\q1
\v 56 \x - \xo 78.56: \xt Jaj 2.11-15\x*God i hae we i hae,
\q2 be olgeta oli girap oli agens long hem,
\q3 oli traem hem.
\q1 Oli no holem ol loa blong hem,
\q2
\v 57 oli tanem baksaed long hem,
\q3 mo oli no stap strong long hem.
\q1 Oli olsem ol papa blong olgeta bifo.
\q1 Oli kam olsem ara we i kruked
\q2 we man i no save trastem.
\q1
\v 58 Oli stap mekem wosip long ol narafala god
\q3 antap long ol hil,
\q2 mo fasin ya i mekem God i kros.
\q1 Oli stap stanemap ol aedol blong olgeta,
\q2 mo fasin ya i mekem hem i kros moa.
\q1
\v 59 Taem hem i luk ol samting ya,
\q2 hem i kros tumas,
\q3 nao i tanem baksaed long olgeta.
\q1
\v 60 \x - \xo 78.60: \xt Jos 18.1; Jer 7.12-14; 26.6\x*Hem i bin stap long haos tapolen blong hem long Silo,
\q3 long medel blong olgeta,
\q2 be hem i lego haos ya,
\q4 i gowe long olgeta.
\q1
\v 61 \x - \xo 78.61: \xt 1 Saml 4.4-22\x*Hem i letem ol enemi blong olgeta
\q2 oli kam tekemaot Bokis ya we i Saen blong Promes.*
\q1 Bokis ya i saen blong paoa blong hem,
\q2 mo blong bigfala laet ya
\q3 we i soemaot we hem i stap.
\q1
\v 62 Hem i kros long ol man blong hem,
\q2 nao i letem ol enemi ya oli kam kilim olgeta i ded.
\q1
\v 63 Ol yang man blong olgeta oli ded long faet,
\q2 nao ol yang gel oli stap nomo,
\q3 i no moa gat man blong oli mared long olgeta.
\q1
\v 64 Ol pris blong hem
\q2 oli ded long faet,
\q3 mo ol woman blong olgeta oli fraet,
\q4 oli no save krae from olgeta.
\b
\q1
\v 65 Biaen, Masta\f + \fr 78.65: \fqa Masta. \ft Yu luk futnot \+bd K\+bd* long 35.22.\f* ya blong yumi i girap,
\q2 i olsem man we i slip gud finis,
\q3 nao i wekap we i harem gud.
\q1 Hem i olsem wan strong man
\q2 we i dring waen, nao i rere blong faet.
\q1
\v 66 Hem i winimgud ol enemi blong hem,
\q2 mo i ronem olgeta i gobak,
\q3 we oli sem we i sem gud,
\q4 oli no moa save mekem faet bakegen.
\q1
\v 67 Hem i no jusumaot laen blong Efrem,
\q2 hem i tanem baksaed long olgeta.
\q1
\v 68 Hem i jusumaot laen blong Juda*
\q2 mo hil ya Saeon* we hem i laekem tumas.
\q1
\v 69 Long ples ya nao,
\q2 hem i wokem tabu haos* blong hem,
\q3 we i olsem hom blong hem long heven.
\q1 Hem i mekem haos ya i strong gud
\q2 olsem we i mekem wol ya,
\q3 we i stap gud oltaem nomo,
\q4 i no save kam nogud.
\b
\q1
\v 70-71 \x - \xo 78.70-71: \xt 1 Saml 16.11,12; 2 Saml 7.8; 1 Kron 17.7\x*Fastaem Deved i stap lukaot long ol sipsip blong hem,
\q2 be God i jusumaot hem
\q3 blong i kam man blong wok blong hem.
\q1 Hem i tekemaot hem long wok ya
\q4 blong lukaot long sipsip,
\q2 mo i putumap hem i kam king
\q4 blong yumi ol laen blong Isrel
\q3 blong i stap lukaot long yumi.
\q1
\v 72 Nao king ya i lavem yumi tumas,
\q2 i lukaot gud long yumi,
\q3 mo i stap lidim yumi long gudhan blong hem.
\c 79
\s Man i prea blong God i ronemaot ol hiten man oli gowe long ples blong hem
\sp (Sing ya, wan laen blong Asaf i wokem.)
\sp (Tok i go long God.)
\q1
\v 1 \x - \xo 79.1: \xt 2 King 25.8-10; 2 Kron 36.17-19; Jer 52.12-14\x*God.
\q1 Ol hiten man oli kam insaed finis
\q3 long ples ya blong yu,
\q2 oli mekem tabu haos* ya blong yu
\q4 i no moa tabu,
\q3 mo oli smasemgud taon ya Jerusalem.*
\q1
\v 2 Oli livim ol dedbodi blong ol man blong wok blong yu
\q3 oli stap,
\q2 blong ol wael anamol mo ol bigfala pijin ya valja* oli kakae.
\q1
\v 3 Oli kilim ol man blong yu,
\q2 mo oli mekem
\q3 we blad blong olgeta i ron olsem wota.
\q1 Long olgeta ples long Jerusalem,
\q2 blad blong olgeta i ron olsem wota nomo,
\q3 mo i no gat man i stap blong berem olgeta.
\q1
\v 4 Ol man blong ol narafala kantri ya
\q3 we oli stap raonabaot long mifala
\q2 oli stap jikim mifala blong spolem mifala,
\q3 oli stap tok nogud long mifala,
\q4 mo oli stap laf long mifala.
\b
\q1
\v 5 Hae God. ?Olsem wanem?
\q1 ?Bambae yu stap kros olwe long mifala
\q2 gogo i no save finis?
\q1 ?Bambae yu letem
\q2 kros blong yu i stap bon oltaem olsem faea?
\q1
\v 6 I gud yu kros long ol man ya blong ol narafala kantri,
\q2 we oli no save mekem wosip long yu
\q3 mo oli no save prea long yu.
\q1
\v 7 Olgeta ya nao oli kilim ol man blong yu,
\q2 mo oli spolem ples ya blong yu.
\b
\q1
\v 8-9 God,
\q2 oltaem yu yu stap sevem mifala.
\q1 Plis yu no panisim mifala
\q2 from ol sin blong ol bubu blong mifala bifo.
\q1 Plis yu sore long mifala.
\q1 Naoia, tingting blong mifala i foldaon olgeta.
\q1 Plis yu halpem mifala,
\q2 yu sevem mifala,
\q3 mo yu fogivim mifala,
\q2 yu tekemaot ol sin blong mifala,
\q3 from we hae nem blong yu
\q4 i stap long mifala.
\q1
\v 10 I no stret blong ol man ya blong ol narafala kantri
\q3 oli stap talem long mifala se,
\q2 “?Wehem God ya blong yufala?”
\q1 God,
\q2 mifala i wantem luk
\q3 we bambae yu panisim olgeta,
\q2 from we oli kilim ol man blong wok blong yu oli ded,
\q3 blad blong olgeta i ron bigwan.
\b
\q1
\v 11 Naoia mifala i stap long kalabus,
\q2 mo oli jajem mifala finis,
\q3 se mifala i mas ded.
\q1 Plis yu lesin long krae blong mifala,
\q2 yu kam long paoa blong yu,
\q3 yu mekem mifala i fri.
\q1
\v 12 Masta\f + \fr 79.12: \fqa Masta. \ft Yu luk futnot \+bd K\+bd* long 35.22.\f*,
\q2 olgeta ya oli stap sakem ol rabis tok i kam long yu.
\q1 Plis yu givimbak fasin ya long olgeta seven taem.
\q1
\v 13 Nao bambae mifala i stap talem tangkiu long yu
\q2 oltaem nomo.
\q1 Mifala i man blong yu,
\q3 mifala i sipsip blong yu nomo.
\q1 Bambae mifala i stap presem yu oltaem,
\q4 gogo i no save finis.
\c 80
\s Man i prea blong God i mekem ples i kam gud bakegen
\sp (Sing ya, wan laen blong Asaf i wokem.)
\sp (Tok i go long God.)
\q1
\v 1-2 \x - \xo 80.1-2: \xt Eks 25.22\x*God.
\q1 Mifala i laen* blong Isrel,*
\q2 mo oltaem yu stap lukaot gud long mifala,
\q3 yu stap lidim mifala,
\q4 olsem we man i stap lukaot gud long ol sipsip blong hem.
\q1 Yu yu stap sidaon long ples blong yu
\q3 antap long tufala jerubim* ya,
\q2 yu stap rul.
\q1 Plis yu lesin long mifala.
\q1 Mifala ol laen blong Efrem,*
\q2 wetem ol laen blong Benjamin,*
\q3 mo ol laen blong Manase.*
\q1 Plis yu soemaot laet blong yu long mifala,
\q2 mo yu soemaot long mifala evriwan,
\q4 we yu yu gat paoa.
\q1 Plis yu kam, yu sevem mifala.
\b
\q1
\v 3 God,
\q2 plis yu soemaot long mifala
\q4 we yu yu gat sore long mifala.
\q1 Plis yu tekem mifala i kambak long yu,
\q2 nao bambae mifala i save stap gud.
\b
\q1
\v 4 Hae God, yu yu God blong mifala,
\q3 mo yu yu gat olgeta paoa.
\q1 Mifala i stap prea long yu.
\q1 ?Bambae yu stap kros long mifala
\q2 gogo kasem wetaem?
\q1
\v 5 Yu yu mekem mifala i stap harem nogud,
\q2 we mifala i stap krae tumas.
\q1 Fasin ya i olsem kakae mo wota blong mifala,
\q2 we evri dei nomo mifala i stap kasem.
\q1
\v 6 Yu stap letem ol man blong ol narafala kantri ya
\q3 we oli stap raonabaot long mifala
\q2 oli stap faet from ples blong mifala.
\q1 Ol enemi ya blong mifala
\q2 oli stap sakem ol rabis tok long mifala.
\b
\q1
\v 7 God, yu yu gat olgeta paoa.
\q1 Plis yu soemaot long mifala
\q2 we yu yu gat sore long mifala.
\q1 Plis yu tekem mifala i kambak long yu,
\q2 nao bambae mifala i save stap gud.
\b
\q1
\v 8 Mifala i olsem rop ya grep*
\q3 we yu tekem i kamaot long Ijip,
\q2 mo yu ronemaot olgeta narafala man,
\q3 nao yu planem long ples blong olgeta.
\q1
\v 9 Yu yu klinimgud ples blong hem blong i gru gud,
\q3 mo ol rus blong hem oli godaon olgeta,
\q2 nao hem i gru i kam bigwan,
\q4 i kavremap olgeta ples ya.
\q1
\v 10 Sado blong hem i kavremap ol hil,
\q2 mo ol han blong hem oli go kavremap
\q4 ol longlongfala tri ya sida* long Lebanon.
\q1
\v 11 Hem i kam bigwan we i bigwan,
\q2 nao ol han blong hem
\q4 oli go kasem Mediterenian Si,
\q3 mo long narasaed,
\q3 oli go kasem Yufretes Reva.
\q1
\v 12 !Rop ya mifala ya!
\q1 ?From wanem yu brekemdaon fenis ya
\q2 we i goraon long hem?
\q1 Naoia ol man we oli stap pas klosap long hem
\q2 oli stap stilim ol frut blong hem.
\q1
\v 13 Ol wael pig oli stap purumbut long hem,
\q2 mo ol wael anamol oli stap kakae.
\b
\q1
\v 14 God, yu yu gat olgeta paoa.
\q1 Plis yu tanem yu,
\q2 yu lukluk i kam long mifala.
\q1 Yu yu stap long heven,
\q2 yu lukluk i kamdaon long mifala.
\q1 Mifala i man blong yu,
\q2 plis yu kam, yu sevem mifala.
\q1
\v 15 Yang rop ya we yu yu bin planem,
\q3 mo yu bin mekem i kam bigwan,
\q2 plis yu kam, yu sevem hem.
\b
\q1
\v 16 Ol enemi oli putum faea long hem finis,
\q2 mo oli stap katemdaon.
\q1 Plis yu girap,
\q2 yu faerap long olgeta,
\q3 yu spolem olgeta.
\q1
\v 17 Yu yu bin jusumaot mifala,
\q2 plis yu lukaot long mifala.
\q1 Yu yu bin mekem mifala i strong,
\q2 plis yu sevem mifala.
\q1
\v 18 Bambae mifala i no save gowe long yu samtaem.
\q1 Plis yu holem mifala i stap laef,
\q2 nao bambae mifala i stap talemaot
\q3 we mifala i man blong yu.
\b
\q1
\v 19 Hae God, yu yu God blong mifala
\q2 mo yu yu gat olgeta paoa.
\q1 Plis yu soemaot long mifala
\q2 we yu yu gat sore long mifala.
\q1 Plis yu tekem mifala i kambak long yu,
\q2 nao bambae mifala i save stap gud.
\c 81
\s Singsing blong lafet
\sp (Sing ya, Asaf i wokem.)
\sp (Tok i go long ol man.)
\q1
\v 1 Olgeta.
\q1 I gud yumi glad,
\q2 yumi singsingaot long God,
\q3 we i God blong Jekob,*
\q4 olfala bubu ya blong yumi bifo. Hem i God blong yumi,
\q2 mo hem i stap blokemgud yumi,
\q3 i stap lukaot gud long yumi.
\q1 Yumi mas singsing blong presem hem.
\q1
\v 2 Yumi statem stringban.
\q1 Yumi plei long tamborin mo gita mo mandolin.
\q1 Yumi mas singsing
\q2 we i gud we i gud.
\q1
\v 3 \x - \xo 81.3: \xt Nam 10.10\x*Yumi blu trampet
\q2 blong mekem wosip blong Lafet blong Niumun,*
\q3 mo blong Lafet blong Fulmun.
\q1
\v 4 Hemia i loa
\q2 we God i givim long yumi ol laen* blong Isrel.*
\q1
\v 5 Hem i givim long ol bubu ya blong yumi bifo,
\q2 long taem ya we hem i tekemaot olgeta long Ijip oli kam.
\b
\q1 Mi mi harem voes blong wan man
\q3 we mi no harem samtaem,
\q2 we i talem se,
\q2
\v 6 “Mi mi talem long ol man blong mi bifo se,
\q3 ‘Mi mi tekemaot ol hevi samting long baksaed blong yufala,
\q4 nao yufala i no moa karem ol brikis blong olgeta,
\q3 yufala i fri.
\q3
\v 7 \x - \xo 81.7: \xt Eks 17.7; Nam 20.13\x*Taem yufala i stap long trabol,
\q4 yufala i singaot long mi,
\q3 nao mi mi sevem yufala.
\q3 Mi mi stap haed insaed long tanda,
\q4 nao mi mi ansa long yufala.
\q3 Mi mi traem yufala long draeples ya,
\q4 we biaen oli kolem springwota blong Meriba.
\q3
\v 8 !Ol laen blong Isrel!
\q4 !Yufala i man blong mi!
\q3 !Mi mi tok blong wonem yufala!
\q3 !Yufala i lesin long tok blong mi!
\q3 !Mi mi wantem tumas
\q4 blong yufala i harem mi!
\q3
\v 9 \x - \xo 81.9: \xt Eks 20.2,3; Dut 5.6,7\x*Bambae yufala i no mekem wosip
\q4 long ol narafala god.
\q3
\v 10 Mi mi Hae God,
\q4 mi God blong yufala.
\q3 Mi nao mi tekemaot yufala
\q3 long ples ya Ijip.
\q3 Mo sipos tingting blong yufala
\q3 i stap strong long mi,
\q4 mi bambae mi givim ol gudgudfala samting
\q3 long yufala.
\b
\q3
\v 11 “ ‘Ol bubu ya blong yufala bifo
\q3 oli man blong mi,
\q4 be oli no save lesin long mi, // oli no save obei long mi.
\q3
\v 12 Nao from samting ya
\q4 mi letem olgeta oli go mekem // stronghed blong olgeta,
\q3 olsem we oli wantem.
\q3
\v 13 Sipos ol man ya blong mi oli save lesin long mi
\q4 bambae mi mi glad tumas,
\q3 be oli no wantem.
\q3 Sipos oli save obei long mi,
\q4 bambae i gud tumas,
\q3 be oli no mekem.
\q3
\v 14 Sipos oli stap mekem olsem,
\q4 bambae mi faet long ol enemi blong olgeta,
\q3 mi winim olgeta kwiktaem nomo,
\q4 be oli no wantem mekem.
\q3
\v 15 Sipos oli stap lesin long mi,
\q4 bambae mi mekem ol man we oli stap agens long mi,
\q3 oli fraet long mi, // oli foldaon long fes blong mi from,
\q3 mo panis blong olgeta bambae i stap we i stap,
\q4 we i no save finis,
\q4 be oli no stap lesin long mi.
\q3
\v 16 Sipos oli stap obei long mi,
\q4 bambae mi fidim olgeta long wit* we i beswan,
\q3 bambae oli kakae eg* blong wael sugabag* // we i swit we i swit,
\q3 nao oli harem gud,
\q4 be oli no save obei long mi.’ ”
\c 82
\s God i stap jajem ol haeman we wok blong olgeta i no stret
\sp (Sing ya, Asaf i wokem.)
\sp (Tok i go long ol man.)
\q1
\v 1 God i stap mekem kot long heven,
\q2 hem i stap jajem ol haeman ya
\q3 we oli gat paoa blong jajem man.
\q1
\v 2 Hem i talem se,
\q2 “Yufala i mas lego fasin ya
\q3 we yufala i stap jajem ol man
\q4 long fasin we i no stret.
\q2 Bambae yufala i no moa saed
\q3 long ol man nogud bakegen.
\q2
\v 3 Yufala i mas lukaot gud
\q3 long raet blong ol puaman,
\q4 mo blong ol pikinini
\q3 we papa blong olgeta i ded.
\q2 Yufala i mas mekem i stret
\q3 long olgeta we oli stap trabol
\q4 mo long olgeta we oli no gat paoa.
\q2
\v 4 Yufala i mas tekemaot olgeta
\q3 long paoa blong ol man nogud.
\b
\q1
\v 5 “!Yufala i no save wan samting nating!
\q2 !Yufala i no gat hed!
\q2 Fasin blong yufala i nogud olgeta.
\q2 Naoia, stret fasin blong jajem man
\q3 i lus finis long wol.
\q2
\v 6 \x - \xo 82.6: \xt Jon 10.34\x*Mi mi God, mi hae we mi hae,
\q3 mo mi talem finis se,
\q3 ‘Yufala i god,
\q4 yufala evriwan i pikinini blong mi.’
\q2
\v 7 Be bambae yufala i ded olsem ol narafala man,
\q3 bambae laef blong yufala i finis
\q4 olsem laef blong ol narafala haeman.”
\sp (Tok i go long God.)
\q1
\v 8 God,
\q2 plis yu kam, yu rulum wol ya.
\q1 Ol man blong olgeta kantri oli blong yu.
\c 83
\s Man we i prea blong God i winim ol enemi blong hem
\sp (Sing ya, Asaf i wokem.)
\sp (Tok i go long God.)
\q1
\v 1 God.
\q1 !Plis yu no stap kwaet!
\q1 !Yu no satem maot blong yu olsem!
\q1 !Plis yu tok!
\q1
\v 2 !Yu luk!
\q1 Ol enemi blong yu oli girap oli agensem yu,
\q2 olgeta ya we oli no laekem yu
\q3 oli stap faet agens long yu.
\q1
\v 3 Mifala i man blong yu nomo
\q3 we yu yu stap lukaot long mifala,
\q2 be oli stap mekem ol tokhaed
\q4 blong spolem mifala,
\q3 oli stap mekem ol plan agens long mifala
\q3 long fasin blong haed.
\q1
\v 4 Oli talem se,
\q2 “!Yufala i kam!
\q2 !Yumi go flatem olgeta ya!
\q2 !Yumi spolemgud ples blong olgeta!
\q2 !Bambae nem ya Isrel* i lus olgeta!”
\b
\q1
\v 5 Olgeta oli agri long plan ya blong olgeta,
\q2 nao oli joen wanples blong oli agens long yu.
\q1
\v 6 Long olgeta ya,
\q2 i gat ol man Edom,
\q3 mo ol laen* blong Ismael,
\q3 mo ol man Moab,
\q3 mo ol laen blong Hega,
\q3
\v 7 mo ol man blong Gebal,
\q3 mo ol man Amon,
\q3 mo ol laen blong Amalek,
\q3 mo ol man Filistia,
\q4 mo ol man Taea.
\q1
\v 8 Mo ol man Asiria tu oli joen wetem olgeta,
\q2 from we oli strong man blong faet,
\q3 mo oli gudfala fren blong ol man Amon mo ol man Moab
\q4 we oli laen blong Lot.
\b
\q1
\v 9 \x - \xo 83.9 a: \xt Jaj 7.1-23; \xo b: \xt Jaj 4.6-22\x*Plis yu mekem long olgeta
\q2 olsem we yu bin mekem
\q4 long ol man Midian bifo,
\q3 olsem we yu bin mekem
\q3 long tufala ya Siseraha mo Jabin, // long Kison Reva.
\q1
\v 10 Yu yu winim tufala long taon ya Endoro,
\q2 mo bodi blong tufala i roten long ples ya.
\q1
\v 11 \x - \xo 83.11 a: \xt Jaj 7.25; \xo b: \xt Jaj 8.12\x*Plis yu mekem long ol lida blong olgeta
\q2 olsem we yu bin mekem
\q3 long tufala haeman ya Oreb mo Seheb.
\q1 Plis yu winim ol king blong olgeta
\q2 olsem we yu bin winim
\q3 tufala king ya Seba mo Jalmuna,
\q4
\v 12 we tufala i talem se,
\q2 “Graon ya we i blong God,
\q3 bambae yumi tekem i blong yumi.”
\b
\q1
\v 13 God,
\q2 plis yu mekem olgeta oli go wanwan,
\q3 olsem asis blong graon
\q4 we win i blu long hem i go olbaot.
\q1
\v 14 Yu kam long olgeta
\q2 olsem bigfala faea we i laet long bus,
\q3 we i stap kakae ol tri olbaot long ol hil.
\q1
\v 15 Plis yu kam long olgeta olsem bigfala win,
\q2 yu mekem olgeta oli fraet.
\q1 Yu kam olsem bigfala hariken,
\q2 yu ronemaot olgeta oli go.
\q1
\v 16 Hae God,
\q2 yu mekem we olgeta oli sem gud,
\q3 gogo oli lukaot rod blong kam man blong yu.
\q1
\v 17 Plis yu winimgud olgeta,
\q2 yu mekem we bambae oli fraet gogo i no save finis,
\q3 yu mekem olgeta oli ded long wan fasin
\q4 we bambae i mekem nem blong olgeta i nogud.
\q1
\v 18 Plis yu mekem olgeta oli save
\q2 we yu nomo yu Hae God,
\q3 yu nao yu hae King blong olgeta ples long wol.
\c 84
\s Man we i laekem haos blong God tumas
\sp (Sing ya, ol laen blong Kora oli wokem.)
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Yu yu gat olgeta paoa.
\q1 !Mi mi laekem haos* blong yu tumas!
\q1
\v 2 !Mi wantem tumas
\q4 blong go stap long hem!
\q1 Hae God,
\q2 mi wantem tumas blong stap oltaem
\q3 long haos blong yu.
\q1 Yu yu God we yu laef.
\q1 Tingting blong mi i glad tumas long yu,
\q2 mo mi stap sing blong presem yu.
\q1
\v 3 Hae God, yu yu gat olgeta paoa.
\q1 Yu yu King blong mi,
\q2 yu yu God blong mi.
\q1 Ol smosmol pijin ya we oli smol tumas,
\q2 be oli stap mekem nes blong olgeta
\q3 long haos blong yu,
\q2 mo oli stap lukaot long ol pikinini blong olgeta
\q4 klosap long olta blong yu.
\q1
\v 4 Ol man we oli stap long haos blong yu
\q3 oli hapi tumas,
\q2 oltaem oli stap singsing blong presem yu.
\b
\q1
\v 5 Ol man we yu yu stap mekem olgeta oli strong,
\q2 oli hapi tumas.
\q1 Oltaem oli wantem tumas blong kam long hil ya Saeon*
\q2 blong mekem prea long yu.
\q1
\v 6 Oltaem,
\q2 taem oli pastru long krik ya Baka
\q4 we i drae we i drae,
\q2 be oli no moa trabol blong kasem wota,
\q3 from we ples ya i kam ples blong wota.
\q1 Ren\f + \fr 84.6: \ft Tok ya blong ren i soemaot we ol laen blong Isrel oli stap sing long Sam ya long taem blong ol lafet ya blong olgeta long en blong Septemba.\f* blong taem ya i mekem
\q2 ol hol long ples ya oli kam fulap long wota.
\q1
\v 7 Yu yu God,
\q2 yu yu hae moa long ol narafala god.
\q1 Oltaem,
\q3 taem ol man ya oli stap kam long Saeon
\q4 oli stap kam strong moa,
\q2 mo bambae oli stap luk yu
\q4 long ples ya blong yu.
\b
\q1
\v 8 Hae God, yu yu God blong mi,
\q2 mo yu yu gat olgeta paoa.
\q1 !Plis yu harem prea blong mi!
\q1 Yu yu God blong Jekob.*
\q1 !Plis yu lesin long mi!
\q1
\v 9 God,
\q2 yu nao yu jusumaot king blong mifala.
\q1 !Plis yu blesem hem!
\b
\q1
\v 10 Yu yu God blong mi.
\q1 Sipos mi stap wan dei nomo
\q3 long haos blong yu,
\q2 be hemia i gud moa,
\q3 i winim we mi stap wan taosen dei
\q4 long ol narafala ples.
\q1 Nating sipos mi stap wok nomo
\q3 long doa blong haos blong yu,
\q2 be hemia i moa gud,
\q3 i winim we mi stap insaed olgeta
\q4 long haos blong ol man nogud.
\q1
\v 11 Hae God,
\q2 yu yu God blong mifala.
\q1 Yu yu King
\q3 we paoa blong yu i bigfala tumas,
\q2 mo yu stap blokem mifala
\q4 blong mifala i stap gud.
\q1 Yu yu stap blesem mifala long gladhat blong yu,
\q2 yu stap leftemap nem blong mifala.
\q1 Yu yu no save holemtaet
\q3 ol gudgudfala samting blong yu,
\q2 oltaem yu stap givim long olgeta
\q4 we oli stap mekem ol stret fasin.
\q1
\v 12 Hae God, yu yu gat olgeta paoa.
\q1 Olgeta we oli stap trastem yu
\q2 bambae oli save harem gud.
\c 85
\s Man i prea blong kantri blong hem i gat gudfala laef
\sp (Sing ya, ol laen blong Kora oli wokem.)
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Kantri ya Isrel* i kantri blong yu.
\q1 Bifo, yu yu bin gat sore long hem,
\q2 mo yu bin mekem hem i kam gud bakegen.
\q1
\v 2 Yu yu bin fogivim mifala
\q3 yu tekemaot ol sin blong mifala,
\q2 mo yu bin tekemaot olgeta rong blong mifala.
\q1
\v 3 Long taem ya, yu bin lego fasin ya
\q3 we yu stap kros long mifala,
\q2 mo yu bin livim kros blong yu,
\q4 yu no moa kros long mifala bakegen.
\b
\q1
\v 4 God, oltaem yu yu stap sevem mifala.
\q1 Plis yu tekem mifala i kambak long yu bakegen,
\q2 yu no moa tanem baksaed long mifala.
\q1
\v 5 ?Olsem wanem?
\q1 ?Bambae yu stap kros long mifala oltaem nomo?
\q1 ?Bambae kros blong yu i no save finis samtaem?
\q1
\v 6 Plis yu mekem mifala i strong bakegen,
\q2 nao bambae mifala i presem yu.
\q1
\v 7 Hae God,
\q2 oltaem yu yu lavem man tumas.
\q1 Plis yu soemaot fasin ya long mifala,
\q2 yu halpem mifala, yu sevem mifala.
\sp (Tok i go long ol man.)
\q1
\v 8 Hae God i God blong yumi,
\q2 mo mi mi stap lesin long ol tok ya
\q3 we hem i stap talem.
\q1 Hem i promes se sipos yumi no gobak
\q3 long ol krangke fasin blong yumi,
\q2 hem bambae i givim pis long yumi.
\q1
\v 9 Tru, oltaem nomo hem i rere
\q3 blong sevem man we i stap ona long hem,
\q2 mo hem bambae i stap long ples blong yumi
\q4 long olgeta paoa blong hem,
\q3 nao bambae hem i stap sevem yumi.
\b
\q1
\v 10 Oltaem God bambae i stap lavem man tumas,
\q2 nao man bambae i putum tingting blong hem
\q3 i stap strong long God.
\q1 God bambae i soemaot stret fasin blong hem,
\q2 nao man bambae i kasem pis long hem.
\q1
\v 11 Fasin ya we man i stap strong long God
\q3 bambae i go antap i kasem heven,
\q2 mo stret fasin ya blong God
\q4 bambae i kamdaon i kasem graon.
\q1
\v 12 Hae God bambae i mekem
\q3 we yumi gat plante samting,
\q2 mo graon blong yumi
\q4 bambae i karem plante kakae.
\q1
\v 13 Stret fasin blong Hae God
\q3 bambae i go fastaem long hem,
\q2 mo bambae i mekemrere rod blong hem.
\c 86
\s King i prea blong God i givhan long hem
\sp (Sing ya, Deved i wokem.)
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Mi mi no strong, mi no gat paoa.
\q1 Plis yu harem krae blong mi,
\q2 yu ansa long mi.
\q1
\v 2 Mi mi man blong wok blong yu,
\q2 mi trastem yu.
\q1 Oltaem tingting blong mi i stap strong long yu.
\q1 Plis yu sevem mi,
\q2 yu no letem mi mi ded.
\b
\q1
\v 3 Yu yu God blong mi,
\q2 plis yu sore long mi.
\q1 Oltaem, mi mi stap prea long yu,
\q2 i stat long moning go kasem long sapa.
\q1
\v 4 Masta\f + \fr 86.4: \fqa Masta. \ft Yu luk futnot \+bd K\+bd* long 35.22.\f*,
\q2 mi mi man blong wok blong yu.
\q1 Mi stap prea i go long yu nomo.
\q1 Plis yu mekem mi mi glad.
\q1
\v 5 Yu yu gud tumas long mifala,
\q2 mo yu stap fogivim mifala,
\q3 yu stap tekemaot ol sin blong mifala.
\q1 Ol man we oli stap mekem prea long yu,
\q2 oltaem yu yu lavem olgeta tumas.
\b
\q1
\v 6 Hae God,
\q2 mi stap krae blong yu givhan long mi.
\q1 Plis yu lesin long prea blong mi,
\q2 mo yu ansa long mi.
\q1
\v 7 Oltaem, taem mi mi stap long trabol,
\q2 mi stap singaot long yu,
\q3 from we mi save
\q4 se yu yu stap ansa long ol prea blong mi.
\b
\q1
\v 8 Masta,
\q2 i no gat narafala god we i olsem yu.
\q1 I no gat wan i stap
\q2 we i stap mekem ol gudgudfala wok
\q3 olsem we yu yu bin mekem.
\q1
\v 9 \x - \xo 86.9: \xt Rev 15.4\x*Ol man blong olgeta kantri,
\q2 yu yu bin mekem olgeta,
\q3 mo bambae oli kam,
\q4 oli bodaon long yu,
\q3 oli presem hae nem blong yu.
\q1
\v 10 Yu nomo yu God.
\q1 Yu yu gat paoa,
\q2 mo yu stap mekem ol bigbigfala samting.
\b
\q1
\v 11 Hae God,
\q2 plis yu tijim mi long ol samting
\q4 we yu wantem blong mi mi mekem,
\q3 nao bambae mi obei long yu,
\q3 mi holem trutok blong yu.
\q1 Yu mekem we mi bambae mi wantem tumas
\q2 blong mekem ol wok blong yu nomo.
\q1
\v 12 God, yu yu Masta* blong mi.
\q1 Bambae mi stap presem yu
\q3 long olgeta tingting blong mi,
\q2 bambae mi stap leftemap hae nem blong yu oltaem,
\q4 gogo i no save finis.
\q1
\v 13 Oltaem yu yu lavem mi tumas.
\q1 Fasin ya blong yu i gud we i gud.
\q1 Yu yu bin sevem mi blong mi no go long beregraon.
\q1
\v 14 God,
\q2 ol praod man oli kam oli agens long mi.
\q1 Wan grup blong ol man nogud
\q2 oli stap traem blong kilim mi.
\q1 Olgeta ya,
\q2 neva oli save lesin long yu.
\q1
\v 15 Be Masta\f + \fr 86.15: \fqa Masta. \ft Yu luk futnot \+bd K\+bd* long 35.22.\f*, yu yu God.
\q1 Fasin blong yu,
\q2 oltaem yu yu gat sore long man,
\q3 mo yu lavem hem tumas.
\q1 Oltaem yu stap mekem tingting blong yu i longfala,
\q2 mo yu yu kaen tumas,
\q3 oltaem yu stap holem ol promes blong yu.
\q1
\v 16 Plis yu lukluk i kam long mi,
\q2 yu sore long mi, yu sevem mi,
\q3 mo yu mekem mi mi strong,
\q2 from we mi mi stap wok blong yu,
\q3 olsem we mama blong mi i stap mekem bifo.
\q1
\v 17 Hae God,
\q2 plis yu soemaot long mi
\q3 we fasin blong yu i gud tumas,
\q2 nao taem olgeta we oli no laekem mi nating
\q3 oli luk we yu yu stap givhan long mi,
\q4 yu stap leftemap tingting blong mi,
\q3 bambae olgeta oli sem.
\c 87
\s Sing blong presem Jerusalem
\sp (Sing ya, ol laen blong Kora oli wokem.)
\sp (Tok i go long ol man.)
\q1
\v 1 Taon ya Jerusalem,*
\q2 hem i taon blong Hae God.
\q1 Hem i wokem long tabu hil* ya Saeon,*
\q2
\v 2 mo i laekem taon ya moa,
\q3 i winim ol narafala taon long Isrel.*
\q1
\v 3 Yufala long taon ya blong hem,
\q2 yufala i lesin long ol gudgudfala tok
\q3 we hem i stap talem
\q4 blong leftemap taon ya.
\b
\q1
\v 4 Hem i talem se,
\q2 “Taem mi mekem lis blong olgeta
\q4 man we oli stap obei long mi,
\q3 bambae mi putum nem blong ol man Ijip
\q4 wetem ol man Babilonia,
\q4 mo ol man Filistia,
\q4 mo ol man Taea,
\q4 mo ol man Itiopia,
\q3 olgeta evriwan oli stap insaed.
\q1 Olgeta ya bambae mi kaontem wetem yufala,
\q2 olsem we oli man ples blong yufala.”
\b
\q1
\v 5 Mo bakegen,
\q3 hem bambae i talem se,
\q2 “Taon ya,
\q3 ol man blong olgeta kantri
\q4 bambae oli gat raet long hem.”
\q1 Hae God, hem i hae we i hae,
\q2 mo hem bambae i mekem taon ya i strong.
\q1
\v 6 Hem bambae i raetemdaon nem blong olgeta
\q3 long wan buk,
\q2 mo bambae hem i kaontem olgeta evriwan,
\q4 se oli man Jerusalem.
\q1
\v 7 Nao olgeta ya bambae oli stap danis,
\q3 mo oli stap singsing se,
\q2 “Saeon* ya,
\q3 olgeta gudgudfala samting blong yumi
\q4 oli stap kamaot long hem oltaem.”
\c 88
\s Man i krae i go long Hae God blong i givhan long hem
\sp (Sing ya, ol laen blong Kora oli wokem. Tok blong hem, Heman we i laen blong Esraha i wokem.)
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Yu yu God blong mi,
\q2 mo oltaem yu stap sevem mi.
\q1 Long dei mo long naet,
\q2 mi stap krae long yu,
\q3 blong yu yu halpem mi.
\q1
\v 2 Plis yu harem prea blong mi.
\q1 Mi mi stap krae long yu
\q2 blong yu givhan long mi.
\q1 Plis yu lesin long mi.
\b
\q1
\v 3 Plante trabol tumas oli stap kasem mi,
\q2 we klosap mi mi ded from.
\q1
\v 4 Naoia, paoa blong mi i lus olgeta,
\q2 oli stap kaontem mi wetem olgeta
\q4 we klosap oli ded.
\q1
\v 5 Ol man oli luk mi olsem we mi mi ded finis.
\q1 Mi mi olsem ol man we oli ded long faet,
\q2 we oli stap finis long beregraon.
\q1 Yu yu fogetem olgeta finis,
\q2 yu no moa save givhan long olgeta.
\q1
\v 6 Yu sakem mi finis insaed long hol
\q2 we i godaon we i godaon olgeta.
\q1 Hol ya i godaon we i godaon,
\q2 mo i tudak tu.
\q1
\v 7 Yu yu kros tumas long mi,
\q1 Kros blong yu i flatem mi olgeta,
\q2 i olsem we bigsi i rolem mi,
\q3 i flatemgud mi.
\b
\q1
\v 8 Yu yu mekem we ol fren blong mi oli lego mi finis,
\q2 yu mekem mi mi kam olsem wan samting
\q4 we i nogud tumas long fes blong olgeta.
\q1 Yu blokemgud ol rod blong mi,
\q2 nao mi mi no save ronwe.
\q1
\v 9 Mi mi harem nogud tumas,
\q2 mi krae gogo ae blong mi i kam nogud from.
\q1 Hae God.
\q1 Evri dei nomo,
\q2 mi mi stap singaot long yu,
\q3 mi stap leftemap han blong mi,
\q4 mi stap prea long yu.
\b
\q1
\v 10 ?Olsem wanem?
\q1 ?Ol merikel we yu yu stap mekem,
\q2 be ol dedman oli save luk?
\q1 !Ol dedman oli no save girap bakegen
\q2 blong presem yu!
\q1
\v 11 ?Oltaem yu yu lavem man tumas,
\q3 mo yu stap holem ol promes blong yu,
\q2 be olgeta we oli stap finis long beregraon
\q4 oli save talemaot ol fasin ya?
\q1
\v 12 Olgeta ya oli stap long ples ya
\q2 we ol man oli fogetem olgeta finis,
\q3 mo oli no save luk ol gudgudfala fasin blong yu.
\q1 !Olgeta we oli stap finis long tudak ya,
\q2 oli no save luk ol merikel ya blong yu!
\b
\q1
\v 13 Hae God.
\q1 Evri moning mi stap prea long yu,
\q2 mi stap krae long yu blong yu givhan long mi.
\q1
\v 14 Hae God.
\q1 ?From wanem yu tanem baksaed long mi?
\q1 ?From wanem yu tanem fes blong yu
\q3 i gowe long mi?
\q1
\v 15 I stat long taem we mi mi yangfala,
\q3 kam kasem tede,
\q2 oltaem nomo,
\q3 mi mi stap harem nogud long bodi blong mi,
\q4 we klosap mi ded from.
\q1 Panis ya we yu stap givim long mi
\q2 hem i hevi tumas,
\q3 nao i mekem mi mi slak we mi slak.
\q1
\v 16 Yu yu kros tumas long mi
\q2 nao tingting blong mi i foldaon.
\q1 Yu mekem i strong tumas long mi,
\q2 yu mekem mi mi kam nogud olgeta.
\q1
\v 17 Oltaem nomo,
\q2 i stat long moning go kasem long sapa,
\q3 panis ya we yu stap givim long mi
\q4 i kam kavremap mi // olsem wota we i ron bigwan,
\q3 i hivap raon long mi long evri saed.
\q1
\v 18 Yu yu mekem olgeta man oli gowe long mi.
\q1 Nating we oli gudfala fren blong mi,
\q2 be yu mekem olgeta oli lego mi,
\q3 naoia tudak nomo i fren blong mi.
\c 89
\s Sing we ol laen blong Isrel oli sing long hem long taem we kantri blong olgeta i stap long trabol
\sp (Sing ya, Etan we i laen blong Esraha i wokem.)
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Oltaem bambae mi stap singsing
\q3 from fasin ya blong yu
\q4 we oltaem yu yu lavem man tumas.
\q1 Fasin ya blong yu
\q3 we oltaem yu stap holem ol promes blong yu,
\q2 bambae mi stap talemaot oltaem nomo,
\q3 gogo i no save finis.
\q1
\v 2 Mi mi save we fasin ya blong yu blong lavem man
\q3 bambae i stap oltaem nomo,
\q2 mo fasin ya blong yu blong holem ol promes blong yu
\q4 bambae i olsem skae, i no save lus.
\q1
\v 3 Yu yu talem se,
\q2 “Mi mi mekem promes finis
\q3 wetem Deved,
\q4 man ya blong wok blong mi
\q3 we mi mi jusumaot hem bifo.
\q2
\v 4 \x - \xo 89.4: \xt 2 Saml 7.12-16; 1 Kron 17.11-14; Sam 132.11; Wok 2.30\x*Mi mi talem long hem se,
\q3 ‘Oltaem ol king blong ol man blong mi
\q4 bambae oli stap kamaot long olgeta
\q3 we oli stap kamaot biaen long yu.
\q3 Olgeta ya,
\q4 mi bambae mi holem olgeta // oli stap gud oltaem,
\q3 bambae mi stap lukaot gud long olgeta // gogo i no save finis.’ ”
\b
\q1
\v 5 Hae God.
\q1 Olgeta long heven oli stap singsing
\q2 blong talemaot ol gudgudfala fasin
\q3 we yu yu mekem,
\q2 oli stap sing from fasin ya
\q3 we yu yu stap holem ol promes blong yu.
\q1
\v 6 I no gat man long heven we i olsem yu.
\q1 Long olgeta we oli stap long heven,
\q2 be i no gat wan man nating
\q3 we i sem mak long yu.
\q1
\v 7 Olgeta enjel long heven oli tabu we i tabu,
\q2 be oli stap ona long yu.
\q1 Olgeta evriwan oli stap fraet long yu,
\q2 from we yu yu hae we yu hae.
\b
\q1
\v 8 Hae God, yu yu God blong mi,
\q2 mo yu gat olgeta paoa.
\q1 I no gat wan man nating we i strong olsem yu.
\q1 Long olgeta samting,
\q2 oltaem yu yu stap holem ol promes blong yu.
\q1
\v 9 Solwota i strong tumas,
\q2 be yu yu stap rulum hem.
\q1 Taem we hem i raf tumas,
\q2 be yu yu stap mekem i kam kwaet bakegen.
\q1
\v 10 Yu yu flatemgud Rahab,*
\q3 bigfala anamol ya blong solwota,
\q2 mo yu kilim hem i ded.
\q1 Yu yu stap winim ol enemi blong yu
\q2 long paoa blong yu we i strong tumas.
\q1
\v 11 Skae i blong yu,
\q2 mo graon ya tu i blong yu.
\q1 Yu yu mekem wol ya
\q2 wetem olgeta samting we i stap long hem.
\q1
\v 12 Yu yu mekem olgeta ples,
\q2 i stat long not, i go kasem long saot.
\q1 Hil ya Taboro mo hil ya Hemon tufala i glad tumas,
\q2 tufala i stap singsing blong presem yu.
\q1
\v 13 !Yu yu gat paoa blong mekem olgeta samting!
\q1 !Paoa blong yu i bigwan tumas!
\q1
\v 14 Yu yu King,
\q2 we fasin blong yu,
\q3 oltaem yu stap mekem i stret,
\q4 oltaem yu stap jajem ol man long stret rod.
\q1 Olgeta samting we yu stap mekem
\q2 oli stap soemaot
\q3 we oltaem yu stap lavem man tumas,
\q4 mo oltaem yu stap holem ol promes blong yu.
\b
\q1
\v 15 Olgeta we oli stap singsing blong presem yu,
\q2 oli glad tumas.
\q1 Oltaem yu yu kaen gud long olgeta,
\q3 nao i olsem we oli stap wokbaot long delaet.
\q1
\v 16 Yu yu mekem olgeta oli harem gud,
\q2 i stat long moning go kasem long sapa.
\q1 Mo oltaem oli stap presem yu
\q2 from ol gudgudfala fasin blong yu.
\q1
\v 17 Oltaem yu yu mekem mifala
\q2 i stap win gud long faet.
\q1 Yu stap mekem mifala i win
\q3 from we yu lavem mifala tumas.
\q1
\v 18 Hae God, yu yu tabu we yu tabu.
\q1 Yu yu God blong mifala ol laen* blong Isrel,*
\q2 mo yu jusumaot king ya blong mifala,
\q4 we i stap lukaot long mifala,
\q3 yu putumap hem i kam king.
\s Promes we God i mekem wetem Deved
\sp (Tok i go long Hae God.)
\q1
\v 19 Longtaem bifo,
\q2 yu yu kamtru long ol man blong wok blong yu,
\q4 we tingting blong olgeta i stap strong long yu,
\q3 yu toktok long olgeta long vison.*
\q1 Yu yu talem se,
\q2 “Mi mi givhan long wan soldia
\q3 we i gat hae nem.
\q2 Mi jusumaot hem long olgeta man,
\q3 nao mi putumap hem i kam king.
\q2
\v 20 \x - \xo 89.20 a: \xt 1 Saml 13.14; Wok 13.22; \xo b: \xt 1 Saml 16.12\x*Soldia ya Deved ya,
\q4 we i man blong wok blong mi,
\q3 mo mi kafsaedem tabu oel
\q4 i go long hed blong hem,
\q3 mi mekem hem i king.
\q2
\v 21 Mi bambae mi mekem hem i strong,
\q3 oltaem paoa blong mi bambae i stap wetem hem.
\q2
\v 22 Ol enemi blong hem neva bambae oli winim hem,
\q3 ol man nogud bambae oli no save daonem hem samtaem.
\q2
\v 23 Bambae mi flatem ol enemi blong hem,
\q3 mi kilim olgeta evriwan
\q4 we oli no laekem hem,
\q3 oli stap agens long hem.
\q2
\v 24 Be hem,
\q4 bambae mi lavem hem tumas,
\q3 tingting blong mi
\q3 bambae i stap strong long hem oltaem,
\q4 mo bambae mi mekem we hem i stap win oltaem.
\q2
\v 25 Bambae mi mekem kingdom blong hem i kam bigwan,
\q3 i stat long Mediterenean Si
\q4 go kasem Yufretes Reva.
\q2
\v 26 Bambae hem i talem long mi se,
\q3 ‘Yu yu papa blong mi,
\q4 mo yu yu God blong mi.
\q3 Oltaem yu stap lukaot gud long mi,
\q4 yu stap sevem mi.’
\q2
\v 27 \x - \xo 89.27: \xt Rev 1.5\x*Bambae mi mekem hem i fasbon pikinini blong mi,
\q3 mo bambae hem i hae we i hae,
\q3 i winim ol narafala king.
\q2
\v 28 Oltaem bambae mi stap holem promes blong mi
\q4 we mi mekem wetem hem,
\q3 mo promes ya bambae i stap oltaem,
\q3 i no save finis.
\q2
\v 29 Olgeta we bambae oli stap kamaot biaen long hem,
\q3 bambae mi mi holem olgeta
\q4 oli stap gud oltaem,
\q3 olsem we skae i stap oltaem nomo.
\q2 Oltaem ol king blong ol man blong mi
\q3 bambae oli stap kamaot biaen long olgeta ya.
\q2
\v 30-32 “Be sipos olgeta ya
\q4 oli no obei long ol loa blong mi,
\q3 mo oli no stap folem ol tok // we mi stap givim long olgeta,
\q3 bambae mi mi panisim olgeta
\q4 from ol sin ya blong olgeta.
\q2 Sipos olgeta oli no tingting long ol tok
\q3 we mi stap tijim olgeta long hem,
\q4 mo oli no stap holem ol tok blong mi,
\q3 bambae mi mekem
\q4 we olgeta oli harem nogud
\q3 from ol fasin nogud ya we oli mekem.
\q2
\v 33 Be Deved,
\q3 bambae mi lavem hem oltaem nomo,
\q3 gogo i no save finis,
\q4 tingting blong mi bambae i stap strong long hem, // we bambae i no save foldaon.
\q2
\v 34 Bambae mi no save brekem promes ya blong mi
\q4 we mi mekem wetem hem,
\q3 bambae mi no save jenisim
\q4 wan tok blong promes ya nating.
\b
\q2
\v 35 “Mi mi tabu we mi tabu,
\q3 mo long nem blong mi,
\q4 mi talem long yufala finis,
\q3 se neva bambae mi save brekem promes ya // we mi mekem wetem Deved.
\q2
\v 36 Olgeta we bambae oli stap kamaot biaen long hem
\q3 bambae mi holem olgeta oli stap oltaem nomo.
\q3 Mi bambae mi stap lukaot long olgeta,
\q4 blong oli stap king oltaem
\q3 olsem we san i stap oltaem nomo.
\q2
\v 37 Bambae oli stap king oltaem
\q3 olsem we mun i stap oltaem
\q3 long skae,
\q4 i stap witnes long mi.”
\s Ol man oli stap krae from we ol enemi oli winim king blong olgeta
\sp (Tok i go long Hae God.)
\q1
\v 38 Hae God.
\q1 Naoia, king ya we yu yu jusumaot hem,
\q2 yu yu kros long hem bakegen,
\q3 yu lego hem finis,
\q4 yu tanem baksaed long hem.
\q1
\v 39 Yu yu brekem promes* ya finis we yu mekem bifo
\q3 wetem man ya blong wok blong yu.
\q1 I olsem we yu tekemaot hat blong king finis long hem,
\q2 yu sakem i go long sofmad.
\q1
\v 40 Yu brekemdaon finis ol stonwol blong taon blong hem,
\q2 yu spolemgud ol strong sefples blong hem.
\q1
\v 41 Ol man we oli stap kam pas long ples ya
\q3 oli stap stilim olting blong hem,
\q2 mo ol man we oli stap raonabaot long hem
\q4 oli stap laf nogud long hem.
\q1
\v 42 Yu yu mekem we ol enemi blong hem
\q3 oli stap win,
\q2 nao olgeta oli stap harem gud tumas.
\q1
\v 43 Yu mekem
\q3 we ol samting blong faet blong hem
\q4 oli kam nogud,
\q2 nao yu letem ol enemi blong hem
\q3 oli kam faet long hem,
\q4 oli winim hem.
\q1
\v 44 Wokingstik blong king,
\q3 yu tekemaot long hem finis,
\q2 mo bigfala jea blong king,
\q3 yu yu tekemaot long hem,
\q4 yu sakem i go long graon.
\q1
\v 45 Yu yu mekem we hem i kam olfala kwiktaem nomo,
\q2 mo yu mekem hem i sem we i sem.
\s King i prea blong God i sevem hem
\sp (Tok i go long Hae God.)
\q1
\v 46 Hae God.
\q1 Naoia mifala i no save luk yu.
\q1 ?Bambae yu stap haed olwe nomo?
\q1 ?Bambae kros blong yu i stap bon olsem faea
\q3 gogo kasem wetaem?
\q1
\v 47 Plis yu no fogetem mi.
\q1 Mi mi man nomo,
\q2 mo laef blong mi i sotfala nomo.
\q1 Yu yu mekem mifala,
\q2 mo mifala evriwan i mas ded.
\q1
\v 48 ?Hu man we i save stap oltaem,
\q2 we i no save ded?
\q1 I no gat man i save ronwe long beregraon.
\b
\q1
\v 49 ?Masta\f + \fr 89.49: \fqa Masta. \ft Yu luk futnot \+bd K\+bd* long 35.22.\f* blong mi,
\q2 wehem gudfala fasin ya blong yu
\q4 we yu stap soemaot bifo,
\q3 we oltaem yu stap lavem man tumas?
\q1 ?Wehem ol promes ya
\q2 we yu yu mekem wetem King Deved bifo?
\q1
\v 50 Mi mi man blong wok blong yu,
\q2 plis yu no fogetem mi.
\q1 Oltaem ol man oli stap tok nogud long mi,
\q2 mo ol hiten man oli stap singaot* trabol i kam long mi.
\q1
\v 51 Hae God,
\q2 mi mi king we yu nomo yu jusumaot mi,
\q3 be ol enemi blong yu oli stap tok nogud long mi.
\q1 Long weples we mi mi pas long hem,
\q2 be olgeta oli stap laf nogud long mi.
\sp (Tok i go long ol man.)
\q1
\v 52 !Oltaem bambae yumi mas presem Hae God,
\q2 gogo i no save finis!
\b
\q1 !Amen!
\q1 !Amen!
\b
\c 90
\ms BUK FO
\mr (Sam 90—106)
\s Man i save stap smoltaem, be God bambae i stap oltaem nomo
\sp (Sing ya, Moses, man blong wok blong God i wokem.)
\sp (Tok i go long God.)
\q1
\v 1 Masta.\f + \fr 90.1: \fqa Masta. \ft Yu luk futnot \+bd K\+bd* long 35.22.\f*
\q1 I stat bifo olgeta kam kasem tede,
\q2 oltaem,
\q3 yu yu olsem hom blong mifala.
\q1
\v 2 Bifo,
\q2 taem we yu no mekem ol hil ya yet,
\q3 long taem ya we yu no wokem wol ya nating yet,
\q2 be yu yu stap fastaem finis.
\q1 Yu yu God we yu stap we yu stap,
\q2 mo bambae yu save stap oltaem,
\q3 gogo i no save finis.
\b
\q1
\v 3 Fastaem yu tekem graon,
\q3 yu mekem mifala long hem,
\q2 mo oltaem yu stap mekem mifala
\q4 i gobak long graon bakegen.
\q1 Yu stap talem se,
\q2 “Ol man long wol,
\q3 yufala i mas gobak long graon.”
\q1
\v 4 \x - \xo 90.4: \xt 2 Pita 3.8\x*Long yu,
\q2 wan taosen yia i olsem wan dei nomo,
\q3 i olsem yestedei we i pas finis,
\q4 i olsem wan aoa nomo long naet,
\q3 we i pas kwiktaem nomo.
\q1
\v 5 Yu yu stap tekemaot mifala,
\q2 olsem wota we i ron bigwan,
\q3 we i brumumaot ol samting.
\q1 Mifala i no save stap longtaem,
\q2 mifala i olsem drim nomo.
\q1 Mifala i olsem gras we i stap gru olbaot.
\q1
\v 6 Long moning, hem i karem flaoa,
\q2 be long sapa, flaoa ya i drae,
\q3 i foldaon.
\b
\q1
\v 7 Yu yu kros,
\q2 nao yu spolem mifala.
\q1 Yu yu kros tumas long mifala,
\q2 nao mifala i fraet we i fraet nogud.
\q1
\v 8 Yu stap mekem
\q3 we ol sin blong mifala i kamaot klia long fes blong yu,
\q2 yu stap luk ol rabis fasin ya
\q4 we mifala i stap mekem long haed nomo.
\b
\q1
\v 9 Yu yu kros,
\q2 nao yu stap katem
\q3 laef blong mifala i kam sotfala.
\q1 Mifala i stap lus,
\q2 olsem win we i godaon, i finis.
\q1
\v 10 Yia blong mifala i save kasem seventi nomo,
\q2 no sipos bodi blong mifala i stap strong oltaem,
\q4 mifala i save kasem eiti,
\q3 be oltaem mifala i stap kasem trabol,
\q3 mifala i stap harem nogud nomo.
\q1 Laef blong mifala i save finis kwiktaem nomo,
\q2 nao mifala i go lus olgeta.
\b
\q1
\v 11 I no gat man samtaem
\q2 we i kasem fulpaoa blong kros blong yu.
\q1 I no gat man yet
\q2 we i savegud fasin blong yu blong kros,
\q3 nao i fraet gud long yu from.
\q1
\v 12 Plis yu mekem mifala i save
\q3 we laef blong mifala i sotfala nomo,
\q2 blong mifala i save kam waes.
\b
\q1
\v 13 Hae God.
\q1 ?Bambae yu yu stap kros long mifala
\q3 gogo kasem wetaem?
\q1 Mifala i man blong wok blong yu,
\q2 plis yu sore long mifala.
\q1
\v 14 Plis yu mekem
\q2 we evri moning, mifala i savegud
\q3 we oltaem yu yu lavem mifala tumas,
\q2 nao bambae mifala i save singsing,
\q3 mifala i save glad oltaem long laef blong mifala.
\q1
\v 15 Long ol yia we i pas finis,
\q2 yu yu stap mekem mifala i harem nogud tumas.
\q1 Plis naoia,
\q2 yu mekem mifala i harem gud,
\q3 stret long mak we bifo
\q4 yu bin mekem mifala i harem nogud.
\q1
\v 16 Mifala i man blong wok blong yu.
\q1 Plis yu letem mifala i luk
\q3 ol bigbigfala wok blong yu,
\q2 mo yu letem olgeta
\q3 we bambae oli stap kamaot biaen long mifala
\q4 oli luk bigfala paoa blong yu.
\q1
\v 17 God,
\q2 yu yu Masta* blong mifala.
\q1 Plis yu givim ol gudgudfala samting blong yu long mifala,
\q2 mo yu mekem we bambae mifala i stap win oltaem
\q4 long olgeta samting we mifala i stap mekem.
\c 91
\s Hae God i stap lukaot gud long yumi
\sp (Tok i go long ol man.)
\q1
\v 1-2 Hae God i hae we i hae,
\q2 mo hem i gat olgeta paoa.
\q1 Mo man we i stap aninit long han blong hem,
\q2 mo i stap trastem hem blong i lukaot gud long hem,
\q2 hem i save talem se,
\q2 “Yu yu God blong mi,
\q3 mo mi mi trastem yu.
\q2 Yu yu stap lukaot gud long mi,
\q3 mo yu stap blokemgud mi.”
\q1
\v 3 Sipos yu yu mekem olsem,
\q2 Hae God bambae i lukaot gud long yu,
\q3 i sevem yu long olgeta samting
\q4 we i stap haed blong kasem yu,
\q3 mo bambae i tekemaot yu long olgeta sik
\q3 we oli blong kilim man i ded.
\q1
\v 4 Bambae hem i blokem yu yu stap gud
\q2 olsem we pikinini blong faol i stap gud
\q3 aninit long wing blong mama blong hem.
\q1 Oltaem tingting blong hem
\q3 bambae i stap strong long yu,
\q2 nao bambae hem i lukaot gud long yu,
\q4 i blokemgud yu.
\q1
\v 5 Nao long naet,
\q2 bambae yu no save fraet long ol samting
\q3 we oli stap mekem man i fraet,
\q2 mo long dei,
\q3 bambae yu no save fraet long ol man
\q4 we oli girap blong kam kilim yu.
\q1
\v 6 Bambae yu no moa save fraet nating
\q2 long ol rabis sik ya
\q4 we oli stap kasem man long tudak,
\q3 mo long ol rabis fasin ya
\q3 we oli stap kilim man long delaet.
\b
\q1
\v 7 Maet wan taosen man
\q2 we oli stap klosap long yu
\q3 oli save foldaon, oli ded.
\q1 Maet ten taosen man
\q2 we oli stap raonabaot long yu
\q3 oli save lus evriwan,
\q2 be ol trabol ya
\q3 bambae oli no save spolem yu.
\q1
\v 8 Bambae yu save luk stret long ae blong yu,
\q2 we ol man nogud oli stap kasem panis.
\b
\q1
\v 9 Hae God i hae we i hae,
\q2 mo from we yu yu stap putum
\q4 tingting blong yu i stap long hem,
\q3 hem bambae i stap blokemgud yu,
\q3 i stap lukaot gud long yu.
\q1
\v 10 Nao from samting ya,
\q2 i no gat wan samting nogud
\q3 we bambae i save kam spolem yu,
\q2 i no gat wan rabis sik
\q3 we bambae i save kam klosap
\q4 long haos blong yu.
\q1
\v 11 \x - \xo 91.11: \xt Mat 4.6; Luk 4.10\x*Hae God bambae i putum
\q2 ol enjel blong hem oli stap raonabaot long yu
\q3 blong oli stap lukaot gud long yu
\q4 long weples yu yu pas long hem.
\q1
\v 12 \x - \xo 91.12: \xt Mat 4.6; Luk 4.11\x*Bambae oli holem yu long han blong olgeta,
\q2 oli leftemap yu i go antap,
\q3 blong yu no save kikim ston long leg blong yu.
\q1
\v 13 \x - \xo 91.13: \xt Luk 10.19\x*Bambae yu save purumbut
\q3 long ol laeon mo long ol snek
\q2 blong kilim olgeta.
\q1 Ol laeon ya we ol man oli fraet long olgeta,
\q3 mo ol posen snek ya,
\q2 be bambae yu save purumpurumbut
\q4 long olgeta
\q3 blong kilim olgeta oli ded.
\b
\q1
\v 14 Hae God i talem se,
\q2 “Mi bambae mi sevem olgeta
\q4 we oli stap lavem mi,
\q3 mo bambae mi lukaot gud long olgeta
\q3 we oli save we mi mi Hae God.
\q2
\v 15 Sipos oli singaot long mi,
\q4 mi bambae mi ansa long olgeta,
\q3 mo sipos oli stap long trabol, mi bambae mi stap wetem olgeta.
\q2 Mi bambae mi tekemaot olgeta long trabol,
\q3 mi leftemap olgeta,
\q4 mi givim hae nem long olgeta.
\q2
\v 16 Mi bambae mi sevem olgeta,
\q3 mi givim longfala laef long olgeta,
\q4 olsem pei blong olgeta.”
\c 92
\s Sing blong presem Hae God
\sp (Sing blong singsing long hem long Sabat* dei.)
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Yu yu God we yu hae we yu hae.
\q1 I gud tumas blong talem tangkiu long yu,
\q2 mo blong sing blong leftemap nem blong yu.
\q1
\v 2 I gud tumas blong talemaot evri moning
\q3 we oltaem yu yu lavem man tumas,
\q2 mo blong talemaot evri naet
\q4 we yu stap holem ol promes blong yu.
\q1
\v 3 I gud tumas blong singsing wetem gita
\q3 mo yukalele mo mandolin
\q2 blong talemaot ol fasin ya blong yu.
\q1
\v 4 Hae God,
\q2 ol bigbigfala wok blong yu
\q3 oli stap mekem mi mi glad tumas.
\q1 Oltaem mi mi harem gud,
\q2 mi stap sing from ol samting ya
\q3 we yu yu mekem.
\b
\q1
\v 5 Hae God.
\q1 !Ol wok blong yu oli bigfala tumas!
\q1 !Tingting blong yu i dip we i dip!
\q1
\v 6 Samting ya,
\q2 man we i no gat hed neva bambae hem i save,
\q3 man we i krangke bambae i no save luksave samtaem.
\q1
\v 7-8 Hae God,
\q2 ol man nogud oli save gru kwik
\q4 olsem rabis gras,
\q3 olgeta evriwan we oli stap mekem ol fasin nogud
\q3 oli save win long plante samting,
\q2 be bambae yu yu spolemgud olgeta,
\q4 from we yu yu hae we yu hae,
\q3 mo bambae yu stap olsem oltaem nomo,
\q3 gogo i no save finis.
\b
\q1
\v 9 Mifala i save
\q2 we ol enemi blong yu bambae oli ded.
\q1 Yu bambae yu winim olgeta man nogud.
\q1
\v 10 Yu yu mekem mi mi strong olsem wael buluk,
\q2 mo yu blesem mi,
\q3 yu mekem mi mi harem gud tumas.
\q1
\v 11 Mi mi luk finis
\q3 we ol enemi blong mi oli lus.
\q1 Olgeta oli man nogud,
\q2 mo mi harem finis we oli stap krae.
\sp (Tok i go long ol man.)
\q1
\v 12-13 Hae God i God blong yumi,
\q2 mo ol man we fasin blong olgeta i stret
\q3 oli stap oltaem long haos* blong hem.
\q1 Bambae oli gru gud olsem pamtri,*
\q2 bambae oli gru olsem ol sida* ya long Lebanon.
\q1 Oltaem oli stap kam strong moa,
\q2 olsem ol tri we man i planem long gudfala graon,
\q3 mo oli stap gru gud oltaem.
\q1
\v 14 Olgeta oli strong olsem olfala tri
\q2 we lif blong hem i stap grin oltaem
\q3 mo i stap karem plante frut yet.
\q1
\v 15 Hemia i soemaot we Hae God,
\q2 fasin blong hem i stret gud olgeta,
\q3 i no gat wan samting nating long hem
\q4 we i no stret.
\q1 Oltaem hem i stap lukaot gud long mi.
\c 93
\s Hae God, hem i king
\sp (Tok i go long Hae God.)
\q1
\v 1 !Hae God, yu yu king!
\q1 Hae nem blong yu mo paoa blong yu
\q2 i stap oltaem long yu,
\q3 olsem klos blong yu nomo.
\q1 Yu yu stanemap wol ya,
\q2 mo hem i stanap strong long ples blong hem
\q3 we i no save muf.
\b
\q1
\v 2 Hae God, yu yu King.
\q1 Yu yu stap rul bifo olgeta kam kasem naoia,
\q2 mo paoa blong yu i no save foldaon.
\q1 Yu yu stap bifo we bifo olgeta,
\q2 kam kasem tede.
\b
\q1
\v 3 Hae God.
\q1 Noes blong dipsi i go antap,
\q3 we i go antap olgeta.
\q1
\v 4 Be yu yu stap rul long heven,
\q2 mo yu yu hae moa.
\q1 Mo voes blong yu i strong moa
\q2 i winim noes blong dipsi.
\q1 Paoa blong yu i strong moa,
\q2 i winim paoa blong ol bigsi.
\b
\q1
\v 5 Hae God,
\q2 ol loa blong yu oli blong oltaem nomo.
\q1 Haos* blong yu i tabu we i tabu,
\q2 mo bambae i stap oltaem nomo,
\q3 gogo i no save finis.
\c 94
\s God i stap jajem olgeta man
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Yu yu God we yu stap givim panis
\q3 long ol man nogud.
\q1 !I gud yu soemaot paoa blong yu long olgeta!
\q1
\v 2 Yu yu stap jajem olgeta man.
\q1 Plis yu girap,
\q2 yu givim panis long ol praod man,
\q3 we i stret long olgeta.
\q1
\v 3 Hae God.
\q1 ?Ol man nogud ya oli laen blong mifala nomo,
\q2 be bambae oli stap glad
\q3 gogo kasem wetaem?
\q1 ?Bambae oli stap mekem olsem
\q2 go kasem wetaem?
\q1
\v 4 Olgeta oli stap brekem loa.
\q1 ?Bambae oli stap praod olsem
\q3 gogo kasem wetaem?
\q1 ?Bambae oli stap tok flas
\q2 from ol rabis fasin blong olgeta
\q3 go kasem wetaem?
\b
\q1
\v 5 Hae God,
\q2 mifala i man blong yu,
\q3 be olgeta ya oli stap flatemgud mifala.
\q1 Nem blong yu i stap long mifala,
\q2 be oli stap mekem mifala i harem nogud
\q3 aninit long han blong olgeta.
\q1
\v 6 Oli stap kilim ol wido,
\q2 mo ol pikinini we ol papa blong olgeta oli ded,
\q3 mo ol strenja we oli stap long ples blong mifala.
\q1
\v 7 Olgeta oli talem se,
\q2 “Hae God i God blong yumi ol laen* blong Isrel,*
\q3 be hem i no save luk yumi.
\q2 !Hem i no save luksave ya!”
\sp (Tok i go long ol man.)
\q1
\v 8 !Olgeta!
\q1 !Yufala i krangke ya!
\q1 !Yufala i lusum hed finis!
\q1 ?Wetaem bambae yufala i save samting?
\q1
\v 9 ?Yufala i ting se God i no save harem samting?
\q1 !Hem nao i mekem sora blong yumi!
\q1 ?Yufala i ting se hem i no save lukluk?
\q2 !Hem nao i mekem ae blong yumi!
\q1
\v 10 ?Yufala i ting
\q2 se hem i no save givim panis long yufala?
\q1 !Hem nao i stap stretem
\q2 ol man blong olgeta kantri!
\q1 ?Yufala i ting se hem i no gat save?
\q1 !Hem nao i tija blong olgeta man!
\q1
\v 11 \x - \xo 94.11: \xt 1 Kor 3.20\x*Hae God i save tingting blong man.
\q1 Hem i savegud we man i no gat hed.
\sp (Tok i go long Hae God.)
\q1
\v 12 Hae God.
\q1 Man we yu stap panisim hem blong stretem hem,
\q3 mo we yu stap tijim hem long ol loa blong yu,
\q2 hem i save harem gud.
\q1
\v 13 Oltaem bambae yu stap blokem
\q3 ol trabol oli no kam long hem,
\q2 yu mekem we hem bambae i stap gud
\q3 go kasem taem we bambae yu digim hol
\q4 blong mekem trap blong kasem ol man nogud.
\sp (Tok i go long ol man.)
\q1
\v 14 Hae God bambae i no save lego yumi ya
\q3 we yumi ol man blong hem,
\q2 hem bambae i no save gowe long yumi ya
\q4 we nem blong hem i stap finis long yumi.
\q1
\v 15 Ol jaj bambae oli mekem kot bakegen
\q3 we bambae oli jajem ol man long stret fasin,
\q2 mo taem ol stret man oli luk fasin ya,
\q4 bambae oli glad long hem.
\b
\q1
\v 16 Bifo i no gat man i stanap,
\q2 i givhan long mi
\q3 blong mi agensem ol man nogud.
\q1 I no gat wan man nating
\q2 i stanap long saed blong mi,
\q3 i agensem ol rabis man ya.
\q1
\v 17 Sipos Hae God i no bin givhan long mi,
\q2 bambae mi go kwiktaem nomo
\q3 long Hom* blong ol Dedman.
\sp (Tok i go long Hae God.)
\q1
\v 18 Hae God.
\q1 Taem mi talem se,
\q3 “!Mi glis, mi foldaon!”
\q2 be yu yu holem mi mi stap gud,
\q4 from we oltaem yu yu lavem mi tumas.
\q1
\v 19 Taem we mi mi wari,
\q3 mo mi stap tingting tumas,
\q2 oltaem yu yu mekem tingting blong mi
\q4 i kam gud bakegen,
\q3 yu stap mekem mi mi glad.
\b
\q1
\v 20 Yu yu no glad nating
\q2 long ol jaj ya we oli no stret,
\q3 we fasin blong olgeta i krangke.
\q1 Olgeta ya oli stap mekem ol loa
\q3 blong stanemap ol fasin nogud,
\q2
\v 21 mo oli stap mekem plan long haed
\q4 blong spolem ol gudfala man,
\q3 mo oli stap jajem ol man
\q3 we oli no mekem wan samting nogud,
\q4 se oli mas ded.
\q1 Ol jaj olsem,
\q2 yu yu stap agens long olgeta.
\sp (Tok i go long ol man.)
\q1
\v 22 Be Hae God i God blong mi,
\q2 mo hem i stap blokem mi
\q4 i stap lukaot gud long mi.
\q1
\v 23 Hem bambae i panisim olgeta ya
\q3 from ol fasin nogud blong olgeta,
\q2 bambae hem i spolem olgeta
\q4 from ol sin blong olgeta.
\q1 Hae God i God blong yumi,
\q2 mo hem bambae i spolemgud olgeta.
\c 95
\s Sing blong presem God
\sp (Tok i go long ol man.)
\q1
\v 1 !Yufala i kam,
\q2 yumi presem Hae God!
\q1 !Yumi glad, yumi singsing long hem!
\q1 !Hem i stap blokemgud yumi,
\q2 i stap sevem yumi!
\q1
\v 2 Yumi kam long fes blong hem,
\q3 yumi talem tangkiu long hem.
\q1 Yumi presem hem,
\q2 yumi sing long hem
\q3 long ol singsing blong glad.
\q1
\v 3 Hae God, hem i God we i gat paoa.
\q1 Hem i king, mo i gat paoa moa
\q2 i winim olgeta narafala god.
\q1
\v 4 Graon ya i stap long han blong hem,
\q2 i stat daon long stamba blong hem
\q4 we i daon we i daon olgeta,
\q3 i go antap kasem ol hil
\q3 we oli hae we i hae.
\q1
\v 5 Hem i mekem solwota,
\q2 mo i stap lukaot long hem.
\q1 Ol aelan tu, hem nomo i mekem olgeta,
\q3 mo oli stap long han blong hem.
\b
\q1
\v 6 Hae God, hem i mekem yumi.
\q1 Yufala i kam, yumi bodaon,
\q2 yumi nildaon long fes blong hem,
\q3 yumi mekem wosip long hem.
\q1
\v 7 \x - \xo 95.7: \xt Hib 3.7-11\x*\x - \xo 95.7: \xt Hib 3.15; 4.7\x*Hem i God blong yumi.
\q1 Yumi ol man blong hem,
\q2 mo hem i stap lukaot gud long yumi.
\q1 Yumi ol sipsip blong hem,
\q2 mo yumi stap long han blong hem.
\b
\q1 Tede, yufala i mas lesin long tok blong hem.
\q1 Hem i talem se,
\q2
\v 8 \x - \xo 95.8: \xt Eks 17.1-7; Nam 20.2-13\x*“Yufala i no mekem stronghed,
\q3 olsem we ol bubu blong yufala bifo
\q4 oli mekem long draeples ya Meriba,
\q3 we narafala nem blong hem Masaha.
\q2
\v 9 Olgeta ya oli luk finis
\q4 ol samting we mi mi mekem long olgeta,
\q3 be long ples ya,
\q4 oli wantem traem mi,
\q3 oli wantem luk paoa blong mi bakegen.
\q2
\v 10 Nao mi mi kros long olgeta foti yia,
\q3 mo mi talem se,
\q3 ‘Ol man ya oli no holem promes
\q3 blong olgeta nating,
\q4 oli no wantem nating // blong obei long ol tok blong mi.’
\q2
\v 11 \x - \xo 95.11 a: \xt Nam 14.20-23; Dut 1.34-36; Hib 4.3,5; \xo b: \xt Dut 12.9,10\x*Mi mi kros gud long olgeta,
\q3 nao mi mekem wan strong tok,
\q3 mi talem se, ‘Yufala ya,
\q4 neva bambae yufala i go insaed long graon ya
\q3 we mi mi wantem givim long yufala // blong yufala i go spel long hem.’ ”
\c 96
\s Hae God i Hae King, mo hem i rulum olgeta man
\r (1 Kronikel 16.23-33)
\sp (Tok i go long ol man.)
\q1
\v 1 !Olgeta man long wol!
\q1 !Yumi sing long Hae God!
\q1 !Yumi wokem wan niufala singsing!
\q1 !Yumi sing blong presem hem!
\q1
\v 2 !Yumi sing long Hae God!
\q1 !Yumi leftemap nem blong hem!
\q1 Evri dei bambae yumi talemaot gud nius ya
\q2 we hem i sevem yumi.
\q1
\v 3 Bambae yumi talemaot paoa blong hem
\q2 long ol man blong ol narafala kantri.
\q1 Bambae yumi talemaot ol bigbigfala wok blong hem
\q2 long fes blong olgeta man.
\b
\q1
\v 4 Hae God i hae we i hae,
\q2 mo yumi mas presem hem,
\q3 yumi mas leftemap nem blong hem.
\q1 Hem i hae moa long ol narafala god,
\q2 mo i stret blong yumi ona moa long hem,
\q3 i winim we yumi ona long ol narafala god.
\q1
\v 5 Olgeta god ya
\q3 blong ol man blong ol narafala kantri
\q2 oli giaman god nomo,
\q4 oli no save mekem wan samting,
\q2 be Hae God ya,
\q3 hem i mekem skae
\q4 wetem olgeta samting we i stap long hem.
\q1
\v 6 Bigfala laet i stap saen raonabaot long hem
\q2 i soemaot we hem i King,
\q3 nem blong hem i hae we i hae.
\q1 Olgeta samting long haos* blong hem
\q2 oli soemaot we paoa blong hem i bigfala tumas,
\q3 mo we hem i gud we i gud.
\b
\q1
\v 7 \x - \xo 96.7: \xt Sam 29.1,2\x*!Olgeta man long wol,
\q2 yumi presem Hae God!
\q1 Yumi leftemap nem blong hem
\q2 from ol gudgudfala samting blong
\q3 hem mo from paoa blong hem.
\q1
\v 8 !Nem blong hem i hae we i hae!
\q1 !Yumi presem hem!
\q1 Yumi tekem presen blong yumi,
\q2 yumi kam long haos blong hem,
\q3 yumi givim long hem.
\q1
\v 9 !Hae God ya i tabu we i tabu!
\q1 !Yumi mas bodaon long fes blong hem,
\q2 yumi mas wosipim hem!
\q1 !I gud yumi tinghevi long hem,
\q2 yumi ona gud long hem!
\q1
\v 10 Yumi mas talemaot long olgeta man
\q3 blong ol narafala kantri se,
\q2 “!Hae God, hem i King!
\q2 Hem i putum wol ya
\q3 i stanap strong long ples blong hem,
\q4 mo i no save muf.
\q2 Hem bambae i jajem olgeta man
\q3 long stret fasin.”
\q1
\v 11 Skae mo graon.
\q1 !Yutufala i harem gud,
\q2 yutufala i glad!
\q1 Solwota.
\q1 !Yu wetem evri samting we i stap long yu,
\q3 yufala i mekem bigfala noes!
\q1
\v 12-13 Ol garen.
\q1 !Yufala wetem evri samting we i stap long yufala,
\q3 yufala i glad!
\q1 Taem Hae God i kam blong rul
\q3 long olgeta man long wol ya,
\q2 olgeta tri long bus bambae oli glad,
\q4 oli stap singsingaot blong presem hem.
\q1 Long taem ya,
\q2 bambae hem i rulum olgeta man blong wol
\q4 long stret fasin,
\q3 mo bambae hem i jajem
\q4 olgeta man blong ol narafala kantri
\q1 ong trutok blong hem.
\c 97
\s Hae God, hem i Hae King
\sp (Tok i go long ol man.)
\q1
\v 1 !Hae God, hem i King!\f + \fr 97.1: \ft Plante toktok blong Sam 97 ya i pija tok blong talemaot fasin blong God blong i rul.\f*
\q1 !Wol,
\q2 i gud yu yu glad long hem!
\q1 !Ol aelan,
\q2 i gud yufala i glad we i glad
\q3 from samting ya!
\q1
\v 2 I gat klaod mo tudak i stap raonabaot long hem.
\q1 Hem i stap rul long stret fasin,
\q2 mo i stap jajem ol man
\q3 long fasin we i stret gud olgeta.
\q1
\v 3 Faea i stap go fastaem long hem,
\q2 i stap bonem ol enemi raon long hem.
\q1
\v 4 Laetning blong hem
\q3 i stap mekem olgeta ples i saen,
\q2 mo taem graon i luk samting ya,
\q4 hem i seksek from.
\q1
\v 5 Hae God i Masta* blong olgeta ples long wol,
\q2 mo long fes blong hem,
\q3 ol hil oli stap ronaot olsem gris.
\q1
\v 6 Olgeta samting long skae
\q3 oli stap talemaot stret fasin blong hem,
\q2 mo olgeta man long wol
\q4 oli stap luk bigfala paoa blong hem.
\q1
\v 7 Olgeta we oli stap mekem wosip long ol narafala god,
\q2 mo oli stap tok flas from olgeta,
\q3 olgeta ya evriwan oli stap sem bigwan.
\q1 Ol narafala god ya oli stap bodaon
\q2 long fes blong Hae God.\f + \fr 97.7: \ft Narafala rod blong tanem tok long las haf blong vas ya i olsem. \+bd !Ol\+bd* \fqa narafala \+bd god! !Yufala i kam\+bd* \fqa bodaon long fes blong Hae God!\f*
\sp (Tok i go long God.)
\q1
\v 8 Hae God.
\q1 Ol man Saeon* oli glad we i glad,
\q2 mo ol taon long Juda* oli harem gud tumas,
\q3 from fasin ya blong yu blong jajem man.
\q1
\v 9 Hae God, yu yu hae we yu hae,
\q2 yu yu King blong olgeta ples long wol.
\q1 Yu yu hae moa,
\q2 yu winim ol narafala god.
\sp (Tok i go long ol man.)
\q1
\v 10 Hae God i lavem ol man blong hem.
\q1 Olgeta oli stap agens long ol rabis fasin,
\q2 mo hem i stap lukaot gud long laef blong olgeta,
\q3 mo taem we olgeta oli stap long
\q3 paoa blong ol man nogud,
\q4 hem i stap tekemaot olgeta.
\q1
\v 11 Laet blong hem i stap saen long ol stret man,
\q2 mo hem i stap mekem olgeta
\q3 oli glad we i glad.
\q1
\v 12 Yufala we fasin blong yufala i stret,
\q2 yufala i joen long Hae God,
\q3 yufala i mas glad.
\q1 Yufala i mas tingbaot
\q3 we fasin blong hem i stret gud, i tabu,
\q2 mo yufala i mas talem tangkiu long hem from.
\c 98
\s Hae God, hem i King blong wol
\sp (Tok i go long ol man.)
\q1
\v 1 Yumi wokem wan niufala sing,
\q2 yumi singsing long hem blong presem Hae God,
\q3 from we hem i stap mekem ol bigbigfala wok.
\q1 Paoa blong hem i strong mo i tabu,
\q2 mo long paoa ya blong hem,
\q3 hem i win long faet, i sevem yumi.
\q1
\v 2 Hae God i talemaot finis we hem i win.
\q1 Hem i soemaot long ol man blong ol narafala kantri,
\q3 we hem i gat paoa blong sevem yumi.
\q1
\v 3 Hem i stap holem ol promes blong hem
\q2 we i mekem long yumi ol laen* blong Isrel,*
\q3 mo oltaem hem i stap lavem yumi.
\q1 Nao olgeta man long evri ples oli
\q2 luk we God blong yumi hem i win.
\b
\q1
\v 4-6 !Hae God i King blong yumi!
\q1 !Olgeta man long wol, yumi glad!
\q1 !Yumi sing long hem!
\q1 !Yumi presem hem long ol singsing!
\q1 !Yumi glad, we yumi singsingaot from!
\q1 !Yumi plei long gita!
\q1 !Yumi sing, yumi presem hem!
\q1 !Yumi blu long trampet mo long pupu!
\q1 !Yumi glad, yumi singsing long hem!
\b
\q1
\v 7 Solwota.
\q1 !Yu wetem evri samting we i stap long yu,
\q2 yufala i mekem bigfala noes!
\q1 Graon.
\q1 !Yu wetem olgeta samting we i stap long yu,
\q3 yufala i singsing!
\q1
\v 8-9 !Ol reva, yufala i klaphan!
\q1 !Ol hil, yufala i glad!
\q1 !Hae God i kam blong rulum wol!
\q1 Yufala i kam long fes blong hem,
\q2 yufala i joen blong singsing.
\q1 Bambae hem i jajem olgeta man long wol
\q3 long stret fasin nomo.
\c 99
\s Hae God, hem i Hae King
\sp (Tok i go long ol man.)
\q1
\v 1 \x - \xo 99.1: \xt Eks 25.22\x*!Hae God, hem i king!
\q1 Hem i stap sidaon long ples blong hem
\q3 antap long tufala jerubim* ya,
\q2 i stap rul,
\q3 mo olgeta man oli fraet long hem,
\q3 oli stap seksek,
\q4 mo graon tu i seksek.
\q1
\v 2 Hae God i stap long Saeon.*
\q1 Hem i gat paoa,
\q2 mo i hae moa long ol man blong ol narafala kantri.
\q1
\v 3 Hem i King,
\q2 mo nem blong hem i hae we i hae.
\q1 Olgeta man bambae oli presem hem,
\q2 from we hem i tabu we i tabu.
\sp (Tok i go long Hae God.)
\q1
\v 4 King blong mifala.
\q1 Yu yu gat olgeta paoa.
\q1 Oltaem yu yu laekem ol fasin
\q2 we i stret.
\q1 Stret fasin ya blong jajem man,
\q2 yu nomo yu tekem i kam,
\q3 yu stanemap long kantri blong mifala.
\sp (Tok i go long ol man.)
\q1
\v 5 !Hae God i God blong yumi!
\q1 !Yumi presem hem!
\q1 Hem i stap sidaon long ples blong hem,
\q3 i stap rul.
\q1 !Hem i tabu we i tabu!
\q1 Yumi kam bodaon long fes blong hem,
\q3 yumi wosipim hem.
\q1
\v 6 Bifo, Moses mo Eron,
\q2 tufala i pris blong Hae God.
\q1 Samuel tu i wan long olgeta
\q2 we oli stap prea long hem.
\q1 Ol man ya blong Hae God
\q2 oli stap krae i go long hem,
\q3 mo hem i stap ansa long olgeta.
\q1
\v 7 \x - \xo 99.7: \xt Eks 33.9\x*Hem i kamtru long olgeta
\q2 long bigfala klaod ya we i stanap stret nomo,
\q3 nao i toktok long olgeta.
\q1 Mo olgeta oli obei long ol loa blong hem,
\q2 mo oli holem ol tok ya
\q3 we hem i talem long olgeta.
\sp (Tok i go long Hae God.)
\q1
\v 8 Hae God.
\q1 Yu yu God blong mifala.
\q1 Long taem ya,
\q2 yu yu ansa long ol man ya blong yu.
\q1 Nating we yu stap panisim olgeta
\q3 from ol sin blong olgeta,
\q2 be yu stap soemaot bakegen long olgeta
\q4 we yu yu save fogivim olgeta,
\q3 yu tekemaot ol sin blong olgeta.
\sp (Tok i go long ol man.)
\q1
\v 9 Hae God i God blong yumi,
\q2 mo hem i tabu we i tabu.
\q1 Yufala i kam,
\q2 yumi presem nem blong hem,
\q3 yumi mekem wosip long hem
\q4 long tabu hil* ya blong hem.
\c 100
\s Sing blong presem Hae God
\sp (Tok i go long ol man.)
\q1
\v 1 !Olgeta man long wol,
\q2 yumi sing long Hae God!
\q1
\v 2 !Yumi glad,
\q2 yumi mekem wosip long hem!
\q1 !Yumi kam long fes blong hem,
\q2 yumi singsing!
\b
\q1
\v 3 Yumi mas tingbaot
\q2 we Hae God, hem i God.
\q1 Hem nomo i mekem yumi,
\q2 mo yumi man blong hem.
\q1 Yumi ol man blong hem,
\q2 yumi olsem ol sipsip blong hem.
\b
\q1
\v 4 !Yufala i kam!
\q1 Yumi go insaed long yad blong haos* blong hem,
\q2 mo yumi wokbaot i go
\q3 we yumi stap talem tangkiu long hem.
\q1 Yumi go insaed long ples blong wosip,
\q2 mo yumi wokbaot i go
\q3 we yumi stap presem hem.
\q1 Yumi talem tangkiu long hem,
\q2 yumi leftemap nem blong hem.
\b
\q1
\v 5 \x - \xo 100.5: \xt 1 Kron 16.34; 2 Kron 5.13; 7.3; Esra 3.11; Sam 106.1; 107.1; 118.1; 136.1; Jer 33.11\x*Hae God, hem i gud tumas.
\q1 Fasin blong hem,
\q2 we hem i stap lavem man tumas,
\q3 bambae i stap oltaem nomo.
\q1 Hem bambae i holem ol promes blong hem oltaem,
\q2 gogo i no save finis.
\c 101
\s Promes blong king
\sp (Sing ya, Deved i wokem.)
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Sing ya blong mi i blong tokbaot fasin ya
\q3 we mi wantem holem ol promes we mi mekem wetem yu,
\q4 mo we mi wantem jajem ol man long stret fasin.
\q1 Bambae mi sing long hem
\q2 blong presem yu.
\q1
\v 2 Mi wantem
\q2 se bambae mi stap folem rod
\q3 we i stret olgeta.
\q1 Mi mi wantem tumas,
\q2 se bambae yu kam stap wetem mi.
\b
\q1 Long haos blong mi,
\q2 bambae mi stap folem ol fasin
\q3 we i klin gud long fes blong yu,
\q2
\v 3 neva bambae mi letem rabis fasin
\q3 i kam spolem mi.
\q1 Mi mi no laekem nating
\q2 wok blong olgeta ya we oli gowe long yu,
\q3 mo bambae mi no save go joen wetem olgeta.
\q1
\v 4 Bambae mi no save mekem ol giaman fasin
\q2 mo bambae mi no save go joen wetem ol man nogud.
\q1
\v 5 Man we i stap tok smosmol
\q2 blong spolem nem blong narafala man,
\q3 bambae mi sakemaot hem.
\q1 Mo man we i stap praod,
\q2 no we i stap tok flas,
\q3 bambae mi no save letem hem i stap.
\b
\q1
\v 6 Be olgeta we tingting blong olgeta
\q3 i stap strong long yu,
\q2 bambae mi tekem olgeta
\q4 oli kam stap wetem mi.
\q1 Olgeta we fasin blong olgeta i stret gud,
\q2 bambae mi letem olgeta oli wok blong mi.
\b
\q1
\v 7 Man we i stap wokem trik
\q3 bambae i no save stap long haos blong mi,
\q2 mo man we i stap giaman
\q4 bambae i no save stap wetem mi.
\q1
\v 8 Hae God.
\q1 Evri dei bambae mi stap spolem ol man nogud
\q2 long kantri blong mifala.
\q1 Bambae mi stap sakemaot olgeta man
\q3 we oli stap mekem i no stret,
\q2 oli gowe long taon blong yu.
\c 102
\s Prea blong wan yang man we i stap long trabol
\sp (Tok i go long Hae God.)
\q1
\v 1 Hae God.
\q1 Plis yu lesin long prea blong mi.
\q1 Mi mi stap krae blong yu givhan long mi,
\q2 plis yu harem mi.
\q1
\v 2 Mi mi stap long trabol.
\q1 Plis yu no tanem
\q2 fes blong yu i gowe long mi.
\q1 Mi mi stap krae long yu.
\q1 Plis yu lesin long mi,
\q2 yu ansa long mi kwiktaem.
\b
\q1
\v 3 Bodi blong mi i stap hot olsem faea,
\q2 mo laef blong mi i olsem smok
\q3 we win i karem i go.
\q1
\v 4 Mi mi kam olsem gras
\q2 we san i bonem i drae.
\q1 Mo mi no moa save harem nating
\q2 se mi hanggri.
\q1
\v 5 Mi stap harem nogud mi krae gogo
\q3 mi kam bunbun olgeta,
\q2 we skin blong mi i go fas gud
\q4 long ol bun blong mi.
\q1
\v 6 Mi mi stap mi wan,
\q2 olsem wael pijin we i stap long draeples,
\q3 olsem hoknaet we i stap hem wan long olfala haos,
\q4 we i no moa gat man i stap long hem.
\q1
\v 7 Mi stap ledaon, be mi no save slip.
\q1 Mi olsem wan pijin we i no gat fren blong hem,
\q2 we hem i stap sidaon antap long haos.
\q1
\v 8 Oltaem ol enemi blong mi
\q2 oli stap tok nogud long mi,
\q3 i stat long moning go kasem sapa.
\q1 Olgeta we oli stap laf long mi
\q2 oli stap yusum nem blong mi
\q3 blong singaot* trabol i kam long man.
\b
\q1
\v 9-10 Yu yu harem nogud long mi,
\q3 mo yu kros tumas long mi,
\q2 nao asis i kam kakae blong mi
\q3 mo wota blong ae blong mi i miksap
\q4 wetem wota blong mi blong dring.
\q1 Yu yu holem mi,
\q2 yu sakem mi mi go longwe.
\q1
\v 11 Laef blong mi i stap go kwiktaem
\q2 olsem san we klosap i go lus.
\q1 Mi mi olsem gras we i drae finis.
\b
\q1
\v 12 Be yu, Hae God,
\q2 bambae yu yu King oltaem
\q3 gogo i no save finis.
\q1 Olgeta man we bambae oli stap kam biaen
\q2 bambae oli stap tingbaot yu.
\q1
\v 13 Naoia, i gud yu yu sore long Saeon,*
\q2 yu girap, yu givhan long hem,
\q3 from we taem i kam finis blong yu sore long hem,
\q4 naoia i prapa taem blong hem.
\q1
\v 14 I nomata we ol enemi blong yu
\q3 oli spolem ples ya finis,
\q2 be mifala ol man blong yu,
\q4 mifala i stap laekem hem yet.
\q1 Nating we ples ya i kam nogud finis,
\q3 be mifala i stap sore long hem yet.
\sp (Tok i go long ol man.)
\q1
\v 15 Olgeta man blong ol narafala kantri
\q3 bambae oli fraet gud long Hae God,
\q2 mo olgeta king long wol
\q4 bambae oli fraet long bigfala paoa blong hem.
\q1
\v 16 Taem hem i wokem Saeon i gud bakegen,
\q2 bambae hem i kamtru
\q3 long bigfala laet ya we i soemaot paoa blong hem.
\q1
\v 17 Yumi ol man blong hem
\q3 mo hem i bin lego yumi
\q2 be bambae hem i harem prea blong yumi,
\q4 bambae hem i lesin long yumi.
\b
\q1
\v 18-20 Hae God i stap long tabu ples blong hem long heven,
\q2 i lukluk i kamdaon long wol.
\q1 Hem i harem krae blong ol man
\q2 we oli stap long kalabus.
\q1 Olgeta we kot i jajem olgeta finis
\q3 se oli mas ded,
\q2 hem i mekem olgeta oli fri.\f + \fr 102.18-20: \ft Narafala rod blong tanem tok ya long medel blong trifala vas ya i olsem. \fqa Hem i harem krae blong \+bd yumi,\+bd* \fqa we \+bd yumi\+bd* s\fqa tap long kalabus. \+bd Yumi ya\+bd* \fqa we kot i jajem \+bd yumi\+bd* \fqa finis se \+bd yumi\+bd* \fqa mas ded, hem i mekem \+bd yumi\+bd* \fqa fri.\f*
\q1 I gud yumi raetemdaon ol samting ya
\q3 we Hae God i mekem,
\q2 blong ol man we oli no bon yet
\q4 bambae oli save ridim,
\q3 nao bambae oli stap presem hem from.
\q1
\v 21-22 Nao sipos ol man blong olgeta kantri mo olgeta kingdom
\q2 oli kam wanples blong mekem wosip long Hae God
\q4 long Saeon,
\q3 bambae oli save talemaot nem blong hem
\q4 mo bambae oli save presem hem.
\b
\q1
\v 23 Mi mi yangfala yet,
\q2 be Hae God i mekem mi mi no moa strong,
\q3 hem i katem laef blong mi i kam sotfala.
\q1
\v 24 Mi mi talem se,
\q2 “Hae God, yu yu God blong mi.
\q2 Yu yu no save ded,
\q3 bambae yu stap oltaem.
\q2 Plis yu no tekemaot mi naoia
\q3 we mi mi no olfala yet.
\q2
\v 25 \x - \xo 102.25: \xt Hib 1.10-12\x*Bifo olgeta,
\q3 yu yu mekem wol ya,
\q4 mo long han blong yu nomo
\q3 yu mekem evri samting we i stap long skae.
\q2
\v 26 Olgeta samting ya bambae oli lus,
\q3 bambae oli brobrok olsem klos,
\q4 be yu bambae yu stap oltaem nomo.
\q2 Bambae yu yu sakem olgeta samting ya
\q3 olsem klos we i kam olfala finis
\q4 nao bambae oli lus olgeta.
\q2
\v 27 Be yu,
\q3 oltaem yu yu stap sem mak nomo,
\q4 mo neva bambae laef blong yu i finis.
\q2
\v 28 Mifala i man blong wok blong yu.
\q2 Ol pikinini blong mifala
\q4 bambae oli stap gud, oli sef,
\q3 mo olgeta we bambae oli stap kamaot biaen long olgeta,
\q4 bambae yu yu lukaot gud long olgeta.
\q2 Bambae oli stap gud oltaem long han blong yu.”
\c 103
\s Hae God i lavem yumi tumas
\sp (Sing ya, Deved i wokem.)
\sp (Tok i go long ol man.)
\q1
\v 1 !Oltaem mi mi mas presem Hae God!
\q1 !Long olgeta laef blong mi,
\q2 mi mas presem tabu nem blong hem!
\q1
\v 2 Mi mi mas presem hem,
\q2 mo mi no save fogetem
\q3 we hem i kaen tumas long mi.
\q1
\v 3 Hem i stap fogivim mi,
\q3 i stap tekemaot ol sin blong mi.
\q1 Hem i stap tekemaot ol sik blong mi,
\q2 i mekem mi mi gud bakegen,
\q3
\v 4 mo i stap lukaot gud long mi
\q3 blong mi mi no ded.
\q1 Hem i lavem mi tumas,
\q3 mo i sore tumas long mi,
\q2 nao oltaem hem i stap mekem
\q4 i gud tumas long mi.
\q1
\v 5 Oltaem hem i stap mekem mi mi harem gud
\q2 long ol gudgudfala samting ya
\q3 we hem i stap givim long mi,
\q2 mo i mekem mi mi stap yang,
\q3 mi stap strong oltaem,
\q4 olsem bigfala pijin ya igel.*
\b
\q1
\v 6 Taem Hae God i mekem kot,
\q2 oltaem hem i stap givhan long man
\q3 we narafala man i stap mekem
\q4 i no stret long hem.
\q1 Oltaem hem i stap mekem rod
\q2 blong man olsem i kasem ol samting
\q3 we hem i gat raet blong kasem.
\q1
\v 7 Bifo, hem i stap soemaot ol plan blong hem long Moses,
\q2 mo i letem ol laen* blong Isrel*
\q3 oli luk ol bigbigfala wok blong hem.
\q1
\v 8 \x - \xo 103.8: \xt Jem 5.11\x*Hae God, hem i gat sore,
\q2 mo oltaem hem i glad tumas
\q3 blong mekem i gud long man.
\q1 Hem i no save kros kwik,
\q2 fasin blong hem we oltaem i stap lavem man tumas,
\q3 hem i gud we i gud, i bitim mak.
\q1
\v 9 Hem i no save gohed oltaem
\q3 blong tok strong long man,
\q2 mo kros blong hem
\q4 i no save stap olwe.
\q1
\v 10 Hem i no save panisim yumi
\q3 stret long mak blong ol sin blong yumi,
\q2 mo hem i no save givimbak
\q3 ol fasin nogud ya long yumi
\q4 we yumi stap mekem long hem.
\q1
\v 11 Fasin ya blong hem
\q3 we oltaem hem i stap lavem ol man
\q3 we oli stap ona long hem,
\q2 hem i gud tumas.
\q1 Lav ya blong hem i bigfala tumas,
\q2 i hae moa i bitim skae antap.
\q1
\v 12 Ol sin ya blong yumi,
\q2 hem i stap tekemaot olgeta
\q4 i go longwe we longwe long yumi,
\q3 olsem we saed long is
\q3 i stap longwe long saed long wes.
\q1
\v 13 Fasin blong Hae God,
\q2 oltaem hem i stap mekem i gud tumas
\q4 long olgeta we oli stap ona long hem,
\q3 olsem we ol papa oli stap mekem
\q3 long ol pikinini blong olgeta.
\q1
\v 14 Hem i savegud
\q2 we hem i mekem yumi long graon.
\q1 Oltaem hem i stap tingbaot
\q2 we yumi kamaot long asis nomo.
\b
\q1
\v 15 Yumi man,
\q2 laef blong yumi i olsem gras nomo.
\q1 Yumi olsem wael flaoa,
\q3 we i gru, i kam strong,
\q2
\v 16 be win i blu long hem,
\q4 nao i lus, man i no moa save luk bakegen.
\q1
\v 17-18 Be ol man we oli stap ona long Hae God,
\q2 oltaem bambae hem i stap lavem olgeta,
\q3 gogo i no save finis.
\q1 Mo sipos olgeta we oli stap kamaot biaen long olgeta
\q2 oli stap holem promes* ya
\q4 we hem i mekem wetem ol olfala blong olgeta,
\q3 mo oli stap obei long ol loa blong hem,
\q2 gudfala fasin blong hem
\q3 bambae i stap oltaem long olgeta,
\q4 gogo i no save finis.
\b
\q1
\v 19 Hae God, hem i King.
\q1 Hem i stap long ples blong hem long heven,
\q2 mo i stap rul long olgeta samting.
\q1
\v 20 Yufala ol enjel, yufala i strong,
\q2 mo yufala i gat paoa.
\q1 Oltaem yufala i stap obei
\q3 long ol tok blong Hae God,
\q2 mo yufala i stap lesin
\q4 long ol samting we hem i talem.
\q1 !Yufala i mas presem hem!
\q1
\v 21 Yufala olgeta long heven,
\q2 yufala i man blong wok blong Hae God.
\q1 Yufala i gat paoa,
\q2 mo yufala i stap mekem ol samting we hem i wantem.
\q1 !Yufala i mas presem hem!
\q1
\v 22 Yufala olgeta samting
\q3 we Hae God i mekem yufala,
\q2 yufala i stap long evri ples
\q4 we hem i stap rul long hem.
\q1 !Yufala i mas presem hem!
\q1 !Mi mi mas presem Hae God!
\c 104
\s Sing blong presem Hae God from we hem i mekem evri samting
\sp (Tok i go long Hae God.)
\q1
\v 1 !Hae God.
\q1 Oltaem mi mi mas presem yu!
\q1 !Yu yu God blong mi,
\q2 mo yu yu hae tumas!
\q1 !Yu yu King!
\q1 Hae nem blong yu mo paoa blong yu,
\q3 tufala i olsem klos blong yu,
\q2
\v 2 mo laet ya we i stap soemaot bigfala paoa blong yu,
\q4 hem i olsem klos we yu yu stap putum.
\q1 Yu yu putumap skae
\q2 olsem haos tapolen blong yu.
\q1
\v 3 Yu mekem haos ya blong yu
\q2 antap long wota we i stap antap.\f + \fr 104.3: \ft Wota ya we i stap antap, yu luk tok blong hem long Jenesis 1.6-7.\f*
\q1 Yu stap yusum klaod
\q3 olsem kat blong yu we hos i pulum,
\q2 mo taem win i blu,
\q4 yu stap raed long hem olsem hos blong yu.
\q1
\v 4 \x - \xo 104.4: \xt Hib 1.7\x*Yu stap yusum ol win
\q3 olsem ol man blong karem tok blong yu,
\q2 mo yu yusum ol laetning
\q4 olsem ol man blong wok blong yu.
\b
\q1
\v 5 Yu yu putum wol ya
\q2 i stap strong long fandesen blong hem,
\q3 we bambae hem i no save muf nating.
\q1
\v 6 Yu putum bigfala solwota
\q3 blong kavremap hem olsem klos blong hem,
\q2 mo solwota ya i kavremap olgeta hil.
\q1
\v 7 Be taem yu tok strong long solwota ya,
\q2 hem i godaon.
\q1 Voes blong yu i olsem tanda,
\q2 mo taem hem i harem, hem i ronwe.
\q1
\v 8 Solwota ya i ron i godaon,
\q2 nao ol hil mo ol krik
\q4 oli kamkamaot,
\q3 mo hem i go stap long ples
\q4 we yu yu makem blong hem i stap long hem.
\q1
\v 9 Yu yu putum mak
\q3 we solwota bambae i go finis long hem,
\q2 mo yu blokem hem
\q4 blong i no save kam kavremap wol ya bakegen.
\b
\q1
\v 10 Yu yu mekem ol springwota
\q3 oli stap ron long ol krik,
\q2 mo yu mekem ol reva
\q4 oli stap ron long medel blong ol hil.
\q1
\v 11 Ol wael dongki wetem ol narafala wael anamol
\q2 oli stap dring long ol wota ya,
\q3 blong oli harem gud.
\q1
\v 12 Ol pijin oli stap mekem nes blong olgeta,
\q2 long ol tri long saed blong ol wota ya,
\q3 mo oltaem oli stap singsing.
\b
\q1
\v 13 Yu yu sanem ren i aot long skae i kam,
\q3 i wasem ol hil,
\q2 mo graon i fulap long ol gudgudfala samting
\q4 we yu yu mekem.
\q1
\v 14 Yu mekem gras i gru
\q3 blong ol anamol oli kakae,
\q2 mo yu mekem ol samting
\q4 we man i save planem.
\q1 From samting ya,
\q2 man i save wokem ol garen blong hem,
\q3
\v 15 nao i save mekem waen
\q3 blong mekem hem i glad,
\q4 mo i save tekem olifoel* // blong mekem fes blong hem i saen,
\q3 mo i save tekem kakae // blong mekem hem i strong.
\sp (Tok i go long ol man.)
\q1
\v 16 Ol sida* long Lebanon oli blong Hae God,
\q3 hem nomo i planem,
\q2 mo oltaem ren i stap kasemgud olgeta.
\q1
\v 17 Ol pijin oli stap mekem nes blong olgeta
\q3 long ples ya,
\q2 mo ol bigfala pijin oli stap mekem nes blong olgeta
\q4 long ol bigbigfala paentri* long ples ya.
\q1
\v 18 Ol bigfala hil i ples blong wael nani,
\q2 mo ol klif i ples blong haed blong anamol ya baja.*
\sp (Tok i go long Hae God.)
\q1
\v 19 Hae God.
\q1 Yu yu mekem mun blong makem ol manis.
\q1 Evri dei, san i savegud
\q2 taem blong hem blong go draon.
\q1
\v 20 Yu yu mekem naet,
\q2 mo long tudak,
\q3 olgeta wael anamol oli stap kamkamaot.
\q1
\v 21 Taem ol yang laeon oli go blong lukaot kakae,
\q2 oli stap singsingaot bigwan.
\q1 Oli stap lukaot kakae ya
\q2 we yu yu stap givim long olgeta.
\q1
\v 22 Be taem san i girap,
\q2 oli gobak long ol hol blong olgeta,
\q3 oli stap slip.
\q1
\v 23 Nao ol man oli go blong mekem ol wok blong olgeta,
\q2 mo oli stap wok gogo kasem sapa.
\b
\q1
\v 24 Hae God.
\q1 Yu yu mekem plante naranarafala samting,
\q2 mo olgeta evriwan oli stap soemaot
\q3 we fasin blong yu blong wokem
\q4 olgeta i waes we i waes.
\q1 Wol ya i fulap long olgeta samting
\q2 we yu yu mekem.
\q1
\v 25 I gat solwota i stap
\q3 we i bigfala tumas,
\q2 mo i gat plante samting we yu yu mekem
\q4 oli stap insaed long hem.
\q1 Ol samting ya, samfala oli bigbigwan,
\q2 mo samfala oli smosmol.
\q1 Olgeta oli plante tumas,
\q2 we man i no save kaontem olgeta.
\q1
\v 26 \x - \xo 104.26: \xt Job 41.1; Sam 74.14; Aes 27.1\x*Ol sip oli stap ron long solwota ya,
\q2 mo leviatan,*
\q3 bigfala anamol ya blong solwota
\q4 we yu yu mekem,
\q2 hem i stap pleplei insaed long hem.
\b
\q1
\v 27 Olgeta ya evriwan,
\q2 taem oli hanggri, oli stap luk long yu,
\q3 blong yu givim kakae long olgeta.
\q1
\v 28 Taem yu givim kakae long olgeta,
\q2 olgeta oli kakae, mo oli harem gud.
\q1
\v 29 Taem yu gowe long olgeta,
\q2 olgeta oli harem nogud.
\q1 Taem yu tekemaot win blong olgeta,
\q2 olgeta oli ded,
\q3 oli gobak long asis
\q4 we oli kamaot long hem.
\q1
\v 30 Taem yu givim win blong yu long olgeta,
\q2 yu mekem olgeta oli laef.\f + \fr 104.30: \ft Narafala rod blong tanem tok long fas haf blong vas ya i olsem. \fqa Taem yu \+bd sanem Spirit\+bd* \fqa blong yu \+bd i kam\+bd* \fqa long olgeta, yu mekem olgeta oli laef.\f*
\q1 Oltaem yu yu mekem olgeta samting long graon ya
\q2 oli gat niufala laef.
\sp (Tok i go long ol man.)
\q1
\v 31 Prea blong mi,
\q2 we ol gudgudfala samting ya
\q4 we oli stap soemaot paoa blong Hae God,
\q3 bambae oli stap oltaem nomo
\q3 gogo i no save finis.
\q1 Mi mi wantem
\q2 we oltaem bambae hem i glad
\q3 long olgeta samting ya we hem i mekem.
\q1
\v 32 Taem hem i lukluk i kam long wol,
\q2 graon i seksek.
\q1 Taem hem i tajem ol hil,
\q2 smok i kamaot long olgeta.
\b
\q1
\v 33 Oltaem long laef blong mi,
\q2 bambae mi stap singsing blong presem Hae God,
\q3 gogo laef blong mi i finis.
\q1
\v 34 Mi wantem we hem bambae i harem gud
\q3 long sing ya blong mi,
\q2 from we oltaem,
\q4 hem i stap mekem mi mi glad.
\q1
\v 35 Prea blong mi
\q2 we hem bambae i brumumaot ol man nogud
\q3 oli gowe long wol ya,
\q4 we bambae i no moa gat wan long olgeta i stap.
\b
\q1 !Mi mi mas presem Hae God!
\q1 !Oltaem yumi evriwan i mas presem hem!
\c 105
\s Hae God i stap givhan gud long ol man blong hem
\r (1 Kronikel 16.8-22)
\sp (Tok i go long ol man.)
\q1
\v 1 !Yumi talem tangkiu long Hae God!
\q1 !Yumi talemaot hae nem blong hem!
\q1 Yumi go long olgeta man blong ol narafala kantri,
\q2 yumi talemaot ol samting ya we hem i bin mekem.
\q1
\v 2 Yumi sing, yumi presem hem.
\q1 Yumi talemaot ol bigbigfala samting ya
\q2 we hem i bin mekem.
\q1
\v 3 Yumi evriwan ya
\q3 we yumi stap mekem wosip long hem,
\q2 yumi mas glad,
\q3 from we tabu nem blong hem
\q4 i stap long yumi.
\q1
\v 4 Yumi mas luk long Hae God
\q2 blong hem i givhan long yumi,
\q3 mo oltaem,
\q4 yumi mas mekem wosip long hem.
\q1
\v 5-6 Yumi ya,
\q2 yumi laen* blong Ebraham,
\q4 we i man blong wok blong Hae God,
\q3 mo yumi laen blong Isrel,*
\q3 we Hae God i jusumaot hem.
\q1 Oltaem yumi mas tingbaot ol merikel
\q2 we hem i mekem,
\q3 mo ol rul blong hem
\q4 we hem i givim blong jajem man.
\b
\q1
\v 7 Hae God,
\q2 hem i God blong yumi.
\q1 Ol tok we hem i talem
\q2 i blong olgeta man long wol.
\q1
\v 8 Promes* ya we hem i mekem wetem yumi
\q2 bambae hem i no save fogetem samtaem.
\q1 Oltaem bambae hem i stap holem promes ya
\q2 we i mekem wetem yumi,
\q3 mo wetem olgeta we bambae oli kamaot biaen long yumi,
\q4 gogo i no save finis.
\q1
\v 9 \x - \xo 105.9 a: \xt Jen 12.7; 17.8; \xo b: \xt Jen 26.3\x*Promes ya,
\q2 hem i mekem fastaem wetem Ebraham bifo,
\q2 mo biaen, i mekem bakegen wetem Aesak,
\q3 mo i givim strong tok long hem
\q4 blong mekem promes ya i stanap.
\q1
