<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">--- Open Bislama Bible Revised</book>
  <para style="h">OL SAM</para>
  <para style="mt1">OL SAM</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">BUK WAN</para>
  <para style="s2">(Sam 1-41)</para>
  <para style="s">Ol man we oli save harem gud tru</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Olgeta we oli no wantem folem toktok</para>
  <para style="q3" vid="PSA 1:1">blong ol man nogud,</para>
  <para style="q2" vid="PSA 1:1">mo we oli no wantem folem</para>
  <para style="q4" vid="PSA 1:1">fasin blong olgeta,</para>
  <para style="q3" vid="PSA 1:1">mo we oli no wantem joen wetem olgeta</para>
  <para style="q3" vid="PSA 1:1">we oli stap laf long God,</para>
  <para style="q2" vid="PSA 1:1">olgeta ya oli save harem gud.<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />Ol man olsem,</para>
  <para style="q2" vid="PSA 1:2">oli glad blong folem Loa* blong Hae God,</para>
  <para style="q3" vid="PSA 1:2">mo oltaem oli stap ridim,</para>
  <para style="q4" vid="PSA 1:2">mo oli stap tingting long hem</para>
  <para style="q3" vid="PSA 1:2">long dei mo long naet.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1.3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 17:8">Jer 17.8</ref>
      </char>
    </note>Olgeta ya oli olsem ol tri</para>
  <para style="q2" vid="PSA 1:3">we oli gru long saed blong wota</para>
  <para style="q3" vid="PSA 1:3">we i stap ron.</para>
  <para style="q1" vid="PSA 1:3">Ol tri ya oli stap karem frut</para>
  <para style="q2" vid="PSA 1:3">long stret taem blong olgeta,</para>
  <para style="q3" vid="PSA 1:3">mo lif blong olgeta i no save drae.</para>
  <para style="q1" vid="PSA 1:3">Mo long sem fasin,</para>
  <para style="q2" vid="PSA 1:3">ol man ya tu oli stap win</para>
  <para style="q3" vid="PSA 1:3">long evri samting we oli stap mekem.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Be ol man nogud oli no olsemia nating,</para>
  <para style="q2" vid="PSA 1:4">oli olsem doti blong wit* nomo,</para>
  <para style="q3" vid="PSA 1:4">we win i stap karem i go.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />God bambae i jajem olgeta,</para>
  <para style="q3" vid="PSA 1:5">se oli lus,</para>
  <para style="q2" vid="PSA 1:5">mo bambae i seraot olgeta</para>
  <para style="q4" vid="PSA 1:5">oli gowe long ol man blong hem.<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Rod blong ol man nogud ya</para>
  <para style="q3" vid="PSA 1:6">i rod blong lus,</para>
  <para style="q2" vid="PSA 1:6">be ol stret man,</para>
  <para style="q4" vid="PSA 1:6">oltaem Hae God i stap lukaot gud long olgeta,</para>
  <para style="q3" vid="PSA 1:6">mo i stap lidim olgeta long rod blong olgeta.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">King we God i jusumaot</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.1: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 4:25">Wok 4.25</ref>,<ref loc="ACT 4:26">26</ref></char>
    </note>?From wanem ol narafala kantri</para>
  <para style="q2" vid="PSA 2:1">oli stap mekem plan blong mekem trabol?</para>
  <para style="q1" vid="PSA 2:1">?From wanem ol man blong olgeta</para>
  <para style="q2" vid="PSA 2:1">oli stap mekem ol plan</para>
  <para style="q3" vid="PSA 2:1">we oli no save win long hem nating?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Ol king blong olgeta oli girap,</para>
  <para style="q2" vid="PSA 2:2">oli putum wan tok we i agens long Hae God,</para>
  <para style="q3" vid="PSA 2:2">mo i agens long king ya tu</para>
  <para style="q4" vid="PSA 2:2">we hem i makemaot hem</para>
  <para style="q3" vid="PSA 2:2">i putumap hem blong mekem wok blong hem.<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />Oli stap talem se,</para>
  <para style="q2" vid="PSA 2:3">“Yumi brekemaot ol rop ya</para>
  <para style="q3" vid="PSA 2:3">we tufala i stap fasem yumi long hem.</para>
  <para style="q2" vid="PSA 2:3">Yumi kamaot long han blong tufala ya</para>
  <para style="q3" vid="PSA 2:3">blong yumi fri.”<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Hae God, hem i King.</para>
  <para style="q1" vid="PSA 2:4">Hem i stap sidaon long heven,</para>
  <para style="q2" vid="PSA 2:4">i stap laf.</para>
  <para style="q1" vid="PSA 2:4">Hem i stap laf gud</para>
  <para style="q2" vid="PSA 2:4">long ol rabis plan blong olgeta.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Mo hem i kros,</para>
  <para style="q2" vid="PSA 2:5">i tok strong long olgeta,</para>
  <para style="q3" vid="PSA 2:5">i talem se, “!Yufala i lukaot, a!”</para>
  <para style="q1" vid="PSA 2:5">Mo from we hem i kros olsem,</para>
  <para style="q2" vid="PSA 2:5">olgeta oli fraet, oli seksek.<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />Hem i talem se,</para>
  <para style="q2" vid="PSA 2:6">“Mi mi putumap king blong mi finis</para>
  <para style="q3" vid="PSA 2:6">long Saeon,*</para>
  <para style="q4" vid="PSA 2:6">tabu hil ya blong mi.”<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.7: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:33">Wok 13.33</ref>; <ref loc="HEB 1:5">Hib 1.5</ref>; <ref loc="HEB 5:5">5.5</ref></char>
    </note>King ya i talem se,</para>
  <para style="q2" vid="PSA 2:7">“Bambae mi mi talemaot samting ya</para>
  <para style="q3" vid="PSA 2:7">we Hae God i talem.</para>
  <para style="q2" vid="PSA 2:7">Hem i talem long mi se,</para>
  <para style="q3" vid="PSA 2:7">‘Yu yu pikinini blong mi.</para>
  <para style="q3" vid="PSA 2:7">Tede mi mi kam stret Papa blong yu.<verse eid="PSA 2:7" /></para>
  <para style="q3">
    <verse number="8" style="v" sid="PSA 2:8" />Ol narafala kantri ya,</para>
  <para style="q4" vid="PSA 2:8">wetem olgeta man long wol,</para>
  <para style="q3" vid="PSA 2:8">yu yu save askem olgeta long mi,</para>
  <para style="q4" vid="PSA 2:8">nao mi bambae mi givim olgeta long yu, <optbreak /> oli blong yu.<verse eid="PSA 2:8" /></para>
  <para style="q3">
    <verse number="9" style="v" sid="PSA 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.9: </char>
      <char style="xt" closed="false">
        <ref loc="REV 2:26">Rev 2.26</ref>,<ref loc="REV 2:27">27</ref>; <ref loc="REV 12:5">12.5</ref>; <ref loc="REV 19:15">19.15</ref></char>
    </note>Bambae yu yu kilim ol man ya</para>
  <para style="q3" vid="PSA 2:9">long wan aean,</para>
  <para style="q4" vid="PSA 2:9">bambae yu smasem olgeta</para>
  <para style="q3" vid="PSA 2:9">long ol smosmol pis, <optbreak /> olsem graonpot we i brobrok.’ ”<verse eid="PSA 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Ol king.</para>
  <para style="q1" vid="PSA 2:10">Yufala i mas harem tok ya we mi talem</para>
  <para style="q2" vid="PSA 2:10">se yufala i mas lukaot.</para>
  <para style="q1" vid="PSA 2:10">Ol lida blong wol.</para>
  <para style="q1" vid="PSA 2:10">Yufala i mas lanem mining</para>
  <para style="q2" vid="PSA 2:10">blong samting ya.<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />Yufala i mas wok blong Hae God,</para>
  <para style="q2" vid="PSA 2:11">we yufala i ona gud long hem.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />I gud yufala i fraet long hem,</para>
  <para style="q2" vid="PSA 2:12">nao yufala i bodaon long hem.<note caller="+" style="f"><char style="fr" closed="false">2.12: </char><char style="ft" closed="false">Narafala rod blong tanem tok long vas 11 wetem fas haf blong vas 12 i olsem. </char><char style="fqa" closed="false">Yufala i mas wok blong Hae God, we yufala i ona gud long hem. Yufala i mas mekem tingting blong yufala i stap daon, mo yufala i glad. </char><char style="fv">12</char> Yufala i mas <char style="fqa" closed="false">bodaon long <char style="bd">pikinini blong</char> </char><char style="fqa" closed="false">hem.</char></note></para>
  <para style="q1" vid="PSA 2:12">Sipos no,</para>
  <para style="q2" vid="PSA 2:12">kwiktaem nomo bambae hem i kros,</para>
  <para style="q3" vid="PSA 2:12">nao wantaem nomo bambae yufala i ded.</para>
  <para style="q1" vid="PSA 2:12">Olgeta man we oli stap go long hem</para>
  <para style="q2" vid="PSA 2:12">blong hem i lukaot gud long olgeta,</para>
  <para style="q4" vid="PSA 2:12">oli save harem gud.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">Prea we man i prea long hem long moning</para>
  <para style="sp">(Sing ya, Deved i wokem biaen long taem ya we hem i ronwe long pikinini blong hem Absalom we i wantem kilim hem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />Hae God.</para>
  <para style="q1" vid="PSA 3:1">Mi mi gat plante enemi blong mi.</para>
  <para style="q1" vid="PSA 3:1">Olgeta oli plante tumas</para>
  <para style="q3" vid="PSA 3:1">we oli stap agens long mi.<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Oli tokbaot mi, oli talem se,</para>
  <para style="q2" vid="PSA 3:2">“God bambae i no save givhan long hem.”<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Hae God.</para>
  <para style="q1" vid="PSA 3:3">Yu yu olsem wan sil.*</para>
  <para style="q1" vid="PSA 3:3">Oltaem yu stap blokemgud mi</para>
  <para style="q2" vid="PSA 3:3">blong trabol i no kasem mi.</para>
  <para style="q1" vid="PSA 3:3">Yu yu stap mekem mi mi win,</para>
  <para style="q2" vid="PSA 3:3">mo yu stap mekem tingting blong mi i strong bakegen.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Oltaem mi stap krae i kam long yu</para>
  <para style="q2" vid="PSA 3:4">blong yu givhan long mi.</para>
  <para style="q1" vid="PSA 3:4">Mo yu yu stap long tabu hil* blong yu,</para>
  <para style="q2" vid="PSA 3:4">nao yu stap ansa long mi.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Hae God.</para>
  <para style="q1" vid="PSA 3:5">Long naet mi mi ledaon, mi slip gud,</para>
  <para style="q2" vid="PSA 3:5">mo long moning mi wekap bakegen,</para>
  <para style="q3" vid="PSA 3:5">from we yu stap lukaot gud long mi.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />I gat ten taosen enemi</para>
  <para style="q2" vid="PSA 3:6">we oli hivap raon long mi,</para>
  <para style="q3" vid="PSA 3:6">oli stap agens long mi,</para>
  <para style="q4" vid="PSA 3:6">be mi mi no save fraet long olgeta.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />!Hae God, yu yu God blong mi!</para>
  <para style="q1" vid="PSA 3:7">!Plis yu kam, yu sevem mi!</para>
  <para style="q1" vid="PSA 3:7">Oltaem yu stap panisim ol enemi blong mi,</para>
  <para style="q2" vid="PSA 3:7">yu stap brekemdaon paoa blong olgeta.<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Paoa blong sevem man i blong yu nomo.</para>
  <para style="q1" vid="PSA 3:8">Mi wantem blong yu blesem ol man blong yu.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">Prea we man i prea long hem long naet</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong sing wetem gita.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />God,</para>
  <para style="q2" vid="PSA 4:1">oltaem yu stap mekem mi mi kasem ol samting</para>
  <para style="q3" vid="PSA 4:1">we mi gat raet blong kasem.</para>
  <para style="q1" vid="PSA 4:1">Sipos mi mi prea long yu,</para>
  <para style="q2" vid="PSA 4:1">plis yu ansa long mi.</para>
  <para style="q1" vid="PSA 4:1">Taem we mi mi stap long trabol,</para>
  <para style="q2" vid="PSA 4:1">yu yu stap halpem mi.</para>
  <para style="q1" vid="PSA 4:1">Naoia, plis yu kaen long mi,</para>
  <para style="q2" vid="PSA 4:1">yu harem prea blong mi.<verse eid="PSA 4:1" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Olgeta.</para>
  <para style="q1" vid="PSA 4:2">?Bambae yufala i stap spolem nem blong mi</para>
  <para style="q2" vid="PSA 4:2">gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 4:2">?Bambae yufala i stap laekem samting we i nogud</para>
  <para style="q2" vid="PSA 4:2">gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 4:2">?Mo bambae yufala i stap folem fasin blong giaman</para>
  <para style="q2" vid="PSA 4:2">gogo kasem wetaem?<verse eid="PSA 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Yufala i mas tingbaot</para>
  <para style="q2" vid="PSA 4:3">we Hae God i bin jusumaot ol stret man</para>
  <para style="q3" vid="PSA 4:3">oli blong hem,</para>
  <para style="q2" vid="PSA 4:3">mo taem mi mi prea long hem</para>
  <para style="q3" vid="PSA 4:3">hem i stap harem mi.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4.4: </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:26">Efes 4.26</ref>
      </char>
    </note>I gud yufala i fraet, yufala i seksek,</para>
  <para style="q2" vid="PSA 4:4">nao yufala i no moa mekem sin.<note caller="+" style="f"><char style="fr" closed="false">4.4: </char><char style="ft" closed="false">Narafala rod blong tanem tok long fas haf blong vas ya i olsem. </char><char style="fqa" closed="false">Yufala i save kros, be i nogud yufala i mekem samting nogud.</char></note></para>
  <para style="q1" vid="PSA 4:4">Taem yufala i stap long bed blong yufala,</para>
  <para style="q2" vid="PSA 4:4">i gud yufala i stap kwaet,</para>
  <para style="q3" vid="PSA 4:4">yufala i tingting gud long ol samting ya.<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Yufala i mas mekem ol sakrefaes long Hae God,</para>
  <para style="q3" vid="PSA 4:5">olsem we loa i talem,</para>
  <para style="q2" vid="PSA 4:5">mo yufala i mas trastem hem.<verse eid="PSA 4:5" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Hae God.</para>
  <para style="q1" vid="PSA 4:6">I gat plante man we oli stap prea se,</para>
  <para style="q2" vid="PSA 4:6">“Hae God.</para>
  <para style="q2" vid="PSA 4:6">Plis yu givim plante gudfala samting moa long mifala.</para>
  <para style="q2" vid="PSA 4:6">Yu luk long mifala,</para>
  <para style="q3" vid="PSA 4:6">yu kaen long mifala.”<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Taem olgeta ya oli kasem</para>
  <para style="q3" vid="PSA 4:7">plante kakae mo plante waen,</para>
  <para style="q2" vid="PSA 4:7">oli harem gud tumas.</para>
  <para style="q1" vid="PSA 4:7">Be yu yu mekem mi mi glad,</para>
  <para style="q2" vid="PSA 4:7">mi harem gud moa, i winim olgeta.<verse eid="PSA 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Hae God.</para>
  <para style="q1" vid="PSA 4:8">Taem mi mi ledaon,</para>
  <para style="q2" vid="PSA 4:8">tingting blong mi i kwaet,</para>
  <para style="q3" vid="PSA 4:8">nao mi slip gud,</para>
  <para style="q2" vid="PSA 4:8">from we yu nomo yu stap lukaot gud long mi,</para>
  <para style="q3" vid="PSA 4:8">nao mi mi sef.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">Prea we man i mekem blong God i lukaot gud long hem</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong sing wetem bambu paep.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />Hae God.</para>
  <para style="q1" vid="PSA 5:1">Plis yu lesin long ol tok blong mi.</para>
  <para style="q1" vid="PSA 5:1">Mi mi stap harem nogud</para>
  <para style="q2" vid="PSA 5:1">we mi krae from.</para>
  <para style="q1" vid="PSA 5:1">Plis yu lukluk i kam long mi.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 5:2">mo yu yu King blong mi.</para>
  <para style="q1" vid="PSA 5:2">Mi mi stap krae long yu</para>
  <para style="q2" vid="PSA 5:2">blong yu givhan long mi.</para>
  <para style="q1" vid="PSA 5:2">Plis yu harem krae blong mi.</para>
  <para style="b" vid="PSA 5:2" />
  <para style="q1" vid="PSA 5:2">Hae God.</para>
  <para style="q1" vid="PSA 5:2">Mi mi stap prea long yu nomo,<verse eid="PSA 5:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 5:3" />mo oltaem, long moning,</para>
  <para style="q3" vid="PSA 5:3">yu yu harem mi.</para>
  <para style="q1" vid="PSA 5:3">Taem san i girap,</para>
  <para style="q2" vid="PSA 5:3">mi mi kam long fes blong yu,</para>
  <para style="q3" vid="PSA 5:3">mi prea,</para>
  <para style="q2" vid="PSA 5:3">mo mi stap wet</para>
  <para style="q3" vid="PSA 5:3">blong yu yu ansa long mi.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Yu yu no olsem ol narafala god ya</para>
  <para style="q2" vid="PSA 5:4">we oli stap glad long ol rabis fasin.</para>
  <para style="q1" vid="PSA 5:4">Man we i stap mekem i nogud,</para>
  <para style="q2" vid="PSA 5:4">hem i no save stap wetem yu.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Ol praod man oli no save stanap</para>
  <para style="q3" vid="PSA 5:5">long fes blong yu,</para>
  <para style="q2" vid="PSA 5:5">mo yu no laekem ol man nogud nating.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />Yu yu stap flatemgud ol man blong giaman,</para>
  <para style="q2" vid="PSA 5:6">mo yu no laekem nating ol man blong faet</para>
  <para style="q3" vid="PSA 5:6">mo ol man blong trikim man,</para>
  <para style="q2" vid="PSA 5:6">yu stap agens long olgeta.<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Be from we oltaem yu yu stap lavem man tumas,</para>
  <para style="q2" vid="PSA 5:7">mi mi save kam long haos* blong yu.</para>
  <para style="q1" vid="PSA 5:7">Mi save mekem wosip long yu</para>
  <para style="q3" vid="PSA 5:7">long tabu haos blong yu,</para>
  <para style="q2" vid="PSA 5:7">mi save bodaon long yu,</para>
  <para style="q4" vid="PSA 5:7">mi ona long yu.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />Hae God,</para>
  <para style="q2" vid="PSA 5:8">ol enemi blong mi oli plante we plante.</para>
  <para style="q1" vid="PSA 5:8">Plis yu lidim mi</para>
  <para style="q2" vid="PSA 5:8">blong mi mekem ol samting</para>
  <para style="q3" vid="PSA 5:8">we yu yu wantem,</para>
  <para style="q2" vid="PSA 5:8">yu mekem rod blong yu i klia long mi</para>
  <para style="q3" vid="PSA 5:8">blong mi mi folem.<verse eid="PSA 5:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5.9: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:13">Rom 3.13</ref>
      </char>
    </note>Ol samting ya</para>
  <para style="q2" vid="PSA 5:9">we ol enemi blong mi oli stap talem,</para>
  <para style="q3" vid="PSA 5:9">neva man i save trastem.</para>
  <para style="q1" vid="PSA 5:9">Long tingting blong olgeta,</para>
  <para style="q2" vid="PSA 5:9">oli wantem nomo blong kilim man i ded.</para>
  <para style="q1" vid="PSA 5:9">Ol tok blong olgeta i swit we i swit,</para>
  <para style="q2" vid="PSA 5:9">be i fulap long trik</para>
  <para style="q3" vid="PSA 5:9">blong mekem man i ded.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />God.</para>
  <para style="q1" vid="PSA 5:10">Plis yu jajem olgeta,</para>
  <para style="q3" vid="PSA 5:10">yu talemaot we oli rong,</para>
  <para style="q2" vid="PSA 5:10">mo yu panisim olgeta.</para>
  <para style="q1" vid="PSA 5:10">Plis yu mekem ol plan blong olgeta</para>
  <para style="q2" vid="PSA 5:10">i spolem olgeta bakegen.</para>
  <para style="q1" vid="PSA 5:10">Yu ronemaot olgeta oli go longwe,</para>
  <para style="q2" vid="PSA 5:10">from we oli mekem plante sin,</para>
  <para style="q3" vid="PSA 5:10">mo oli stap girap agens long yu.<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Be olgeta we oli sef long yu</para>
  <para style="q2" vid="PSA 5:11">bambae oli harem gud.</para>
  <para style="q1" vid="PSA 5:11">Bambae oli save sing oltaem</para>
  <para style="q2" vid="PSA 5:11">from we oli glad tumas.</para>
  <para style="q1" vid="PSA 5:11">Olgeta we oli lavem yu,</para>
  <para style="q2" vid="PSA 5:11">plis yu lukaot gud long olgeta,</para>
  <para style="q3" vid="PSA 5:11">yu sevem olgeta.</para>
  <para style="q1" vid="PSA 5:11">Yu nomo yu stap mekem olgeta</para>
  <para style="q2" vid="PSA 5:11">oli harem gud, oli glad.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Hae God.</para>
  <para style="q1" vid="PSA 5:12">Oltaem yu stap blesem olgeta</para>
  <para style="q2" vid="PSA 5:12">we oli stap obei long yu.</para>
  <para style="q1" vid="PSA 5:12">Fasin blong yu we yu lavem man</para>
  <para style="q2" vid="PSA 5:12">i olsem wan sil*</para>
  <para style="q3" vid="PSA 5:12">we i stap blokemgud olgeta.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">Prea we man i mekem long taem blong trabol</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong sing wetem mandolin.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6.1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:1">Sam 38.1</ref>
      </char>
    </note>Hae God.</para>
  <para style="q1" vid="PSA 6:1">Nating we yu yu kros long mi,</para>
  <para style="q2" vid="PSA 6:1">be plis yu no tok strong long mi.</para>
  <para style="q1" vid="PSA 6:1">Yu yu kros tumas long mi,</para>
  <para style="q2" vid="PSA 6:1">be plis yu no panisim mi.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Hae God.</para>
  <para style="q1" vid="PSA 6:2">Mi mi slak tumas.</para>
  <para style="q1" vid="PSA 6:2">Plis yu sore long mi.</para>
  <para style="q1" vid="PSA 6:2">Mi mi wik we mi wik,</para>
  <para style="q2" vid="PSA 6:2">plis yu mekem mi mi strong bakegen.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Long olgeta laef blong mi naoia,</para>
  <para style="q2" vid="PSA 6:3">mi mi harem i nogud we i nogud.</para>
  <para style="q1" vid="PSA 6:3">Hae God.</para>
  <para style="q2" vid="PSA 6:3">?Bambae yu stap wet blong givhan long mi</para>
  <para style="q3" vid="PSA 6:3">gogo kasem wetaem?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Hae God,</para>
  <para style="q2" vid="PSA 6:4">plis yu kam, yu sevem mi.</para>
  <para style="q1" vid="PSA 6:4">Fasin blong yu,</para>
  <para style="q3" vid="PSA 6:4">oltaem yu lavem man tumas,</para>
  <para style="q2" vid="PSA 6:4">plis yu sevem mi blong mi no save ded.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Long Hom* blong ol Dedman,</para>
  <para style="q2" vid="PSA 6:5">i no gat man we i save tingbaot yu.</para>
  <para style="q1" vid="PSA 6:5">I no gat wan man nating long ples ya</para>
  <para style="q2" vid="PSA 6:5">we i save presem yu.<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Mi mi stap harem nogud</para>
  <para style="q2" vid="PSA 6:6">gogo mi slak from.</para>
  <para style="q1" vid="PSA 6:6">Evri naet mi stap krae</para>
  <para style="q2" vid="PSA 6:6">gogo bed blong mi i wetwet</para>
  <para style="q3" vid="PSA 6:6">long wota blong ae blong mi.</para>
  <para style="q1" vid="PSA 6:6">Oltaem pilo blong mi i wetwet gud</para>
  <para style="q2" vid="PSA 6:6">long wota blong ae blong mi.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Ol enemi blong mi</para>
  <para style="q2" vid="PSA 6:7">oli stap mekem mi mi krae gogo</para>
  <para style="q3" vid="PSA 6:7">ae blong mi i solap from,</para>
  <para style="q4" vid="PSA 6:7">nao mi no moa save lukluk.<verse eid="PSA 6:7" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6.8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:23">Mat 7.23</ref>; <ref loc="LUK 13:27">Luk 13.27</ref></char>
    </note>Yufala ol man nogud,</para>
  <para style="q2" vid="PSA 6:8">yufala i gowe long mi.</para>
  <para style="q1" vid="PSA 6:8">Hae God i harem krae blong mi finis.<verse eid="PSA 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />Taem mi stap krae long hem</para>
  <para style="q4" vid="PSA 6:9">blong i givhan long mi,</para>
  <para style="q2" vid="PSA 6:9">hem i stap lesin long mi,</para>
  <para style="q3" vid="PSA 6:9">hem bambae i harem prea blong mi.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Ol enemi blong mi bambae oli sem,</para>
  <para style="q2" vid="PSA 6:10">bambae oli harem nogud tumas.</para>
  <para style="q1" vid="PSA 6:10">Hae God bambae i ronemaot olgeta,</para>
  <para style="q2" vid="PSA 6:10">we kwiktaem nomo bambae oli <optbreak /> sem gud,</para>
  <para style="q3" vid="PSA 6:10">oli ronwe.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">Prea we man i mekem taem hem i stap long trabol</para>
  <para style="sp">(Sing ya, Deved i wokem. Hem i prea long Hae God long sing ya from trabol we Kus, wan man long laen* blong Benjamin* i mekem long hem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />Hae God.</para>
  <para style="q1" vid="PSA 7:1">Yu yu God blong mi.</para>
  <para style="b" vid="PSA 7:1" />
  <para style="q1" vid="PSA 7:1">Mi mi kam long yu blong haed long yu.</para>
  <para style="q1" vid="PSA 7:1">Plis yu sevem mi,</para>
  <para style="q2" vid="PSA 7:1">yu tekemaot mi long han blong</para>
  <para style="q3" vid="PSA 7:1">olgeta we oli stap ronem mi.<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />Sipos no,</para>
  <para style="q2" vid="PSA 7:2">bambae oli kam karem mi mi go long wan ples</para>
  <para style="q4" vid="PSA 7:2">we i no gat man i save sevem mi,</para>
  <para style="q3" vid="PSA 7:2">nao bambae oli terem bodi blong mi</para>
  <para style="q3" vid="PSA 7:2">long ol smosmol pis</para>
  <para style="q4" vid="PSA 7:2">olsem we laeon i mekem <optbreak /> long kakae blong hem.<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />Hae God,</para>
  <para style="q2" vid="PSA 7:3">yu yu God blong mi.</para>
  <para style="q1" vid="PSA 7:3">Fasin blong mi i stret nomo.<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />Mi mi no mekem i nogud</para>
  <para style="q2" vid="PSA 7:4">long fren blong mi</para>
  <para style="q4" vid="PSA 7:4">we i mekem i gud long mi,</para>
  <para style="q3" vid="PSA 7:4">mo enemi blong mi</para>
  <para style="q3" vid="PSA 7:4">we i no spolem mi,</para>
  <para style="q3" vid="PSA 7:4">mi mi no mekem i nogud long hem.<note caller="+" style="f"><char style="fr" closed="false">7.4: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">Mi mi no mekem i nogud long fren blong mi we i mekem i gud long mi, mo enemi blong mi we <char style="bd">i spolem mi</char>, mi mi no mekem <char style="bd">i gud long</char> hem.</char></note><verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />Sipos mi bin mekem wan long ol samting ya,</para>
  <para style="q3" vid="PSA 7:5">i gud yu letem ol enemi blong mi oli kam,</para>
  <para style="q4" vid="PSA 7:5">oli ronem mi gogo oli kasem mi,</para>
  <para style="q4" vid="PSA 7:5">oli kilim mi gogo oli flatem mi,</para>
  <para style="q4" vid="PSA 7:5">oli spolem mi gogo oli livim mi mi ded olgeta.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />Hae God.</para>
  <para style="q1" vid="PSA 7:6">Ol enemi blong mi oli stap kros long mi.</para>
  <para style="q1" vid="PSA 7:6">Mi mi wantem blong yu yu halpem mi.</para>
  <para style="q1" vid="PSA 7:6">Plis yu kam,</para>
  <para style="q2" vid="PSA 7:6">yu blokem olgeta,</para>
  <para style="q3" vid="PSA 7:6">yu kros long olgeta,</para>
  <para style="q4" vid="PSA 7:6">yu agensem olgeta.</para>
  <para style="q1" vid="PSA 7:6">Yu yu wantem ol man oli mekem stret fasin.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Plis yu tekem olgeta man</para>
  <para style="q2" vid="PSA 7:7">oli kam wanples long fes blong yu,</para>
  <para style="q3" vid="PSA 7:7">nao yu sidaon long jea blong yu long heven,</para>
  <para style="q4" vid="PSA 7:7">yu jajem olgeta.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />Hae God,</para>
  <para style="q3" vid="PSA 7:8">yu yu stap jajem olgeta man,</para>
  <para style="q2" vid="PSA 7:8">yu yu save we mi mi stret man,</para>
  <para style="q3" vid="PSA 7:8">mi no save giaman.</para>
  <para style="q1" vid="PSA 7:8">Plis yu lukluk gud long fasin ya blong mi,</para>
  <para style="q2" vid="PSA 7:8">yu givhan long mi.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7.9: </char>
      <char style="xt" closed="false">
        <ref loc="REV 2:23">Rev 2.23</ref>
      </char>
    </note>Yu yu God we fasin blong yu i stret nomo,</para>
  <para style="q2" vid="PSA 7:9">yu yu stap jajem ol tingting blong mifala</para>
  <para style="q3" vid="PSA 7:9">mo ol samting we mifala i wantem.</para>
  <para style="q1" vid="PSA 7:9">Plis yu blokem ol rabis fasin blong ol man nogud,</para>
  <para style="q3" vid="PSA 7:9">blong oli no spolem mifala,</para>
  <para style="q2" vid="PSA 7:9">mo yu mekem ol stret man oli stanap strong.<verse eid="PSA 7:9" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />God i stap blokemgud mi</para>
  <para style="q2" vid="PSA 7:10">olsem wan sil.*</para>
  <para style="q1" vid="PSA 7:10">Hem i stap sevem olgeta</para>
  <para style="q2" vid="PSA 7:10">we oli stap obei long hem.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />God i wan stret jaj.</para>
  <para style="q1" vid="PSA 7:11">Olgeta we oli stap mekem nogud,</para>
  <para style="q2" vid="PSA 7:11">oltaem hem i stap jajem olgeta</para>
  <para style="q3" vid="PSA 7:11">se oli mas panis.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Sipos olgeta ya oli no jenisim fasin blong olgeta,</para>
  <para style="q2" vid="PSA 7:12">God bambae i sapenem naef blong faet blong hem.</para>
  <para style="q1" vid="PSA 7:12">Hem i taetem string blong bonara blong hem finis,</para>
  <para style="q2" vid="PSA 7:12">i mekem i rere.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />Hem i holem finis ol samting blong faet blong hem,</para>
  <para style="q2" vid="PSA 7:13">we i blong kilim man i ded.</para>
  <para style="q1" vid="PSA 7:13">Ara blong hem we i gat faea long en blong hem,</para>
  <para style="q2" vid="PSA 7:13">hem i pulumrere finis</para>
  <para style="q3" vid="PSA 7:13">blong i sut long hem.<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />!Yufala i luk!</para>
  <para style="q1" vid="PSA 7:14">Ol man nogud oli stap tingting</para>
  <para style="q2" vid="PSA 7:14">blong mekem ol rabis fasin.</para>
  <para style="q1" vid="PSA 7:14">Oli stap plan blong mekem trabol</para>
  <para style="q2" vid="PSA 7:14">nao oli gohed,</para>
  <para style="q3" vid="PSA 7:14">oli stap giagiaman long ol man.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />Be ol hol we oli digim</para>
  <para style="q2" vid="PSA 7:15">blong kasem ol narafala man,</para>
  <para style="q3" vid="PSA 7:15">olgeta oli foldaon long hem bakegen.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Ol rabis fasin we oli stap mekem</para>
  <para style="q3" vid="PSA 7:16">i kasem olgeta bakegen,</para>
  <para style="q2" vid="PSA 7:16">mo fasin blong olgeta blong spolem man</para>
  <para style="q4" vid="PSA 7:16">i spolem olgeta nomo.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Hae God, hem i hae we i hae.</para>
  <para style="q1" vid="PSA 7:17">Mi mi stap sing blong presem hem,</para>
  <para style="q2" vid="PSA 7:17">mo mi stap talem tangkiu long hem,</para>
  <para style="q3" vid="PSA 7:17">from we hem i stap jajem man</para>
  <para style="q4" vid="PSA 7:17">long stret fasin.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">Paoa blong God mo hae nem blong man</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />Hae God.</para>
  <para style="q1" vid="PSA 8:1">Yu yu Masta* blong mifala.</para>
  <para style="q1" vid="PSA 8:1">Olgeta man long evri ples long wol</para>
  <para style="q2" vid="PSA 8:1">oli save luk bigfala paoa blong yu.</para>
  <para style="q1" vid="PSA 8:1">Yu yu King,</para>
  <para style="q2" vid="PSA 8:1">mo hae nem blong yu</para>
  <para style="q3" vid="PSA 8:1">i finisim olgeta ples long heven.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8.2: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:16">Mat 21.16</ref>
      </char>
    </note>Ol pikinini mo ol smosmol pikinini</para>
  <para style="q2" vid="PSA 8:2">oli stap sing</para>
  <para style="q3" vid="PSA 8:2">blong presem yu.</para>
  <para style="q1" vid="PSA 8:2">Yu yu wokem wan strong sefples</para>
  <para style="q2" vid="PSA 8:2">blong blokem ol enemi blong yu,</para>
  <para style="q3" vid="PSA 8:2">blong oli no save kam long yu.</para>
  <para style="q1" vid="PSA 8:2">Olgeta we oli stap agens long yu</para>
  <para style="q2" vid="PSA 8:2">oli no save spolem yu.<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Taem mi mi luk skae</para>
  <para style="q3" vid="PSA 8:3">we yu yu mekem,</para>
  <para style="q2" vid="PSA 8:3">mo mi luk mun mo ol sta</para>
  <para style="q3" vid="PSA 8:3">we yu yu putum olgeta oli stap</para>
  <para style="q4" vid="PSA 8:3">long stret ples blong olgeta,<verse eid="PSA 8:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 8:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8.4: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:17">Job 7.17</ref>,<ref loc="JOB 7:18">18</ref>; <ref loc="PSA 144:3">Sam 144.3</ref>; <ref loc="HEB 2:6-8">Hib 2.6-8</ref></char>
    </note>mi luk man se hem i nating nomo.</para>
  <para style="q1" vid="PSA 8:4">I no stret</para>
  <para style="q2" vid="PSA 8:4">blong yu yu tingbaot hem.</para>
  <para style="q1" vid="PSA 8:4">I no stret nating</para>
  <para style="q2" vid="PSA 8:4">blong yu lukaot gud long hem.<verse eid="PSA 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Be yu yu mekem hem,</para>
  <para style="q2" vid="PSA 8:5">yu leftemap hem i hae we i hae,</para>
  <para style="q3" vid="PSA 8:5">we yu nomo yu hae moa long hem.<note caller="+" style="f"><char style="fr" closed="false">8.5: </char><char style="ft" closed="false">Narafala rod blong tanem tok long fas haf blong vas ya i olsem. </char><char style="fqa" closed="false">Be yu yu mekem hem, yu leftemap hem i hae we i hae, we <char style="bd">ol enjel nomo oli</char> </char><char style="fqa" closed="false">hae moa long hem.</char></note></para>
  <para style="q1" vid="PSA 8:5">Yu mekem hem i olsem king,</para>
  <para style="q2" vid="PSA 8:5">yu givim paoa long hem</para>
  <para style="q3" vid="PSA 8:5">mo yu leftemap nem blong hem.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8.6: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:27">1 Kor 15.27</ref>; <ref loc="EPH 1:22">Efes 1.22</ref>; <ref loc="HEB 2:8">Hib 2.8</ref></char>
    </note>Yu putumap hem</para>
  <para style="q2" vid="PSA 8:6">blong i rul long olgeta samting</para>
  <para style="q3" vid="PSA 8:6">we yu yu mekem,</para>
  <para style="q2" vid="PSA 8:6">yu mekem hem i bos</para>
  <para style="q3" vid="PSA 8:6">long olgeta samting ya.<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />Ol sipsip mo ol buluk</para>
  <para style="q3" vid="PSA 8:7">mo ol wael anamol,<verse eid="PSA 8:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 8:8" />mo ol pijin mo ol fis</para>
  <para style="q4" vid="PSA 8:8">mo olgeta samting insaed long solwota,</para>
  <para style="q3" vid="PSA 8:8">be hem i bos long olgeta evriwan.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />Hae God.</para>
  <para style="q1" vid="PSA 8:9">Yu yu Masta blong mifala.</para>
  <para style="q1" vid="PSA 8:9">Olgeta man long evri ples long wol</para>
  <para style="q2" vid="PSA 8:9">oli save luk bigfala paoa blong yu.<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">Prea blong talem tangkiu long God from stret fasin blong hem blong jajem man</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />Hae God.</para>
  <para style="q1" vid="PSA 9:1">Mi bambae mi presem yu</para>
  <para style="q3" vid="PSA 9:1">long olgeta tingting blong mi,</para>
  <para style="q2" vid="PSA 9:1">mi bambae mi talemaot</para>
  <para style="q4" vid="PSA 9:1">olgeta gudgudfala wok blong yu.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />God, yu yu hae we yu hae,</para>
  <para style="q2" vid="PSA 9:2">yu mekem mi mi glad tumas.</para>
  <para style="q1" vid="PSA 9:2">Oltaem bambae mi sing blong presem yu,</para>
  <para style="q2" vid="PSA 9:2">bambae mi stap sing</para>
  <para style="q3" vid="PSA 9:2">blong leftemap hae nem blong yu.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Taem ol enemi blong mi oli luk yu,</para>
  <para style="q2" vid="PSA 9:3">oli tanemraon,</para>
  <para style="q3" vid="PSA 9:3">oli folfoldaon, oli ded.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Taem yu yu jajem man,</para>
  <para style="q2" vid="PSA 9:4">fasin blong yu i stret olgeta.</para>
  <para style="q1" vid="PSA 9:4">Mo taem yu jajem mi,</para>
  <para style="q2" vid="PSA 9:4">yu talem se mi mi mekem i stret nomo.<verse eid="PSA 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Yu yu jajem ol hiten man finis,</para>
  <para style="q3" vid="PSA 9:5">se oli mas panis,</para>
  <para style="q2" vid="PSA 9:5">mo ol man nogud,</para>
  <para style="q4" vid="PSA 9:5">yu yu spolem olgeta finis.</para>
  <para style="q1" vid="PSA 9:5">Nem blong olgeta i lus olgeta,</para>
  <para style="q2" vid="PSA 9:5">bambae man i no moa save tingbaot olgeta bakegen.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Ol enemi blong mifala oli finis</para>
  <para style="q2" vid="PSA 9:6">we i finis olgeta.</para>
  <para style="q1" vid="PSA 9:6">Yu bin spolem ol taon blong olgeta,</para>
  <para style="q2" vid="PSA 9:6">mo ol man oli fogetemgud olgeta.<verse eid="PSA 9:6" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Hae God bambae i King oltaem nomo,</para>
  <para style="q2" vid="PSA 9:7">gogo i no save finis.</para>
  <para style="q1" vid="PSA 9:7">Hem i putumrere jea blong hem finis</para>
  <para style="q2" vid="PSA 9:7">blong jajem olgeta man.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Hem i stap rulum wol ya</para>
  <para style="q2" vid="PSA 9:8">long fasin we i stret.</para>
  <para style="q1" vid="PSA 9:8">Hem i stap jajem olgeta man</para>
  <para style="q2" vid="PSA 9:8">long stret fasin nomo.<verse eid="PSA 9:8" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />Hae God.</para>
  <para style="q1" vid="PSA 9:9">Yu yu sefples blong olgeta ya</para>
  <para style="q2" vid="PSA 9:9">we ol man oli stap spolem olgeta.</para>
  <para style="q1" vid="PSA 9:9">Yu yu ples blong haed blong olgeta</para>
  <para style="q2" vid="PSA 9:9">long taem blong trabol.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Olgeta we oli save yu,</para>
  <para style="q2" vid="PSA 9:10">bambae oli trastem yu.</para>
  <para style="q1" vid="PSA 9:10">Olgeta we oli kam long yu,</para>
  <para style="q2" vid="PSA 9:10">yu no save lego wan long olgeta.<verse eid="PSA 9:10" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Hae God i stap long Saeon,*</para>
  <para style="q2" vid="PSA 9:11">i stap rulum ol man.</para>
  <para style="q1" vid="PSA 9:11">Yumi sing, yumi presem hem.</para>
  <para style="q1" vid="PSA 9:11">Yumi talemaot ol gudgudfala wok blong hem</para>
  <para style="q2" vid="PSA 9:11">long olgeta man long evri ples.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Olgeta we oli harem nogud,</para>
  <para style="q2" vid="PSA 9:12">hem i stap tingbaot olgeta,</para>
  <para style="q3" vid="PSA 9:12">mo hem i no save fogetem krae blong olgeta.</para>
  <para style="q1" vid="PSA 9:12">Mo hem i stap panisim ol man</para>
  <para style="q2" vid="PSA 9:12">we oli stap mekem i nogud long olgeta.<verse eid="PSA 9:12" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />Hae God, plis yu sore long mi.</para>
  <para style="q1" vid="PSA 9:13">Yu luk,</para>
  <para style="q2" vid="PSA 9:13">ol enemi blong mi oli mekem mi</para>
  <para style="q3" vid="PSA 9:13">mi harem nogud tumas.</para>
  <para style="q1" vid="PSA 9:13">Plis yu sevem mi blong mi mi no ded.<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />Nao bambae mi save stanap</para>
  <para style="q2" vid="PSA 9:14">long fes blong olgeta man long Jerusalem,*</para>
  <para style="q3" vid="PSA 9:14">mi save talemaot long olgeta,</para>
  <para style="q4" vid="PSA 9:14">olgeta samting we mi mi stap presem yu from.</para>
  <para style="q1" vid="PSA 9:14">Bambae mi mi glad</para>
  <para style="q2" vid="PSA 9:14">from we yu yu sevem mi.<verse eid="PSA 9:14" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Ol hiten man oli digim wan hol long rod,</para>
  <para style="q2" vid="PSA 9:15">be oli foldaon long hem bakegen.</para>
  <para style="q1" vid="PSA 9:15">Trap we olgeta nomo oli putum</para>
  <para style="q2" vid="PSA 9:15">i kasem olgeta bakegen.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />Hae God i mekem ol man oli save hem</para>
  <para style="q2" vid="PSA 9:16">long fasin ya we hem i stap jajem ol man long stret fasin.</para>
  <para style="q1" vid="PSA 9:16">Be ol man nogud,</para>
  <para style="q2" vid="PSA 9:16">rabis fasin blong olgeta</para>
  <para style="q3" vid="PSA 9:16">i stap spolem olgeta bakegen.<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Ol man nogud bambae oli ded,</para>
  <para style="q2" vid="PSA 9:17">oli go long Hom* blong ol Dedman.</para>
  <para style="q1" vid="PSA 9:17">Ol man blong olgeta ples</para>
  <para style="q2" vid="PSA 9:17">we oli tanem baksaed long God,</para>
  <para style="q3" vid="PSA 9:17">bambae oli lus olgeta.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Ol man we oli no gat man blong givhan long olgeta,</para>
  <para style="q2" vid="PSA 9:18">bambae oli no save trabol oltaem,</para>
  <para style="q3" vid="PSA 9:18">hem bambae i givhan long olgeta.</para>
  <para style="q1" vid="PSA 9:18">Ol puaman,</para>
  <para style="q2" vid="PSA 9:18">tingting blong olgeta</para>
  <para style="q3" vid="PSA 9:18">bambae i no save foldaon olgeta,</para>
  <para style="q4" vid="PSA 9:18">hem bambae i leftemap olgeta.<verse eid="PSA 9:18" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />!Hae God, plis yu kam!</para>
  <para style="q1" vid="PSA 9:19">!Yu no letem ol man oli winim yu!</para>
  <para style="q1" vid="PSA 9:19">Yu tekem ol hiten man</para>
  <para style="q2" vid="PSA 9:19">oli kam stanap long fes blong yu,</para>
  <para style="q3" vid="PSA 9:19">yu jajem olgeta.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Plis yu mekem olgeta oli fraet.</para>
  <para style="q1" vid="PSA 9:20">Yu mekem olgeta oli save</para>
  <para style="q2" vid="PSA 9:20">we oli man nomo, oli no gat paoa.<note caller="+" style="f"><char style="fr" closed="false">9.20: </char><char style="ft" closed="false">Long sam olfala Oltesteman, Sam 10 i joen nomo long Sam 9, mo biaen long hem olgeta namba blong Ol Sam oli jenis kasem Sam 147 we i seraot long tu haf.</char></note><verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">Prea we man i mekem blong Hae God i mekem stret fasin i stanap</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />Hae God.</para>
  <para style="q1" vid="PSA 10:1">?From wanem yu stap longwe tumas?</para>
  <para style="q1" vid="PSA 10:1">?From wanem yu stap haed</para>
  <para style="q2" vid="PSA 10:1">taem we mifala i stap long trabol?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Ol man nogud oli flas tumas,</para>
  <para style="q2" vid="PSA 10:2">nao oli stap ronem ol puaman.</para>
  <para style="q1" vid="PSA 10:2">Plis yu letem ol trap we oli mekem</para>
  <para style="q2" vid="PSA 10:2">i kasem olgeta bakegen.<verse eid="PSA 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Hae God.</para>
  <para style="q1" vid="PSA 10:3">Man nogud i stap tok flas</para>
  <para style="q3" vid="PSA 10:3">from ol samting nogud we hem i wantem.</para>
  <para style="q1" vid="PSA 10:3">Man we i wantem kasem evri samting,</para>
  <para style="q2" vid="PSA 10:3">hem i tanem baksaed long yu,</para>
  <para style="q3" vid="PSA 10:3">mo i stap tok nogud long yu.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Man nogud i no kea long yu nating,</para>
  <para style="q2" vid="PSA 10:4">hem i flas tumas,</para>
  <para style="q3" vid="PSA 10:4">nao long tingting blong hem</para>
  <para style="q4" vid="PSA 10:4">i stap talem se, “I no gat God i stap.”<verse eid="PSA 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Hem i stap win oltaem nomo,</para>
  <para style="q2" vid="PSA 10:5">long olgeta wok blong hem.</para>
  <para style="q1" vid="PSA 10:5">Hem i no save luksave mak blong</para>
  <para style="q2" vid="PSA 10:5">laef we yu yu putum.</para>
  <para style="q1" vid="PSA 10:5">Hem i stap tok nogud long ol enemi blong hem,</para>
  <para style="q2" vid="PSA 10:5">i stap laf long olgeta.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Hem i stap talem se,</para>
  <para style="q2" vid="PSA 10:6">“Bambae mi mi no save lus.</para>
  <para style="q2" vid="PSA 10:6">Neva bambae mi mi kasem trabol.”<verse eid="PSA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10.7: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:14">Rom 3.14</ref>
      </char>
    </note>Man olsem, maot blong hem i nogud.</para>
  <para style="q1" vid="PSA 10:7">Oltaem hem i stap tok nogud long man,</para>
  <para style="q2" vid="PSA 10:7">i stap giaman,</para>
  <para style="q3" vid="PSA 10:7">i stap tok blong mekem man i fraet.</para>
  <para style="q1" vid="PSA 10:7">Hem i kwik blong sakem ol rabis tok,</para>
  <para style="q2" vid="PSA 10:7">we i blong spolem man nomo.<verse eid="PSA 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Hem i stap haed long ol vilej,</para>
  <para style="q2" vid="PSA 10:8">i stap wet long ol man</para>
  <para style="q3" vid="PSA 10:8">we oli no mekem samting nogud,</para>
  <para style="q3" vid="PSA 10:8">blong i kilim olgeta oli ded.<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />Hem i stap haed long ples blong hem,</para>
  <para style="q2" vid="PSA 10:9">i stap wet olsem wan laeon.</para>
  <para style="q1" vid="PSA 10:9">Hem i stap wet nomo long ol puaman,</para>
  <para style="q2" vid="PSA 10:9">i stap kasem olgeta long trap blong hem,</para>
  <para style="q3" vid="PSA 10:9">nao i pulum olgeta i gowe.<verse eid="PSA 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Hem i gat paoa,</para>
  <para style="q2" vid="PSA 10:10">nao hem i stap smasemgud olgeta</para>
  <para style="q2" vid="PSA 10:10">we oli no strong,</para>
  <para style="q3" vid="PSA 10:10">i stap flatemgud olgeta.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />Long tingting blong hem,</para>
  <para style="q2" vid="PSA 10:11">hem i stap talem se,</para>
  <para style="q3" vid="PSA 10:11">“!God i no kea!</para>
  <para style="q3" vid="PSA 10:11">!Hem i satem ae blong hem finis!</para>
  <para style="q3" vid="PSA 10:11">!Neva bambae hem i luk mi!”<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />Hae God,</para>
  <para style="q2" vid="PSA 10:12">yu kam,</para>
  <para style="q3" vid="PSA 10:12">yu panisim ol man nogud ya.</para>
  <para style="q1" vid="PSA 10:12">Plis yu tingbaot olgeta</para>
  <para style="q2" vid="PSA 10:12">we oli stap harem nogud.<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />?Olsem wanem yu stap letem man nogud</para>
  <para style="q2" vid="PSA 10:13">i lukluk rabis long yu?</para>
  <para style="q1" vid="PSA 10:13">?Weswe hem i stap talem se,</para>
  <para style="q2" vid="PSA 10:13">“God i no save panisim mi”?<verse eid="PSA 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Be yu yu luk ol samting ya finis,</para>
  <para style="q2" vid="PSA 10:14">yu save olgeta we oli stap trabol,</para>
  <para style="q3" vid="PSA 10:14">mo we oli harem nogud,</para>
  <para style="q2" vid="PSA 10:14">mo oltaem yu yu rere</para>
  <para style="q3" vid="PSA 10:14">blong givhan long olgeta.</para>
  <para style="q1" vid="PSA 10:14">Man we i no strong,</para>
  <para style="q2" vid="PSA 10:14">hem i stap putum laef blong hem</para>
  <para style="q3" vid="PSA 10:14">long han blong yu,</para>
  <para style="q2" vid="PSA 10:14">mo oltaem yu stap givhan long olgeta</para>
  <para style="q3" vid="PSA 10:14">we oli no gat man</para>
  <para style="q4" vid="PSA 10:14">blong givhan long olgeta.<verse eid="PSA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Plis yu brekemdaon paoa blong ol man nogud,</para>
  <para style="q2" vid="PSA 10:15">yu panisim olgeta</para>
  <para style="q3" vid="PSA 10:15">from ol samting nogud we oli mekem,</para>
  <para style="q4" vid="PSA 10:15">gogo oli no save mekem bakegen.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />Hae God, yu yu King,</para>
  <para style="q2" vid="PSA 10:16">mo bambae yu stap rul oltaem nomo,</para>
  <para style="q3" vid="PSA 10:16">gogo i no save finis.</para>
  <para style="q1" vid="PSA 10:16">Olgeta we oli stap mekem wosip long ol narafala god,</para>
  <para style="q2" vid="PSA 10:16">bambae oli finis,</para>
  <para style="q3" vid="PSA 10:16">bambae oli lus olgeta</para>
  <para style="q4" vid="PSA 10:16">we i no moa gat wan i stap</para>
  <para style="q3" vid="PSA 10:16">long graon ya blong yu.<verse eid="PSA 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />Hae God,</para>
  <para style="q2" vid="PSA 10:17">mi mi save</para>
  <para style="q3" vid="PSA 10:17">se yu bambae yu lesin long ol man blong yu</para>
  <para style="q4" vid="PSA 10:17">we ol man oli stap spolem olgeta,</para>
  <para style="q3" vid="PSA 10:17">mo bambae yu mekem tingting blong olgeta</para>
  <para style="q4" vid="PSA 10:17">i strong bakegen.<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />Yu bambae yu harem krae blong olgeta ya</para>
  <para style="q2" vid="PSA 10:18">wetem ol pikinini we papa blong olgeta i ded.</para>
  <para style="q1" vid="PSA 10:18">Bambae yu givhan long olgeta,</para>
  <para style="q2" vid="PSA 10:18">yu jajem olgeta long stret fasin,</para>
  <para style="q3" vid="PSA 10:18">blong olgeta ya we oli man nomo</para>
  <para style="q4" vid="PSA 10:18">bambae oli no moa save mekem olgeta</para>
  <para style="q3" vid="PSA 10:18">oli fraet bakegen.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">Sing blong man we i trastem Hae God</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1-3" style="v" sid="PSA 11:1-3" />Mi mi trastem Hae God,</para>
  <para style="q2" vid="PSA 11:1-3">nao mi mi stap gud long han blong hem.</para>
  <para style="q1" vid="PSA 11:1-3">Be yufala i no gat hed,</para>
  <para style="q2" vid="PSA 11:1-3">yufala i stap talem long mi se,</para>
  <para style="q2" vid="PSA 11:1-3">“Yu flae olsem pijin,</para>
  <para style="q3" vid="PSA 11:1-3">yu go antap long hil ya.</para>
  <para style="q1" vid="PSA 11:1-3">Ol man nogud</para>
  <para style="q3" vid="PSA 11:1-3">oli taetem string blong bonara blong olgeta finis.</para>
  <para style="q2" vid="PSA 11:1-3">Naoia oli stap haed long tudak,</para>
  <para style="q3" vid="PSA 11:1-3">we oli putumrere ara finis long bonara,</para>
  <para style="q4" vid="PSA 11:1-3">blong sutum ol stret man.</para>
  <para style="q2" vid="PSA 11:1-3">Taem evri samting i go olbaot olsemia,</para>
  <para style="q3" vid="PSA 11:1-3">gudfala man i no save mekem wan samting nating.”</para>
  <para style="q1" vid="PSA 11:1-3">?Be weswe yufala i stap toktok long mi olsem?<verse eid="PSA 11:1-3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />Hae God i stap</para>
  <para style="q2" vid="PSA 11:4">long tabu haos* blong hem.</para>
  <para style="q1" vid="PSA 11:4">Hem i King,</para>
  <para style="q2" vid="PSA 11:4">i stap rulum olgeta man.</para>
  <para style="q1" vid="PSA 11:4">Hem i stap long heven,</para>
  <para style="q2" vid="PSA 11:4">i stap lukluk olgeta man long evri ples,</para>
  <para style="q3" vid="PSA 11:4">mo i save evri samting we oli stap mekem.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />God i stap skelem laef blong olgeta man,</para>
  <para style="q2" vid="PSA 11:5">ol gudfala man wetem ol man nogud.</para>
  <para style="q1" vid="PSA 11:5">Mo hem i no laekem nating olgeta</para>
  <para style="q2" vid="PSA 11:5">we oli laekem tumas blong mekem faet.<verse eid="PSA 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />Bambae hem i panisim ol man nogud,</para>
  <para style="q2" vid="PSA 11:6">i sanem faea we i stap laet,</para>
  <para style="q4" vid="PSA 11:6">wetem salfa* we i hot we i hot,</para>
  <para style="q3" vid="PSA 11:6">i kamdaon, i bonem olgeta.</para>
  <para style="q1" vid="PSA 11:6">Bambae hem i sanem win we i hot we i hot</para>
  <para style="q2" vid="PSA 11:6">blong panisim olgeta.<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Hae God,</para>
  <para style="q2" vid="PSA 11:7">hem i stret olgeta,</para>
  <para style="q3" vid="PSA 11:7">mo hem i laekem ol gudfala wok.</para>
  <para style="q1" vid="PSA 11:7">Olgeta we oli mekem ol wok olsem,</para>
  <para style="q3" vid="PSA 11:7">bambae oli go stap wetem hem.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">Prea we man i mekem blong God i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong sing wetem mandolin.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />Hae God.</para>
  <para style="q1" vid="PSA 12:1">Plis yu givhan long mifala.</para>
  <para style="q1" vid="PSA 12:1">Naoia i no moa gat wan gudfala man i stap,</para>
  <para style="q2" vid="PSA 12:1">olgeta stret man oli lus,</para>
  <para style="q3" vid="PSA 12:1">yu no moa save faenem wan.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Ol man oli stap giagiaman</para>
  <para style="q2" vid="PSA 12:2">long olgeta bakegen.</para>
  <para style="q1" vid="PSA 12:2">Olgeta wanwan oli stap giagiaman</para>
  <para style="q2" vid="PSA 12:2">long ol fren blong olgeta,</para>
  <para style="q3" vid="PSA 12:2">long ol swit toktok blong olgeta.<verse eid="PSA 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Hae God,</para>
  <para style="q2" vid="PSA 12:3">plis yu blokem ol swit toktok ya.</para>
  <para style="q1" vid="PSA 12:3">Yu satem maot blong olgeta ya</para>
  <para style="q2" vid="PSA 12:3">we oli stap tok flas,</para>
  <para style="q3" vid="PSA 12:3">oli stap talem se,<verse eid="PSA 12:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 12:4" />“Mifala i stap kasem ol samting</para>
  <para style="q4" vid="PSA 12:4">we mifala i wantem,</para>
  <para style="q3" vid="PSA 12:4">long ol toktok blong mifala nomo.</para>
  <para style="q2" vid="PSA 12:4">Mifala bambae i talem ol samting</para>
  <para style="q4" vid="PSA 12:4">we mifala i wantem talem,</para>
  <para style="q3" vid="PSA 12:4">mo i no gat man i save blokem mifala.”<verse eid="PSA 12:4" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />Be Hae God i talem se,</para>
  <para style="q2" vid="PSA 12:5">“Naoia bambae mi mi kam,</para>
  <para style="q3" vid="PSA 12:5">from we ol man nogud ya</para>
  <para style="q4" vid="PSA 12:5">oli stap spolem ol puaman,</para>
  <para style="q4" vid="PSA 12:5">oli stap mekem olgeta oli harem nogud,</para>
  <para style="q3" vid="PSA 12:5">oli stap krae.</para>
  <para style="q1" vid="PSA 12:5">Ol puaman ya oli wantem tumas</para>
  <para style="q4" vid="PSA 12:5">blong oli stap sef, oli harem gud,</para>
  <para style="q3" vid="PSA 12:5">mo mi bambae mi sevem olgeta.”<verse eid="PSA 12:5" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />Hae God.</para>
  <para style="q1" vid="PSA 12:6">Man i save trastem ol promes* blong yu.</para>
  <para style="q1" vid="PSA 12:6">Ol promes ya oli stret mo oli tru,</para>
  <para style="q2" vid="PSA 12:6">olsem silva we oli bonem seven taem long faea</para>
  <para style="q4" vid="PSA 12:6">blong mekem i klin we i klin gud.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7-8" style="v" sid="PSA 12:7-8" />Ol man nogud oli stap olbaot long olgeta ples,</para>
  <para style="q2" vid="PSA 12:7-8">oli stap leftemap ol fasin we i nogud.</para>
  <para style="q1" vid="PSA 12:7-8">Hae God,</para>
  <para style="q2" vid="PSA 12:7-8">plis yu lukaot long mifala oltaem,</para>
  <para style="q3" vid="PSA 12:7-8">yu blokem ol man ya blong oli no kam spolem mifala,</para>
  <para style="q4" vid="PSA 12:7-8">yu seven mifala.<verse eid="PSA 12:7-8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">Prea we man i mekem blong Hae God i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />Hae God.</para>
  <para style="q1" vid="PSA 13:1">?Bambae yu stap fogetem mi</para>
  <para style="q2" vid="PSA 13:1">gogo kasem wetaem?</para>
  <para style="q3" vid="PSA 13:1">?Oltaem nomo?</para>
  <para style="q1" vid="PSA 13:1">?Bambae yu stap haed long mi</para>
  <para style="q2" vid="PSA 13:1">gogo kasem wetaem?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />?Bambae mi mi stap long trabol</para>
  <para style="q2" vid="PSA 13:2">gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 13:2">?Bambae mi stap harem nogud long tingting blong mi</para>
  <para style="q3" vid="PSA 13:2">long dei mo long naet</para>
  <para style="q2" vid="PSA 13:2">gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 13:2">?Bambae ol enemi blong mi oli stap winim mi</para>
  <para style="q2" vid="PSA 13:2">gogo kasem wetaem?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Hae God,</para>
  <para style="q2" vid="PSA 13:3">yu yu God blong mi.</para>
  <para style="q1" vid="PSA 13:3">Plis yu luk long mi,</para>
  <para style="q2" vid="PSA 13:3">yu harem krae blong mi.</para>
  <para style="q1" vid="PSA 13:3">Plis yu mekem mi mi strong bakegen,</para>
  <para style="q2" vid="PSA 13:3">yu no letem mi mi ded.<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />Yu no letem ol enemi blong mi</para>
  <para style="q2" vid="PSA 13:4">oli talem se, “Yumi winim hem finis.”</para>
  <para style="q1" vid="PSA 13:4">Yu no letem olgeta oli glad</para>
  <para style="q2" vid="PSA 13:4">from we oli daonem mi.<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Mi mi trastem yu</para>
  <para style="q2" vid="PSA 13:5">from fasin ya blong yu</para>
  <para style="q3" vid="PSA 13:5">we oltaem yu yu lavem man tumas.</para>
  <para style="q1" vid="PSA 13:5">Mi bambae mi glad,</para>
  <para style="q2" vid="PSA 13:5">from we yu bambae yu sevem mi.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Hae God,</para>
  <para style="q2" vid="PSA 13:6">mi bambae mi sing long yu,</para>
  <para style="q3" vid="PSA 13:6">from we yu bin mekem i gud tumas long mi.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">Ol fasin nogud blong man</para>
  <para style="s2">(Sam 53)</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14.1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Rom 3.10-12</ref>
      </char>
    </note>Ol man we oli no gat hed,</para>
  <para style="q2" vid="PSA 14:1">oli stap talem se,</para>
  <para style="q3" vid="PSA 14:1">“I no gat God nating.”</para>
  <para style="q1" vid="PSA 14:1">Olgeta ya evriwan oli rabis man nomo,</para>
  <para style="q2" vid="PSA 14:1">oli stap mekem ol samting nomo</para>
  <para style="q3" vid="PSA 14:1">we i nogud we i nogud.</para>
  <para style="q1" vid="PSA 14:1">I no gat wan long olgeta</para>
  <para style="q2" vid="PSA 14:1">we i stap mekem ol samting</para>
  <para style="q3" vid="PSA 14:1">we i stret.<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />Hae God i stap long heven,</para>
  <para style="q2" vid="PSA 14:2">i stap lukluk i kamdaon long olgeta man</para>
  <para style="q3" vid="PSA 14:2">blong faenemaot se i gat man we i waes,</para>
  <para style="q3" vid="PSA 14:2">we i stap mekem wosip long hem</para>
  <para style="q4" vid="PSA 14:2">no i no gat.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Be olgeta evriwan oli lusum rod finis,</para>
  <para style="q2" vid="PSA 14:3">olgeta evriwan oli sem mak nomo,</para>
  <para style="q3" vid="PSA 14:3">oli nogud.</para>
  <para style="q1" vid="PSA 14:3">I no gat wan long olgeta</para>
  <para style="q2" vid="PSA 14:3">we i mekem samting we i gud,</para>
  <para style="q3" vid="PSA 14:3">i no gat wan man nating olsem.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Hae God i stap talem se,</para>
  <para style="q2" vid="PSA 14:4">“?Weswe olgeta ya oli no save?</para>
  <para style="q1" vid="PSA 14:4">Olgeta man ya</para>
  <para style="q4" vid="PSA 14:4">we oli stap mekem ol samting nogud</para>
  <para style="q3" vid="PSA 14:4">oli no gat hed.</para>
  <para style="q2" vid="PSA 14:4">Oli stap laef long ol samting</para>
  <para style="q4" vid="PSA 14:4">we oli stap stilim long ol man blong mi,</para>
  <para style="q3" vid="PSA 14:4">mo oli no save prea long mi tu.”<note caller="+" style="f"><char style="fr" closed="false">14.4: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. <char style="bd">?Olgeta man ya we oli stap mekem ol samting nogud,</char> </char><char style="fqa" closed="false">oli no gat hed? Oli stap laef long ol samting we oli stap stilim long ol man blong <char style="bd">Hae God,</char> </char><char style="fqa" closed="false">mo oli no save prea long <char style="bd">hem</char> tu.</char></note><verse eid="PSA 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Be bambae oli fraet we oli fraet,</para>
  <para style="q3" vid="PSA 14:5">from we God i stap wetem ol man</para>
  <para style="q4" vid="PSA 14:5">we oli stap obei long hem.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Ol man we oli no gat paoa,</para>
  <para style="q2" vid="PSA 14:6">Hae God i stap lukaot gud long olgeta,</para>
  <para style="q4" vid="PSA 14:6">i stap blokemgud olgeta,</para>
  <para style="q3" vid="PSA 14:6">nating we ol man nogud ya</para>
  <para style="q3" vid="PSA 14:6">oli stap traem spolem ol plan blong olgeta.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Hae God i God blong yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 14:7">mo hem i stap long Saeon,*</para>
  <para style="q3" vid="PSA 14:7">mo prea blong mi</para>
  <para style="q4" vid="PSA 14:7">we hem bambae i mekem yumi win.</para>
  <para style="q1" vid="PSA 14:7">Yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 14:7">mo taem hem i mekem yumi gat</para>
  <para style="q4" vid="PSA 14:7">gudfala laef bakegen,</para>
  <para style="q4" vid="PSA 14:7">bambae yumi glad we yumi glad.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">Man we Hae God i glad long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />Hae God.</para>
  <para style="q1" vid="PSA 15:1">?Hu man we i stret blong go</para>
  <para style="q2" vid="PSA 15:1">long Haos Tapolen blong yu?</para>
  <para style="q1" vid="PSA 15:1">?Hu man we i stret blong go mekem wosip long yu</para>
  <para style="q2" vid="PSA 15:1">long Saeon,* tabu hil ya blong yu?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Man we i stret blong mekem olsem,</para>
  <para style="q2" vid="PSA 15:2">hemia man we i stap obei long yu</para>
  <para style="q4" vid="PSA 15:2">long evri samting,</para>
  <para style="q3" vid="PSA 15:2">mo oltaem i stap mekem</para>
  <para style="q3" vid="PSA 15:2">ol samting we i stret.</para>
  <para style="q1" vid="PSA 15:2">Ol tok blong hem i tru mo i stret,<verse eid="PSA 15:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 15:3" />mo hem i no save giaman long ol narafala man.</para>
  <para style="q1" vid="PSA 15:3">Hem i no save mekem ol samting nogud</para>
  <para style="q3" vid="PSA 15:3">long ol fren blong hem,</para>
  <para style="q2" vid="PSA 15:3">mo i no save tok nogud blong spolem nem</para>
  <para style="q4" vid="PSA 15:3">blong ol man raonabaot long hem.<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />Hem i no save laekem ol man</para>
  <para style="q3" vid="PSA 15:4">we yu yu tanem baksaed long olgeta,</para>
  <para style="q2" vid="PSA 15:4">be i stap ona long ol man</para>
  <para style="q4" vid="PSA 15:4">we oli stap obei long yu.</para>
  <para style="q1" vid="PSA 15:4">Oltaem hem i stap mekem ol samting</para>
  <para style="q2" vid="PSA 15:4">we hem i promes blong mekem,</para>
  <para style="q3" vid="PSA 15:4">nating we i had tumas long hem.<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />Hem i stap givimaot lonmane,</para>
  <para style="q2" vid="PSA 15:5">we i no save mekem man</para>
  <para style="q3" vid="PSA 15:5">i pem intres long hem.</para>
  <para style="q1" vid="PSA 15:5">Mo hem i no save tekem mane</para>
  <para style="q2" vid="PSA 15:5">long man we i wantem pem hem</para>
  <para style="q3" vid="PSA 15:5">blong i girap insaed long kot,</para>
  <para style="q3" vid="PSA 15:5">i tok agens long man</para>
  <para style="q4" vid="PSA 15:5">we i mekem i stret nomo.</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q1" vid="PSA 15:5">Man we oltaem i stap mekem olgeta samting ya,</para>
  <para style="q2" vid="PSA 15:5">hem bambae i no save foldaon samtaem.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">Prea blong man we tingting blong hem i stap strong long Hae God</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Hae God.</para>
  <para style="q1" vid="PSA 16:1">Plis yu lukaot gud long mi,</para>
  <para style="q2" vid="PSA 16:1">from we oltaem mi stap trastem yu</para>
  <para style="q3" vid="PSA 16:1">blong yu yu blokemgud mi,</para>
  <para style="q4" vid="PSA 16:1">yu sevem mi.<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Yu yu Masta* blong mi.</para>
  <para style="q1" vid="PSA 16:2">Ol gudgudfala samting we mi mi gat</para>
  <para style="q2" vid="PSA 16:2">oli kamaot long yu nomo.<verse eid="PSA 16:2" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Ol man blong Hae God</para>
  <para style="q2" vid="PSA 16:3">we oli putum tingting blong olgeta</para>
  <para style="q3" vid="PSA 16:3">i stap strong long hem,</para>
  <para style="q4" vid="PSA 16:3">olgeta oli gudfala man.</para>
  <para style="q1" vid="PSA 16:3">Mi mi wantem tumas</para>
  <para style="q2" vid="PSA 16:3">blong stap wetem olgeta.<verse eid="PSA 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Olgeta we oli stap biaen long ol narafala god</para>
  <para style="q2" vid="PSA 16:4">oli stap pulum plante trabol nomo</para>
  <para style="q3" vid="PSA 16:4">i kam long olgeta.</para>
  <para style="q1" vid="PSA 16:4">Mi bambae mi no save joen wetem olgeta</para>
  <para style="q3" vid="PSA 16:4">long ol sakrefaes blong olgeta,</para>
  <para style="q2" vid="PSA 16:4">mo bambae mi no save mekem wosip</para>
  <para style="q4" vid="PSA 16:4">long ol god blong olgeta.<verse eid="PSA 16:4" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />Hae God.</para>
  <para style="q1" vid="PSA 16:5">Yu nomo yu stamba blong olgeta laef blong mi,</para>
  <para style="q2" vid="PSA 16:5">yu yu stap givim olgeta samting ya long mi</para>
  <para style="q4" vid="PSA 16:5">we mi mi sot long hem.</para>
  <para style="q1" vid="PSA 16:5">Laef blong mi long fiuja</para>
  <para style="q2" vid="PSA 16:5">i stap long han blong yu.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Olgeta samting we yu yu givim long mi</para>
  <para style="q2" vid="PSA 16:6">oli gud tumas,</para>
  <para style="q3" vid="PSA 16:6">oli gud we i gud.<verse eid="PSA 16:6" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Mi mi stap presem Hae God,</para>
  <para style="q3" vid="PSA 16:7">from we oltaem hem i stap lidim mi,</para>
  <para style="q2" vid="PSA 16:7">mo long naet,</para>
  <para style="q3" vid="PSA 16:7">tingting blong mi i stap toktok long mi,</para>
  <para style="q4" vid="PSA 16:7">i stap soemaot rod long mi.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Oltaem mi mi save</para>
  <para style="q2" vid="PSA 16:8">we Hae God i stap wetem mi,</para>
  <para style="q3" vid="PSA 16:8">i stap klosap long mi,</para>
  <para style="q4" vid="PSA 16:8">nao i no gat wan samting i save muvum mi.<verse eid="PSA 16:8" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Nao from samting ya mi mi glad tumas,</para>
  <para style="q2" vid="PSA 16:9">mi talem tangkiu long yu,</para>
  <para style="q3" vid="PSA 16:9">mo mi mi harem we mi sef gud,<verse eid="PSA 16:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 16:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16.10: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:35">Wok 13.35</ref>
      </char>
    </note>from we yu yu stap lukaot gud long mi,</para>
  <para style="q3" vid="PSA 16:10">nao yu no save letem mi</para>
  <para style="q4" vid="PSA 16:10">mi go long Hom* blong ol Dedman.</para>
  <para style="q1" vid="PSA 16:10">Oltaem mi mi stap strong long wok blong yu,</para>
  <para style="q2" vid="PSA 16:10">taswe yu no save livim mi mi stap</para>
  <para style="q4" vid="PSA 16:10">olwe long ples ya.<verse eid="PSA 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16.11: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:25-28">Wok 2.25-28</ref>
      </char>
    </note>Yu bambae yu soem rod ya long mi</para>
  <para style="q2" vid="PSA 16:11">we i blong go kasem laef.</para>
  <para style="q1" vid="PSA 16:11">Nao taem mi mi stap wetem yu,</para>
  <para style="q2" vid="PSA 16:11">bambae mi harem we mi glad tumas,</para>
  <para style="q2" vid="PSA 16:11">tingting blong mi bambae i glad oltaem nomo.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">Prea blong man we i no mekem samting nogud</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i wan prea.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />Hae God.</para>
  <para style="q1" vid="PSA 17:1">Mi mi stap long trabol.</para>
  <para style="q1" vid="PSA 17:1">Plis yu harem krae blong mi,</para>
  <para style="q2" vid="PSA 17:1">yu stretem trabol ya</para>
  <para style="q3" vid="PSA 17:1">long fasin we i stret.</para>
  <para style="q1" vid="PSA 17:1">Plis yu lesin long mi,</para>
  <para style="q2" vid="PSA 17:1">yu givhan long mi,</para>
  <para style="q3" vid="PSA 17:1">yu harem prea blong mi,</para>
  <para style="q4" vid="PSA 17:1">from we mi mi no man blong giaman.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Plis yu jajem trabol ya,</para>
  <para style="q2" vid="PSA 17:2">yu talemaot we mi mi stret,</para>
  <para style="q3" vid="PSA 17:2">from we yu nao yu save fasin we i stret.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Yu yu save tingting blong mi.</para>
  <para style="q1" vid="PSA 17:3">Yu bin kam long mi long naet,</para>
  <para style="q2" vid="PSA 17:3">yu faenemaotgud laef blong mi,</para>
  <para style="q3" vid="PSA 17:3">mo yu faenem we mi mi no laekem fasin nogud nating.</para>
  <para style="q1" vid="PSA 17:3">Mi mi no save tok nogud<verse eid="PSA 17:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 17:4" />olsem we ol narafala man oli stap mekem.</para>
  <para style="q1" vid="PSA 17:4">Oltaem mi stap obei long tok blong yu,</para>
  <para style="q2" vid="PSA 17:4">nao mi no save folem ol fasin blong faet.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Oltaem mi stap folem rod blong yu,</para>
  <para style="q2" vid="PSA 17:5">mo neva mi lusum rod ya.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />God, mi mi prea long yu</para>
  <para style="q2" vid="PSA 17:6">from we yu yu stap harem mi.</para>
  <para style="q1" vid="PSA 17:6">Plis yu lesin i kam,</para>
  <para style="q2" vid="PSA 17:6">yu harem ol tok blong mi.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Yu soemaot gudfala fasin ya blong yu</para>
  <para style="q2" vid="PSA 17:7">we oltaem yu lavem man tumas,</para>
  <para style="q3" vid="PSA 17:7">yu sevem mi.</para>
  <para style="q1" vid="PSA 17:7">Taem mi stap klosap long yu,</para>
  <para style="q3" vid="PSA 17:7">mi mi sef,</para>
  <para style="q2" vid="PSA 17:7">ol enemi blong mi oli no save spolem mi.<verse eid="PSA 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Plis yu blokem mi,</para>
  <para style="q2" vid="PSA 17:8">yu lukaot gud long mi,</para>
  <para style="q3" vid="PSA 17:8">olsem we yu stap lukaot gud</para>
  <para style="q4" vid="PSA 17:8">long ae blong yu nomo.</para>
  <para style="q1" vid="PSA 17:8">Yu blokemgud mi,</para>
  <para style="q2" vid="PSA 17:8">olsem we woman faol</para>
  <para style="q3" vid="PSA 17:8">i stap blokemgud ol pikinini blong hem</para>
  <para style="q4" vid="PSA 17:8">long wing blong hem.<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />Sipos yu mekem olsem,</para>
  <para style="q2" vid="PSA 17:9">bambae ol man nogud</para>
  <para style="q3" vid="PSA 17:9">oli no save kam faet long mi.</para>
  <para style="b" vid="PSA 17:9" />
  <para style="q1" vid="PSA 17:9">Ol enemi blong mi</para>
  <para style="q2" vid="PSA 17:9">oli stap kam hivap raon long mi</para>
  <para style="q3" vid="PSA 17:9">blong kilim mi.<verse eid="PSA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Oli stap tok flas</para>
  <para style="q2" vid="PSA 17:10">we oli no gat sore nating.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Naoia, weples we mi mi stap long hem,</para>
  <para style="q3" vid="PSA 17:11">be oli stap kam raon long mi,</para>
  <para style="q2" vid="PSA 17:11">oli stap lukaot janis blong daonem mi.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Oli olsem laeon,</para>
  <para style="q2" vid="PSA 17:12">oli stap wet long mi.</para>
  <para style="q1" vid="PSA 17:12">Oli wantem terem bodi blong mi</para>
  <para style="q2" vid="PSA 17:12">blong brebrekem long ol smosmol pis.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />Hae God, plis yu kam</para>
  <para style="q2" vid="PSA 17:13">yu faet long ol enemi ya blong mi,</para>
  <para style="q3" vid="PSA 17:13">yu winim olgeta.</para>
  <para style="q1" vid="PSA 17:13">Plis yu tekem naef blong faet blong yu,</para>
  <para style="q2" vid="PSA 17:13">yu faet long olgeta,</para>
  <para style="q4" vid="PSA 17:13">yu tekemaot mi long han blong olgeta.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />Ol man ya oli gat olgeta samting</para>
  <para style="q2" vid="PSA 17:14">we oli wantem long laef blong olgeta.</para>
  <para style="q1" vid="PSA 17:14">Plis yu sevem mi,</para>
  <para style="q2" vid="PSA 17:14">yu tekemaot mi long han blong olgeta,</para>
  <para style="q3" vid="PSA 17:14">mo yu panisim olgeta.</para>
  <para style="q1" vid="PSA 17:14">Plis yu mekem we oli harem nogud</para>
  <para style="q2" vid="PSA 17:14">long ol panis ya we yu putumrere finis</para>
  <para style="q3" vid="PSA 17:14">blong givim long olgeta.</para>
  <para style="q1" vid="PSA 17:14">Mi wantem we panis ya bambae i naf</para>
  <para style="q2" vid="PSA 17:14">blong kasem ol pikinini blong olgeta,</para>
  <para style="q3" vid="PSA 17:14">mo blong kasem ol pikinini</para>
  <para style="q4" vid="PSA 17:14">blong ol pikinini blong olgeta tu.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Be mi mi no mekem samting nogud,</para>
  <para style="q2" vid="PSA 17:15">nao from samting ya,</para>
  <para style="q3" vid="PSA 17:15">taem mi mi wekap,</para>
  <para style="q4" vid="PSA 17:15">bambae mi save luk yu,</para>
  <para style="q3" vid="PSA 17:15">mo bambae mi glad tumas,</para>
  <para style="q4" vid="PSA 17:15">from we bambae mi stap wetem yu.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">Deved i prea blong presem Hae God from we hem i win long faet</para>
  <para style="r">(<ref loc="2SA 22:1-51">2 Samuel 22.1-51</ref>)</para>
  <para style="sp">(Sing ya, Deved i wokem. Hem i man blong wok blong Hae God mo i presem hem long sing ya, long taem ya we Hae God i sevem hem, i tekemaot hem long han blong Sol mo long paoa blong olgeta enemi blong hem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 18:1-2" />Hae God. Mi mi lavem yu,</para>
  <para style="q2" vid="PSA 18:1-2">mo yu yu paoa blong mi.</para>
  <para style="sp" vid="PSA 18:1-2">(Tok i go long ol man.)</para>
  <para style="q1" vid="PSA 18:1-2">Hae God i God blong mi.</para>
  <para style="q1" vid="PSA 18:1-2">Hem i wan gudfala ples blong haed blong mi,</para>
  <para style="q2" vid="PSA 18:1-2">mo hem i stap lukaot gud long mi.</para>
  <para style="q1" vid="PSA 18:1-2">Hem i stap blokemgud mi,</para>
  <para style="q2" vid="PSA 18:1-2">mo i wan strong sefples blong mi.</para>
  <para style="q1" vid="PSA 18:1-2">Hem i olsem sil* we i stap blokem mi,</para>
  <para style="q2" vid="PSA 18:1-2">hem i sevem mi,</para>
  <para style="q3" vid="PSA 18:1-2">i holem mi mi stap gud.<verse eid="PSA 18:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Oltaem, taem mi singaot i go long hem</para>
  <para style="q2" vid="PSA 18:3">be hem i stap tekemaot mi</para>
  <para style="q4" vid="PSA 18:3">long han blong ol enemi blong mi,</para>
  <para style="q3" vid="PSA 18:3">i stap sevem mi.</para>
  <para style="q1" vid="PSA 18:3">Yumi evriwan i mas presem Hae God.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4-5" style="v" sid="PSA 18:4-5" />Wan taem, mi harem</para>
  <para style="q2" vid="PSA 18:4-5">se ded i stap klosap nomo long mi,</para>
  <para style="q3" vid="PSA 18:4-5">ol samting blong kilim mi</para>
  <para style="q4" vid="PSA 18:4-5">oli stap hivap raon long mi</para>
  <para style="q3" vid="PSA 18:4-5">blong holem mi.</para>
  <para style="q1" vid="PSA 18:4-5">Mi harem paoa blong hem</para>
  <para style="q2" vid="PSA 18:4-5">i olsem bigfala solwota</para>
  <para style="q3" vid="PSA 18:4-5">we i brok antap long mi, i rolem mi.<verse eid="PSA 18:4-5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Be long trabol ya blong mi,</para>
  <para style="q2" vid="PSA 18:6">mi mi singaot i go long Hae God we i God blong mi,</para>
  <para style="q3" vid="PSA 18:6">blong hem i givhan long mi.</para>
  <para style="q1" vid="PSA 18:6">Nao hem i stap long haos* blong hem,</para>
  <para style="q2" vid="PSA 18:6">i harem voes blong mi.</para>
  <para style="q1" vid="PSA 18:6">Hem i harem mi</para>
  <para style="q2" vid="PSA 18:6">we mi stap krae i go long hem.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Nao graon i seksek</para>
  <para style="q3" vid="PSA 18:7">we i seksek bigwan,</para>
  <para style="q2" vid="PSA 18:7">mo ol stamba blong ol hil tu</para>
  <para style="q4" vid="PSA 18:7">oli muvmuv oli go olbaot,</para>
  <para style="q3" vid="PSA 18:7">from we God i kros we i kros.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Kros blong hem i kam strong olsem we faea i laet,</para>
  <para style="q2" vid="PSA 18:8">i strong we i strong,</para>
  <para style="q3" vid="PSA 18:8">mo i hot olsem ston we i red.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Hem i terem skae i open,</para>
  <para style="q2" vid="PSA 18:9">nao i kamdaon</para>
  <para style="q3" vid="PSA 18:9">we blak klaod i stap aninit long leg blong hem.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Hem i sidaon long wan jerubim,*</para>
  <para style="q2" vid="PSA 18:10">nao win i karem hem i flae kwiktaem i kam.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Hem i mekem tudak i kavremap hem,</para>
  <para style="q2" vid="PSA 18:11">mo blak klaod blong ren i stap raon long hem.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Long fran blong hem,</para>
  <para style="q3" vid="PSA 18:12">i gat bigfala laet i stap saen,</para>
  <para style="q2" vid="PSA 18:12">mo ol ston blong aes* wetem faea</para>
  <para style="q3" vid="PSA 18:12">oli stap kamaot long blak klaod ya,</para>
  <para style="q4" vid="PSA 18:12">oli stap folfoldaon.<verse eid="PSA 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />Hae God i hae we i hae,</para>
  <para style="q2" vid="PSA 18:13">mo hem i mekem tanda i faerap.</para>
  <para style="q1" vid="PSA 18:13">Hem i tok,</para>
  <para style="q2" vid="PSA 18:13">mo ol man oli harem voes blong hem.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Hem i sut long ol ara blong hem,</para>
  <para style="q2" vid="PSA 18:14">nao ol enemi blong hem oli girap,</para>
  <para style="q3" vid="PSA 18:14">oli ron wanwan.</para>
  <para style="q1" vid="PSA 18:14">Hem i sanem laetning i kam,</para>
  <para style="q2" vid="PSA 18:14">nao i mekem olgeta evriwan</para>
  <para style="q3" vid="PSA 18:14">oli ronronwe.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Taem hem i tok strong</para>
  <para style="q2" vid="PSA 18:15">blong blokem ol enemi blong hem,</para>
  <para style="q4" vid="PSA 18:15">mo i tok kros long olgeta,</para>
  <para style="q2" vid="PSA 18:15">botom blong dip solwota</para>
  <para style="q3" vid="PSA 18:15">i no moa haed,</para>
  <para style="q4" vid="PSA 18:15">i kamaot,</para>
  <para style="q3" vid="PSA 18:15">mo ol stamba blong wol ya tu</para>
  <para style="q4" vid="PSA 18:15">oli no moa haed,</para>
  <para style="q3" vid="PSA 18:15">oli stap long klia ples nomo.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />Hae God i stap antap,</para>
  <para style="q2" vid="PSA 18:16">nao i pusum han blong hem i kamdaon,</para>
  <para style="q3" vid="PSA 18:16">i holem mi,</para>
  <para style="q4" vid="PSA 18:16">i pulumaot mi long dip solwota.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Hem i blokem ol enemi ya blong mi</para>
  <para style="q3" vid="PSA 18:17">we oli gat paoa,</para>
  <para style="q2" vid="PSA 18:17">mo olgeta we oli no laekem mi nating,</para>
  <para style="q4" vid="PSA 18:17">oli agens long mi,</para>
  <para style="q3" vid="PSA 18:17">mo olgeta we oli strong tumas</para>
  <para style="q3" vid="PSA 18:17">i winim mi,</para>
  <para style="q2" vid="PSA 18:17">nao i tekemaot mi long han blong olgeta,</para>
  <para style="q3" vid="PSA 18:17">i sevem mi.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Taem mi mi stap long trabol,</para>
  <para style="q3" vid="PSA 18:18">olgeta oli kam faet long mi,</para>
  <para style="q2" vid="PSA 18:18">be Hae God i lukaot gud long mi,</para>
  <para style="q4" vid="PSA 18:18">i sevem mi.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />Hem i halpem mi,</para>
  <para style="q2" vid="PSA 18:19">i tekemaot mi long trabol ya</para>
  <para style="q3" vid="PSA 18:19">we ded i stap long hem.</para>
  <para style="q1" vid="PSA 18:19">Hem i sevem mi from we hem i lavem mi.<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />Hae God i stap givhan long mi olsem,</para>
  <para style="q2" vid="PSA 18:20">from we mi mi stap mekem</para>
  <para style="q3" vid="PSA 18:20">ol samting we i stret.</para>
  <para style="q1" vid="PSA 18:20">Hem i stap blesem mi olsem,</para>
  <para style="q2" vid="PSA 18:20">from we mi no mekem</para>
  <para style="q3" vid="PSA 18:20">wan samting we i rong.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Oltaem mi stap obei</para>
  <para style="q2" vid="PSA 18:21">long ol loa blong hem.</para>
  <para style="q1" vid="PSA 18:21">Hem i God blong mi,</para>
  <para style="q2" vid="PSA 18:21">mo mi mi no gowe long hem samtaem.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Mi stap folemgud olgeta loa blong hem,</para>
  <para style="q2" vid="PSA 18:22">mo neva mi mi brekem tok we hem i putum.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Hem i save</para>
  <para style="q2" vid="PSA 18:23">we mi mi no mekem wan samting</para>
  <para style="q3" vid="PSA 18:23">nating we i nogud,</para>
  <para style="q2" vid="PSA 18:23">mo we oltaem mi stap lukaot gud,</para>
  <para style="q3" vid="PSA 18:23">blong mi no mekem wan samting</para>
  <para style="q4" vid="PSA 18:23">we i rong.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />Nao hem i stap mekem i gud long mi,</para>
  <para style="q2" vid="PSA 18:24">from we mi stap mekem ol samting</para>
  <para style="q4" vid="PSA 18:24">we i stret,</para>
  <para style="q3" vid="PSA 18:24">mo from we hem i save</para>
  <para style="q3" vid="PSA 18:24">we mi no mekem wan samting we i rong.<verse eid="PSA 18:24" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />!Hae God!</para>
  <para style="q1" vid="PSA 18:25">Olgeta we oli stap obei</para>
  <para style="q3" vid="PSA 18:25">long yu,</para>
  <para style="q2" vid="PSA 18:25">oltaem, yu yu stap mekem i gud</para>
  <para style="q4" vid="PSA 18:25">tumas long olgeta,</para>
  <para style="q2" vid="PSA 18:25">mo olgeta</para>
  <para style="q4" vid="PSA 18:25">we fasin blong olgeta i stret gud,</para>
  <para style="q3" vid="PSA 18:25">oltaem, yu yu stap mekem i stret</para>
  <para style="q3" vid="PSA 18:25">gud long olgeta.<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />Ol man we oli stap mekem i stret nomo,</para>
  <para style="q3" vid="PSA 18:26">yu yu stap mekem i stret nomo long olgeta,</para>
  <para style="q2" vid="PSA 18:26">be ol man we oli stap mekem i nogud,</para>
  <para style="q3" vid="PSA 18:26">yu yu stap givimbak fasin ya long olgeta.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Ol man we tingting blong olgeta i stap daon,</para>
  <para style="q3" vid="PSA 18:27">yu yu stap sevem olgeta,</para>
  <para style="q2" vid="PSA 18:27">be ol praod man,</para>
  <para style="q3" vid="PSA 18:27">yu yu stap daonem olgeta.<verse eid="PSA 18:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />Hae God, yu yu God blong mi,</para>
  <para style="q2" vid="PSA 18:28">mo yu yu laet blong mi.</para>
  <para style="q1" vid="PSA 18:28">Yu nao yu stap ronemaot tudak long mi.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Yu stap givim paoa long mi,</para>
  <para style="q3" vid="PSA 18:29">blong mi go faet long ol enemi blong mi,</para>
  <para style="q2" vid="PSA 18:29">mo yu stap mekem mi mi strong,</para>
  <para style="q3" vid="PSA 18:29">blong mi go insaed long ol taon,</para>
  <para style="q4" vid="PSA 18:29">we oli strong ples blong haed blong olgeta.<verse eid="PSA 18:29" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />God ya,</para>
  <para style="q2" vid="PSA 18:30">fasin blong hem i stret gud olgeta,</para>
  <para style="q3" vid="PSA 18:30">man i save trastem ol tok blong hem.</para>
  <para style="q1" vid="PSA 18:30">Hem i olsem sil</para>
  <para style="q2" vid="PSA 18:30">blong blokemgud olgeta</para>
  <para style="q3" vid="PSA 18:30">we oli luk long hem,</para>
  <para style="q4" vid="PSA 18:30">blong faenem sefples blong haed.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />Hae God, hem nomo i God.</para>
  <para style="q1" vid="PSA 18:31">Hem nomo i stap blokem yumi,</para>
  <para style="q2" vid="PSA 18:31">i stap sevem yumi.<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />Hem nao i stap mekem mi mi strong,</para>
  <para style="q2" vid="PSA 18:32">mo i stap mekem rod blong mi i stret.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18.33: </char>
      <char style="xt" closed="false">
        <ref loc="HAB 3:19">Hab 3.19</ref>
      </char>
    </note>Hem i stap mekem leg blong mi</para>
  <para style="q3" vid="PSA 18:33">i strong olsem leg blong nani,</para>
  <para style="q2" vid="PSA 18:33">blong mi save wokbaot</para>
  <para style="q4" vid="PSA 18:33">long ples we i nogud,</para>
  <para style="q3" vid="PSA 18:33">mo taem mi stap wokbaot long ol klif,</para>
  <para style="q3" vid="PSA 18:33">hem i stap holem mi mi sef.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />Hem i stap lanem mi blong faet,</para>
  <para style="q2" vid="PSA 18:34">blong mi save pulum bonara</para>
  <para style="q3" vid="PSA 18:34">we i strong we i strong.<verse eid="PSA 18:34" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Hae God.</para>
  <para style="q1" vid="PSA 18:35">Yu yu stap blokemgud mi,</para>
  <para style="q2" vid="PSA 18:35">yu stap sevem mi,</para>
  <para style="q3" vid="PSA 18:35">nao mi mi stap gud long han blong yu.</para>
  <para style="q1" vid="PSA 18:35">Fasin blong yu</para>
  <para style="q2" vid="PSA 18:35">we yu stap givhan long mi,</para>
  <para style="q3" vid="PSA 18:35">hem i stap leftemap nem blong mi.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Yu yu bin lukaot gud long mi</para>
  <para style="q2" vid="PSA 18:36">blong ol enemi blong mi oli no holem mi,</para>
  <para style="q3" vid="PSA 18:36">nao mi mi no foldaon.<verse eid="PSA 18:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Mi mi stap ronem olgeta</para>
  <para style="q2" vid="PSA 18:37">we mi no spel nating</para>
  <para style="q3" vid="PSA 18:37">gogo mi kasem olgeta,</para>
  <para style="q4" vid="PSA 18:37">mi flatemgud olgeta.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Mi stap kilim olgeta oli foldaon</para>
  <para style="q2" vid="PSA 18:38">we oli no save girap.</para>
  <para style="q1" vid="PSA 18:38">Mi mi winim olgeta,</para>
  <para style="q2" vid="PSA 18:38">nao oli stap ledaon olbaot</para>
  <para style="q3" vid="PSA 18:38">long fes blong mi.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Yu nomo yu stap mekem</para>
  <para style="q3" vid="PSA 18:39">mi mi strong blong faet,</para>
  <para style="q2" vid="PSA 18:39">yu stap mekem mi</para>
  <para style="q4" vid="PSA 18:39">mi winim ol enemi blong mi,<verse eid="PSA 18:39" /></para>
  <para style="q3">
    <verse number="40" style="v" sid="PSA 18:40" />mo yu stap mekem olgeta</para>
  <para style="q3" vid="PSA 18:40">oli ronwe long mi.</para>
  <para style="q1" vid="PSA 18:40">Olgeta oli no laekem mi nating,</para>
  <para style="q3" vid="PSA 18:40">oli stap agens long mi,</para>
  <para style="q2" vid="PSA 18:40">be mi mi kilim olgeta oli ded.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Hae God.</para>
  <para style="q1" vid="PSA 18:41">Olgeta ya oli stap krae</para>
  <para style="q3" vid="PSA 18:41">blong man i givhan long olgeta,</para>
  <para style="q2" vid="PSA 18:41">be i no gat man i stap</para>
  <para style="q4" vid="PSA 18:41">blong sevem olgeta.</para>
  <para style="q1" vid="PSA 18:41">Oli stap krae i go long yu,</para>
  <para style="q3" vid="PSA 18:41">be yu yu no wantem harem olgeta.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Mi mi stap smasem olgeta,</para>
  <para style="q2" vid="PSA 18:42">gogo oli kam olsem asis nomo</para>
  <para style="q3" vid="PSA 18:42">we win i karem i go.</para>
  <para style="q1" vid="PSA 18:42">Mi stap purumpurumbut long olgeta,</para>
  <para style="q2" vid="PSA 18:42">gogo oli kam olsem sofmad long rod.<verse eid="PSA 18:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Yu yu tekemaot mi</para>
  <para style="q2" vid="PSA 18:43">long han blong ol man</para>
  <para style="q3" vid="PSA 18:43">we oli stap agens long mi,</para>
  <para style="q3" vid="PSA 18:43">yu sevem mi,</para>
  <para style="q2" vid="PSA 18:43">mo yu mekem</para>
  <para style="q3" vid="PSA 18:43">we mi mi rulum ol man</para>
  <para style="q4" vid="PSA 18:43">blong ol narafala kantri.</para>
  <para style="q1" vid="PSA 18:43">Ol man ya, mi mi no save olgeta bifo,</para>
  <para style="q2" vid="PSA 18:43">be naoia oli stap long han blong mi.<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Olgeta oli bodaon long fes blong mi,</para>
  <para style="q2" vid="PSA 18:44">mo taem oli harem tok blong mi,</para>
  <para style="q3" vid="PSA 18:44">oli obei long mi.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Tingting blong olgeta i foldaon,</para>
  <para style="q3" vid="PSA 18:45">from we oli no moa gat paoa,</para>
  <para style="q2" vid="PSA 18:45">nao oli livim ol sefples blong olgeta,</para>
  <para style="q3" vid="PSA 18:45">oli kam,</para>
  <para style="q4" vid="PSA 18:45">we oli fraet, oli seksek gud.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />!Hae God, yu yu laef!</para>
  <para style="q1" vid="PSA 18:46">!Oltaem, yu stap blokem mi,</para>
  <para style="q2" vid="PSA 18:46">yu stap lukaot gud long mi!</para>
  <para style="q1" vid="PSA 18:46">!Mi mi presem yu!</para>
  <para style="q1" vid="PSA 18:46">!Oltaem yu stap sevem mi!</para>
  <para style="q1" vid="PSA 18:46">!Mi mi stap leftemap hae nem blong yu!<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47-48" style="v" sid="PSA 18:47-48" />Oltaem yu nomo yu stap tekemaot mi</para>
  <para style="q3" vid="PSA 18:47-48">long han blong ol enemi blong mi,</para>
  <para style="q2" vid="PSA 18:47-48">mo yu stap mekem rod,</para>
  <para style="q4" vid="PSA 18:47-48">blong mi mi winim olgeta,</para>
  <para style="q3" vid="PSA 18:47-48">mi givimbak long olgeta</para>
  <para style="q4" vid="PSA 18:47-48">ol trabol we oli stap mekem long mi.</para>
  <para style="q1" vid="PSA 18:47-48">Yu yu stap blokemgud mi,</para>
  <para style="q2" vid="PSA 18:47-48">blong ol man blong mekem faet</para>
  <para style="q3" vid="PSA 18:47-48">oli no spolem mi,</para>
  <para style="q2" vid="PSA 18:47-48">yu stap sevem mi.</para>
  <para style="q1" vid="PSA 18:47-48">Nao yu yu stap putum</para>
  <para style="q2" vid="PSA 18:47-48">ol man blong ol narafala kantri</para>
  <para style="q3" vid="PSA 18:47-48">oli stap long han long mi.<verse eid="PSA 18:47-48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18.49: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:9">Rom 15.9</ref>
      </char>
    </note>Hae God.</para>
  <para style="q1" vid="PSA 18:49">From ol samting ya,</para>
  <para style="q2" vid="PSA 18:49">oltaem,</para>
  <para style="q4" vid="PSA 18:49">long fes blong olgeta man long wol,</para>
  <para style="q3" vid="PSA 18:49">mi mi stap leftemap nem blong yu,</para>
  <para style="q4" vid="PSA 18:49">mo mi stap sing blong presem yu.<verse eid="PSA 18:49" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />Yu yu stap putumap man i kam king,</para>
  <para style="q2" vid="PSA 18:50">mo yu stap mekem hem i win gud.</para>
  <para style="q1" vid="PSA 18:50">Yu yu jusumaot mi mi king,</para>
  <para style="q2" vid="PSA 18:50">mo yu stap soemaot long mi</para>
  <para style="q3" vid="PSA 18:50">we oltaem yu yu lavem mi tumas.</para>
  <para style="q1" vid="PSA 18:50">Fasin ya, yu yu statem long mi,</para>
  <para style="q2" vid="PSA 18:50">mo oltaem,</para>
  <para style="q3" vid="PSA 18:50">bambae yu stap mekem long olgeta</para>
  <para style="q4" vid="PSA 18:50">we bambae oli stap kamaot biaen long mi,</para>
  <para style="q3" vid="PSA 18:50">gogo i no save finis.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">Ol wok blong God i soemaot bigfala paoa blong hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Oltaem skae i stap soemaot bigfala paoa blong God,</para>
  <para style="q2" vid="PSA 19:1">mo olgeta samting we oli stap long hem</para>
  <para style="q4" vid="PSA 19:1">oli stap soemaot ol gudgudfala wok <optbreak /> we God i mekem.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Evri dei ol man oli save luk</para>
  <para style="q3" vid="PSA 19:2">bigfala paoa ya blong God</para>
  <para style="q2" vid="PSA 19:2">mo evri naet oli save luk</para>
  <para style="q4" vid="PSA 19:2">ol gudgudfala wok ya blong hem.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Skae wetem olgeta samting ya</para>
  <para style="q2" vid="PSA 19:3">oli no save tok,</para>
  <para style="q3" vid="PSA 19:3">man i no save harem voes blong olgeta,<verse eid="PSA 19:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 19:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19.4: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 10:18">Rom 10.18</ref>
      </char>
    </note>be tok blong olgeta i stap goaot</para>
  <para style="q4" vid="PSA 19:4">long olgeta ples long wol,</para>
  <para style="q3" vid="PSA 19:4">toktok blong olgeta i stap go</para>
  <para style="q3" vid="PSA 19:4">long evri kona blong hem.</para>
  <para style="q1" vid="PSA 19:4">God i mekem ples blong hem long skae.<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />San i stap girap long moning,</para>
  <para style="q2" vid="PSA 19:5">i kamaot olsem wan man we i jes mared</para>
  <para style="q4" vid="PSA 19:5">we i hapi tumas,</para>
  <para style="q3" vid="PSA 19:5">olsem wan jampion blong resis</para>
  <para style="q3" vid="PSA 19:5">we i rere blong resis blong i win.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Hem i stat long narasaed blong skae,</para>
  <para style="q2" vid="PSA 19:6">nao i gokros long narasaed blong hem.</para>
  <para style="q1" vid="PSA 19:6">Mo i no gat wan samting</para>
  <para style="q2" vid="PSA 19:6">we i save ronwe long hot blong hem.<verse eid="PSA 19:6" /></para>
  <para style="s">Loa blong Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Loa* blong Hae God i stret gud,</para>
  <para style="q2" vid="PSA 19:7">mo i stap givim niufala paoa long yumi.</para>
  <para style="q1" vid="PSA 19:7">Ol tok we Hae God i putum,</para>
  <para style="q2" vid="PSA 19:7">yumi save bilif long hem,</para>
  <para style="q3" vid="PSA 19:7">mo i stap givim waes long olgeta</para>
  <para style="q4" vid="PSA 19:7">we oli no waes.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Ol loa we hem i stap tijim yumi long hem</para>
  <para style="q3" vid="PSA 19:8">oli stret,</para>
  <para style="q2" vid="PSA 19:8">mo olgeta we oli stap obei long ol loa ya,</para>
  <para style="q4" vid="PSA 19:8">oli stap harem gud.</para>
  <para style="q1" vid="PSA 19:8">Ol tok we hem i putum oli stret gud,</para>
  <para style="q2" vid="PSA 19:8">mo oli stap givim save long yumi.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Fasin ya we man i ona long Hae God,</para>
  <para style="q2" vid="PSA 19:9">hem i gud tumas,</para>
  <para style="q3" vid="PSA 19:9">mo bambae i save stap oltaem nomo.</para>
  <para style="q1" vid="PSA 19:9">Ol tingting blong Hae God</para>
  <para style="q3" vid="PSA 19:9">oli stret gud,</para>
  <para style="q2" vid="PSA 19:9">mo hem i stap jajem yumi</para>
  <para style="q4" vid="PSA 19:9">long fasin we i stret long evri man.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Mi mi wantem ol tok ya moa,</para>
  <para style="q2" vid="PSA 19:10">i winim we mi wantem gol we i beswan,</para>
  <para style="q4" vid="PSA 19:10">mo mi harem se i swit moa, <optbreak /> i winim eg* blong sugabag.*<verse eid="PSA 19:10" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Hae God,</para>
  <para style="q2" vid="PSA 19:11">ol tok ya blong yu,</para>
  <para style="q3" vid="PSA 19:11">oli stap givim save long mi,</para>
  <para style="q4" vid="PSA 19:11">we mi mi man blong wok blong yu.</para>
  <para style="q1" vid="PSA 19:11">Yu yu stap givim pei long mi,</para>
  <para style="q2" vid="PSA 19:11">from we mi stap obei long olgeta.<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Hae God,</para>
  <para style="q2" vid="PSA 19:12">i no gat man i save luk ol sin</para>
  <para style="q3" vid="PSA 19:12">we i blong hem nomo.</para>
  <para style="q1" vid="PSA 19:12">Plis yu mekem mi mi fri</para>
  <para style="q2" vid="PSA 19:12">long ol sin we mi mi mekem</para>
  <para style="q3" vid="PSA 19:12">be mi no save.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Plis yu blokem mi</para>
  <para style="q2" vid="PSA 19:13">blong mi no mekem stronghed blong mi</para>
  <para style="q3" vid="PSA 19:13">blong mekem ol fasin nogud,</para>
  <para style="q2" vid="PSA 19:13">mo yu no letem ol fasin ya</para>
  <para style="q3" vid="PSA 19:13">i kam bos long mi.</para>
  <para style="q1" vid="PSA 19:13">Nao bambae mi mi kam stret gud,</para>
  <para style="q2" vid="PSA 19:13">mi aot long paoa blong sin,</para>
  <para style="q3" vid="PSA 19:13">mi fri.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Hae God.</para>
  <para style="q1" vid="PSA 19:14">Yu yu strong ples blong haed blong mi,</para>
  <para style="q2" vid="PSA 19:14">mo yu yu mekem mi mi fri.</para>
  <para style="q1" vid="PSA 19:14">Prea blong mi,</para>
  <para style="q2" vid="PSA 19:14">we ol tok blong mi</para>
  <para style="q3" vid="PSA 19:14">mo ol tingting blong mi</para>
  <para style="q4" vid="PSA 19:14">bambae oli stret gud long fes blong yu.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">Tok blong blesem king blong i go long faet</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Pris i blesem king.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 20:1-2" />King.</para>
  <para style="q1" vid="PSA 20:1-2">Hae God i God blong Jekob,*</para>
  <para style="q2" vid="PSA 20:1-2">mo hem i God blong yu.</para>
  <para style="q1" vid="PSA 20:1-2">Hem i stap long ples blong hem</para>
  <para style="q2" vid="PSA 20:1-2">long tabu hil* ya Saeon.*</para>
  <para style="q1" vid="PSA 20:1-2">Prea blong mi</para>
  <para style="q2" vid="PSA 20:1-2">se sipos yu stap long trabol,</para>
  <para style="q3" vid="PSA 20:1-2">hem bambae i harem krae blong yu,</para>
  <para style="q4" vid="PSA 20:1-2">hem bambae i lukaot gud long yu, <optbreak /> i sevem yu,</para>
  <para style="q3" vid="PSA 20:1-2">mo bambae i givhan long yu, i kam halpem yu.<verse eid="PSA 20:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Prea blong mi</para>
  <para style="q2" vid="PSA 20:3">we hem bambae i no fogetem olgeta presen ya</para>
  <para style="q4" vid="PSA 20:3">we yu yu givim long hem,</para>
  <para style="q3" vid="PSA 20:3">hem bambae i glad long ol sakrefaes ya</para>
  <para style="q3" vid="PSA 20:3">we yu bonem blong mekem wosip long hem.<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Prea blong mi</para>
  <para style="q2" vid="PSA 20:4">we hem bambae i givim olgeta samting long yu</para>
  <para style="q4" vid="PSA 20:4">we yu yu wantem,</para>
  <para style="q3" vid="PSA 20:4">mo hem bambae i mekem yu yu win</para>
  <para style="q3" vid="PSA 20:4">long olgeta plan blong yu.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Nao bambae mifala i stap singaot bigwan</para>
  <para style="q2" vid="PSA 20:5">from we mifala i glad we yu yu win.</para>
  <para style="q1" vid="PSA 20:5">Bambae mifala i mekem lafet from samting ya,</para>
  <para style="q2" vid="PSA 20:5">bambae mifala i stap presem God blong yumi from.</para>
  <para style="q1" vid="PSA 20:5">Prea blong mi</para>
  <para style="q2" vid="PSA 20:5">we Hae God bambae i mekem olgeta samting ya</para>
  <para style="q3" vid="PSA 20:5">we yu yu stap askem long hem.<verse eid="PSA 20:5" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Hae God i jusumaot king blong yumi,</para>
  <para style="q3" vid="PSA 20:6">mo hem i putumap hem,</para>
  <para style="q2" vid="PSA 20:6">mo naoia mi mi save</para>
  <para style="q3" vid="PSA 20:6">we hem bambae i givhan long hem,</para>
  <para style="q4" vid="PSA 20:6">i mekem hem i win.</para>
  <para style="q1" vid="PSA 20:6">Hae God i stap long tabu ples blong hem long heven,</para>
  <para style="q2" vid="PSA 20:6">mo bambae hem i harem prea blong king ya,</para>
  <para style="q3" vid="PSA 20:6">i givhan long hem.</para>
  <para style="q1" vid="PSA 20:6">Long paoa blong hem,</para>
  <para style="q2" vid="PSA 20:6">hem bambae i stap mekem hem i win bigwan.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Sam man oli stap trastem</para>
  <para style="q4" vid="PSA 20:7">ol kat blong faet blong olgeta,</para>
  <para style="q3" vid="PSA 20:7">mo sam oli stap trastem</para>
  <para style="q3" vid="PSA 20:7">ol hos blong olgeta,</para>
  <para style="q2" vid="PSA 20:7">be yumi,</para>
  <para style="q3" vid="PSA 20:7">Hae God i God blong yumi</para>
  <para style="q4" vid="PSA 20:7">mo yumi trastem paoa blong hem.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Ol narafala man ya,</para>
  <para style="q2" vid="PSA 20:8">bambae oli stambol,</para>
  <para style="q3" vid="PSA 20:8">oli foldaon,</para>
  <para style="q2" vid="PSA 20:8">be yumi,</para>
  <para style="q3" vid="PSA 20:8">bambae yumi stanap strong</para>
  <para style="q4" vid="PSA 20:8">we yumi no save muf.<verse eid="PSA 20:8" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />Hae God.</para>
  <para style="q1" vid="PSA 20:9">Plis yu givhan long king ya,</para>
  <para style="q2" vid="PSA 20:9">yu mekem hem i win.</para>
  <para style="q1" vid="PSA 20:9">Taem mifala i singaot i kam long yu,</para>
  <para style="q2" vid="PSA 20:9">plis yu harem mifala.<note caller="+" style="f"><char style="fr" closed="false">20.9: </char><char style="ft" closed="false">Tok long las haf blong vas ya i folem olfala translesen blong Oltesteman long lanwis blong ol man Gris bifo, we i kamaot long olfala Oltesteman long lanwis ya Hibru, be long Oltesteman long Hibru we i stap tede, tok ya i olsem. </char><char style="fqa" closed="false">Taem mifala i singaot i <char style="bd">go long hem, hem bambae i</char> </char><char style="fqa" closed="false">harem mifala.</char></note><verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">Tok blong presem Hae God from we king i win</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />Hae God.</para>
  <para style="q1" vid="PSA 21:1">King blong mifala i glad tumas</para>
  <para style="q2" vid="PSA 21:1">from we yu yu givim paoa long hem.</para>
  <para style="q1" vid="PSA 21:1">Hem i glad we i glad,</para>
  <para style="q2" vid="PSA 21:1">from we yu yu winim ol enemi blong hem.<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Olgeta samting we hem i wantem tumas,</para>
  <para style="q2" vid="PSA 21:2">yu yu bin givim long hem.</para>
  <para style="q1" vid="PSA 21:2">Olgeta samting we hem i askem long yu,</para>
  <para style="q2" vid="PSA 21:2">yu yu bin mekem.<verse eid="PSA 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Yu yu kam long hem,</para>
  <para style="q2" vid="PSA 21:3">mo yu mekem i gud tumas long hem.</para>
  <para style="q1" vid="PSA 21:3">Yu yu wokem wan hat blong king long gol,</para>
  <para style="q2" vid="PSA 21:3">nao yu putum long hed blong hem.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Hem i askem laef long yu,</para>
  <para style="q2" vid="PSA 21:4">nao yu yu givim long hem.</para>
  <para style="q1" vid="PSA 21:4">Mo laef ya we yu givim,</para>
  <para style="q2" vid="PSA 21:4">bambae i no save finis.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Hem i gat hae nem</para>
  <para style="q2" vid="PSA 21:5">from we yu yu givhan long hem.</para>
  <para style="q1" vid="PSA 21:5">Yu mekem hem i king,</para>
  <para style="q2" vid="PSA 21:5">nao ol man oli ona long hem.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Ol gudgudfala samting</para>
  <para style="q3" vid="PSA 21:6">we yu yu givim long hem</para>
  <para style="q2" vid="PSA 21:6">bambae oli stap wetem hem oltaem.</para>
  <para style="q1" vid="PSA 21:6">Yu yu stap mekem hem i glad tumas</para>
  <para style="q2" vid="PSA 21:6">from we yu stap wetem hem.<verse eid="PSA 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Hae God,</para>
  <para style="q2" vid="PSA 21:7">yu yu hae we yu hae.</para>
  <para style="q1" vid="PSA 21:7">King blong mifala i stap trastem yu,</para>
  <para style="q2" vid="PSA 21:7">mo hem bambae i stap sef oltaem,</para>
  <para style="q3" vid="PSA 21:7">from we oltaem yu yu lavem hem.<verse eid="PSA 21:7" /></para>
  <para style="sp">(Tok i go long king.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />King.</para>
  <para style="q1" vid="PSA 21:8">Bambae yu yu winim olgeta</para>
  <para style="q2" vid="PSA 21:8">we oli enemi blong yu.</para>
  <para style="q1" vid="PSA 21:8">Bambae yu holem olgeta evriwan</para>
  <para style="q2" vid="PSA 21:8">we oli no laekem yu,</para>
  <para style="q3" vid="PSA 21:8">oli agens long yu.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Taem yu kamtru long olgeta,</para>
  <para style="q2" vid="PSA 21:9">bambae yu spolem olgeta</para>
  <para style="q3" vid="PSA 21:9">olsem we bigfala faea i kakae olgeta samting.</para>
  <para style="q1" vid="PSA 21:9">Hae God bambae i kros tumas long olgeta,</para>
  <para style="q3" vid="PSA 21:9">i spolem olgeta,</para>
  <para style="q4" vid="PSA 21:9">i mekem wan bigfala faea i finisim olgeta.<verse eid="PSA 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Bambae i no moa gat wan man long laen blong olgeta</para>
  <para style="q3" vid="PSA 21:10">we bambae i stap laef,</para>
  <para style="q2" vid="PSA 21:10">yu bambae yu kilim olgeta evriwan.<verse eid="PSA 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Olgeta oli save mekem ol plan blong olgeta,</para>
  <para style="q2" vid="PSA 21:11">mo oli save girap oli agens long yu,</para>
  <para style="q2" vid="PSA 21:11">be bambae oli no save win.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Yu bambae yu sutum olgeta</para>
  <para style="q3" vid="PSA 21:12">long ol ara blong yu,</para>
  <para style="q2" vid="PSA 21:12">nao bambae yu mekem olgeta</para>
  <para style="q3" vid="PSA 21:12">oli tanemraon, oli ronwe.<verse eid="PSA 21:12" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Hae God.</para>
  <para style="q1" vid="PSA 21:13">Yu yu gat bigfala paoa.</para>
  <para style="q1" vid="PSA 21:13">Bambae mifala i sing blong leftemap nem blong yu,</para>
  <para style="q2" vid="PSA 21:13">bambae mifala i presem yu</para>
  <para style="q3" vid="PSA 21:13">from paoa ya blong yu.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">Prea blong man we i harem nogud be i sing blong presem God</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22.1: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:46">Mat 27.46</ref>; <ref loc="MRK 15:34">Mak 15.34</ref></char>
    </note>?God blong mi,</para>
  <para style="q2" vid="PSA 22:1">God blong mi,</para>
  <para style="q3" vid="PSA 22:1">from wanem yu livim mi mi stap olsem?</para>
  <para style="q1" vid="PSA 22:1">Mi krae we mi krae</para>
  <para style="q3" vid="PSA 22:1">blong yu givhan long mi,</para>
  <para style="q2" vid="PSA 22:1">be yu no mekem.<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Long dei mi stap krae i kam long yu,</para>
  <para style="q3" vid="PSA 22:2">be yu no ansa,</para>
  <para style="q2" vid="PSA 22:2">mo long naet mi gohed blong krae,</para>
  <para style="q4" vid="PSA 22:2">be mi stap harem nogud yet.<verse eid="PSA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Be God yu yu tabu we yu tabu,</para>
  <para style="q2" vid="PSA 22:3">yu stap sidaon long bigfala jea blong yu,</para>
  <para style="q3" vid="PSA 22:3">mo mifala ol laen* blong Isrel,*</para>
  <para style="q4" vid="PSA 22:3">mifala i stap presem yu.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Ol bubu blong mifala bifo</para>
  <para style="q2" vid="PSA 22:4">oli putum tingting blong olgeta i stap long yu,</para>
  <para style="q2" vid="PSA 22:4">oli trastem yu,</para>
  <para style="q3" vid="PSA 22:4">nao yu yu tekemaot olgeta long trabol.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Oli krae i kam long yu,</para>
  <para style="q3" vid="PSA 22:5">nao yu yu sevem olgeta,</para>
  <para style="q2" vid="PSA 22:5">oli trastem yu,</para>
  <para style="q3" vid="PSA 22:5">nao tingting blong olgeta i no foldaon.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Be naoia mi mi no moa olsem man,</para>
  <para style="q2" vid="PSA 22:6">mi olsem maget nomo</para>
  <para style="q3" vid="PSA 22:6">we ol man oli stap lukluk nogud long mi,</para>
  <para style="q4" vid="PSA 22:6">oli no laekem mi.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22.7: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:39">Mat 27.39</ref>; <ref loc="MRK 15:29">Mak 15.29</ref>; <ref loc="LUK 23:35">Luk 23.35</ref></char>
    </note>Olgeta man we oli luk mi</para>
  <para style="q2" vid="PSA 22:7">oli stap tok nogud long mi,</para>
  <para style="q3" vid="PSA 22:7">oli stap laf long mi,</para>
  <para style="q4" vid="PSA 22:7">oli stap spet long mi</para>
  <para style="q3" vid="PSA 22:7">oli stap saksakem hed blong olgeta,<verse eid="PSA 22:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 22:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22.8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:43">Mat 27.43</ref>
      </char>
    </note>oli talem se, “?Hem i trastem Hae God,</para>
  <para style="q3" vid="PSA 22:8">be from wanem Hae God i no sevem hem?</para>
  <para style="q2" vid="PSA 22:8">?Sipos Hae God i laekem hem,</para>
  <para style="q3" vid="PSA 22:8">be from wanem hem i no givhan long hem?”<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9-10" style="v" sid="PSA 22:9-10" />Be i stat long dei ya we mi mi bon,</para>
  <para style="q3" vid="PSA 22:9-10">mi mi trastem yu,</para>
  <para style="q2" vid="PSA 22:9-10">mo i kam kasem tede,</para>
  <para style="q3" vid="PSA 22:9-10">oltaem yu yu God blong mi.</para>
  <para style="q1" vid="PSA 22:9-10">Long taem we mama blong mi</para>
  <para style="q4" vid="PSA 22:9-10">i bonem mi,</para>
  <para style="q3" vid="PSA 22:9-10">yu yu lukaot gud long mi, mi sef,</para>
  <para style="q2" vid="PSA 22:9-10">mo long taem we mi mi smol pikinini nomo,</para>
  <para style="q3" vid="PSA 22:9-10">yu yu holem mi mi stap laef</para>
  <para style="q4" vid="PSA 22:9-10">long titi blong mama blong mi.<verse eid="PSA 22:9-10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Plis yu no stap longwe long mi.</para>
  <para style="q1" vid="PSA 22:11">Naoia trabol i stap klosap,</para>
  <para style="q2" vid="PSA 22:11">mo i no gat man blong givhan long mi.<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Plante enemi oli kamraon long mi</para>
  <para style="q2" vid="PSA 22:12">olsem ol bul.</para>
  <para style="q1" vid="PSA 22:12">Oli olsem ol strong bul ya long Basan,</para>
  <para style="q2" vid="PSA 22:12">nao oli stap hivap raonabaot long mi.<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />Oli openem maot blong olgeta</para>
  <para style="q2" vid="PSA 22:13">olsem laeon we i wantem kakae man.</para>
  <para style="q1" vid="PSA 22:13">Oli stap singaot bigwan</para>
  <para style="q2" vid="PSA 22:13">olsem laeon we i hanggri tumas.<verse eid="PSA 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Paoa blong mi i lus,</para>
  <para style="q2" vid="PSA 22:14">olsem wota we i kafsaed</para>
  <para style="q3" vid="PSA 22:14">i go long sanbij.</para>
  <para style="q1" vid="PSA 22:14">Ol bun blong mi oli kamaot long ol joen blong olgeta,</para>
  <para style="q2" vid="PSA 22:14">mo tingting blong mi i foldaon</para>
  <para style="q3" vid="PSA 22:14">we i foldaon olgeta.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Paoa blong mi i finis olgeta,</para>
  <para style="q2" vid="PSA 22:15">mo tang blong mi i pas strong</para>
  <para style="q3" vid="PSA 22:15">insaed long maot blong mi antap.</para>
  <para style="q1" vid="PSA 22:15">Yu yu livim mi finis blong mi ded,</para>
  <para style="q2" vid="PSA 22:15">mi go long beregraon.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Ol man nogud oli kam hivap,</para>
  <para style="q2" vid="PSA 22:16">oli stap raon long mi,</para>
  <para style="q3" vid="PSA 22:16">olsem hip blong ol dog,</para>
  <para style="q4" vid="PSA 22:16">we oli kam blong kakae mi.</para>
  <para style="q1" vid="PSA 22:16">Olgeta oli stikim leg blong mi</para>
  <para style="q2" vid="PSA 22:16">mo han blong mi.<note caller="+" style="f"><char style="fr" closed="false">22.16: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">Ol man nogud oli kam hivap, oli stap raon long mi olsem hip blong ol dog we oli kam blong kakae <char style="bd">mi, nao oli terem</char> </char><char style="fqa" closed="false">leg blong mi mo han blong mi.</char></note><verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Man i save luk ol bun blong mi nomo,</para>
  <para style="q2" vid="PSA 22:17">nao ol enemi blong mi oli luk mi,</para>
  <para style="q3" vid="PSA 22:17">oli stap laf long mi.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22.18: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:35">Mat 27.35</ref>; <ref loc="MRK 15:24">Mak 15.24</ref>; <ref loc="LUK 23:34">Luk 23.34</ref>; <ref loc="JHN 19:24">Jon 19.24</ref></char>
    </note>Oli tekemaot ol klos blong mi</para>
  <para style="q3" vid="PSA 22:18">oli seraot long olgeta,</para>
  <para style="q2" vid="PSA 22:18">mo oli sakem daes blong luk se</para>
  <para style="q4" vid="PSA 22:18">hu bambae i tekem kot blong mi.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Hae God.</para>
  <para style="q1" vid="PSA 22:19">Plis yu no stap longwe long mi,</para>
  <para style="q2" vid="PSA 22:19">yu kam kwik,</para>
  <para style="q3" vid="PSA 22:19">yu givhan long mi.<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Yu blokem olgeta</para>
  <para style="q2" vid="PSA 22:20">we oli wantem kam faet long mi</para>
  <para style="q3" vid="PSA 22:20">blong kilim mi mi ded.</para>
  <para style="q1" vid="PSA 22:20">Yu sevem laef blong mi,</para>
  <para style="q2" vid="PSA 22:20">yu tekemaot mi long paoa blong olgeta ya</para>
  <para style="q3" vid="PSA 22:20">we oli olsem dog.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Yu sevem mi</para>
  <para style="q2" vid="PSA 22:21">blong ol laeon ya oli no kakae mi.</para>
  <para style="q1" vid="PSA 22:21">Mi mi no gat paoa nating</para>
  <para style="q2" vid="PSA 22:21">long fes blong ol wael bul ya.<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22.22: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:12">Hib 2.12</ref>
      </char>
    </note>Nao mi bambae mi talemaot long ol man blong mi</para>
  <para style="q2" vid="PSA 22:22">ol samting ya we yu bin mekem.</para>
  <para style="q1" vid="PSA 22:22">Bambae mi mi presem yu</para>
  <para style="q2" vid="PSA 22:22">long fes blong olgeta.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Bambae mi talem se,</para>
  <para style="q2" vid="PSA 22:23">“Yufala ol laen blong Isrel,</para>
  <para style="q3" vid="PSA 22:23">yufala i man blong wok blong Hae God.</para>
  <para style="q2" vid="PSA 22:23">Yufala i mas presem hem,</para>
  <para style="q3" vid="PSA 22:23">yufala i mas ona long hem,</para>
  <para style="q4" vid="PSA 22:23">mo yufala i mas bodaon long hem.<verse eid="PSA 22:23" /></para>
  <para style="q2">
    <verse number="24" style="v" sid="PSA 22:24" />Hem i no save fogetem ol puaman,</para>
  <para style="q3" vid="PSA 22:24">mo i no save livim olgeta</para>
  <para style="q4" vid="PSA 22:24">oli stap harem nogud.</para>
  <para style="q2" vid="PSA 22:24">Hem i no save tanem baksaed long olgeta.</para>
  <para style="q2" vid="PSA 22:24">Taem oli krae long hem</para>
  <para style="q4" vid="PSA 22:24">blong i givhan long olgeta,</para>
  <para style="q3" vid="PSA 22:24">hem i stap ansa long olgeta.”<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Nao bambae mi mi presem yu</para>
  <para style="q2" vid="PSA 22:25">long fes blong olgeta man blong yu.</para>
  <para style="q1" vid="PSA 22:25">Long fes blong olgeta ya</para>
  <para style="q3" vid="PSA 22:25">we oli stap mekem wosip long yu,</para>
  <para style="q2" vid="PSA 22:25">bambae mi mekem ol sakrefaes ya</para>
  <para style="q4" vid="PSA 22:25">we mi bin promes blong mekem.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Hae God,</para>
  <para style="q2" vid="PSA 22:26">ol puaman bambae oli kakae</para>
  <para style="q4" vid="PSA 22:26">olsem we oli wantem,</para>
  <para style="q3" vid="PSA 22:26">mo olgeta we oli stap lukaot yu</para>
  <para style="q3" vid="PSA 22:26">bambae oli presem yu.</para>
  <para style="q1" vid="PSA 22:26">Prea blong mi,</para>
  <para style="q2" vid="PSA 22:26">we olgeta ya bambae oli gat gudfala laef oltaem.<verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Hae God.</para>
  <para style="q1" vid="PSA 22:27">Olgeta man blong evri kantri</para>
  <para style="q2" vid="PSA 22:27">bambae oli tingbaot yu bakegen.</para>
  <para style="q1" vid="PSA 22:27">Olgeta evriwan long evri ples long</para>
  <para style="q2" vid="PSA 22:27">wol bambae oli kambak long yu.</para>
  <para style="q1" vid="PSA 22:27">Olgeta man blong evri kala</para>
  <para style="q2" vid="PSA 22:27">bambae oli mekem wosip long yu,<verse eid="PSA 22:27" /></para>
  <para style="q3">
    <verse number="28" style="v" sid="PSA 22:28" />from we yu yu King,</para>
  <para style="q4" vid="PSA 22:28">mo yu stap rulum olgeta man.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Olgeta praod man</para>
  <para style="q2" vid="PSA 22:29">bambae oli bodaon long yu.</para>
  <para style="q1" vid="PSA 22:29">Olgeta man blong wol ya oli save ded,</para>
  <para style="q2" vid="PSA 22:29">be bambae oli bodaon long fes blong yu.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Ol man we oli no bon yet</para>
  <para style="q2" vid="PSA 22:30">bambae oli wok blong yu.</para>
  <para style="q1" vid="PSA 22:30">Ol man bambae oli talemaot yu</para>
  <para style="q2" vid="PSA 22:30">long olgeta we bambae oli kam biaen.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Bambae oli talemaot ol stret fasin blong yu</para>
  <para style="q2" vid="PSA 22:31">long ol man we bambae oli bon biaen se,</para>
  <para style="q3" vid="PSA 22:31">“Hae God i sevem ol man blong hem.”<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">Hae God i stap lukaot gud long yumi</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />Hae God i stap lukaot gud long mi</para>
  <para style="q2" vid="PSA 23:1">olsem we mi mi sipsip blong hem,</para>
  <para style="q3" vid="PSA 23:1">nao mi no save sot long wan samting.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23.2: </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:17">Rev 7.17</ref>
      </char>
    </note>Oltaem hem i stap putum mi</para>
  <para style="q2" vid="PSA 23:2">mi spel gud long ples</para>
  <para style="q3" vid="PSA 23:2">we i gat gudfala gras long hem.</para>
  <para style="q1" vid="PSA 23:2">Hem i stap lidim mi</para>
  <para style="q2" vid="PSA 23:2">mi go long kwaet ples</para>
  <para style="q3" vid="PSA 23:2">we wota i stap ron smol long hem.<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />Hem i stap mekem laef blong mi</para>
  <para style="q2" vid="PSA 23:3">i niuwan bakegen,</para>
  <para style="q2" vid="PSA 23:3">mo i stap lidim mi long ol stret rod,</para>
  <para style="q2" vid="PSA 23:3">from we oltaem hem i stap lukaot gud long yumi.<verse eid="PSA 23:3" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Hae God.</para>
  <para style="q1" vid="PSA 23:4">Nating we mi pas</para>
  <para style="q3" vid="PSA 23:4">long ples we i tudak olgeta,</para>
  <para style="q4" vid="PSA 23:4">i ples blong ded,</para>
  <para style="q2" vid="PSA 23:4">be mi mi no save fraet long wan samting,</para>
  <para style="q3" vid="PSA 23:4">from we yu yu stap wetem mi.</para>
  <para style="q1" vid="PSA 23:4">Yu stap blokemgud mi</para>
  <para style="q3" vid="PSA 23:4">long nalnal blong yu</para>
  <para style="q4" vid="PSA 23:4">mo long wokingstik blong yu,</para>
  <para style="q2" vid="PSA 23:4">nao mi mi stap sef.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Yu yu mekemrere wan lafet blong mi</para>
  <para style="q2" vid="PSA 23:5">long fes blong ol enemi blong mi.</para>
  <para style="q1" vid="PSA 23:5">Yu mekem welkam long mi</para>
  <para style="q2" vid="PSA 23:5">olsem we yu mekem long wan haeman</para>
  <para style="q3" vid="PSA 23:5">we i kam long haos blong yu.</para>
  <para style="q1" vid="PSA 23:5">Yu fulumap kap blong mi</para>
  <para style="q2" vid="PSA 23:5">i fulap we i fulap gud.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Mi mi save</para>
  <para style="q2" vid="PSA 23:6">se oltaem long laef blong mi,</para>
  <para style="q3" vid="PSA 23:6">bambae yu gat sore long mi,</para>
  <para style="q4" vid="PSA 23:6">mo bambae yu mekem i gud tumas long mi,</para>
  <para style="q2" vid="PSA 23:6">mo haos blong yu bambae i hom blong mi olwe nomo.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">Hae King i kam</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24.1: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:26">1 Kor 10.26</ref>
      </char>
    </note>Wol ya wetem olgeta gudgudfala samting blong hem</para>
  <para style="q3" vid="PSA 24:1">oli blong Hae God.</para>
  <para style="q1" vid="PSA 24:1">Graon ya wetem olgeta samting we i stap long hem</para>
  <para style="q3" vid="PSA 24:1">oli blong hem nomo.<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />Hem i putum graon ya</para>
  <para style="q3" vid="PSA 24:2">long medel solwota,</para>
  <para style="q2" vid="PSA 24:2">i putum fandesen blong hem daon olgeta</para>
  <para style="q3" vid="PSA 24:2">aninit long dip solwota.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />?Hu man i gat raet blong go antap</para>
  <para style="q2" vid="PSA 24:3">long hil* blong Hae God?</para>
  <para style="q1" vid="PSA 24:3">?Hu man i save go insaed</para>
  <para style="q2" vid="PSA 24:3">long tabu ples ya blong hem?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4-6" style="v" sid="PSA 24:4-6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24.4-6: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:8">Mat 5.8</ref>
      </char>
    </note>Man we tingting blong hem i klin</para>
  <para style="q4" vid="PSA 24:4-6">mo laef blong hem i stret,</para>
  <para style="q3" vid="PSA 24:4-6">we i no save mekem wosip long ol giaman god,</para>
  <para style="q3" vid="PSA 24:4-6">mo i no save mekem ol giaman promes,</para>
  <para style="q2" vid="PSA 24:4-6">hem nao i save lukaot Hae God,</para>
  <para style="q4" vid="PSA 24:4-6">we i God blong Jekob,*</para>
  <para style="q3" vid="PSA 24:4-6">hem nao i save kam stanap long fes blong hem.</para>
  <para style="q1" vid="PSA 24:4-6">Man olsem,</para>
  <para style="q2" vid="PSA 24:4-6">Hae God bambae i blesem hem</para>
  <para style="q3" vid="PSA 24:4-6">mo i sevem hem.</para>
  <para style="q1" vid="PSA 24:4-6">God bambae i talemaot</para>
  <para style="q2" vid="PSA 24:4-6">we hem i no man blong mekem samting nogud.<verse eid="PSA 24:4-6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Ol doa.</para>
  <para style="q1" vid="PSA 24:7">!Yufala i mas open bigwan!</para>
  <para style="q1" vid="PSA 24:7">!Ol olfala doa, yufala i open gud!</para>
  <para style="q1" vid="PSA 24:7">Nao King ya we i hae we i hae</para>
  <para style="q2" vid="PSA 24:7">bambae i kam insaed.<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />?King ya we i hae we i hae, hu ya?</para>
  <para style="q1" vid="PSA 24:8">!Hemia Hae God ya!</para>
  <para style="q1" vid="PSA 24:8">Hem i strong, mo i gat paoa,</para>
  <para style="q2" vid="PSA 24:8">mo oltaem hem i stap win long faet.<verse eid="PSA 24:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Ol doa.</para>
  <para style="q1" vid="PSA 24:9">!Yufala i mas open bigwan!</para>
  <para style="q1" vid="PSA 24:9">!Ol olfala doa, yufala i open gud!</para>
  <para style="q1" vid="PSA 24:9">Nao King ya we i hae we i hae</para>
  <para style="q2" vid="PSA 24:9">bambae i kam insaed.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />?King ya we i hae we i hae, hu ya?</para>
  <para style="q1" vid="PSA 24:10">!Hemia Hae God ya!</para>
  <para style="q1" vid="PSA 24:10">Hem i gat olgeta paoa,</para>
  <para style="q2" vid="PSA 24:10">mo hem nao i King ya we i hae we i hae.<verse eid="PSA 24:10" /></para>
  <para style="b" />
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">Prea we man i mekem blong Hae God i lidim hem, i lukaot gud long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 25:1-2" />Hae God, yu yu God blong mi.</para>
  <para style="q1" vid="PSA 25:1-2">Mi mi stap prea long yu nomo,</para>
  <para style="q2" vid="PSA 25:1-2">mo mi trastem yu oltaem.</para>
  <para style="q1" vid="PSA 25:1-2">Plis yu no letem ol enemi blong mi</para>
  <para style="q2" vid="PSA 25:1-2">oli winim mi, oli stap laf long mi.</para>
  <para style="q1" vid="PSA 25:1-2">Yu no letem olgeta</para>
  <para style="q2" vid="PSA 25:1-2">oli mekem mi mi sem.<verse eid="PSA 25:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Ol man we oli stap trastem yu</para>
  <para style="q3" vid="PSA 25:3">oli no save sem,</para>
  <para style="q2" vid="PSA 25:3">be olgeta we oli kwik blong girap agens long yu,</para>
  <para style="q3" vid="PSA 25:3">olgeta ya nao bambae oli sem.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Hae God.</para>
  <para style="q1" vid="PSA 25:4">Plis yu tijim mi long ol fasin blong yu,</para>
  <para style="q2" vid="PSA 25:4">yu mekem mi mi savegud ol rod blong yu.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Yu tijim mi,</para>
  <para style="q2" vid="PSA 25:5">blong mi save folem trutok blong yu</para>
  <para style="q3" vid="PSA 25:5">long olgeta laef blong mi,</para>
  <para style="q2" vid="PSA 25:5">from we yu nomo yu God blong mi</para>
  <para style="q3" vid="PSA 25:5">we yu stap sevem mi.</para>
  <para style="q1" vid="PSA 25:5">Oltaem mi mi trastem yu.<verse eid="PSA 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Hae God,</para>
  <para style="q2" vid="PSA 25:6">plis yu no lego fasin ya blong yu</para>
  <para style="q3" vid="PSA 25:6">we yu yu kaen tumas,</para>
  <para style="q4" vid="PSA 25:6">mo oltaem yu stap lavem man tumas.</para>
  <para style="q1" vid="PSA 25:6">Yu yu stap soemaot fasin ya,</para>
  <para style="q2" vid="PSA 25:6">i stat longtaem finis, kam kasem tede.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Plis yu fogivim mi,</para>
  <para style="q2" vid="PSA 25:7">yu tekemaot ol sin blong mi</para>
  <para style="q3" vid="PSA 25:7">mo ol rabis fasin we mi stap mekem</para>
  <para style="q4" vid="PSA 25:7">taem mi yang yet.</para>
  <para style="q1" vid="PSA 25:7">Hae God, yu yu gud tumas,</para>
  <para style="q3" vid="PSA 25:7">mo oltaem yu stap lavem man,</para>
  <para style="q2" vid="PSA 25:7">plis yu tingbaot mi oltaem.<verse eid="PSA 25:7" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />Nao from we fasin blong Hae God i stret,</para>
  <para style="q3" vid="PSA 25:8">mo hem i stap mekem i gud long man,</para>
  <para style="q2" vid="PSA 25:8">hem i stap tijim ol man nogud</para>
  <para style="q4" vid="PSA 25:8">blong oli folem rod blong hem.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Ol man we tingting blong olgeta i stap daon,</para>
  <para style="q2" vid="PSA 25:9">hem i stap lidim olgeta</para>
  <para style="q4" vid="PSA 25:9">long ol rod we i stret,</para>
  <para style="q3" vid="PSA 25:9">mo i stap tijim olgeta</para>
  <para style="q3" vid="PSA 25:9">long ol samting we hem nomo i wantem.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Oltaem hem i lavem man tumas,</para>
  <para style="q2" vid="PSA 25:10">mo tingting blong hem i stap strong long man.</para>
  <para style="q1" vid="PSA 25:10">Long fasin ya nao,</para>
  <para style="q2" vid="PSA 25:10">hem i stap lidim olgeta</para>
  <para style="q4" vid="PSA 25:10">we oli stap holem promes* ya</para>
  <para style="q3" vid="PSA 25:10">we hem i mekem wetem ol bubu blong yumi bifo,</para>
  <para style="q3" vid="PSA 25:10">mo oli stap folem ol tok blong hem.<verse eid="PSA 25:10" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />Hae God.</para>
  <para style="q1" vid="PSA 25:11">Ol sin blong mi oli plante tumas,</para>
  <para style="q2" vid="PSA 25:11">plis yu fogivim mi,</para>
  <para style="q3" vid="PSA 25:11">yu tekemaot ol sin ya blong mi,</para>
  <para style="q4" vid="PSA 25:11">from we yu yu God blong fogivim man.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Man we i stap obei long yu,</para>
  <para style="q2" vid="PSA 25:12">yu bambae yu tijim hem</para>
  <para style="q3" vid="PSA 25:12">long rod we i gud blong hem i folem.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Oltaem bambae hem i gat plante samting,</para>
  <para style="q2" vid="PSA 25:13">mo ol pikinini blong hem</para>
  <para style="q3" vid="PSA 25:13">bambae oli holem graon blong hem</para>
  <para style="q4" vid="PSA 25:13">i blong olgeta.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />Yu yu fren blong olgeta</para>
  <para style="q3" vid="PSA 25:14">we oli stap obei long yu,</para>
  <para style="q2" vid="PSA 25:14">mo yu stap mekem olgeta</para>
  <para style="q4" vid="PSA 25:14">oli savegud promes ya</para>
  <para style="q3" vid="PSA 25:14">we yu mekem wetem ol bubu blong mifala bifo.<verse eid="PSA 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Hae God.</para>
  <para style="q1" vid="PSA 25:15">Oltaem nomo mi stap luk long yu,</para>
  <para style="q2" vid="PSA 25:15">mo yu yu stap sevem mi,</para>
  <para style="q3" vid="PSA 25:15">yu tekemaot mi long ol trabol.<verse eid="PSA 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />Plis yu luk long mi,</para>
  <para style="q3" vid="PSA 25:16">yu sore long mi,</para>
  <para style="q2" vid="PSA 25:16">from we mi mi no gat fren blong mi,</para>
  <para style="q4" vid="PSA 25:16">mo mi no moa strong.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Plis yu tekemaot ol samting</para>
  <para style="q3" vid="PSA 25:17">we i stap mekem mi mi wari tumas,</para>
  <para style="q2" vid="PSA 25:17">mo yu sevem mi</para>
  <para style="q4" vid="PSA 25:17">long ol trabol blong mi.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Yu tingbaot mi.</para>
  <para style="q1" vid="PSA 25:18">Mi mi trabol tumas, mi harem nogud,</para>
  <para style="q2" vid="PSA 25:18">plis yu fogivim mi,</para>
  <para style="q4" vid="PSA 25:18">yu tekemaot ol sin blong mi.<verse eid="PSA 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />!Yu luk!</para>
  <para style="q1" vid="PSA 25:19">Ol enemi blong mi oli plante</para>
  <para style="q3" vid="PSA 25:19">we i plante,</para>
  <para style="q2" vid="PSA 25:19">mo oli no laekem mi nating</para>
  <para style="q3" vid="PSA 25:19">oli agens long mi.<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Mi mi kam blong haed long yu.</para>
  <para style="q1" vid="PSA 25:20">Plis yu blokem mi, yu sevem mi,</para>
  <para style="q2" vid="PSA 25:20">yu no letem ol enemi blong mi</para>
  <para style="q2" vid="PSA 25:20">oli mekem mi mi sem.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Mi mi wantem</para>
  <para style="q2" vid="PSA 25:21">we stret fasin ya we mi stap mekem,</para>
  <para style="q3" vid="PSA 25:21">mo fasin ya we mi stap tok tru oltaem,</para>
  <para style="q4" vid="PSA 25:21">bambae i holem mi mi stap gud,</para>
  <para style="q3" vid="PSA 25:21">from we mi mi trastem yu.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />God,</para>
  <para style="q2" vid="PSA 25:22">plis yu sevem mifala</para>
  <para style="q3" vid="PSA 25:22">ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 25:22">yu tekemaot mifala</para>
  <para style="q4" vid="PSA 25:22">long olgeta trabol blong mifala.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">Prea blong wan gudfala man</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />Hae God.</para>
  <para style="q1" vid="PSA 26:1">Oltaem mi mi stap mekem</para>
  <para style="q3" vid="PSA 26:1">ol samting we i stret,</para>
  <para style="q2" vid="PSA 26:1">mo mi stap trastemgud yu.</para>
  <para style="q1" vid="PSA 26:1">Plis yu talemaot</para>
  <para style="q2" vid="PSA 26:1">we mi mi no mekem samting nogud.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />Plis yu lukluk long laef blong mi,</para>
  <para style="q3" vid="PSA 26:2">blong faenemaot se mi mi wanem man,</para>
  <para style="q2" vid="PSA 26:2">mo yu skelem olgeta tingting blong mi.<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Fasin ya blong yu</para>
  <para style="q3" vid="PSA 26:3">we oltaem yu stap lavem man tumas,</para>
  <para style="q2" vid="PSA 26:3">hem nao i stap lidim mi.</para>
  <para style="q1" vid="PSA 26:3">Fasin ya we tingting blong yu i stap strong long man,</para>
  <para style="q2" vid="PSA 26:3">hem nao i stap soemaot rod long mi.<verse eid="PSA 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Mi mi no save go stap</para>
  <para style="q2" vid="PSA 26:4">wetem ol man blong giaman.</para>
  <para style="q1" vid="PSA 26:4">Mi no gat bisnes nating</para>
  <para style="q2" vid="PSA 26:4">wetem ol man ya we oli gat tu tingting.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Mi mi no laekem</para>
  <para style="q3" vid="PSA 26:5">kampani blong ol rabis man,</para>
  <para style="q2" vid="PSA 26:5">mo mi no glad nating</para>
  <para style="q3" vid="PSA 26:5">blong go sidaon wetem ol man nogud.<verse eid="PSA 26:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Hae God.</para>
  <para style="q1" vid="PSA 26:6">Mi wasem han blong mi</para>
  <para style="q3" vid="PSA 26:6">blong soemaot we laef blong mi i klin</para>
  <para style="q4" vid="PSA 26:6">long fes blong yu,</para>
  <para style="q2" vid="PSA 26:6">nao mi stap wokbaot raon long olta blong yu,</para>
  <para style="q3" vid="PSA 26:6">mi stap mekem wosip long yu.<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />Mi stap singsing</para>
  <para style="q3" vid="PSA 26:7">blong talem tangkiu long yu,</para>
  <para style="q2" vid="PSA 26:7">mo mi stap talemaot</para>
  <para style="q4" vid="PSA 26:7">olgeta bigbigfala wok blong yu.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />Hae God,</para>
  <para style="q2" vid="PSA 26:8">mi mi laekem haos* blong yu tumas.</para>
  <para style="q1" vid="PSA 26:8">Haos ya i ples we yu yu stap long hem</para>
  <para style="q2" vid="PSA 26:8">long bigfala paoa blong yu.<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Taem yu spolem ol man nogud,</para>
  <para style="q2" vid="PSA 26:9">plis yu no spolem mi.</para>
  <para style="q1" vid="PSA 26:9">Taem yu panisim ol man blong kilim man,</para>
  <para style="q2" vid="PSA 26:9">plis yu no makem mi wetem olgeta.<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Plis yu no kaontem mi wetem ol man ya</para>
  <para style="q2" vid="PSA 26:10">we oli stap mekem ol rabis fasin oltaem,</para>
  <para style="q3" vid="PSA 26:10">mo oltaem oli rere nomo blong holem mane</para>
  <para style="q4" vid="PSA 26:10">blong oli givhan long man</para>
  <para style="q3" vid="PSA 26:10">long fasin we i no stret.<verse eid="PSA 26:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Mi mi stap mekem ol samting</para>
  <para style="q2" vid="PSA 26:11">we i stret nomo.</para>
  <para style="q1" vid="PSA 26:11">Plis yu sore long mi,</para>
  <para style="q2" vid="PSA 26:11">yu sevem mi.<verse eid="PSA 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Hae God,</para>
  <para style="q2" vid="PSA 26:12">oltaem yu yu stap mekem</para>
  <para style="q3" vid="PSA 26:12">we mi mi stap sef long olgeta trabol,</para>
  <para style="q2" vid="PSA 26:12">nao from samting ya</para>
  <para style="q3" vid="PSA 26:12">bambae mi mi presem yu</para>
  <para style="q4" vid="PSA 26:12">long fes blong olgeta man blong yu.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />Hae God, hem i laet blong mi,</para>
  <para style="q2" vid="PSA 27:1">mo hem i stap sevem mi.</para>
  <para style="q1" vid="PSA 27:1">Mi bambae mi no save fraet long man.</para>
  <para style="q1" vid="PSA 27:1">Hae God i strong ples blong haed blong mi.</para>
  <para style="q1" vid="PSA 27:1">Bambae mi no save fraet.<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Ol enemi blong mi mo ol badfren blong mi</para>
  <para style="q3" vid="PSA 27:2">oli man nogud,</para>
  <para style="q2" vid="PSA 27:2">nao taem oli kam blong faet long mi,</para>
  <para style="q4" vid="PSA 27:2">mo blong traem kilim mi,</para>
  <para style="q3" vid="PSA 27:2">olgeta oli stambol, oli foldaon.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Nating sipos wan bigfala grup blong ol soldia</para>
  <para style="q3" vid="PSA 27:3">oli kam hivap raon long mi,</para>
  <para style="q2" vid="PSA 27:3">be bambae mi no save fraet.</para>
  <para style="q1" vid="PSA 27:3">Nating sipos ol enemi blong mi</para>
  <para style="q3" vid="PSA 27:3">oli kam faet long mi,</para>
  <para style="q2" vid="PSA 27:3">be bambae mi trastem God yet.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Mi mi askem wan samting long Hae God,</para>
  <para style="q2" vid="PSA 27:4">wan samting nomo we mi mi wantem.</para>
  <para style="q1" vid="PSA 27:4">Mi wantem tumas blong mi save stap</para>
  <para style="q3" vid="PSA 27:4">long haos* blong hem</para>
  <para style="q4" vid="PSA 27:4">oltaem long laef blong mi,</para>
  <para style="q2" vid="PSA 27:4">blong mi stap lukluk ol gudgudfala fasin blong hem,</para>
  <para style="q3" vid="PSA 27:4">mi stap tingting gud long olgeta,</para>
  <para style="q4" vid="PSA 27:4">mo blong mi save askem long hem</para>
  <para style="q3" vid="PSA 27:4">blong i lidim mi oltaem.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Long taem blong trabol</para>
  <para style="q2" vid="PSA 27:5">hem bambae i lukaot gud long mi.</para>
  <para style="q1" vid="PSA 27:5">Bambae hem i haedem mi</para>
  <para style="q2" vid="PSA 27:5">insaed long Haos Tapolen blong hem.</para>
  <para style="q1" vid="PSA 27:5">Bambae hem i mekem mi mi stap gud</para>
  <para style="q2" vid="PSA 27:5">olsem we mi stap antap long wan bigfala ston</para>
  <para style="q3" vid="PSA 27:5">we i hae we i hae.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Nao bambae mi winim ol enemi blong mi</para>
  <para style="q2" vid="PSA 27:6">we oli stap raon long mi.</para>
  <para style="q1" vid="PSA 27:6">Mo bambae mi go long Haos Tapolen blong Hae God,</para>
  <para style="q2" vid="PSA 27:6">mi mekem sakrefaes long hem</para>
  <para style="q3" vid="PSA 27:6">we mi mi glad tumas,</para>
  <para style="q4" vid="PSA 27:6">mi stap singsingaot bigwan from.</para>
  <para style="q1" vid="PSA 27:6">Bambae mi singsing,</para>
  <para style="q2" vid="PSA 27:6">mi presem hem.<verse eid="PSA 27:6" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />Hae God.</para>
  <para style="q2" vid="PSA 27:7">Plis yu lesin long mi</para>
  <para style="q2" vid="PSA 27:7">taem mi singaot i kam long yu.</para>
  <para style="q1" vid="PSA 27:7">Plis yu sore long mi, yu ansa long mi.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Hae God, sipos yu talem se,</para>
  <para style="q3" vid="PSA 27:8">“Yu kam,</para>
  <para style="q4" vid="PSA 27:8">yu mekem wosip long mi,”</para>
  <para style="q2" vid="PSA 27:8">bambae mi mi glad, mi kam.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Plis yu no haedem fes blong yu long mi.</para>
  <para style="b" vid="PSA 27:9" />
  <para style="q1" vid="PSA 27:9">Mi mi man blong wok blong yu</para>
  <para style="q2" vid="PSA 27:9">we oltaem yu stap halpem mi.</para>
  <para style="q1" vid="PSA 27:9">Plis yu no kros long mi,</para>
  <para style="q2" vid="PSA 27:9">yu no pusumaot mi</para>
  <para style="q3" vid="PSA 27:9">blong mi gowe long yu.</para>
  <para style="q1" vid="PSA 27:9">God, oltaem yu yu stap sevem mi,</para>
  <para style="q2" vid="PSA 27:9">plis yu no lego mi.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Hae God.</para>
  <para style="q1" vid="PSA 27:10">Papa mo mama blong mi,</para>
  <para style="q2" vid="PSA 27:10">maet tufala i save lego mi,</para>
  <para style="q3" vid="PSA 27:10">be yu, oltaem nomo</para>
  <para style="q4" vid="PSA 27:10">bambae yu stap lukaot gud long mi.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />Hae God,</para>
  <para style="q2" vid="PSA 27:11">plis yu tijim mi long ol fasin blong yu.</para>
  <para style="q1" vid="PSA 27:11">Plis yu lidim mi mi go long rod</para>
  <para style="q3" vid="PSA 27:11">we i sef,</para>
  <para style="q2" vid="PSA 27:11">from we ol enemi blong mi oli plante tumas.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Plis yu no livim mi mi stap</para>
  <para style="q2" vid="PSA 27:12">long han blong ol enemi blong mi.</para>
  <para style="q1" vid="PSA 27:12">Olgeta oli stap kam faet long mi</para>
  <para style="q2" vid="PSA 27:12">long ol giaman toktok,</para>
  <para style="q3" vid="PSA 27:12">mo ol strong tok blong mekem mi mi fraet.<verse eid="PSA 27:12" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Mi mi savegud</para>
  <para style="q2" vid="PSA 27:13">we bambae mi stap gogo mi luk</para>
  <para style="q3" vid="PSA 27:13">we Hae God bambae i mekem i gud tumas long mi</para>
  <para style="q4" vid="PSA 27:13">long laef ya we yumi stap long hem naoia.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Yumi mas trastem Hae God,</para>
  <para style="q2" vid="PSA 27:14">mo yumi mas bilif long hem.</para>
  <para style="q1" vid="PSA 27:14">Yumi no mas letem tingting blong yumi i foldaon,</para>
  <para style="q2" vid="PSA 27:14">oltaem yumi mas trastem hem.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">Prea we man i mekem blong Hae God i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />Hae God.</para>
  <para style="q1" vid="PSA 28:1">Mi mi krae i kam long yu</para>
  <para style="q3" vid="PSA 28:1">from we yu nomo yu strong sefples blong mi,</para>
  <para style="q2" vid="PSA 28:1">plis yu harem krae blong mi.</para>
  <para style="q1" vid="PSA 28:1">Sipos yu no mekem wan samting,</para>
  <para style="q2" vid="PSA 28:1">bambae mi lus wetem olgeta</para>
  <para style="q3" vid="PSA 28:1">we oli stap godaon long Hom* blong ol Dedman.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Sipos mi luk long tabu haos* blong yu,</para>
  <para style="q3" vid="PSA 28:2">mi leftemap han blong mi,</para>
  <para style="q4" vid="PSA 28:2">mi prea,</para>
  <para style="q2" vid="PSA 28:2">plis yu lesin long mi.</para>
  <para style="q1" vid="PSA 28:2">Sipos mi kam, mi krae long yu</para>
  <para style="q3" vid="PSA 28:2">blong yu givhan long mi,</para>
  <para style="q2" vid="PSA 28:2">plis yu harem krae blong mi.<verse eid="PSA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Sipos yu jajem ol man nogud ya,</para>
  <para style="q2" vid="PSA 28:3">plis yu no kaontem mi wetem olgeta.</para>
  <para style="q1" vid="PSA 28:3">Olgeta ya oli stap talem ol gudfala</para>
  <para style="q3" vid="PSA 28:3">tok long ol narafala man,</para>
  <para style="q2" vid="PSA 28:3">be long tingting blong olgeta,</para>
  <para style="q3" vid="PSA 28:3">oli no laekem ol man ya nating,</para>
  <para style="q4" vid="PSA 28:3">oli agens long olgeta.<verse eid="PSA 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28.4: </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:12">Rev 22.12</ref>
      </char>
    </note>Plis yu panisim olgeta</para>
  <para style="q2" vid="PSA 28:4">from ol samting we oli bin mekem,</para>
  <para style="q3" vid="PSA 28:4">mo ol rabis fasin ya we oli bin folem.</para>
  <para style="q1" vid="PSA 28:4">Yu mekem olgeta</para>
  <para style="q2" vid="PSA 28:4">oli kakae frut blong ol samting ya bakegen.<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Hae God.</para>
  <para style="q1" vid="PSA 28:5">Olgeta ya oli no tingting nating</para>
  <para style="q3" vid="PSA 28:5">long ol wok blong yu,</para>
  <para style="q4" vid="PSA 28:5">mo long ol samting we yu yu mekem.</para>
  <para style="q1" vid="PSA 28:5">Taswe bambae yu yu panisim olgeta,</para>
  <para style="q2" vid="PSA 28:5">yu flatemgud olgeta</para>
  <para style="q3" vid="PSA 28:5">we oli no save girap bakegen samtaem.<verse eid="PSA 28:5" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Mi mi mas presem Hae God,</para>
  <para style="q2" vid="PSA 28:6">from we hem i harem mi finis</para>
  <para style="q3" vid="PSA 28:6">we mi stap krae long hem</para>
  <para style="q4" vid="PSA 28:6">blong i givhan long mi.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />Hem i paoa blong mi</para>
  <para style="q2" vid="PSA 28:7">mo hem i stap lukaot gud long mi.</para>
  <para style="q1" vid="PSA 28:7">Mi mi trastem hem.</para>
  <para style="q1" vid="PSA 28:7">Hem i stap givhan long mi,</para>
  <para style="q2" vid="PSA 28:7">mo i stap mekem mi mi glad.</para>
  <para style="q1" vid="PSA 28:7">Mi mi stap presem hem,</para>
  <para style="q2" vid="PSA 28:7">long ol singsing blong glad.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />Yumi ol man blong Hae God,</para>
  <para style="q2" vid="PSA 28:8">mo hem nomo i stap givim paoa long yumi,</para>
  <para style="q3" vid="PSA 28:8">mo hem i stap sevem yumi.</para>
  <para style="q1" vid="PSA 28:8">Hem i makemaot mi,</para>
  <para style="q2" vid="PSA 28:8">mo i putumap mi mi king.</para>
  <para style="q1" vid="PSA 28:8">Oltaem hem i stap blokemgud mi,</para>
  <para style="q2" vid="PSA 28:8">mo i stap sevem mi.<verse eid="PSA 28:8" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />Hae God.</para>
  <para style="q2" vid="PSA 28:9">Plis yu sevem ol man blong yu,</para>
  <para style="q2" vid="PSA 28:9">yu blesem olgeta.</para>
  <para style="q1" vid="PSA 28:9">Olgeta oli olsem sipsip blong yu.</para>
  <para style="q1" vid="PSA 28:9">Plis yu lukaot gud long olgeta oltaem,</para>
  <para style="q2" vid="PSA 28:9">gogo i no save finis.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">Voes blong Hae God i kamaot long hariken</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29.1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:7-9">Sam 96.7-9</ref>
      </char>
    </note>Yufala we i stap long heven,</para>
  <para style="q2" vid="PSA 29:1">yufala i presem Hae God.</para>
  <para style="q1" vid="PSA 29:1">Yufala i presem hem from paoa blong hem,</para>
  <para style="q2" vid="PSA 29:1">mo from ol gudgudfala samting blong hem.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Hae God ya,</para>
  <para style="q2" vid="PSA 29:2">nem blong hem i hae we i hae.</para>
  <para style="q1" vid="PSA 29:2">Yufala i presem hem</para>
  <para style="q2" vid="PSA 29:2">long fasin we i stret long hem.</para>
  <para style="q1" vid="PSA 29:2">Hem i tabu we i tabu.</para>
  <para style="q1" vid="PSA 29:2">Yufala i bodaon long hem,</para>
  <para style="q2" vid="PSA 29:2">yufala i wosipim hem.<verse eid="PSA 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />Nem blong Hae God i hae we i hae.</para>
  <para style="q1" vid="PSA 29:3">Ol man oli save harem voes blong hem long solwota.</para>
  <para style="q1" vid="PSA 29:3">Voes blong hem i faerap olsem tanda</para>
  <para style="q2" vid="PSA 29:3">antap long solwota.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Ol man oli harem voes blong hem,</para>
  <para style="q2" vid="PSA 29:4">mo taem hem i tok,</para>
  <para style="q3" vid="PSA 29:4">oli haremsave se hem i King,</para>
  <para style="q4" vid="PSA 29:4">mo hem i gat olgeta paoa.<verse eid="PSA 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Voes blong Hae God</para>
  <para style="q2" vid="PSA 29:5">i brebrekem ol strongfala tri ya sida.*</para>
  <para style="q1" vid="PSA 29:5">Nating we ol bigbigfala sida</para>
  <para style="q3" vid="PSA 29:5">blong ol hil blong Lebanon,</para>
  <para style="q2" vid="PSA 29:5">be Hae God i brebrekem olgeta.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Hem i mekem ol hil ya long Lebanon</para>
  <para style="q3" vid="PSA 29:6">wetem hil ya Hemon</para>
  <para style="q2" vid="PSA 29:6">oli stap seksek bigwan.</para>
  <para style="q1" vid="PSA 29:6">Oli olsem ol pikinini</para>
  <para style="q3" vid="PSA 29:6">blong buluk wetem ol yang bul</para>
  <para style="q3" vid="PSA 29:6">we oli stap jamjam olbaot.<verse eid="PSA 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Voes blong Hae God</para>
  <para style="q2" vid="PSA 29:7">i mekem laetning i laet.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Voes blong hem</para>
  <para style="q2" vid="PSA 29:8">i mekem graon blong draeples</para>
  <para style="q3" vid="PSA 29:8">i seksek,</para>
  <para style="q2" vid="PSA 29:8">i mekem draeples ya long Kades</para>
  <para style="q3" vid="PSA 29:8">i seksek we i seksek gud.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Voes blong Hae God</para>
  <para style="q2" vid="PSA 29:9">i seksekem ol oktri,*</para>
  <para style="q3" vid="PSA 29:9">i tekemaot ol lif blong olgeta,</para>
  <para style="q2" vid="PSA 29:9">nao olgeta man</para>
  <para style="q4" vid="PSA 29:9">we oli stap long haos* blong hem,</para>
  <para style="q3" vid="PSA 29:9">oli singaot bigwan se,</para>
  <para style="q4" vid="PSA 29:9">“Yumi leftemap nem blong God.”<note caller="+" style="f"><char style="fr" closed="false">29.9: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">Voes blong Hae God <char style="bd">i mekem ol anamol ya dia oli bonem ol pikinini blong olgeta, mo i mekem ol nani oli bonem pikinini we i no taem blong olgeta yet. Nao</char> </char><char style="fqa" closed="false">olgeta man we oli stap long haos blong hem, oli singaot bigwan se, “Yumi leftemap nem blong God.”</char></note><verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />Nating we ol wota oli ron bigwan,</para>
  <para style="q2" vid="PSA 29:10">be Hae God i stap rul long olgeta.</para>
  <para style="q1" vid="PSA 29:10">Hem i King,</para>
  <para style="q2" vid="PSA 29:10">we bambae i stap rul oltaem nomo,</para>
  <para style="q3" vid="PSA 29:10">gogo i no save finis.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />Hem i stap givim paoa</para>
  <para style="q3" vid="PSA 29:11">long ol man blong hem,</para>
  <para style="q2" vid="PSA 29:11">mo i stap blesem olgeta,</para>
  <para style="q3" vid="PSA 29:11">i stap mekem olgeta</para>
  <para style="q4" vid="PSA 29:11">oli gat gudfala laef, oli gat pis.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">Sing blong talem tangkiu long God</para>
  <para style="sp">(Sing ya, Deved i wokem. Mo biaen, ol man oli sing long hem blong mekem haos* blong God i tabu bakegen.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />Hae God.</para>
  <para style="q1" vid="PSA 30:1">Mi mi stap presem yu</para>
  <para style="q3" vid="PSA 30:1">from we yu yu sevem mi</para>
  <para style="q4" vid="PSA 30:1">nao mi mi no ded,</para>
  <para style="q2" vid="PSA 30:1">mo yu no letem ol enemi blong mi</para>
  <para style="q4" vid="PSA 30:1">oli daonem mi,</para>
  <para style="q3" vid="PSA 30:1">nao oli stap glad from.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />Hae God,</para>
  <para style="q2" vid="PSA 30:2">yu yu God blong mi.</para>
  <para style="q1" vid="PSA 30:2">Mi mi krae long yu</para>
  <para style="q3" vid="PSA 30:2">blong yu givhan long mi,</para>
  <para style="q2" vid="PSA 30:2">nao yu yu mekem bodi blong mi</para>
  <para style="q3" vid="PSA 30:2">i gud bakegen.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Yu yu blokem mi</para>
  <para style="q3" vid="PSA 30:3">blong mi no go long Hom* blong ol Dedman,</para>
  <para style="q2" vid="PSA 30:3">yu sevem laef blong mi.<verse eid="PSA 30:3" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Yumi ol man blong Hae God</para>
  <para style="q3" vid="PSA 30:4">we tingting blong yumi i strong long hem,</para>
  <para style="q2" vid="PSA 30:4">yumi sing, yumi presem hem.</para>
  <para style="q1" vid="PSA 30:4">Hem i tabu.</para>
  <para style="q1" vid="PSA 30:4">Yumi mas tingbaot ol samting ya</para>
  <para style="q3" vid="PSA 30:4">we hem i bin mekem,</para>
  <para style="q2" vid="PSA 30:4">nao yumi talem tangkiu long hem from.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Kros blong hem i save stap smoltaem nomo,</para>
  <para style="q2" vid="PSA 30:5">be gudfala fasin blong hem i save stap</para>
  <para style="q3" vid="PSA 30:5">gogo laef blong man i finis.</para>
  <para style="q1" vid="PSA 30:5">Long naet,</para>
  <para style="q2" vid="PSA 30:5">maet man i save harem nogud,</para>
  <para style="q4" vid="PSA 30:5">i krae,</para>
  <para style="q2" vid="PSA 30:5">be long moning,</para>
  <para style="q3" vid="PSA 30:5">i save harem gud, i glad bakegen.<verse eid="PSA 30:5" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="6-7" style="v" sid="PSA 30:6-7" />Hae God.</para>
  <para style="q1" vid="PSA 30:6-7">Bifo, mi harem se mi mi sef,</para>
  <para style="q2" vid="PSA 30:6-7">nao mi talem se,</para>
  <para style="q3" vid="PSA 30:6-7">“Neva wan samting i save winim mi.”</para>
  <para style="q1" vid="PSA 30:6-7">Yu yu bin mekem i gud tumas long mi,</para>
  <para style="q2" vid="PSA 30:6-7">yu bin blokemgud mi</para>
  <para style="q3" vid="PSA 30:6-7">olsem wan strong hil blong haed.</para>
  <para style="q1" vid="PSA 30:6-7">Be biaen, yu haedem fes blong yu,</para>
  <para style="q3" vid="PSA 30:6-7">nao mi mi fraet bakegen.<verse eid="PSA 30:6-7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Hae God,</para>
  <para style="q2" vid="PSA 30:8">long taem ya mi mi singaot long yu,</para>
  <para style="q3" vid="PSA 30:8">mi askem long yu</para>
  <para style="q4" vid="PSA 30:8">blong yu givhan long mi.<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />Mi talem se,</para>
  <para style="q2" vid="PSA 30:9">“?Sipos mi mi ded,</para>
  <para style="q3" vid="PSA 30:9">bambae yu yu winim wanem?</para>
  <para style="q2" vid="PSA 30:9">?Sipos mi mi godaon</para>
  <para style="q4" vid="PSA 30:9">long Hom blong ol Dedman,</para>
  <para style="q3" vid="PSA 30:9">wanem gudfala samting</para>
  <para style="q4" vid="PSA 30:9">bambae yu yu kasem?</para>
  <para style="q2" vid="PSA 30:9">!Ol dedman oli no save presem yu!</para>
  <para style="q2" vid="PSA 30:9">Asis blong man i no save talemaot</para>
  <para style="q3" vid="PSA 30:9">gudfala fasin ya blong yu</para>
  <para style="q4" vid="PSA 30:9">we i no save foldaon samtaem.<verse eid="PSA 30:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 30:10" />Hae God,</para>
  <para style="q2" vid="PSA 30:10">plis yu harem mi,</para>
  <para style="q3" vid="PSA 30:10">yu sore long mi.</para>
  <para style="q2" vid="PSA 30:10">Plis yu givhan long mi.”<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Yu yu tekemaot harem nogud blong mi finis,</para>
  <para style="q2" vid="PSA 30:11">mo yu mekem mi mi glad</para>
  <para style="q3" vid="PSA 30:11">we mi stap danis from.</para>
  <para style="q1" vid="PSA 30:11">Yu yu tekemaot ol rabis klos ya finis</para>
  <para style="q2" vid="PSA 30:11">we i soemaot we mi mi harem nogud,</para>
  <para style="q3" vid="PSA 30:11">mo yu mekem tingting blong mi i fulap glad.<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />Nao from samting ya,</para>
  <para style="q2" vid="PSA 30:12">bambae mi no save stap kwaet.</para>
  <para style="q1" vid="PSA 30:12">Bambae mi stap presem yu.</para>
  <para style="q1" vid="PSA 30:12">Hae God, yu yu God blong mi.</para>
  <para style="q1" vid="PSA 30:12">Bambae mi stap talem tangkiu long yu oltaem,</para>
  <para style="q2" vid="PSA 30:12">gogo i no save finis.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">Tok blong man we i trastem Hae God</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />Hae God.</para>
  <para style="q1" vid="PSA 31:1">Mi mi kam long yu</para>
  <para style="q2" vid="PSA 31:1">blong yu lukaot long mi.</para>
  <para style="q1" vid="PSA 31:1">Plis yu no letem ol enemi blong mi</para>
  <para style="q2" vid="PSA 31:1">oli winim mi.</para>
  <para style="q1" vid="PSA 31:1">Yu yu God we fasin blong yu i stret.</para>
  <para style="q1" vid="PSA 31:1">Mi mi prea long yu,</para>
  <para style="q2" vid="PSA 31:1">plis yu sevem mi.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Naoia plis yu harem mi,</para>
  <para style="q2" vid="PSA 31:2">yu sevem mi.</para>
  <para style="q1" vid="PSA 31:2">Plis yu blokemgud mi,</para>
  <para style="q2" vid="PSA 31:2">yu kam olsem wan strong ples blong haed blong mi,</para>
  <para style="q3" vid="PSA 31:2">we mi mi save sef long hem.<verse eid="PSA 31:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Yu nao yu sefples blong mi,</para>
  <para style="q2" vid="PSA 31:3">yu nomo yu strong ples blong mi blong haed.</para>
  <para style="q1" vid="PSA 31:3">Plis yu go fastaem, yu lidim mi,</para>
  <para style="q2" vid="PSA 31:3">from we yu nao yu sefples blong mi.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Plis yu no letem mi mi foldaon long trap ya</para>
  <para style="q2" vid="PSA 31:4">we oli putumrere finis blong kasem mi.</para>
  <para style="q1" vid="PSA 31:4">Yu yu ples blong haed blong mi</para>
  <para style="q2" vid="PSA 31:4">we trabol i no save spolem mi.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31.5: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:46">Luk 23.46</ref>
      </char>
    </note>Hae God,</para>
  <para style="q2" vid="PSA 31:5">mi mi putum laef blong mi</para>
  <para style="q3" vid="PSA 31:5">long han blong yu.</para>
  <para style="q1" vid="PSA 31:5">Mi save we yu bambae yu sevem mi,</para>
  <para style="q2" vid="PSA 31:5">from we yu yu God,</para>
  <para style="q4" vid="PSA 31:5">we oltaem, tingting blong yu</para>
  <para style="q3" vid="PSA 31:5">i stap strong long ol man blong yu.<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />Olgeta ya</para>
  <para style="q3" vid="PSA 31:6">we oli stap mekem wosip long ol giaman god,</para>
  <para style="q2" vid="PSA 31:6">yu yu no laekem olgeta nating,</para>
  <para style="q4" vid="PSA 31:6">yu stap agens long olgeta,</para>
  <para style="q3" vid="PSA 31:6">be mi mi stap trastem yu oltaem.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Bambae mi mi hapi,</para>
  <para style="q2" vid="PSA 31:7">mi glad tumas,</para>
  <para style="q3" vid="PSA 31:7">from fasin ya blong yu</para>
  <para style="q4" vid="PSA 31:7">we oltaem yu lavem man tumas.</para>
  <para style="q1" vid="PSA 31:7">Taem mi mi harem nogud,</para>
  <para style="q3" vid="PSA 31:7">be yu yu luk,</para>
  <para style="q2" vid="PSA 31:7">mo taem mi mi stap long trabol,</para>
  <para style="q4" vid="PSA 31:7">be yu yu save.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Yu yu no letem ol enemi blong mi</para>
  <para style="q3" vid="PSA 31:8">oli holem mi,</para>
  <para style="q2" vid="PSA 31:8">yu mekem mi mi fri</para>
  <para style="q4" vid="PSA 31:8">blong go long weples</para>
  <para style="q3" vid="PSA 31:8">we mi wantem go long hem.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />Hae God,</para>
  <para style="q2" vid="PSA 31:9">plis yu sore long mi,</para>
  <para style="q3" vid="PSA 31:9">from we naoia,</para>
  <para style="q4" vid="PSA 31:9">mi mi stap long trabol.</para>
  <para style="q1" vid="PSA 31:9">Ae blong mi i solap</para>
  <para style="q3" vid="PSA 31:9">from we mi stap krae tumas,</para>
  <para style="q2" vid="PSA 31:9">bodi blong mi i slak we i slak,</para>
  <para style="q3" vid="PSA 31:9">mo tingting blong mi i kam nogud olgeta.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Paoa blong mi i finis,</para>
  <para style="q2" vid="PSA 31:10">from we mi stap krae tumas.</para>
  <para style="q1" vid="PSA 31:10">Laef blong mi i kam sotfala,</para>
  <para style="q2" vid="PSA 31:10">from we oltaem mi stap harem nogud.</para>
  <para style="q1" vid="PSA 31:10">Mi mi kam slak olgeta from ol trabol blong mi,</para>
  <para style="q2" vid="PSA 31:10">mo paoa blong mi i finis olgeta.<verse eid="PSA 31:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Ol enemi blong mi,</para>
  <para style="q2" vid="PSA 31:11">mo olgeta we oli stap klosap long mi,</para>
  <para style="q4" vid="PSA 31:11">oli no laekem mi,</para>
  <para style="q3" vid="PSA 31:11">oli stap lukluk nogud long mi.</para>
  <para style="q1" vid="PSA 31:11">Olgeta we oli savegud mi</para>
  <para style="q2" vid="PSA 31:11">be oli fraet long mi.</para>
  <para style="q1" vid="PSA 31:11">Taem oli luk mi long rod,</para>
  <para style="q2" vid="PSA 31:11">oli ronwe long mi.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Olgeta evriwan oli fogetem mi</para>
  <para style="q2" vid="PSA 31:12">olsem we mi mi ded finis.</para>
  <para style="q1" vid="PSA 31:12">Mi mi kam olsem wan samting</para>
  <para style="q2" vid="PSA 31:12">we ol man oli sakem finis.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Mi harem we ol enemi blong mi</para>
  <para style="q2" vid="PSA 31:13">oli stap tok smosmol agens long mi.</para>
  <para style="q1" vid="PSA 31:13">Nao long evri ples we mi pas long hem,</para>
  <para style="q2" vid="PSA 31:13">oli stap mekem mi mi fraet we mi fraet.</para>
  <para style="q1" vid="PSA 31:13">Oli stap mekem plan agens long mi,</para>
  <para style="q2" vid="PSA 31:13">blong kilim mi mi ded.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Be Hae God, mi mi trastem yu.</para>
  <para style="q1" vid="PSA 31:14">Mi talem se, “Yu yu God blong mi.”<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Oltaem mi mi stap long han blong yu.</para>
  <para style="q1" vid="PSA 31:15">Plis yu tekemaot mi</para>
  <para style="q2" vid="PSA 31:15">long han blong ol enemi ya blong mi,</para>
  <para style="q3" vid="PSA 31:15">we oli stap spolem mi.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Mi mi man blong wok blong yu.</para>
  <para style="q1" vid="PSA 31:16">Plis yu lukluk i kam long mi,</para>
  <para style="q2" vid="PSA 31:16">yu kaen long mi.</para>
  <para style="q1" vid="PSA 31:16">Fasin blong yu,</para>
  <para style="q2" vid="PSA 31:16">oltaem yu yu lavem man tumas,</para>
  <para style="q3" vid="PSA 31:16">plis yu sevem mi.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />Hae God,</para>
  <para style="q2" vid="PSA 31:17">mi mi singaot long yu.</para>
  <para style="q1" vid="PSA 31:17">Plis yu no letem ol enemi blong mi</para>
  <para style="q2" vid="PSA 31:17">oli mekem mi mi sem.</para>
  <para style="q1" vid="PSA 31:17">Olgeta ya oli man nogud,</para>
  <para style="q2" vid="PSA 31:17">i gud yu mekem olgeta oli sem.</para>
  <para style="q1" vid="PSA 31:17">I gud yu satem maot blong olgeta,</para>
  <para style="q2" vid="PSA 31:17">yu letem olgeta oli godaon</para>
  <para style="q3" vid="PSA 31:17">long Hom* blong ol Dedman.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Olgeta ya oli praod tumas,</para>
  <para style="q3" vid="PSA 31:18">mo oli stap tok flas,</para>
  <para style="q2" vid="PSA 31:18">be oli man blong giaman nomo,</para>
  <para style="q3" vid="PSA 31:18">oli stap tok nogud long ol stret man.</para>
  <para style="q1" vid="PSA 31:18">Plis yu blokem maot blong olgeta</para>
  <para style="q2" vid="PSA 31:18">blong oli stap kwaet.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />!Hae God, yu yu gud tumas!</para>
  <para style="q1" vid="PSA 31:19">Long fes blong olgeta man long wol,</para>
  <para style="q2" vid="PSA 31:19">yu yu stap givim ol gudgudfala samting</para>
  <para style="q4" vid="PSA 31:19">long ol man we oli ona long yu</para>
  <para style="q3" vid="PSA 31:19">mo we oli luk long yu</para>
  <para style="q4" vid="PSA 31:19">blong yu sevem olgeta.<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Yu stap haedem ol man ya</para>
  <para style="q3" vid="PSA 31:20">oli stap gud long saed blong yu,</para>
  <para style="q2" vid="PSA 31:20">nao ol plan blong ol man nogud</para>
  <para style="q3" vid="PSA 31:20">oli no save spolem olgeta.</para>
  <para style="q1" vid="PSA 31:20">Yu stap haedem olgeta long sefples blong haed,</para>
  <para style="q2" vid="PSA 31:20">nao ol rabis tok blong ol enemi blong olgeta</para>
  <para style="q3" vid="PSA 31:20">i no save spolem olgeta.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />!Hae God, mi mi presem yu!</para>
  <para style="q1" vid="PSA 31:21">Taem ol enemi blong mi oli raonem mi,</para>
  <para style="q3" vid="PSA 31:21">oli faet long mi,</para>
  <para style="q2" vid="PSA 31:21">yu yu soemaot</para>
  <para style="q4" vid="PSA 31:21">we oltaem yu lavem mi tumas,</para>
  <para style="q3" vid="PSA 31:21">nao yu givhan long mi.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />Mi mi fraet,</para>
  <para style="q2" vid="PSA 31:22">mi ting se yu yu ronemaot mi finis</para>
  <para style="q4" vid="PSA 31:22">long fes blong yu.</para>
  <para style="q1" vid="PSA 31:22">Be taem mi krae i kam long yu</para>
  <para style="q2" vid="PSA 31:22">blong yu givhan long mi,</para>
  <para style="q3" vid="PSA 31:22">yu yu harem mi.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Yufala we tingting blong yufala</para>
  <para style="q3" vid="PSA 31:23">i stap strong long Hae God,</para>
  <para style="q2" vid="PSA 31:23">yufala i mas lavem hem.</para>
  <para style="q1" vid="PSA 31:23">Hae God i stap lukaot gud</para>
  <para style="q4" vid="PSA 31:23">long ol man</para>
  <para style="q3" vid="PSA 31:23">we tingting blong olgeta</para>
  <para style="q4" vid="PSA 31:23">i stap strong long hem,</para>
  <para style="q2" vid="PSA 31:23">hem i stap sevem olgeta.</para>
  <para style="q1" vid="PSA 31:23">Be ol praod man,</para>
  <para style="q2" vid="PSA 31:23">hem i stap panisimgud olgeta</para>
  <para style="q3" vid="PSA 31:23">long mak we i stret blong oli kasem.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Yufala evriwan</para>
  <para style="q2" vid="PSA 31:24">we yufala i putum tingting blong yufala</para>
  <para style="q3" vid="PSA 31:24">i stap long Hae God,</para>
  <para style="q2" vid="PSA 31:24">yufala i mas strong.</para>
  <para style="q1" vid="PSA 31:24">Tingting blong yufala i mas stap strong oltaem.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">Man i talemaot sin blong hem, mo Hae God i fogivim hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32.1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:7">Rom 4.7</ref>,<ref loc="ROM 4:8">8</ref></char>
    </note>Man we Hae God i fogivim hem,</para>
  <para style="q2" vid="PSA 32:1">mo i tekemaot ol sin blong hem,</para>
  <para style="q2" vid="PSA 32:1">hem i save harem gud.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Man we Hae God i no moa jajem hem</para>
  <para style="q4" vid="PSA 32:2">from ol samting nogud we hem i mekem,</para>
  <para style="q3" vid="PSA 32:2">mo we i no moa giaman long laef blong hem,</para>
  <para style="q2" vid="PSA 32:2">hem i save harem gud.<verse eid="PSA 32:2" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="3-5" style="v" sid="PSA 32:3-5" />Taem mi no talemaot ol sin blong mi long yu,</para>
  <para style="q3" vid="PSA 32:3-5">mi mi slak we mi slak,</para>
  <para style="q4" vid="PSA 32:3-5">from we evri dei nomo, <optbreak /> mi stap krae kasem tudak.</para>
  <para style="q1" vid="PSA 32:3-5">Long dei mo long naet,</para>
  <para style="q2" vid="PSA 32:3-5">yu stap panisim mi.</para>
  <para style="q1" vid="PSA 32:3-5">Paoa blong mi i lus olgeta,</para>
  <para style="q2" vid="PSA 32:3-5">olsem wota we bigsan i bonem,</para>
  <para style="q3" vid="PSA 32:3-5">nao i drae olgeta.</para>
  <para style="q1" vid="PSA 32:3-5">Ale, mi talem se,</para>
  <para style="q2" vid="PSA 32:3-5">“Bambae mi talemaot sin blong mi long Hae God.”</para>
  <para style="q1" vid="PSA 32:3-5">Nao mi talemaot ol sin blong mi long yu,</para>
  <para style="q2" vid="PSA 32:3-5">mi no moa haedem ol samting nogud</para>
  <para style="q3" vid="PSA 32:3-5">we mi mi mekem.</para>
  <para style="q1" vid="PSA 32:3-5">Nao yu yu fogivim mi,</para>
  <para style="q2" vid="PSA 32:3-5">yu tekemaot ol sin blong mi.<verse eid="PSA 32:3-5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />From gudfala fasin ya blong yu,</para>
  <para style="q2" vid="PSA 32:6">i gud olgeta man</para>
  <para style="q4" vid="PSA 32:6">we tingting blong olgeta i stap strong long yu,</para>
  <para style="q3" vid="PSA 32:6">oli prea long yu.</para>
  <para style="q1" vid="PSA 32:6">Nao taem bigfala trabol i kam,</para>
  <para style="q2" vid="PSA 32:6">olsem we bigfala wota i ron i kam,</para>
  <para style="q3" vid="PSA 32:6">bambae i no save kasem olgeta.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Yu yu ples blong haed blong mi,</para>
  <para style="q2" vid="PSA 32:7">yu stap blokem ol trabol</para>
  <para style="q3" vid="PSA 32:7">oli no kasem mi.</para>
  <para style="q1" vid="PSA 32:7">Mi mi stap sing bigwan</para>
  <para style="q3" vid="PSA 32:7">from paoa blong yu we i sevem mi,</para>
  <para style="q2" vid="PSA 32:7">from we yu yu stap blokem mi,</para>
  <para style="q4" vid="PSA 32:7">yu stap lukaot gud long mi.<verse eid="PSA 32:7" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />Hae God i talem se,</para>
  <para style="q2" vid="PSA 32:8">“Mi bambae mi tijim yu</para>
  <para style="q3" vid="PSA 32:8">long rod we i stret blong yu yu folem.</para>
  <para style="q1" vid="PSA 32:8">Bambae mi stap givim gudfala tingting long yu,</para>
  <para style="q2" vid="PSA 32:8">mo mi stap lukaot gud long yu.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />I nogud yu mekem stronghed,</para>
  <para style="q2" vid="PSA 32:9">olsem hos no hafkas* dongki,</para>
  <para style="q3" vid="PSA 32:9">we man i mas putum rop long maot blong hem,</para>
  <para style="q4" vid="PSA 32:9">blong mekem hem i folem tingting blong hem.”<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Ol man nogud</para>
  <para style="q2" vid="PSA 32:10">bambae oli harem nogud tumas</para>
  <para style="q3" vid="PSA 32:10">long bodi blong olgeta,</para>
  <para style="q2" vid="PSA 32:10">be olgeta we oli trastem Hae God,</para>
  <para style="q3" vid="PSA 32:10">hem bambae i stap lukaot gud long olgeta</para>
  <para style="q4" vid="PSA 32:10">from we oltaem hem i lavem man tumas.<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Yufala we fasin blong yufala i stret,</para>
  <para style="q2" vid="PSA 32:11">i gud yufala i glad,</para>
  <para style="q3" vid="PSA 32:11">yufala i harem gud from ol samting ya</para>
  <para style="q4" vid="PSA 32:11">we Hae God i mekem.</para>
  <para style="q1" vid="PSA 32:11">Yufala we i stap obei long hem,</para>
  <para style="q2" vid="PSA 32:11">i gud yufala i singsingaot</para>
  <para style="q3" vid="PSA 32:11">from we yufala i glad.<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />Yufala we fasin blong yufala i stret,</para>
  <para style="q2" vid="PSA 33:1">i gud yufala i singsingaot</para>
  <para style="q3" vid="PSA 33:1">blong soemaot we yufala i glad</para>
  <para style="q4" vid="PSA 33:1">long ol samting ya</para>
  <para style="q3" vid="PSA 33:1">we Hae God i mekem.</para>
  <para style="q1" vid="PSA 33:1">Yufala evriwan we i stap obei long hem,</para>
  <para style="q2" vid="PSA 33:1">yufala i presem hem.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Yufala i kilim gita,</para>
  <para style="q2" vid="PSA 33:2">yufala i singsing</para>
  <para style="q3" vid="PSA 33:2">blong talem tangkiu long Hae God,</para>
  <para style="q2" vid="PSA 33:2">yufala i mekem stringban</para>
  <para style="q4" vid="PSA 33:2">blong presem hem.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />I gud yufala i wokem wan niufala sing,</para>
  <para style="q2" vid="PSA 33:3">yufala i sing long hem.</para>
  <para style="q1" vid="PSA 33:3">Yufala i plei gita we yufala i plei gud,</para>
  <para style="q2" vid="PSA 33:3">mo yufala i glad,</para>
  <para style="q3" vid="PSA 33:3">yufala i singsingaot bigwan.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Ol tok blong Hae God oli tru,</para>
  <para style="q2" vid="PSA 33:4">mo man i save trastem olgeta wok blong hem.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />Hae God i laekem ol fasin we i stret.</para>
  <para style="q1" vid="PSA 33:5">Fasin ya blong hem</para>
  <para style="q2" vid="PSA 33:5">we oltaem hem i lavem man tumas,</para>
  <para style="q3" vid="PSA 33:5">hem i kavremap evri ples long wol ya.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Olgeta samting long skae,</para>
  <para style="q2" vid="PSA 33:6">Hae God i mekem olgeta long tok blong hem nomo.</para>
  <para style="q1" vid="PSA 33:6">San mo mun mo ol sta</para>
  <para style="q2" vid="PSA 33:6">oli kamaot long tok we hem i talem.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Hem i putum solwota</para>
  <para style="q3" vid="PSA 33:7">i stap long ples blong hem,</para>
  <para style="q2" vid="PSA 33:7">hem i putumgud dip solwota</para>
  <para style="q3" vid="PSA 33:7">i stap long prapa ples blong hem.<verse eid="PSA 33:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Yufala evriwan long graon ya,</para>
  <para style="q2" vid="PSA 33:8">yufala i bodaon long Hae God,</para>
  <para style="q3" vid="PSA 33:8">yufala i wosipim hem.</para>
  <para style="q1" vid="PSA 33:8">Yufala evriwan long wol ya,</para>
  <para style="q2" vid="PSA 33:8">yufala i ona long hem.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Taem hem i tok, wol ya i stanap.</para>
  <para style="q1" vid="PSA 33:9">Tok blong hem</para>
  <para style="q2" vid="PSA 33:9">i mekem evri samting i kamaot.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />Hem i stap spolem ol tingting</para>
  <para style="q2" vid="PSA 33:10">blong ol man blong ol narafala kantri.</para>
  <para style="q1" vid="PSA 33:10">Hem i stap blokem olgeta</para>
  <para style="q2" vid="PSA 33:10">blong oli no wokem ol plan blong olgeta.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Be ol plan blong hem</para>
  <para style="q2" vid="PSA 33:11">oli stap stanap strong oltaem.</para>
  <para style="q1" vid="PSA 33:11">Tingting blong hem i stap we i stap,</para>
  <para style="q2" vid="PSA 33:11">i no save finis samtaem.<verse eid="PSA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Ol man blong kantri we Hae God i God blong olgeta,</para>
  <para style="q2" vid="PSA 33:12">we hem i jusumaot olgeta blong oli man blong hem,</para>
  <para style="q2" vid="PSA 33:12">olgeta ya oli save harem gud.<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />Hae God i stap long heven,</para>
  <para style="q2" vid="PSA 33:13">i stap lukluk i kamdaon,</para>
  <para style="q3" vid="PSA 33:13">i stap luk olgeta man.<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />Hem i King,</para>
  <para style="q3" vid="PSA 33:14">i stap long ples blong hem,</para>
  <para style="q2" vid="PSA 33:14">i lukluk i kamdaon</para>
  <para style="q3" vid="PSA 33:14">long olgeta man we oli stap long wol ya.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />Hem i givim tingting long olgeta man,</para>
  <para style="q2" vid="PSA 33:15">mo hem i save olgeta samting we oli stap mekem.<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Maet ol soldia blong king oli strong tumas,</para>
  <para style="q2" vid="PSA 33:16">be king i no save win long samting ya.</para>
  <para style="q1" vid="PSA 33:16">Mo maet i gat wan soldia</para>
  <para style="q3" vid="PSA 33:16">we i strong we i strong,</para>
  <para style="q2" vid="PSA 33:16">be hem tu i no save win long paoa blong hem.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Maet king i gat plante bigbigfala hos blong faet,</para>
  <para style="q2" vid="PSA 33:17">be oli no save mekem hem i win.</para>
  <para style="q1" vid="PSA 33:17">Nating we oli strong we i strong</para>
  <para style="q2" vid="PSA 33:17">be oli no save sevem hem.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Hae God i stap lukaot gud long olgeta</para>
  <para style="q2" vid="PSA 33:18">we oli ona long hem,</para>
  <para style="q3" vid="PSA 33:18">mo we oli trastem fasin ya blong hem</para>
  <para style="q4" vid="PSA 33:18">we oltaem hem i lavem man tumas.<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />Long hadtaem we i no gat kakae,</para>
  <para style="q2" vid="PSA 33:19">hem i stap lukaot gud long olgeta</para>
  <para style="q3" vid="PSA 33:19">blong oli stap laef.</para>
  <para style="q1" vid="PSA 33:19">Hem i stap sevem olgeta</para>
  <para style="q2" vid="PSA 33:19">blong oli no ded.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Yumi ya,</para>
  <para style="q2" vid="PSA 33:20">yumi putum tingting blong yumi</para>
  <para style="q3" vid="PSA 33:20">i stap long Hae God.</para>
  <para style="q1" vid="PSA 33:20">Hem i stap lukaot gud long yumi,</para>
  <para style="q2" vid="PSA 33:20">mo i stap givhan long yumi.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Oltaem hem i stap mekem yumi glad,</para>
  <para style="q2" vid="PSA 33:21">from we yumi trastem tabu nem blong hem.<verse eid="PSA 33:21" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Hae God.</para>
  <para style="q1" vid="PSA 33:22">Mifala i putum tingting blong mifala</para>
  <para style="q3" vid="PSA 33:22">i stap finis long yu.</para>
  <para style="q1" vid="PSA 33:22">Prea blong mifala,</para>
  <para style="q2" vid="PSA 33:22">we fasin ya blong yu</para>
  <para style="q3" vid="PSA 33:22">we oltaem yu lavem man tumas,</para>
  <para style="q4" vid="PSA 33:22">bambae i stap wetem mifala oltaem.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">Sing blong presem Hae God from gudfala fasin blong hem</para>
  <para style="sp">(Sing ya, Deved i wokem, biaen long taem ya we i giaman long fes blong King Abimelek, i mekem olsem we hed blong hem i krangke, nao king ya i ronemaot hem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Oltaem mi bambae mi talem tangkiu long Hae God,</para>
  <para style="q2" vid="PSA 34:1">bambae mi presem hem oltaem nomo.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Bambae mi presem hem</para>
  <para style="q2" vid="PSA 34:2">from ol samting we hem i mekem.</para>
  <para style="q1" vid="PSA 34:2">I gud olgeta we ol man oli stap spolem olgeta</para>
  <para style="q2" vid="PSA 34:2">oli lesin long tok ya,</para>
  <para style="q3" vid="PSA 34:2">nao bambae oli glad.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Yufala i kam joen wetem mi,</para>
  <para style="q2" vid="PSA 34:3">yumi talemaot we Hae God i hae we i hae,</para>
  <para style="q2" vid="PSA 34:3">yumi leftemap hae nem blong hem.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Mi mi prea long hem,</para>
  <para style="q2" vid="PSA 34:4">nao hem i ansa long mi,</para>
  <para style="q3" vid="PSA 34:4">i tekemaot mi long ol man</para>
  <para style="q4" vid="PSA 34:4">we oli stap mekem mi mi fraet.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Olgeta we ol man oli stap spolem olgeta</para>
  <para style="q2" vid="PSA 34:5">oli luk long hem, nao oli glad.</para>
  <para style="q1" vid="PSA 34:5">Neva bambae tingting blong olgeta i foldaon.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Taem ol man oli stap spolem mi,</para>
  <para style="q3" vid="PSA 34:6">mi singaot i go long Hae God,</para>
  <para style="q2" vid="PSA 34:6">nao hem i harem mi,</para>
  <para style="q3" vid="PSA 34:6">i tekemaot mi long olgeta trabol blong mi.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Oltaem enjel blong hem</para>
  <para style="q2" vid="PSA 34:7">i stap lukaot gud long olgeta</para>
  <para style="q4" vid="PSA 34:7">we oli ona long hem,</para>
  <para style="q3" vid="PSA 34:7">mo i stap tekemaot olgeta long trabol.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34.8: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 2:3">1 Pita 2.3</ref>
      </char>
    </note>Hae God, hem i gud tumas.</para>
  <para style="q1" vid="PSA 34:8">Yufala i traem trastem hem.</para>
  <para style="q1" vid="PSA 34:8">Bambae yufala i faenemaot we hem i tru.</para>
  <para style="q1" vid="PSA 34:8">Olgeta we oli go long hem blong faenem sefples,</para>
  <para style="q3" vid="PSA 34:8">oli save harem gud.<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Yufala ol man blong Hae God,</para>
  <para style="q2" vid="PSA 34:9">yufala i ona long hem.</para>
  <para style="q1" vid="PSA 34:9">Olgeta we oli stap ona long hem</para>
  <para style="q2" vid="PSA 34:9">oli no save sot long wan samting.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Maet ol pikinini blong laeon</para>
  <para style="q3" vid="PSA 34:10">oli save hanggri,</para>
  <para style="q2" vid="PSA 34:10">be olgeta we oli stap luk long Hae God</para>
  <para style="q3" vid="PSA 34:10">oli no save sot long wan gudfala samting.<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Yufala ol yang fren blong mi,</para>
  <para style="q2" vid="PSA 34:11">yufala i kam, yufala i lesin long mi.</para>
  <para style="q1" vid="PSA 34:11">Bambae mi tijim yufala</para>
  <para style="q2" vid="PSA 34:11">blong yufala i ona long Hae God.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34.12: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:10-12">1 Pita 3.10-12</ref>
      </char>
    </note>?Olsem wanem?</para>
  <para style="q1" vid="PSA 34:12">?Yufala i wantem harem gud long laef blong yufala?</para>
  <para style="q1" vid="PSA 34:12">?Yufala i wantem laef blong yufala i longfala</para>
  <para style="q2" vid="PSA 34:12">we yufala i hapi oltaem?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />Oraet,</para>
  <para style="q2" vid="PSA 34:13">yufala i no moa tok nogud,</para>
  <para style="q3" vid="PSA 34:13">yufala i no moa giaman.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Yufala i no moa mekem ol rabis fasin,</para>
  <para style="q2" vid="PSA 34:14">yufala i mekem ol samting nomo we i gud.</para>
  <para style="q1" vid="PSA 34:14">Long olgeta tingting blong yufala,</para>
  <para style="q2" vid="PSA 34:14">yufala i mas wok had blong mekem pis.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />Hae God i stap lukluk long ol stret man,</para>
  <para style="q2" vid="PSA 34:15">i stap lesin blong harem krae blong olgeta.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />Be hem i stap agensem olgeta</para>
  <para style="q3" vid="PSA 34:16">we oli stap mekem ol rabis fasin,</para>
  <para style="q2" vid="PSA 34:16">nao taem olgeta ya oli lus long wol ya,</para>
  <para style="q3" vid="PSA 34:16">be bambae i no longtaem,</para>
  <para style="q4" vid="PSA 34:16">ol man oli no moa save tingbaot olgeta bakegen.<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Taem ol stret man oli krae i go long Hae God,</para>
  <para style="q2" vid="PSA 34:17">hem i harem olgeta,</para>
  <para style="q3" vid="PSA 34:17">i tekemaot olgeta long olgeta trabol blong olgeta.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />Hem i stap klosap long ol man</para>
  <para style="q3" vid="PSA 34:18">we tingting blong olgeta i kam nogud,</para>
  <para style="q2" vid="PSA 34:18">i stap sevem ol man</para>
  <para style="q3" vid="PSA 34:18">we tingting blong olgeta i foldaon olgeta.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Man we i stret i save harem nogud</para>
  <para style="q3" vid="PSA 34:19">long plante trabol,</para>
  <para style="q2" vid="PSA 34:19">be Hae God i save tekemaot hem</para>
  <para style="q3" vid="PSA 34:19">long olgeta trabol ya.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34.20: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:36">Jon 19.36</ref>
      </char>
    </note>Hae God i save lukaot gud long hem,</para>
  <para style="q2" vid="PSA 34:20">we bambae i no gat wan bun blong hem nating i brok.<verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Olgeta ya</para>
  <para style="q2" vid="PSA 34:21">we oli no laekem ol stret man,</para>
  <para style="q3" vid="PSA 34:21">oli man nogud nomo.</para>
  <para style="q1" vid="PSA 34:21">Hae God bambae i panisim olgeta.</para>
  <para style="q1" vid="PSA 34:21">Rabis fasin blong olgeta</para>
  <para style="q2" vid="PSA 34:21">bambae i mekem olgeta oli ded.<verse eid="PSA 34:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />Be ol man blong Hae God,</para>
  <para style="q2" vid="PSA 34:22">hem bambae i sevem olgeta.</para>
  <para style="q1" vid="PSA 34:22">Olgeta we oli go blong haed long hem,</para>
  <para style="q2" vid="PSA 34:22">bambae hem i no save panisim olgeta.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">Prea we man i mekem blong Hae God i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />Hae God.</para>
  <para style="q1" vid="PSA 35:1">Plis yu agensem olgeta</para>
  <para style="q3" vid="PSA 35:1">we oli agensem mi,</para>
  <para style="q2" vid="PSA 35:1">yu faet long olgeta</para>
  <para style="q3" vid="PSA 35:1">we oli stap faet long mi.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Yu tekem ol samting blong faet blong yu,</para>
  <para style="q2" vid="PSA 35:2">yu kam, yu halpem mi.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Yu leftemap spia mo akis blong yu,</para>
  <para style="q2" vid="PSA 35:3">yu fesem olgeta we oli stap ronem mi.</para>
  <para style="q1" vid="PSA 35:3">Mo yu talemgud long mi</para>
  <para style="q2" vid="PSA 35:3">we yu bambae yu sevem mi.<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Plis yu mekem olgeta ya</para>
  <para style="q2" vid="PSA 35:4">we oli traem blong kilim mi</para>
  <para style="q3" vid="PSA 35:4">oli lus mo oli sem.</para>
  <para style="q1" vid="PSA 35:4">Olgeta ya we oli stap mekem plan blong spolem mi,</para>
  <para style="q2" vid="PSA 35:4">plis yu mekem olgeta oli lusum hed,</para>
  <para style="q3" vid="PSA 35:4">oli tanemraon, oli gobak.<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Yu sanem enjel blong yu i ronem olgeta,</para>
  <para style="q2" vid="PSA 35:5">yu mekem olgeta i kam olsem doti blong wit,*</para>
  <para style="q3" vid="PSA 35:5">we taem win i blu,</para>
  <para style="q4" vid="PSA 35:5">i karem i go olbaot.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />Taem enjel blong yu i stap ronemaot olgeta,</para>
  <para style="q2" vid="PSA 35:6">plis yu mekem rod blong olgeta</para>
  <para style="q3" vid="PSA 35:6">i kam tudak, mo i glis.<verse eid="PSA 35:6" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Mi mi no mekem wan samting long olgeta,</para>
  <para style="q2" vid="PSA 35:7">be oli girap,</para>
  <para style="q3" vid="PSA 35:7">oli putum trap blong kasem mi,</para>
  <para style="q4" vid="PSA 35:7">oli digim hol,</para>
  <para style="q3" vid="PSA 35:7">blong mi mi foldaon long hem.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Be olgeta bambae oli kasem trabol</para>
  <para style="q2" vid="PSA 35:8">long taem we oli no tingbaot.</para>
  <para style="q1" vid="PSA 35:8">Trap ya we oli putum</para>
  <para style="q2" vid="PSA 35:8">bambae i kasem olgeta bakegen.</para>
  <para style="q1" vid="PSA 35:8">Hol ya we oli digim,</para>
  <para style="q2" vid="PSA 35:8">bambae oli foldaon long hem.<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Long taem ya,</para>
  <para style="q3" vid="PSA 35:9">bambae mi mi glad we mi glad long Hae God,</para>
  <para style="q4" vid="PSA 35:9">from we hem i sevem mi.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Long olgeta tingting blong mi,</para>
  <para style="q2" vid="PSA 35:10">bambae mi talemaot long hem se,</para>
  <para style="q3" vid="PSA 35:10">“Hae God.</para>
  <para style="q2" vid="PSA 35:10">I no gat wan man we i olsem yu.</para>
  <para style="q3" vid="PSA 35:10">Yu yu stap blokemgud man we i no strong,</para>
  <para style="q4" vid="PSA 35:10">blong man we i strong</para>
  <para style="q3" vid="PSA 35:10">i no save kam mekem i nogud long hem.</para>
  <para style="q2" vid="PSA 35:10">Mo yu stap blokemgud puaman</para>
  <para style="q3" vid="PSA 35:10">blong man we i gat paoa</para>
  <para style="q4" vid="PSA 35:10">i no save kam spolem hem.”<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Ol man nogud oli tok agens long mi,</para>
  <para style="q2" vid="PSA 35:11">mo oli talemaot se mi mi mekem ol trabol,</para>
  <para style="q3" vid="PSA 35:11">be mi mi no save ol samting ya nating.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Mi mi stap mekem i gud nomo long olgeta,</para>
  <para style="q2" vid="PSA 35:12">be olgeta oli mekem i nogud long mi,</para>
  <para style="q3" vid="PSA 35:12">nao tingting blong mi klosap i foldaon olgeta.<verse eid="PSA 35:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Be taem olgeta ya oli sik,</para>
  <para style="q2" vid="PSA 35:13">mi mi putum ol rabis klos</para>
  <para style="q3" vid="PSA 35:13">mo mi livim kakae blong mi,</para>
  <para style="q4" vid="PSA 35:13">mi no kakae,</para>
  <para style="q3" vid="PSA 35:13">blong soemaot we mi mi sore long olgeta.</para>
  <para style="q1" vid="PSA 35:13">Mi bodaon,</para>
  <para style="q3" vid="PSA 35:13">we hed blong mi i godaon olgeta,<verse eid="PSA 35:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14" />nao mi stap prea from olgeta</para>
  <para style="q3" vid="PSA 35:14">olsem we mi stap prea</para>
  <para style="q4" vid="PSA 35:14">from wan fren blong mi,</para>
  <para style="q3" vid="PSA 35:14">no wan brata blong mi.</para>
  <para style="q1" vid="PSA 35:14">Mi stap wokbaot</para>
  <para style="q3" vid="PSA 35:14">we hed blong mi i hang daon,</para>
  <para style="q2" vid="PSA 35:14">from we mi sore tumas,</para>
  <para style="q3" vid="PSA 35:14">olsem we man i sore</para>
  <para style="q4" vid="PSA 35:14">taem we mama blong hem i lus.<verse eid="PSA 35:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Be taem mi mi stap long trabol,</para>
  <para style="q2" vid="PSA 35:15">olgeta oli glad,</para>
  <para style="q3" vid="PSA 35:15">oli kam hivap raon long mi,</para>
  <para style="q4" vid="PSA 35:15">oli stap laf long mi.</para>
  <para style="q1" vid="PSA 35:15">Ol man we mi mi no save olgeta</para>
  <para style="q2" vid="PSA 35:15">oli stap faetem mi,</para>
  <para style="q3" vid="PSA 35:15">oli gohed blong kilim mi</para>
  <para style="q4" vid="PSA 35:15">we oli no spel.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Ol rabis man ya oli spolem mi,</para>
  <para style="q2" vid="PSA 35:16">oli laf nogud long mi,</para>
  <para style="q3" vid="PSA 35:16">oli stap kakae tut blong olgeta</para>
  <para style="q4" vid="PSA 35:16">i kam long mi.<verse eid="PSA 35:16" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />?Hae God.</para>
  <para style="q1" vid="PSA 35:17">Bambae yu stap lukluk mi olsem</para>
  <para style="q3" vid="PSA 35:17">gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 35:17">Olgeta ya we oli stap faet long mi,</para>
  <para style="q2" vid="PSA 35:17">oli olsem laeon we i wantem kakae mi.</para>
  <para style="q1" vid="PSA 35:17">Plis yu tekemaot mi long han blong olgeta</para>
  <para style="q2" vid="PSA 35:17">yu sevem mi.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />Nao bambae mi talem tangkiu long yu</para>
  <para style="q3" vid="PSA 35:18">long fes blong olgeta man blong yu,</para>
  <para style="q2" vid="PSA 35:18">bambae mi presem yu</para>
  <para style="q3" vid="PSA 35:18">long fes blong olgeta evriwan.<verse eid="PSA 35:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35.19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:4">Sam 69.4</ref>; <ref loc="JHN 15:25">Jon 15.25</ref></char>
    </note>Ol enemi blong mi oli man blong giaman.</para>
  <para style="q1" vid="PSA 35:19">Plis yu no letem mi mi lus</para>
  <para style="q2" vid="PSA 35:19">nao bambae olgeta oli stap glad from.</para>
  <para style="q1" vid="PSA 35:19">Mi mi no mekem wan samting long olgeta,</para>
  <para style="q2" vid="PSA 35:19">be olgeta oli no laekem mi nating,</para>
  <para style="q3" vid="PSA 35:19">oli agens long mi.</para>
  <para style="q1" vid="PSA 35:19">Mi mi harem nogud tumas,</para>
  <para style="q3" vid="PSA 35:19">plis yu no letem olgeta oli laf long mi from.<verse eid="PSA 35:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Olgeta oli no save toktok gud</para>
  <para style="q3" vid="PSA 35:20">long ol man we oli laekem pis,</para>
  <para style="q2" vid="PSA 35:20">oli stap mekem plante giaman toktok</para>
  <para style="q4" vid="PSA 35:20">agens long olgeta.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Oli jikim mi, oli talem se, “!A!</para>
  <para style="q2" vid="PSA 35:21">!Mifala i luk samting ya we yu yu mekem!”<verse eid="PSA 35:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />Be Hae God, yu yu Masta<note caller="+" style="f"><char style="fr" closed="false">35.22: </char><char style="fqa" closed="false">Masta. Nem ya, long ples ya, hem i narafala nem blong Hae God.</char></note> blong mi,</para>
  <para style="q2" vid="PSA 35:22">mo yu luk samting ya finis.</para>
  <para style="q1" vid="PSA 35:22">Plis yu no stap sidaon kwaet,</para>
  <para style="q2" vid="PSA 35:22">yu no go longwe long mi.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Masta* blong mi,</para>
  <para style="q2" vid="PSA 35:23">plis yu girap, yu kam blokemgud mi.</para>
  <para style="q1" vid="PSA 35:23">Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 35:23">yu girap, yu tok long saed blong mi.<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />Hae God,</para>
  <para style="q2" vid="PSA 35:24">yu yu God blong mi,</para>
  <para style="q3" vid="PSA 35:24">mo fasin blong yu i stret.</para>
  <para style="q1" vid="PSA 35:24">I gud yu talemaot</para>
  <para style="q3" vid="PSA 35:24">we mi mi no mekem samting nogud,</para>
  <para style="q2" vid="PSA 35:24">yu no letem ol enemi blong mi</para>
  <para style="q3" vid="PSA 35:24">oli stap glad</para>
  <para style="q4" vid="PSA 35:24">from we mi mi stap long trabol.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Plis yu no letem olgeta oli talem se,</para>
  <para style="q2" vid="PSA 35:25">“!Saye, yumi winim hem finis!</para>
  <para style="q3" vid="PSA 35:25">!Samting ya nao yumi wantem!”<verse eid="PSA 35:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Olgeta we oli stap hapi</para>
  <para style="q3" vid="PSA 35:26">from we mi mi harem nogud,</para>
  <para style="q2" vid="PSA 35:26">i gud yu mekem olgeta oli sem,</para>
  <para style="q3" vid="PSA 35:26">oli lusum hed olgeta.</para>
  <para style="q1" vid="PSA 35:26">Mi mi wantem</para>
  <para style="q2" vid="PSA 35:26">se olgeta we oli stap talem</para>
  <para style="q4" vid="PSA 35:26">se oli gud moa i winim mi,</para>
  <para style="q3" vid="PSA 35:26">bambae oli sem we oli sem gud,</para>
  <para style="q3" vid="PSA 35:26">we ol man oli stap tokbaot olgeta from.<verse eid="PSA 35:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Olgeta ya</para>
  <para style="q2" vid="PSA 35:27">we oli wantem tumas</para>
  <para style="q3" vid="PSA 35:27">blong yu yu talemaot</para>
  <para style="q4" vid="PSA 35:27">se mi mi stret man,</para>
  <para style="q2" vid="PSA 35:27">i gud olgeta ya oli glad,</para>
  <para style="q3" vid="PSA 35:27">oli stap singsingaot bigwan,</para>
  <para style="q2" vid="PSA 35:27">i gud oli stap taltalem oltaem se,</para>
  <para style="q3" vid="PSA 35:27">“!Hae God, hem i hae we i hae!</para>
  <para style="q3" vid="PSA 35:27">Hem i glad tumas</para>
  <para style="q4" vid="PSA 35:27">taem man blong wok blong hem i win.”<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Nao bambae mi mi talemaot stret fasin blong yu,</para>
  <para style="q2" vid="PSA 35:28">mo bambae mi stap presem yu evri dei nomo,</para>
  <para style="q3" vid="PSA 35:28">i stat long moning,</para>
  <para style="q4" vid="PSA 35:28">gogo kasem tudak.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">Fasin nogud blong man mo gudfala fasin blong Hae God</para>
  <para style="sp">(Deved i man blong wok blong Hae God mo hem i wokem sing ya.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36.1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:18">Rom 3.18</ref>
      </char>
    </note>Man nogud,</para>
  <para style="q2" vid="PSA 36:1">oltaem fasin blong mekem nogud</para>
  <para style="q3" vid="PSA 36:1">i stap toktok long hem,</para>
  <para style="q4" vid="PSA 36:1">insaed olgeta long tingting blong hem.</para>
  <para style="q1" vid="PSA 36:1">Hem i no laekem God,</para>
  <para style="q3" vid="PSA 36:1">i no save ona long hem nating,<verse eid="PSA 36:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 36:2" />from we hem i flas tumas</para>
  <para style="q3" vid="PSA 36:2">nao i ting</para>
  <para style="q4" vid="PSA 36:2">se God bambae i no save faenemaot <optbreak /> ol sin blong hem,</para>
  <para style="q3" vid="PSA 36:2">i no save jajem hem from.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Tok blong hem i nogud,</para>
  <para style="q3" vid="PSA 36:3">i fulap long ol giaman,</para>
  <para style="q2" vid="PSA 36:3">nao hem i no moa save mekem ol samting</para>
  <para style="q3" vid="PSA 36:3">we i waes mo i gud.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Taem hem i ledaon long bed,</para>
  <para style="q2" vid="PSA 36:4">hem i stap mekem ol plan we i nogud.</para>
  <para style="q1" vid="PSA 36:4">Hem i no save mekem wan gud samting nating,</para>
  <para style="q2" vid="PSA 36:4">mo neva hem i talem no long ol fasin nogud.<verse eid="PSA 36:4" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />Hae God.</para>
  <para style="q1" vid="PSA 36:5">Fasin ya blong yu</para>
  <para style="q3" vid="PSA 36:5">we oltaem yu stap lavem man,</para>
  <para style="q2" vid="PSA 36:5">hem i hae we i hae.</para>
  <para style="q1" vid="PSA 36:5">Fasin ya</para>
  <para style="q3" vid="PSA 36:5">we oltaem yu stap holem promes* blong yu,</para>
  <para style="q2" vid="PSA 36:5">hem i go antap kasem skae.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Stret fasin blong yu i no save jenis,</para>
  <para style="q3" vid="PSA 36:6">i olsem ol bigbigfala hil</para>
  <para style="q4" vid="PSA 36:6">we oli no save muv,</para>
  <para style="q2" vid="PSA 36:6">mo stret fasin blong yu blong jajem man,</para>
  <para style="q3" vid="PSA 36:6">man i no save makem,</para>
  <para style="q4" vid="PSA 36:6">i dip we i dip olsem dip solwota.</para>
  <para style="q1" vid="PSA 36:6">Yu yu stap lukaot gud long ol man</para>
  <para style="q2" vid="PSA 36:6">mo long ol anamol tu.<verse eid="PSA 36:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />God, fasin ya blong yu</para>
  <para style="q3" vid="PSA 36:7">we oltaem yu stap lavem man,</para>
  <para style="q2" vid="PSA 36:7">hem i gudfala tumas.</para>
  <para style="q1" vid="PSA 36:7">Mifala i faenem sefples long yu</para>
  <para style="q2" vid="PSA 36:7">olsem we ol pikinini blong faol</para>
  <para style="q3" vid="PSA 36:7">oli faenem sefples</para>
  <para style="q4" vid="PSA 36:7">aninit long wing blong mama blong olgeta.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Oltaem mifala i stap kakae gud</para>
  <para style="q2" vid="PSA 36:8">long ol kakae ya we yu yu stap givim.</para>
  <para style="q1" vid="PSA 36:8">Oltaem yu letem mifala i stap dring</para>
  <para style="q2" vid="PSA 36:8">long reva ya blong ol gudgudfala fasin blong yu.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Yu yu stamba blong laef blong olgeta samting,</para>
  <para style="q2" vid="PSA 36:9">mo from laet blong yu nao,</para>
  <para style="q3" vid="PSA 36:9">mifala i stap luk delaet.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Fasin blong yu,</para>
  <para style="q2" vid="PSA 36:10">oltaem yu stap lavem tumas olgeta</para>
  <para style="q3" vid="PSA 36:10">we oli save yu,</para>
  <para style="q2" vid="PSA 36:10">mo yu stap mekem i gud long olgeta</para>
  <para style="q3" vid="PSA 36:10">we fasin blong olgeta i stret.</para>
  <para style="q1" vid="PSA 36:10">Plis yu no lego fasin ya blong yu.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Plis yu no letem ol praod man</para>
  <para style="q3" vid="PSA 36:11">oli kam faet long mi,</para>
  <para style="q2" vid="PSA 36:11">yu no letem ol man nogud</para>
  <para style="q3" vid="PSA 36:11">oli mekem mi mi ronwe.<verse eid="PSA 36:11" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />!Yufala i luk!</para>
  <para style="q1" vid="PSA 36:12">Hemia nao poen ya</para>
  <para style="q2" vid="PSA 36:12">we ol man nogud oli foldaon finis long hem.</para>
  <para style="q1" vid="PSA 36:12">Mo oli stap ledaon long ples ya,</para>
  <para style="q2" vid="PSA 36:12">we neva bambae oli save girap bakegen samtaem.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">Laef blong man nogud mo laef blong gudfala man</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Bambae yu no jalus long ol man</para>
  <para style="q2" vid="PSA 37:1">we oli stap mekem samting nogud.</para>
  <para style="q1" vid="PSA 37:1">Nating we ol man nogud oli stap win,</para>
  <para style="q2" vid="PSA 37:1">be bambae yu no harem nogud from.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />Olgeta ya bambae oli lus</para>
  <para style="q3" vid="PSA 37:2">olsem gras we i drae long draetaem.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Yu mas trastem Hae God,</para>
  <para style="q3" vid="PSA 37:3">mo yu mas mekem ol fasin we i gud,</para>
  <para style="q2" vid="PSA 37:3">blong yu save stap long graon ya,</para>
  <para style="q3" vid="PSA 37:3">nao yu harem gud from we yu yu sef.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Yu mas luk long Hae God</para>
  <para style="q3" vid="PSA 37:4">blong i mekem yu yu glad,</para>
  <para style="q2" vid="PSA 37:4">nao bambae hem i givim long yu</para>
  <para style="q3" vid="PSA 37:4">ol samting we yu yu wantem tumas.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Yu mas givim laef blong yu</para>
  <para style="q3" vid="PSA 37:5">long Hae God,</para>
  <para style="q2" vid="PSA 37:5">yu mas trastem hem,</para>
  <para style="q3" vid="PSA 37:5">nao bambae hem i halpem yu.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />Bambae hem i mekem ol stret fasin blong yu</para>
  <para style="q3" vid="PSA 37:6">i klia olsem delaet,</para>
  <para style="q2" vid="PSA 37:6">mo i mekem ol trutok we yu yu stap talem</para>
  <para style="q3" vid="PSA 37:6">i saen olsem san long medel dei.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Yu mas mekem tingting blong yu</para>
  <para style="q3" vid="PSA 37:7">i longfala,</para>
  <para style="q2" vid="PSA 37:7">mo yu mas wet long Hae God</para>
  <para style="q3" vid="PSA 37:7">blong hem i givhan long yu.</para>
  <para style="q1" vid="PSA 37:7">I nogud blong yu harem nogud</para>
  <para style="q2" vid="PSA 37:7">taem ol narafala man oli stap win</para>
  <para style="q3" vid="PSA 37:7">long ol rabis plan blong olgeta,</para>
  <para style="q4" vid="PSA 37:7">nao oli stap kam rijman.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />I nogud yu kros,</para>
  <para style="q2" vid="PSA 37:8">i nogud yu faerap,</para>
  <para style="q3" vid="PSA 37:8">i nogud yu wari.</para>
  <para style="q1" vid="PSA 37:8">Ol samting ya i rod blong kasem trabol nomo.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Olgeta we oli trastem Hae God</para>
  <para style="q3" vid="PSA 37:9">bambae oli tekem graon ya i blong olgeta,</para>
  <para style="q2" vid="PSA 37:9">be ol man nogud,</para>
  <para style="q3" vid="PSA 37:9">Hae God bambae i ronemaot olgeta.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Bambae i no longtaem,</para>
  <para style="q2" vid="PSA 37:10">ol man nogud oli lus.</para>
  <para style="q1" vid="PSA 37:10">Bambae yu save lukaot olgeta,</para>
  <para style="q2" vid="PSA 37:10">be bambae yu no save faenem olgeta.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37.11: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:5">Mat 5.5</ref>
      </char>
    </note>Ol man we tingting blong olgeta i stap daon,</para>
  <para style="q2" vid="PSA 37:11">bambae oli tekem graon ya i blong olgeta.</para>
  <para style="q1" vid="PSA 37:11">Nao bambae oli harem gud,</para>
  <para style="q2" vid="PSA 37:11">from we oli stap gud,</para>
  <para style="q3" vid="PSA 37:11">mo oli gat plante samting.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Ol man nogud oli stap mekem ol plan</para>
  <para style="q2" vid="PSA 37:12">agens long ol gudfala man.</para>
  <para style="q1" vid="PSA 37:12">Oltaem oli stap kros long olgeta,</para>
  <para style="q2" vid="PSA 37:12">we oli stap kakae tut blong olgeta from.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Be Masta<note caller="+" style="f"><char style="fr" closed="false">37.13: </char><char style="fqa" closed="false">Masta</char><char style="ft" closed="false">. Yu luk futnot <char style="bd">K</char> long 35.22.</char></note> blong yumi i stap laf</para>
  <para style="q3" vid="PSA 37:13">long ol man nogud,</para>
  <para style="q2" vid="PSA 37:13">from we hem i save</para>
  <para style="q3" vid="PSA 37:13">we i no longtaem,</para>
  <para style="q4" vid="PSA 37:13">bambae hem i spolem olgeta.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Ol man nogud</para>
  <para style="q2" vid="PSA 37:14">oli stap pulumaot</para>
  <para style="q3" vid="PSA 37:14">ol naef blong faet blong olgeta,</para>
  <para style="q2" vid="PSA 37:14">mo oli stap taetem</para>
  <para style="q4" vid="PSA 37:14">ol bonara blong olgeta,</para>
  <para style="q3" vid="PSA 37:14">blong kilim ol puaman mo ol trabolman,</para>
  <para style="q4" vid="PSA 37:14">mo blong spolem ol man</para>
  <para style="q3" vid="PSA 37:14">we oli stap mekem stret fasin.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Be naef blong faet ya blong olgeta</para>
  <para style="q3" vid="PSA 37:15">bambae i kilim olgeta bakegen,</para>
  <para style="q2" vid="PSA 37:15">mo ol bonara ya blong olgeta</para>
  <para style="q3" vid="PSA 37:15">bambae oli brobrok.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Smol samting nomo</para>
  <para style="q3" vid="PSA 37:16">we wan gudfala man i gat,</para>
  <para style="q2" vid="PSA 37:16">i moa gud,</para>
  <para style="q3" vid="PSA 37:16">i winim olgeta samting</para>
  <para style="q4" vid="PSA 37:16">we ol man nogud oli gat,<verse eid="PSA 37:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PSA 37:17" />from we Hae God bambae i tekemaot</para>
  <para style="q4" vid="PSA 37:17">paoa blong ol man nogud,</para>
  <para style="q3" vid="PSA 37:17">be bambae i blokem olgeta we oli gud,</para>
  <para style="q3" vid="PSA 37:17">i sevem olgeta.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Hae God i stap lukaot gud long olgeta</para>
  <para style="q3" vid="PSA 37:18">we oli stap obei long hem,</para>
  <para style="q2" vid="PSA 37:18">mo graon ya bambae i blong olgeta</para>
  <para style="q3" vid="PSA 37:18">gogo i no save finis.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Bambae oli no save harem nogud</para>
  <para style="q2" vid="PSA 37:19">long ol hadtaem.</para>
  <para style="q1" vid="PSA 37:19">Sipos kakae is sot,</para>
  <para style="q2" vid="PSA 37:19">be bambae oli gat plante kakae.<verse eid="PSA 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Be ol man nogud bambae oli ded,</para>
  <para style="q2" vid="PSA 37:20">ol enemi ya blong Hae God</para>
  <para style="q3" vid="PSA 37:20">bambae oli lus olsem ol flaoa,</para>
  <para style="q4" vid="PSA 37:20">bambae oli lus olsem smok nomo.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Ol man nogud oli stap karem</para>
  <para style="q3" vid="PSA 37:21">ol samting blong ol narafala man</para>
  <para style="q4" vid="PSA 37:21">blong oli yusum fastaem,</para>
  <para style="q2" vid="PSA 37:21">mo neva oli kam givimbak.</para>
  <para style="q1" vid="PSA 37:21">Be ol gudfala man,</para>
  <para style="q2" vid="PSA 37:21">fasin blong olgeta i gud tumas,</para>
  <para style="q3" vid="PSA 37:21">oli stap givim ol samting i go long man</para>
  <para style="q4" vid="PSA 37:21">long gladhat blong olgeta.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Olgeta we Hae God i blesem olgeta</para>
  <para style="q3" vid="PSA 37:22">bambae oli tekem graon ya i blong olgeta,</para>
  <para style="q2" vid="PSA 37:22">be olgeta we hem i promes</para>
  <para style="q4" vid="PSA 37:22">se panis bambae i kasem olgeta,</para>
  <para style="q3" vid="PSA 37:22">hem bambae i ronemaot olgeta.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Hae God i stap lidim ol man</para>
  <para style="q3" vid="PSA 37:23">long rod we i stret blong olgeta i folem,</para>
  <para style="q2" vid="PSA 37:23">mo i stap lukaot gud long ol man</para>
  <para style="q3" vid="PSA 37:23">we hem i glad long fasin blong olgeta.<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />Sipos oli foldaon</para>
  <para style="q3" vid="PSA 37:24">be bambae oli no save stap daon longtaem,</para>
  <para style="q2" vid="PSA 37:24">from we Hae God bambae i holem olgeta,</para>
  <para style="q3" vid="PSA 37:24">i leftemap olgeta bakegen.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Naoia mi mi olfala,</para>
  <para style="q3" vid="PSA 37:25">mi stap longtaem,</para>
  <para style="q2" vid="PSA 37:25">be neva mi luk wan gudfala man</para>
  <para style="q4" vid="PSA 37:25">we Hae God i lego hem,</para>
  <para style="q3" vid="PSA 37:25">no ol pikinini blong man olsem</para>
  <para style="q3" vid="PSA 37:25">we oli stap asaskem kakae olbaot.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />Oltaem ol man olsem oli glad nomo</para>
  <para style="q2" vid="PSA 37:26">blong oli stap givim olting blong olgeta</para>
  <para style="q3" vid="PSA 37:26">i go long ol man,</para>
  <para style="q2" vid="PSA 37:26">mo oli save letem ol man</para>
  <para style="q3" vid="PSA 37:26">oli kam karem olting blong olgeta</para>
  <para style="q4" vid="PSA 37:26">blong yusum fastaem.</para>
  <para style="q1" vid="PSA 37:26">Mo ol pikinini blong olgeta</para>
  <para style="q2" vid="PSA 37:26">oli olsem rod we God i stap yusum</para>
  <para style="q3" vid="PSA 37:26">blong mekem i gud long olgeta</para>
  <para style="q4" vid="PSA 37:26">mo long ol man raonabaot long olgeta.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Yu mas tanem baksaed blong yu</para>
  <para style="q3" vid="PSA 37:27">long ol rabis fasin,</para>
  <para style="q2" vid="PSA 37:27">mo yu mas mekem ol samting we i gud,</para>
  <para style="q3" vid="PSA 37:27">nao olgeta we bambae oli stap kamaot biaen long yu</para>
  <para style="q4" vid="PSA 37:27">bambae oli stap oltaem long graon ya,<verse eid="PSA 37:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="PSA 37:28" />from we Hae God i laekem</para>
  <para style="q4" vid="PSA 37:28">ol fasin we i stret,</para>
  <para style="q3" vid="PSA 37:28">mo i no save lego ol stret man ya</para>
  <para style="q4" vid="PSA 37:28">we tingting blong olgeta</para>
  <para style="q3" vid="PSA 37:28">i stap strong long hem.</para>
  <para style="q1" vid="PSA 37:28">Hem bambae i stap lukaot gud long olgeta</para>
  <para style="q3" vid="PSA 37:28">gogo i no save finis,</para>
  <para style="q2" vid="PSA 37:28">be olgeta we bambae oli stap kamaot</para>
  <para style="q3" vid="PSA 37:28">biaen long ol man nogud,</para>
  <para style="q4" vid="PSA 37:28">bambae hem i ronemaot olgeta.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Ol stret man ya bambae oli tekem graon ya</para>
  <para style="q3" vid="PSA 37:29">i blong olgeta,</para>
  <para style="q2" vid="PSA 37:29">mo bambae oli stap long hem</para>
  <para style="q4" vid="PSA 37:29">gogo i no save finis.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Ol tok blong gudfala man oli waes,</para>
  <para style="q2" vid="PSA 37:30">mo ol samting we hem i talem</para>
  <para style="q3" vid="PSA 37:30">oli stret nomo.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Hem i stap holem ol loa blong God blong hem</para>
  <para style="q3" vid="PSA 37:31">long tingting blong hem,</para>
  <para style="q2" vid="PSA 37:31">mo neva hem i lego ol loa ya.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Oltaem man nogud i stap wajem gudfala man</para>
  <para style="q2" vid="PSA 37:32">blong traem faenem rod blong kilim hem i ded.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Be Hae God i no save letem gudfala man</para>
  <para style="q2" vid="PSA 37:33">i go long han blong enemi blong hem.</para>
  <para style="q1" vid="PSA 37:33">Sipos man nogud i tekem gudfala man</para>
  <para style="q3" vid="PSA 37:33">i go long kot,</para>
  <para style="q2" vid="PSA 37:33">bambae Hae God i no save letem man nogud ya</para>
  <para style="q4" vid="PSA 37:33">i winim gudfala man ya.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Yu mas putum tingting blong yu</para>
  <para style="q4" vid="PSA 37:34">i stap strong long Hae God,</para>
  <para style="q3" vid="PSA 37:34">mo yu mas obei long ol tok blong hem,</para>
  <para style="q2" vid="PSA 37:34">nao bambae hem i ona long yu,</para>
  <para style="q3" vid="PSA 37:34">i givim graon ya long yu.</para>
  <para style="q1" vid="PSA 37:34">Bambae yu luk</para>
  <para style="q2" vid="PSA 37:34">we hem i ronemaot ol man nogud.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Bifo mi mi luk wan man nogud i stap</para>
  <para style="q2" vid="PSA 37:35">we hem i haeman long ples blong hem,</para>
  <para style="q3" vid="PSA 37:35">mo i stap spolem ol man.</para>
  <para style="q1" vid="PSA 37:35">Hem i hae we i hae long olgeta man</para>
  <para style="q2" vid="PSA 37:35">olsem wan bigfala sida* long Lebanon</para>
  <para style="q3" vid="PSA 37:35">we i hae tumas.<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Nao biaen mi kam pas long ples blong hem bakegen</para>
  <para style="q2" vid="PSA 37:36">be hem i no moa stap.</para>
  <para style="q1" vid="PSA 37:36">Mi traem lukaot hem</para>
  <para style="q2" vid="PSA 37:36">be mi no save faenem hem.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Yu lukluk gud long gudfala man,</para>
  <para style="q2" vid="PSA 37:37">we laef blong hem i stret,</para>
  <para style="q3" vid="PSA 37:37">mo we hem i wantem pis,</para>
  <para style="q2" vid="PSA 37:37">yu traem makem fasin blong hem.</para>
  <para style="q1" vid="PSA 37:37">Olgeta we oli kamaot biaen long hem</para>
  <para style="q2" vid="PSA 37:37">oli plante we plante.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Be ol man nogud,</para>
  <para style="q2" vid="PSA 37:38">Hae God i stap kilim olgeta oli ded.</para>
  <para style="q1" vid="PSA 37:38">Mo olgeta we oli kamaot biaen long olgeta,</para>
  <para style="q2" vid="PSA 37:38">hem i stap flatemgud olgeta.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />Oltaem Hae God i stap sevem ol stret man,</para>
  <para style="q2" vid="PSA 37:39">i stap lukaot gud long olgeta</para>
  <para style="q3" vid="PSA 37:39">long taem blong trabol.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />Hem i stap halpem olgeta,</para>
  <para style="q2" vid="PSA 37:40">i stap sevem olgeta.</para>
  <para style="q1" vid="PSA 37:40">Hem i stap tekemaot olgeta</para>
  <para style="q3" vid="PSA 37:40">long han blong ol man nogud,</para>
  <para style="q2" vid="PSA 37:40">from we oli stap luk long hem</para>
  <para style="q3" vid="PSA 37:40">blong hem i blokemgud olgeta</para>
  <para style="q4" vid="PSA 37:40">oli stap gud.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">Prea blong man we i harem nogud</para>
  <para style="sp">(Sing ya i wan krae we Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />Hae God.</para>
  <para style="q1" vid="PSA 38:1">Taem yu yu kros,</para>
  <para style="q2" vid="PSA 38:1">plis yu no jajem mi.</para>
  <para style="q1" vid="PSA 38:1">Taem yu kros tumas,</para>
  <para style="q2" vid="PSA 38:1">be plis yu no panisim mi.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Yu yu mekem mi mi karekil finis</para>
  <para style="q3" vid="PSA 38:2">long ol ara blong yu,</para>
  <para style="q2" vid="PSA 38:2">yu kilim mi</para>
  <para style="q3" vid="PSA 38:2">mi foldaon finis.<verse eid="PSA 38:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Mi mi harem nogud tumas long bodi blong mi</para>
  <para style="q3" vid="PSA 38:3">from we yu yu kros long mi,</para>
  <para style="q2" vid="PSA 38:3">ol bodi blong mi evriwan i kam nogud</para>
  <para style="q4" vid="PSA 38:3">from ol sin blong mi.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Naoia ol sin blong mi i kavremap mi</para>
  <para style="q2" vid="PSA 38:4">olsem we mi draon long dip solwota.</para>
  <para style="q1" vid="PSA 38:4">Ol sin blong mi oli olsem wan samting we i hevi tumas,</para>
  <para style="q2" vid="PSA 38:4">mi no moa save karem.<verse eid="PSA 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Mi mi mekem i krangke</para>
  <para style="q3" vid="PSA 38:5">we mi stap mekem i nogud long yu,</para>
  <para style="q2" vid="PSA 38:5">ol soa blong mi oli kam nogud,</para>
  <para style="q3" vid="PSA 38:5">oli sting.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Ol sin ya blong mi</para>
  <para style="q2" vid="PSA 38:6">i mekem mi mi bendaon,</para>
  <para style="q3" vid="PSA 38:6">we mi no moa save girap.</para>
  <para style="q1" vid="PSA 38:6">Mi stap krae evri dei nomo,</para>
  <para style="q2" vid="PSA 38:6">i stat long moning,</para>
  <para style="q3" vid="PSA 38:6">gogo kasem tudak.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Mi mi fiva,</para>
  <para style="q2" vid="PSA 38:7">we bodi blong mi i hot we i hot,</para>
  <para style="q3" vid="PSA 38:7">we klosap mi ded from.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Mi mi slak we mi slak</para>
  <para style="q3" vid="PSA 38:8">we mi flat olgeta,</para>
  <para style="q2" vid="PSA 38:8">tingting blong mi i trabol</para>
  <para style="q3" vid="PSA 38:8">mo mi stap harem</para>
  <para style="q4" vid="PSA 38:8">ol bodi blong mi i soa we i soa,</para>
  <para style="q3" vid="PSA 38:8">we mi stap krae from.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Masta,<note caller="+" style="f"><char style="fr" closed="false">38.9: </char><char style="fqa" closed="false">Masta</char><char style="ft" closed="false">. Yu luk futnot <char style="bd">K</char> long Sam 35.22.</char></note></para>
  <para style="q2" vid="PSA 38:9">yu yu save olgeta samting</para>
  <para style="q3" vid="PSA 38:9">we mi mi wantem.</para>
  <para style="q1" vid="PSA 38:9">Yu yu harem we mi stap krae</para>
  <para style="q2" vid="PSA 38:9">from we mi harem nogud tumas.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Naoia hat blong mi i stap pam strong,</para>
  <para style="q2" vid="PSA 38:10">paoa blong mi i lus,</para>
  <para style="q3" vid="PSA 38:10">mo ae blong mi i no moa saen.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Ol fren blong mi,</para>
  <para style="q2" vid="PSA 38:11">mo olgeta we oli stap raonabaot long mi</para>
  <para style="q2" vid="PSA 38:11">oli no save kam klosap long mi</para>
  <para style="q3" vid="PSA 38:11">from ol soa blong mi.</para>
  <para style="q1" vid="PSA 38:11">Ol famle blong mi tu</para>
  <para style="q2" vid="PSA 38:11">oli no save kam sidaon wetem mi.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Olgeta we oli wantem kilim mi</para>
  <para style="q3" vid="PSA 38:12">oli stap putum ol trap blong kasem mi,</para>
  <para style="q2" vid="PSA 38:12">mo olgeta we oli wantem mekem mi mi foldaon,</para>
  <para style="q4" vid="PSA 38:12">oli stap tok strong long mi blong spolem mi.</para>
  <para style="q1" vid="PSA 38:12">Oltaem oli stap mekem ol plan agens long mi</para>
  <para style="q2" vid="PSA 38:12">we oli no save spel.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Mi mi olsem man we sora blong hem i fas,</para>
  <para style="q3" vid="PSA 38:13">nao i no save harem samting,</para>
  <para style="q2" vid="PSA 38:13">mi olsem man we tang blong hem i fas,</para>
  <para style="q4" vid="PSA 38:13">nao i no save toktok.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Mi mi olsem man we i no save ansa</para>
  <para style="q2" vid="PSA 38:14">from we hem i no save harem samting.<verse eid="PSA 38:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />Be Hae God,</para>
  <para style="q2" vid="PSA 38:15">mi mi trastem yu.</para>
  <para style="q1" vid="PSA 38:15">Yu yu Masta* blong mi,</para>
  <para style="q2" vid="PSA 38:15">mo yu God blong mi,</para>
  <para style="q3" vid="PSA 38:15">bambae yu harem krae blong mi.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Plis yu no letem ol enemi blong mi oli glad</para>
  <para style="q3" vid="PSA 38:16">from we mi mi harem nogud.</para>
  <para style="q2" vid="PSA 38:16">Yu no letem olgeta oli tok flas</para>
  <para style="q4" vid="PSA 38:16">from we laef blong mi i kam nogud.<verse eid="PSA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Naoia klosap laef blong mi i foldaon</para>
  <para style="q2" vid="PSA 38:17">mo oltaem nomo</para>
  <para style="q3" vid="PSA 38:17">mi stap harem nogud long bodi blong mi.<verse eid="PSA 38:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Mi mi talemaot ol sin blong mi,</para>
  <para style="q2" vid="PSA 38:18">mi sore tumas long ol samting nogud</para>
  <para style="q3" vid="PSA 38:18">we mi mi mekem.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Ol enemi blong mi,</para>
  <para style="q3" vid="PSA 38:19">oltaem oli strong, oli no save sik.</para>
  <para style="q1" vid="PSA 38:19">I gat plante man tumas</para>
  <para style="q2" vid="PSA 38:19">we oli no laekem mi nating,</para>
  <para style="q2" vid="PSA 38:19">oli stap agens long mi,</para>
  <para style="q3" vid="PSA 38:19">be from nating nomo.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Mi mi stap mekem i gud nomo long olgeta,</para>
  <para style="q2" vid="PSA 38:20">be olgeta oli stap mekem i nogud long mi.</para>
  <para style="q1" vid="PSA 38:20">Oli kam enemi blong mi</para>
  <para style="q2" vid="PSA 38:20">from we mi stap traem mekem</para>
  <para style="q3" vid="PSA 38:20">ol samting we i stret.<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />Hae God,</para>
  <para style="q2" vid="PSA 38:21">plis yu no lego mi,</para>
  <para style="q1" vid="PSA 38:21">God blong mi,</para>
  <para style="q2" vid="PSA 38:21">yu no stap longwe long mi.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Yu yu Masta* blong mi,</para>
  <para style="q2" vid="PSA 38:22">mo yu yu sevem mi.</para>
  <para style="q1" vid="PSA 38:22">Plis yu kam kwik, yu halpem mi.<verse eid="PSA 38:22" /></para>
  <para style="b" />
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">Man we i harem nogud tumas long bodi blong hem i talemaot sin blong hem</para>
  <para style="sp">(Sing ya, Deved i wokem blong givim long Jedutun we i lida blong kwaea.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 39:1-2" />Taem trabol ya i kasem mi,</para>
  <para style="q3" vid="PSA 39:1-2">fastaem mi mi talem se,</para>
  <para style="q2" vid="PSA 39:1-2">“Naoia mi mi mas lukaot gud</para>
  <para style="q3" vid="PSA 39:1-2">blong mi no talem sam tok</para>
  <para style="q4" vid="PSA 39:1-2">we i no stret.</para>
  <para style="q2" vid="PSA 39:1-2">I nogud mi letem maot blong mi</para>
  <para style="q3" vid="PSA 39:1-2">i mekem mi mi sin.</para>
  <para style="q2" vid="PSA 39:1-2">Sipos ol man nogud oli stap klosap long mi,</para>
  <para style="q3" vid="PSA 39:1-2">i nogud mi tokbaot trabol ya blong mi.”</para>
  <para style="q1" vid="PSA 39:1-2">Ale mi stap kwaet,</para>
  <para style="q2" vid="PSA 39:1-2">mi no talem wan tok.</para>
  <para style="q1" vid="PSA 39:1-2">Nating we i blong talem wan gudfala samting,</para>
  <para style="q2" vid="PSA 39:1-2">be mi no tok.</para>
  <para style="q1" vid="PSA 39:1-2">Be trabol blong mi i stap kam mowas,</para>
  <para style="q2" vid="PSA 39:1-2">mo mi mi harem nogud tumas.<verse eid="PSA 39:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />Tingting blong mi i trabol we i trabol gud,</para>
  <para style="q2" vid="PSA 39:3">mo taem mi stap tingbaot trabol ya blong mi,</para>
  <para style="q3" vid="PSA 39:3">tingting blong mi i stap kam nogud moa.</para>
  <para style="q1" vid="PSA 39:3">Nao mi mi no moa save stap kwaet,</para>
  <para style="q3" vid="PSA 39:3">mi talem se,<verse eid="PSA 39:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 39:4" />“?Hae God.</para>
  <para style="q2" vid="PSA 39:4">Bambae mi mi stap gogo kasem wetaem?</para>
  <para style="q2" vid="PSA 39:4">?Wetaem bambae mi mi ded?</para>
  <para style="q2" vid="PSA 39:4">Plis yu talemaot long mi</para>
  <para style="q3" vid="PSA 39:4">wetaem laef blong mi bambae i finis.<verse eid="PSA 39:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 39:5" />Naoia yu mekem</para>
  <para style="q3" vid="PSA 39:5">laef blong mi i kam sotwan we i sotwan olgeta.</para>
  <para style="q2" vid="PSA 39:5">Long fes blong yu,</para>
  <para style="q3" vid="PSA 39:5">taem ya blong mi i olsem nating nomo.</para>
  <para style="q2" vid="PSA 39:5">Laef blong man</para>
  <para style="q3" vid="PSA 39:5">i olsem wan smol win nomo,</para>
  <para style="q4" vid="PSA 39:5">we i blu wan taem, nao i finis.<verse eid="PSA 39:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 39:6" />Hem i olsem sado nomo.</para>
  <para style="q2" vid="PSA 39:6">Olgeta samting we man i stap mekem</para>
  <para style="q3" vid="PSA 39:6">i blong nating nomo.</para>
  <para style="q2" vid="PSA 39:6">Hem i stap hivimap ol gudgudfala samting,</para>
  <para style="q3" vid="PSA 39:6">be i no save hu man bambae i tekem.”<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />Masta.<note caller="+" style="f"><char style="fr" closed="false">39.7: </char><char style="fqa" closed="false">Masta</char><char style="ft" closed="false">. Yu luk futnot <char style="bd">K</char> long 35.22.</char></note></para>
  <para style="q1" vid="PSA 39:7">Ol gudgudfala samting ya</para>
  <para style="q3" vid="PSA 39:7">we bifo mi mi wantem olgeta tumas,</para>
  <para style="q2" vid="PSA 39:7">naoia mi no moa save putum tingting blong mi</para>
  <para style="q3" vid="PSA 39:7">i stap long olgeta.<note caller="+" style="f"><char style="fr" closed="false">39.7: </char><char style="ft" closed="false">Narafala rod blong tanem tok long medel blong vas ya i olsem. <char style="bd">Laef blong mi i kam nogud finis. ?Wanem samting nao mi mi save</char> putum tingting blong mi i stap long hem, se bambae mi kasem?</char></note></para>
  <para style="q1" vid="PSA 39:7">Naoia mi mi putum tingting blong mi</para>
  <para style="q2" vid="PSA 39:7">i stap long yu nomo.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Plis yu tekemaot mi</para>
  <para style="q3" vid="PSA 39:8">long olgeta sin blong mi,</para>
  <para style="q2" vid="PSA 39:8">mo yu no letem ol krangke man</para>
  <para style="q4" vid="PSA 39:8">oli laf long mi.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Naoia mi stap kwaet,</para>
  <para style="q3" vid="PSA 39:9">mi no moa save talem wan samting,</para>
  <para style="q2" vid="PSA 39:9">from we mi save</para>
  <para style="q4" vid="PSA 39:9">we yu nao yu mekem mi mi harem nogud olsem.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Plis, yu no moa panisim mi bakegen.</para>
  <para style="q1" vid="PSA 39:10">Klosap mi mi ded,</para>
  <para style="q2" vid="PSA 39:10">from we yu stap slavem mi.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Taem yu tok strong long man</para>
  <para style="q3" vid="PSA 39:11">blong panisim hem from sin blong hem,</para>
  <para style="q2" vid="PSA 39:11">yu stap spolem ol samting</para>
  <para style="q4" vid="PSA 39:11">we hem i laekem tumas,</para>
  <para style="q3" vid="PSA 39:11">olsem we kakros i stap spolem olting.</para>
  <para style="q1" vid="PSA 39:11">Yes i tru,</para>
  <para style="q2" vid="PSA 39:11">man i olsem wan smol win nomo,</para>
  <para style="q2" vid="PSA 39:11">we i blu wan taem, nao i finis.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />Hae God,</para>
  <para style="q2" vid="PSA 39:12">plis yu harem prea blong mi,</para>
  <para style="q3" vid="PSA 39:12">yu lesin long krae blong mi.</para>
  <para style="q1" vid="PSA 39:12">Taem mi stap krae,</para>
  <para style="q2" vid="PSA 39:12">plis yu kam halpem mi.</para>
  <para style="q1" vid="PSA 39:12">Mi mi stap wetem yu long wol ya</para>
  <para style="q2" vid="PSA 39:12">olsem strenja we i stap smoltaem nomo,</para>
  <para style="q3" vid="PSA 39:12">olsem ol bubu blong mi bifo.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Plis yu livim mi mi stap mi wan</para>
  <para style="q2" vid="PSA 39:13">blong mi save harem gud fastaem.</para>
  <para style="q1" vid="PSA 39:13">Afta, bambae mi mi lus,</para>
  <para style="q2" vid="PSA 39:13">mi no moa stap long ples ya bakegen.<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Mi mi stap wet long Hae God</para>
  <para style="q3" vid="PSA 40:1">blong i givhan long mi,</para>
  <para style="q2" vid="PSA 40:1">mi holem tingting blong mi i longfala</para>
  <para style="q4" vid="PSA 40:1">mi stap prea gogo,</para>
  <para style="q3" vid="PSA 40:1">nao hem i lesin long prea blong mi,</para>
  <para style="q3" vid="PSA 40:1">i harem krae blong mi.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Hem i pulumaot mi long hol</para>
  <para style="q3" vid="PSA 40:2">we i nogud we i nogud,</para>
  <para style="q2" vid="PSA 40:2">i tekemaot mi long swom</para>
  <para style="q4" vid="PSA 40:2">we i fulap long sofmad.</para>
  <para style="q1" vid="PSA 40:2">Hem i putum mi</para>
  <para style="q3" vid="PSA 40:2">antap long wan bigfala ston,</para>
  <para style="q2" vid="PSA 40:2">nao mi mi stap gud</para>
  <para style="q4" vid="PSA 40:2">long sefples we i strong.<verse eid="PSA 40:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />Hem i tijim mi long wan niufala sing,</para>
  <para style="q2" vid="PSA 40:3">blong mi stap sing blong presem hem</para>
  <para style="q3" vid="PSA 40:3">we i God blong yumi.</para>
  <para style="q1" vid="PSA 40:3">Plante man taem oli luk samting ya</para>
  <para style="q3" vid="PSA 40:3">bambae oli luksave se Hae God i tabu,</para>
  <para style="q3" vid="PSA 40:3">nao bambae oli putum tingting blong olgeta</para>
  <para style="q4" vid="PSA 40:3">i stap long hem.<verse eid="PSA 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Olgeta we oli trastem Hae God,</para>
  <para style="q2" vid="PSA 40:4">we oli no save folem ol giaman god,</para>
  <para style="q3" vid="PSA 40:4">mo we oli no save joen long olgeta</para>
  <para style="q4" vid="PSA 40:4">we oli stap mekem wosip long ol giaman god ya,</para>
  <para style="q2" vid="PSA 40:4">oli save harem gud.<verse eid="PSA 40:4" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />Hae God,</para>
  <para style="q2" vid="PSA 40:5">yu yu God blong mifala.</para>
  <para style="q1" vid="PSA 40:5">Yu yu mekem plante samting finis</para>
  <para style="q2" vid="PSA 40:5">blong givhan long mifala.</para>
  <para style="q1" vid="PSA 40:5">I no gat narafala god</para>
  <para style="q2" vid="PSA 40:5">we i olsem yu.</para>
  <para style="q1" vid="PSA 40:5">Yu mekem plante gudfala plan</para>
  <para style="q2" vid="PSA 40:5">blong mifala i folem.</para>
  <para style="q1" vid="PSA 40:5">Mi mi no save tokbaot olgeta evriwan,</para>
  <para style="q2" vid="PSA 40:5">oli plante tumas.<verse eid="PSA 40:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40.6: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 10:5-7">Hib 10.5-7</ref>
      </char>
    </note>Yu no wantem ol sakrefaes</para>
  <para style="q2" vid="PSA 40:6">mo ol presen we mi stap givim long yu.</para>
  <para style="q1" vid="PSA 40:6">Yu no askem long mi</para>
  <para style="q2" vid="PSA 40:6">blong mi stap bonem ol anamol</para>
  <para style="q4" vid="PSA 40:6">we oli bon evriwan long olta,</para>
  <para style="q3" vid="PSA 40:6">mo blong mi stap mekem ol sakrefaes</para>
  <para style="q3" vid="PSA 40:6">blong tekemaot sin blong mi.</para>
  <para style="q1" vid="PSA 40:6">Yu yu wantem toktok long mi,</para>
  <para style="q2" vid="PSA 40:6">nao yu mekem sora blong mi i open</para>
  <para style="q3" vid="PSA 40:6">blong mi save harem tok blong yu.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7-8" style="v" sid="PSA 40:7-8" />Nao taem yu tok,</para>
  <para style="q3" vid="PSA 40:7-8">mi mi talem se,</para>
  <para style="q2" vid="PSA 40:7-8">“God blong mi.</para>
  <para style="q2" vid="PSA 40:7-8">Mi ya, mi kam.</para>
  <para style="q2" vid="PSA 40:7-8">Ol tok blong yu blong tijim mi</para>
  <para style="q3" vid="PSA 40:7-8">oli stap long buk blong Loa* blong yu.</para>
  <para style="q2" vid="PSA 40:7-8">Mi mi wantem tumas</para>
  <para style="q3" vid="PSA 40:7-8">blong mekem ol samting we yu yu wantem.</para>
  <para style="q2" vid="PSA 40:7-8">Oltaem mi mi holem tok blong yu</para>
  <para style="q3" vid="PSA 40:7-8">long tingting blong mi.”<verse eid="PSA 40:7-8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Hae God.</para>
  <para style="q1" vid="PSA 40:9">Long fes blong olgeta man blong yu,</para>
  <para style="q2" vid="PSA 40:9">mi mi talemaot gud nius ya</para>
  <para style="q3" vid="PSA 40:9">we yu yu sevem mifala.</para>
  <para style="q1" vid="PSA 40:9">Mo yu yu save we oltaem nomo,</para>
  <para style="q2" vid="PSA 40:9">bambae mi stap talemaot samting ya,</para>
  <para style="q3" vid="PSA 40:9">we neva bambae mi spel.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Nius ya we yu yu sevem mifala,</para>
  <para style="q2" vid="PSA 40:10">mi mi no stap haedem samtaem,</para>
  <para style="q3" vid="PSA 40:10">se i blong mi nomo.</para>
  <para style="q1" vid="PSA 40:10">Fasin blong yu,</para>
  <para style="q2" vid="PSA 40:10">we yu stap holemstrong promes* blong yu long man</para>
  <para style="q3" vid="PSA 40:10">mo we yu stap givhan long hem oltaem,</para>
  <para style="q4" vid="PSA 40:10">mi mi no haedem nating long ol man blong yu.</para>
  <para style="q1" vid="PSA 40:10">Oltaem</para>
  <para style="q2" vid="PSA 40:10">mi stap talemaot long fes blong olgeta</para>
  <para style="q3" vid="PSA 40:10">we tingting blong yu i stap strong long man,</para>
  <para style="q4" vid="PSA 40:10">mo we oltaem yu stap lavem hem tumas.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Hae God,</para>
  <para style="q2" vid="PSA 40:11">mi mi save we oltaem yu yu gat sore long mi,</para>
  <para style="q3" vid="PSA 40:11">we neva bambae i finis.</para>
  <para style="q1" vid="PSA 40:11">Fasin blong yu we yu stap lavem mi tumas,</para>
  <para style="q2" vid="PSA 40:11">mo we tingting blong yu i stap strong long mi,</para>
  <para style="q3" vid="PSA 40:11">oltaem bambae i stap mekem mi mi sef.<verse eid="PSA 40:11" /></para>
  <para style="s">Prea we man i mekem blong Hae God i givhan long hem</para>
  <para style="s2">(Sam 70)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Naoia plante trabol oli stap kam raon long mi.</para>
  <para style="q1" vid="PSA 40:12">Oli plante tumas, mi mi no save kaontem.</para>
  <para style="q1" vid="PSA 40:12">Ol sin blong mi i kavremap mi,</para>
  <para style="q2" vid="PSA 40:12">mo naoia mi no moa save lukluk.</para>
  <para style="q1" vid="PSA 40:12">Oli plante tumas,</para>
  <para style="q3" vid="PSA 40:12">i winim ol hea long hed blong mi,</para>
  <para style="q3" vid="PSA 40:12">nao tingting blong mi i foldaon olgeta.<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />Hae God, plis yu sevem mi.</para>
  <para style="q1" vid="PSA 40:13">Yu kam kwik, yu halpem mi.<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Olgeta we oli stap traem blong kilim mi,</para>
  <para style="q2" vid="PSA 40:14">i gud yu daonem olgeta</para>
  <para style="q3" vid="PSA 40:14">we bambae oli lusum hed from.</para>
  <para style="q1" vid="PSA 40:14">Olgeta we oli glad</para>
  <para style="q3" vid="PSA 40:14">from we mi mi stap long trabol,</para>
  <para style="q2" vid="PSA 40:14">i gud yu mekem olgeta oli tanemraon,</para>
  <para style="q4" vid="PSA 40:14">oli gobak we bambae oli sem gud.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Olgeta we oli stap laf long mi,</para>
  <para style="q2" vid="PSA 40:15">i gud yu mekem olgeta oli lus</para>
  <para style="q3" vid="PSA 40:15">we tingting blong olgeta</para>
  <para style="q4" vid="PSA 40:15">bambae i foldaon olgeta.<verse eid="PSA 40:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Be olgeta we oli stap kam long yu,</para>
  <para style="q2" vid="PSA 40:16">i gud yu mekem olgeta oli glad</para>
  <para style="q3" vid="PSA 40:16">we oli stap harem gud oltaem.</para>
  <para style="q1" vid="PSA 40:16">Olgeta ya oli stap talem tangkiu long yu</para>
  <para style="q3" vid="PSA 40:16">from we yu stap sevem olgeta,</para>
  <para style="q2" vid="PSA 40:16">mo i gud yu letem olgeta</para>
  <para style="q3" vid="PSA 40:16">oli stap talem oltaem se,</para>
  <para style="q3" vid="PSA 40:16">“!Hae God, hem i hae we i hae!”<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Masta<note caller="+" style="f"><char style="fr" closed="false">40.17: </char><char style="fqa" closed="false">Masta</char><char style="ft" closed="false">. Yu luk futnot <char style="bd">K</char> long 35.22.</char></note>, yu yu God blong mi.</para>
  <para style="q1" vid="PSA 40:17">Mi mi pua, mi no gat paoa,</para>
  <para style="q2" vid="PSA 40:17">be yu yu no fogetem mi nating,</para>
  <para style="q3" vid="PSA 40:17">oltaem yu stap tingbaot mi.</para>
  <para style="q1" vid="PSA 40:17">Oltaem yu yu stap sevem mi.</para>
  <para style="q1" vid="PSA 40:17">Plis yu kam kwik, yu givhan long mi.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">Prea we sikman i mekem nao i oraet bakegen</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Ol man we oli stap tingbaot ol puaman,</para>
  <para style="q2" vid="PSA 41:1">oli save harem gud.</para>
  <para style="q1" vid="PSA 41:1">Sipos oli stap long trabol,</para>
  <para style="q2" vid="PSA 41:1">Hae God bambae i givhan long olgeta.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />Hem bambae i blokem olgeta,</para>
  <para style="q2" vid="PSA 41:2">i lukaot gud long laef blong olgeta.</para>
  <para style="q1" vid="PSA 41:2">Bambae hem i mekem olgeta</para>
  <para style="q3" vid="PSA 41:2">oli stap long graon ya,</para>
  <para style="q3" vid="PSA 41:2">oli harem gud,</para>
  <para style="q2" vid="PSA 41:2">bambae hem i no save letem olgeta</para>
  <para style="q4" vid="PSA 41:2">oli go long paoa blong ol enemi blong olgeta.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />Mo taem oli sik,</para>
  <para style="q3" vid="PSA 41:3">hem bambae i givhan long olgeta</para>
  <para style="q2" vid="PSA 41:3">i mekem olgeta oli oraet bakegen.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Taem mi mi sik,</para>
  <para style="q2" vid="PSA 41:4">mi talem se, “Hae God,</para>
  <para style="q3" vid="PSA 41:4">mi mi mekem i nogud long yu.</para>
  <para style="q2" vid="PSA 41:4">Plis yu sore long mi,</para>
  <para style="q3" vid="PSA 41:4">yu mekem mi mi strong bakegen.”<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Ol enemi blong mi oli stap spolem mi</para>
  <para style="q2" vid="PSA 41:5">long ol tok blong olgeta.</para>
  <para style="q1" vid="PSA 41:5">Oli wantem nomo blong mi mi ded,</para>
  <para style="q2" vid="PSA 41:5">blong ol man oli fogetem mi.<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Olgeta we oli kam blong luk mi</para>
  <para style="q2" vid="PSA 41:6">oli giaman nomo,</para>
  <para style="q3" vid="PSA 41:6">oli no sore long mi nating.</para>
  <para style="q1" vid="PSA 41:6">Oli kam nomo</para>
  <para style="q3" vid="PSA 41:6">blong faenemaot sik blong mi,</para>
  <para style="q2" vid="PSA 41:6">nao taem oli gobak,</para>
  <para style="q3" vid="PSA 41:6">oli stap tokbaot mi long evri ples.<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Olgeta man ya we oli no laekem mi</para>
  <para style="q2" vid="PSA 41:7">oli stap tok smosmol agens long mi,</para>
  <para style="q3" vid="PSA 41:7">mo oli stap tingbaot nomo</para>
  <para style="q4" vid="PSA 41:7">se bambae mi mi ded.<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />Oli talem se,</para>
  <para style="q2" vid="PSA 41:8">“Hem i sik finis</para>
  <para style="q3" vid="PSA 41:8">we bambae i ded from.</para>
  <para style="q2" vid="PSA 41:8">Neva bambae hem i kamaot</para>
  <para style="q3" vid="PSA 41:8">long bed blong hem bakegen.”<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41.9: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:23">Mat 26.23</ref>; <ref loc="MRK 14:18">Mak 14.18</ref>; <ref loc="LUK 22:21">Luk 22.21</ref>; <ref loc="JHN 13:18">Jon 13.18</ref></char>
    </note>Gudfala fren ya blong mi</para>
  <para style="q2" vid="PSA 41:9">we mi trastem hem tumas,</para>
  <para style="q3" vid="PSA 41:9">mo we mitufala i stap kakae</para>
  <para style="q4" vid="PSA 41:9">long wan basket nomo,</para>
  <para style="q2" vid="PSA 41:9">be hem i girap i agensem mi.<verse eid="PSA 41:9" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Hae God,</para>
  <para style="q2" vid="PSA 41:10">plis yu sore long mi.</para>
  <para style="q1" vid="PSA 41:10">Yu mekem mi mi strong bakegen,</para>
  <para style="q2" vid="PSA 41:10">nao bambae mi go givimbak ol samting ya</para>
  <para style="q3" vid="PSA 41:10">we ol enemi blong mi</para>
  <para style="q4" vid="PSA 41:10">oli stap mekem long mi.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Taem mi luk</para>
  <para style="q3" vid="PSA 41:11">we olgeta oli no save winim mi,</para>
  <para style="q2" vid="PSA 41:11">bambae mi savegud</para>
  <para style="q4" vid="PSA 41:11">we yu yu glad long mi.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Yu yu stap givhan long mi,</para>
  <para style="q2" vid="PSA 41:12">from we mi stap mekem ol samting</para>
  <para style="q3" vid="PSA 41:12">we i stret.</para>
  <para style="q1" vid="PSA 41:12">Bambae yu gohed blong holem mi</para>
  <para style="q2" vid="PSA 41:12">mi stap wetem yu oltaem.<verse eid="PSA 41:12" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41.13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:48">Sam 106.48</ref>
      </char>
    </note>Yumi presem Hae God</para>
  <para style="q2" vid="PSA 41:13">we i God blong yumi ol laen* blong Isrel.*</para>
  <para style="q1" vid="PSA 41:13">Oltaem, yumi mas presem hem</para>
  <para style="q2" vid="PSA 41:13">gogo i no save finis.</para>
  <para style="q1" vid="PSA 41:13">Amen.</para>
  <para style="q1" vid="PSA 41:13">Amen.<verse eid="PSA 41:13" /></para>
  <para style="b" />
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">BUK TU</para>
  <para style="mr">(<ref loc="PSA 42-72">Sam 42—72</ref>)</para>
  <para style="s">Prea blong man we i stap afsaed long kantri blong hem, mo i no save gobak</para>
  <para style="sp">(Sing ya, ol pikinini blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />God,</para>
  <para style="q2" vid="PSA 42:1">mi mi wantem tumas</para>
  <para style="q4" vid="PSA 42:1">blong yu yu kam long laef blong mi,</para>
  <para style="q3" vid="PSA 42:1">olsem wan anamol we i tosta tumas</para>
  <para style="q3" vid="PSA 42:1">i wantem dring long springwota.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />God,</para>
  <para style="q2" vid="PSA 42:2">yu yu laef</para>
  <para style="q3" vid="PSA 42:2">we yu no save ded.</para>
  <para style="q1" vid="PSA 42:2">Mi mi wantem yu tumas,</para>
  <para style="q3" vid="PSA 42:2">olsem we mi tosta,</para>
  <para style="q3" vid="PSA 42:2">mi wantem tumas blong dring wota.</para>
  <para style="q1" vid="PSA 42:2">?Wetaem bambae mi save kam stanap</para>
  <para style="q3" vid="PSA 42:2">long fes blong yu,</para>
  <para style="q2" vid="PSA 42:2">blong mekem wosip long yu?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Mi mi stap krae long dei mo long naet,</para>
  <para style="q2" vid="PSA 42:3">wota blong ae blong mi nomo</para>
  <para style="q3" vid="PSA 42:3">i kakae blong mi.</para>
  <para style="q1" vid="PSA 42:3">Oltaem ol enemi blong mi</para>
  <para style="q2" vid="PSA 42:3">oli stap jikim mi, oli talem se,</para>
  <para style="q3" vid="PSA 42:3">“?Wehem God ya blong yu?”<verse eid="PSA 42:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />God,</para>
  <para style="q2" vid="PSA 42:4">bifo, mi stap wokbaot wetem olgeta man</para>
  <para style="q3" vid="PSA 42:4">blong go long haos* blong yu.</para>
  <para style="q1" vid="PSA 42:4">Mi stap lidim olgeta i go,</para>
  <para style="q2" vid="PSA 42:4">we oli hapi tumas, oli singsing,</para>
  <para style="q3" vid="PSA 42:4">oli stap singsingaot blong presem yu.</para>
  <para style="q1" vid="PSA 42:4">Be taem mi tingbaot ol samting ya,</para>
  <para style="q2" vid="PSA 42:4">tingting blong mi i stap kam nogud olgeta.<verse eid="PSA 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />?From wanem mi mi sore tumas olsem?</para>
  <para style="q1" vid="PSA 42:5">?From wanem tingting blong mi i trabol tumas?</para>
  <para style="q1" vid="PSA 42:5">Bambae mi mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 42:5">i stap long yu nomo,</para>
  <para style="q2" vid="PSA 42:5">mo bakegen,</para>
  <para style="q3" vid="PSA 42:5">bambae mi stap presem yu</para>
  <para style="q4" vid="PSA 42:5">we yu yu God blong mi,</para>
  <para style="q3" vid="PSA 42:5">yu sevem mi.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6-7" style="v" sid="PSA 42:6-7" />Long ples ya,</para>
  <para style="q2" vid="PSA 42:6-7">afsaed long kantri blong mi,</para>
  <para style="q3" vid="PSA 42:6-7">tingting blong mi i kam nogud,</para>
  <para style="q2" vid="PSA 42:6-7">ale, mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 42:6-7">i stap long yu bakegen.</para>
  <para style="q1" vid="PSA 42:6-7">Yu yu stap sanem trabol</para>
  <para style="q2" vid="PSA 42:6-7">i kam long laef blong mi</para>
  <para style="q3" vid="PSA 42:6-7">olsem ol wef blong bigfala solwota.</para>
  <para style="q1" vid="PSA 42:6-7">Ol bigfala trabol ya</para>
  <para style="q2" vid="PSA 42:6-7">oli kam long mi olsem wota</para>
  <para style="q3" vid="PSA 42:6-7">we i ron bigwan, i draonem mi.</para>
  <para style="q1" vid="PSA 42:6-7">Oli kam olsem ol wotafol ya</para>
  <para style="q2" vid="PSA 42:6-7">we oli kamaot long tufala hil ya Hemon mo Mijara,</para>
  <para style="q4" vid="PSA 42:6-7">oli godaon long Jodan Reva,</para>
  <para style="q3" vid="PSA 42:6-7">we oli bigfala tumas,</para>
  <para style="q4" vid="PSA 42:6-7">oli stap mekem noes olsem tanda.<verse eid="PSA 42:6-7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Hae God,</para>
  <para style="q2" vid="PSA 42:8">yu yu God blong laef blong mi.</para>
  <para style="q1" vid="PSA 42:8">Mi mi wantem we long dei,</para>
  <para style="q3" vid="PSA 42:8">bambae yu soemaot fasin blong yu,</para>
  <para style="q4" vid="PSA 42:8">we oltaem yu lavem man tumas,</para>
  <para style="q2" vid="PSA 42:8">nao long naet,</para>
  <para style="q3" vid="PSA 42:8">bambae mi save singsing</para>
  <para style="q4" vid="PSA 42:8">blong mekem prea long yu.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />God,</para>
  <para style="q2" vid="PSA 42:9">oltaem yu yu stap blokem ol enemi blong mi,</para>
  <para style="q3" vid="PSA 42:9">oli no kam faet long mi.</para>
  <para style="q1" vid="PSA 42:9">?From wanem yu fogetem mi?</para>
  <para style="q1" vid="PSA 42:9">?From wanem mi stap harem nogud</para>
  <para style="q2" vid="PSA 42:9">long han blong ol enemi blong mi</para>
  <para style="q3" vid="PSA 42:9">we oli stap spolem mi?<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Ol rabis tok blong olgeta i stap stikim mi tumas.</para>
  <para style="q1" vid="PSA 42:10">Oltaem ol enemi blong mi oli stap talem long mi se,</para>
  <para style="q2" vid="PSA 42:10">“?Wehem God ya blong yu?”<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />?From wanem mi mi sore tumas olsem?</para>
  <para style="q1" vid="PSA 42:11">?From wanem tingting blong mi i trabol tumas?</para>
  <para style="q1" vid="PSA 42:11">Bambae mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 42:11">i stap long yu nomo,</para>
  <para style="q2" vid="PSA 42:11">mo bakegen,</para>
  <para style="q3" vid="PSA 42:11">bambae mi stap presem yu</para>
  <para style="q4" vid="PSA 42:11">we yu yu God blong mi,</para>
  <para style="q3" vid="PSA 42:11">yu sevem mi.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">Prea blong man we i stap afsaed long kantri blong hem, mo i no save gobak</para>
  <para style="sp">(Sing ya i haf blong Sam 42.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />God,</para>
  <para style="q2" vid="PSA 43:1">plis yu talemaot long fes blong ol man</para>
  <para style="q3" vid="PSA 43:1">we mi mi no mekem samting nogud,</para>
  <para style="q2" vid="PSA 43:1">mo yu stanap long saed blong mi,</para>
  <para style="q3" vid="PSA 43:1">yu agensem ol man</para>
  <para style="q4" vid="PSA 43:1">we oli no mekem wosip long yu.</para>
  <para style="q1" vid="PSA 43:1">Plis yu blokem ol man blong giaman</para>
  <para style="q3" vid="PSA 43:1">mo ol man nogud,</para>
  <para style="q2" vid="PSA 43:1">yu sevem mi.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Yu yu God,</para>
  <para style="q2" vid="PSA 43:2">we yu sefples blong mi.</para>
  <para style="q1" vid="PSA 43:2">?From wanem yu lego mi?</para>
  <para style="q1" vid="PSA 43:2">Ol enemi blong mi</para>
  <para style="q2" vid="PSA 43:2">oli stap spolem mi tumas.</para>
  <para style="q1" vid="PSA 43:2">?From wanem mi stap harem nogud olsem?<verse eid="PSA 43:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Plis yu sanem laet blong yu</para>
  <para style="q2" vid="PSA 43:3">mo trutok blong yu i kam.</para>
  <para style="q1" vid="PSA 43:3">Mi wantem blong tufala i lidim mi,</para>
  <para style="q2" vid="PSA 43:3">tufala i tekem mi mi kambak long Saeon,*</para>
  <para style="q4" vid="PSA 43:3">tabu hil ya blong yu,</para>
  <para style="q3" vid="PSA 43:3">tufala i tekem mi mi kamtru long ples blong yu</para>
  <para style="q3" vid="PSA 43:3">we yu yu stap long hem.<verse eid="PSA 43:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />God,</para>
  <para style="q2" vid="PSA 43:4">yu yu stamba blong glad blong mi,</para>
  <para style="q2" vid="PSA 43:4">bambae mi go long olta blong yu bakegen</para>
  <para style="q3" vid="PSA 43:4">blong mekem sakrefaes.</para>
  <para style="q1" vid="PSA 43:4">Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 43:4">bambae mi plei long gita blong mi,</para>
  <para style="q3" vid="PSA 43:4">mi sing blong presem yu.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />?From wanem mi mi sore tumas olsem?</para>
  <para style="q1" vid="PSA 43:5">?From wanem tingting blong mi</para>
  <para style="q3" vid="PSA 43:5">i trabol tumas?</para>
  <para style="q1" vid="PSA 43:5">Bambae mi mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 43:5">i stap long yu nomo,</para>
  <para style="q2" vid="PSA 43:5">mo bakegen,</para>
  <para style="q3" vid="PSA 43:5">bambae mi stap presem yu</para>
  <para style="q4" vid="PSA 43:5">we yu yu God blong mi,</para>
  <para style="q3" vid="PSA 43:5">yu sevem mi.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">Prea we ol man oli mekem blong God i blokemgud olgeta, i sevem olgeta</para>
  <para style="sp">(Sing ya, ol pikinini blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />God,</para>
  <para style="q2" vid="PSA 44:1">ol bigbigfala samting ya</para>
  <para style="q3" vid="PSA 44:1">we yu mekem bifo olgeta</para>
  <para style="q4" vid="PSA 44:1">long taem blong ol bubu blong mifala,</para>
  <para style="q2" vid="PSA 44:1">mifala i harem ol samting ya</para>
  <para style="q3" vid="PSA 44:1">stret long sora blong mifala.</para>
  <para style="q1" vid="PSA 44:1">Ol bubu blong mifala</para>
  <para style="q2" vid="PSA 44:1">oli talemaot long mifala finis.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Oli talem se yu nomo yu ronemaot ol hiten man</para>
  <para style="q3" vid="PSA 44:2">blong putum ol man blong yu</para>
  <para style="q4" vid="PSA 44:2">oli stap long graon blong olgeta.</para>
  <para style="q1" vid="PSA 44:2">Yu yu spolem olgeta</para>
  <para style="q2" vid="PSA 44:2">blong mekem ol man blong yu</para>
  <para style="q3" vid="PSA 44:2">oli gat plante samting.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Ol man blong yu,</para>
  <para style="q2" vid="PSA 44:3">oli no winim graon ya long faet,</para>
  <para style="q3" vid="PSA 44:3">no long paoa blong olgeta.</para>
  <para style="q1" vid="PSA 44:3">Oli winim long paoa blong yu</para>
  <para style="q2" vid="PSA 44:3">mo long han blong yu nomo,</para>
  <para style="q3" vid="PSA 44:3">mo from we yu mekem olgeta oli savegud</para>
  <para style="q4" vid="PSA 44:3">we yu yu stap wetem olgeta.</para>
  <para style="q1" vid="PSA 44:3">Hemia i soemaot</para>
  <para style="q2" vid="PSA 44:3">we yu yu lavem olgeta tumas.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Yu yu King blong mi,</para>
  <para style="q2" vid="PSA 44:4">yu yu God blong mi.</para>
  <para style="q1" vid="PSA 44:4">Yu nao yu mekem ol man ya blong yu</para>
  <para style="q2" vid="PSA 44:4">oli stap win.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Mifala i stap winim ol enemi blong</para>
  <para style="q2" vid="PSA 44:5">mifala long paoa blong yu nomo.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Mi mi no trastem bonara blong mi</para>
  <para style="q2" vid="PSA 44:6">no naef blong faet blong mi</para>
  <para style="q3" vid="PSA 44:6">blong sevem mi.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Yu nomo yu stap sevem mifala,</para>
  <para style="q2" vid="PSA 44:7">yu stap tekemaot mifala</para>
  <para style="q3" vid="PSA 44:7">long han blong ol enemi blong mifala,</para>
  <para style="q2" vid="PSA 44:7">yu stap winim olgeta</para>
  <para style="q3" vid="PSA 44:7">we oli no laekem mifala</para>
  <para style="q4" vid="PSA 44:7">oli agens long mifala.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Bambae mifala i stap presem yu olwe nomo.</para>
  <para style="q1" vid="PSA 44:8">Bambae mifala i stap talem tangkiu long yu oltaem,</para>
  <para style="q2" vid="PSA 44:8">gogo i no save finis.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Be naoia,</para>
  <para style="q2" vid="PSA 44:9">yu yu tanem baksaed finis</para>
  <para style="q4" vid="PSA 44:9">long mifala,</para>
  <para style="q3" vid="PSA 44:9">yu no moa stap go</para>
  <para style="q3" vid="PSA 44:9">wetem ol soldia blong mifala bakegen,</para>
  <para style="q4" vid="PSA 44:9">mo yu letem ol enemi blong mifala <optbreak /> oli winim mifala.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Yu mekem mifala i ronwe</para>
  <para style="q3" vid="PSA 44:10">long ol enemi blong mifala,</para>
  <para style="q2" vid="PSA 44:10">nao oli kam tekem olting blong mifala</para>
  <para style="q3" vid="PSA 44:10">oli karem i blong olgeta.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Yu letem mifala,</para>
  <para style="q3" vid="PSA 44:11">blong oli kilim mifala olsem sipsip,</para>
  <para style="q2" vid="PSA 44:11">yu mekem mifala i go stap olbaot</para>
  <para style="q4" vid="PSA 44:11">long ol narafala kantri.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Yu stap salem ol man blong yu</para>
  <para style="q2" vid="PSA 44:12">long praes we i daon olgeta,</para>
  <para style="q3" vid="PSA 44:12">olsem we oli rabis nomo.<verse eid="PSA 44:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Olgeta we oli stap raonabaot long mifala</para>
  <para style="q3" vid="PSA 44:13">oli luk samting ya we yu yu mekem,</para>
  <para style="q2" vid="PSA 44:13">nao oli stap lukluk rabis long mifala,</para>
  <para style="q4" vid="PSA 44:13">oli stap laf long mifala.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Yu yu mekem mifala i kam olsem wan samting</para>
  <para style="q2" vid="PSA 44:14">we ol man blong ol narafala kantri</para>
  <para style="q3" vid="PSA 44:14">oli lukluk nogud long hem,</para>
  <para style="q4" vid="PSA 44:14">oli stap saksakem hed blong olgeta,</para>
  <para style="q3" vid="PSA 44:14">oli stap laf nogud long mifala.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Oltaem mi mi harem</para>
  <para style="q2" vid="PSA 44:15">se mi no moa stret</para>
  <para style="q3" vid="PSA 44:15">long fes blong ol man,</para>
  <para style="q2" vid="PSA 44:15">nao mi mi sem tumas,<verse eid="PSA 44:15" /></para>
  <para style="q3">
    <verse number="16" style="v" sid="PSA 44:16" />from we mi stap harem</para>
  <para style="q4" vid="PSA 44:16">ol rabis tok blong ol enemi blong mi,</para>
  <para style="q4" vid="PSA 44:16">mo ol tok nogud blong olgeta</para>
  <para style="q3" vid="PSA 44:16">we oli no laekem mi, <optbreak /> oli stap agens long mi.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Nating we mifala i no fogetem yu</para>
  <para style="q2" vid="PSA 44:17">mo mifala i no brekem promes ya</para>
  <para style="q3" vid="PSA 44:17">we yu mekem wetem mifala,</para>
  <para style="q2" vid="PSA 44:17">be olgeta samting ya i bin kasem mifala.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Mo nating we mifala i stap folem ol loa blong yu</para>
  <para style="q3" vid="PSA 44:18">mo tingting blong mifala i no gowe long yu,<verse eid="PSA 44:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PSA 44:19" />be yu yu lego mifala</para>
  <para style="q4" vid="PSA 44:19">long medel blong ol wael anamol,</para>
  <para style="q3" vid="PSA 44:19">yu no givhan long mifala,</para>
  <para style="q3" vid="PSA 44:19">yu livim mifala i stap <optbreak /> long ples we i tudak olgeta.<verse eid="PSA 44:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />God blong mifala,</para>
  <para style="q2" vid="PSA 44:20">sipos mifala i bin lego</para>
  <para style="q4" vid="PSA 44:20">fasin blong mekem wosip long yu,</para>
  <para style="q3" vid="PSA 44:20">nao mifala i stap prea</para>
  <para style="q3" vid="PSA 44:20">long wan narafala god,<verse eid="PSA 44:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="PSA 44:21" />i tru,</para>
  <para style="q3" vid="PSA 44:21">yu bambae yu faenemaot samting ya,</para>
  <para style="q4" vid="PSA 44:21">from we yu yu save</para>
  <para style="q3" vid="PSA 44:21">ol tingting blong mifala we i haed,</para>
  <para style="q2" vid="PSA 44:21">be i no olsem.<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44.22: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 8:36">Rom 8.36</ref>
      </char>
    </note>Be evri dei nomo</para>
  <para style="q3" vid="PSA 44:22">oli stap kilim mifala i ded</para>
  <para style="q2" vid="PSA 44:22">from we mifala i man blong yu.</para>
  <para style="q1" vid="PSA 44:22">Oltaem oli stap mekem mifala olsem ol sipsip</para>
  <para style="q2" vid="PSA 44:22">we oli stap rere blong man i kilim olgeta.<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />!Masta<note caller="+" style="f"><char style="fr" closed="false">44.23: </char><char style="fqa" closed="false">Masta</char><char style="ft" closed="false">. Yu luk futnot <char style="bd">K</char> long 35.22.</char></note>, plis yu wekap!</para>
  <para style="q2" vid="PSA 44:23">?From wanem yu stap slip olsem?</para>
  <para style="q1" vid="PSA 44:23">!Yu kam kwik!</para>
  <para style="q1" vid="PSA 44:23">!Yu no lego mifala we yu lego mifala olgeta!<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />?From wanem yu stap haed long mifala?</para>
  <para style="q2" vid="PSA 44:24">!I nogud yu fogetem mifala ya</para>
  <para style="q3" vid="PSA 44:24">we mifala i stap harem nogud,</para>
  <para style="q4" vid="PSA 44:24">mifala i stap long trabol!<verse eid="PSA 44:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Ol enemi blong mifala oli flatemgud mifala,</para>
  <para style="q2" vid="PSA 44:25">mifala i stap ledaon olbaot long graon.</para>
  <para style="q1" vid="PSA 44:25">Olgeta oli winim mifala finis,</para>
  <para style="q2" vid="PSA 44:25">mifala i stap ledaon long asis nomo.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />!Plis yu kam givhan long mifala!</para>
  <para style="q1" vid="PSA 44:26">Plis yu sevem mifala,</para>
  <para style="q2" vid="PSA 44:26">from we fasin blong yu,</para>
  <para style="q3" vid="PSA 44:26">oltaem yu yu lavem mifala tumas.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">Wan sing blong mared blong king</para>
  <para style="sp">(Sing ya, ol pikinini blong Kora oli wokem. Wan sing blong switat.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Taem mi stap wokem sing ya blong king,</para>
  <para style="q2" vid="PSA 45:1">tingting blong mi i fulap long ol gudgudfala tok.</para>
  <para style="q1" vid="PSA 45:1">Tang blong mi i rere nomo blong mekem wan sing,</para>
  <para style="q2" vid="PSA 45:1">olsem we pen blong man we i waes blong raet</para>
  <para style="q3" vid="PSA 45:1">i rere blong raet.<verse eid="PSA 45:1" /></para>
  <para style="sp">(Tok i go long king.)</para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />King,</para>
  <para style="q2" vid="PSA 45:2">yu yu naes moa,</para>
  <para style="q3" vid="PSA 45:2">yu winim olgeta man,</para>
  <para style="q2" vid="PSA 45:2">mo yu wan gudfala man blong tok.</para>
  <para style="q1" vid="PSA 45:2">Oltaem God i stap blesem yu.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Yu yu strong man blong faet.</para>
  <para style="q1" vid="PSA 45:3">Yu yu gat ol gudgudfala samting,</para>
  <para style="q2" vid="PSA 45:3">mo yu hae we yu hae.</para>
  <para style="q1" vid="PSA 45:3">Yu mas tekem naef blong faet blong yu,</para>
  <para style="q3" vid="PSA 45:3">yu hangem long saed blong yu,<verse eid="PSA 45:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 45:4" />mo yu raed long hos blong yu,</para>
  <para style="q3" vid="PSA 45:4">yu go long paoa blong yu</para>
  <para style="q4" vid="PSA 45:4">blong yu winim ol enemi blong yu.</para>
  <para style="q1" vid="PSA 45:4">Yu mas faet from fasin ya</para>
  <para style="q2" vid="PSA 45:4">we man i gat sore long narafala man</para>
  <para style="q3" vid="PSA 45:4">mo from trutok mo stret fasin,</para>
  <para style="q4" vid="PSA 45:4">blong ol fasin ya oli save stanap oltaem.</para>
  <para style="q1" vid="PSA 45:4">Paoa blong yu bambae i mekem yu yu win</para>
  <para style="q2" vid="PSA 45:4">we yu win bigwan.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Ol ara blong yu oli sap,</para>
  <para style="q2" vid="PSA 45:5">bambae oli stikim bodi blong ol enemi blong yu,</para>
  <para style="q3" vid="PSA 45:5">go kasem hat blong olgeta.</para>
  <para style="q1" vid="PSA 45:5">Ol man blong narafala kantri</para>
  <para style="q2" vid="PSA 45:5">bambae oli foldaon long leg blong yu</para>
  <para style="q3" vid="PSA 45:5">blong ona long yu.<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45.6: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:8">Hib 1.8</ref>,<ref loc="HEB 1:9">9</ref></char>
    </note>Paoa we God i givim long yu</para>
  <para style="q3" vid="PSA 45:6">blong yu yu king,</para>
  <para style="q2" vid="PSA 45:6">bambae i stap oltaem nomo,</para>
  <para style="q4" vid="PSA 45:6">i no save finis.<note caller="+" style="f"><char style="fr" closed="false">45.6: </char><char style="ft" closed="false">Narafala rod blong tanem tok long fas haf blong vas ya i olsem. <char style="bd">God, paoa ya blong yu we</char> </char><char style="fqa" closed="false">yu king, bambae i stap oltaem nomo i no save finis.</char></note></para>
  <para style="q1" vid="PSA 45:6">Yu yu stap rulum ol man blong yu</para>
  <para style="q2" vid="PSA 45:6">long stret fasin.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Yu yu laekem ol fasin we i stret,</para>
  <para style="q2" vid="PSA 45:7">be ol fasin we i nogud</para>
  <para style="q3" vid="PSA 45:7">yu agens long olgeta.</para>
  <para style="q1" vid="PSA 45:7">Nao from samting ya,</para>
  <para style="q2" vid="PSA 45:7">God, we i God blong yu,</para>
  <para style="q3" vid="PSA 45:7">hem i jusumaot yu finis,</para>
  <para style="q4" vid="PSA 45:7">mo i mekem yu yu glad moa,</para>
  <para style="q3" vid="PSA 45:7">i winim we i mekem <optbreak /> long ol narafala king.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Tufala senta ya, mir* mo alos,*</para>
  <para style="q2" vid="PSA 45:8">oli stap putum long klos blong yu.</para>
  <para style="q1" vid="PSA 45:8">Yu yu stap long ol gudfala haos blong yu</para>
  <para style="q3" vid="PSA 45:8">we oli flasem long tut blong elefen,</para>
  <para style="q2" vid="PSA 45:8">mo ol man blong stringban oli stap</para>
  <para style="q4" vid="PSA 45:8">plei blong mekem yu yu glad.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Long haos blong yu ol woman oli stap</para>
  <para style="q3" vid="PSA 45:9">we samfala oli dota blong ol king,</para>
  <para style="q2" vid="PSA 45:9">mo kwin i stap stanap</para>
  <para style="q3" vid="PSA 45:9">long raet saed blong jea blong yu.</para>
  <para style="q1" vid="PSA 45:9">Hem i putum ol flas samting</para>
  <para style="q2" vid="PSA 45:9">we oli wokem long gol we i beswan.<verse eid="PSA 45:9" /></para>
  <para style="sp">(Tok i go long woman we i mared long king.)</para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Yu we tede yu mared long king,</para>
  <para style="q2" vid="PSA 45:10">yu lesin long samting we bambae mi talem.</para>
  <para style="q1" vid="PSA 45:10">Yu mas fogetem ol man ples blong yu</para>
  <para style="q2" vid="PSA 45:10">mo ol famle blong yu.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Bambae king i wantem yu tumas,</para>
  <para style="q2" vid="PSA 45:11">from we yu yu naes we yu naes.</para>
  <para style="q1" vid="PSA 45:11">Hem i masta blong yu,</para>
  <para style="q2" vid="PSA 45:11">mo yu mas ona long hem.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Ol man Taea bambae oli tekem ol</para>
  <para style="q3" vid="PSA 45:12">presen i kam long yu,</para>
  <para style="q2" vid="PSA 45:12">mo ol rijman bambae oli traem</para>
  <para style="q4" vid="PSA 45:12">blong mekem yu yu glad long olgeta.<verse eid="PSA 45:12" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="13-14" style="v" sid="PSA 45:13-14" />Gel ya we bambae i mared long king,</para>
  <para style="q2" vid="PSA 45:13-14">hem i naes we i naes.</para>
  <para style="q1" vid="PSA 45:13-14">Hem i werem klos blong hem</para>
  <para style="q2" vid="PSA 45:13-14">we oli wokem long gol tred,</para>
  <para style="q3" vid="PSA 45:13-14">mo we i gat plante kala long hem.</para>
  <para style="q1" vid="PSA 45:13-14">Nao hem i wokbaot i go insaed long haos blong king,</para>
  <para style="q2" vid="PSA 45:13-14">mo oli tekem hem i go long king,</para>
  <para style="q3" vid="PSA 45:13-14">we ol gel blong folem hem long</para>
  <para style="q4" vid="PSA 45:13-14">mared oli biaen long hem.<verse eid="PSA 45:13-14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Olgeta ya oli go insaed long haos blong king,</para>
  <para style="q2" vid="PSA 45:15">we oli glad we oli glad.<verse eid="PSA 45:15" /></para>
  <para style="sp">(Tok i go long king.)</para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />King,</para>
  <para style="q2" vid="PSA 45:16">ol pikinini blong yu</para>
  <para style="q3" vid="PSA 45:16">wetem olgeta we bambae oli kamaot biaen long olgeta,</para>
  <para style="q4" vid="PSA 45:16">bambae olgeta tu oli king</para>
  <para style="q3" vid="PSA 45:16">olsem ol bubu blong yu bifo.</para>
  <para style="q1" vid="PSA 45:16">Mo bambae yu mekem olgeta oli rul</para>
  <para style="q2" vid="PSA 45:16">long olgeta ples long wol.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Sing ya blong mi</para>
  <para style="q2" vid="PSA 45:17">bambae i holem nem blong yu,</para>
  <para style="q3" vid="PSA 45:17">i stap oltaem nomo.</para>
  <para style="q1" vid="PSA 45:17">Mo olgeta man</para>
  <para style="q2" vid="PSA 45:17">bambae oli stap presem nem blong yu,</para>
  <para style="q3" vid="PSA 45:17">gogo i no save finis.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">God i stap wetem yumi</para>
  <para style="sp">(Sing ya, ol pikinini blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />God, hem i sefples blong yumi,</para>
  <para style="q2" vid="PSA 46:1">hem i paoa blong yumi.</para>
  <para style="q1" vid="PSA 46:1">Oltaem hem i rere blong givhan long yumi</para>
  <para style="q2" vid="PSA 46:1">long taem blong trabol.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Nao from samting ya,</para>
  <para style="q2" vid="PSA 46:2">nating sipos graon i seksek,</para>
  <para style="q3" vid="PSA 46:2">mo ol hil oli folfoldaon</para>
  <para style="q3" vid="PSA 46:2">i go long dipsi,</para>
  <para style="q2" vid="PSA 46:2">be yumi no save fraet.<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />I nomata sipos solwota i girap</para>
  <para style="q2" vid="PSA 46:3">we i raf we i raf,</para>
  <para style="q4" vid="PSA 46:3">mo ol hil oli stap seksek from,</para>
  <para style="q2" vid="PSA 46:3">be bambae yumi no save fraet nating.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />God i hae we i hae,</para>
  <para style="q2" vid="PSA 46:4">mo i gat wan reva i stap ron</para>
  <para style="q4" vid="PSA 46:4">long taon blong hem,</para>
  <para style="q3" vid="PSA 46:4">we i stap mekem ol man long taon ya oli glad,</para>
  <para style="q4" vid="PSA 46:4">i stap mekem ol man long tabu haos* blong hem</para>
  <para style="q3" vid="PSA 46:4">oli glad tumas.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />God i stap insaed long taon ya,</para>
  <para style="q2" vid="PSA 46:5">mo neva bambae ples ya i seksek</para>
  <para style="q3" vid="PSA 46:5">i foldaon.</para>
  <para style="q1" vid="PSA 46:5">Taem i stat brok delaet,</para>
  <para style="q2" vid="PSA 46:5">be hem i stap finis</para>
  <para style="q3" vid="PSA 46:5">blong givhan long taon ya.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Taem hem i tok,</para>
  <para style="q2" vid="PSA 46:6">voes blong hem i faerap olsem tanda,</para>
  <para style="q3" vid="PSA 46:6">nao wol ya i ronaot,</para>
  <para style="q4" vid="PSA 46:6">i kam olsem wota.</para>
  <para style="q1" vid="PSA 46:6">Mo ol man blong ol narafala kantri</para>
  <para style="q2" vid="PSA 46:6">oli fraet tumas,</para>
  <para style="q3" vid="PSA 46:6">mo ol kingdom oli folfoldaon.<verse eid="PSA 46:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />Hae God i gat olgeta paoa,</para>
  <para style="q2" vid="PSA 46:7">mo hem i stap wetem yumi.</para>
  <para style="q1" vid="PSA 46:7">Hem i God blong Jekob,*</para>
  <para style="q2" vid="PSA 46:7">hem i sefples blong yumi.<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Yufala i kam,</para>
  <para style="q2" vid="PSA 46:8">yufala i luk ol samting ya</para>
  <para style="q3" vid="PSA 46:8">we Hae God i mekem.</para>
  <para style="q1" vid="PSA 46:8">Yufala i luk</para>
  <para style="q2" vid="PSA 46:8">ol bigbigfala wok ya</para>
  <para style="q3" vid="PSA 46:8">we hem i mekem long wol.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Hem i stap mekem</para>
  <para style="q2" vid="PSA 46:9">ol faet i finis</para>
  <para style="q3" vid="PSA 46:9">long olgeta ples long wol.</para>
  <para style="q1" vid="PSA 46:9">Hem i stap brekem ol bonara,</para>
  <para style="q2" vid="PSA 46:9">i stap spolem ol spia,</para>
  <para style="q3" vid="PSA 46:9">mo i stap bonem ol sil* long faea.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />Hem i talem se,</para>
  <para style="q2" vid="PSA 46:10">“!Yufala i no moa faet!</para>
  <para style="q3" vid="PSA 46:10">!Yufala i mas save we mi mi God!</para>
  <para style="q2" vid="PSA 46:10">Mi mi King blong ol man long ol narafala kantri.</para>
  <para style="q2" vid="PSA 46:10">Mi mi King blong olgeta man long wol.”<verse eid="PSA 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />Hae God i gat olgeta paoa,</para>
  <para style="q2" vid="PSA 46:11">mo hem i stap wetem yumi.</para>
  <para style="q1" vid="PSA 46:11">Hem i God blong Jekob,</para>
  <para style="q2" vid="PSA 46:11">hem i sefples blong yumi.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">God i King blong olgeta man</para>
  <para style="sp">(Sing ya, ol pikinini blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />!Olgeta man blong evri ples!</para>
  <para style="q2" vid="PSA 47:1">!Yufala evriwan i klapem han!</para>
  <para style="q1" vid="PSA 47:1">!Yufala i singsing bigwan blong presem God</para>
  <para style="q2" vid="PSA 47:1">long ol singsing blong glad!<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Hae God i hae we i hae,</para>
  <para style="q2" vid="PSA 47:2">yumi mas ona long hem.</para>
  <para style="q1" vid="PSA 47:2">Hem i King we i gat paoa,</para>
  <para style="q2" vid="PSA 47:2">i stap rul long olgeta ples long wol.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Hem i givhan long yumi</para>
  <para style="q3" vid="PSA 47:3">blong yumi winim ol man</para>
  <para style="q4" vid="PSA 47:3">blong ol narafala kantri,</para>
  <para style="q2" vid="PSA 47:3">i mekem we yumi rulum olgeta.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />Yumi ol man blong hem</para>
  <para style="q3" vid="PSA 47:4">we hem i lavem yumi,</para>
  <para style="q2" vid="PSA 47:4">mo ples ya we yumi stap long hem,</para>
  <para style="q4" vid="PSA 47:4">we yumi stap flas from,</para>
  <para style="q3" vid="PSA 47:4">hem nao i jusumaot <optbreak /> se i blong yumi.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />Hae God i God blong yumi.</para>
  <para style="q2" vid="PSA 47:5">Hem i go antap finis,</para>
  <para style="q3" vid="PSA 47:5">i sidaon long bigfala jea blong hem.<note caller="+" style="f"><char style="fr" closed="false">47.5: </char><char style="ft" closed="false">Vas ya i tokbaot taem ya we ol Livaet oli karem Bokis we i Saen blong Promes i go insaed long haos blong God, nao oli go putum long ples blong hem. Lid blong Bokis ya i pija blong bigfala jea blong God.</char></note></para>
  <para style="q1" vid="PSA 47:5">Mo taem hem i stap go antap</para>
  <para style="q2" vid="PSA 47:5">ol man oli glad, oli singsingaot,</para>
  <para style="q2" vid="PSA 47:5">oli stap blu bigwan long ol pupu.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />!God i King blong yumi!</para>
  <para style="q2" vid="PSA 47:6">!Yumi sing! !Yumi presem hem!<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />!Hem i rul long olgeta ples long wol!</para>
  <para style="q2" vid="PSA 47:7">!Yumi presem hem</para>
  <para style="q3" vid="PSA 47:7">long ol singsing blong yumi!<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8-9" style="v" sid="PSA 47:8-9" />God ya i God blong Ebraham,</para>
  <para style="q2" vid="PSA 47:8-9">mo hem i stap sidaon</para>
  <para style="q4" vid="PSA 47:8-9">long tabu jea blong hem,</para>
  <para style="q3" vid="PSA 47:8-9">hem i stap rul long olgeta kantri.</para>
  <para style="q1" vid="PSA 47:8-9">Ol lida blong ol narafala kantri</para>
  <para style="q2" vid="PSA 47:8-9">bambae oli kam wanples,</para>
  <para style="q3" vid="PSA 47:8-9">oli joen wetem yumi ol man blong hem.</para>
  <para style="q1" vid="PSA 47:8-9">Hem i gat paoa moa i winim olgeta soldia,</para>
  <para style="q2" vid="PSA 47:8-9">mo hem bambae i King blong olgeta man.<verse eid="PSA 47:8-9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">Saeon i taon blong Hae God</para>
  <para style="sp">(Sing ya, ol pikinini blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />Hae God i God blong yumi,</para>
  <para style="q3" vid="PSA 48:1">mo hem i hae we i hae.</para>
  <para style="q1" vid="PSA 48:1">Long taon ya blong hem,</para>
  <para style="q2" vid="PSA 48:1">long tabu hil* ya blong hem,</para>
  <para style="q3" vid="PSA 48:1">yumi mas leftemap nem blong hem i go antap.<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48.2: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:35">Mat 5.35</ref>
      </char>
    </note>God, hem i King we i gat paoa,</para>
  <para style="q2" vid="PSA 48:2">mo Saeon,* hil ya blong hem i hae,</para>
  <para style="q4" vid="PSA 48:2">mo i gudfala tumas,</para>
  <para style="q3" vid="PSA 48:2">mo taon ya blong hem i stap mekem</para>
  <para style="q3" vid="PSA 48:2">ol man long olgeta ples long wol oli glad.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />God i soemaot finis</para>
  <para style="q2" vid="PSA 48:3">we taem yumi stap wetem hem,</para>
  <para style="q3" vid="PSA 48:3">long ol strong sefples insaed long taon ya,</para>
  <para style="q4" vid="PSA 48:3">yumi save stap gud.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Ol king blong ol narafala kantri oli kam wanples,</para>
  <para style="q2" vid="PSA 48:4">nao oli kam hivap raon long taon ya</para>
  <para style="q3" vid="PSA 48:4">blong mekem faet long yumi.<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Be taem oli luk taon ya,</para>
  <para style="q2" vid="PSA 48:5">oli sapraes tumas,</para>
  <para style="q3" vid="PSA 48:5">nao oli fraet, oli ronwe.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Oli fraet we oli fraet,</para>
  <para style="q2" vid="PSA 48:6">nao oli harem nogud tumas</para>
  <para style="q3" vid="PSA 48:6">olsem woman we i wantem bonem pikinini blong hem.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Oli olsem sip</para>
  <para style="q2" vid="PSA 48:7">we bigfala win i stap sakem i go olbaot.<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Hae God i gat olgeta paoa,</para>
  <para style="q2" vid="PSA 48:8">mo hem i God blong yumi.</para>
  <para style="q1" vid="PSA 48:8">Ol samting ya we hem i bin mekem bifo,</para>
  <para style="q3" vid="PSA 48:8">yumi harem finis,</para>
  <para style="q2" vid="PSA 48:8">mo naoia yumi luk bakegen</para>
  <para style="q4" vid="PSA 48:8">long taon ya blong hem.</para>
  <para style="q1" vid="PSA 48:8">Hem bambae i holem taon ya</para>
  <para style="q2" vid="PSA 48:8">i stap gud oltaem nomo,</para>
  <para style="q3" vid="PSA 48:8">gogo i no save finis.<verse eid="PSA 48:8" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />God,</para>
  <para style="q2" vid="PSA 48:9">insaed long haos* blong yu,</para>
  <para style="q3" vid="PSA 48:9">mifala i stap tingting long fasin ya blong yu,</para>
  <para style="q4" vid="PSA 48:9">we oltaem yu yu lavem man tumas.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Olgeta man long evri ples</para>
  <para style="q3" vid="PSA 48:10">oli stap presem yu,</para>
  <para style="q2" vid="PSA 48:10">mo hae nem blong yu</para>
  <para style="q4" vid="PSA 48:10">i finisim olgeta ples long wol.</para>
  <para style="q1" vid="PSA 48:10">!Yu yu stap rulum ol man long stret fasin!<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />!I gud mifala evriwan long Saeon,</para>
  <para style="q2" vid="PSA 48:11">mifala i glad!</para>
  <para style="q1" vid="PSA 48:11">!Yu yu stap jajem ol man long stret fasin!</para>
  <para style="q1" vid="PSA 48:11">!I gud mifala evriwan long ol taon long Juda,*</para>
  <para style="q2" vid="PSA 48:11">mifala i glad!<verse eid="PSA 48:11" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Ol man blong God,</para>
  <para style="q2" vid="PSA 48:12">yufala i wokbaot</para>
  <para style="q3" vid="PSA 48:12">i goraon long bigfala taon ya Saeon.</para>
  <para style="q1" vid="PSA 48:12">Yufala i kaontem ol wajhaos* blong hem,<verse eid="PSA 48:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 48:13" />yufala i luklukgud bigfala stonwol blong hem,</para>
  <para style="q3" vid="PSA 48:13">mo yufala i makemgud ol strong haos blong hem,</para>
  <para style="q2" vid="PSA 48:13">blong yufala i save talemgud long ol pikinini</para>
  <para style="q3" vid="PSA 48:13">we bambae oli kamaot biaen long yufala se,<verse eid="PSA 48:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 48:14" />“God ya blong Saeon,</para>
  <para style="q4" vid="PSA 48:14">hem i God blong yumi.</para>
  <para style="q2" vid="PSA 48:14">Hem bambae i God blong yumi oltaem,</para>
  <para style="q3" vid="PSA 48:14">mo bambae hem i lidim yumi,</para>
  <para style="q4" vid="PSA 48:14">gogo i no save finis.”<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">Fasin ya we man i putum tingting blong hem long plante samting we hem i gat, hem i krangke</para>
  <para style="sp">(Sing ya, ol pikinini blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 49:1-2" />!Olgeta man blong evri ples!</para>
  <para style="q2" vid="PSA 49:1-2">!Yufala evriwan i lesin!</para>
  <para style="q1" vid="PSA 49:1-2">!Ol haeman mo ol olbaotman!</para>
  <para style="q2" vid="PSA 49:1-2">!Ol rijman mo ol puaman!</para>
  <para style="q1" vid="PSA 49:1-2">!Yufala evriwan long wol!</para>
  <para style="q2" vid="PSA 49:1-2">!Yufala i harem samting ya!<verse eid="PSA 49:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Ol tok we bambae mi talem</para>
  <para style="q2" vid="PSA 49:3">i waes tumas.</para>
  <para style="q1" vid="PSA 49:3">Tok we bambae i kamaot long tingting blong mi</para>
  <para style="q2" vid="PSA 49:3">i hevi gud.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Bambae mi tingting gud long ol waestok ya</para>
  <para style="q3" vid="PSA 49:4">we ol olfala oli stap talem,</para>
  <para style="q2" vid="PSA 49:4">mo taem mi plei long gita</para>
  <para style="q3" vid="PSA 49:4">bambae mi stap talemaot ol mining blong olgeta.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 49:5-6" />Long taem blong trabol,</para>
  <para style="q2" vid="PSA 49:5-6">mi mi no save fraet.</para>
  <para style="q1" vid="PSA 49:5-6">Nating we ol enemi blong mi</para>
  <para style="q2" vid="PSA 49:5-6">oli trastem plante samting we oli gat,</para>
  <para style="q3" vid="PSA 49:5-6">mo oli stap tok flas tumas</para>
  <para style="q4" vid="PSA 49:5-6">from ol samting ya,</para>
  <para style="q2" vid="PSA 49:5-6">be sipos olgeta oli kamraon long mi</para>
  <para style="q4" vid="PSA 49:5-6">blong ronem mi,</para>
  <para style="q3" vid="PSA 49:5-6">bambae mi no save fraet long olgeta.<verse eid="PSA 49:5-6" /></para>
  <para style="q1">
    <verse number="7-9" style="v" sid="PSA 49:7-9" />I no gat man i save pemaot laef blong hem</para>
  <para style="q2" vid="PSA 49:7-9">blong bambae i no go long beregraon.</para>
  <para style="q1" vid="PSA 49:7-9">Man i no save pem laef blong hem long God</para>
  <para style="q3" vid="PSA 49:7-9">blong bambae i stap laef olwe,</para>
  <para style="q2" vid="PSA 49:7-9">from we praes blong laef blong man</para>
  <para style="q4" vid="PSA 49:7-9">i hae tumas.</para>
  <para style="q1" vid="PSA 49:7-9">Olgeta samting we man i save givim,</para>
  <para style="q2" vid="PSA 49:7-9">neva bambae i naf long samting ya.<verse eid="PSA 49:7-9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Yufala i save.</para>
  <para style="q1" vid="PSA 49:10">Nating we man i waes,</para>
  <para style="q3" vid="PSA 49:10">be hem i sem mak nomo</para>
  <para style="q4" vid="PSA 49:10">long man we i no gat hed,</para>
  <para style="q3" vid="PSA 49:10">mo man we i krangke,</para>
  <para style="q2" vid="PSA 49:10">olgeta evriwan oli mas ded.</para>
  <para style="q1" vid="PSA 49:10">Olgeta evriwan bambae oli livim</para>
  <para style="q2" vid="PSA 49:10">ol gudgudfala samting blong olgeta</para>
  <para style="q3" vid="PSA 49:10">long han blong ol narafala man.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Beregraon bambae i hom blong olgeta olwe nomo.</para>
  <para style="q1" vid="PSA 49:11">Nating we fastaem oli gat graon blong olgeta,</para>
  <para style="q2" vid="PSA 49:11">be bambae oli stap long ples ya</para>
  <para style="q3" vid="PSA 49:11">gogo i no save finis.<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Hae nem blong man i no save sevem hem long ded,</para>
  <para style="q2" vid="PSA 49:12">bambae hem i mas ded olsem ol anamol.<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Yufala i traem makem ol man</para>
  <para style="q2" vid="PSA 49:13">we oli stap trastem olgeta nomo.</para>
  <para style="q1" vid="PSA 49:13">Naoia, olgeta oli stap harem gud</para>
  <para style="q2" vid="PSA 49:13">long plante samting ya blong olgeta.</para>
  <para style="q1" vid="PSA 49:13">?Be bambae oli kasem wanem samting?<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Bambae oli ded olsem sipsip nomo,</para>
  <para style="q2" vid="PSA 49:14">mo Ded bambae i man blong lukaot long olgeta.</para>
  <para style="q1" vid="PSA 49:14">Ol bodi blong olgeta</para>
  <para style="q2" vid="PSA 49:14">bambae oli roten kwiktaem nomo,</para>
  <para style="q3" vid="PSA 49:14">long Hom* blong ol Dedman,</para>
  <para style="q4" vid="PSA 49:14">we i longwe long ples blong olgeta.</para>
  <para style="q1" vid="PSA 49:14">Be ol stret man bambae oli win.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />God bambae i sevem mi,</para>
  <para style="q2" vid="PSA 49:15">hem bambae i tekemaot mi</para>
  <para style="q2" vid="PSA 49:15">long paoa blong ded,</para>
  <para style="q3" vid="PSA 49:15">i tekem mi mi go stap wetem hem.<verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Sipos yufala i luk</para>
  <para style="q2" vid="PSA 49:16">we man i stap kam rijman,</para>
  <para style="q3" vid="PSA 49:16">we olting blong hem i stap kam plante we plante,</para>
  <para style="q2" vid="PSA 49:16">bambae yufala i no harem nogud.<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />Taem hem i ded,</para>
  <para style="q2" vid="PSA 49:17">bambae hem i no save tekem ol gudgudfala samting ya</para>
  <para style="q3" vid="PSA 49:17">i go wetem hem.</para>
  <para style="q1" vid="PSA 49:17">Ol samting ya blong hem</para>
  <para style="q2" vid="PSA 49:17">bambae oli no save go wetem hem</para>
  <para style="q3" vid="PSA 49:17">long beregraon.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Nating sipos man i stap harem gud</para>
  <para style="q2" vid="PSA 49:18">oltaem long laef blong hem,</para>
  <para style="q3" vid="PSA 49:18">mo ol man oli stap leftemap hem,</para>
  <para style="q4" vid="PSA 49:18">from we hem i stap win,<verse eid="PSA 49:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PSA 49:19" />be bambae hem i mas ded,</para>
  <para style="q3" vid="PSA 49:19">i go joen long ol bubu blong hem,</para>
  <para style="q4" vid="PSA 49:19">long ples ya we i tudak olwe nomo.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Hae nem blong man i no save sevem hem long ded,</para>
  <para style="q2" vid="PSA 49:20">bambae hem i mas ded olsem ol anamol.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">Prapa fasin blong mekem wosip</para>
  <para style="sp">(Sing ya, Asaf i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />Hae God, hem i God,</para>
  <para style="q2" vid="PSA 50:1">mo hem i gat olgeta paoa.</para>
  <para style="q1" vid="PSA 50:1">Hem i sanemaot tok blong hem</para>
  <para style="q2" vid="PSA 50:1">i go long olgeta ples long wol,</para>
  <para style="q3" vid="PSA 50:1">i stat long is, i go kasem long wes,</para>
  <para style="q4" vid="PSA 50:1">blong singaot olgeta man</para>
  <para style="q3" vid="PSA 50:1">oli kam wanples.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Saeon,*</para>
  <para style="q3" vid="PSA 50:2">i gudfala ples we i gud tumas,</para>
  <para style="q2" vid="PSA 50:2">mo bigfala delaet ya</para>
  <para style="q3" vid="PSA 50:2">we i soemaot we God i stap,</para>
  <para style="q4" vid="PSA 50:2">i stap saenaot long ples ya,</para>
  <para style="q3" vid="PSA 50:2">i kasem evri ples.<verse eid="PSA 50:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />God blong yumi i stap kam,</para>
  <para style="q2" vid="PSA 50:3">be i no kam long kwaet fasin,</para>
  <para style="q1" vid="PSA 50:3">Faea we i stap kakae ol samting</para>
  <para style="q3" vid="PSA 50:3">i stap kam fastaem long hem,</para>
  <para style="q2" vid="PSA 50:3">mo win we i strong tumas</para>
  <para style="q4" vid="PSA 50:3">i stap raonabaot long hem.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />Hem i singaot heven mo wol</para>
  <para style="q2" vid="PSA 50:4">blong tufala i witnes blong hem,</para>
  <para style="q3" vid="PSA 50:4">bambae tufala i luk</para>
  <para style="q4" vid="PSA 50:4">we hem i jajem olgeta man blong hem.<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />Hem i talem se,</para>
  <para style="q2" vid="PSA 50:5">“Yufala i tekem ol man blong mi</para>
  <para style="q3" vid="PSA 50:5">we tingting blong olgeta i stap strong long mi,</para>
  <para style="q4" vid="PSA 50:5">oli kam wanples.</para>
  <para style="q2" vid="PSA 50:5">Olgeta we oli mekem sakrefaes long mi</para>
  <para style="q4" vid="PSA 50:5">blong soemaot we oli holem promes blong mi,</para>
  <para style="q3" vid="PSA 50:5">oli mas kam stanap long fes blong mi.”<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Olgeta samting long skae oli stap talemaot</para>
  <para style="q2" vid="PSA 50:6">we fasin blong God i stret,</para>
  <para style="q3" vid="PSA 50:6">mo hem nomo i save jajem ol man.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />Nao God i talem se,</para>
  <para style="q2" vid="PSA 50:7">“Ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 50:7">yufala i man blong mi.</para>
  <para style="q2" vid="PSA 50:7">Yufala i lesin,</para>
  <para style="q3" vid="PSA 50:7">nao bambae mi mi toktok.</para>
  <para style="q2" vid="PSA 50:7">Bambae mi talemaot ol poen</para>
  <para style="q3" vid="PSA 50:7">agens long yufala.</para>
  <para style="q2" vid="PSA 50:7">Mi mi God,</para>
  <para style="q3" vid="PSA 50:7">mi God blong yufala.<verse eid="PSA 50:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 50:8" />Mi mi no save tok long yufala</para>
  <para style="q3" vid="PSA 50:8">from ol sakrefaes blong yufala.</para>
  <para style="q2" vid="PSA 50:8">Ol presen ya we yufala i stap bonem long olta</para>
  <para style="q3" vid="PSA 50:8">oli stap oltaem long fes blong mi.<verse eid="PSA 50:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 50:9" />Be mi mi no stap wantem ol bul</para>
  <para style="q4" vid="PSA 50:9">long ol fam blong yufala</para>
  <para style="q3" vid="PSA 50:9">mo ol man nani</para>
  <para style="q1" vid="PSA 50:9">long ol fenis blong yufala.<verse eid="PSA 50:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 50:10" />Olgeta anamol long bus oli blong mi,</para>
  <para style="q3" vid="PSA 50:10">wetem olgeta buluk long hamas taosen hil.<verse eid="PSA 50:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 50:11" />Olgeta wael pijin</para>
  <para style="q4" vid="PSA 50:11">wetem ol narafala laef samting</para>
  <para style="q3" vid="PSA 50:11">we oli stap olbaot long wol,</para>
  <para style="q3" vid="PSA 50:11">oli blong mi.<verse eid="PSA 50:11" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="12" style="v" sid="PSA 50:12" />“Mo sipos mi hanggri,</para>
  <para style="q3" vid="PSA 50:12">bambae mi no save askem</para>
  <para style="q3" vid="PSA 50:12">ol samting ya long yufala,</para>
  <para style="q3" vid="PSA 50:12">from we wol ya</para>
  <para style="q4" vid="PSA 50:12">wetem evri samting we i stap long hem</para>
  <para style="q4" vid="PSA 50:12">oli blong mi.<verse eid="PSA 50:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 50:13" />?Weswe?</para>
  <para style="q2" vid="PSA 50:13">?Yufala i ting</para>
  <para style="q3" vid="PSA 50:13">se mi mi stap kakae mit blong bul,</para>
  <para style="q4" vid="PSA 50:13">no mi stap dring blad blong nani?<verse eid="PSA 50:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 50:14" />Mi mi God, mo mi hae we mi hae,</para>
  <para style="q3" vid="PSA 50:14">mo i gud yufala i stap talem tangkiu long mi oltaem.</para>
  <para style="q2" vid="PSA 50:14">Hemia nao i prapa sakrefaes blong yufala.</para>
  <para style="q2" vid="PSA 50:14">Mo i gud yufala i stap mekem olgeta samting</para>
  <para style="q3" vid="PSA 50:14">we yufala i promes finis long mi,</para>
  <para style="q4" vid="PSA 50:14">se bambae yufala i mekem.<verse eid="PSA 50:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 50:15" />Nao sipos yufala i singaot long mi long taem blong trabol,</para>
  <para style="q3" vid="PSA 50:15">bambae mi mi sevem yufala,</para>
  <para style="q4" vid="PSA 50:15">mo bambae yufala i leftemap nem blong mi.”<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />Be God i tok long ol man nogud,</para>
  <para style="q3" vid="PSA 50:16">i talem se,</para>
  <para style="q2" vid="PSA 50:16">“?From wanem yufala i stap lanem ol loa blong mi,</para>
  <para style="q3" vid="PSA 50:16">nao yufala i stap ridim baehat?</para>
  <para style="q2" vid="PSA 50:16">?From wanem yufala i stap tokbaot promes ya</para>
  <para style="q3" vid="PSA 50:16">we mi bin mekem wetem ol bubu blong yufala bifo?</para>
  <para style="q2" vid="PSA 50:16">!Yufala i man blong giaman nomo!<verse eid="PSA 50:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PSA 50:17" />Yufala i stap sakem ol tok blong mi,</para>
  <para style="q3" vid="PSA 50:17">mo yufala i no wantem nating</para>
  <para style="q4" vid="PSA 50:17">blong mi mi stretem yufala.<verse eid="PSA 50:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="PSA 50:18" />Oltaem yufala i stap mekem fren</para>
  <para style="q4" vid="PSA 50:18">long ol man blong stil,</para>
  <para style="q3" vid="PSA 50:18">mo yufala i stap go miksap</para>
  <para style="q3" vid="PSA 50:18">wetem ol man blong stilim woman.<verse eid="PSA 50:18" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="19" style="v" sid="PSA 50:19" />“Oltaem yufala i rere nomo</para>
  <para style="q4" vid="PSA 50:19">blong talem ol tok we i nogud,</para>
  <para style="q3" vid="PSA 50:19">mo yufala i stap gohed blong giaman</para>
  <para style="q3" vid="PSA 50:19">we yufala i no kea.<verse eid="PSA 50:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="PSA 50:20" />Yufala i stap tok agens</para>
  <para style="q4" vid="PSA 50:20">long ol brata blong yufala.</para>
  <para style="q2" vid="PSA 50:20">Ol stret brata blong yufala nomo,</para>
  <para style="q3" vid="PSA 50:20">be yufala i stap spolem nem blong olgeta.<verse eid="PSA 50:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="PSA 50:21" />Yufala i stap mekem ol samting ya,</para>
  <para style="q3" vid="PSA 50:21">mo yufala i ting</para>
  <para style="q4" vid="PSA 50:21">se mi mi no save tok long yufala from.</para>
  <para style="q2" vid="PSA 50:21">!Yufala i ting</para>
  <para style="q3" vid="PSA 50:21">se mi mi olsem yufala nomo!</para>
  <para style="q2" vid="PSA 50:21">Be naoia,</para>
  <para style="q3" vid="PSA 50:21">bambae mi mi tok strong long yufala,</para>
  <para style="q4" vid="PSA 50:21">blong mekem ol poen blong yufala</para>
  <para style="q3" vid="PSA 50:21">i klia gud long yufala.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="22" style="v" sid="PSA 50:22" />“Yufala we i no tingting long mi,</para>
  <para style="q3" vid="PSA 50:22">yufala i lesin long ol samting ya.</para>
  <para style="q2" vid="PSA 50:22">Sipos no,</para>
  <para style="q3" vid="PSA 50:22">bambae mi mi spolem yufala,</para>
  <para style="q4" vid="PSA 50:22">nao bambae i no gat man blong sevem yufala.<verse eid="PSA 50:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PSA 50:23" />Man we i stap talem tangkiu long mi,</para>
  <para style="q3" vid="PSA 50:23">hem i stap ona long mi,</para>
  <para style="q4" vid="PSA 50:23">i olsem we hem i stap mekem prapa sakrefaes long mi.</para>
  <para style="q2" vid="PSA 50:23">Mo man we i stap obei long mi,</para>
  <para style="q3" vid="PSA 50:23">mi bambae mi sevem hem.”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">Prea we man i mekem blong God i tekemaot sin blong hem</para>
  <para style="sp">(Sing ya, Deved i wokem, biaen long taem ya we Profet Natan i tok long hem from we hem i slip wetem Batseba, woman blong Uria.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />God, oltaem yu yu lavem man tumas,</para>
  <para style="q3" vid="PSA 51:1">plis yu sore long mi.</para>
  <para style="q1" vid="PSA 51:1">Fasin blong yu blong gat sore long</para>
  <para style="q3" vid="PSA 51:1">man i bigwan tumas,</para>
  <para style="q2" vid="PSA 51:1">plis yu ravemaot ol sin blong mi.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Yu wasemaot ol fasin nogud ya</para>
  <para style="q3" vid="PSA 51:2">long laef blong mi,</para>
  <para style="q2" vid="PSA 51:2">yu tekemaot ol sin blong mi,</para>
  <para style="q4" vid="PSA 51:2">yu mekem mi mi klin.<verse eid="PSA 51:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Mi mi luksave ol rabis fasin blong mi,</para>
  <para style="q2" vid="PSA 51:3">oltaem mi mi savegud ol sin blong mi.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51.4: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:4">Rom 3.4</ref>
      </char>
    </note>Sin ya we mi mekem</para>
  <para style="q3" vid="PSA 51:4">i agens long yu nomo,</para>
  <para style="q2" vid="PSA 51:4">mi mi mekem ol samting ya</para>
  <para style="q4" vid="PSA 51:4">we i nogud tumas long fes blong yu.</para>
  <para style="q1" vid="PSA 51:4">From samting ya,</para>
  <para style="q3" vid="PSA 51:4">i stret we yu yu stap jajem mi,</para>
  <para style="q2" vid="PSA 51:4">i stret nomo</para>
  <para style="q4" vid="PSA 51:4">we yu yu stap tok long mi.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Mi mi man nogud,</para>
  <para style="q2" vid="PSA 51:5">i stat long taem we mi mi bon.</para>
  <para style="q1" vid="PSA 51:5">Fasin blong mi i nogud,</para>
  <para style="q2" vid="PSA 51:5">i stat long taem we mi stap yet</para>
  <para style="q3" vid="PSA 51:5">long bel blong mama blong mi.<verse eid="PSA 51:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Be yu yu wantem man</para>
  <para style="q2" vid="PSA 51:6">we tingting blong hem</para>
  <para style="q3" vid="PSA 51:6">i stret gud olgeta.</para>
  <para style="q1" vid="PSA 51:6">Plis yu fulumap tingting blong mi</para>
  <para style="q2" vid="PSA 51:6">long waes blong yu.<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Plis yu tekemaot ol sin blong mi,</para>
  <para style="q2" vid="PSA 51:7">nao bambae mi mi klin.<note caller="+" style="f"><char style="fr" closed="false">51.7: </char><char style="ft" closed="false">Long Oltesteman long lanwis ya Hibru, tok long ples ya i mekem parabol long fasin we pris i folem taem hem i soemaot we man we i bin gat leprosi i klin bakegen, no man we i bin tajem dedbodi i klin bakegen. Parabol ya i min se man ya i wantem blong God i talemaot we hem i klin bakegen long olgeta sin blong hem. Yu luk Levitikas 14.1-9 mo Namba 19.16-19.</char></note></para>
  <para style="q1" vid="PSA 51:7">Plis yu wasem mi,</para>
  <para style="q2" vid="PSA 51:7">nao bambae mi waet we mi waet</para>
  <para style="q3" vid="PSA 51:7">i winim waet klaod.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Plis yu mekem mi mi harem noes blong olgeta</para>
  <para style="q2" vid="PSA 51:8">we oli glad oli stap singsing.</para>
  <para style="q1" vid="PSA 51:8">Nating we yu yu mekem ol bun blong mi</para>
  <para style="q3" vid="PSA 51:8">oli slak finis,</para>
  <para style="q3" vid="PSA 51:8">be plis yu mekem mi mi harem gud bakegen,</para>
  <para style="q4" vid="PSA 51:8">mi glad.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Plis yu ravemaot olgeta sin blong mi,</para>
  <para style="q2" vid="PSA 51:9">yu no moa lukluk long olgeta.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />God,</para>
  <para style="q2" vid="PSA 51:10">plis yu mekem tingting blong mi</para>
  <para style="q3" vid="PSA 51:10">i klin olgeta.</para>
  <para style="q1" vid="PSA 51:10">Plis yu mekem we hat blong mi</para>
  <para style="q2" vid="PSA 51:10">i kam niuwan bakegen,</para>
  <para style="q3" vid="PSA 51:10">mo i stap strong long yu oltaem.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Plis yu no ronemaot mi</para>
  <para style="q3" vid="PSA 51:11">mi gowe long yu,</para>
  <para style="q2" vid="PSA 51:11">mo yu no tekemaot Tabu Spirit blong yu</para>
  <para style="q4" vid="PSA 51:11">i gowe long mi.<note caller="+" style="f"><char style="fr" closed="false">51.11: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">Plis yu no ronemaot mi mi gowe long yu, mo yu no tekemaot <char style="bd">paoa</char> </char><char style="fqa" closed="false">blong yu i gowe long mi.</char></note><verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Plis yu mekem mi mi glad bakegen</para>
  <para style="q3" vid="PSA 51:12">from we yu yu sevem mi.</para>
  <para style="q1" vid="PSA 51:12">Plis yu mekem mi</para>
  <para style="q4" vid="PSA 51:12">mi wantem blong obei long yu.<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Nao bambae mi tijim ol man nogud</para>
  <para style="q3" vid="PSA 51:13">long ol tok blong yu,</para>
  <para style="q2" vid="PSA 51:13">mo bambae oli kambak long yu.<verse eid="PSA 51:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />God,</para>
  <para style="q2" vid="PSA 51:14">oltaem yu yu stap sevem mi.</para>
  <para style="q1" vid="PSA 51:14">Plis yu letem mi mi go fri,</para>
  <para style="q3" vid="PSA 51:14">mi no ded,</para>
  <para style="q2" vid="PSA 51:14">nao bambae mi glad, mi stap sing</para>
  <para style="q4" vid="PSA 51:14">blong talemaot stret fasin blong yu.<note caller="+" style="f"><char style="fr" closed="false">51.14: </char><char style="ft" closed="false">Narafala rod blong tanem tok blong las haf blong vas ya i olsem. <char style="bd">Mi mi kilim man i ded. Plis yu fogivim mi, yu tekemaot sin blong mi,</char> </char><char style="fqa" closed="false">nao bambae mi glad, mi stap sing blong talemaot stret fasin blong yu.</char></note><verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Masta<note caller="+" style="f"><char style="fr" closed="false">51.15: </char><char style="fqa" closed="false">Masta</char><char style="ft" closed="false">. Yu luk futnot <char style="bd">K</char> long 35.22.</char></note>,</para>
  <para style="q2" vid="PSA 51:15">plis yu givhan long mi</para>
  <para style="q3" vid="PSA 51:15">blong mi save tok,</para>
  <para style="q3" vid="PSA 51:15">nao bambae mi presem yu.<verse eid="PSA 51:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Sipos yu yu wantem sakrefaes ya</para>
  <para style="q3" vid="PSA 51:16">we man i bonem i bon evriwan,</para>
  <para style="q4" vid="PSA 51:16">no sam narafala sakrefaes,</para>
  <para style="q3" vid="PSA 51:16">bambae mi mi glad blong mekem,</para>
  <para style="q2" vid="PSA 51:16">be ol sakrefaes ya oli no save</para>
  <para style="q3" vid="PSA 51:16">mekem yu yu glad.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />God,</para>
  <para style="q2" vid="PSA 51:17">sakrefaes blong mi,</para>
  <para style="q3" vid="PSA 51:17">hemia we tingting blong mi i stap daon.</para>
  <para style="q1" vid="PSA 51:17">Yu yu no save tanem baksaed</para>
  <para style="q2" vid="PSA 51:17">long man we i tanem tingting blong hem</para>
  <para style="q3" vid="PSA 51:17">mo i putum hem i stap daon.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />God, plis yu kaen long Saeon,*</para>
  <para style="q2" vid="PSA 51:18">yu givhan long hem,</para>
  <para style="q3" vid="PSA 51:18">yu stanemap bigfala stonwol blong Jerusalem* bakegen.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Nao bambae yu yu glad long ol sakrefaes</para>
  <para style="q3" vid="PSA 51:19">we man i mekem long stret fasin,</para>
  <para style="q2" vid="PSA 51:19">mo long ol presen blong mifala</para>
  <para style="q4" vid="PSA 51:19">we mifala i bonem i go long yu.</para>
  <para style="q1" vid="PSA 51:19">Bambae mifala i stap bonem ol bul</para>
  <para style="q2" vid="PSA 51:19">long olta blong yu.<note caller="+" style="f"><char style="fr" closed="false">51.19: </char><char style="ft" closed="false">Plante man oli bilif se vas 18 wetem 19, fastaem tufala i no haf blong Sam ya. Maet ol laen blong Isrel we oli go wok slef long Babilon oli joenem Sam ya long tok ya, blong yusum long prea blong olgeta, taem oli stap longwe.</char></note><verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">God bambae i jajem man we i stap mekem trabol</para>
  <para style="sp">(Sing ya, Deved i wokem, biaen long taem ya we man Edom ya Doeg i go talem long Sol we Deved i go finis long haos blong Ahimelek.)</para>
  <para style="sp">(Tok i go long Doeg.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />Strong man blong faet.</para>
  <para style="q2" vid="PSA 52:1">?From wanem yu stap tok flas</para>
  <para style="q2" vid="PSA 52:1">from rabis fasin blong yu?</para>
  <para style="q1" vid="PSA 52:1">Fasin ya blong God</para>
  <para style="q2" vid="PSA 52:1">we oltaem hem i lavem man tumas,</para>
  <para style="q3" vid="PSA 52:1">hem i no save finis.<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Oltaem yu yu stap mekem ol plan</para>
  <para style="q2" vid="PSA 52:2">blong spolem ol narafala man.</para>
  <para style="q1" vid="PSA 52:2">Yu yu wan sapmaot,</para>
  <para style="q2" vid="PSA 52:2">mo oltaem yu stap mekem ol giaman toktok.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Yu yu laekem tumas ol rabis fasin,</para>
  <para style="q3" vid="PSA 52:3">i winim we yu laekem ol gudfala fasin,</para>
  <para style="q2" vid="PSA 52:3">mo yu laekem tumas ol giaman toktok,</para>
  <para style="q4" vid="PSA 52:3">i winim we yu laekem ol trutok.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />!Yu man blong giaman!</para>
  <para style="q1" vid="PSA 52:4">Oltaem yu laekem tumas</para>
  <para style="q2" vid="PSA 52:4">blong spolem ol man</para>
  <para style="q3" vid="PSA 52:4">long ol tok blong yu.<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />God bambae i flatemgud yu,</para>
  <para style="q2" vid="PSA 52:5">we bambae yu no save girap bakegen.</para>
  <para style="q1" vid="PSA 52:5">Hem bambae i kam holem yu</para>
  <para style="q2" vid="PSA 52:5">i pulumaot yu wantaem nomo</para>
  <para style="q3" vid="PSA 52:5">long hom blong yu.</para>
  <para style="q1" vid="PSA 52:5">Hem bambae i tekemaot yu long wol ya,</para>
  <para style="q2" vid="PSA 52:5">nao bambae yu no moa stap wetem ol man.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Bambae ol stret man oli luk, oli fraet,</para>
  <para style="q2" vid="PSA 52:6">nao bambae oli laf long yu.</para>
  <para style="q1" vid="PSA 52:6">Bambae oli talem se,<verse eid="PSA 52:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 52:7" />“!Yufala i luk man ya!</para>
  <para style="q2" vid="PSA 52:7">Hem i no save trastem God</para>
  <para style="q3" vid="PSA 52:7">blong i sevem hem.</para>
  <para style="q2" vid="PSA 52:7">Hem i gat plante samting,</para>
  <para style="q3" vid="PSA 52:7">mo hem i stap putum tingting blong hem</para>
  <para style="q4" vid="PSA 52:7">long olgeta samting ya we hem i gat,</para>
  <para style="q3" vid="PSA 52:7">mo i stap luk long ol rabis fasin ya blong hem</para>
  <para style="q3" vid="PSA 52:7">blong oli mekem hem i stap gud.”<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Be mi mi olsem wan olif</para>
  <para style="q2" vid="PSA 52:8">we i stap gru</para>
  <para style="q3" vid="PSA 52:8">long yad blong haos* blong God.</para>
  <para style="q1" vid="PSA 52:8">Fasin blong God,</para>
  <para style="q2" vid="PSA 52:8">oltaem hem i stap lavem man tumas,</para>
  <para style="q3" vid="PSA 52:8">mo bambae mi mi stap trastem lav ya blong hem</para>
  <para style="q4" vid="PSA 52:8">gogo i no save finis.<verse eid="PSA 52:8" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />God.</para>
  <para style="q1" vid="PSA 52:9">Oltaem bambae mi talem tangkiu long yu</para>
  <para style="q3" vid="PSA 52:9">from ol samting ya we yu yu bin mekem.</para>
  <para style="q1" vid="PSA 52:9">Bambae mi talemaot</para>
  <para style="q2" vid="PSA 52:9">long fes blong ol man blong yu,</para>
  <para style="q3" vid="PSA 52:9">we yu yu gudfala tumas.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">Ol fasin nogud blong man</para>
  <para style="r">(<ref loc="PSA 14">Sam 14</ref>)</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">53.1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:10-12">Rom 3.10-12</ref>
      </char>
    </note>Ol man we oli no gat hed,</para>
  <para style="q2" vid="PSA 53:1">oli stap talem se,</para>
  <para style="q2" vid="PSA 53:1">“I no gat God nating.”</para>
  <para style="q1" vid="PSA 53:1">Olgeta ya evriwan oli rabis man nomo,</para>
  <para style="q2" vid="PSA 53:1">oli stap mekem ol sin nomo</para>
  <para style="q3" vid="PSA 53:1">we i nogud we i nogud.</para>
  <para style="q1" vid="PSA 53:1">I no gat wan long olgeta</para>
  <para style="q2" vid="PSA 53:1">we i stap mekem samting</para>
  <para style="q3" vid="PSA 53:1">we i stret.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />God i stap long heven,</para>
  <para style="q2" vid="PSA 53:2">i stap lukluk i kamdaon long olgeta man</para>
  <para style="q3" vid="PSA 53:2">blong faenemaot se i gat man we i waes,</para>
  <para style="q4" vid="PSA 53:2">we i stap mekem wosip long hem,</para>
  <para style="q3" vid="PSA 53:2">no i no gat.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Be olgeta evriwan oli gorong finis,</para>
  <para style="q2" vid="PSA 53:3">olgeta evriwan oli sem mak nomo,</para>
  <para style="q3" vid="PSA 53:3">oli nogud.</para>
  <para style="q1" vid="PSA 53:3">I no gat wan long olgeta</para>
  <para style="q2" vid="PSA 53:3">we i mekem samting we i gud,</para>
  <para style="q3" vid="PSA 53:3">i no gat wan man nating olsem.<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />God i stap talem se,</para>
  <para style="q2" vid="PSA 53:4">“?Weswe olgeta ya oli no save?</para>
  <para style="q2" vid="PSA 53:4">Ol man ya</para>
  <para style="q3" vid="PSA 53:4">we oli stap mekem ol samting nogud</para>
  <para style="q4" vid="PSA 53:4">oli no gat hed.</para>
  <para style="q2" vid="PSA 53:4">Oli stap laef long ol samting</para>
  <para style="q3" vid="PSA 53:4">we oli stap stilim long ol man blong mi,</para>
  <para style="q4" vid="PSA 53:4">mo oli no save prea long mi tu.”<note caller="+" style="f"><char style="fr" closed="false">53.4: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">?<char style="bd">Weswe</char> </char><char style="fqa" closed="false">olgeta ya oli no save? ?Ol man ya we oli stap mekem ol samting nogud, oli no gat hed? Oli stap laef long ol samting we oli stap stilim long ol man blong <char style="bd">God,</char> </char><char style="fqa" closed="false">mo oli no save prea long <char style="bd">hem</char> </char><char style="fqa" closed="false">tu.</char></note><verse eid="PSA 53:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Be bambae oli fraet we oli fraet,</para>
  <para style="q3" vid="PSA 53:5">we neva oli fraet olsem samtaem.</para>
  <para style="q1" vid="PSA 53:5">God i tanem baksaed long olgeta finis,</para>
  <para style="q2" vid="PSA 53:5">nao yumi ol man blong hem,</para>
  <para style="q3" vid="PSA 53:5">bambae yumi winimgud olgeta.</para>
  <para style="q1" vid="PSA 53:5">Hem bambae i sakem ol bun</para>
  <para style="q2" vid="PSA 53:5">blong ol enemi ya blong yumi</para>
  <para style="q3" vid="PSA 53:5">oli go wanwan olbaot.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 53:6">mo God i God blong yumi.</para>
  <para style="q1" vid="PSA 53:6">Hem i stap long Saeon,*</para>
  <para style="q2" vid="PSA 53:6">mo prea blong mi</para>
  <para style="q3" vid="PSA 53:6">we hem bambae i mekem yumi win.</para>
  <para style="q1" vid="PSA 53:6">Yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 53:6">mo taem hem i mekem yumi gat gudfala laef bakegen,</para>
  <para style="q4" vid="PSA 53:6">bambae yumi glad we yumi glad.<verse eid="PSA 53:6" /></para>
  <para style="b" />
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">Prea we man i mekem blong God i lukaot gud long hem</para>
  <para style="sp">(Sing ya, Deved i wokem, biaen long taem ya we ol man Sif oli go talem long Sol we Deved i stap haed long ples blong olgeta. Sing ya i blong sing wetem stringban.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />God,</para>
  <para style="q2" vid="PSA 54:1">plis yu sevem mi</para>
  <para style="q3" vid="PSA 54:1">long paoa blong yu.</para>
  <para style="q1" vid="PSA 54:1">Long strong han blong yu,</para>
  <para style="q2" vid="PSA 54:1">plis yu mekem mi mi fri.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />Plis yu harem prea blong mi,</para>
  <para style="q3" vid="PSA 54:2">yu lesin long ol tok blong mi.<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Ol praod man oli stap kam</para>
  <para style="q3" vid="PSA 54:3">blong faet long mi,</para>
  <para style="q2" vid="PSA 54:3">ol raf man oli stap traem</para>
  <para style="q4" vid="PSA 54:3">blong kilim mi.</para>
  <para style="q1" vid="PSA 54:3">Olgeta ya oli no kea nating long yu.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Be oltaem God i stap givhan long mi.</para>
  <para style="q1" vid="PSA 54:4">Hem i Masta<note caller="+" style="f"><char style="fr" closed="false">54.4: </char><char style="fqa" closed="false">Masta</char><char style="ft" closed="false">. Yu luk futnot <char style="bd">K</char> long 35.22.</char></note> blong mi,</para>
  <para style="q2" vid="PSA 54:4">mo i stap blokemgud mi.<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Prea blong mi</para>
  <para style="q2" vid="PSA 54:5">we ol rabis fasin</para>
  <para style="q3" vid="PSA 54:5">we ol enemi blong mi oli stap mekem long mi,</para>
  <para style="q2" vid="PSA 54:5">hem bambae i yusum olgeta</para>
  <para style="q4" vid="PSA 54:5">blong panisim olgeta bakegen.</para>
  <para style="q1" vid="PSA 54:5">Hem bambae i spolem olgeta,</para>
  <para style="q2" vid="PSA 54:5">from we tingting blong hem</para>
  <para style="q3" vid="PSA 54:5">i stap strong long mi.<verse eid="PSA 54:5" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Hae God,</para>
  <para style="q2" vid="PSA 54:6">mi bambae mi glad nomo</para>
  <para style="q3" vid="PSA 54:6">blong mekem sakrefaes long yu.</para>
  <para style="q1" vid="PSA 54:6">Bambae mi talem tangkiu long yu</para>
  <para style="q2" vid="PSA 54:6">from we yu yu gud tumas.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Yu yu tekemaot mi</para>
  <para style="q3" vid="PSA 54:7">long olgeta trabol blong mi,</para>
  <para style="q2" vid="PSA 54:7">mo mi luk we ol enemi blong mi oli lus.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">Prea blong man we fren blong hem i spolem hem</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong sing wetem stringban.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />God,</para>
  <para style="q2" vid="PSA 55:1">plis yu harem prea blong mi.</para>
  <para style="q1" vid="PSA 55:1">Sipos mi krae long yu,</para>
  <para style="q2" vid="PSA 55:1">plis yu no tanem baksaed long mi.<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />Yu lesin long mi, yu ansa long mi.</para>
  <para style="q1" vid="PSA 55:2">Mi mi slak olgeta from we mi wari tumas.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />Mi mi fraet tumas</para>
  <para style="q3" vid="PSA 55:3">long ol strong tok blong ol enemi blong mi,</para>
  <para style="q2" vid="PSA 55:3">laef blong mi i foldaon</para>
  <para style="q4" vid="PSA 55:3">from we ol man nogud oli stap spolem mi.</para>
  <para style="q1" vid="PSA 55:3">Oli stap mekem mi mi trabol,</para>
  <para style="q2" vid="PSA 55:3">oli kros long mi we oli no laekem mi nating.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Mi mi fraet we mi fraet,</para>
  <para style="q2" vid="PSA 55:4">mo tingting blong mi i foldaon olgeta</para>
  <para style="q3" vid="PSA 55:4">from we mi fraet long ded.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Mi fraet tumas nao mi seksek from,</para>
  <para style="q3" vid="PSA 55:5">mi harem i nogud we i nogud.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Mi wantem tumas</para>
  <para style="q3" vid="PSA 55:6">se mi gat wing olsem sotleg,*</para>
  <para style="q2" vid="PSA 55:6">nao bambae mi save flae</para>
  <para style="q4" vid="PSA 55:6">blong go faenem ples blong spel.<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Sipos i olsem,</para>
  <para style="q2" vid="PSA 55:7">bambae mi flae i go longwe,</para>
  <para style="q3" vid="PSA 55:7">nao bambae mi mekem ples blong mi</para>
  <para style="q4" vid="PSA 55:7">long draeples.<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Bambae kwiktaem nomo,</para>
  <para style="q2" vid="PSA 55:8">mi save faenem sefples blong mi,</para>
  <para style="q3" vid="PSA 55:8">blong mi save go haed long hem,</para>
  <para style="q4" vid="PSA 55:8">blong bigfala ren mo hariken</para>
  <para style="q3" vid="PSA 55:8">i no save kasem mi.<verse eid="PSA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Masta,*</para>
  <para style="q2" vid="PSA 55:9">plis yu mekem</para>
  <para style="q3" vid="PSA 55:9">ol tok blong ol enemi blong mi</para>
  <para style="q4" vid="PSA 55:9">oli paspas.</para>
  <para style="b" vid="PSA 55:9" />
  <para style="q1" vid="PSA 55:9">Mi mi luk we ol man long taon ya</para>
  <para style="q2" vid="PSA 55:9">oli stap rao mo oli stap faet.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Long dei mo long naet,</para>
  <para style="q2" vid="PSA 55:10">oli stap olbaot long taon ya,</para>
  <para style="q3" vid="PSA 55:10">oli stap mekem ples i fulap gud</para>
  <para style="q4" vid="PSA 55:10">long ol trabol mo ol samting nogud.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Oli stap spolem evri ples.</para>
  <para style="q1" vid="PSA 55:11">Ol rod oli fulap</para>
  <para style="q2" vid="PSA 55:11">long ol man blong spolem man</para>
  <para style="q3" vid="PSA 55:11">mo ol man blong giagiaman blong stil.<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="sp">(Tok blong man ya i go long fren blong hem we i spolem hem.)</para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Sipos i wan enemi we i stap laf long mi,</para>
  <para style="q3" vid="PSA 55:12">bambae mi no save harem nogud from.</para>
  <para style="q1" vid="PSA 55:12">Mo sipos i wan narafala man we i agens long mi,</para>
  <para style="q2" vid="PSA 55:12">we i stap tok flas long mi,</para>
  <para style="q3" vid="PSA 55:12">bambae mi save haed long hem.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Be hemia yu ya,</para>
  <para style="q2" vid="PSA 55:13">we yumitufala i wan nomo,</para>
  <para style="q3" vid="PSA 55:13">we yu wan gudfala fren blong mi.<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />Bifo, yumitufala i stap storian gud oltaem,</para>
  <para style="q2" vid="PSA 55:14">mo yumitufala i stap mekem wosip wanples nomo,</para>
  <para style="q3" vid="PSA 55:14">insaed long haos* blong God.<verse eid="PSA 55:14" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Mi wantem ol enemi blong mi oli ded</para>
  <para style="q3" vid="PSA 55:15">we i no taem blong olgeta yet,</para>
  <para style="q2" vid="PSA 55:15">mi wantem oli go long Hom* blong ol Dedman</para>
  <para style="q4" vid="PSA 55:15">long taem we oli no tingbaot nating blong go.</para>
  <para style="q1" vid="PSA 55:15">Rabis fasin i stap finis</para>
  <para style="q2" vid="PSA 55:15">long hom blong olgeta</para>
  <para style="q3" vid="PSA 55:15">mo long tingting blong olgeta.<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Be Hae God i God blong mi,</para>
  <para style="q2" vid="PSA 55:16">mo mi bambae mi singaot i go long hem</para>
  <para style="q3" vid="PSA 55:16">blong i givhan long mi,</para>
  <para style="q2" vid="PSA 55:16">nao bambae hem i sevem mi.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Long moning mo long medel dei mo long naet,</para>
  <para style="q3" vid="PSA 55:17">ol tok mo ol krae blong mi</para>
  <para style="q3" vid="PSA 55:17">bambae oli stap go antap long hem,</para>
  <para style="q2" vid="PSA 55:17">mo bambae hem i harem voes blong mi.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Mi mi gat plante enemi tumas</para>
  <para style="q3" vid="PSA 55:18">we oli stap agens long mi,</para>
  <para style="q2" vid="PSA 55:18">be sipos mi go blong faet agens long olgeta,</para>
  <para style="q3" vid="PSA 55:18">hem bambae i tekem mi mi kambak</para>
  <para style="q4" vid="PSA 55:18">we mi stap gud nomo.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />God i stap rul bifo olgeta,</para>
  <para style="q3" vid="PSA 55:19">taem we wol i no stap yet,</para>
  <para style="q2" vid="PSA 55:19">mo hem bambae i harem mi.</para>
  <para style="q1" vid="PSA 55:19">Hem bambae i daonem olgeta,</para>
  <para style="q2" vid="PSA 55:19">from we oli no save tanem tingting blong olgeta,</para>
  <para style="q3" vid="PSA 55:19">mo oli no save ona long hem.<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Fren ya blong mi</para>
  <para style="q2" vid="PSA 55:20">i brekem ol promes blong hem,</para>
  <para style="q3" vid="PSA 55:20">nao i kam faet agens long mifala,</para>
  <para style="q4" vid="PSA 55:20">we mifala ol fren blong hem nomo.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Ol tok blong hem i swit,</para>
  <para style="q3" vid="PSA 55:21">i winim suga,</para>
  <para style="q2" vid="PSA 55:21">be long tingting blong hem</para>
  <para style="q3" vid="PSA 55:21">hem i no laekem ol narafala man,</para>
  <para style="q4" vid="PSA 55:21">i agens long olgeta.</para>
  <para style="q1" vid="PSA 55:21">Ol tok blong hem i stap mekem</para>
  <para style="q3" vid="PSA 55:21">tingting blong ol man i kam kwaet,</para>
  <para style="q2" vid="PSA 55:21">be biaen oli luk</para>
  <para style="q3" vid="PSA 55:21">we ol tok ya i strong tumas,</para>
  <para style="q4" vid="PSA 55:21">i spolem olgeta olsem naef blong faet.<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Yufala i mas putum ol trabol blong yufala</para>
  <para style="q3" vid="PSA 55:22">long Hae God,</para>
  <para style="q2" vid="PSA 55:22">nao hem bambae i blokem yufala,</para>
  <para style="q4" vid="PSA 55:22">i sevem yufala.</para>
  <para style="q1" vid="PSA 55:22">Hem i no save letem stret man i lus.<verse eid="PSA 55:22" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />God,</para>
  <para style="q2" vid="PSA 55:23">yu bambae yu sakem ol man blong kilim man</para>
  <para style="q4" vid="PSA 55:23">mo ol man blong giaman</para>
  <para style="q3" vid="PSA 55:23">oli go long beregraon</para>
  <para style="q4" vid="PSA 55:23">we oli yangfala nomo,</para>
  <para style="q3" vid="PSA 55:23">we i no taem blong olgeta yet.</para>
  <para style="q1" vid="PSA 55:23">Be mi bambae mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 55:23">i stap long yu nomo.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">Prea blong man we i trastem God</para>
  <para style="sp">(Sing ya, Deved i wokem, biaen long taem ya we ol man Filistia oli holem hem long taon ya Gat.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 56:1-2" />God, yu yu hae we yu hae. Plis yu sore long mi,</para>
  <para style="q2" vid="PSA 56:1-2">from we ol man we oli stap kam mekem faet long mi</para>
  <para style="q3" vid="PSA 56:1-2">oli plante we plante.</para>
  <para style="q1" vid="PSA 56:1-2">Evri dei nomo oli stap ronem mi,</para>
  <para style="q3" vid="PSA 56:1-2">mo oli stap faet long mi,</para>
  <para style="q4" vid="PSA 56:1-2">i stat long moning</para>
  <para style="q3" vid="PSA 56:1-2">gogo kasem long sapa.</para>
  <para style="q1" vid="PSA 56:1-2">Hae God, yu yu gat olgeta paoa.<verse eid="PSA 56:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Taem mi mi fraet,</para>
  <para style="q2" vid="PSA 56:3">mi putum tingting blong mi i stap long yu.<verse eid="PSA 56:3" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Mi mi trastem Hae God</para>
  <para style="q3" vid="PSA 56:4">nao mi no moa fraet.</para>
  <para style="q1" vid="PSA 56:4">Mi mi presem hem</para>
  <para style="q4" vid="PSA 56:4">from ol promes blong hem.</para>
  <para style="q1" vid="PSA 56:4">I no gat man i save mekem wan samting long mi.<verse eid="PSA 56:4" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />I stat long moning</para>
  <para style="q3" vid="PSA 56:5">gogo kasem long sapa,</para>
  <para style="q2" vid="PSA 56:5">ol enemi blong mi</para>
  <para style="q4" vid="PSA 56:5">oli stap mekem trabol long mi.</para>
  <para style="q1" vid="PSA 56:5">Oltaem oli stap lukaot rod</para>
  <para style="q2" vid="PSA 56:5">blong spolem mi.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Oli stap hivap long ol ples blong haed,</para>
  <para style="q2" vid="PSA 56:6">oli stap wajem mi long olgeta ples</para>
  <para style="q4" vid="PSA 56:6">we mi stap go long hem,</para>
  <para style="q3" vid="PSA 56:6">mo oli stap wet blong kilim mi.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />God,</para>
  <para style="q2" vid="PSA 56:7">plis yu kros long olgeta,</para>
  <para style="q3" vid="PSA 56:7">yu daonem olgeta.</para>
  <para style="q1" vid="PSA 56:7">Plis yu panisim olgeta</para>
  <para style="q2" vid="PSA 56:7">from ol rabis fasin ya blong olgeta.<verse eid="PSA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Yu yu savegud ol trabol blong mi,</para>
  <para style="q2" vid="PSA 56:8">mo olgeta taem ya we mi stap krae,</para>
  <para style="q3" vid="PSA 56:8">yu yu makemdaon olgeta finis</para>
  <para style="q4" vid="PSA 56:8">long buk blong yu.<verse eid="PSA 56:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9-10" style="v" sid="PSA 56:9-10" />Hae God,</para>
  <para style="q2" vid="PSA 56:9-10">long dei we bambae mi singaot long yu,</para>
  <para style="q3" vid="PSA 56:9-10">yu bambae yu mekem</para>
  <para style="q4" vid="PSA 56:9-10">ol enemi blong mi oli tanemraon,</para>
  <para style="q3" vid="PSA 56:9-10">oli gobak.</para>
  <para style="q1" vid="PSA 56:9-10">Mi mi save samting ya finis,</para>
  <para style="q2" vid="PSA 56:9-10">from we yu yu stap long saed blong mi.</para>
  <para style="q1" vid="PSA 56:9-10">Mi mi stap presem yu</para>
  <para style="q2" vid="PSA 56:9-10">from ol promes blong yu.<verse eid="PSA 56:9-10" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Mi mi trastem Hae God,</para>
  <para style="q2" vid="PSA 56:11">nao bambae mi no save fraet.</para>
  <para style="q1" vid="PSA 56:11">I no gat man i save mekem wan samting long mi.<verse eid="PSA 56:11" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />God,</para>
  <para style="q2" vid="PSA 56:12">bambae mi givim olgeta samting ya long yu</para>
  <para style="q3" vid="PSA 56:12">we mi bin promes blong givim.</para>
  <para style="q1" vid="PSA 56:12">Bambae mi givim presen blong mi long yu</para>
  <para style="q3" vid="PSA 56:12">blong talem tangkiu long yu<verse eid="PSA 56:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 56:13" />from we yu yu sevem mi</para>
  <para style="q3" vid="PSA 56:13">nao mi no ded,</para>
  <para style="q4" vid="PSA 56:13">mo yu no letem mi mi lus.</para>
  <para style="q1" vid="PSA 56:13">Nao bambae mi mi stap wokbaot wetem yu,</para>
  <para style="q2" vid="PSA 56:13">long laet ya we i stap saen long olgeta</para>
  <para style="q3" vid="PSA 56:13">we oli gat laef.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">Prea we man i mekem blong bambae God i givhan long hem</para>
  <para style="r">(<ref loc="PSA 108:1-5">Sam 108.1-5</ref>)</para>
  <para style="sp">(Sing ya, Deved i wokem, biaen long taem ya we hem i ronwe long Sol, i go haed long hol blong ston.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />God,</para>
  <para style="q2" vid="PSA 57:1">yu sore long mi.</para>
  <para style="q1" vid="PSA 57:1">Plis yu sore long mi</para>
  <para style="q3" vid="PSA 57:1">from we mi mi stap long bigfala trabol</para>
  <para style="q4" vid="PSA 57:1">we i olsem hariken.</para>
  <para style="q1" vid="PSA 57:1">Mi mi kam blong haed long yu,</para>
  <para style="q2" vid="PSA 57:1">blong yu blokem mi mi stap gud</para>
  <para style="q3" vid="PSA 57:1">olsem we pikinini blong faol i stap gud</para>
  <para style="q4" vid="PSA 57:1">aninit long wing blong mama blong hem,</para>
  <para style="q3" vid="PSA 57:1">nao bambae mi save stap gud <optbreak /> gogo kasem we trabol ya i finis.<verse eid="PSA 57:1" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />God, hem i hae we i hae.</para>
  <para style="q1" vid="PSA 57:2">Mi mi stap singaot i go long hem,</para>
  <para style="q2" vid="PSA 57:2">from we hem i stap givim evri samting long mi</para>
  <para style="q2" vid="PSA 57:2">we mi mi sot long hem.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Hem i stap long heven,</para>
  <para style="q2" vid="PSA 57:3">mo bambae hem i harem krae blong mi,</para>
  <para style="q3" vid="PSA 57:3">i sevem mi.</para>
  <para style="q1" vid="PSA 57:3">Bambae hem i mekem</para>
  <para style="q2" vid="PSA 57:3">olgeta we oli stap mekem i strong tumas long mi oli sem.</para>
  <para style="q1" vid="PSA 57:3">Hem bambae i soemaot long mi</para>
  <para style="q2" vid="PSA 57:3">we oltaem hem i lavem mi tumas,</para>
  <para style="q3" vid="PSA 57:3">mo we tingting blong hem</para>
  <para style="q4" vid="PSA 57:3">i stap strong long mi.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Ol enemi blong mi</para>
  <para style="q3" vid="PSA 57:4">we oli stap raonem mi</para>
  <para style="q2" vid="PSA 57:4">oli olsem ol laeon ya</para>
  <para style="q4" vid="PSA 57:4">we oli stap kakae man,</para>
  <para style="q3" vid="PSA 57:4">we tut blong olgeta</para>
  <para style="q3" vid="PSA 57:4">oli longfala olsem spia mo ara,</para>
  <para style="q4" vid="PSA 57:4">mo tang blong olgeta <optbreak /> i olsem naef blong faet we i sap we i sap.<verse eid="PSA 57:4" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />God.</para>
  <para style="q1" vid="PSA 57:5">Mi mi wantem tumas</para>
  <para style="q2" vid="PSA 57:5">blong yu yu soemaot</para>
  <para style="q3" vid="PSA 57:5">we yu yu hae we yu hae</para>
  <para style="q3" vid="PSA 57:5">i bitim skae,</para>
  <para style="q4" vid="PSA 57:5">mo we bigfala paoa blong yu <optbreak /> i kasem olgeta ples long wol.<note caller="+" style="f"><char style="fr" closed="false">57.5: </char><char style="ft" closed="false">Narafala rod blong tanem tok long las haf blong vas ya i olsem. </char><char style="fqa" closed="false">Mi mi wantem tumas blong <char style="bd">ol man bambae oli leftemap nem blong yu i go antap</char> </char><char style="fqa" closed="false">i bitim skae, mo <char style="bd">blong yu bambae yu soemaot</char> </char><char style="fqa" closed="false">bigfala paoa blong yu <char style="bd">long</char> </char><char style="fqa" closed="false">olgeta ples long wol.</char></note><verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Ol enemi blong mi oli putum net finis</para>
  <para style="q3" vid="PSA 57:6">blong kasem mi,</para>
  <para style="q2" vid="PSA 57:6">nao mi mi harem i nogud we i nogud.</para>
  <para style="q1" vid="PSA 57:6">Oli digim wan hol long rod blong mi,</para>
  <para style="q2" vid="PSA 57:6">be olgeta nomo oli foldaon long hem bakegen.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />God.</para>
  <para style="q1" vid="PSA 57:7">!Oltaem tingting blong mi i stap strong long yu!</para>
  <para style="q2" vid="PSA 57:7">!Bambae mi sing, mi presem yu!<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />!Naoia mi mi mas wekap!</para>
  <para style="q1" vid="PSA 57:8">!Gita mo mandolin blong mi,</para>
  <para style="q2" vid="PSA 57:8">tufala i mas wekap!</para>
  <para style="q1" vid="PSA 57:8">!Bambae mi wekemap san ya!<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Masta<note caller="+" style="f"><char style="fr" closed="false">57.9 </char><char style="fqa" closed="false">Masta</char><char style="ft" closed="false">. Yu luk futnot <char style="bd">K</char> long 35.22.</char></note>,</para>
  <para style="q2" vid="PSA 57:9">bambae mi mi talem tangkiu long yu</para>
  <para style="q4" vid="PSA 57:9">long fes blong olgeta man,</para>
  <para style="q3" vid="PSA 57:9">bambae mi sing blong presem yu</para>
  <para style="q3" vid="PSA 57:9">long fes blong ol man blong ol narafala kantri.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Fasin ya blong yu</para>
  <para style="q2" vid="PSA 57:10">we oltaem yu lavem man tumas,</para>
  <para style="q3" vid="PSA 57:10">hem i hae we i hae,</para>
  <para style="q4" vid="PSA 57:10">i go kasem skae.</para>
  <para style="q1" vid="PSA 57:10">Fasin blong yu</para>
  <para style="q2" vid="PSA 57:10">we oltaem yu stap holem ol promes blong yu,</para>
  <para style="q3" vid="PSA 57:10">hem i hae tumas,</para>
  <para style="q4" vid="PSA 57:10">i go antap i kasem ol klaod.<verse eid="PSA 57:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />God.</para>
  <para style="q1" vid="PSA 57:11">Mi mi wantem tumas</para>
  <para style="q2" vid="PSA 57:11">blong yu yu soemaot</para>
  <para style="q3" vid="PSA 57:11">we yu yu hae we yu hae</para>
  <para style="q3" vid="PSA 57:11">i bitim skae,</para>
  <para style="q4" vid="PSA 57:11">mo we bigfala paoa blong yu</para>
  <para style="q1" vid="PSA 57:11">i kasem olgeta ples long wol. <char style="ord">E</char><verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">Prea we man i mekem blong God i panisim ol man nogud</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol haeman.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Ol haeman.<note caller="+" style="f"><char style="fr" closed="false">58.1: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">!Ol <char style="bd">narafala god</char>!</char></note></para>
  <para style="q1" vid="PSA 58:1">?I tru se yufala i stap jajem man</para>
  <para style="q2" vid="PSA 58:1">long stret fasin?</para>
  <para style="q1" vid="PSA 58:1">?Yufala i stap jajem ol man</para>
  <para style="q2" vid="PSA 58:1">long rod we i stret?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />!Nogat!</para>
  <para style="q1" vid="PSA 58:2">Yufala i stap tingbaot nomo</para>
  <para style="q3" vid="PSA 58:2">ol rabis fasin we yufala i save mekem,</para>
  <para style="q2" vid="PSA 58:2">mo yufala i stap mekem ol strong fasin nomo</para>
  <para style="q4" vid="PSA 58:2">blong spolem ol man long wol.<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Ol man nogud oli stap gorong oltaem,</para>
  <para style="q2" vid="PSA 58:3">i stat long taem we oli stap</para>
  <para style="q3" vid="PSA 58:3">long bel blong mama blong olgeta.</para>
  <para style="q1" vid="PSA 58:3">Oli stap talem ol giaman tok,</para>
  <para style="q3" vid="PSA 58:3">i stat taem oli bon.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Oli olsem ol posen snek</para>
  <para style="q3" vid="PSA 58:4">we posen blong olgeta i strong tumas,</para>
  <para style="q2" vid="PSA 58:4">mo oli stap blokem sora blong olgeta</para>
  <para style="q3" vid="PSA 58:4">olsem posen snek ya</para>
  <para style="q4" vid="PSA 58:4">we sora blong hem i fas,<verse eid="PSA 58:4" /></para>
  <para style="q4">
    <verse number="5" style="v" sid="PSA 58:5" />we i no save harem <optbreak /> voes blong man blong pleplei long snek, <optbreak /> mo i no save harem</para>
  <para style="q4" vid="PSA 58:5">singsing blong kleva.<verse eid="PSA 58:5" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />God,</para>
  <para style="q2" vid="PSA 58:6">plis yu brekem ol tut blong ol laeon ya.</para>
  <para style="q1" vid="PSA 58:6">Hae God,</para>
  <para style="q2" vid="PSA 58:6">plis yu pulumaot ol tut blong olgeta.<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Yu letem olgeta oli lus olsem wota</para>
  <para style="q3" vid="PSA 58:7">we i kafsaed i go long sanbij,</para>
  <para style="q2" vid="PSA 58:7">yu flatemdaon olgeta olsem gras long rod,</para>
  <para style="q3" vid="PSA 58:7">we ol man oli stap purumbut long hem</para>
  <para style="q4" vid="PSA 58:7">nao i drae.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Plis yu letem olgeta oli kam olsem snel</para>
  <para style="q2" vid="PSA 58:8">we wota blong hem i ronaot,</para>
  <para style="q3" vid="PSA 58:8">nao i ded.</para>
  <para style="q1" vid="PSA 58:8">Yu mekem olgeta oli kam olsem pikinini</para>
  <para style="q2" vid="PSA 58:8">we i ded taem i bon,</para>
  <para style="q3" vid="PSA 58:8">we i no save luk delaet.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />God,</para>
  <para style="q2" vid="PSA 58:9">taem oli no gat save yet</para>
  <para style="q3" vid="PSA 58:9">plis yu katemdaon olgeta</para>
  <para style="q4" vid="PSA 58:9">olsem ol rabis gras nomo.</para>
  <para style="q1" vid="PSA 58:9">Taem oli laef yet,</para>
  <para style="q2" vid="PSA 58:9">plis yu kros,</para>
  <para style="q3" vid="PSA 58:9">yu blu long olgeta blong oli gowe.<verse eid="PSA 58:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Bambae ol stret man oli glad</para>
  <para style="q2" vid="PSA 58:10">taem oli luk</para>
  <para style="q3" vid="PSA 58:10">we yu yu panisim ol man nogud.</para>
  <para style="q1" vid="PSA 58:10">Bambae oli stap wokbaot nomo</para>
  <para style="q2" vid="PSA 58:10">long blad blong ol man nogud ya.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />Nao ol man bambae oli talem se,</para>
  <para style="q2" vid="PSA 58:11">“Tru, God i stap.</para>
  <para style="q2" vid="PSA 58:11">Hem i stap givim pei long ol stret man.</para>
  <para style="q2" vid="PSA 58:11">Hem i stap jajem olgeta man long wol.”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">Prea we man i mekem blong God i sevem hem</para>
  <para style="sp">(Sing ya, Deved i wokem, biaen long taem ya we Sol i sanem ol man blong hem oli go blong wajem haos blong Deved blong oli kilim hem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />God blong mi.</para>
  <para style="q1" vid="PSA 59:1">Plis yu sevem mi,</para>
  <para style="q2" vid="PSA 59:1">blong ol enemi blong mi oli no spolem mi.</para>
  <para style="q1" vid="PSA 59:1">Sipos oli kam blong faet long mi,</para>
  <para style="q2" vid="PSA 59:1">plis yu blokem mi.<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Olgeta ya oli man nogud,</para>
  <para style="q2" vid="PSA 59:2">oli man blong kilim man.</para>
  <para style="q1" vid="PSA 59:2">Plis yu tekemaot mi long han blong olgeta,</para>
  <para style="q2" vid="PSA 59:2">yu sevem mi.<verse eid="PSA 59:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3-4" style="v" sid="PSA 59:3-4" />!Hae God, yu luk!</para>
  <para style="q1" vid="PSA 59:3-4">Ol rabis man ya oli stap go wanples,</para>
  <para style="q2" vid="PSA 59:3-4">oli agens long mi,</para>
  <para style="q3" vid="PSA 59:3-4">nao oli stap wet blong kilim mi.</para>
  <para style="q1" vid="PSA 59:3-4">Olgeta oli ron kwik</para>
  <para style="q3" vid="PSA 59:3-4">blong mekemrere blong faet,</para>
  <para style="q2" vid="PSA 59:3-4">be i no from wan rong blong mi,</para>
  <para style="q3" vid="PSA 59:3-4">i no from wan samting nogud</para>
  <para style="q4" vid="PSA 59:3-4">we mi mi mekem.<verse eid="PSA 59:3-4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />Hae God, yu yu gat olgeta paoa,</para>
  <para style="q2" vid="PSA 59:5">mo yu God blong mifala ol laen* blong Isrel.*</para>
  <para style="q1" vid="PSA 59:5">Plis yu wekap,</para>
  <para style="q2" vid="PSA 59:5">yu kam givhan long mi,</para>
  <para style="q3" vid="PSA 59:5">yu panisim ol hiten man ya.</para>
  <para style="q1" vid="PSA 59:5">Yu no mas sore long ol man nogud ya</para>
  <para style="q2" vid="PSA 59:5">we oli stap spolem ol fren blong olgeta.<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Oltaem, taem i tudak,</para>
  <para style="q2" vid="PSA 59:6">oli stap kambak long mi bakegen,</para>
  <para style="q3" vid="PSA 59:6">oli stap krae olsem ol dog</para>
  <para style="q4" vid="PSA 59:6">we oli stap go olbaot long taon.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Yu lesin long ol strong tok</para>
  <para style="q2" vid="PSA 59:7">mo ol rabis tok ya</para>
  <para style="q3" vid="PSA 59:7">we oli stap sakem i kam long mi.</para>
  <para style="q1" vid="PSA 59:7">Taem oli tok,</para>
  <para style="q2" vid="PSA 59:7">tok blong olgeta i olsem naef blong</para>
  <para style="q3" vid="PSA 59:7">faet we i sap we i sap.</para>
  <para style="q1" vid="PSA 59:7">Be oli ting se i no gat man</para>
  <para style="q2" vid="PSA 59:7">i stap harem olgeta.<verse eid="PSA 59:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Be Hae God,</para>
  <para style="q2" vid="PSA 59:8">yu yu stap laf nomo long olgeta.</para>
  <para style="q1" vid="PSA 59:8">Yu yu stap laf long olgeta hiten man.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />God,</para>
  <para style="q2" vid="PSA 59:9">mi mi trastem paoa blong yu oltaem.</para>
  <para style="q1" vid="PSA 59:9">Yu nomo yu sefples blong mi.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />God blong mi,</para>
  <para style="q2" vid="PSA 59:10">yu yu lavem mi,</para>
  <para style="q3" vid="PSA 59:10">mo bambae yu kam stap wetem mi.</para>
  <para style="q1" vid="PSA 59:10">Yu bambae yu letem mi mi luk</para>
  <para style="q2" vid="PSA 59:10">we yu winim ol enemi blong mi.<verse eid="PSA 59:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />God, yu yu Masta* blong mifala,</para>
  <para style="q2" vid="PSA 59:11">yu stap blokemgud mifala.</para>
  <para style="q1" vid="PSA 59:11">Plis yu no kilim olgeta.</para>
  <para style="q1" vid="PSA 59:11">I nogud</para>
  <para style="q2" vid="PSA 59:11">ol man blong mi oli fogetem olgeta.</para>
  <para style="q1" vid="PSA 59:11">Plis yu yusum paoa blong yu,</para>
  <para style="q2" vid="PSA 59:11">yu mekem olgeta oli lus,</para>
  <para style="q3" vid="PSA 59:11">oli ron wanwan.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12-13" style="v" sid="PSA 59:12-13" />Sin i stap long maot blong olgeta,</para>
  <para style="q2" vid="PSA 59:12-13">ol tok blong olgeta i nogud.</para>
  <para style="q1" vid="PSA 59:12-13">I gud yu mekem</para>
  <para style="q2" vid="PSA 59:12-13">we praod blong olgeta</para>
  <para style="q3" vid="PSA 59:12-13">i spolem olgeta bakegen.</para>
  <para style="q1" vid="PSA 59:12-13">I gud yu kros,</para>
  <para style="q2" vid="PSA 59:12-13">yu spolem olgeta</para>
  <para style="q4" vid="PSA 59:12-13">we yu spolemgud olgeta</para>
  <para style="q3" vid="PSA 59:12-13">from we oli stap singaot* trabol i kam long mifala,</para>
  <para style="q4" vid="PSA 59:12-13">mo oli stap giaman.</para>
  <para style="q1" vid="PSA 59:12-13">Nao bambae olgeta man oli save</para>
  <para style="q2" vid="PSA 59:12-13">we yu yu stap rul long Isrel,</para>
  <para style="q3" vid="PSA 59:12-13">mo paoa blong yu i go kasem olgeta ples long wol.<verse eid="PSA 59:12-13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Oltaem, taem i tudak,</para>
  <para style="q2" vid="PSA 59:14">ol enemi blong mi</para>
  <para style="q4" vid="PSA 59:14">oli stap kambak long mi,</para>
  <para style="q3" vid="PSA 59:14">oli stap go olbaot long taon,</para>
  <para style="q3" vid="PSA 59:14">oli stap krae olsem dog.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Oli olsem ol dog</para>
  <para style="q2" vid="PSA 59:15">we oli stap go olbaot blong lukaot kakae,</para>
  <para style="q3" vid="PSA 59:15">mo sipos kakae i no naf,</para>
  <para style="q4" vid="PSA 59:15">oli stap kros.<verse eid="PSA 59:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Be mi bambae mi stap sing</para>
  <para style="q2" vid="PSA 59:16">blong talemaot paoa blong yu.</para>
  <para style="q1" vid="PSA 59:16">Evri moning bambae mi stap sing bigwan</para>
  <para style="q2" vid="PSA 59:16">blong talemaot we oltaem yu yu lavem man.</para>
  <para style="q1" vid="PSA 59:16">Oltaem yu yu strong ples blong haed blong mi,</para>
  <para style="q2" vid="PSA 59:16">yu yu sefples blong mi</para>
  <para style="q4" vid="PSA 59:16">long taem blong trabol.<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />God,</para>
  <para style="q2" vid="PSA 59:17">oltaem yu yu lavem mi.</para>
  <para style="q1" vid="PSA 59:17">Yu yu sefples blong mi,</para>
  <para style="q2" vid="PSA 59:17">mo yu stap blokemgud mi.</para>
  <para style="q1" vid="PSA 59:17">Oltaem bambae mi mi stap presem yu.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">Prea blong ol man we oli lus long faet</para>
  <para style="r">(<ref loc="PSA 108:6-13">Sam 108.6-13</ref>)</para>
  <para style="sp">(Sing ya, Deved i wokem blong tijim ol man. Hem i mekem long taem ya we hem i faet agens long ol man Aram we oli kamaot long Naharaem mo Joba. Hemia long semtaem ya we Joab wetem ol soldia blong hem oli tanemraon oli gobak long bigfala levelples ya we nem blong hem “Ples blong Tekem Sol”, nao oli kilim twelef taosen man Edom oli ded long ples ya.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />God,</para>
  <para style="q2" vid="PSA 60:1">bifo, yu yu lego mifala,</para>
  <para style="q3" vid="PSA 60:1">yu mekem we mifala i lus long faet.</para>
  <para style="q1" vid="PSA 60:1">Bifo, yu yu kros long mifala,</para>
  <para style="q2" vid="PSA 60:1">be naoia,</para>
  <para style="q3" vid="PSA 60:1">plis yu kambak long mifala bakegen.<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Bifo, yu yu mekem graon i seksek,</para>
  <para style="q2" vid="PSA 60:2">nao i brok i open bigwan.</para>
  <para style="q1" vid="PSA 60:2">Naoia, plis yu mekem i gud bakegen,</para>
  <para style="q2" vid="PSA 60:2">from we hem i stap folfoldaon yet.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Mifala ol man blong yu,</para>
  <para style="q2" vid="PSA 60:3">be yu mekem we mifala i harem nogud tumas,</para>
  <para style="q3" vid="PSA 60:3">mifala i stap wokbaot krangke,</para>
  <para style="q4" vid="PSA 60:3">olsem we mifala i drong.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Mifala i stap ona long yu,</para>
  <para style="q2" vid="PSA 60:4">nao yu givim saen long mifala</para>
  <para style="q3" vid="PSA 60:4">blong mifala i ronwe,</para>
  <para style="q4" vid="PSA 60:4">trabol i no kasem mifala.<verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Yu yu lavem mifala tumas.</para>
  <para style="q1" vid="PSA 60:5">Plis yu sevem mifala long paoa blong yu,</para>
  <para style="q2" vid="PSA 60:5">yu ansa long prea blong mifala,</para>
  <para style="q4" vid="PSA 60:5">blong mifala i save stap gud.<verse eid="PSA 60:5" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Olgeta.</para>
  <para style="q2" vid="PSA 60:6">God i stap long tabu ples blong hem,</para>
  <para style="q2" vid="PSA 60:6">i talem se, “Bambae mi mi win,</para>
  <para style="q3" vid="PSA 60:6">nao mi seraot ples ya Sekem</para>
  <para style="q3" vid="PSA 60:6">i go long ol man blong mi,</para>
  <para style="q4" vid="PSA 60:6">mo bambae mi makemaot ol haf <optbreak /> blong bigfala levelples ya Sukot</para>
  <para style="q3" vid="PSA 60:6">i go long olgeta.<verse eid="PSA 60:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 60:7" />Ples ya Gilead i blong mi,</para>
  <para style="q3" vid="PSA 60:7">mo ples ya Manase* tu i blong mi,</para>
  <para style="q2" vid="PSA 60:7">Ples ya Efrem* i olsem hat blong faet blong mi,</para>
  <para style="q3" vid="PSA 60:7">mo ples ya Juda* i olsem wokingstik blong mi</para>
  <para style="q3" vid="PSA 60:7">we mi mi King.<verse eid="PSA 60:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 60:8" />Be bambae mi yusum kantri ya Moab</para>
  <para style="q3" vid="PSA 60:8">olsem besin blong wasem fes blong mi,</para>
  <para style="q4" vid="PSA 60:8">mo bambae mi sakem sus blong mi</para>
  <para style="q3" vid="PSA 60:8">i go stap long kantri ya Edom, <optbreak /> olsem saen we ples ya i blong mi.</para>
  <para style="q2" vid="PSA 60:8">Mi mi winim ol man Filistia</para>
  <para style="q3" vid="PSA 60:8">nao mi singsingaot from.”<verse eid="PSA 60:8" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />God.</para>
  <para style="q2" vid="PSA 60:9">?Hu nao bambae i lidim mifala</para>
  <para style="q3" vid="PSA 60:9">i go long kantri ya Edom?</para>
  <para style="q2" vid="PSA 60:9">?Hu nao bambae i tekem mifala i go insaed</para>
  <para style="q3" vid="PSA 60:9">long taon ya blong olgeta</para>
  <para style="q4" vid="PSA 60:9">we i strong tumas?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />?Olsem wanem?</para>
  <para style="q1" vid="PSA 60:10">?I tru we yu yu lego mifala finis?</para>
  <para style="q1" vid="PSA 60:10">?Bambae yu no moa go</para>
  <para style="q2" vid="PSA 60:10">wetem ol soldia blong mifala</para>
  <para style="q3" vid="PSA 60:10">bakegen long faet?<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Plis yu halpem mifala,</para>
  <para style="q3" vid="PSA 60:11">yu agensem ol enemi blong mifala,</para>
  <para style="q2" vid="PSA 60:11">from we ol samting</para>
  <para style="q3" vid="PSA 60:11">we ol man nomo oli save mekem</para>
  <para style="q4" vid="PSA 60:11">blong givhan long mifala</para>
  <para style="q3" vid="PSA 60:11">i blong nating nomo.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />God,</para>
  <para style="q2" vid="PSA 60:12">sipos yu yu stap wetem mifala,</para>
  <para style="q3" vid="PSA 60:12">bambae mifala i wi n,</para>
  <para style="q2" vid="PSA 60:12">from we yu bambae yu winim ol enemi blong mifala.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">Prea blong man we i stap afsaed long kantri blong hem mo i no save gobak</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong sing wetem stringban.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />God.</para>
  <para style="q1" vid="PSA 61:1">Plis yu harem krae blong mi,</para>
  <para style="q3" vid="PSA 61:1">yu lesin long prea blong mi.<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Mi mi stap longwe tumas long ples blong mi,</para>
  <para style="q2" vid="PSA 61:2">tingting blong mi i foldaon,</para>
  <para style="q3" vid="PSA 61:2">nao mi stap singaot long yu.</para>
  <para style="b" vid="PSA 61:2" />
  <para style="q1" vid="PSA 61:2">Plis yu tekem mi mi go</para>
  <para style="q3" vid="PSA 61:2">long wan strong ples blong haed,<verse eid="PSA 61:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 61:3" />from we oltaem,</para>
  <para style="q3" vid="PSA 61:3">yu yu stap lukaot gud long mi,</para>
  <para style="q4" vid="PSA 61:3">yu stap blokem ol enemi blong mi.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Plis yu letem mi mi stap</para>
  <para style="q2" vid="PSA 61:4">long tabu ples blong yu</para>
  <para style="q3" vid="PSA 61:4">oltaem long laef blong mi,</para>
  <para style="q2" vid="PSA 61:4">yu letem mi mi faenem sefples long yu,</para>
  <para style="q3" vid="PSA 61:4">olsem we pikinini blong faol i faenem sefples</para>
  <para style="q4" vid="PSA 61:4">aninit long wing blong mama blong hem.<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />God,</para>
  <para style="q3" vid="PSA 61:5">yu yu harem ol promes blong mi finis,</para>
  <para style="q2" vid="PSA 61:5">mo ol samting ya we i blong man</para>
  <para style="q3" vid="PSA 61:5">we i ona long yu,</para>
  <para style="q4" vid="PSA 61:5">yu yu givim long mi finis.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Plis yu mekem</para>
  <para style="q2" vid="PSA 61:6">we king blong mifala i gat longfala laef,</para>
  <para style="q3" vid="PSA 61:6">mo yu letem hem i stap longtaem we longtaem.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />God.</para>
  <para style="q1" vid="PSA 61:7">Prea blong mi,</para>
  <para style="q2" vid="PSA 61:7">we bambae hem i rul long fes blong yu</para>
  <para style="q3" vid="PSA 61:7">oltaem long laef blong hem,</para>
  <para style="q2" vid="PSA 61:7">mo we oltaem bambae yu yu lavem hem tumas,</para>
  <para style="q4" vid="PSA 61:7">tingting blong yu i stap strong long hem,</para>
  <para style="q3" vid="PSA 61:7">nao bambae yu stap lukaot gud long hem,</para>
  <para style="q3" vid="PSA 61:7">yu blokemgud hem.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Evri dei,</para>
  <para style="q2" vid="PSA 61:8">bambae mi stap givim ol samting ya long yu</para>
  <para style="q3" vid="PSA 61:8">we mi promes blong givim,</para>
  <para style="q2" vid="PSA 61:8">mo oltaem,</para>
  <para style="q4" vid="PSA 61:8">bambae mi sing blong presem yu.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">Man i talemaot we hem i trastem God oltaem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />Oltaem mi mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 62:1">i stap long God nomo,</para>
  <para style="q2" vid="PSA 62:1">nao mi save mekem tingting blong mi i longfala,</para>
  <para style="q3" vid="PSA 62:1">mi save wet longtaem</para>
  <para style="q4" vid="PSA 62:1">blong hem i sevem mi.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Hem nomo i stap blokemgud mi</para>
  <para style="q2" vid="PSA 62:2">blong trabol i no kasem mi,</para>
  <para style="q3" vid="PSA 62:2">mo hem i stap sevem mi.</para>
  <para style="q1" vid="PSA 62:2">Hem i strong ples blong haed blong mi,</para>
  <para style="q2" vid="PSA 62:2">mo neva bambae ol enemi blong mi</para>
  <para style="q3" vid="PSA 62:2">oli save winim mi.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Mi mi no strong,</para>
  <para style="q2" vid="PSA 62:3">mi olsem fenis we i roten finis,</para>
  <para style="q3" vid="PSA 62:3">i stap folfoldaon.</para>
  <para style="q1" vid="PSA 62:3">?Bambae yufala evriwan i stap kam faet long mi</para>
  <para style="q2" vid="PSA 62:3">gogo kasem wetaem?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />?Ating yufala i wantem nomo</para>
  <para style="q2" vid="PSA 62:4">blong mekem mi mi foldaon,</para>
  <para style="q3" vid="PSA 62:4">mi lusum hae nem blong mi?</para>
  <para style="q1" vid="PSA 62:4">Yufala i stap glad nomo</para>
  <para style="q2" vid="PSA 62:4">blong talem ol giaman toktok.</para>
  <para style="q1" vid="PSA 62:4">Yufala i stap talem ol tok</para>
  <para style="q3" vid="PSA 62:4">blong mekem man i harem gud,</para>
  <para style="q2" vid="PSA 62:4">be long tingting blong yufala,</para>
  <para style="q3" vid="PSA 62:4">yufala i stap singaot* trabol</para>
  <para style="q4" vid="PSA 62:4">i kam long hem.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Oltaem mi mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 62:5">i stap long God nomo,</para>
  <para style="q2" vid="PSA 62:5">nao mi save mekem tingting blong mi i longfala,</para>
  <para style="q3" vid="PSA 62:5">mi save wet longtaem long hem,</para>
  <para style="q4" vid="PSA 62:5">blong kasem ol samting</para>
  <para style="q3" vid="PSA 62:5">we tingting blong mi i stap long hem.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />Hem nomo i stap blokem mi</para>
  <para style="q2" vid="PSA 62:6">blong trabol i no kasem mi,</para>
  <para style="q3" vid="PSA 62:6">mo i stap sevem mi.</para>
  <para style="q1" vid="PSA 62:6">Hem i strong ples blong haed blong mi,</para>
  <para style="q2" vid="PSA 62:6">mo neva bambae ol enemi blong mi</para>
  <para style="q3" vid="PSA 62:6">oli save winim mi.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Mi mi stap luk long God nomo</para>
  <para style="q3" vid="PSA 62:7">blong hem i sevem mi,</para>
  <para style="q2" vid="PSA 62:7">mo blong hem i holem</para>
  <para style="q4" vid="PSA 62:7">hae nem blong mi i stap gud.</para>
  <para style="q1" vid="PSA 62:7">Hem nao i strong ples blong blokem mi,</para>
  <para style="q2" vid="PSA 62:7">hem i sefples blong mi.<verse eid="PSA 62:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Olgeta.</para>
  <para style="q1" vid="PSA 62:8">God i sefples blong yumi.</para>
  <para style="q1" vid="PSA 62:8">I gud yufala i trastem hem oltaem,</para>
  <para style="q2" vid="PSA 62:8">yufala i talemaot ol trabol blong yufala long hem.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Olgeta man oli olsem smol win nomo</para>
  <para style="q2" vid="PSA 62:9">we i blu wantaem,</para>
  <para style="q3" vid="PSA 62:9">nao i finis.</para>
  <para style="q1" vid="PSA 62:9">Ol haeman mo ol man olbaot nomo,</para>
  <para style="q2" vid="PSA 62:9">olgeta evriwan i sem mak,</para>
  <para style="q3" vid="PSA 62:9">oli olsem nating nomo.</para>
  <para style="q1" vid="PSA 62:9">Sipos yu putum olgeta long skel,</para>
  <para style="q2" vid="PSA 62:9">oli no hevi nating,</para>
  <para style="q3" vid="PSA 62:9">oli olsem win nomo.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Yufala i no trastem</para>
  <para style="q2" vid="PSA 62:10">ol strong fasin ya blong stil</para>
  <para style="q3" vid="PSA 62:10">blong yufala i kam rijman.</para>
  <para style="q1" vid="PSA 62:10">Yufala i no putum tingting blong</para>
  <para style="q2" vid="PSA 62:10">yufala long rod blong stil.</para>
  <para style="q1" vid="PSA 62:10">Mo sipos olting blong yufala i stap kam plante,</para>
  <para style="q2" vid="PSA 62:10">be yufala i no mas trastem ol samting ya.<verse eid="PSA 62:10" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="11-12" style="v" sid="PSA 62:11-12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62.11-12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 34:11">Job 34.11</ref>; <ref loc="JER 17:10">Jer 17.10</ref>; <ref loc="MAT 16:27">Mat 16.27</ref>; <ref loc="ROM 2:6">Rom 2.6</ref>; <ref loc="REV 2:23">Rev 2.23</ref></char>
    </note>God.</para>
  <para style="q1" vid="PSA 62:11-12">Yu yu Masta* blong mifala.</para>
  <para style="q1" vid="PSA 62:11-12">I no wan taem nomo</para>
  <para style="q2" vid="PSA 62:11-12">we mi mi harem yu yu stap talem</para>
  <para style="q3" vid="PSA 62:11-12">se paoa i blong yu,</para>
  <para style="q4" vid="PSA 62:11-12">mo oltaem yu yu lavem man tumas.</para>
  <para style="q1" vid="PSA 62:11-12">Yu nomo yu stap givim pei long mifala,</para>
  <para style="q2" vid="PSA 62:11-12">stret long ol wok blong mifala.<verse eid="PSA 62:11-12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">Prea blong man we i wantem God tumas</para>
  <para style="sp">(Sing ya, Deved i wokem, long taem ya we hem i stap long draeples long Juda.*)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />God.</para>
  <para style="q1" vid="PSA 63:1">Yu yu God blong mi.</para>
  <para style="q1" vid="PSA 63:1">Mi mi wantem tumas</para>
  <para style="q2" vid="PSA 63:1">blong yu yu stap oltaem</para>
  <para style="q3" vid="PSA 63:1">long laef blong mi.</para>
  <para style="q1" vid="PSA 63:1">Taem yu yu no stap,</para>
  <para style="q2" vid="PSA 63:1">mi mi harem we laef blong mi</para>
  <para style="q3" vid="PSA 63:1">i olsem graon we i no moa gat wota nating long hem,</para>
  <para style="q3" vid="PSA 63:1">i drae we i drae,</para>
  <para style="q4" vid="PSA 63:1">i no moa gud blong wan samting,</para>
  <para style="q2" vid="PSA 63:1">nao from samting ya,</para>
  <para style="q3" vid="PSA 63:1">mi mi wantem yu tumas.<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Plis yu letem mi mi luk yu</para>
  <para style="q2" vid="PSA 63:2">long tabu ples blong yu.</para>
  <para style="q1" vid="PSA 63:2">Yu letem mi mi luk</para>
  <para style="q2" vid="PSA 63:2">bigfala paoa blong yu,</para>
  <para style="q3" vid="PSA 63:2">mo bigfala laet ya</para>
  <para style="q4" vid="PSA 63:2">we i soemaot we yu yu stap.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Oltaem yu yu lavem mi,</para>
  <para style="q2" vid="PSA 63:3">mo fasin ya, mi mi wantem moa,</para>
  <para style="q3" vid="PSA 63:3">i winim we mi wantem stap laef.</para>
  <para style="q1" vid="PSA 63:3">From samting ya,</para>
  <para style="q2" vid="PSA 63:3">bambae mi presem yu.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Bambae mi stap talem tangkiu long yu</para>
  <para style="q2" vid="PSA 63:4">oltaem long laef blong mi.</para>
  <para style="q1" vid="PSA 63:4">Bambae mi leftemap han blong mi,</para>
  <para style="q2" vid="PSA 63:4">mi mekem prea long yu.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Bambae mi kam fulap</para>
  <para style="q2" vid="PSA 63:5">long ol gudgudfala samting blong yu</para>
  <para style="q3" vid="PSA 63:5">olsem we mi harem gud long lafet.</para>
  <para style="q1" vid="PSA 63:5">Nao bambae mi sing</para>
  <para style="q2" vid="PSA 63:5">long ol singsing blong glad,</para>
  <para style="q3" vid="PSA 63:5">blong mi presem yu.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Oltaem, taem we mi ledaon long bed,</para>
  <para style="q2" vid="PSA 63:6">mi stap tingbaot yu.</para>
  <para style="q1" vid="PSA 63:6">I stat long sapa gogo kasem long moning</para>
  <para style="q2" vid="PSA 63:6">mi mi stap tingting long yu,<verse eid="PSA 63:6" /></para>
  <para style="q3">
    <verse number="7" style="v" sid="PSA 63:7" />from we oltaem yu yu stap givhan long mi.</para>
  <para style="q1" vid="PSA 63:7">Mi mi stap faenem sefples long yu</para>
  <para style="q2" vid="PSA 63:7">olsem we pikinini blong faol i faenem sefples</para>
  <para style="q3" vid="PSA 63:7">aninit long wing blong mama blong hem,</para>
  <para style="q2" vid="PSA 63:7">nao mi mi glad,</para>
  <para style="q3" vid="PSA 63:7">mi stap singsing from.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Mi mi no save lego yu,</para>
  <para style="q2" vid="PSA 63:8">mo raethan blong yu i stap holem mi</para>
  <para style="q3" vid="PSA 63:8">mi stap gud.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Olgeta ya we oli stap traem blong kilim mi,</para>
  <para style="q2" vid="PSA 63:9">bambae oli godaon long Hom* blong ol Dedman.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Bambae ol man oli kilim olgeta long faet,</para>
  <para style="q2" vid="PSA 63:10">mo ol wael dog bambae oli kakae ol bodi blong olgeta.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />God.</para>
  <para style="q1" vid="PSA 63:11">Mi mi king,</para>
  <para style="q2" vid="PSA 63:11">mo bambae mi glad tumas</para>
  <para style="q3" vid="PSA 63:11">from we yu bambae yu stap mekem mi mi win.</para>
  <para style="q1" vid="PSA 63:11">Olgeta we oli stap mekem promes long nem blong yu,</para>
  <para style="q3" vid="PSA 63:11">bambae oli presem yu,</para>
  <para style="q2" vid="PSA 63:11">be ol man blong giaman,</para>
  <para style="q4" vid="PSA 63:11">bambae yu satem maot blong olgeta.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">Prea we man i mekem blong God i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />God.</para>
  <para style="q1" vid="PSA 64:1">Mi mi stap long trabol ya.</para>
  <para style="q1" vid="PSA 64:1">Plis yu lesin long prea blong mi.</para>
  <para style="q1" vid="PSA 64:1">Mi mi fraet tumas long ol enemi blong mi.</para>
  <para style="q1" vid="PSA 64:1">Plis yu sevem laef blong mi.<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Plis yu blokemgud mi</para>
  <para style="q2" vid="PSA 64:2">blong ol plan blong ol man nogud</para>
  <para style="q3" vid="PSA 64:2">oli no save kasem mi.</para>
  <para style="q1" vid="PSA 64:2">Yu no letem mi mi go long han</para>
  <para style="q3" vid="PSA 64:2">blong ol hip blong ol rabis man ya.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Olgeta oli stap mekemrere ol tok blong olgeta</para>
  <para style="q2" vid="PSA 64:3">we i olsem naef blong faet</para>
  <para style="q3" vid="PSA 64:3">we i sap we i sap,</para>
  <para style="q2" vid="PSA 64:3">mo oli stap makem ol man</para>
  <para style="q3" vid="PSA 64:3">blong sutum olgeta</para>
  <para style="q4" vid="PSA 64:3">long ol rabis tok ya blong olgeta.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Olgeta oli stap haed,</para>
  <para style="q2" vid="PSA 64:4">nao wantaem nomo,</para>
  <para style="q3" vid="PSA 64:4">oli sutum ol gudfala man</para>
  <para style="q4" vid="PSA 64:4">long ol giaman toktok blong olgeta,</para>
  <para style="q3" vid="PSA 64:4">we oli no fraet nating.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Oli stap givgivhan long olgeta</para>
  <para style="q2" vid="PSA 64:5">long ol rabis plan blong olgeta.</para>
  <para style="q1" vid="PSA 64:5">Oli stap tingbaotgud ol ples</para>
  <para style="q2" vid="PSA 64:5">we bambae oli putum ol trap blong olgeta long hem,</para>
  <para style="q3" vid="PSA 64:5">mo oli talem se,</para>
  <para style="q2" vid="PSA 64:5">“!Bambae i no gat man i save luk ol trap ya!”<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Oli stap mekem ol plan</para>
  <para style="q3" vid="PSA 64:6">blong mekem ol samting nogud,</para>
  <para style="q2" vid="PSA 64:6">mo oli talem se,</para>
  <para style="q2" vid="PSA 64:6">“Plan ya blong yumi i nambawan.</para>
  <para style="q2" vid="PSA 64:6">Bambae i no gat man i save</para>
  <para style="q3" vid="PSA 64:6">faenemaot tingting blong yumi.”<verse eid="PSA 64:6" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Be bambae God i sutum olgeta</para>
  <para style="q2" vid="PSA 64:7">long ara blong hem,</para>
  <para style="q3" vid="PSA 64:7">mo wantaem nomo bambae oli karekil.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Ol rabis tok ya blong olgeta</para>
  <para style="q2" vid="PSA 64:8">bambae i kakae olgeta bakegen.</para>
  <para style="q1" vid="PSA 64:8">Mo ol man we bambae oli luk olgeta,</para>
  <para style="q2" vid="PSA 64:8">bambae oli saksakem hed blong olgeta from.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Nao olgeta man evriwan bambae oli fraet,</para>
  <para style="q2" vid="PSA 64:9">bambae oli stap tingbaot samting ya</para>
  <para style="q4" vid="PSA 64:9">we God i mekem,</para>
  <para style="q3" vid="PSA 64:9">mo bambae oli stap tokbaot</para>
  <para style="q3" vid="PSA 64:9">ol wok blong hem.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Ol man we oli stret</para>
  <para style="q2" vid="PSA 64:10">bambae oli glad from ol samting ya</para>
  <para style="q3" vid="PSA 64:10">we Hae God i mekem,</para>
  <para style="q2" vid="PSA 64:10">nao bambae oli faenem sefples long hem.</para>
  <para style="q1" vid="PSA 64:10">Olgeta stret man ya evriwan</para>
  <para style="q2" vid="PSA 64:10">bambae oli presem hem.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">Sing blong presem God mo blong talem tangkiu long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />God.</para>
  <para style="q1" vid="PSA 65:1">I stret blong mifala i presem yu long Saeon,*</para>
  <para style="q3" vid="PSA 65:1">mo blong mifala i holem ol promes ya</para>
  <para style="q4" vid="PSA 65:1">we mifala i mekem long yu,<verse eid="PSA 65:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 65:2" />from we oltaem,</para>
  <para style="q3" vid="PSA 65:2">yu yu stap ansa long ol prea blong mifala.</para>
  <para style="q1" vid="PSA 65:2">Olgeta man long evri ples</para>
  <para style="q2" vid="PSA 65:2">bambae oli mas kam long yu,<verse eid="PSA 65:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 65:3" />from we oli stap mekem sin.</para>
  <para style="q1" vid="PSA 65:3">Ol fasin nogud blong mifala</para>
  <para style="q2" vid="PSA 65:3">oli stap winim mifala,</para>
  <para style="q3" vid="PSA 65:3">be yu yu stap fogivim mifala,</para>
  <para style="q4" vid="PSA 65:3">yu stap tekemaot sin blong mifala.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Olgeta man we yu yu stap jusumaot olgeta,</para>
  <para style="q3" vid="PSA 65:4">mo yu stap tekem olgeta</para>
  <para style="q4" vid="PSA 65:4">oli kam long tabu ples blong yu,</para>
  <para style="q2" vid="PSA 65:4">oli save harem gud.</para>
  <para style="q1" vid="PSA 65:4">Bambae mifala i harem gud</para>
  <para style="q3" vid="PSA 65:4">long ol gudgudfala samting ya</para>
  <para style="q4" vid="PSA 65:4">blong haos* blong yu,</para>
  <para style="q2" vid="PSA 65:4">bambae mifala i stap klosap nomo long yu</para>
  <para style="q3" vid="PSA 65:4">long tabu haos ya blong yu.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Taem mifala i krae long yu,</para>
  <para style="q2" vid="PSA 65:5">yu yu stap ansa long mifala,</para>
  <para style="q4" vid="PSA 65:5">yu stap mekem mifala i win,</para>
  <para style="q3" vid="PSA 65:5">yu stap mekem ol bigbigfala samting</para>
  <para style="q3" vid="PSA 65:5">blong sevem mifala.</para>
  <para style="q1" vid="PSA 65:5">Ol man long olgeta ples long wol</para>
  <para style="q2" vid="PSA 65:5">oli stap trastem yu.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />Yu yu stanemap ol bigbigfala hil</para>
  <para style="q2" vid="PSA 65:6">long paoa blong yu.</para>
  <para style="q1" vid="PSA 65:6">Long fasin ya,</para>
  <para style="q2" vid="PSA 65:6">yu soemaot we yu yu gat olgeta paoa.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />Yu stap mekem ol rafsi</para>
  <para style="q3" vid="PSA 65:7">oli kam kwaet,</para>
  <para style="q2" vid="PSA 65:7">mo yu stap blokem ol bigsi</para>
  <para style="q4" vid="PSA 65:7">oli no mekem noes.</para>
  <para style="q1" vid="PSA 65:7">Yu mekem ol man</para>
  <para style="q2" vid="PSA 65:7">oli no moa raorao olbaot,</para>
  <para style="q3" vid="PSA 65:7">oli stap kwaet.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Ol man long olgeta ples long wol</para>
  <para style="q2" vid="PSA 65:8">oli fraet long ol bigbigfala wok</para>
  <para style="q3" vid="PSA 65:8">we yu yu mekem,</para>
  <para style="q2" vid="PSA 65:8">nao oli stap ona long yu from.</para>
  <para style="q1" vid="PSA 65:8">Ol wok blong yu i mekem</para>
  <para style="q2" vid="PSA 65:8">ol man long wol ya oli hapi tumas</para>
  <para style="q4" vid="PSA 65:8">oli stap singsingaot,</para>
  <para style="q3" vid="PSA 65:8">i stat long narasaed blong wol,</para>
  <para style="q4" vid="PSA 65:8">i go kasem narasaed blong hem.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Yu yu soemaot</para>
  <para style="q2" vid="PSA 65:9">we yu stap lukaot gud long wol ya,</para>
  <para style="q3" vid="PSA 65:9">from we yu stap sanem ren i kam,</para>
  <para style="q4" vid="PSA 65:9">nao yu mekem graon blong hem</para>
  <para style="q3" vid="PSA 65:9">i kam gud we i gud.</para>
  <para style="q1" vid="PSA 65:9">Yu mekem we ol wota oli stap ron,</para>
  <para style="q2" vid="PSA 65:9">mo we graon i karem plante kakae.</para>
  <para style="q1" vid="PSA 65:9">Fasin blong yu blong mekem i olsem.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Yu stap sanem plante ren i kam long ol garen</para>
  <para style="q3" vid="PSA 65:10">we ol man oli planem finis,</para>
  <para style="q2" vid="PSA 65:10">blong mekem graon i wetwet.</para>
  <para style="q1" vid="PSA 65:10">Yu mekem graon i sofsof long ren,</para>
  <para style="q2" vid="PSA 65:10">nao yu mekem ol samting oli gru.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Gudfala fasin ya blong yu i mekem</para>
  <para style="q2" vid="PSA 65:11">we oltaem i gat plante gudfala kakae i stap.</para>
  <para style="q1" vid="PSA 65:11">Long evri ples we yu yu pas long hem,</para>
  <para style="q2" vid="PSA 65:11">yu stap givim plante kakae long ol man.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Ol ples olbaot</para>
  <para style="q3" vid="PSA 65:12">oli fulap long kakae blong sipsip,</para>
  <para style="q2" vid="PSA 65:12">mo evri samting long ol hil</para>
  <para style="q4" vid="PSA 65:12">oli stap harem gud.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Ol open ples</para>
  <para style="q3" vid="PSA 65:13">oli fulap gud long ol sipsip,</para>
  <para style="q2" vid="PSA 65:13">ol levelples long medel blong ol hil</para>
  <para style="q4" vid="PSA 65:13">oli fulap gud long wit.*</para>
  <para style="q1" vid="PSA 65:13">Long evri ples,</para>
  <para style="q2" vid="PSA 65:13">olgeta samting oli stap</para>
  <para style="q3" vid="PSA 65:13">singsingaot, mo oli stap singsing</para>
  <para style="q4" vid="PSA 65:13">from we oli glad tumas.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">Ol man oli singsing blong talem tangkiu long God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />!Olgeta man!</para>
  <para style="q1" vid="PSA 66:1">!Yumi presem God!</para>
  <para style="q1" vid="PSA 66:1">!Yumi glad!</para>
  <para style="q1" vid="PSA 66:1">!Yumi singsing long hem!<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />!I gud yumi sing</para>
  <para style="q2" vid="PSA 66:2">blong leftemap nem blong hem!</para>
  <para style="q1" vid="PSA 66:2">!Yumi presem hem!</para>
  <para style="q1" vid="PSA 66:2">!Yumi leftemap nem blong hem!<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />Yumi talem long hem se,</para>
  <para style="q2" vid="PSA 66:3">“Ol samting ya we yu yu stap mekem,</para>
  <para style="q3" vid="PSA 66:3">oli gud tumas.</para>
  <para style="q2" vid="PSA 66:3">Paoa blong yu i bigfala tumas,</para>
  <para style="q3" vid="PSA 66:3">i mekem we ol enemi blong yu</para>
  <para style="q4" vid="PSA 66:3">oli fraet,</para>
  <para style="q3" vid="PSA 66:3">oli bodaon, oli ona long yu.<verse eid="PSA 66:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 66:4" />Olgeta man long wol</para>
  <para style="q3" vid="PSA 66:4">oli stap mekem wosip long yu,</para>
  <para style="q4" vid="PSA 66:4">oli stap singsing blong presem nem blong yu.”<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />!Olgeta!</para>
  <para style="q1" vid="PSA 66:5">Yufala i kam,</para>
  <para style="q2" vid="PSA 66:5">yufala i harem ol samting ya</para>
  <para style="q2" vid="PSA 66:5">we God i bin mekem.</para>
  <para style="q1" vid="PSA 66:5">Yufala i traem tingbaot</para>
  <para style="q2" vid="PSA 66:5">ol bigbigfala wok ya we hem i mekem</para>
  <para style="q3" vid="PSA 66:5">long fes blong ol man bifo.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66.6 a: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Eks 14.21</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 3:14-17">Jos 3.14-17</ref>
      </char>
    </note>Hem i mekem solwota i seraot long tu haf,</para>
  <para style="q3" vid="PSA 66:6">ples i kam drae,</para>
  <para style="q2" vid="PSA 66:6">mo i mekem reva i no moa ron,</para>
  <para style="q3" vid="PSA 66:6">nao ol bubu blong yumi bifo</para>
  <para style="q4" vid="PSA 66:6">oli wokbaot nomo,</para>
  <para style="q3" vid="PSA 66:6">oli gokros long narasaed.</para>
  <para style="q1" vid="PSA 66:6">Mo olgeta oli glad tumas</para>
  <para style="q2" vid="PSA 66:6">from samting ya we hem i mekem.<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />Bambae hem i stap rul oltaem</para>
  <para style="q2" vid="PSA 66:7">long paoa blong hem,</para>
  <para style="q3" vid="PSA 66:7">gogo i no save finis,</para>
  <para style="q2" vid="PSA 66:7">mo oltaem bambae hem i stap wajem</para>
  <para style="q3" vid="PSA 66:7">ol man blong ol narafala kantri.</para>
  <para style="q1" vid="PSA 66:7">I nogud ol enemi blong hem</para>
  <para style="q2" vid="PSA 66:7">oli traem girap, oli agensem hem.<verse eid="PSA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Olgeta man blong evri kantri,</para>
  <para style="q2" vid="PSA 66:8">yufala i presem God blong mifala.</para>
  <para style="q1" vid="PSA 66:8">Yufala i presem hem</para>
  <para style="q2" vid="PSA 66:8">we yufala i singsingaot bigwan.<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />Hem i stap holem mifala i stap laef,</para>
  <para style="q2" vid="PSA 66:9">hem i no save letem mifala i foldaon.<verse eid="PSA 66:9" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />God,</para>
  <para style="q2" vid="PSA 66:10">yu yu bin mekem ol strong fasin long mifala</para>
  <para style="q4" vid="PSA 66:10">blong mekem laef blong mifala i klin,</para>
  <para style="q3" vid="PSA 66:10">olsem we man i bonem silva</para>
  <para style="q3" vid="PSA 66:10">blong tekemaot doti blong hem.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Yu letem mifala i foldaon long trap,</para>
  <para style="q2" vid="PSA 66:11">we mifala i harem nogud tumas,</para>
  <para style="q3" vid="PSA 66:11">olsem we mifala i stap karem ol hevi samting.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Yu letem ol enemi blong mifala</para>
  <para style="q3" vid="PSA 66:12">oli kam purumbut long mifala,</para>
  <para style="q2" vid="PSA 66:12">mo yu mekem we mifala i gotru long faea,</para>
  <para style="q4" vid="PSA 66:12">mo long wota we i ron bigwan.</para>
  <para style="q1" vid="PSA 66:12">Be naoia,</para>
  <para style="q2" vid="PSA 66:12">yu tekem mifala i kam long sefples bakegen.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Bambae mi mi mekem ol sakrefaes</para>
  <para style="q3" vid="PSA 66:13">long haos* blong yu,</para>
  <para style="q2" vid="PSA 66:13">we bambae mi bonem olgeta i bon evriwan</para>
  <para style="q4" vid="PSA 66:13">blong mekem wosip long yu.</para>
  <para style="q1" vid="PSA 66:13">Bambae mi givim ol samting ya long yu</para>
  <para style="q2" vid="PSA 66:13">we mi promes finis blong givim.<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />Hemia ol samting ya</para>
  <para style="q2" vid="PSA 66:14">we taem mi stap long trabol,</para>
  <para style="q3" vid="PSA 66:14">mi talem se bambae mi givim long yu.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Bambae mi bonem ol smol sipsip we oli fatfat gud</para>
  <para style="q2" vid="PSA 66:15">oli bon olgeta long olta blong yu.</para>
  <para style="q1" vid="PSA 66:15">Bambae mi bonem ol man sipsip,</para>
  <para style="q2" vid="PSA 66:15">we smok blong olgeta</para>
  <para style="q3" vid="PSA 66:15">bambae i go antap long yu.</para>
  <para style="q1" vid="PSA 66:15">Mo bambae mi tekem ol bul mo ol man nani,</para>
  <para style="q2" vid="PSA 66:15">mi bonem olgeta blong mekem sakrefaes long yu.<verse eid="PSA 66:15" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Yufala we i stap ona long God,</para>
  <para style="q2" vid="PSA 66:16">yufala i kam, yufala i lesin.</para>
  <para style="q1" vid="PSA 66:16">Bambae mi talemaot long yufala</para>
  <para style="q2" vid="PSA 66:16">ol samting ya we hem i mekem long mi.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Mi prea long hem</para>
  <para style="q3" vid="PSA 66:17">blong i givhan long mi,</para>
  <para style="q2" vid="PSA 66:17">mo mi presem hem,</para>
  <para style="q4" vid="PSA 66:17">mi leftemap nem blong hem.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18-19" style="v" sid="PSA 66:18-19" />God i Masta* blong mi,</para>
  <para style="q2" vid="PSA 66:18-19">mo sipos mi haedem ol sin blong mi,</para>
  <para style="q3" vid="PSA 66:18-19">bambae hem i no save lesin long mi.</para>
  <para style="q1" vid="PSA 66:18-19">Be mi mi talemaot olgeta long hem,</para>
  <para style="q2" vid="PSA 66:18-19">nao hem i lesin long prea blong mi,</para>
  <para style="q3" vid="PSA 66:18-19">i harem tok blong mi.<verse eid="PSA 66:18-19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Oltaem mi mi stap presem God</para>
  <para style="q2" vid="PSA 66:20">from we taem mi mi prea long hem,</para>
  <para style="q3" vid="PSA 66:20">hem i no save tanem baksaed long mi,</para>
  <para style="q2" vid="PSA 66:20">hem i holemtaet fasin ya blong hem</para>
  <para style="q3" vid="PSA 66:20">we oltaem hem i lavem mi tumas.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">Sing blong talem tangkiu long God</para>
  <para style="sp">(Sing ya i blong sing wetem stringban.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />God.</para>
  <para style="q1" vid="PSA 67:1">Plis yu sore long mifala,</para>
  <para style="q3" vid="PSA 67:1">yu blesem mifala.</para>
  <para style="q1" vid="PSA 67:1">Plis yu stap lukluk long mifala,</para>
  <para style="q3" vid="PSA 67:1">yu kaen long mifala,<verse eid="PSA 67:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 67:2" />blong ol man long olgeta ples long wol</para>
  <para style="q4" vid="PSA 67:2">oli save samting we yu yu wantem,</para>
  <para style="q3" vid="PSA 67:2">mo blong ol man blong ol narafala kantri</para>
  <para style="q3" vid="PSA 67:2">oli save fasin blong yu blong sevem man.<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />God,</para>
  <para style="q2" vid="PSA 67:3">i gud ol man oli presem yu,</para>
  <para style="q3" vid="PSA 67:3">i gud olgeta man evriwan oli presem yu.<verse eid="PSA 67:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />I gud olgeta man blong evri kantri</para>
  <para style="q3" vid="PSA 67:4">oli glad, oli singsing,</para>
  <para style="q2" vid="PSA 67:4">from we yu yu stap jajem olgeta</para>
  <para style="q4" vid="PSA 67:4">long stret fasin,</para>
  <para style="q3" vid="PSA 67:4">mo yu stap lidim olgeta man</para>
  <para style="q3" vid="PSA 67:4">long evri kantri long wol.<verse eid="PSA 67:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />God,</para>
  <para style="q2" vid="PSA 67:5">i gud ol man oli presem yu.</para>
  <para style="q3" vid="PSA 67:5">I gud olgeta man evriwan oli presem yu.<verse eid="PSA 67:5" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />God i God blong yumi,</para>
  <para style="q2" vid="PSA 67:6">mo hem i stap blesem yumi,</para>
  <para style="q3" vid="PSA 67:6">i mekem we graon ya blong yumi</para>
  <para style="q2" vid="PSA 67:6">i givim plante kakae long yumi.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Hem i blesemgud yumi,</para>
  <para style="q2" vid="PSA 67:7">mo i gud olgeta man long evri ples</para>
  <para style="q3" vid="PSA 67:7">oli ona gud long hem.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">Ol laen blong Isrel oli singsing from we oli win</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />God.</para>
  <para style="q1" vid="PSA 68:1">Plis yu kam long paoa blong yu,</para>
  <para style="q3" vid="PSA 68:1">yu ronem ol enemi blong yu</para>
  <para style="q4" vid="PSA 68:1">oli ron wanwan.</para>
  <para style="q1" vid="PSA 68:1">Yu kam,</para>
  <para style="q2" vid="PSA 68:1">yu winim olgeta we oli no laekem yu</para>
  <para style="q4" vid="PSA 68:1">oli stap agens long yu,</para>
  <para style="q3" vid="PSA 68:1">yu mekem olgeta oli ronronwe.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />God,</para>
  <para style="q2" vid="PSA 68:2">plis yu ronem ol man nogud ya</para>
  <para style="q4" vid="PSA 68:2">oli gowe long fes blong yu,</para>
  <para style="q3" vid="PSA 68:2">olsem smok we win i blu long hem,</para>
  <para style="q3" vid="PSA 68:2">i karem i go.</para>
  <para style="q1" vid="PSA 68:2">Yu mekem we olgeta oli lus olgeta,</para>
  <para style="q2" vid="PSA 68:2">olsem gris we i stap long bigsan,</para>
  <para style="q3" vid="PSA 68:2">i ronaot, i lus.<verse eid="PSA 68:2" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Yumi ol stret man,</para>
  <para style="q2" vid="PSA 68:3">yumi mas kam long fes blong God,</para>
  <para style="q3" vid="PSA 68:3">yumi mas harem gud, yumi glad.</para>
  <para style="q1" vid="PSA 68:3">I gud yumi hapi,</para>
  <para style="q2" vid="PSA 68:3">we yumi stap singsingaot from.<verse eid="PSA 68:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />I gud yumi sing long hem,</para>
  <para style="q2" vid="PSA 68:4">yumi singsing blong presem nem blong hem.</para>
  <para style="q1" vid="PSA 68:4">Hem i stap sidaon long klaod,</para>
  <para style="q2" vid="PSA 68:4">i stap kam.</para>
  <para style="q1" vid="PSA 68:4">I gud yumi mekemrere rod blong hem.</para>
  <para style="q1" vid="PSA 68:4">Nem blong hem, Hae God.</para>
  <para style="q1" vid="PSA 68:4">I gud yumi kam long fes blong hem,</para>
  <para style="q2" vid="PSA 68:4">yumi glad.<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />God i stap long tabu haos* blong hem,</para>
  <para style="q2" vid="PSA 68:5">mo hem i stap lukaot long ol pikinini</para>
  <para style="q3" vid="PSA 68:5">we papa blong olgeta i ded,</para>
  <para style="q4" vid="PSA 68:5">mo i stap mekem i gud long ol wido.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Hem i stap fren long ol man</para>
  <para style="q3" vid="PSA 68:6">we oli no gat fren blong olgeta,</para>
  <para style="q2" vid="PSA 68:6">i stap givim ples long olgeta</para>
  <para style="q4" vid="PSA 68:6">blong oli save stap gud long hem.</para>
  <para style="q1" vid="PSA 68:6">Hem i stap tekemaot ol man long kalabus,</para>
  <para style="q2" vid="PSA 68:6">i stap lidim olgeta i go,</para>
  <para style="q3" vid="PSA 68:6">we oli fri, oli hapi.</para>
  <para style="q1" vid="PSA 68:6">Be olgeta we oli stap agens long hem,</para>
  <para style="q2" vid="PSA 68:6">hem i stap putum olgeta</para>
  <para style="q3" vid="PSA 68:6">oli stap long graon we i drae,</para>
  <para style="q4" vid="PSA 68:6">i nogud olgeta.<verse eid="PSA 68:6" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />God,</para>
  <para style="q2" vid="PSA 68:7">taem ol man blong yu bifo</para>
  <para style="q4" vid="PSA 68:7">oli aot long Ijip, oli kam,</para>
  <para style="q3" vid="PSA 68:7">yu stap lidim olgeta,</para>
  <para style="q3" vid="PSA 68:7">mo yu stap krosem ol draeples.<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68.8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:18">Eks 19.18</ref>
      </char>
    </note>Yu yu God blong hil ya Sinae<note caller="+" style="f"><char style="fr" closed="false">68.8: </char><char style="fqa" closed="false">God blong hil ya Sinae. </char><char style="ft" closed="false">Nem ya, hem i kamaot from we taem ol laen blong Isrel oli aot long Ijip, oli stap kam long Kenan, God i soemaot hem long olgeta long bigfala hil ya Sinae. Yu luk Eksodas 19.16-25.</char></note>,</para>
  <para style="q3" vid="PSA 68:8">yu yu God blong mifala ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 68:8">mo taem yu yu stap kam,</para>
  <para style="q3" vid="PSA 68:8">graon i seksek,</para>
  <para style="q4" vid="PSA 68:8">mo bigfala ren i kam.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />God,</para>
  <para style="q2" vid="PSA 68:9">yu yu mekem bigfala ren i kam,</para>
  <para style="q3" vid="PSA 68:9">nao yu mekem graon ya blong yu</para>
  <para style="q3" vid="PSA 68:9">we i kam nogud finis,</para>
  <para style="q4" vid="PSA 68:9">i kam gud bakegen.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Ol man blong yu oli mekem hom blong olgeta</para>
  <para style="q3" vid="PSA 68:10">long ples ya,</para>
  <para style="q2" vid="PSA 68:10">mo from we fasin blong yu i gud tumas,</para>
  <para style="q3" vid="PSA 68:10">oltaem yu stap givim ol samting long ol puaman.<verse eid="PSA 68:10" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />God i Masta* blong yumi,</para>
  <para style="q3" vid="PSA 68:11">mo hem i givim tok blong hem,</para>
  <para style="q2" vid="PSA 68:11">nao plante woman oli kam talemaot nius,</para>
  <para style="q3" vid="PSA 68:11">se ol king wetem ol soldia blong olgeta oli ronronwe.<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />Nao ol woman long hom oli seraot ol samting</para>
  <para style="q3" vid="PSA 68:12">we ol man oli winim long faet ya.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Oli karem ol pija blong sotleg*</para>
  <para style="q3" vid="PSA 68:13">we oli flasem long silva,</para>
  <para style="q2" vid="PSA 68:13">mo we wing blong olgeta i saen</para>
  <para style="q4" vid="PSA 68:13">from we oli flasem long gol we i klin gud.</para>
  <para style="b" vid="PSA 68:13" />
  <para style="q1" vid="PSA 68:13">(?From wanem sam long yufala</para>
  <para style="q3" vid="PSA 68:13">oli stap long hom,</para>
  <para style="q2" vid="PSA 68:13">oli stap lukaot long sipsip</para>
  <para style="q4" vid="PSA 68:13">long taem ya?)<verse eid="PSA 68:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />God i gat olgeta paoa,</para>
  <para style="q2" vid="PSA 68:14">mo taem hem i winim ol king ya,</para>
  <para style="q3" vid="PSA 68:14">i mekem olgeta oli ron wanwan,</para>
  <para style="q2" vid="PSA 68:14">i olsem we sno i folfoldaon</para>
  <para style="q3" vid="PSA 68:14">long bigfala hil ya Jalmon,</para>
  <para style="q4" vid="PSA 68:14">i go olbaot.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Bigfala hil ya Basan,</para>
  <para style="q2" vid="PSA 68:15">hem i bigwan we i bigwan,</para>
  <para style="q3" vid="PSA 68:15">mo i gat plante smosmol hil antap long hem.<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Hil,</para>
  <para style="q2" vid="PSA 68:16">yu yu gat plante smosmol hil we i hae.</para>
  <para style="q1" vid="PSA 68:16">?From wanem yu stap lukluk nogud</para>
  <para style="q3" vid="PSA 68:16">long tabu hil ya Saeon,*</para>
  <para style="q3" vid="PSA 68:16">we God i jusumaot blong i stap long hem?</para>
  <para style="q1" vid="PSA 68:16">Hae God bambae i stap long ples ya oltaem,</para>
  <para style="q2" vid="PSA 68:16">gogo i no save finis.<verse eid="PSA 68:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Masta ya blong yumi i kamaot long Sinae</para>
  <para style="q2" vid="PSA 68:17">wetem plante taosen kat blong faet we oli strong,</para>
  <para style="q3" vid="PSA 68:17">nao i go insaed long tabu ples blong hem.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68.18: </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:8">Efes 4.8</ref>
      </char>
    </note>Hem i go antap long hil ya we i hae,</para>
  <para style="q2" vid="PSA 68:18">i tekem ol man we i winim olgeta long faet</para>
  <para style="q3" vid="PSA 68:18">oli go kalabus long ples blong hem.</para>
  <para style="q1" vid="PSA 68:18">Fastaem olgeta ya oli stap agens long hem,</para>
  <para style="q2" vid="PSA 68:18">be naoia oli stap givim presen long hem.</para>
  <para style="q1" vid="PSA 68:18">Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 68:18">mo hem bambae i stap long ples ya</para>
  <para style="q3" vid="PSA 68:18">gogo i no save finis.<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Yumi presem Masta ya blong yumi,</para>
  <para style="q2" vid="PSA 68:19">we evri dei,</para>
  <para style="q3" vid="PSA 68:19">hem i stap karem ol hevi samting blong yumi.</para>
  <para style="q1" vid="PSA 68:19">Hem i God mo i stap sevem yumi.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />God ya blong yumi,</para>
  <para style="q3" vid="PSA 68:20">hem i God blong sevem man.</para>
  <para style="q1" vid="PSA 68:20">Hem i Hae God mo i Masta blong yumi,</para>
  <para style="q2" vid="PSA 68:20">mo hem i stap holem yumi,</para>
  <para style="q3" vid="PSA 68:20">yumi stap laef.<verse eid="PSA 68:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Tru,</para>
  <para style="q2" vid="PSA 68:21">God bambae i brekem hed</para>
  <para style="q3" vid="PSA 68:21">blong ol enemi blong hem.</para>
  <para style="q1" vid="PSA 68:21">Bambae hem i smasemgud hed blong olgeta,</para>
  <para style="q2" vid="PSA 68:21">from we oli stap gohed</para>
  <para style="q3" vid="PSA 68:21">blong folem ol fasin nogud blong olgeta.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Hem i Masta blong yumi,</para>
  <para style="q3" vid="PSA 68:22">mo hem i talem se,</para>
  <para style="q2" vid="PSA 68:22">“Bambae mi tekem ol enemi ya blong mi</para>
  <para style="q3" vid="PSA 68:22">we oli stap long Basan oli kambak.</para>
  <para style="q2" vid="PSA 68:22">Bambae mi tekemaot olgeta</para>
  <para style="q3" vid="PSA 68:22">we oli stap long dipsi oli kambak.<verse eid="PSA 68:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PSA 68:23" />Bambae yufala i save wokbaot long blad blong olgeta,</para>
  <para style="q3" vid="PSA 68:23">mo ol dog blong yufala bambae oli save dring blad ya</para>
  <para style="q4" vid="PSA 68:23">olsem we oli wantem.”<verse eid="PSA 68:23" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />God.</para>
  <para style="q1" vid="PSA 68:24">Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 68:24">yu yu King blong mi.</para>
  <para style="q1" vid="PSA 68:24">Olgeta man oli luk</para>
  <para style="q2" vid="PSA 68:24">we yu yu win yu maj i go,</para>
  <para style="q3" vid="PSA 68:24">blong go insaed long tabu ples blong yu.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Ol man blong singsing</para>
  <para style="q3" vid="PSA 68:25">oli stap go biaen long yu,</para>
  <para style="q2" vid="PSA 68:25">mo biaen long olgeta,</para>
  <para style="q4" vid="PSA 68:25">i gat ol gel oli stap kilim ol tamborin,</para>
  <para style="q3" vid="PSA 68:25">mo biaen bakegen,</para>
  <para style="q3" vid="PSA 68:25">i gat ol man blong stringban.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Olgeta oli stap singsing se,</para>
  <para style="q2" vid="PSA 68:26">“Yumi ol man blong God,</para>
  <para style="q4" vid="PSA 68:26">yumi kam wanples finis,</para>
  <para style="q4" vid="PSA 68:26">yumi presem hem.</para>
  <para style="q2" vid="PSA 68:26">Yumi evriwan i laen blong Isrel,</para>
  <para style="q4" vid="PSA 68:26">yumi presem Hae God.”<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Biaen long ol man blong stringban,</para>
  <para style="q2" vid="PSA 68:27">ol laen blong Benjamin*</para>
  <para style="q3" vid="PSA 68:27">we i smol laen olgeta</para>
  <para style="q3" vid="PSA 68:27">oli wokbaot i go.</para>
  <para style="q1" vid="PSA 68:27">Afta,</para>
  <para style="q2" vid="PSA 68:27">ol lida blong laen blong Juda*</para>
  <para style="q3" vid="PSA 68:27">wetem ol man blong olgeta,</para>
  <para style="q2" vid="PSA 68:27">mo laswan,</para>
  <para style="q3" vid="PSA 68:27">ol lida blong laen blong Sebulun*</para>
  <para style="q4" vid="PSA 68:27">mo ol lida blong laen blong Naftali.*<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />God,</para>
  <para style="q2" vid="PSA 68:28">plis yu soemaot bakegen paoa ya blong yu</para>
  <para style="q3" vid="PSA 68:28">we yu bin yusum bifo</para>
  <para style="q4" vid="PSA 68:28">blong givhan long mifala.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Paoa ya i kamaot long yu,</para>
  <para style="q2" vid="PSA 68:29">long haos blong yu long Jerusalem,*</para>
  <para style="q3" vid="PSA 68:29">long ples ya we ol king</para>
  <para style="q4" vid="PSA 68:29">oli stap givim presen long yu.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Kantri ya Ijip i olsem wan algita</para>
  <para style="q2" vid="PSA 68:30">we i stap haed long ol longlongfala gras ya long wota.</para>
  <para style="q1" vid="PSA 68:30">Plis yu tok strong long hem.</para>
  <para style="q1" vid="PSA 68:30">Ol man blong ol narafala kantri</para>
  <para style="q2" vid="PSA 68:30">oli olsem ol bul wetem ol pikinini blong olgeta.</para>
  <para style="q1" vid="PSA 68:30">Plis yu tok strong long olgeta,</para>
  <para style="q2" vid="PSA 68:30">gogo kasem we olgeta oli kam bodaon long yu,</para>
  <para style="q3" vid="PSA 68:30">oli givim ol mane blong olgeta long yu.</para>
  <para style="q1" vid="PSA 68:30">Olgeta ya oli laekem faet tumas.</para>
  <para style="q1" vid="PSA 68:30">Plis yu mekem olgeta oli ronronwe.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Ol haeman blong karem tok blong gavman blong Ijip</para>
  <para style="q2" vid="PSA 68:31">bambae oli aot long ples blong</para>
  <para style="q3" vid="PSA 68:31">olgeta oli kam.</para>
  <para style="q1" vid="PSA 68:31">Ol man Itiopia</para>
  <para style="q2" vid="PSA 68:31">bambae oli leftemap han blong</para>
  <para style="q3" vid="PSA 68:31">olgeta oli prea long yu.<verse eid="PSA 68:31" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Olgeta man long wol,</para>
  <para style="q2" vid="PSA 68:32">yufala i sing long God.</para>
  <para style="q1" vid="PSA 68:32">Hem i Masta blong yumi.</para>
  <para style="q1" vid="PSA 68:32">Yufala i singsing,</para>
  <para style="q2" vid="PSA 68:32">yufala i presem hem.<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />Skae ya i stap bifo olgeta,</para>
  <para style="q2" vid="PSA 68:33">mo hem i rod we God i stap wokbaot long hem.</para>
  <para style="q1" vid="PSA 68:33">Yufala i lesin gud long hem.</para>
  <para style="q1" vid="PSA 68:33">Hem i stap singaot bigwan olsem tanda.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Yufala i talemaot paoa blong God.</para>
  <para style="q1" vid="PSA 68:34">Hem i King,</para>
  <para style="q2" vid="PSA 68:34">mo paoa blong hem i stap holem kantri blong yumi.</para>
  <para style="q1" vid="PSA 68:34">Olgeta samting long skae</para>
  <para style="q2" vid="PSA 68:34">oli stap soemaot bigfala paoa blong hem.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Taem God i kamaot long tabu ples blong hem,</para>
  <para style="q2" vid="PSA 68:35">yumi evriwan i fraet long hem,</para>
  <para style="q3" vid="PSA 68:35">yumi stap ona long hem.</para>
  <para style="q1" vid="PSA 68:35">Yumi ol laen blong Isrel,</para>
  <para style="q2" vid="PSA 68:35">mo hem i God blong yumi.</para>
  <para style="q1" vid="PSA 68:35">Hem i stap givim paoa long yumi,</para>
  <para style="q2" vid="PSA 68:35">mo i stap mekem yumi strong.<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">Wan man i krae long God blong hem i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />!God!</para>
  <para style="q1" vid="PSA 69:1">!Plis yu sevem mi!</para>
  <para style="q1" vid="PSA 69:1">!Mi mi stap long bigfala trabol!</para>
  <para style="q1" vid="PSA 69:1">I olsem we wota i kam antap,</para>
  <para style="q3" vid="PSA 69:1">i kasem nek blong mi finis,<verse eid="PSA 69:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 69:2" />no mi draon long swom</para>
  <para style="q4" vid="PSA 69:2">we i fulap gud long sofmad,</para>
  <para style="q3" vid="PSA 69:2">mo i no gat graon we i strong</para>
  <para style="q3" vid="PSA 69:2">blong mi save stanap long hem,</para>
  <para style="q2" vid="PSA 69:2">no mi stap long wota we i dip,</para>
  <para style="q3" vid="PSA 69:2">mo i ron bigwan, i kavremap mi,</para>
  <para style="q4" vid="PSA 69:2">we klosap mi draon olgeta.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Mi mi stap singaot long yu</para>
  <para style="q2" vid="PSA 69:3">blong yu givhan long mi,</para>
  <para style="q4" vid="PSA 69:3">gogo mi taed,</para>
  <para style="q3" vid="PSA 69:3">trot blong mi i kam nogud from.</para>
  <para style="q1" vid="PSA 69:3">Mi stap lukluk i go long yu</para>
  <para style="q2" vid="PSA 69:3">blong yu kam givhan long mi,</para>
  <para style="q3" vid="PSA 69:3">gogo ae blong mi i soa,</para>
  <para style="q2" vid="PSA 69:3">be no, yu no kam.<verse eid="PSA 69:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69.4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:19">Sam 35.19</ref>; <ref loc="JHN 15:25">Jon 15.25</ref></char>
    </note>Olgeta we oli stap agens long mi from nating nomo</para>
  <para style="q2" vid="PSA 69:4">oli plante moa,</para>
  <para style="q3" vid="PSA 69:4">i winim hea blong hed blong mi.</para>
  <para style="q1" vid="PSA 69:4">Ol enemi ya blong mi</para>
  <para style="q2" vid="PSA 69:4">oli stap mekem ol giaman toktok agens long mi.</para>
  <para style="q1" vid="PSA 69:4">Olgeta oli strong tumas,</para>
  <para style="q2" vid="PSA 69:4">mo oli wantem kilim mi.</para>
  <para style="q1" vid="PSA 69:4">Ol samting ya we mi mi tekem long olgeta,</para>
  <para style="q2" vid="PSA 69:4">mi pem nomo, mi no stilim,</para>
  <para style="q3" vid="PSA 69:4">be olgeta oli stap fosem mi</para>
  <para style="q4" vid="PSA 69:4">blong mi go givimbak.<verse eid="PSA 69:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />God,</para>
  <para style="q2" vid="PSA 69:5">yu yu save ol krangke fasin blong mi.</para>
  <para style="q1" vid="PSA 69:5">Ol sin blong mi oli no save haed long fes blong yu.<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Hae God, Masta* blong mi,</para>
  <para style="q2" vid="PSA 69:6">yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 69:6">Plis yu no letem mi mi mekem</para>
  <para style="q2" vid="PSA 69:6">olgeta we oli trastem yu oli sem.</para>
  <para style="q1" vid="PSA 69:6">Yu yu God blong mifala ol laen* blong Isrel.*</para>
  <para style="q1" vid="PSA 69:6">Yu no pulum sem i kam long mifala ya</para>
  <para style="q3" vid="PSA 69:6">we mifala i stap mekem wosip long yu.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Ol man oli sakem ol rabis tok</para>
  <para style="q4" vid="PSA 69:7">i kam long mi,</para>
  <para style="q2" vid="PSA 69:7">oli mekem mi mi sem tumas</para>
  <para style="q4" vid="PSA 69:7">from we mi stap mekem ol wok blong yu.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Naoia, ol brata blong mi oli luk mi</para>
  <para style="q3" vid="PSA 69:8">olsem wan strenja nomo,</para>
  <para style="q2" vid="PSA 69:8">mo ol famle blong mi oli luk mi</para>
  <para style="q4" vid="PSA 69:8">olsem man blong narafala ples.<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69.9 a: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:17">Jon 2.17</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:3">Rom 15.3</ref>
      </char>
    </note>Mi mi wantem tumas</para>
  <para style="q2" vid="PSA 69:9">se evri samting long haos* blong yu</para>
  <para style="q3" vid="PSA 69:9">oli mas stret gud.</para>
  <para style="q1" vid="PSA 69:9">Oltaem tingting ya i stap wok insaed long mi,</para>
  <para style="q2" vid="PSA 69:9">olsem faea we i stap laet.</para>
  <para style="q1" vid="PSA 69:9">Ol rabis tok ya</para>
  <para style="q2" vid="PSA 69:9">we ol man oli stap sakem long yu,</para>
  <para style="q3" vid="PSA 69:9">oli stap spolem mi.<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Taem mi mi livim kakae</para>
  <para style="q2" vid="PSA 69:10">from we mi wantem mekem</para>
  <para style="q3" vid="PSA 69:10">tingting blong mi i stap daon,</para>
  <para style="q2" vid="PSA 69:10">be ol man oli stap jikim mi.<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />Taem mi putum ol rabis klos</para>
  <para style="q3" vid="PSA 69:11">blong soemaot we mi harem nogud,</para>
  <para style="q2" vid="PSA 69:11">be olgeta oli stap laf nogud long mi.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Oltaem oli stap tokbaot mi olbaot long vilej,</para>
  <para style="q2" vid="PSA 69:12">mo ol man blong drong</para>
  <para style="q4" vid="PSA 69:12">oli stap mekem ol singsing blong mi.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Be Hae God, yu yu God blong mi,</para>
  <para style="q2" vid="PSA 69:13">mi bambae mi stap prea long yu.</para>
  <para style="q1" vid="PSA 69:13">Plis yu ansa long mi</para>
  <para style="q2" vid="PSA 69:13">long taem we yu yu jusum.</para>
  <para style="q1" vid="PSA 69:13">Oltaem yu yu lavem mi tumas,</para>
  <para style="q2" vid="PSA 69:13">mo yu stap holem promes blong yu blong sevem mi,</para>
  <para style="q2" vid="PSA 69:13">plis yu ansa long mi.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Plis yu pulumaot mi</para>
  <para style="q3" vid="PSA 69:14">blong mi no draon long swom ya,</para>
  <para style="q2" vid="PSA 69:14">yu sevem mi</para>
  <para style="q4" vid="PSA 69:14">blong ol enemi ya oli no spolem mi.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Plis yu tekemaot mi long trabol ya.</para>
  <para style="q1" vid="PSA 69:15">Yu no letem</para>
  <para style="q2" vid="PSA 69:15">we wota i ron bigwan i kavremap mi,</para>
  <para style="q3" vid="PSA 69:15">no mi draon long dip solwota,</para>
  <para style="q4" vid="PSA 69:15">no mi godaon long beregraon,</para>
  <para style="q3" vid="PSA 69:15">mi lus.<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />Hae God,</para>
  <para style="q2" vid="PSA 69:16">oltaem yu yu lavem mi tumas.</para>
  <para style="q1" vid="PSA 69:16">Plis yu ansa long mi.</para>
  <para style="q1" vid="PSA 69:16">Yu yu gat bigfala sore long man.</para>
  <para style="q1" vid="PSA 69:16">Plis yu lukluk long mi.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Mi mi man blong wok blong yu.</para>
  <para style="q1" vid="PSA 69:17">Plis yu no haed long mi.</para>
  <para style="q1" vid="PSA 69:17">Naoia mi mi stap long bigfala trabol.</para>
  <para style="q1" vid="PSA 69:17">Plis yu kwik, yu ansa long mi.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Yu kam, yu sevem mi,</para>
  <para style="q3" vid="PSA 69:18">yu tekemaot mi long han blong ol enemi blong mi.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Yu yu save</para>
  <para style="q2" vid="PSA 69:19">we oli stap sakem ol rabis tok long mi</para>
  <para style="q4" vid="PSA 69:19">blong spolem mi,</para>
  <para style="q3" vid="PSA 69:19">oli spolem nem blong mi</para>
  <para style="q3" vid="PSA 69:19">long fes blong ol man,</para>
  <para style="q4" vid="PSA 69:19">mo oli mekem mi mi sem.</para>
  <para style="q1" vid="PSA 69:19">Yu yu savegud olgeta enemi blong mi.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Ol rabis tok ya blong olgeta</para>
  <para style="q3" vid="PSA 69:20">i spolem tingting blong mi finis,</para>
  <para style="q2" vid="PSA 69:20">naoia tingting blong mi</para>
  <para style="q4" vid="PSA 69:20">i foldaon olgeta.</para>
  <para style="q1" vid="PSA 69:20">Mi stap wet blong man i sore long mi,</para>
  <para style="q3" vid="PSA 69:20">i kam luk mi,</para>
  <para style="q2" vid="PSA 69:20">be i no gat man i mekem olsem.</para>
  <para style="q1" vid="PSA 69:20">Mi stap wet blong man i kam</para>
  <para style="q3" vid="PSA 69:20">leftemap tingting blong mi bakegen,</para>
  <para style="q2" vid="PSA 69:20">be mi no luk wan man i kam.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69.21: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:48">Mat 27.48</ref>; <ref loc="MRK 15:36">Mak 15.36</ref>; <ref loc="LUK 23:26">Luk 23.26</ref>; <ref loc="JHN 19:28">Jon 19.28</ref>,<ref loc="JHN 19:29">29</ref></char>
    </note>Taem mi mi hanggri,</para>
  <para style="q3" vid="PSA 69:21">olgeta oli givim posen long mi,</para>
  <para style="q2" vid="PSA 69:21">mo taem mi tosta,</para>
  <para style="q4" vid="PSA 69:21">oli givim waen we i konkon long mi.<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69.22: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 11:9">Rom 11.9</ref>,<ref loc="ROM 11:10">10</ref></char>
    </note>Plis yu letem kakae blong ol lafet blong olgeta</para>
  <para style="q3" vid="PSA 69:22">i spolem olgeta bakegen,</para>
  <para style="q2" vid="PSA 69:22">mo yu mekem we ol lafet blong sakrefaes blong olgeta</para>
  <para style="q2" vid="PSA 69:22">oli kam olsem trap blong kasem olgeta.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Plis yu mekem ae blong olgeta i blaen</para>
  <para style="q3" vid="PSA 69:23">blong oli no save lukluk,</para>
  <para style="q2" vid="PSA 69:23">mo yu mekem bodi blong olgeta</para>
  <para style="q4" vid="PSA 69:23">i no moa strong.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />I gud yu kros we yu kros gud long olgeta,</para>
  <para style="q2" vid="PSA 69:24">we yu meksavegud olgeta.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69.25: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Wok 1.20</ref>
      </char>
    </note>I gud yu mekem ples blong olgeta</para>
  <para style="q3" vid="PSA 69:25">i kam emti,</para>
  <para style="q2" vid="PSA 69:25">mo yu mekem we ol haos tapolen blong olgeta</para>
  <para style="q4" vid="PSA 69:25">oli stap nating nomo,<verse eid="PSA 69:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="PSA 69:26" />from we oli stap ronem ol man,</para>
  <para style="q4" vid="PSA 69:26">we yu yu panisim olgeta finis,</para>
  <para style="q3" vid="PSA 69:26">mo oli stap mekem olgeta</para>
  <para style="q3" vid="PSA 69:26">we yu yu mekem oli karekil finis,</para>
  <para style="q4" vid="PSA 69:26">oli harem nogud moa.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Plis yu jajem olgeta</para>
  <para style="q2" vid="PSA 69:27">from ol sin ya blong olgeta.</para>
  <para style="q1" vid="PSA 69:27">Yu no letem wan long olgeta i stap laef,</para>
  <para style="q2" vid="PSA 69:27">i go fri.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69.28: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:32">Eks 32.32</ref>; <ref loc="REV 3:5">Rev 3.5</ref>; <ref loc="REV 13:8">13.8</ref>; <ref loc="REV 17:8">17.8</ref></char>
    </note>I gud yu ravemaot nem blong olgeta</para>
  <para style="q2" vid="PSA 69:28">long buk ya</para>
  <para style="q3" vid="PSA 69:28">we nem blong ol man we oli gat laef</para>
  <para style="q4" vid="PSA 69:28">i stap long hem,</para>
  <para style="q2" vid="PSA 69:28">yu no moa kaontem olgeta</para>
  <para style="q3" vid="PSA 69:28">wetem ol stret man.<verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />God,</para>
  <para style="q2" vid="PSA 69:29">mi mi harem nogud tumas long bodi blong mi,</para>
  <para style="q3" vid="PSA 69:29">mo tingting blong mi i foldaon olgeta.</para>
  <para style="q1" vid="PSA 69:29">Plis yu leftemap tingting blong mi,</para>
  <para style="q2" vid="PSA 69:29">yu sevem mi.<verse eid="PSA 69:29" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Bambae mi stap presem God</para>
  <para style="q3" vid="PSA 69:30">long singsing,</para>
  <para style="q2" vid="PSA 69:30">bambae mi stap talem tangkiu long hem</para>
  <para style="q4" vid="PSA 69:30">blong leftemap hae nem blong hem.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Hemia bambae i mekem Hae God</para>
  <para style="q3" vid="PSA 69:31">i harem gud moa,</para>
  <para style="q2" vid="PSA 69:31">i winim</para>
  <para style="q4" vid="PSA 69:31">we mi stap givim buluk long hem,</para>
  <para style="q3" vid="PSA 69:31">i winim</para>
  <para style="q4" vid="PSA 69:31">we mi kilim bul we i fatfat gud</para>
  <para style="q3" vid="PSA 69:31">blong mekem sakrefaes long hem.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Taem ol man we oli stap harem nogud</para>
  <para style="q3" vid="PSA 69:32">aninit long han blong narafala man</para>
  <para style="q4" vid="PSA 69:32">oli luk samting ya,</para>
  <para style="q2" vid="PSA 69:32">bambae oli glad.</para>
  <para style="q1" vid="PSA 69:32">Yufala we i stap mekem wosip long God,</para>
  <para style="q2" vid="PSA 69:32">hem bambae i leftemap tingting blong yufala.<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />Hae God i stap lesin long olgeta</para>
  <para style="q3" vid="PSA 69:33">we oli sot long ol samting,</para>
  <para style="q2" vid="PSA 69:33">mo hem i no save fogetem ol man blong hem</para>
  <para style="q4" vid="PSA 69:33">we oli stap long kalabus.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Skae mo graon,</para>
  <para style="q2" vid="PSA 69:34">yutufala wetem olgeta samting we i stap long yutufala,</para>
  <para style="q3" vid="PSA 69:34">yufala i presem God.</para>
  <para style="q1" vid="PSA 69:34">Solwota,</para>
  <para style="q2" vid="PSA 69:34">yu wetem olgeta samting we i stap long yu,</para>
  <para style="q3" vid="PSA 69:34">yufala i presem hem.<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />Hem bambae i sevem Jerusalem*</para>
  <para style="q2" vid="PSA 69:35">mo bambae i wokemgud ol taon blong Juda* bakegen.</para>
  <para style="q1" vid="PSA 69:35">Ol man blong hem</para>
  <para style="q2" vid="PSA 69:35">bambae oli kam stap long ples ya,</para>
  <para style="q3" vid="PSA 69:35">mo bambae oli holem ol graon ya bakegen.<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />Ol pikinini blong ol man blong hem</para>
  <para style="q3" vid="PSA 69:36">bambae oli holem ples ya i blong olgeta,</para>
  <para style="q2" vid="PSA 69:36">mo from we oli lavem hem,</para>
  <para style="q4" vid="PSA 69:36">bambae oli stap oltaem long ples ya.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">Prea we man i mekem blong God i givhan long hem</para>
  <para style="r">(<ref loc="PSA 40:13-17">Sam 40.13-17</ref>)</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Hae God. Yu yu God blong mi.</para>
  <para style="q1" vid="PSA 70:1">Plis yu sevem mi.</para>
  <para style="q1" vid="PSA 70:1">Yu kam kwik, yu halpem mi.<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Olgeta we oli stap traem blong kilim mi,</para>
  <para style="q2" vid="PSA 70:2">i gud yu daonem olgeta</para>
  <para style="q3" vid="PSA 70:2">we bambae oli lusum hed from.</para>
  <para style="q1" vid="PSA 70:2">Olgeta we oli glad</para>
  <para style="q3" vid="PSA 70:2">from we mi mi stap long trabol,</para>
  <para style="q2" vid="PSA 70:2">i gud yu mekem olgeta oli tanemraon,</para>
  <para style="q4" vid="PSA 70:2">oli gobak we bambae oli sem gud.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Olgeta we oli stap laf long mi,</para>
  <para style="q2" vid="PSA 70:3">i gud yu mekem olgeta oli lus</para>
  <para style="q3" vid="PSA 70:3">we tingting blong olgeta</para>
  <para style="q4" vid="PSA 70:3">bambae i foldaon olgeta.<verse eid="PSA 70:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Be olgeta we oli stap kam long yu,</para>
  <para style="q2" vid="PSA 70:4">i gud yu mekem olgeta oli fulap glad</para>
  <para style="q3" vid="PSA 70:4">we oli stap harem gud oltaem.</para>
  <para style="q1" vid="PSA 70:4">Olgeta ya oli stap talem tangkiu long yu</para>
  <para style="q3" vid="PSA 70:4">from we yu stap sevem olgeta,</para>
  <para style="q2" vid="PSA 70:4">mo i gud yu letem olgeta</para>
  <para style="q3" vid="PSA 70:4">oli stap talem oltaem se,</para>
  <para style="q4" vid="PSA 70:4">“!God, hem i hae we i hae!”<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Hae God, yu yu God blong mi.</para>
  <para style="q1" vid="PSA 70:5">Mi mi pua, mi no gat paoa.</para>
  <para style="q1" vid="PSA 70:5">Plis yu kam kwiktaem.</para>
  <para style="q1" vid="PSA 70:5">Oltaem yu yu stap sevem mi.</para>
  <para style="q1" vid="PSA 70:5">Plis yu kam kwik,</para>
  <para style="q2" vid="PSA 70:5">yu givhan long mi.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">Prea blong wan olfala man</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />Hae God.</para>
  <para style="q1" vid="PSA 71:1">Mi mi kam long yu</para>
  <para style="q3" vid="PSA 71:1">blong yu lukaot gud long mi.</para>
  <para style="q1" vid="PSA 71:1">Plis yu no letem</para>
  <para style="q2" vid="PSA 71:1">we ol enemi blong mi oli winim mi samtaem.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Fasin blong yu i stret olgeta.</para>
  <para style="q1" vid="PSA 71:2">Plis yu halpem mi, yu sevem mi.</para>
  <para style="q1" vid="PSA 71:2">Yu lesin long mi,</para>
  <para style="q2" vid="PSA 71:2">yu tekemaot mi long trabol ya</para>
  <para style="q3" vid="PSA 71:2">we i kasem mi.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Oltaem mi mi stap kam haed long yu,</para>
  <para style="q2" vid="PSA 71:3">mi stap luk long yu nomo</para>
  <para style="q3" vid="PSA 71:3">blong yu blokem mi.</para>
  <para style="q1" vid="PSA 71:3">Naoia,</para>
  <para style="q2" vid="PSA 71:3">plis yu kam ples blong haed blong mi bakegen,</para>
  <para style="q3" vid="PSA 71:3">yu kam wan strong ples blong blokem mi.<verse eid="PSA 71:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Hae God, yu yu God blong mi,</para>
  <para style="q2" vid="PSA 71:4">mo yu yu Masta* blong mi.</para>
  <para style="q1" vid="PSA 71:4">Plis yu sevem mi,</para>
  <para style="q2" vid="PSA 71:4">yu tekemaot mi long paoa blong ol rabis man ya,</para>
  <para style="q3" vid="PSA 71:4">we fasin blong olgeta i nogud,</para>
  <para style="q4" vid="PSA 71:4">i strong we i strong.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Mi mi putum tingting blong mi,</para>
  <para style="q3" vid="PSA 71:5">i stap long yu nomo.</para>
  <para style="q1" vid="PSA 71:5">I stat bifo,</para>
  <para style="q3" vid="PSA 71:5">taem mi mi yangfala yet,</para>
  <para style="q2" vid="PSA 71:5">mi stap trastem yu.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Mi mi stap trastem yu oltaem long laef blong mi.</para>
  <para style="q1" vid="PSA 71:6">Yu yu stap lukaot gud long mi oltaem,</para>
  <para style="q2" vid="PSA 71:6">i stat long taem ya we mi mi bon,</para>
  <para style="q3" vid="PSA 71:6">i kam kasem tede,</para>
  <para style="q2" vid="PSA 71:6">mo oltaem bambae mi mi presem yu.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Oltaem,</para>
  <para style="q2" vid="PSA 71:7">laef blong mi i wan eksampol long plante man,</para>
  <para style="q3" vid="PSA 71:7">from we yu yu kam wan strong ples blong blokem mi.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Evri dei nomo,</para>
  <para style="q2" vid="PSA 71:8">i stat long eli moning kasem tudak,</para>
  <para style="q3" vid="PSA 71:8">mi mi stap presem yu,</para>
  <para style="q4" vid="PSA 71:8">mi stap leftemap hae nem blong yu.<verse eid="PSA 71:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Naoia mi mi kam olfala.</para>
  <para style="q1" vid="PSA 71:9">Plis yu no tanem baksaed long mi.</para>
  <para style="q1" vid="PSA 71:9">Naoia mi mi no moa strong.</para>
  <para style="q1" vid="PSA 71:9">Plis yu no lego mi.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Ol enemi blong mi oli stap toktok,</para>
  <para style="q2" vid="PSA 71:10">oli stap mekem plan agens long mi,</para>
  <para style="q3" vid="PSA 71:10">oli wantem kilim mi mi ded.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Oli talem se,</para>
  <para style="q1" vid="PSA 71:11">“!Taem nao! !God i lego hem finis!</para>
  <para style="q2" vid="PSA 71:11">Yumi go ronem hem,</para>
  <para style="q3" vid="PSA 71:11">yumi holem hem.</para>
  <para style="q2" vid="PSA 71:11">!I no gat man blong sevem hem ya!”<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />God,</para>
  <para style="q2" vid="PSA 71:12">plis yu no stap longwe long mi.</para>
  <para style="q1" vid="PSA 71:12">God blong mi,</para>
  <para style="q2" vid="PSA 71:12">yu kam kwik, yu givhan long mi.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Olgeta ya we oli stap faet long mi,</para>
  <para style="q2" vid="PSA 71:13">mi wantem blong yu winim olgeta,</para>
  <para style="q3" vid="PSA 71:13">yu spolem olgeta.</para>
  <para style="q1" vid="PSA 71:13">Olgeta we oli stap traem blong spolem mi,</para>
  <para style="q2" vid="PSA 71:13">mi wantem blong yu mekem olgeta oli sem,</para>
  <para style="q3" vid="PSA 71:13">we ol man bambae oli stap tokbaot olgeta from.<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Oltaem bambae mi mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 71:14">i stap long yu,</para>
  <para style="q2" vid="PSA 71:14">oltaem nomo bambae mi stap presem yu.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Bambae mi stap tokbaot</para>
  <para style="q2" vid="PSA 71:15">ol stret fasin blong yu.</para>
  <para style="q1" vid="PSA 71:15">Oltaem bambae mi stap talemaot</para>
  <para style="q3" vid="PSA 71:15">paoa blong yu blong sevem man,</para>
  <para style="q2" vid="PSA 71:15">i stat long moning</para>
  <para style="q4" vid="PSA 71:15">gogo kasem long sapa.</para>
  <para style="q1" vid="PSA 71:15">Nating we ol fasin ya</para>
  <para style="q2" vid="PSA 71:15">oli strong tumas blong mi mi savegud,</para>
  <para style="q2" vid="PSA 71:15">be mi mi mas talemaot.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Hae God, yu yu Masta blong mi.</para>
  <para style="q1" vid="PSA 71:16">Oltaem,</para>
  <para style="q2" vid="PSA 71:16">bambae mi stap tokbaot yu nomo.</para>
  <para style="q1" vid="PSA 71:16">Bambae mi stap presem yu</para>
  <para style="q3" vid="PSA 71:16">from paoa blong yu,</para>
  <para style="q2" vid="PSA 71:16">mo bambae mi stap talemaot</para>
  <para style="q4" vid="PSA 71:16">ol stret fasin ya blong yu.<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />God,</para>
  <para style="q2" vid="PSA 71:17">i stat long taem we mi mi yangfala,</para>
  <para style="q3" vid="PSA 71:17">yu yu stap tijim mi,</para>
  <para style="q2" vid="PSA 71:17">mo mi stap tokbaot yet</para>
  <para style="q3" vid="PSA 71:17">ol bigbigfala wok ya blong yu.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Naoia mi mi olfala,</para>
  <para style="q3" vid="PSA 71:18">hea blong mi i waet.</para>
  <para style="q1" vid="PSA 71:18">Mo sipos mi stap talemaot yu</para>
  <para style="q2" vid="PSA 71:18">long ol man we oli bon biaen long mi,</para>
  <para style="q3" vid="PSA 71:18">se yu yu strong, yu gat paoa,</para>
  <para style="q2" vid="PSA 71:18">plis yu stap wetem mi,</para>
  <para style="q3" vid="PSA 71:18">yu no lego mi.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />God, i no gat man we i olsem yu.</para>
  <para style="q1" vid="PSA 71:19">Yu yu bin mekem ol bigbigfala wok,</para>
  <para style="q2" vid="PSA 71:19">mo stret fasin blong yu i bigwan we i bigwan,</para>
  <para style="q3" vid="PSA 71:19">mifala i no save makem.<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Yu yu sanem trabol i kam long mi</para>
  <para style="q3" vid="PSA 71:20">mo yu mekem mi mi harem nogud,</para>
  <para style="q2" vid="PSA 71:20">be mi mi save</para>
  <para style="q3" vid="PSA 71:20">we bambae yu mekem mi mi strong bakegen,</para>
  <para style="q4" vid="PSA 71:20">bambae yu holem mi <optbreak /> blong mi no go long beregraon.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Bambae yu stap leftemap nem blong mi</para>
  <para style="q3" vid="PSA 71:21">i kam hae moa,</para>
  <para style="q2" vid="PSA 71:21">bambae yu toktok gud long mi,</para>
  <para style="q4" vid="PSA 71:21">yu mekem mi mi harem gud bakegen.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />God blong mi,</para>
  <para style="q2" vid="PSA 71:22">bambae mi mas presem yu wetem gita,</para>
  <para style="q2" vid="PSA 71:22">bambae mi presem yu,</para>
  <para style="q3" vid="PSA 71:22">from we tingting blong yu i stap strong long mi oltaem.</para>
  <para style="q1" vid="PSA 71:22">Yu yu God blong mifala ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 71:22">mo yu tabu we yu tabu,</para>
  <para style="q2" vid="PSA 71:22">bambae mi plei long mandolin blong mi,</para>
  <para style="q4" vid="PSA 71:22">mi stap singim ol singsing blong presem yu.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Bambae mi stap singsingaot</para>
  <para style="q4" vid="PSA 71:23">from we mi mi glad,</para>
  <para style="q2" vid="PSA 71:23">bambae mi stap singsing long olgeta tingting blong mi,</para>
  <para style="q4" vid="PSA 71:23">from we yu yu sevem mi.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Oltaem bambae mi stap tokbaot</para>
  <para style="q3" vid="PSA 71:24">ol stret fasin blong yu,</para>
  <para style="q2" vid="PSA 71:24">i stat long moning</para>
  <para style="q4" vid="PSA 71:24">go kasem long sapa,</para>
  <para style="q2" vid="PSA 71:24">from we olgeta ya</para>
  <para style="q4" vid="PSA 71:24">we oli traem blong spolem mi,</para>
  <para style="q3" vid="PSA 71:24">yu yu winim olgeta finis,</para>
  <para style="q3" vid="PSA 71:24">yu mekem olgeta oli sem.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">Prea we ol man i mekem blong God i blesem king</para>
  <para style="sp">(Sing ya, Solomon i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />God.</para>
  <para style="q1" vid="PSA 72:1">Plis yu tijim king blong mifala</para>
  <para style="q3" vid="PSA 72:1">blong bambae hem i save jajem man</para>
  <para style="q4" vid="PSA 72:1">long stret fasin blong yu.</para>
  <para style="q1" vid="PSA 72:1">Hem i pikinini blong king.</para>
  <para style="q1" vid="PSA 72:1">Fasin blong yu blong jajem man</para>
  <para style="q2" vid="PSA 72:1">hem i stret olgeta.</para>
  <para style="q1" vid="PSA 72:1">Plis yu givim fasin ya long hem,<verse eid="PSA 72:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 72:2" />blong bambae hem i stap jajem <optbreak /> mifala ol man blong yu,</para>
  <para style="q4" vid="PSA 72:2">long stret fasin,</para>
  <para style="q3" vid="PSA 72:2">mo bambae hem i mekem i stret gud <optbreak /> long ol puaman</para>
  <para style="q4" vid="PSA 72:2">we ol narafala man oli stap spolem olgeta.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Yu mekem we mifala long kantri ya,</para>
  <para style="q2" vid="PSA 72:3">mifala i gat gudfala laef,</para>
  <para style="q3" vid="PSA 72:3">mifala i stap harem gud</para>
  <para style="q4" vid="PSA 72:3">from ol stret fasin blong hem.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Plis yu mekem</para>
  <para style="q2" vid="PSA 72:4">we hem bambae i stap jajem ol puaman</para>
  <para style="q4" vid="PSA 72:4">long fasin we i stret,</para>
  <para style="q3" vid="PSA 72:4">mo i stap halpem ol man</para>
  <para style="q3" vid="PSA 72:4">we oli sot long ol samting,</para>
  <para style="q4" vid="PSA 72:4">mo i stap daonem ol man <optbreak /> we oli stap spolem ol puaman ya.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Plis yu mekem</para>
  <para style="q2" vid="PSA 72:5">we ol man blong yu</para>
  <para style="q3" vid="PSA 72:5">oli stap mekem wosip long yu oltaem,</para>
  <para style="q3" vid="PSA 72:5">olsem we san mo mun,</para>
  <para style="q4" vid="PSA 72:5">tufala i stap saen oltaem</para>
  <para style="q3" vid="PSA 72:5">we tufala i no save lus.<verse eid="PSA 72:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Plis yu mekem we fasin blong king ya</para>
  <para style="q2" vid="PSA 72:6">bambae i olsem ren we i folfoldaon</para>
  <para style="q4" vid="PSA 72:6">long garen we man i jes planem,</para>
  <para style="q3" vid="PSA 72:6">i mekem graon blong hem i wetwet.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Yu mekem we long taem blong hem,</para>
  <para style="q2" vid="PSA 72:7">bambae stret fasin i kam bigwan long kantri blong mifala,</para>
  <para style="q3" vid="PSA 72:7">mo mifala i gat gudfala laef oltaem,</para>
  <para style="q4" vid="PSA 72:7">olsem we mun i stap saen oltaem.<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72.8: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 9:10">Sek 9.10</ref>
      </char>
    </note>Bambae hem i king long olgeta ples,</para>
  <para style="q2" vid="PSA 72:8">i stat long solwota narasaed,</para>
  <para style="q3" vid="PSA 72:8">i go kasem solwota narasaed,</para>
  <para style="q2" vid="PSA 72:8">i stat long Yufretes Reva,</para>
  <para style="q3" vid="PSA 72:8">i go kasem en blong wol.<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Ol man blong draeples</para>
  <para style="q2" vid="PSA 72:9">bambae oli bodaon long fes blong hem.</para>
  <para style="q1" vid="PSA 72:9">Ol enemi blong hem</para>
  <para style="q2" vid="PSA 72:9">bambae oli foldaon long graon</para>
  <para style="q3" vid="PSA 72:9">blong ona long hem.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Ol king blong Spen</para>
  <para style="q3" vid="PSA 72:10">mo ol king blong ol aelan</para>
  <para style="q2" vid="PSA 72:10">bambae oli stap givim ol presen long hem.</para>
  <para style="q1" vid="PSA 72:10">Ol king blong Arebia</para>
  <para style="q3" vid="PSA 72:10">mo ol king blong Itiopia</para>
  <para style="q2" vid="PSA 72:10">bambae oli stap tekem ol presen i kam long hem.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Olgeta king bambae oli stap bodaon</para>
  <para style="q3" vid="PSA 72:11">long fes blong hem.</para>
  <para style="q1" vid="PSA 72:11">Mo olgeta man long wol</para>
  <para style="q4" vid="PSA 72:11">bambae oli stap wok blong hem.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Hem bambae i stap sevem ol puaman</para>
  <para style="q2" vid="PSA 72:12">we oli stap singaot i go long hem,</para>
  <para style="q2" vid="PSA 72:12">mo bambae i stap givhan long olgeta</para>
  <para style="q3" vid="PSA 72:12">we oli sot long ol samting,</para>
  <para style="q4" vid="PSA 72:12">mo i no gat man blong lukaot long olgeta.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Hem bambae i gat sore long ol puaman,</para>
  <para style="q3" vid="PSA 72:13">mo long olgeta we oli no strong,</para>
  <para style="q2" vid="PSA 72:13">mo i stap sevem laef blong olgeta</para>
  <para style="q4" vid="PSA 72:13">we oli sot long ol samting.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Olgeta we oli stap harem nogud</para>
  <para style="q3" vid="PSA 72:14">aninit long han blong narafala man,</para>
  <para style="q2" vid="PSA 72:14">hem bambae i tekemaot olgeta,</para>
  <para style="q4" vid="PSA 72:14">i sevem olgeta.</para>
  <para style="q1" vid="PSA 72:14">Long fes blong hem,</para>
  <para style="q2" vid="PSA 72:14">laef blong ol man olsem bambae i gud tumas.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />God,</para>
  <para style="q2" vid="PSA 72:15">plis yu mekem laef blong hem i kam longfala.</para>
  <para style="q1" vid="PSA 72:15">Yu mekem we ol man Arebia</para>
  <para style="q2" vid="PSA 72:15">bambae oli kam givim gol long hem.</para>
  <para style="q1" vid="PSA 72:15">Yu mekem we oltaem</para>
  <para style="q2" vid="PSA 72:15">ol man bambae oli stap prea from hem,</para>
  <para style="q3" vid="PSA 72:15">mo yu blesem hem oltaem.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Yu mekem we bambae i gat plante kakae long ples ya,</para>
  <para style="q2" vid="PSA 72:16">we bambae ol hil oli fulap gud long hem.</para>
  <para style="q1" vid="PSA 72:16">Yu mekem we graon blong mifala</para>
  <para style="q3" vid="PSA 72:16">bambae i karem plante kakae</para>
  <para style="q4" vid="PSA 72:16">olsem gudfala graon ya</para>
  <para style="q3" vid="PSA 72:16">long Lebanon,</para>
  <para style="q2" vid="PSA 72:16">mo we ol taon blong mifala</para>
  <para style="q3" vid="PSA 72:16">bambae oli fulap gud long man</para>
  <para style="q4" vid="PSA 72:16">olsem we open ples i fulap gud long gras.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Yu mekem we ol man bambae oli no save fogetem</para>
  <para style="q3" vid="PSA 72:17">nem blong king ya samtaem,</para>
  <para style="q2" vid="PSA 72:17">mo we hae nem blong hem</para>
  <para style="q3" vid="PSA 72:17">bambae i stap oltaem,</para>
  <para style="q4" vid="PSA 72:17">olsem we san i stap oltaem.</para>
  <para style="q1" vid="PSA 72:17">Yu mekem we olgeta man long wol</para>
  <para style="q2" vid="PSA 72:17">bambae oli stap askem long yu</para>
  <para style="q3" vid="PSA 72:17">blong yu blesem olgeta,</para>
  <para style="q4" vid="PSA 72:17">olsem we yu stap blesem king ya.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Hae God,</para>
  <para style="q2" vid="PSA 72:18">yu yu God blong mifala ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 72:18">mo mifala i presem yu.</para>
  <para style="q1" vid="PSA 72:18">Yu nomo yu save mekem ol bigbigfala wok ya.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Oltaem bambae mifala i stap presem</para>
  <para style="q2" vid="PSA 72:19">hae nem blong yu,</para>
  <para style="q3" vid="PSA 72:19">gogo i no save finis.</para>
  <para style="q1" vid="PSA 72:19">Mifala i wantem</para>
  <para style="q2" vid="PSA 72:19">we bigfala paoa blong yu we yu yu King,</para>
  <para style="q2" vid="PSA 72:19">bambae i kavremap olgeta ples long wol ya.</para>
  <para style="q1" vid="PSA 72:19">!Amen!</para>
  <para style="q1" vid="PSA 72:19">!Amen!<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Hemia en blong ol prea blong</para>
  <para style="q2" vid="PSA 72:20">King Deved, pikinini blong Jese.<verse eid="PSA 72:20" /></para>
  <para style="b" />
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">BUK TRI</para>
  <para style="mr">(<ref loc="PSA 73-89">Sam 73—89</ref>)</para>
  <para style="s">God i stap mekem ol stret fasin</para>
  <para style="sp">(Sing ya, Asaf i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Tru,</para>
  <para style="q2" vid="PSA 73:1">God i gud tumas long yumi ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 73:1">we tingting blong yumi i klin gud.<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Be mi,</para>
  <para style="q2" vid="PSA 73:2">klosap tingting blong mi</para>
  <para style="q3" vid="PSA 73:2">i no moa stap long hem,</para>
  <para style="q4" vid="PSA 73:2">bilif blong mi klosap i lus,<verse eid="PSA 73:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 73:3" />from we taem mi luk ol man nogud ya</para>
  <para style="q3" vid="PSA 73:3">we ol samting long laef blong olgeta</para>
  <para style="q4" vid="PSA 73:3">oli stap ron gud nomo,</para>
  <para style="q3" vid="PSA 73:3">mo oli stap praod from,</para>
  <para style="q2" vid="PSA 73:3">mi mi jalus long olgeta.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Olgeta ya oli no stap harem nogud</para>
  <para style="q3" vid="PSA 73:4">long bodi blong olgeta,</para>
  <para style="q2" vid="PSA 73:4">oli no stap sik,</para>
  <para style="q4" vid="PSA 73:4">bodi blong olgeta i strong olwe nomo.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Oli no stap harem nogud</para>
  <para style="q3" vid="PSA 73:5">olsem ol narafala man,</para>
  <para style="q2" vid="PSA 73:5">oli no stap kasem trabol</para>
  <para style="q4" vid="PSA 73:5">olsem we olgeta ya oli stap kasem.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Olgeta oli stap praod tumas from,</para>
  <para style="q2" vid="PSA 73:6">mo fasin ya blong praod blong olgeta</para>
  <para style="q4" vid="PSA 73:6">i olsem jen we oli stap hangem long nek blong olgeta,</para>
  <para style="q3" vid="PSA 73:6">mo fasin blong olgeta blong faet</para>
  <para style="q3" vid="PSA 73:6">i olsem klos blong olgeta.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Oltaem ol rabis samting i stap kamaot</para>
  <para style="q3" vid="PSA 73:7">long tingting blong olgeta,</para>
  <para style="q2" vid="PSA 73:7">mo oltaem maen blong olgeta</para>
  <para style="q4" vid="PSA 73:7">i fulap long ol rabis plan.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Oli stap laf long ol narafala man,</para>
  <para style="q2" vid="PSA 73:8">mo oli stap tokbaot ol samting nogud.</para>
  <para style="q1" vid="PSA 73:8">Oli praod tumas,</para>
  <para style="q2" vid="PSA 73:8">mo oli stap mekem plan blong mekem i nogud</para>
  <para style="q3" vid="PSA 73:8">long ol narafala man.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />God i stap long heven,</para>
  <para style="q2" vid="PSA 73:9">be oli stap tok nogud long hem,</para>
  <para style="q3" vid="PSA 73:9">mo oli stap mekem flas blong olgeta,</para>
  <para style="q4" vid="PSA 73:9">se oli bos long ol man long wol.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Nao ol man blong God tu</para>
  <para style="q3" vid="PSA 73:10">oli stap folem olgeta,</para>
  <para style="q2" vid="PSA 73:10">mo oli bilif tumas long olgeta samting ya</para>
  <para style="q4" vid="PSA 73:10">we ol man ya oli stap talem.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Ol man nogud ya oli talem se,</para>
  <para style="q1" vid="PSA 73:11">“!God i hae we i hae,</para>
  <para style="q2" vid="PSA 73:11">be hem bambae i no save samting ya!</para>
  <para style="q1" vid="PSA 73:11">!Hem i no save faenemaot ya!”<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Hemia nao fasin blong olgeta.</para>
  <para style="q1" vid="PSA 73:12">Olgeta oli gat plante samting,</para>
  <para style="q2" vid="PSA 73:12">mo oltaem oli stap tekem plante samting moa.<verse eid="PSA 73:12" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="13-15" style="v" sid="PSA 73:13-15" />God.</para>
  <para style="q1" vid="PSA 73:13-15">Maet i gat man i save tok kros long yu,</para>
  <para style="q2" vid="PSA 73:13-15">i talem se, “!Yu luk!</para>
  <para style="q1" vid="PSA 73:13-15">Mi mi stap holem tingting blong mi i klin,</para>
  <para style="q3" vid="PSA 73:13-15">mi no stap mekem sin,</para>
  <para style="q4" vid="PSA 73:13-15">be hemia i blong nating nomo.</para>
  <para style="q1" vid="PSA 73:13-15">Oltaem yu yu stap mekem mi mi harem nogud,</para>
  <para style="q2" vid="PSA 73:13-15">i stat long moning, gogo i kasem long sapa.</para>
  <para style="q1" vid="PSA 73:13-15">Evri moning, yu yu stap panisim mi.”</para>
  <para style="q1" vid="PSA 73:13-15">Be sipos mi mi stap tok olsem,</para>
  <para style="q2" vid="PSA 73:13-15">hemia i min se mi mi no man blong yu.<verse eid="PSA 73:13-15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Mi traem tingting long ol samting ya,</para>
  <para style="q2" vid="PSA 73:16">be i had tumas long mi,<verse eid="PSA 73:16" /></para>
  <para style="q3">
    <verse number="17" style="v" sid="PSA 73:17" />gogo kasem we mi go insaed long haos* blong yu,</para>
  <para style="q2" vid="PSA 73:17">nao mi jes luksave ol samting</para>
  <para style="q3" vid="PSA 73:17">we bambae i kasem ol man nogud ya.<verse eid="PSA 73:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Bambae yu yu putum olgeta</para>
  <para style="q3" vid="PSA 73:18">long ol ples we i glis,</para>
  <para style="q2" vid="PSA 73:18">bambae yu mekem olgeta oli foldaon,</para>
  <para style="q4" vid="PSA 73:18">oli kam nogud olgeta.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Bambae yu spolem olgeta kwiktaem nomo,</para>
  <para style="q2" vid="PSA 73:19">bambae oli godaon long ples we i nogud olgeta.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Masta<note caller="+" style="f"><char style="fr" closed="false">73.20: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long 35.22.</char></note>,</para>
  <para style="q2" vid="PSA 73:20">bambae olgeta oli olsem drim,</para>
  <para style="q3" vid="PSA 73:20">we long moning i lus.</para>
  <para style="q1" vid="PSA 73:20">Taem yu yu girap,</para>
  <para style="q2" vid="PSA 73:20">olgeta ya bambae oli lus wantaem nomo.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Taem we oli spolem tingting blong mi,</para>
  <para style="q2" vid="PSA 73:21">mo oli mekem mi mi harem nogud tumas,<verse eid="PSA 73:21" /></para>
  <para style="q3">
    <verse number="22" style="v" sid="PSA 73:22" />mi mi krangke, mi olsem anamol nomo,</para>
  <para style="q4" vid="PSA 73:22">i strong blong mi save tingting blong yu.<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Be oltaem mi mi stap klosap long yu,</para>
  <para style="q2" vid="PSA 73:23">mo yu stap holem mi long han blong mi.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Yu yu stap lidim mi</para>
  <para style="q3" vid="PSA 73:24">long ol toktok blong yu,</para>
  <para style="q2" vid="PSA 73:24">mo biaen, bambae yu ona long mi,</para>
  <para style="q4" vid="PSA 73:24">yu tekem mi mi go stap wetem yu.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />God,</para>
  <para style="q2" vid="PSA 73:25">i no gat wan samting long heven</para>
  <para style="q3" vid="PSA 73:25">we mi mi save putum tingting blong mi i stap long hem,</para>
  <para style="q2" vid="PSA 73:25">yu nomo.</para>
  <para style="q1" vid="PSA 73:25">!Mo from we yu yu God blong mi,</para>
  <para style="q2" vid="PSA 73:25">i no moa gat wan samting long graon ya tu</para>
  <para style="q3" vid="PSA 73:25">we mi save putum tingting blong mi i stap long hem!<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Tingting blong mi</para>
  <para style="q2" vid="PSA 73:26">mo bodi blong mi i save kam slak,</para>
  <para style="q3" vid="PSA 73:26">be yu yu paoa blong mi,</para>
  <para style="q4" vid="PSA 73:26">yu nomo we mi mi wantem</para>
  <para style="q3" vid="PSA 73:26">oltaem long laef blong mi.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27-28" style="v" sid="PSA 73:27-28" />Hae God, yu yu God blong mi,</para>
  <para style="q2" vid="PSA 73:27-28">mo yu yu Masta* blong mi.</para>
  <para style="q1" vid="PSA 73:27-28">Ol man we oli lego yu,</para>
  <para style="q2" vid="PSA 73:27-28">mi mi savegud se bambae oli lus.</para>
  <para style="q1" vid="PSA 73:27-28">Olgeta ya we oli no moa holem promes</para>
  <para style="q3" vid="PSA 73:27-28">we oli mekem wetem yu,</para>
  <para style="q2" vid="PSA 73:27-28">yu bambae yu spolem olgeta.</para>
  <para style="q1" vid="PSA 73:27-28">Taem we mi mi kam stap klosap long yu,</para>
  <para style="q2" vid="PSA 73:27-28">mi harem se i gud tumas long mi.</para>
  <para style="q1" vid="PSA 73:27-28">Yu yu sefples blong mi,</para>
  <para style="q3" vid="PSA 73:27-28">yu yu stap blokem mi,</para>
  <para style="q2" vid="PSA 73:27-28">mo oltaem</para>
  <para style="q3" vid="PSA 73:27-28">bambae mi mi stap talemaot</para>
  <para style="q4" vid="PSA 73:27-28">olgeta samting we yu yu mekem.<verse eid="PSA 73:27-28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">Man i prea blong God i givhan long ol man blong hem</para>
  <para style="sp">(Sing ya, wan laen blong Asaf i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />!God!</para>
  <para style="q1" vid="PSA 74:1">?From wanem yu lego mifala olsemia?</para>
  <para style="q1" vid="PSA 74:1">!Mifala i man blong yu nomo!</para>
  <para style="q1" vid="PSA 74:1">?Olsem wanem?</para>
  <para style="q1" vid="PSA 74:1">?Bambae yu stap kros long mifala oltaem nomo?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Plis yu tingbaot mifala.</para>
  <para style="q1" vid="PSA 74:2">Yu yu jusumaot mifala longtaem finis,</para>
  <para style="q2" vid="PSA 74:2">se mifala i man blong yu.</para>
  <para style="q1" vid="PSA 74:2">Bifo, mifala i stap wok slef* nomo,</para>
  <para style="q2" vid="PSA 74:2">be yu yu tekemaot mifala,</para>
  <para style="q3" vid="PSA 74:2">yu makemaot mifala long laen ya,</para>
  <para style="q3" vid="PSA 74:2">se mifala i man blong yu.</para>
  <para style="q1" vid="PSA 74:2">Plis yu tingbaot hil ya Saeon*</para>
  <para style="q2" vid="PSA 74:2">we yu stap long hem bifo.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Ol enemi blong mifala</para>
  <para style="q2" vid="PSA 74:3">oli spolemgud evri samting long haos* blong yu.</para>
  <para style="q1" vid="PSA 74:3">I gud yu kam,</para>
  <para style="q2" vid="PSA 74:3">yu wokbaot long ples ya, yu lukluk.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Ol enemi blong yu oli win finis,</para>
  <para style="q2" vid="PSA 74:4">oli stap long haos blong yu,</para>
  <para style="q3" vid="PSA 74:4">oli stap singsingaot bigwan.</para>
  <para style="q1" vid="PSA 74:4">Oli pulum ol flaeg blong olgeta</para>
  <para style="q2" vid="PSA 74:4">long ples ya finis,</para>
  <para style="q3" vid="PSA 74:4">blong soemaot we oli win.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Oli stap mekem olsem ol man</para>
  <para style="q3" vid="PSA 74:5">blong katemdaon tri,</para>
  <para style="q2" vid="PSA 74:5">we oli stap daonem ol tri</para>
  <para style="q4" vid="PSA 74:5">long akis blong olgeta.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Oli stap smasem ol plang blong haos blong yu</para>
  <para style="q2" vid="PSA 74:6">long ol akis mo ol bigbigfala hama blong olgeta.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Oli brekemdaon haos ya,</para>
  <para style="q2" vid="PSA 74:7">nao oli putum faea long hem.</para>
  <para style="q1" vid="PSA 74:7">Ples ya we ol man oli stap mekem wosip long yu long hem,</para>
  <para style="q2" vid="PSA 74:7">oli spolem,</para>
  <para style="q3" vid="PSA 74:7">oli mekem i no moa tabu.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Oli wantem flatemgud mifala,</para>
  <para style="q2" vid="PSA 74:8">nao oli bonem evri ples long kantri ya</para>
  <para style="q3" vid="PSA 74:8">we mifala i stap go long hem</para>
  <para style="q4" vid="PSA 74:8">blong mekem wosip long yu.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Olgeta saen blong soemaot paoa blong yu long mifala</para>
  <para style="q3" vid="PSA 74:9">i finis.</para>
  <para style="q1" vid="PSA 74:9">Naoia i no moa gat profet i stap,</para>
  <para style="q2" vid="PSA 74:9">mo i no moa gat man we i save talemaot</para>
  <para style="q3" vid="PSA 74:9">we trabol ya bambae i stap olsem</para>
  <para style="q3" vid="PSA 74:9">go kasem wetaem.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />God.</para>
  <para style="q1" vid="PSA 74:10">?Bambae ol enemi blong mifala</para>
  <para style="q2" vid="PSA 74:10">oli stap laf long yu gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 74:10">?Olsem wanem?</para>
  <para style="q1" vid="PSA 74:10">?Bambae oli stap tok nogud</para>
  <para style="q2" vid="PSA 74:10">long nem blong yu oltaem nomo?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />?From wanem</para>
  <para style="q2" vid="PSA 74:11">yu no wantem givhan long mifala?</para>
  <para style="q1" vid="PSA 74:11">?From wanem yu no mekem wan samting</para>
  <para style="q2" vid="PSA 74:11">blong halpem mifala?<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />God, yu yu King blong mifala.</para>
  <para style="q1" vid="PSA 74:12">I stat bifo olgeta,</para>
  <para style="q2" vid="PSA 74:12">yu yu sevem mifala plante taem finis.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74.13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Eks 14.21</ref>
      </char>
    </note>Long bigfala paoa blong yu,</para>
  <para style="q3" vid="PSA 74:13">yu mekem solwota i gowe,</para>
  <para style="q2" vid="PSA 74:13">mo yu smasem hed</para>
  <para style="q4" vid="PSA 74:13">blong ol bigbigfala anamol ya blong solwota.<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74.14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 41:1">Job 41.1</ref>; <ref loc="PSA 104:26">Sam 104.26</ref>; <ref loc="ISA 27:1">Aes 27.1</ref></char>
    </note>Yu smasem ol hed blong bigfala anamol ya Leviatan,*</para>
  <para style="q2" vid="PSA 74:14">mo yu givim bodi blong hem long ol anamol blong draeples</para>
  <para style="q4" vid="PSA 74:14">blong oli kakae.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Ol springwota mo ol reva,</para>
  <para style="q3" vid="PSA 74:15">yu mekem olgeta oli stap ron,</para>
  <para style="q2" vid="PSA 74:15">mo ol bigfala reva we neva oli drae samtaem,</para>
  <para style="q4" vid="PSA 74:15">yu mekem oli drae.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Yu yu mekem dei mo naet,</para>
  <para style="q2" vid="PSA 74:16">mo yu putum san mo mun</para>
  <para style="q3" vid="PSA 74:16">long ples blong tufala.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Yu makem ol ples</para>
  <para style="q3" vid="PSA 74:17">we wol i go finis long hem,</para>
  <para style="q2" vid="PSA 74:17">mo yu mekem kol taem mo hot taem.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />Hae God,</para>
  <para style="q2" vid="PSA 74:18">yu mas tingbaot</para>
  <para style="q3" vid="PSA 74:18">we ol enemi blong yu</para>
  <para style="q4" vid="PSA 74:18">oli stap laf long yu.</para>
  <para style="q1" vid="PSA 74:18">Olgeta ya oli no bilif long yu,</para>
  <para style="q2" vid="PSA 74:18">mo oli stap tok nogud long nem blong yu.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Plis yu no letem</para>
  <para style="q2" vid="PSA 74:19">mifala i go long han blong ol enemi ya blong mifala</para>
  <para style="q4" vid="PSA 74:19">we fasin blong olgeta i strong tumas.</para>
  <para style="q1" vid="PSA 74:19">Yu no fogetem mifala</para>
  <para style="q2" vid="PSA 74:19">we ol man ya oli stap ronem mifala.<verse eid="PSA 74:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Plis yu tingbaot promes* ya</para>
  <para style="q2" vid="PSA 74:20">we yu mekem wetem mifala.</para>
  <para style="q1" vid="PSA 74:20">Naoia i gat fulap faet i stap</para>
  <para style="q2" vid="PSA 74:20">long olgeta ples we ol man oli stap long tudak.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Mifala i stap harem nogud</para>
  <para style="q2" vid="PSA 74:21">aninit long han blong ol enemi ya.</para>
  <para style="q1" vid="PSA 74:21">Plis yu no letem mifala i sem.</para>
  <para style="q1" vid="PSA 74:21">Mifala i puaman,</para>
  <para style="q2" vid="PSA 74:21">mifala i sot long plante samting.</para>
  <para style="q1" vid="PSA 74:21">Plis yu mekem rod blong mifala i presem yu.<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />God,</para>
  <para style="q2" vid="PSA 74:22">plis yu talemaot we yu yu stret.</para>
  <para style="q1" vid="PSA 74:22">Yu mas tingbaot</para>
  <para style="q2" vid="PSA 74:22">we ol man we oli no save yu</para>
  <para style="q3" vid="PSA 74:22">oltaem oli stap laf long yu,</para>
  <para style="q4" vid="PSA 74:22">i stat long moning,</para>
  <para style="q3" vid="PSA 74:22">gogo kasem long sapa.<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Ol enemi ya blong yu we oli kros,</para>
  <para style="q2" vid="PSA 74:23">oli stap singsingaot.</para>
  <para style="q1" vid="PSA 74:23">Noes blong olgeta i stap gohed oltaem.</para>
  <para style="q1" vid="PSA 74:23">Plis yu no fogetem olgeta.</para>
  <para style="q1" vid="PSA 74:23">Yu kam, yu panisim olgeta.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">God bambae i jajem ol man</para>
  <para style="sp">(Sing ya, Asaf i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />God,</para>
  <para style="q2" vid="PSA 75:1">mifala i talem tangkiu long yu,</para>
  <para style="q3" vid="PSA 75:1">mifala i talem tangkiu tumas long yu.</para>
  <para style="q1" vid="PSA 75:1">Mifala i stap talemaot</para>
  <para style="q3" vid="PSA 75:1">we yu yu hae we yu hae,</para>
  <para style="q2" vid="PSA 75:1">mo mifala i stap tokbaot</para>
  <para style="q4" vid="PSA 75:1">ol gudgudfala samting we yu yu mekem.<verse eid="PSA 75:1" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />God i talem se,</para>
  <para style="q2" vid="PSA 75:2">“Mi mi putum taem finis</para>
  <para style="q4" vid="PSA 75:2">blong jajem ol man,</para>
  <para style="q3" vid="PSA 75:2">mo bambae mi jajem olgeta</para>
  <para style="q3" vid="PSA 75:2">long stret fasin.<verse eid="PSA 75:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 75:3" />Nating we evri samting we i laef</para>
  <para style="q3" vid="PSA 75:3">bambae oli seksek,</para>
  <para style="q4" vid="PSA 75:3">mo graon bambae i muf,</para>
  <para style="q3" vid="PSA 75:3">be bambae mi mi holem fandesen blong wol ya</para>
  <para style="q3" vid="PSA 75:3">i stap strong.<verse eid="PSA 75:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 75:4" />Naoia mi mi talem long ol man nogud,</para>
  <para style="q4" vid="PSA 75:4">se oli no moa praod,<verse eid="PSA 75:4" /></para>
  <para style="q3">
    <verse number="5" style="v" sid="PSA 75:5" />mo mi talem stret long olgeta,</para>
  <para style="q3" vid="PSA 75:5">se oli no moa tok flas.”<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Fasin blong jajem man</para>
  <para style="q2" vid="PSA 75:6">i no save kamaot long is mo long wes,</para>
  <para style="q3" vid="PSA 75:6">mo long not mo long saot,<verse eid="PSA 75:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 75:7" />God nomo bambae i jajem ol man.</para>
  <para style="q1" vid="PSA 75:7">Hem bambae i talemaot</para>
  <para style="q2" vid="PSA 75:7">we sam man bambae oli panis,</para>
  <para style="q3" vid="PSA 75:7">mo sam bambae oli no panis.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Hae God i stap holem wan kap</para>
  <para style="q2" vid="PSA 75:8">we i fulap gud long waen we i strong,</para>
  <para style="q4" vid="PSA 75:8">we i blong spolemgud olgeta,</para>
  <para style="q3" vid="PSA 75:8">we hemia i pija blong soemaot we hem i kros.</para>
  <para style="q1" vid="PSA 75:8">Hem bambae i kafsaedem waen ya,</para>
  <para style="q2" vid="PSA 75:8">nao olgeta man nogud bambae oli dring</para>
  <para style="q3" vid="PSA 75:8">gogo oli finisimgud.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Be mi bambae mi stap tokbaot</para>
  <para style="q2" vid="PSA 75:9">God ya blong Jekob* oltaem nomo,</para>
  <para style="q3" vid="PSA 75:9">gogo i no save finis.</para>
  <para style="q1" vid="PSA 75:9">Bambae mi stap sing blong presem hem.<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />Hem bambae i brekem paoa</para>
  <para style="q2" vid="PSA 75:10">blong ol man nogud,</para>
  <para style="q3" vid="PSA 75:10">be ol stret man,</para>
  <para style="q4" vid="PSA 75:10">bambae hem i mekem olgeta</para>
  <para style="q3" vid="PSA 75:10">oli gat paoa moa.<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">Oltaem God i stap win</para>
  <para style="sp">(Sing ya, Asaf i wokem. Hemia i blong sing wetem stringban.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />Long Juda* mo long Isrel,*</para>
  <para style="q2" vid="PSA 76:1">olgeta man oli savegud ol wok blong God,</para>
  <para style="q3" vid="PSA 76:1">mo oli stap ona long nem blong hem.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Ples blong hem long Jerusalem*</para>
  <para style="q2" vid="PSA 76:2">i stap long hil ya Saeon.*<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Long ples ya nao,</para>
  <para style="q2" vid="PSA 76:3">hem i brebrekem ol ara ya</para>
  <para style="q3" vid="PSA 76:3">we ol enemi blong hem</para>
  <para style="q4" vid="PSA 76:3">oli stap sutum i kam,</para>
  <para style="q3" vid="PSA 76:3">mo i stap smasem ol sil*</para>
  <para style="q4" vid="PSA 76:3">mo ol naef blong faet</para>
  <para style="q3" vid="PSA 76:3">wetem ol narafala samting blong faet blong olgeta.<verse eid="PSA 76:3" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />God,</para>
  <para style="q2" vid="PSA 76:4">yu yu hae we yu hae.</para>
  <para style="q1" vid="PSA 76:4">Long taem ya we yu winim ol enemi blong yu,</para>
  <para style="q2" vid="PSA 76:4">mo yu aot long hil ya longwe,</para>
  <para style="q4" vid="PSA 76:4">yu kambak,</para>
  <para style="q3" vid="PSA 76:4">yu yu olsem wan hae king</para>
  <para style="q3" vid="PSA 76:4">we i gat olgeta paoa.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Ol soldia blong olgeta</para>
  <para style="q3" vid="PSA 76:5">oli strong man blong faet,</para>
  <para style="q2" vid="PSA 76:5">be yu yu kilim olgeta</para>
  <para style="q4" vid="PSA 76:5">mo yu tekemaot olting blong olgeta finis.</para>
  <para style="q1" vid="PSA 76:5">Naoia, oli ded finis,</para>
  <para style="q3" vid="PSA 76:5">oli stap slip,</para>
  <para style="q2" vid="PSA 76:5">olgeta paoa mo waes blong olgeta</para>
  <para style="q4" vid="PSA 76:5">i no save givhan long olgeta.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />God blong Jekob,*</para>
  <para style="q2" vid="PSA 76:6">long taem ya we yu yu tok strong long olgeta,</para>
  <para style="q3" vid="PSA 76:6">ol hos blong olgeta</para>
  <para style="q4" vid="PSA 76:6">wetem ol man we oli stap ron long ol hos ya,</para>
  <para style="q3" vid="PSA 76:6">oli folfoldaon, oli ded olgeta.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />God,</para>
  <para style="q2" vid="PSA 76:7">olgeta man oli fraet long yu.</para>
  <para style="q1" vid="PSA 76:7">Taem we yu yu kros,</para>
  <para style="q2" vid="PSA 76:7">i no gat man i save stanap long fes blong yu.<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8-9" style="v" sid="PSA 76:8-9" />Yu yu stap long heven,</para>
  <para style="q2" vid="PSA 76:8-9">be yu mekem olgeta man long wol</para>
  <para style="q3" vid="PSA 76:8-9">oli savegud tingting blong yu,</para>
  <para style="q4" vid="PSA 76:8-9">we yu yu no glad nating</para>
  <para style="q3" vid="PSA 76:8-9">long ol fasin nogud.</para>
  <para style="q1" vid="PSA 76:8-9">Taswe, taem yu girap blong jajem ol man,</para>
  <para style="q2" vid="PSA 76:8-9">mo blong sevem olgeta man ya</para>
  <para style="q3" vid="PSA 76:8-9">we oli stap harem nogud</para>
  <para style="q4" vid="PSA 76:8-9">aninit long han blong narafala man,</para>
  <para style="q2" vid="PSA 76:8-9">olgeta man long wol oli fraet,</para>
  <para style="q3" vid="PSA 76:8-9">oli stap kwaet.<verse eid="PSA 76:8-9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Ol man oli save kros long yu,</para>
  <para style="q2" vid="PSA 76:10">be taem frut blong kros ya i kamaot,</para>
  <para style="q3" vid="PSA 76:10">hem i narafala,</para>
  <para style="q4" vid="PSA 76:10">i mekem nem blong yu i go antap moa.</para>
  <para style="q1" vid="PSA 76:10">Olgeta we bambae oli stap laef</para>
  <para style="q3" vid="PSA 76:10">taem ol faet oli finis,</para>
  <para style="q2" vid="PSA 76:10">bambae oli stap holem ol lafet blong yu.<verse eid="PSA 76:10" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 76:11">mo yufala i mas givim</para>
  <para style="q3" vid="PSA 76:11">ol samting ya long hem</para>
  <para style="q4" vid="PSA 76:11">we yufala i promes blong givim.</para>
  <para style="q1" vid="PSA 76:11">Yufala long olgeta kantri ya</para>
  <para style="q2" vid="PSA 76:11">we i stap klosap,</para>
  <para style="q3" vid="PSA 76:11">yufala i mas tekem ol presen i kam long hem.</para>
  <para style="q1" vid="PSA 76:11">God i stap mekem ol man</para>
  <para style="q2" vid="PSA 76:11">oli fraet long hem.<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />Ol haeman we oli praod,</para>
  <para style="q2" vid="PSA 76:12">hem i stap daonem tingting blong olgeta,</para>
  <para style="q3" vid="PSA 76:12">mo ol hae king,</para>
  <para style="q4" vid="PSA 76:12">hem i stap mekem olgeta oli fraet.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">God i givhan long man we i harem nogud</para>
  <para style="sp">(Sing ya, Asaf i wokem blong givim long Jedutun we i lida blong kwaea.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Long laef blong mi,</para>
  <para style="q2" vid="PSA 77:1">mi mi stap krae bigwan long God.</para>
  <para style="q1" vid="PSA 77:1">Mi mi krae we mi krae,</para>
  <para style="q2" vid="PSA 77:1">mo hem i harem mi.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Taem trabol i kasem mi,</para>
  <para style="q2" vid="PSA 77:2">mi mi prea long Masta<note caller="+" style="f"><char style="fr" closed="false">77.2: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long Sam 35.22.</char></note> blong yumi.</para>
  <para style="q1" vid="PSA 77:2">I stat long sapa,</para>
  <para style="q3" vid="PSA 77:2">go kasem long moning,</para>
  <para style="q2" vid="PSA 77:2">mi stap leftemap han blong mi,</para>
  <para style="q4" vid="PSA 77:2">mi prea,</para>
  <para style="q3" vid="PSA 77:2">be tingting blong mi i no kam gud.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Nao taem mi tingbaot God,</para>
  <para style="q2" vid="PSA 77:3">mi pulum win blong mi from.</para>
  <para style="q1" vid="PSA 77:3">Oltaem, taem mi tingting long hem,</para>
  <para style="q2" vid="PSA 77:3">be tingting blong mi i stap foldaon.<verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Hem i mekem mi mi no save slip,</para>
  <para style="q2" vid="PSA 77:4">mi stap wekap gogo kasem delaet,</para>
  <para style="q3" vid="PSA 77:4">nao mi wari tumas, mi no save toktok.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Mi stap ting long ol dei</para>
  <para style="q2" vid="PSA 77:5">we i pas finis,</para>
  <para style="q3" vid="PSA 77:5">mo mi stap tingbaot ol yia</para>
  <para style="q4" vid="PSA 77:5">we i pas longtaem finis.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />Long naet,</para>
  <para style="q2" vid="PSA 77:6">mi stap tingting we mi tingting tumas,</para>
  <para style="q3" vid="PSA 77:6">mi stap tingting longtaem</para>
  <para style="q4" vid="PSA 77:6">long ol samting ya,</para>
  <para style="q3" vid="PSA 77:6">nao mi stap tingting se,<verse eid="PSA 77:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 77:7" />“?Naoia i olsem wanem?</para>
  <para style="q2" vid="PSA 77:7">?Bambae Masta* blong mifala i tanem baksaed long mifala</para>
  <para style="q3" vid="PSA 77:7">gogo i no save finis?</para>
  <para style="q2" vid="PSA 77:7">?Bambae hem i no moa save glad</para>
  <para style="q3" vid="PSA 77:7">long mifala bakegen?<verse eid="PSA 77:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 77:8" />?Olsem wanem?</para>
  <para style="q2" vid="PSA 77:8">?Hem i lego mifala finis?</para>
  <para style="q2" vid="PSA 77:8">?Ating hem i no moa lavem mifala?</para>
  <para style="q2" vid="PSA 77:8">Mi luk se promes blong hem</para>
  <para style="q3" vid="PSA 77:8">i no moa stanap nao.<verse eid="PSA 77:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 77:9" />Hem i fogetem mifala finis.</para>
  <para style="q2" vid="PSA 77:9">Naoia hem i no moa sore long mifala.</para>
  <para style="q2" vid="PSA 77:9">Bifo hem i kaen long mifala,</para>
  <para style="q3" vid="PSA 77:9">be naoia i kros long mifala bakegen.”<verse eid="PSA 77:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Nao mi tingting bakegen se,</para>
  <para style="q2" vid="PSA 77:10">“No, be ol tingting ya i min</para>
  <para style="q3" vid="PSA 77:10">se God i hae we i hae,</para>
  <para style="q4" vid="PSA 77:10">be i no moa gat paoa nao.</para>
  <para style="q2" vid="PSA 77:10">!Samting ya nao</para>
  <para style="q3" vid="PSA 77:10">i spolem tingting blong mi moa!”<verse eid="PSA 77:10" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Hae God.</para>
  <para style="q1" vid="PSA 77:11">Bambae mi mi stap tingbaot</para>
  <para style="q3" vid="PSA 77:11">ol bigbigfala wok blong yu,</para>
  <para style="q2" vid="PSA 77:11">mo ol merikel ya we yu yu mekem bifo.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Bambae mi stap tingting gud</para>
  <para style="q2" vid="PSA 77:12">long olgeta bigbigfala wok ya blong yu.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />God,</para>
  <para style="q2" vid="PSA 77:13">fasin blong yu i klin olgeta,</para>
  <para style="q3" vid="PSA 77:13">i tabu,</para>
  <para style="q4" vid="PSA 77:13">i no gat narafala god i stap</para>
  <para style="q3" vid="PSA 77:13">we i hae olsem yu.<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Yu yu God blong wokem merikel.</para>
  <para style="q1" vid="PSA 77:14">Yu yu soemaot paoa blong yu finis</para>
  <para style="q2" vid="PSA 77:14">long medel blong olgeta man.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Long paoa blong yu,</para>
  <para style="q2" vid="PSA 77:15">yu sevem ol laen* ya blong Jekob* mo ol laen blong Josef,</para>
  <para style="q4" vid="PSA 77:15">we olgeta oli man blong yu,</para>
  <para style="q3" vid="PSA 77:15">yu mekem olgeta oli stap gud.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />God,</para>
  <para style="q2" vid="PSA 77:16">taem solwota i luk yu, hem i fraet,</para>
  <para style="q3" vid="PSA 77:16">mo dipsi ya i fraet, i seksek.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Bigfala klaod blong ren i kam</para>
  <para style="q2" vid="PSA 77:17">nao i ren bigwan.</para>
  <para style="q1" vid="PSA 77:17">Tanda i faerap long skae,</para>
  <para style="q2" vid="PSA 77:17">mo laetning i kamaot long olgeta ples.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Yu yu mekem tanda ya i faerap bigwan,</para>
  <para style="q2" vid="PSA 77:18">mo yu mekem laetning ya i laet long olgeta ples long wol,</para>
  <para style="q3" vid="PSA 77:18">nao graon i fraet, i seksek.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Yu yu wokbaot long medel blong ol wef,</para>
  <para style="q2" vid="PSA 77:19">yu gokros long dip solwota go kasem narasaed,</para>
  <para style="q3" vid="PSA 77:19">be man i no save luk trak blong yu.<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Yu yu putum ol man blong yu</para>
  <para style="q3" vid="PSA 77:20">long han blong Moses mo Eron,</para>
  <para style="q2" vid="PSA 77:20">nao yu stap lidim olgeta</para>
  <para style="q3" vid="PSA 77:20">olsem we man blong lukaot long sipsip</para>
  <para style="q4" vid="PSA 77:20">i stap lidim ol sipsip blong hem.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">Fasin blong God mo fasin blong ol man blong hem</para>
  <para style="sp">(Sing ya, Asaf i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Ol man blong mi.</para>
  <para style="q1" vid="PSA 78:1">Yufala i lesin long ol tok ya blong mi</para>
  <para style="q3" vid="PSA 78:1">we bambae mi tijim yufala long hem,</para>
  <para style="q2" vid="PSA 78:1">yufala i lesin gud long ol samting ya</para>
  <para style="q3" vid="PSA 78:1">we bambae mi talem.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.2: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:35">Mat 13.35</ref>
      </char>
    </note>Bambae mi tijim yufala long ol parabol,</para>
  <para style="q2" vid="PSA 78:2">mo bambae mi talemaot mining</para>
  <para style="q3" vid="PSA 78:2">blong ol tokhaed ya blong bifo.<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />Hemia ol samting we yumi harem finis</para>
  <para style="q2" vid="PSA 78:3">mo we yumi save finis.</para>
  <para style="q1" vid="PSA 78:3">Ol samting ya,</para>
  <para style="q2" vid="PSA 78:3">ol papa blong yumi oli talem long yumi finis.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />Hae God i gat paoa,</para>
  <para style="q2" vid="PSA 78:4">mo hem i stap mekem ol merikel</para>
  <para style="q3" vid="PSA 78:4">mo ol bigbigfala wok.</para>
  <para style="q1" vid="PSA 78:4">Bambae yumi no haedem ol samting ya</para>
  <para style="q3" vid="PSA 78:4">long ol pikinini blong yumi,</para>
  <para style="q2" vid="PSA 78:4">oltaem yumi mas talemaot long olgeta.<verse eid="PSA 78:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />Hem i givim ol loa blong hem</para>
  <para style="q3" vid="PSA 78:5">wetem ol tok blong hem</para>
  <para style="q2" vid="PSA 78:5">long ol bubu blong yumi bifo.</para>
  <para style="q1" vid="PSA 78:5">Olgeta ya oli laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 78:5">mo hem i talem long olgeta</para>
  <para style="q4" vid="PSA 78:5">blong oli tijim ol pikinini blong olgeta long ol loa ya,<verse eid="PSA 78:5" /></para>
  <para style="q3">
    <verse number="6" style="v" sid="PSA 78:6" />blong ol smol bubu blong olgeta</para>
  <para style="q3" vid="PSA 78:6">oli save lanem ol loa ya,</para>
  <para style="q4" vid="PSA 78:6">nao oli save talemaot <optbreak /> long ol pikinini blong olgeta bakegen.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Long fasin ya,</para>
  <para style="q2" vid="PSA 78:7">olgeta ya tu oli save trastem God,</para>
  <para style="q3" vid="PSA 78:7">mo oli no save fogetem</para>
  <para style="q3" vid="PSA 78:7">ol samting we hem i bin mekem,</para>
  <para style="q4" vid="PSA 78:7">oltaem oli save obei long ol tok blong hem.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Nao long fasin ya,</para>
  <para style="q2" vid="PSA 78:8">olgeta oli no save kam olsem ol bubu blong olgeta bifo</para>
  <para style="q3" vid="PSA 78:8">we oli no save obei long God,</para>
  <para style="q4" vid="PSA 78:8">oli stap agens long hem.</para>
  <para style="q1" vid="PSA 78:8">Ol bubu ya blong olgeta,</para>
  <para style="q2" vid="PSA 78:8">neva oli putum tingting blong olgeta</para>
  <para style="q4" vid="PSA 78:8">i stap strong long God,</para>
  <para style="q3" vid="PSA 78:8">tingting blong olgeta</para>
  <para style="q3" vid="PSA 78:8">i no save stap strong long hem nating.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Ol laen blong Efrem*</para>
  <para style="q3" vid="PSA 78:9">oli rere long ol bonara blong olgeta blong oli faet,</para>
  <para style="q2" vid="PSA 78:9">be long dei blong faet,</para>
  <para style="q4" vid="PSA 78:9">oli girap oli ronwe.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Olgeta oli brekem promes ya</para>
  <para style="q3" vid="PSA 78:10">we oli bin mekem wetem God,</para>
  <para style="q2" vid="PSA 78:10">mo oli no wantem nating</para>
  <para style="q4" vid="PSA 78:10">blong obei long ol loa blong hem.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Oli fogetem ol samting ya</para>
  <para style="q3" vid="PSA 78:11">we hem i bin mekem bifo,</para>
  <para style="q2" vid="PSA 78:11">mo oli no moa tingbaot ol merikel ya</para>
  <para style="q4" vid="PSA 78:11">we hem i mekem long fes blong olgeta.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.12: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:8-12:32">Eks 7.8—12.32</ref>
      </char>
    </note>Long levelples ya Joan long Ijip,</para>
  <para style="q2" vid="PSA 78:12">hem i mekem plante merikel blong oli luk.<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Eks 14.21</ref>,<ref loc="EXO 14:22">22</ref></char>
    </note>Mo hem i mekem solwota i seraot long tu haf,</para>
  <para style="q2" vid="PSA 78:13">i kam olsem tu bigfala stonwol we i stanap,</para>
  <para style="q3" vid="PSA 78:13">mo ples i kam drae,</para>
  <para style="q2" vid="PSA 78:13">nao hem i tekem olgeta oli pas long medel,</para>
  <para style="q3" vid="PSA 78:13">oli gotru long narasaed.<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.14: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Eks 13.21</ref>,<ref loc="EXO 13:22">22</ref></char>
    </note>Long dei,</para>
  <para style="q2" vid="PSA 78:14">hem i yusum klaod blong lidim olgeta,</para>
  <para style="q3" vid="PSA 78:14">mo long naet, hem i lidim olgeta</para>
  <para style="q4" vid="PSA 78:14">long laet blong faea.<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />Taem oli stap long draeples,</para>
  <para style="q2" vid="PSA 78:15">tu taem hem i splitim bigfala ston i open,</para>
  <para style="q3" vid="PSA 78:15">nao bigfala wota we i stap daon olgeta</para>
  <para style="q4" vid="PSA 78:15">i sut i kam antap blong oli dring.<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.16: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Eks 17.1-7</ref>; <ref loc="NUM 20:2-13">Nam 20.2-13</ref></char>
    </note>Hem i mekem</para>
  <para style="q2" vid="PSA 78:16">we wota ya i kamaot long ston i ron i godaon,</para>
  <para style="q3" vid="PSA 78:16">we i olsem wan bigfala reva.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />God i hae we i hae,</para>
  <para style="q2" vid="PSA 78:17">be olgeta oli stap gohed yet</para>
  <para style="q3" vid="PSA 78:17">blong mekem sin agens long hem,</para>
  <para style="q4" vid="PSA 78:17">nao long draeples ya,</para>
  <para style="q3" vid="PSA 78:17">oltaem oli stap agens long hem.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.18: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:2-15">Eks 16.2-15</ref>; <ref loc="NUM 11:4-23">Nam 11.4-23</ref>,<ref loc="NUM 11:31-35">31-35</ref></char>
    </note>Oli stap mekem stronghed</para>
  <para style="q2" vid="PSA 78:18">blong traem hem long fasin ya</para>
  <para style="q3" vid="PSA 78:18">we oli talemstrong</para>
  <para style="q4" vid="PSA 78:18">se hem i mas givim kakae long olgeta</para>
  <para style="q3" vid="PSA 78:18">olsem we oli wantem.<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Oli stap tok agens long hem,</para>
  <para style="q2" vid="PSA 78:19">oli stap taltalem se,</para>
  <para style="q2" vid="PSA 78:19">“?Olsem wanem?</para>
  <para style="q2" vid="PSA 78:19">?God i save givim gudfala kakae long yumi</para>
  <para style="q4" vid="PSA 78:19">long draeples ya?<verse eid="PSA 78:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="PSA 78:20" />Yes, i tru,</para>
  <para style="q3" vid="PSA 78:20">hem i splitim ston,</para>
  <para style="q4" vid="PSA 78:20">nao wota i sut, i kamaot,</para>
  <para style="q3" vid="PSA 78:20">i ron bigwan.</para>
  <para style="q2" vid="PSA 78:20">?Be olsem wanem?</para>
  <para style="q2" vid="PSA 78:20">?Hem i save givim kakae tu long yumi?</para>
  <para style="q2" vid="PSA 78:20">?Yumi ol man blong hem,</para>
  <para style="q3" vid="PSA 78:20">be yufala i ting</para>
  <para style="q4" vid="PSA 78:20">se hem i save givim mit long yumi?”<verse eid="PSA 78:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />Nao taem Hae God i harem ol tok ya,</para>
  <para style="q2" vid="PSA 78:21">hem i kros,</para>
  <para style="q3" vid="PSA 78:21">nao i gohed i faerap gud long olgeta we faealaet,<verse eid="PSA 78:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 78:22" />from we oli no trastem hem,</para>
  <para style="q3" vid="PSA 78:22">mo oli no bilif</para>
  <para style="q4" vid="PSA 78:22">se bambae hem i save sevem olgeta.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Be hem i talem long ol doa blong skae</para>
  <para style="q3" vid="PSA 78:23">blong oli open,<verse eid="PSA 78:23" /></para>
  <para style="q2">
    <verse number="24" style="v" sid="PSA 78:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.24: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:31">Jon 6.31</ref>
      </char>
    </note>nao hem i tekem kakae ya</para>
  <para style="q4" vid="PSA 78:24">we i kamaot long heven,</para>
  <para style="q3" vid="PSA 78:24">i givim long olgeta.</para>
  <para style="q1" vid="PSA 78:24">Hem i sanem samting ya mana*</para>
  <para style="q2" vid="PSA 78:24">i kam long olgeta blong oli kakae.<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Kakae ya i kakae blong enjel,</para>
  <para style="q2" vid="PSA 78:25">mo hem i stap givim plante long olgeta</para>
  <para style="q3" vid="PSA 78:25">olsem we oli wantem.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />Mo long paoa blong hem,</para>
  <para style="q2" vid="PSA 78:26">hem i mekem win i blu i kam long is,</para>
  <para style="q3" vid="PSA 78:26">mo i mekem win i girap strong long saot,</para>
  <para style="q4" vid="PSA 78:26">i blu i kam.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />Nao hem i sanem ol pijin oli kamdaon long olgeta</para>
  <para style="q3" vid="PSA 78:27">we oli plante we plante</para>
  <para style="q4" vid="PSA 78:27">olsem sanbij long solwota,</para>
  <para style="q2" vid="PSA 78:27">nao ol man ya oli gat mit blong olgeta</para>
  <para style="q3" vid="PSA 78:27">we i fulap we i fulap</para>
  <para style="q4" vid="PSA 78:27">olsem doti nomo.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Ol pijin ya oli kam folfoldaon</para>
  <para style="q2" vid="PSA 78:28">long ples ya we oli stap long hem,</para>
  <para style="q3" vid="PSA 78:28">olbaot raon long ol haos tapolen blong olgeta,<verse eid="PSA 78:28" /></para>
  <para style="q4">
    <verse number="29" style="v" sid="PSA 78:29" />mo oli kakae,</para>
  <para style="q3" vid="PSA 78:29">nao oli harem gud.</para>
  <para style="q1" vid="PSA 78:29">Ol samting ya we oli wantem tumas,</para>
  <para style="q2" vid="PSA 78:29">hem i givim long olgeta.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Be taem we oli stap gohed long ol pijin ya yet</para>
  <para style="q3" vid="PSA 78:30">from we oli wantem tumas,<verse eid="PSA 78:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="PSA 78:31" />God i kros gud long olgeta,</para>
  <para style="q3" vid="PSA 78:31">nao i kilim ol prapa strong man blong olgeta,</para>
  <para style="q4" vid="PSA 78:31">we oli nambawan yang man blong olgeta.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Mo nating we God i stap mekem</para>
  <para style="q3" vid="PSA 78:32">ol samting ya long olgeta,</para>
  <para style="q2" vid="PSA 78:32">be oli gohed yet,</para>
  <para style="q3" vid="PSA 78:32">oli stap mekem ol samting nogud.</para>
  <para style="q1" vid="PSA 78:32">Nating we hem i stap mekem</para>
  <para style="q3" vid="PSA 78:32">ol merikel long fes blong olgeta,</para>
  <para style="q2" vid="PSA 78:32">be oli no save trastem hem.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Nao hem i katem laef blong olgeta i sotfala,</para>
  <para style="q2" vid="PSA 78:33">i kilim olgeta kwiktaem nomo long wan bigfala trabol.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />Mo evri taem,</para>
  <para style="q3" vid="PSA 78:34">taem we hem i kilim sam long olgeta,</para>
  <para style="q2" vid="PSA 78:34">olgeta we oli stap</para>
  <para style="q4" vid="PSA 78:34">oli tanem tingting blong olgeta,</para>
  <para style="q3" vid="PSA 78:34">nao oli folem tok blong hem,</para>
  <para style="q3" vid="PSA 78:34">mo oli stap prea strong long hem.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Olgeta oli luksave we God i hae we i hae,</para>
  <para style="q2" vid="PSA 78:35">mo hem i stap lukaot long olgeta,</para>
  <para style="q3" vid="PSA 78:35">i stap givhan long olgeta,</para>
  <para style="q4" vid="PSA 78:35">mo i stap sevem olgeta.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Be ol tok blong olgeta i blong giaman nomo,</para>
  <para style="q2" vid="PSA 78:36">i no gat wan samting we oli talem we i tru.<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.37: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:21">Wok 8.21</ref>
      </char>
    </note>Oli no holemgud tok blong hem,</para>
  <para style="q2" vid="PSA 78:37">mo oli no strong long promes blong olgeta</para>
  <para style="q3" vid="PSA 78:37">we oli mekem wetem hem.<verse eid="PSA 78:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Be God i gat sore long ol man blong hem,</para>
  <para style="q2" vid="PSA 78:38">mo i fogivim olgeta,</para>
  <para style="q3" vid="PSA 78:38">i tekemaot ol sin blong olgeta,</para>
  <para style="q4" vid="PSA 78:38">nao i no spolem olgeta.</para>
  <para style="q1" vid="PSA 78:38">Plante taem,</para>
  <para style="q2" vid="PSA 78:38">hem i holem kros blong hem.</para>
  <para style="q1" vid="PSA 78:38">Hem i kros tumas long olgeta</para>
  <para style="q2" vid="PSA 78:38">be i no letem i kamaot.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Hem i save</para>
  <para style="q2" vid="PSA 78:39">we olgeta oli man nomo we oli save ded.</para>
  <para style="q1" vid="PSA 78:39">Oli olsem win nomo</para>
  <para style="q2" vid="PSA 78:39">we i blu i kam nao i go.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Oltaem oli stap agensem hem</para>
  <para style="q3" vid="PSA 78:40">long draeples ya,</para>
  <para style="q2" vid="PSA 78:40">mo plante taem,</para>
  <para style="q3" vid="PSA 78:40">oli mekem hem i sore,</para>
  <para style="q4" vid="PSA 78:40">i harem nogud.<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />God ya blong yumi ol laen blong Isrel</para>
  <para style="q3" vid="PSA 78:41">hem i tabu,</para>
  <para style="q2" vid="PSA 78:41">be oltaem,</para>
  <para style="q3" vid="PSA 78:41">olgeta ya oli stap traem hem,</para>
  <para style="q4" vid="PSA 78:41">oli stap mekem hem i harem nogud.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Oli no moa tingbaot bigfala paoa blong hem,</para>
  <para style="q2" vid="PSA 78:42">mo dei ya we hem i tekemaot olgeta</para>
  <para style="q3" vid="PSA 78:42">long han blong ol enemi blong olgeta.<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />Long taem ya we oli stap</para>
  <para style="q3" vid="PSA 78:43">long levelples ya Joan,</para>
  <para style="q4" vid="PSA 78:43">long Ijip,</para>
  <para style="q2" vid="PSA 78:43">hem i mekem ol bigbigfala wok mo ol merikel.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.44: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Eks 7.17-21</ref>
      </char>
    </note>Hem i tanem ol reva long Ijip oli kam blad,</para>
  <para style="q2" vid="PSA 78:44">nao ol man Ijip oli no gat wota blong dring.<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.45 a: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:20-24">Eks 8.20-24</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:1-6">Eks 8.1-6</ref>
      </char>
    </note>Hem i sanem ol flae i kam fulap long ples blong olgeta</para>
  <para style="q3" vid="PSA 78:45">we i mekem olgeta oli harem nogud,</para>
  <para style="q2" vid="PSA 78:45">mo i sanem ol frog i kam</para>
  <para style="q4" vid="PSA 78:45">we oli spolemgud ples blong olgeta.<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.46: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Eks 10.12-15</ref>
      </char>
    </note>Hem i sanem ol lokis* oli kam kakae ol kakae blong olgeta,</para>
  <para style="q2" vid="PSA 78:46">blong spolemgud ol garen blong olgeta.<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.47: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Eks 9.22-25</ref>
      </char>
    </note>Hem i sanem ol ston blong aes*</para>
  <para style="q2" vid="PSA 78:47">we i folfoldaon olsem ren,</para>
  <para style="q3" vid="PSA 78:47">i kilim ol rop ya grep,*</para>
  <para style="q2" vid="PSA 78:47">mo i kilim ol figtri* blong olgeta</para>
  <para style="q3" vid="PSA 78:47">long aes blong wota blong naet.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Hem i kilim ol buluk blong olgeta</para>
  <para style="q2" vid="PSA 78:48">long ol ston blong aes ya,</para>
  <para style="q3" vid="PSA 78:48">mo i kilim ol sipsip mo ol nani blong olgeta long laetning.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49-51" style="v" sid="PSA 78:49-51" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.49-51: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Eks 12.29</ref>
      </char>
    </note>Hem i kros we i kros,</para>
  <para style="q2" vid="PSA 78:49-51">mo taem hem i letem kros blong hem i kam long olgeta,</para>
  <para style="q3" vid="PSA 78:49-51">hem i mekem we olgeta oli kasem bigfala trabol.</para>
  <para style="q1" vid="PSA 78:49-51">Hem i no moa holem kros blong hem,</para>
  <para style="q2" vid="PSA 78:49-51">i sanem ol enjel oli kam</para>
  <para style="q3" vid="PSA 78:49-51">blong kilim olgeta long wan sik.</para>
  <para style="q1" vid="PSA 78:49-51">Hem i no tingbaot laef blong olgeta nating.</para>
  <para style="q1" vid="PSA 78:49-51">Olgeta oli kamaot long laen blong Ham bifo,</para>
  <para style="q2" vid="PSA 78:49-51">mo hem i kilim olgeta fasbon pikinini boe blong olgeta</para>
  <para style="q3" vid="PSA 78:49-51">oli ded.<verse eid="PSA 78:49-51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.52: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:17-22">Eks 13.17-22</ref>
      </char>
    </note>Be long ol man blong hem,</para>
  <para style="q2" vid="PSA 78:52">hem i stap mekem olsem we man blong lukaot long sipsip,</para>
  <para style="q3" vid="PSA 78:52">i stap mekem long ol sipsip blong hem.</para>
  <para style="q1" vid="PSA 78:52">Hem i lidim olgeta oli aot long Ijip,</para>
  <para style="q2" vid="PSA 78:52">mo hem i stap lidim olgeta</para>
  <para style="q3" vid="PSA 78:52">taem oli stap wokbaot long draeples.<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.53: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:26-28">Eks 14.26-28</ref>
      </char>
    </note>Hem i lidim olgeta,</para>
  <para style="q2" vid="PSA 78:53">nao from samting ya oli no fraet nating,</para>
  <para style="q2" vid="PSA 78:53">oli wokbaot gud nomo, oli sef.</para>
  <para style="q1" vid="PSA 78:53">Be ol enemi blong olgeta,</para>
  <para style="q2" vid="PSA 78:53">solwota i kam kavremap olgeta,</para>
  <para style="q3" vid="PSA 78:53">i rolem olgeta oli ded.<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.54: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:17">Eks 15.17</ref>; <ref loc="JOS 3:14-17">Jos 3.14-17</ref></char>
    </note>Nao hem i tekem ol man blong hem</para>
  <para style="q2" vid="PSA 78:54">oli gotru long wan gudfala graon</para>
  <para style="q3" vid="PSA 78:54">we i tabu, i blong hem.</para>
  <para style="q1" vid="PSA 78:54">Ples ya i ples blong hil,</para>
  <para style="q2" vid="PSA 78:54">we hem nomo i winimaot long han blong ol hiten man</para>
  <para style="q4" vid="PSA 78:54">we oli bin stap long hem fastaem.<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.55: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 11:16-23">Jos 11.16-23</ref>
      </char>
    </note>Nao taem ol man ya blong hem</para>
  <para style="q3" vid="PSA 78:55">oli kam insaed long ples ya,</para>
  <para style="q2" vid="PSA 78:55">hem i stap ronemaot ol hiten man ya</para>
  <para style="q4" vid="PSA 78:55">long fes blong olgeta.</para>
  <para style="q1" vid="PSA 78:55">Nao hem i seraot ol graon blong ol hiten man ya</para>
  <para style="q3" vid="PSA 78:55">i go long ol laen blong ol man blong hem,</para>
  <para style="q2" vid="PSA 78:55">mo i letem ol man ya blong hem</para>
  <para style="q4" vid="PSA 78:55">oli mekem hom blong olgeta long ples blong olgeta.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.56: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:11-15">Jaj 2.11-15</ref>
      </char>
    </note>God i hae we i hae,</para>
  <para style="q2" vid="PSA 78:56">be olgeta oli girap oli agens long hem,</para>
  <para style="q3" vid="PSA 78:56">oli traem hem.</para>
  <para style="q1" vid="PSA 78:56">Oli no holem ol loa blong hem,<verse eid="PSA 78:56" /></para>
  <para style="q2">
    <verse number="57" style="v" sid="PSA 78:57" />oli tanem baksaed long hem,</para>
  <para style="q3" vid="PSA 78:57">mo oli no stap strong long hem.</para>
  <para style="q1" vid="PSA 78:57">Oli olsem ol papa blong olgeta bifo.</para>
  <para style="q1" vid="PSA 78:57">Oli kam olsem ara we i kruked</para>
  <para style="q2" vid="PSA 78:57">we man i no save trastem.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Oli stap mekem wosip long ol narafala god</para>
  <para style="q3" vid="PSA 78:58">antap long ol hil,</para>
  <para style="q2" vid="PSA 78:58">mo fasin ya i mekem God i kros.</para>
  <para style="q1" vid="PSA 78:58">Oli stap stanemap ol aedol blong olgeta,</para>
  <para style="q2" vid="PSA 78:58">mo fasin ya i mekem hem i kros moa.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Taem hem i luk ol samting ya,</para>
  <para style="q2" vid="PSA 78:59">hem i kros tumas,</para>
  <para style="q3" vid="PSA 78:59">nao i tanem baksaed long olgeta.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.60: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 18:1">Jos 18.1</ref>; <ref loc="JER 7:12-14">Jer 7.12-14</ref>; <ref loc="JER 26:6">26.6</ref></char>
    </note>Hem i bin stap long haos tapolen blong hem long Silo,</para>
  <para style="q3" vid="PSA 78:60">long medel blong olgeta,</para>
  <para style="q2" vid="PSA 78:60">be hem i lego haos ya,</para>
  <para style="q4" vid="PSA 78:60">i gowe long olgeta.<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.61: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 4:4-22">1 Saml 4.4-22</ref>
      </char>
    </note>Hem i letem ol enemi blong olgeta</para>
  <para style="q2" vid="PSA 78:61">oli kam tekemaot Bokis ya we i Saen blong Promes.*</para>
  <para style="q1" vid="PSA 78:61">Bokis ya i saen blong paoa blong hem,</para>
  <para style="q2" vid="PSA 78:61">mo blong bigfala laet ya</para>
  <para style="q3" vid="PSA 78:61">we i soemaot we hem i stap.<verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />Hem i kros long ol man blong hem,</para>
  <para style="q2" vid="PSA 78:62">nao i letem ol enemi ya oli kam kilim olgeta i ded.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Ol yang man blong olgeta oli ded long faet,</para>
  <para style="q2" vid="PSA 78:63">nao ol yang gel oli stap nomo,</para>
  <para style="q3" vid="PSA 78:63">i no moa gat man blong oli mared long olgeta.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />Ol pris blong hem</para>
  <para style="q2" vid="PSA 78:64">oli ded long faet,</para>
  <para style="q3" vid="PSA 78:64">mo ol woman blong olgeta oli fraet,</para>
  <para style="q4" vid="PSA 78:64">oli no save krae from olgeta.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Biaen, Masta<note caller="+" style="f"><char style="fr" closed="false">78.65: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long 35.22.</char></note> ya blong yumi i girap,</para>
  <para style="q2" vid="PSA 78:65">i olsem man we i slip gud finis,</para>
  <para style="q3" vid="PSA 78:65">nao i wekap we i harem gud.</para>
  <para style="q1" vid="PSA 78:65">Hem i olsem wan strong man</para>
  <para style="q2" vid="PSA 78:65">we i dring waen, nao i rere blong faet.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />Hem i winimgud ol enemi blong hem,</para>
  <para style="q2" vid="PSA 78:66">mo i ronem olgeta i gobak,</para>
  <para style="q3" vid="PSA 78:66">we oli sem we i sem gud,</para>
  <para style="q4" vid="PSA 78:66">oli no moa save mekem faet bakegen.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Hem i no jusumaot laen blong Efrem,</para>
  <para style="q2" vid="PSA 78:67">hem i tanem baksaed long olgeta.<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Hem i jusumaot laen blong Juda*</para>
  <para style="q2" vid="PSA 78:68">mo hil ya Saeon* we hem i laekem tumas.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />Long ples ya nao,</para>
  <para style="q2" vid="PSA 78:69">hem i wokem tabu haos* blong hem,</para>
  <para style="q3" vid="PSA 78:69">we i olsem hom blong hem long heven.</para>
  <para style="q1" vid="PSA 78:69">Hem i mekem haos ya i strong gud</para>
  <para style="q2" vid="PSA 78:69">olsem we i mekem wol ya,</para>
  <para style="q3" vid="PSA 78:69">we i stap gud oltaem nomo,</para>
  <para style="q4" vid="PSA 78:69">i no save kam nogud.<verse eid="PSA 78:69" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="70-71" style="v" sid="PSA 78:70-71" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78.70-71: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:11">1 Saml 16.11</ref>,<ref loc="1SA 16:12">12</ref>; <ref loc="2SA 7:8">2 Saml 7.8</ref>; <ref loc="1CH 17:7">1 Kron 17.7</ref></char>
    </note>Fastaem Deved i stap lukaot long ol sipsip blong hem,</para>
  <para style="q2" vid="PSA 78:70-71">be God i jusumaot hem</para>
  <para style="q3" vid="PSA 78:70-71">blong i kam man blong wok blong hem.</para>
  <para style="q1" vid="PSA 78:70-71">Hem i tekemaot hem long wok ya</para>
  <para style="q4" vid="PSA 78:70-71">blong lukaot long sipsip,</para>
  <para style="q2" vid="PSA 78:70-71">mo i putumap hem i kam king</para>
  <para style="q4" vid="PSA 78:70-71">blong yumi ol laen blong Isrel</para>
  <para style="q3" vid="PSA 78:70-71">blong i stap lukaot long yumi.<verse eid="PSA 78:70-71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Nao king ya i lavem yumi tumas,</para>
  <para style="q2" vid="PSA 78:72">i lukaot gud long yumi,</para>
  <para style="q3" vid="PSA 78:72">mo i stap lidim yumi long gudhan blong hem.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">Man i prea blong God i ronemaot ol hiten man oli gowe long ples blong hem</para>
  <para style="sp">(Sing ya, wan laen blong Asaf i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79.1: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:8-10">2 King 25.8-10</ref>; <ref loc="2CH 36:17-19">2 Kron 36.17-19</ref>; <ref loc="JER 52:12-14">Jer 52.12-14</ref></char>
    </note>God.</para>
  <para style="q1" vid="PSA 79:1">Ol hiten man oli kam insaed finis</para>
  <para style="q3" vid="PSA 79:1">long ples ya blong yu,</para>
  <para style="q2" vid="PSA 79:1">oli mekem tabu haos* ya blong yu</para>
  <para style="q4" vid="PSA 79:1">i no moa tabu,</para>
  <para style="q3" vid="PSA 79:1">mo oli smasemgud taon ya Jerusalem.*<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Oli livim ol dedbodi blong ol man blong wok blong yu</para>
  <para style="q3" vid="PSA 79:2">oli stap,</para>
  <para style="q2" vid="PSA 79:2">blong ol wael anamol mo ol bigfala pijin ya valja* oli kakae.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Oli kilim ol man blong yu,</para>
  <para style="q2" vid="PSA 79:3">mo oli mekem</para>
  <para style="q3" vid="PSA 79:3">we blad blong olgeta i ron olsem wota.</para>
  <para style="q1" vid="PSA 79:3">Long olgeta ples long Jerusalem,</para>
  <para style="q2" vid="PSA 79:3">blad blong olgeta i ron olsem wota nomo,</para>
  <para style="q3" vid="PSA 79:3">mo i no gat man i stap blong berem olgeta.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Ol man blong ol narafala kantri ya</para>
  <para style="q3" vid="PSA 79:4">we oli stap raonabaot long mifala</para>
  <para style="q2" vid="PSA 79:4">oli stap jikim mifala blong spolem mifala,</para>
  <para style="q3" vid="PSA 79:4">oli stap tok nogud long mifala,</para>
  <para style="q4" vid="PSA 79:4">mo oli stap laf long mifala.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Hae God. ?Olsem wanem?</para>
  <para style="q1" vid="PSA 79:5">?Bambae yu stap kros olwe long mifala</para>
  <para style="q2" vid="PSA 79:5">gogo i no save finis?</para>
  <para style="q1" vid="PSA 79:5">?Bambae yu letem</para>
  <para style="q2" vid="PSA 79:5">kros blong yu i stap bon oltaem olsem faea?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />I gud yu kros long ol man ya blong ol narafala kantri,</para>
  <para style="q2" vid="PSA 79:6">we oli no save mekem wosip long yu</para>
  <para style="q3" vid="PSA 79:6">mo oli no save prea long yu.<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Olgeta ya nao oli kilim ol man blong yu,</para>
  <para style="q2" vid="PSA 79:7">mo oli spolem ples ya blong yu.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8-9" style="v" sid="PSA 79:8-9" />God,</para>
  <para style="q2" vid="PSA 79:8-9">oltaem yu yu stap sevem mifala.</para>
  <para style="q1" vid="PSA 79:8-9">Plis yu no panisim mifala</para>
  <para style="q2" vid="PSA 79:8-9">from ol sin blong ol bubu blong mifala bifo.</para>
  <para style="q1" vid="PSA 79:8-9">Plis yu sore long mifala.</para>
  <para style="q1" vid="PSA 79:8-9">Naoia, tingting blong mifala i foldaon olgeta.</para>
  <para style="q1" vid="PSA 79:8-9">Plis yu halpem mifala,</para>
  <para style="q2" vid="PSA 79:8-9">yu sevem mifala,</para>
  <para style="q3" vid="PSA 79:8-9">mo yu fogivim mifala,</para>
  <para style="q2" vid="PSA 79:8-9">yu tekemaot ol sin blong mifala,</para>
  <para style="q3" vid="PSA 79:8-9">from we hae nem blong yu</para>
  <para style="q4" vid="PSA 79:8-9">i stap long mifala.<verse eid="PSA 79:8-9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />I no stret blong ol man ya blong ol narafala kantri</para>
  <para style="q3" vid="PSA 79:10">oli stap talem long mifala se,</para>
  <para style="q2" vid="PSA 79:10">“?Wehem God ya blong yufala?”</para>
  <para style="q1" vid="PSA 79:10">God,</para>
  <para style="q2" vid="PSA 79:10">mifala i wantem luk</para>
  <para style="q3" vid="PSA 79:10">we bambae yu panisim olgeta,</para>
  <para style="q2" vid="PSA 79:10">from we oli kilim ol man blong wok blong yu oli ded,</para>
  <para style="q3" vid="PSA 79:10">blad blong olgeta i ron bigwan.<verse eid="PSA 79:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Naoia mifala i stap long kalabus,</para>
  <para style="q2" vid="PSA 79:11">mo oli jajem mifala finis,</para>
  <para style="q3" vid="PSA 79:11">se mifala i mas ded.</para>
  <para style="q1" vid="PSA 79:11">Plis yu lesin long krae blong mifala,</para>
  <para style="q2" vid="PSA 79:11">yu kam long paoa blong yu,</para>
  <para style="q3" vid="PSA 79:11">yu mekem mifala i fri.<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Masta<note caller="+" style="f"><char style="fr" closed="false">79.12: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long 35.22.</char></note>,</para>
  <para style="q2" vid="PSA 79:12">olgeta ya oli stap sakem ol rabis tok i kam long yu.</para>
  <para style="q1" vid="PSA 79:12">Plis yu givimbak fasin ya long olgeta seven taem.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Nao bambae mifala i stap talem tangkiu long yu</para>
  <para style="q2" vid="PSA 79:13">oltaem nomo.</para>
  <para style="q1" vid="PSA 79:13">Mifala i man blong yu,</para>
  <para style="q3" vid="PSA 79:13">mifala i sipsip blong yu nomo.</para>
  <para style="q1" vid="PSA 79:13">Bambae mifala i stap presem yu oltaem,</para>
  <para style="q4" vid="PSA 79:13">gogo i no save finis.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">Man i prea blong God i mekem ples i kam gud bakegen</para>
  <para style="sp">(Sing ya, wan laen blong Asaf i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 80:1-2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80.1-2: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:22">Eks 25.22</ref>
      </char>
    </note>God.</para>
  <para style="q1" vid="PSA 80:1-2">Mifala i laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 80:1-2">mo oltaem yu stap lukaot gud long mifala,</para>
  <para style="q3" vid="PSA 80:1-2">yu stap lidim mifala,</para>
  <para style="q4" vid="PSA 80:1-2">olsem we man i stap lukaot gud long ol sipsip blong hem.</para>
  <para style="q1" vid="PSA 80:1-2">Yu yu stap sidaon long ples blong yu</para>
  <para style="q3" vid="PSA 80:1-2">antap long tufala jerubim* ya,</para>
  <para style="q2" vid="PSA 80:1-2">yu stap rul.</para>
  <para style="q1" vid="PSA 80:1-2">Plis yu lesin long mifala.</para>
  <para style="q1" vid="PSA 80:1-2">Mifala ol laen blong Efrem,*</para>
  <para style="q2" vid="PSA 80:1-2">wetem ol laen blong Benjamin,*</para>
  <para style="q3" vid="PSA 80:1-2">mo ol laen blong Manase.*</para>
  <para style="q1" vid="PSA 80:1-2">Plis yu soemaot laet blong yu long mifala,</para>
  <para style="q2" vid="PSA 80:1-2">mo yu soemaot long mifala evriwan,</para>
  <para style="q4" vid="PSA 80:1-2">we yu yu gat paoa.</para>
  <para style="q1" vid="PSA 80:1-2">Plis yu kam, yu sevem mifala.<verse eid="PSA 80:1-2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />God,</para>
  <para style="q2" vid="PSA 80:3">plis yu soemaot long mifala</para>
  <para style="q4" vid="PSA 80:3">we yu yu gat sore long mifala.</para>
  <para style="q1" vid="PSA 80:3">Plis yu tekem mifala i kambak long yu,</para>
  <para style="q2" vid="PSA 80:3">nao bambae mifala i save stap gud.<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />Hae God, yu yu God blong mifala,</para>
  <para style="q3" vid="PSA 80:4">mo yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 80:4">Mifala i stap prea long yu.</para>
  <para style="q1" vid="PSA 80:4">?Bambae yu stap kros long mifala</para>
  <para style="q2" vid="PSA 80:4">gogo kasem wetaem?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Yu yu mekem mifala i stap harem nogud,</para>
  <para style="q2" vid="PSA 80:5">we mifala i stap krae tumas.</para>
  <para style="q1" vid="PSA 80:5">Fasin ya i olsem kakae mo wota blong mifala,</para>
  <para style="q2" vid="PSA 80:5">we evri dei nomo mifala i stap kasem.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Yu stap letem ol man blong ol narafala kantri ya</para>
  <para style="q3" vid="PSA 80:6">we oli stap raonabaot long mifala</para>
  <para style="q2" vid="PSA 80:6">oli stap faet from ples blong mifala.</para>
  <para style="q1" vid="PSA 80:6">Ol enemi ya blong mifala</para>
  <para style="q2" vid="PSA 80:6">oli stap sakem ol rabis tok long mifala.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />God, yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 80:7">Plis yu soemaot long mifala</para>
  <para style="q2" vid="PSA 80:7">we yu yu gat sore long mifala.</para>
  <para style="q1" vid="PSA 80:7">Plis yu tekem mifala i kambak long yu,</para>
  <para style="q2" vid="PSA 80:7">nao bambae mifala i save stap gud.<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Mifala i olsem rop ya grep*</para>
  <para style="q3" vid="PSA 80:8">we yu tekem i kamaot long Ijip,</para>
  <para style="q2" vid="PSA 80:8">mo yu ronemaot olgeta narafala man,</para>
  <para style="q3" vid="PSA 80:8">nao yu planem long ples blong olgeta.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Yu yu klinimgud ples blong hem blong i gru gud,</para>
  <para style="q3" vid="PSA 80:9">mo ol rus blong hem oli godaon olgeta,</para>
  <para style="q2" vid="PSA 80:9">nao hem i gru i kam bigwan,</para>
  <para style="q4" vid="PSA 80:9">i kavremap olgeta ples ya.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Sado blong hem i kavremap ol hil,</para>
  <para style="q2" vid="PSA 80:10">mo ol han blong hem oli go kavremap</para>
  <para style="q4" vid="PSA 80:10">ol longlongfala tri ya sida* long Lebanon.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Hem i kam bigwan we i bigwan,</para>
  <para style="q2" vid="PSA 80:11">nao ol han blong hem</para>
  <para style="q4" vid="PSA 80:11">oli go kasem Mediterenian Si,</para>
  <para style="q3" vid="PSA 80:11">mo long narasaed,</para>
  <para style="q3" vid="PSA 80:11">oli go kasem Yufretes Reva.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />!Rop ya mifala ya!</para>
  <para style="q1" vid="PSA 80:12">?From wanem yu brekemdaon fenis ya</para>
  <para style="q2" vid="PSA 80:12">we i goraon long hem?</para>
  <para style="q1" vid="PSA 80:12">Naoia ol man we oli stap pas klosap long hem</para>
  <para style="q2" vid="PSA 80:12">oli stap stilim ol frut blong hem.<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Ol wael pig oli stap purumbut long hem,</para>
  <para style="q2" vid="PSA 80:13">mo ol wael anamol oli stap kakae.<verse eid="PSA 80:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />God, yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 80:14">Plis yu tanem yu,</para>
  <para style="q2" vid="PSA 80:14">yu lukluk i kam long mifala.</para>
  <para style="q1" vid="PSA 80:14">Yu yu stap long heven,</para>
  <para style="q2" vid="PSA 80:14">yu lukluk i kamdaon long mifala.</para>
  <para style="q1" vid="PSA 80:14">Mifala i man blong yu,</para>
  <para style="q2" vid="PSA 80:14">plis yu kam, yu sevem mifala.<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />Yang rop ya we yu yu bin planem,</para>
  <para style="q3" vid="PSA 80:15">mo yu bin mekem i kam bigwan,</para>
  <para style="q2" vid="PSA 80:15">plis yu kam, yu sevem hem.<verse eid="PSA 80:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Ol enemi oli putum faea long hem finis,</para>
  <para style="q2" vid="PSA 80:16">mo oli stap katemdaon.</para>
  <para style="q1" vid="PSA 80:16">Plis yu girap,</para>
  <para style="q2" vid="PSA 80:16">yu faerap long olgeta,</para>
  <para style="q3" vid="PSA 80:16">yu spolem olgeta.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Yu yu bin jusumaot mifala,</para>
  <para style="q2" vid="PSA 80:17">plis yu lukaot long mifala.</para>
  <para style="q1" vid="PSA 80:17">Yu yu bin mekem mifala i strong,</para>
  <para style="q2" vid="PSA 80:17">plis yu sevem mifala.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Bambae mifala i no save gowe long yu samtaem.</para>
  <para style="q1" vid="PSA 80:18">Plis yu holem mifala i stap laef,</para>
  <para style="q2" vid="PSA 80:18">nao bambae mifala i stap talemaot</para>
  <para style="q3" vid="PSA 80:18">we mifala i man blong yu.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />Hae God, yu yu God blong mifala</para>
  <para style="q2" vid="PSA 80:19">mo yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 80:19">Plis yu soemaot long mifala</para>
  <para style="q2" vid="PSA 80:19">we yu yu gat sore long mifala.</para>
  <para style="q1" vid="PSA 80:19">Plis yu tekem mifala i kambak long yu,</para>
  <para style="q2" vid="PSA 80:19">nao bambae mifala i save stap gud.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">Singsing blong lafet</para>
  <para style="sp">(Sing ya, Asaf i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Olgeta.</para>
  <para style="q1" vid="PSA 81:1">I gud yumi glad,</para>
  <para style="q2" vid="PSA 81:1">yumi singsingaot long God,</para>
  <para style="q3" vid="PSA 81:1">we i God blong Jekob,*</para>
  <para style="q4" vid="PSA 81:1">olfala bubu ya blong yumi bifo. Hem i God blong yumi,</para>
  <para style="q2" vid="PSA 81:1">mo hem i stap blokemgud yumi,</para>
  <para style="q3" vid="PSA 81:1">i stap lukaot gud long yumi.</para>
  <para style="q1" vid="PSA 81:1">Yumi mas singsing blong presem hem.<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Yumi statem stringban.</para>
  <para style="q1" vid="PSA 81:2">Yumi plei long tamborin mo gita mo mandolin.</para>
  <para style="q1" vid="PSA 81:2">Yumi mas singsing</para>
  <para style="q2" vid="PSA 81:2">we i gud we i gud.<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81.3: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 10:10">Nam 10.10</ref>
      </char>
    </note>Yumi blu trampet</para>
  <para style="q2" vid="PSA 81:3">blong mekem wosip blong Lafet blong Niumun,*</para>
  <para style="q3" vid="PSA 81:3">mo blong Lafet blong Fulmun.<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Hemia i loa</para>
  <para style="q2" vid="PSA 81:4">we God i givim long yumi ol laen* blong Isrel.*<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Hem i givim long ol bubu ya blong yumi bifo,</para>
  <para style="q2" vid="PSA 81:5">long taem ya we hem i tekemaot olgeta long Ijip oli kam.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q1" vid="PSA 81:5">Mi mi harem voes blong wan man</para>
  <para style="q3" vid="PSA 81:5">we mi no harem samtaem,</para>
  <para style="q2" vid="PSA 81:5">we i talem se,<verse eid="PSA 81:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 81:6" />“Mi mi talem long ol man blong mi bifo se,</para>
  <para style="q3" vid="PSA 81:6">‘Mi mi tekemaot ol hevi samting long baksaed blong yufala,</para>
  <para style="q4" vid="PSA 81:6">nao yufala i no moa karem ol brikis blong olgeta,</para>
  <para style="q3" vid="PSA 81:6">yufala i fri.<verse eid="PSA 81:6" /></para>
  <para style="q3">
    <verse number="7" style="v" sid="PSA 81:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81.7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:7">Eks 17.7</ref>; <ref loc="NUM 20:13">Nam 20.13</ref></char>
    </note>Taem yufala i stap long trabol,</para>
  <para style="q4" vid="PSA 81:7">yufala i singaot long mi,</para>
  <para style="q3" vid="PSA 81:7">nao mi mi sevem yufala.</para>
  <para style="q3" vid="PSA 81:7">Mi mi stap haed insaed long tanda,</para>
  <para style="q4" vid="PSA 81:7">nao mi mi ansa long yufala.</para>
  <para style="q3" vid="PSA 81:7">Mi mi traem yufala long draeples ya,</para>
  <para style="q4" vid="PSA 81:7">we biaen oli kolem springwota blong Meriba.<verse eid="PSA 81:7" /></para>
  <para style="q3">
    <verse number="8" style="v" sid="PSA 81:8" />!Ol laen blong Isrel!</para>
  <para style="q4" vid="PSA 81:8">!Yufala i man blong mi!</para>
  <para style="q3" vid="PSA 81:8">!Mi mi tok blong wonem yufala!</para>
  <para style="q3" vid="PSA 81:8">!Yufala i lesin long tok blong mi!</para>
  <para style="q3" vid="PSA 81:8">!Mi mi wantem tumas</para>
  <para style="q4" vid="PSA 81:8">blong yufala i harem mi!<verse eid="PSA 81:8" /></para>
  <para style="q3">
    <verse number="9" style="v" sid="PSA 81:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81.9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:2">Eks 20.2</ref>,<ref loc="EXO 20:3">3</ref>; <ref loc="DEU 5:6">Dut 5.6</ref>,<ref loc="DEU 5:7">7</ref></char>
    </note>Bambae yufala i no mekem wosip</para>
  <para style="q4" vid="PSA 81:9">long ol narafala god.<verse eid="PSA 81:9" /></para>
  <para style="q3">
    <verse number="10" style="v" sid="PSA 81:10" />Mi mi Hae God,</para>
  <para style="q4" vid="PSA 81:10">mi God blong yufala.</para>
  <para style="q3" vid="PSA 81:10">Mi nao mi tekemaot yufala</para>
  <para style="q3" vid="PSA 81:10">long ples ya Ijip.</para>
  <para style="q3" vid="PSA 81:10">Mo sipos tingting blong yufala</para>
  <para style="q3" vid="PSA 81:10">i stap strong long mi,</para>
  <para style="q4" vid="PSA 81:10">mi bambae mi givim ol gudgudfala samting</para>
  <para style="q3" vid="PSA 81:10">long yufala.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q3">
    <verse number="11" style="v" sid="PSA 81:11" />“ ‘Ol bubu ya blong yufala bifo</para>
  <para style="q3" vid="PSA 81:11">oli man blong mi,</para>
  <para style="q4" vid="PSA 81:11">be oli no save lesin long mi, <optbreak /> oli no save obei long mi.<verse eid="PSA 81:11" /></para>
  <para style="q3">
    <verse number="12" style="v" sid="PSA 81:12" />Nao from samting ya</para>
  <para style="q4" vid="PSA 81:12">mi letem olgeta oli go mekem <optbreak /> stronghed blong olgeta,</para>
  <para style="q3" vid="PSA 81:12">olsem we oli wantem.<verse eid="PSA 81:12" /></para>
  <para style="q3">
    <verse number="13" style="v" sid="PSA 81:13" />Sipos ol man ya blong mi oli save lesin long mi</para>
  <para style="q4" vid="PSA 81:13">bambae mi mi glad tumas,</para>
  <para style="q3" vid="PSA 81:13">be oli no wantem.</para>
  <para style="q3" vid="PSA 81:13">Sipos oli save obei long mi,</para>
  <para style="q4" vid="PSA 81:13">bambae i gud tumas,</para>
  <para style="q3" vid="PSA 81:13">be oli no mekem.<verse eid="PSA 81:13" /></para>
  <para style="q3">
    <verse number="14" style="v" sid="PSA 81:14" />Sipos oli stap mekem olsem,</para>
  <para style="q4" vid="PSA 81:14">bambae mi faet long ol enemi blong olgeta,</para>
  <para style="q3" vid="PSA 81:14">mi winim olgeta kwiktaem nomo,</para>
  <para style="q4" vid="PSA 81:14">be oli no wantem mekem.<verse eid="PSA 81:14" /></para>
  <para style="q3">
    <verse number="15" style="v" sid="PSA 81:15" />Sipos oli stap lesin long mi,</para>
  <para style="q4" vid="PSA 81:15">bambae mi mekem ol man we oli stap agens long mi,</para>
  <para style="q3" vid="PSA 81:15">oli fraet long mi, <optbreak /> oli foldaon long fes blong mi from,</para>
  <para style="q3" vid="PSA 81:15">mo panis blong olgeta bambae i stap we i stap,</para>
  <para style="q4" vid="PSA 81:15">we i no save finis,</para>
  <para style="q4" vid="PSA 81:15">be oli no stap lesin long mi.<verse eid="PSA 81:15" /></para>
  <para style="q3">
    <verse number="16" style="v" sid="PSA 81:16" />Sipos oli stap obei long mi,</para>
  <para style="q4" vid="PSA 81:16">bambae mi fidim olgeta long wit* we i beswan,</para>
  <para style="q3" vid="PSA 81:16">bambae oli kakae eg* blong wael sugabag* <optbreak /> we i swit we i swit,</para>
  <para style="q3" vid="PSA 81:16">nao oli harem gud,</para>
  <para style="q4" vid="PSA 81:16">be oli no save obei long mi.’ ”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">God i stap jajem ol haeman we wok blong olgeta i no stret</para>
  <para style="sp">(Sing ya, Asaf i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />God i stap mekem kot long heven,</para>
  <para style="q2" vid="PSA 82:1">hem i stap jajem ol haeman ya</para>
  <para style="q3" vid="PSA 82:1">we oli gat paoa blong jajem man.<verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />Hem i talem se,</para>
  <para style="q2" vid="PSA 82:2">“Yufala i mas lego fasin ya</para>
  <para style="q3" vid="PSA 82:2">we yufala i stap jajem ol man</para>
  <para style="q4" vid="PSA 82:2">long fasin we i no stret.</para>
  <para style="q2" vid="PSA 82:2">Bambae yufala i no moa saed</para>
  <para style="q3" vid="PSA 82:2">long ol man nogud bakegen.<verse eid="PSA 82:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 82:3" />Yufala i mas lukaot gud</para>
  <para style="q3" vid="PSA 82:3">long raet blong ol puaman,</para>
  <para style="q4" vid="PSA 82:3">mo blong ol pikinini</para>
  <para style="q3" vid="PSA 82:3">we papa blong olgeta i ded.</para>
  <para style="q2" vid="PSA 82:3">Yufala i mas mekem i stret</para>
  <para style="q3" vid="PSA 82:3">long olgeta we oli stap trabol</para>
  <para style="q4" vid="PSA 82:3">mo long olgeta we oli no gat paoa.<verse eid="PSA 82:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 82:4" />Yufala i mas tekemaot olgeta</para>
  <para style="q3" vid="PSA 82:4">long paoa blong ol man nogud.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />“!Yufala i no save wan samting nating!</para>
  <para style="q2" vid="PSA 82:5">!Yufala i no gat hed!</para>
  <para style="q2" vid="PSA 82:5">Fasin blong yufala i nogud olgeta.</para>
  <para style="q2" vid="PSA 82:5">Naoia, stret fasin blong jajem man</para>
  <para style="q3" vid="PSA 82:5">i lus finis long wol.<verse eid="PSA 82:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 82:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82.6: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:34">Jon 10.34</ref>
      </char>
    </note>Mi mi God, mi hae we mi hae,</para>
  <para style="q3" vid="PSA 82:6">mo mi talem finis se,</para>
  <para style="q3" vid="PSA 82:6">‘Yufala i god,</para>
  <para style="q4" vid="PSA 82:6">yufala evriwan i pikinini blong mi.’<verse eid="PSA 82:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 82:7" />Be bambae yufala i ded olsem ol narafala man,</para>
  <para style="q3" vid="PSA 82:7">bambae laef blong yufala i finis</para>
  <para style="q4" vid="PSA 82:7">olsem laef blong ol narafala haeman.”<verse eid="PSA 82:7" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />God,</para>
  <para style="q2" vid="PSA 82:8">plis yu kam, yu rulum wol ya.</para>
  <para style="q1" vid="PSA 82:8">Ol man blong olgeta kantri oli blong yu.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">Man we i prea blong God i winim ol enemi blong hem</para>
  <para style="sp">(Sing ya, Asaf i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />God.</para>
  <para style="q1" vid="PSA 83:1">!Plis yu no stap kwaet!</para>
  <para style="q1" vid="PSA 83:1">!Yu no satem maot blong yu olsem!</para>
  <para style="q1" vid="PSA 83:1">!Plis yu tok!<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />!Yu luk!</para>
  <para style="q1" vid="PSA 83:2">Ol enemi blong yu oli girap oli agensem yu,</para>
  <para style="q2" vid="PSA 83:2">olgeta ya we oli no laekem yu</para>
  <para style="q3" vid="PSA 83:2">oli stap faet agens long yu.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Mifala i man blong yu nomo</para>
  <para style="q3" vid="PSA 83:3">we yu yu stap lukaot long mifala,</para>
  <para style="q2" vid="PSA 83:3">be oli stap mekem ol tokhaed</para>
  <para style="q4" vid="PSA 83:3">blong spolem mifala,</para>
  <para style="q3" vid="PSA 83:3">oli stap mekem ol plan agens long mifala</para>
  <para style="q3" vid="PSA 83:3">long fasin blong haed.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Oli talem se,</para>
  <para style="q2" vid="PSA 83:4">“!Yufala i kam!</para>
  <para style="q2" vid="PSA 83:4">!Yumi go flatem olgeta ya!</para>
  <para style="q2" vid="PSA 83:4">!Yumi spolemgud ples blong olgeta!</para>
  <para style="q2" vid="PSA 83:4">!Bambae nem ya Isrel* i lus olgeta!”<verse eid="PSA 83:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Olgeta oli agri long plan ya blong olgeta,</para>
  <para style="q2" vid="PSA 83:5">nao oli joen wanples blong oli agens long yu.<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />Long olgeta ya,</para>
  <para style="q2" vid="PSA 83:6">i gat ol man Edom,</para>
  <para style="q3" vid="PSA 83:6">mo ol laen* blong Ismael,</para>
  <para style="q3" vid="PSA 83:6">mo ol man Moab,</para>
  <para style="q3" vid="PSA 83:6">mo ol laen blong Hega,<verse eid="PSA 83:6" /></para>
  <para style="q3">
    <verse number="7" style="v" sid="PSA 83:7" />mo ol man blong Gebal,</para>
  <para style="q3" vid="PSA 83:7">mo ol man Amon,</para>
  <para style="q3" vid="PSA 83:7">mo ol laen blong Amalek,</para>
  <para style="q3" vid="PSA 83:7">mo ol man Filistia,</para>
  <para style="q4" vid="PSA 83:7">mo ol man Taea.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Mo ol man Asiria tu oli joen wetem olgeta,</para>
  <para style="q2" vid="PSA 83:8">from we oli strong man blong faet,</para>
  <para style="q3" vid="PSA 83:8">mo oli gudfala fren blong ol man Amon mo ol man Moab</para>
  <para style="q4" vid="PSA 83:8">we oli laen blong Lot.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83.9 a: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 7:1-23">Jaj 7.1-23</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 4:6-22">Jaj 4.6-22</ref>
      </char>
    </note>Plis yu mekem long olgeta</para>
  <para style="q2" vid="PSA 83:9">olsem we yu bin mekem</para>
  <para style="q4" vid="PSA 83:9">long ol man Midian bifo,</para>
  <para style="q3" vid="PSA 83:9">olsem we yu bin mekem</para>
  <para style="q3" vid="PSA 83:9">long tufala ya Siseraha mo Jabin, <optbreak /> long Kison Reva.<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />Yu yu winim tufala long taon ya Endoro,</para>
  <para style="q2" vid="PSA 83:10">mo bodi blong tufala i roten long ples ya.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83.11 a: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 7:25">Jaj 7.25</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 8:12">Jaj 8.12</ref>
      </char>
    </note>Plis yu mekem long ol lida blong olgeta</para>
  <para style="q2" vid="PSA 83:11">olsem we yu bin mekem</para>
  <para style="q3" vid="PSA 83:11">long tufala haeman ya Oreb mo Seheb.</para>
  <para style="q1" vid="PSA 83:11">Plis yu winim ol king blong olgeta</para>
  <para style="q2" vid="PSA 83:11">olsem we yu bin winim</para>
  <para style="q3" vid="PSA 83:11">tufala king ya Seba mo Jalmuna,<verse eid="PSA 83:11" /></para>
  <para style="q4">
    <verse number="12" style="v" sid="PSA 83:12" />we tufala i talem se,</para>
  <para style="q2" vid="PSA 83:12">“Graon ya we i blong God,</para>
  <para style="q3" vid="PSA 83:12">bambae yumi tekem i blong yumi.”<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />God,</para>
  <para style="q2" vid="PSA 83:13">plis yu mekem olgeta oli go wanwan,</para>
  <para style="q3" vid="PSA 83:13">olsem asis blong graon</para>
  <para style="q4" vid="PSA 83:13">we win i blu long hem i go olbaot.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />Yu kam long olgeta</para>
  <para style="q2" vid="PSA 83:14">olsem bigfala faea we i laet long bus,</para>
  <para style="q3" vid="PSA 83:14">we i stap kakae ol tri olbaot long ol hil.<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />Plis yu kam long olgeta olsem bigfala win,</para>
  <para style="q2" vid="PSA 83:15">yu mekem olgeta oli fraet.</para>
  <para style="q1" vid="PSA 83:15">Yu kam olsem bigfala hariken,</para>
  <para style="q2" vid="PSA 83:15">yu ronemaot olgeta oli go.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />Hae God,</para>
  <para style="q2" vid="PSA 83:16">yu mekem we olgeta oli sem gud,</para>
  <para style="q3" vid="PSA 83:16">gogo oli lukaot rod blong kam man blong yu.<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Plis yu winimgud olgeta,</para>
  <para style="q2" vid="PSA 83:17">yu mekem we bambae oli fraet gogo i no save finis,</para>
  <para style="q3" vid="PSA 83:17">yu mekem olgeta oli ded long wan fasin</para>
  <para style="q4" vid="PSA 83:17">we bambae i mekem nem blong olgeta i nogud.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Plis yu mekem olgeta oli save</para>
  <para style="q2" vid="PSA 83:18">we yu nomo yu Hae God,</para>
  <para style="q3" vid="PSA 83:18">yu nao yu hae King blong olgeta ples long wol.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">Man we i laekem haos blong God tumas</para>
  <para style="sp">(Sing ya, ol laen blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />Hae God.</para>
  <para style="q1" vid="PSA 84:1">Yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 84:1">!Mi mi laekem haos* blong yu tumas!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />!Mi wantem tumas</para>
  <para style="q4" vid="PSA 84:2">blong go stap long hem!</para>
  <para style="q1" vid="PSA 84:2">Hae God,</para>
  <para style="q2" vid="PSA 84:2">mi wantem tumas blong stap oltaem</para>
  <para style="q3" vid="PSA 84:2">long haos blong yu.</para>
  <para style="q1" vid="PSA 84:2">Yu yu God we yu laef.</para>
  <para style="q1" vid="PSA 84:2">Tingting blong mi i glad tumas long yu,</para>
  <para style="q2" vid="PSA 84:2">mo mi stap sing blong presem yu.<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Hae God, yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 84:3">Yu yu King blong mi,</para>
  <para style="q2" vid="PSA 84:3">yu yu God blong mi.</para>
  <para style="q1" vid="PSA 84:3">Ol smosmol pijin ya we oli smol tumas,</para>
  <para style="q2" vid="PSA 84:3">be oli stap mekem nes blong olgeta</para>
  <para style="q3" vid="PSA 84:3">long haos blong yu,</para>
  <para style="q2" vid="PSA 84:3">mo oli stap lukaot long ol pikinini blong olgeta</para>
  <para style="q4" vid="PSA 84:3">klosap long olta blong yu.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Ol man we oli stap long haos blong yu</para>
  <para style="q3" vid="PSA 84:4">oli hapi tumas,</para>
  <para style="q2" vid="PSA 84:4">oltaem oli stap singsing blong presem yu.<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Ol man we yu yu stap mekem olgeta oli strong,</para>
  <para style="q2" vid="PSA 84:5">oli hapi tumas.</para>
  <para style="q1" vid="PSA 84:5">Oltaem oli wantem tumas blong kam long hil ya Saeon*</para>
  <para style="q2" vid="PSA 84:5">blong mekem prea long yu.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Oltaem,</para>
  <para style="q2" vid="PSA 84:6">taem oli pastru long krik ya Baka</para>
  <para style="q4" vid="PSA 84:6">we i drae we i drae,</para>
  <para style="q2" vid="PSA 84:6">be oli no moa trabol blong kasem wota,</para>
  <para style="q3" vid="PSA 84:6">from we ples ya i kam ples blong wota.</para>
  <para style="q1" vid="PSA 84:6">Ren<note caller="+" style="f"><char style="fr" closed="false">84.6: </char><char style="ft" closed="false">Tok ya blong ren i soemaot we ol laen blong Isrel oli stap sing long Sam ya long taem blong ol lafet ya blong olgeta long en blong Septemba.</char></note> blong taem ya i mekem</para>
  <para style="q2" vid="PSA 84:6">ol hol long ples ya oli kam fulap long wota.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Yu yu God,</para>
  <para style="q2" vid="PSA 84:7">yu yu hae moa long ol narafala god.</para>
  <para style="q1" vid="PSA 84:7">Oltaem,</para>
  <para style="q3" vid="PSA 84:7">taem ol man ya oli stap kam long Saeon</para>
  <para style="q4" vid="PSA 84:7">oli stap kam strong moa,</para>
  <para style="q2" vid="PSA 84:7">mo bambae oli stap luk yu</para>
  <para style="q4" vid="PSA 84:7">long ples ya blong yu.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Hae God, yu yu God blong mi,</para>
  <para style="q2" vid="PSA 84:8">mo yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 84:8">!Plis yu harem prea blong mi!</para>
  <para style="q1" vid="PSA 84:8">Yu yu God blong Jekob.*</para>
  <para style="q1" vid="PSA 84:8">!Plis yu lesin long mi!<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />God,</para>
  <para style="q2" vid="PSA 84:9">yu nao yu jusumaot king blong mifala.</para>
  <para style="q1" vid="PSA 84:9">!Plis yu blesem hem!<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Yu yu God blong mi.</para>
  <para style="q1" vid="PSA 84:10">Sipos mi stap wan dei nomo</para>
  <para style="q3" vid="PSA 84:10">long haos blong yu,</para>
  <para style="q2" vid="PSA 84:10">be hemia i gud moa,</para>
  <para style="q3" vid="PSA 84:10">i winim we mi stap wan taosen dei</para>
  <para style="q4" vid="PSA 84:10">long ol narafala ples.</para>
  <para style="q1" vid="PSA 84:10">Nating sipos mi stap wok nomo</para>
  <para style="q3" vid="PSA 84:10">long doa blong haos blong yu,</para>
  <para style="q2" vid="PSA 84:10">be hemia i moa gud,</para>
  <para style="q3" vid="PSA 84:10">i winim we mi stap insaed olgeta</para>
  <para style="q4" vid="PSA 84:10">long haos blong ol man nogud.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Hae God,</para>
  <para style="q2" vid="PSA 84:11">yu yu God blong mifala.</para>
  <para style="q1" vid="PSA 84:11">Yu yu King</para>
  <para style="q3" vid="PSA 84:11">we paoa blong yu i bigfala tumas,</para>
  <para style="q2" vid="PSA 84:11">mo yu stap blokem mifala</para>
  <para style="q4" vid="PSA 84:11">blong mifala i stap gud.</para>
  <para style="q1" vid="PSA 84:11">Yu yu stap blesem mifala long gladhat blong yu,</para>
  <para style="q2" vid="PSA 84:11">yu stap leftemap nem blong mifala.</para>
  <para style="q1" vid="PSA 84:11">Yu yu no save holemtaet</para>
  <para style="q3" vid="PSA 84:11">ol gudgudfala samting blong yu,</para>
  <para style="q2" vid="PSA 84:11">oltaem yu stap givim long olgeta</para>
  <para style="q4" vid="PSA 84:11">we oli stap mekem ol stret fasin.<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />Hae God, yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 84:12">Olgeta we oli stap trastem yu</para>
  <para style="q2" vid="PSA 84:12">bambae oli save harem gud.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">Man i prea blong kantri blong hem i gat gudfala laef</para>
  <para style="sp">(Sing ya, ol laen blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />Hae God.</para>
  <para style="q1" vid="PSA 85:1">Kantri ya Isrel* i kantri blong yu.</para>
  <para style="q1" vid="PSA 85:1">Bifo, yu yu bin gat sore long hem,</para>
  <para style="q2" vid="PSA 85:1">mo yu bin mekem hem i kam gud bakegen.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Yu yu bin fogivim mifala</para>
  <para style="q3" vid="PSA 85:2">yu tekemaot ol sin blong mifala,</para>
  <para style="q2" vid="PSA 85:2">mo yu bin tekemaot olgeta rong blong mifala.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Long taem ya, yu bin lego fasin ya</para>
  <para style="q3" vid="PSA 85:3">we yu stap kros long mifala,</para>
  <para style="q2" vid="PSA 85:3">mo yu bin livim kros blong yu,</para>
  <para style="q4" vid="PSA 85:3">yu no moa kros long mifala bakegen.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />God, oltaem yu yu stap sevem mifala.</para>
  <para style="q1" vid="PSA 85:4">Plis yu tekem mifala i kambak long yu bakegen,</para>
  <para style="q2" vid="PSA 85:4">yu no moa tanem baksaed long mifala.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />?Olsem wanem?</para>
  <para style="q1" vid="PSA 85:5">?Bambae yu stap kros long mifala oltaem nomo?</para>
  <para style="q1" vid="PSA 85:5">?Bambae kros blong yu i no save finis samtaem?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Plis yu mekem mifala i strong bakegen,</para>
  <para style="q2" vid="PSA 85:6">nao bambae mifala i presem yu.<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Hae God,</para>
  <para style="q2" vid="PSA 85:7">oltaem yu yu lavem man tumas.</para>
  <para style="q1" vid="PSA 85:7">Plis yu soemaot fasin ya long mifala,</para>
  <para style="q2" vid="PSA 85:7">yu halpem mifala, yu sevem mifala.<verse eid="PSA 85:7" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 85:8">mo mi mi stap lesin long ol tok ya</para>
  <para style="q3" vid="PSA 85:8">we hem i stap talem.</para>
  <para style="q1" vid="PSA 85:8">Hem i promes se sipos yumi no gobak</para>
  <para style="q3" vid="PSA 85:8">long ol krangke fasin blong yumi,</para>
  <para style="q2" vid="PSA 85:8">hem bambae i givim pis long yumi.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Tru, oltaem nomo hem i rere</para>
  <para style="q3" vid="PSA 85:9">blong sevem man we i stap ona long hem,</para>
  <para style="q2" vid="PSA 85:9">mo hem bambae i stap long ples blong yumi</para>
  <para style="q4" vid="PSA 85:9">long olgeta paoa blong hem,</para>
  <para style="q3" vid="PSA 85:9">nao bambae hem i stap sevem yumi.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Oltaem God bambae i stap lavem man tumas,</para>
  <para style="q2" vid="PSA 85:10">nao man bambae i putum tingting blong hem</para>
  <para style="q3" vid="PSA 85:10">i stap strong long God.</para>
  <para style="q1" vid="PSA 85:10">God bambae i soemaot stret fasin blong hem,</para>
  <para style="q2" vid="PSA 85:10">nao man bambae i kasem pis long hem.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Fasin ya we man i stap strong long God</para>
  <para style="q3" vid="PSA 85:11">bambae i go antap i kasem heven,</para>
  <para style="q2" vid="PSA 85:11">mo stret fasin ya blong God</para>
  <para style="q4" vid="PSA 85:11">bambae i kamdaon i kasem graon.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Hae God bambae i mekem</para>
  <para style="q3" vid="PSA 85:12">we yumi gat plante samting,</para>
  <para style="q2" vid="PSA 85:12">mo graon blong yumi</para>
  <para style="q4" vid="PSA 85:12">bambae i karem plante kakae.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Stret fasin blong Hae God</para>
  <para style="q3" vid="PSA 85:13">bambae i go fastaem long hem,</para>
  <para style="q2" vid="PSA 85:13">mo bambae i mekemrere rod blong hem.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">King i prea blong God i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />Hae God.</para>
  <para style="q1" vid="PSA 86:1">Mi mi no strong, mi no gat paoa.</para>
  <para style="q1" vid="PSA 86:1">Plis yu harem krae blong mi,</para>
  <para style="q2" vid="PSA 86:1">yu ansa long mi.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 86:2">mi trastem yu.</para>
  <para style="q1" vid="PSA 86:2">Oltaem tingting blong mi i stap strong long yu.</para>
  <para style="q1" vid="PSA 86:2">Plis yu sevem mi,</para>
  <para style="q2" vid="PSA 86:2">yu no letem mi mi ded.<verse eid="PSA 86:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 86:3">plis yu sore long mi.</para>
  <para style="q1" vid="PSA 86:3">Oltaem, mi mi stap prea long yu,</para>
  <para style="q2" vid="PSA 86:3">i stat long moning go kasem long sapa.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Masta<note caller="+" style="f"><char style="fr" closed="false">86.4: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long 35.22.</char></note>,</para>
  <para style="q2" vid="PSA 86:4">mi mi man blong wok blong yu.</para>
  <para style="q1" vid="PSA 86:4">Mi stap prea i go long yu nomo.</para>
  <para style="q1" vid="PSA 86:4">Plis yu mekem mi mi glad.<verse eid="PSA 86:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Yu yu gud tumas long mifala,</para>
  <para style="q2" vid="PSA 86:5">mo yu stap fogivim mifala,</para>
  <para style="q3" vid="PSA 86:5">yu stap tekemaot ol sin blong mifala.</para>
  <para style="q1" vid="PSA 86:5">Ol man we oli stap mekem prea long yu,</para>
  <para style="q2" vid="PSA 86:5">oltaem yu yu lavem olgeta tumas.<verse eid="PSA 86:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />Hae God,</para>
  <para style="q2" vid="PSA 86:6">mi stap krae blong yu givhan long mi.</para>
  <para style="q1" vid="PSA 86:6">Plis yu lesin long prea blong mi,</para>
  <para style="q2" vid="PSA 86:6">mo yu ansa long mi.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Oltaem, taem mi mi stap long trabol,</para>
  <para style="q2" vid="PSA 86:7">mi stap singaot long yu,</para>
  <para style="q3" vid="PSA 86:7">from we mi save</para>
  <para style="q4" vid="PSA 86:7">se yu yu stap ansa long ol prea blong mi.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />Masta,</para>
  <para style="q2" vid="PSA 86:8">i no gat narafala god we i olsem yu.</para>
  <para style="q1" vid="PSA 86:8">I no gat wan i stap</para>
  <para style="q2" vid="PSA 86:8">we i stap mekem ol gudgudfala wok</para>
  <para style="q3" vid="PSA 86:8">olsem we yu yu bin mekem.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86.9: </char>
      <char style="xt" closed="false">
        <ref loc="REV 15:4">Rev 15.4</ref>
      </char>
    </note>Ol man blong olgeta kantri,</para>
  <para style="q2" vid="PSA 86:9">yu yu bin mekem olgeta,</para>
  <para style="q3" vid="PSA 86:9">mo bambae oli kam,</para>
  <para style="q4" vid="PSA 86:9">oli bodaon long yu,</para>
  <para style="q3" vid="PSA 86:9">oli presem hae nem blong yu.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Yu nomo yu God.</para>
  <para style="q1" vid="PSA 86:10">Yu yu gat paoa,</para>
  <para style="q2" vid="PSA 86:10">mo yu stap mekem ol bigbigfala samting.<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />Hae God,</para>
  <para style="q2" vid="PSA 86:11">plis yu tijim mi long ol samting</para>
  <para style="q4" vid="PSA 86:11">we yu wantem blong mi mi mekem,</para>
  <para style="q3" vid="PSA 86:11">nao bambae mi obei long yu,</para>
  <para style="q3" vid="PSA 86:11">mi holem trutok blong yu.</para>
  <para style="q1" vid="PSA 86:11">Yu mekem we mi bambae mi wantem tumas</para>
  <para style="q2" vid="PSA 86:11">blong mekem ol wok blong yu nomo.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />God, yu yu Masta* blong mi.</para>
  <para style="q1" vid="PSA 86:12">Bambae mi stap presem yu</para>
  <para style="q3" vid="PSA 86:12">long olgeta tingting blong mi,</para>
  <para style="q2" vid="PSA 86:12">bambae mi stap leftemap hae nem blong yu oltaem,</para>
  <para style="q4" vid="PSA 86:12">gogo i no save finis.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Oltaem yu yu lavem mi tumas.</para>
  <para style="q1" vid="PSA 86:13">Fasin ya blong yu i gud we i gud.</para>
  <para style="q1" vid="PSA 86:13">Yu yu bin sevem mi blong mi no go long beregraon.<verse eid="PSA 86:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />God,</para>
  <para style="q2" vid="PSA 86:14">ol praod man oli kam oli agens long mi.</para>
  <para style="q1" vid="PSA 86:14">Wan grup blong ol man nogud</para>
  <para style="q2" vid="PSA 86:14">oli stap traem blong kilim mi.</para>
  <para style="q1" vid="PSA 86:14">Olgeta ya,</para>
  <para style="q2" vid="PSA 86:14">neva oli save lesin long yu.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Be Masta<note caller="+" style="f"><char style="fr" closed="false">86.15: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long 35.22.</char></note>, yu yu God.</para>
  <para style="q1" vid="PSA 86:15">Fasin blong yu,</para>
  <para style="q2" vid="PSA 86:15">oltaem yu yu gat sore long man,</para>
  <para style="q3" vid="PSA 86:15">mo yu lavem hem tumas.</para>
  <para style="q1" vid="PSA 86:15">Oltaem yu stap mekem tingting blong yu i longfala,</para>
  <para style="q2" vid="PSA 86:15">mo yu yu kaen tumas,</para>
  <para style="q3" vid="PSA 86:15">oltaem yu stap holem ol promes blong yu.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Plis yu lukluk i kam long mi,</para>
  <para style="q2" vid="PSA 86:16">yu sore long mi, yu sevem mi,</para>
  <para style="q3" vid="PSA 86:16">mo yu mekem mi mi strong,</para>
  <para style="q2" vid="PSA 86:16">from we mi mi stap wok blong yu,</para>
  <para style="q3" vid="PSA 86:16">olsem we mama blong mi i stap mekem bifo.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Hae God,</para>
  <para style="q2" vid="PSA 86:17">plis yu soemaot long mi</para>
  <para style="q3" vid="PSA 86:17">we fasin blong yu i gud tumas,</para>
  <para style="q2" vid="PSA 86:17">nao taem olgeta we oli no laekem mi nating</para>
  <para style="q3" vid="PSA 86:17">oli luk we yu yu stap givhan long mi,</para>
  <para style="q4" vid="PSA 86:17">yu stap leftemap tingting blong mi,</para>
  <para style="q3" vid="PSA 86:17">bambae olgeta oli sem.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">Sing blong presem Jerusalem</para>
  <para style="sp">(Sing ya, ol laen blong Kora oli wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />Taon ya Jerusalem,*</para>
  <para style="q2" vid="PSA 87:1">hem i taon blong Hae God.</para>
  <para style="q1" vid="PSA 87:1">Hem i wokem long tabu hil* ya Saeon,*<verse eid="PSA 87:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 87:2" />mo i laekem taon ya moa,</para>
  <para style="q3" vid="PSA 87:2">i winim ol narafala taon long Isrel.*<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Yufala long taon ya blong hem,</para>
  <para style="q2" vid="PSA 87:3">yufala i lesin long ol gudgudfala tok</para>
  <para style="q3" vid="PSA 87:3">we hem i stap talem</para>
  <para style="q4" vid="PSA 87:3">blong leftemap taon ya.<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />Hem i talem se,</para>
  <para style="q2" vid="PSA 87:4">“Taem mi mekem lis blong olgeta</para>
  <para style="q4" vid="PSA 87:4">man we oli stap obei long mi,</para>
  <para style="q3" vid="PSA 87:4">bambae mi putum nem blong ol man Ijip</para>
  <para style="q4" vid="PSA 87:4">wetem ol man Babilonia,</para>
  <para style="q4" vid="PSA 87:4">mo ol man Filistia,</para>
  <para style="q4" vid="PSA 87:4">mo ol man Taea,</para>
  <para style="q4" vid="PSA 87:4">mo ol man Itiopia,</para>
  <para style="q3" vid="PSA 87:4">olgeta evriwan oli stap insaed.</para>
  <para style="q1" vid="PSA 87:4">Olgeta ya bambae mi kaontem wetem yufala,</para>
  <para style="q2" vid="PSA 87:4">olsem we oli man ples blong yufala.”<verse eid="PSA 87:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Mo bakegen,</para>
  <para style="q3" vid="PSA 87:5">hem bambae i talem se,</para>
  <para style="q2" vid="PSA 87:5">“Taon ya,</para>
  <para style="q3" vid="PSA 87:5">ol man blong olgeta kantri</para>
  <para style="q4" vid="PSA 87:5">bambae oli gat raet long hem.”</para>
  <para style="q1" vid="PSA 87:5">Hae God, hem i hae we i hae,</para>
  <para style="q2" vid="PSA 87:5">mo hem bambae i mekem taon ya i strong.<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />Hem bambae i raetemdaon nem blong olgeta</para>
  <para style="q3" vid="PSA 87:6">long wan buk,</para>
  <para style="q2" vid="PSA 87:6">mo bambae hem i kaontem olgeta evriwan,</para>
  <para style="q4" vid="PSA 87:6">se oli man Jerusalem.<verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Nao olgeta ya bambae oli stap danis,</para>
  <para style="q3" vid="PSA 87:7">mo oli stap singsing se,</para>
  <para style="q2" vid="PSA 87:7">“Saeon* ya,</para>
  <para style="q3" vid="PSA 87:7">olgeta gudgudfala samting blong yumi</para>
  <para style="q4" vid="PSA 87:7">oli stap kamaot long hem oltaem.”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">Man i krae i go long Hae God blong i givhan long hem</para>
  <para style="sp">(Sing ya, ol laen blong Kora oli wokem. Tok blong hem, Heman we i laen blong Esraha i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />Hae God.</para>
  <para style="q1" vid="PSA 88:1">Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 88:1">mo oltaem yu stap sevem mi.</para>
  <para style="q1" vid="PSA 88:1">Long dei mo long naet,</para>
  <para style="q2" vid="PSA 88:1">mi stap krae long yu,</para>
  <para style="q3" vid="PSA 88:1">blong yu yu halpem mi.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Plis yu harem prea blong mi.</para>
  <para style="q1" vid="PSA 88:2">Mi mi stap krae long yu</para>
  <para style="q2" vid="PSA 88:2">blong yu givhan long mi.</para>
  <para style="q1" vid="PSA 88:2">Plis yu lesin long mi.<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Plante trabol tumas oli stap kasem mi,</para>
  <para style="q2" vid="PSA 88:3">we klosap mi mi ded from.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />Naoia, paoa blong mi i lus olgeta,</para>
  <para style="q2" vid="PSA 88:4">oli stap kaontem mi wetem olgeta</para>
  <para style="q4" vid="PSA 88:4">we klosap oli ded.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Ol man oli luk mi olsem we mi mi ded finis.</para>
  <para style="q1" vid="PSA 88:5">Mi mi olsem ol man we oli ded long faet,</para>
  <para style="q2" vid="PSA 88:5">we oli stap finis long beregraon.</para>
  <para style="q1" vid="PSA 88:5">Yu yu fogetem olgeta finis,</para>
  <para style="q2" vid="PSA 88:5">yu no moa save givhan long olgeta.<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Yu sakem mi finis insaed long hol</para>
  <para style="q2" vid="PSA 88:6">we i godaon we i godaon olgeta.</para>
  <para style="q1" vid="PSA 88:6">Hol ya i godaon we i godaon,</para>
  <para style="q2" vid="PSA 88:6">mo i tudak tu.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Yu yu kros tumas long mi,</para>
  <para style="q1" vid="PSA 88:7">Kros blong yu i flatem mi olgeta,</para>
  <para style="q2" vid="PSA 88:7">i olsem we bigsi i rolem mi,</para>
  <para style="q3" vid="PSA 88:7">i flatemgud mi.<verse eid="PSA 88:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Yu yu mekem we ol fren blong mi oli lego mi finis,</para>
  <para style="q2" vid="PSA 88:8">yu mekem mi mi kam olsem wan samting</para>
  <para style="q4" vid="PSA 88:8">we i nogud tumas long fes blong olgeta.</para>
  <para style="q1" vid="PSA 88:8">Yu blokemgud ol rod blong mi,</para>
  <para style="q2" vid="PSA 88:8">nao mi mi no save ronwe.<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />Mi mi harem nogud tumas,</para>
  <para style="q2" vid="PSA 88:9">mi krae gogo ae blong mi i kam nogud from.</para>
  <para style="q1" vid="PSA 88:9">Hae God.</para>
  <para style="q1" vid="PSA 88:9">Evri dei nomo,</para>
  <para style="q2" vid="PSA 88:9">mi mi stap singaot long yu,</para>
  <para style="q3" vid="PSA 88:9">mi stap leftemap han blong mi,</para>
  <para style="q4" vid="PSA 88:9">mi stap prea long yu.<verse eid="PSA 88:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />?Olsem wanem?</para>
  <para style="q1" vid="PSA 88:10">?Ol merikel we yu yu stap mekem,</para>
  <para style="q2" vid="PSA 88:10">be ol dedman oli save luk?</para>
  <para style="q1" vid="PSA 88:10">!Ol dedman oli no save girap bakegen</para>
  <para style="q2" vid="PSA 88:10">blong presem yu!<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />?Oltaem yu yu lavem man tumas,</para>
  <para style="q3" vid="PSA 88:11">mo yu stap holem ol promes blong yu,</para>
  <para style="q2" vid="PSA 88:11">be olgeta we oli stap finis long beregraon</para>
  <para style="q4" vid="PSA 88:11">oli save talemaot ol fasin ya?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Olgeta ya oli stap long ples ya</para>
  <para style="q2" vid="PSA 88:12">we ol man oli fogetem olgeta finis,</para>
  <para style="q3" vid="PSA 88:12">mo oli no save luk ol gudgudfala fasin blong yu.</para>
  <para style="q1" vid="PSA 88:12">!Olgeta we oli stap finis long tudak ya,</para>
  <para style="q2" vid="PSA 88:12">oli no save luk ol merikel ya blong yu!<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Hae God.</para>
  <para style="q1" vid="PSA 88:13">Evri moning mi stap prea long yu,</para>
  <para style="q2" vid="PSA 88:13">mi stap krae long yu blong yu givhan long mi.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />Hae God.</para>
  <para style="q1" vid="PSA 88:14">?From wanem yu tanem baksaed long mi?</para>
  <para style="q1" vid="PSA 88:14">?From wanem yu tanem fes blong yu</para>
  <para style="q3" vid="PSA 88:14">i gowe long mi?<verse eid="PSA 88:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />I stat long taem we mi mi yangfala,</para>
  <para style="q3" vid="PSA 88:15">kam kasem tede,</para>
  <para style="q2" vid="PSA 88:15">oltaem nomo,</para>
  <para style="q3" vid="PSA 88:15">mi mi stap harem nogud long bodi blong mi,</para>
  <para style="q4" vid="PSA 88:15">we klosap mi ded from.</para>
  <para style="q1" vid="PSA 88:15">Panis ya we yu stap givim long mi</para>
  <para style="q2" vid="PSA 88:15">hem i hevi tumas,</para>
  <para style="q3" vid="PSA 88:15">nao i mekem mi mi slak we mi slak.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Yu yu kros tumas long mi</para>
  <para style="q2" vid="PSA 88:16">nao tingting blong mi i foldaon.</para>
  <para style="q1" vid="PSA 88:16">Yu mekem i strong tumas long mi,</para>
  <para style="q2" vid="PSA 88:16">yu mekem mi mi kam nogud olgeta.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Oltaem nomo,</para>
  <para style="q2" vid="PSA 88:17">i stat long moning go kasem long sapa,</para>
  <para style="q3" vid="PSA 88:17">panis ya we yu stap givim long mi</para>
  <para style="q4" vid="PSA 88:17">i kam kavremap mi <optbreak /> olsem wota we i ron bigwan,</para>
  <para style="q3" vid="PSA 88:17">i hivap raon long mi long evri saed.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Yu yu mekem olgeta man oli gowe long mi.</para>
  <para style="q1" vid="PSA 88:18">Nating we oli gudfala fren blong mi,</para>
  <para style="q2" vid="PSA 88:18">be yu mekem olgeta oli lego mi,</para>
  <para style="q3" vid="PSA 88:18">naoia tudak nomo i fren blong mi.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">Sing we ol laen blong Isrel oli sing long hem long taem we kantri blong olgeta i stap long trabol</para>
  <para style="sp">(Sing ya, Etan we i laen blong Esraha i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />Hae God.</para>
  <para style="q1" vid="PSA 89:1">Oltaem bambae mi stap singsing</para>
  <para style="q3" vid="PSA 89:1">from fasin ya blong yu</para>
  <para style="q4" vid="PSA 89:1">we oltaem yu yu lavem man tumas.</para>
  <para style="q1" vid="PSA 89:1">Fasin ya blong yu</para>
  <para style="q3" vid="PSA 89:1">we oltaem yu stap holem ol promes blong yu,</para>
  <para style="q2" vid="PSA 89:1">bambae mi stap talemaot oltaem nomo,</para>
  <para style="q3" vid="PSA 89:1">gogo i no save finis.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Mi mi save we fasin ya blong yu blong lavem man</para>
  <para style="q3" vid="PSA 89:2">bambae i stap oltaem nomo,</para>
  <para style="q2" vid="PSA 89:2">mo fasin ya blong yu blong holem ol promes blong yu</para>
  <para style="q4" vid="PSA 89:2">bambae i olsem skae, i no save lus.<verse eid="PSA 89:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Yu yu talem se,</para>
  <para style="q2" vid="PSA 89:3">“Mi mi mekem promes finis</para>
  <para style="q3" vid="PSA 89:3">wetem Deved,</para>
  <para style="q4" vid="PSA 89:3">man ya blong wok blong mi</para>
  <para style="q3" vid="PSA 89:3">we mi mi jusumaot hem bifo.<verse eid="PSA 89:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 89:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89.4: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:12-16">2 Saml 7.12-16</ref>; <ref loc="1CH 17:11-14">1 Kron 17.11-14</ref>; <ref loc="PSA 132:11">Sam 132.11</ref>; <ref loc="ACT 2:30">Wok 2.30</ref></char>
    </note>Mi mi talem long hem se,</para>
  <para style="q3" vid="PSA 89:4">‘Oltaem ol king blong ol man blong mi</para>
  <para style="q4" vid="PSA 89:4">bambae oli stap kamaot long olgeta</para>
  <para style="q3" vid="PSA 89:4">we oli stap kamaot biaen long yu.</para>
  <para style="q3" vid="PSA 89:4">Olgeta ya,</para>
  <para style="q4" vid="PSA 89:4">mi bambae mi holem olgeta <optbreak /> oli stap gud oltaem,</para>
  <para style="q3" vid="PSA 89:4">bambae mi stap lukaot gud long olgeta <optbreak /> gogo i no save finis.’ ”<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />Hae God.</para>
  <para style="q1" vid="PSA 89:5">Olgeta long heven oli stap singsing</para>
  <para style="q2" vid="PSA 89:5">blong talemaot ol gudgudfala fasin</para>
  <para style="q3" vid="PSA 89:5">we yu yu mekem,</para>
  <para style="q2" vid="PSA 89:5">oli stap sing from fasin ya</para>
  <para style="q3" vid="PSA 89:5">we yu yu stap holem ol promes blong yu.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />I no gat man long heven we i olsem yu.</para>
  <para style="q1" vid="PSA 89:6">Long olgeta we oli stap long heven,</para>
  <para style="q2" vid="PSA 89:6">be i no gat wan man nating</para>
  <para style="q3" vid="PSA 89:6">we i sem mak long yu.<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Olgeta enjel long heven oli tabu we i tabu,</para>
  <para style="q2" vid="PSA 89:7">be oli stap ona long yu.</para>
  <para style="q1" vid="PSA 89:7">Olgeta evriwan oli stap fraet long yu,</para>
  <para style="q2" vid="PSA 89:7">from we yu yu hae we yu hae.<verse eid="PSA 89:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Hae God, yu yu God blong mi,</para>
  <para style="q2" vid="PSA 89:8">mo yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 89:8">I no gat wan man nating we i strong olsem yu.</para>
  <para style="q1" vid="PSA 89:8">Long olgeta samting,</para>
  <para style="q2" vid="PSA 89:8">oltaem yu yu stap holem ol promes blong yu.<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Solwota i strong tumas,</para>
  <para style="q2" vid="PSA 89:9">be yu yu stap rulum hem.</para>
  <para style="q1" vid="PSA 89:9">Taem we hem i raf tumas,</para>
  <para style="q2" vid="PSA 89:9">be yu yu stap mekem i kam kwaet bakegen.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Yu yu flatemgud Rahab,*</para>
  <para style="q3" vid="PSA 89:10">bigfala anamol ya blong solwota,</para>
  <para style="q2" vid="PSA 89:10">mo yu kilim hem i ded.</para>
  <para style="q1" vid="PSA 89:10">Yu yu stap winim ol enemi blong yu</para>
  <para style="q2" vid="PSA 89:10">long paoa blong yu we i strong tumas.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Skae i blong yu,</para>
  <para style="q2" vid="PSA 89:11">mo graon ya tu i blong yu.</para>
  <para style="q1" vid="PSA 89:11">Yu yu mekem wol ya</para>
  <para style="q2" vid="PSA 89:11">wetem olgeta samting we i stap long hem.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Yu yu mekem olgeta ples,</para>
  <para style="q2" vid="PSA 89:12">i stat long not, i go kasem long saot.</para>
  <para style="q1" vid="PSA 89:12">Hil ya Taboro mo hil ya Hemon tufala i glad tumas,</para>
  <para style="q2" vid="PSA 89:12">tufala i stap singsing blong presem yu.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />!Yu yu gat paoa blong mekem olgeta samting!</para>
  <para style="q1" vid="PSA 89:13">!Paoa blong yu i bigwan tumas!<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Yu yu King,</para>
  <para style="q2" vid="PSA 89:14">we fasin blong yu,</para>
  <para style="q3" vid="PSA 89:14">oltaem yu stap mekem i stret,</para>
  <para style="q4" vid="PSA 89:14">oltaem yu stap jajem ol man long stret rod.</para>
  <para style="q1" vid="PSA 89:14">Olgeta samting we yu stap mekem</para>
  <para style="q2" vid="PSA 89:14">oli stap soemaot</para>
  <para style="q3" vid="PSA 89:14">we oltaem yu stap lavem man tumas,</para>
  <para style="q4" vid="PSA 89:14">mo oltaem yu stap holem ol promes blong yu.<verse eid="PSA 89:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Olgeta we oli stap singsing blong presem yu,</para>
  <para style="q2" vid="PSA 89:15">oli glad tumas.</para>
  <para style="q1" vid="PSA 89:15">Oltaem yu yu kaen gud long olgeta,</para>
  <para style="q3" vid="PSA 89:15">nao i olsem we oli stap wokbaot long delaet.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Yu yu mekem olgeta oli harem gud,</para>
  <para style="q2" vid="PSA 89:16">i stat long moning go kasem long sapa.</para>
  <para style="q1" vid="PSA 89:16">Mo oltaem oli stap presem yu</para>
  <para style="q2" vid="PSA 89:16">from ol gudgudfala fasin blong yu.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Oltaem yu yu mekem mifala</para>
  <para style="q2" vid="PSA 89:17">i stap win gud long faet.</para>
  <para style="q1" vid="PSA 89:17">Yu stap mekem mifala i win</para>
  <para style="q3" vid="PSA 89:17">from we yu lavem mifala tumas.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Hae God, yu yu tabu we yu tabu.</para>
  <para style="q1" vid="PSA 89:18">Yu yu God blong mifala ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 89:18">mo yu jusumaot king ya blong mifala,</para>
  <para style="q4" vid="PSA 89:18">we i stap lukaot long mifala,</para>
  <para style="q3" vid="PSA 89:18">yu putumap hem i kam king.<verse eid="PSA 89:18" /></para>
  <para style="s">Promes we God i mekem wetem Deved</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Longtaem bifo,</para>
  <para style="q2" vid="PSA 89:19">yu yu kamtru long ol man blong wok blong yu,</para>
  <para style="q4" vid="PSA 89:19">we tingting blong olgeta i stap strong long yu,</para>
  <para style="q3" vid="PSA 89:19">yu toktok long olgeta long vison.*</para>
  <para style="q1" vid="PSA 89:19">Yu yu talem se,</para>
  <para style="q2" vid="PSA 89:19">“Mi mi givhan long wan soldia</para>
  <para style="q3" vid="PSA 89:19">we i gat hae nem.</para>
  <para style="q2" vid="PSA 89:19">Mi jusumaot hem long olgeta man,</para>
  <para style="q3" vid="PSA 89:19">nao mi putumap hem i kam king.<verse eid="PSA 89:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="PSA 89:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89.20 a: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 13:14">1 Saml 13.14</ref>; <ref loc="ACT 13:22">Wok 13.22</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:12">1 Saml 16.12</ref>
      </char>
    </note>Soldia ya Deved ya,</para>
  <para style="q4" vid="PSA 89:20">we i man blong wok blong mi,</para>
  <para style="q3" vid="PSA 89:20">mo mi kafsaedem tabu oel</para>
  <para style="q4" vid="PSA 89:20">i go long hed blong hem,</para>
  <para style="q3" vid="PSA 89:20">mi mekem hem i king.<verse eid="PSA 89:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="PSA 89:21" />Mi bambae mi mekem hem i strong,</para>
  <para style="q3" vid="PSA 89:21">oltaem paoa blong mi bambae i stap wetem hem.<verse eid="PSA 89:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 89:22" />Ol enemi blong hem neva bambae oli winim hem,</para>
  <para style="q3" vid="PSA 89:22">ol man nogud bambae oli no save daonem hem samtaem.<verse eid="PSA 89:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PSA 89:23" />Bambae mi flatem ol enemi blong hem,</para>
  <para style="q3" vid="PSA 89:23">mi kilim olgeta evriwan</para>
  <para style="q4" vid="PSA 89:23">we oli no laekem hem,</para>
  <para style="q3" vid="PSA 89:23">oli stap agens long hem.<verse eid="PSA 89:23" /></para>
  <para style="q2">
    <verse number="24" style="v" sid="PSA 89:24" />Be hem,</para>
  <para style="q4" vid="PSA 89:24">bambae mi lavem hem tumas,</para>
  <para style="q3" vid="PSA 89:24">tingting blong mi</para>
  <para style="q3" vid="PSA 89:24">bambae i stap strong long hem oltaem,</para>
  <para style="q4" vid="PSA 89:24">mo bambae mi mekem we hem i stap win oltaem.<verse eid="PSA 89:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="PSA 89:25" />Bambae mi mekem kingdom blong hem i kam bigwan,</para>
  <para style="q3" vid="PSA 89:25">i stat long Mediterenean Si</para>
  <para style="q4" vid="PSA 89:25">go kasem Yufretes Reva.<verse eid="PSA 89:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="PSA 89:26" />Bambae hem i talem long mi se,</para>
  <para style="q3" vid="PSA 89:26">‘Yu yu papa blong mi,</para>
  <para style="q4" vid="PSA 89:26">mo yu yu God blong mi.</para>
  <para style="q3" vid="PSA 89:26">Oltaem yu stap lukaot gud long mi,</para>
  <para style="q4" vid="PSA 89:26">yu stap sevem mi.’<verse eid="PSA 89:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="PSA 89:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89.27: </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:5">Rev 1.5</ref>
      </char>
    </note>Bambae mi mekem hem i fasbon pikinini blong mi,</para>
  <para style="q3" vid="PSA 89:27">mo bambae hem i hae we i hae,</para>
  <para style="q3" vid="PSA 89:27">i winim ol narafala king.<verse eid="PSA 89:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="PSA 89:28" />Oltaem bambae mi stap holem promes blong mi</para>
  <para style="q4" vid="PSA 89:28">we mi mekem wetem hem,</para>
  <para style="q3" vid="PSA 89:28">mo promes ya bambae i stap oltaem,</para>
  <para style="q3" vid="PSA 89:28">i no save finis.<verse eid="PSA 89:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="PSA 89:29" />Olgeta we bambae oli stap kamaot biaen long hem,</para>
  <para style="q3" vid="PSA 89:29">bambae mi mi holem olgeta</para>
  <para style="q4" vid="PSA 89:29">oli stap gud oltaem,</para>
  <para style="q3" vid="PSA 89:29">olsem we skae i stap oltaem nomo.</para>
  <para style="q2" vid="PSA 89:29">Oltaem ol king blong ol man blong mi</para>
  <para style="q3" vid="PSA 89:29">bambae oli stap kamaot biaen long olgeta ya.<verse eid="PSA 89:29" /></para>
  <para style="q2">
    <verse number="30-32" style="v" sid="PSA 89:30-32" />“Be sipos olgeta ya</para>
  <para style="q4" vid="PSA 89:30-32">oli no obei long ol loa blong mi,</para>
  <para style="q3" vid="PSA 89:30-32">mo oli no stap folem ol tok <optbreak /> we mi stap givim long olgeta,</para>
  <para style="q3" vid="PSA 89:30-32">bambae mi mi panisim olgeta</para>
  <para style="q4" vid="PSA 89:30-32">from ol sin ya blong olgeta.</para>
  <para style="q2" vid="PSA 89:30-32">Sipos olgeta oli no tingting long ol tok</para>
  <para style="q3" vid="PSA 89:30-32">we mi stap tijim olgeta long hem,</para>
  <para style="q4" vid="PSA 89:30-32">mo oli no stap holem ol tok blong mi,</para>
  <para style="q3" vid="PSA 89:30-32">bambae mi mekem</para>
  <para style="q4" vid="PSA 89:30-32">we olgeta oli harem nogud</para>
  <para style="q3" vid="PSA 89:30-32">from ol fasin nogud ya we oli mekem.<verse eid="PSA 89:30-32" /></para>
  <para style="q2">
    <verse number="33" style="v" sid="PSA 89:33" />Be Deved,</para>
  <para style="q3" vid="PSA 89:33">bambae mi lavem hem oltaem nomo,</para>
  <para style="q3" vid="PSA 89:33">gogo i no save finis,</para>
  <para style="q4" vid="PSA 89:33">tingting blong mi bambae i stap strong long hem, <optbreak /> we bambae i no save foldaon.<verse eid="PSA 89:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="PSA 89:34" />Bambae mi no save brekem promes ya blong mi</para>
  <para style="q4" vid="PSA 89:34">we mi mekem wetem hem,</para>
  <para style="q3" vid="PSA 89:34">bambae mi no save jenisim</para>
  <para style="q4" vid="PSA 89:34">wan tok blong promes ya nating.<verse eid="PSA 89:34" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="35" style="v" sid="PSA 89:35" />“Mi mi tabu we mi tabu,</para>
  <para style="q3" vid="PSA 89:35">mo long nem blong mi,</para>
  <para style="q4" vid="PSA 89:35">mi talem long yufala finis,</para>
  <para style="q3" vid="PSA 89:35">se neva bambae mi save brekem promes ya <optbreak /> we mi mekem wetem Deved.<verse eid="PSA 89:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 89:36" />Olgeta we bambae oli stap kamaot biaen long hem</para>
  <para style="q3" vid="PSA 89:36">bambae mi holem olgeta oli stap oltaem nomo.</para>
  <para style="q3" vid="PSA 89:36">Mi bambae mi stap lukaot long olgeta,</para>
  <para style="q4" vid="PSA 89:36">blong oli stap king oltaem</para>
  <para style="q3" vid="PSA 89:36">olsem we san i stap oltaem nomo.<verse eid="PSA 89:36" /></para>
  <para style="q2">
    <verse number="37" style="v" sid="PSA 89:37" />Bambae oli stap king oltaem</para>
  <para style="q3" vid="PSA 89:37">olsem we mun i stap oltaem</para>
  <para style="q3" vid="PSA 89:37">long skae,</para>
  <para style="q4" vid="PSA 89:37">i stap witnes long mi.”<verse eid="PSA 89:37" /></para>
  <para style="s">Ol man oli stap krae from we ol enemi oli winim king blong olgeta</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Hae God.</para>
  <para style="q1" vid="PSA 89:38">Naoia, king ya we yu yu jusumaot hem,</para>
  <para style="q2" vid="PSA 89:38">yu yu kros long hem bakegen,</para>
  <para style="q3" vid="PSA 89:38">yu lego hem finis,</para>
  <para style="q4" vid="PSA 89:38">yu tanem baksaed long hem.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Yu yu brekem promes* ya finis we yu mekem bifo</para>
  <para style="q3" vid="PSA 89:39">wetem man ya blong wok blong yu.</para>
  <para style="q1" vid="PSA 89:39">I olsem we yu tekemaot hat blong king finis long hem,</para>
  <para style="q2" vid="PSA 89:39">yu sakem i go long sofmad.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Yu brekemdaon finis ol stonwol blong taon blong hem,</para>
  <para style="q2" vid="PSA 89:40">yu spolemgud ol strong sefples blong hem.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Ol man we oli stap kam pas long ples ya</para>
  <para style="q3" vid="PSA 89:41">oli stap stilim olting blong hem,</para>
  <para style="q2" vid="PSA 89:41">mo ol man we oli stap raonabaot long hem</para>
  <para style="q4" vid="PSA 89:41">oli stap laf nogud long hem.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Yu yu mekem we ol enemi blong hem</para>
  <para style="q3" vid="PSA 89:42">oli stap win,</para>
  <para style="q2" vid="PSA 89:42">nao olgeta oli stap harem gud tumas.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Yu mekem</para>
  <para style="q3" vid="PSA 89:43">we ol samting blong faet blong hem</para>
  <para style="q4" vid="PSA 89:43">oli kam nogud,</para>
  <para style="q2" vid="PSA 89:43">nao yu letem ol enemi blong hem</para>
  <para style="q3" vid="PSA 89:43">oli kam faet long hem,</para>
  <para style="q4" vid="PSA 89:43">oli winim hem.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Wokingstik blong king,</para>
  <para style="q3" vid="PSA 89:44">yu tekemaot long hem finis,</para>
  <para style="q2" vid="PSA 89:44">mo bigfala jea blong king,</para>
  <para style="q3" vid="PSA 89:44">yu yu tekemaot long hem,</para>
  <para style="q4" vid="PSA 89:44">yu sakem i go long graon.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Yu yu mekem we hem i kam olfala kwiktaem nomo,</para>
  <para style="q2" vid="PSA 89:45">mo yu mekem hem i sem we i sem.<verse eid="PSA 89:45" /></para>
  <para style="s">King i prea blong God i sevem hem</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />Hae God.</para>
  <para style="q1" vid="PSA 89:46">Naoia mifala i no save luk yu.</para>
  <para style="q1" vid="PSA 89:46">?Bambae yu stap haed olwe nomo?</para>
  <para style="q1" vid="PSA 89:46">?Bambae kros blong yu i stap bon olsem faea</para>
  <para style="q3" vid="PSA 89:46">gogo kasem wetaem?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Plis yu no fogetem mi.</para>
  <para style="q1" vid="PSA 89:47">Mi mi man nomo,</para>
  <para style="q2" vid="PSA 89:47">mo laef blong mi i sotfala nomo.</para>
  <para style="q1" vid="PSA 89:47">Yu yu mekem mifala,</para>
  <para style="q2" vid="PSA 89:47">mo mifala evriwan i mas ded.<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />?Hu man we i save stap oltaem,</para>
  <para style="q2" vid="PSA 89:48">we i no save ded?</para>
  <para style="q1" vid="PSA 89:48">I no gat man i save ronwe long beregraon.<verse eid="PSA 89:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />?Masta<note caller="+" style="f"><char style="fr" closed="false">89.49: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long 35.22.</char></note> blong mi,</para>
  <para style="q2" vid="PSA 89:49">wehem gudfala fasin ya blong yu</para>
  <para style="q4" vid="PSA 89:49">we yu stap soemaot bifo,</para>
  <para style="q3" vid="PSA 89:49">we oltaem yu stap lavem man tumas?</para>
  <para style="q1" vid="PSA 89:49">?Wehem ol promes ya</para>
  <para style="q2" vid="PSA 89:49">we yu yu mekem wetem King Deved bifo?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 89:50">plis yu no fogetem mi.</para>
  <para style="q1" vid="PSA 89:50">Oltaem ol man oli stap tok nogud long mi,</para>
  <para style="q2" vid="PSA 89:50">mo ol hiten man oli stap singaot* trabol i kam long mi.<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />Hae God,</para>
  <para style="q2" vid="PSA 89:51">mi mi king we yu nomo yu jusumaot mi,</para>
  <para style="q3" vid="PSA 89:51">be ol enemi blong yu oli stap tok nogud long mi.</para>
  <para style="q1" vid="PSA 89:51">Long weples we mi mi pas long hem,</para>
  <para style="q2" vid="PSA 89:51">be olgeta oli stap laf nogud long mi.<verse eid="PSA 89:51" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />!Oltaem bambae yumi mas presem Hae God,</para>
  <para style="q2" vid="PSA 89:52">gogo i no save finis!</para>
  <para style="b" vid="PSA 89:52" />
  <para style="q1" vid="PSA 89:52">!Amen!</para>
  <para style="q1" vid="PSA 89:52">!Amen!<verse eid="PSA 89:52" /></para>
  <para style="b" />
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">BUK FO</para>
  <para style="mr">(<ref loc="PSA 90-106">Sam 90—106</ref>)</para>
  <para style="s">Man i save stap smoltaem, be God bambae i stap oltaem nomo</para>
  <para style="sp">(Sing ya, Moses, man blong wok blong God i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />Masta.<note caller="+" style="f"><char style="fr" closed="false">90.1: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long 35.22.</char></note></para>
  <para style="q1" vid="PSA 90:1">I stat bifo olgeta kam kasem tede,</para>
  <para style="q2" vid="PSA 90:1">oltaem,</para>
  <para style="q3" vid="PSA 90:1">yu yu olsem hom blong mifala.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Bifo,</para>
  <para style="q2" vid="PSA 90:2">taem we yu no mekem ol hil ya yet,</para>
  <para style="q3" vid="PSA 90:2">long taem ya we yu no wokem wol ya nating yet,</para>
  <para style="q2" vid="PSA 90:2">be yu yu stap fastaem finis.</para>
  <para style="q1" vid="PSA 90:2">Yu yu God we yu stap we yu stap,</para>
  <para style="q2" vid="PSA 90:2">mo bambae yu save stap oltaem,</para>
  <para style="q3" vid="PSA 90:2">gogo i no save finis.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Fastaem yu tekem graon,</para>
  <para style="q3" vid="PSA 90:3">yu mekem mifala long hem,</para>
  <para style="q2" vid="PSA 90:3">mo oltaem yu stap mekem mifala</para>
  <para style="q4" vid="PSA 90:3">i gobak long graon bakegen.</para>
  <para style="q1" vid="PSA 90:3">Yu stap talem se,</para>
  <para style="q2" vid="PSA 90:3">“Ol man long wol,</para>
  <para style="q3" vid="PSA 90:3">yufala i mas gobak long graon.”<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90.4: </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:8">2 Pita 3.8</ref>
      </char>
    </note>Long yu,</para>
  <para style="q2" vid="PSA 90:4">wan taosen yia i olsem wan dei nomo,</para>
  <para style="q3" vid="PSA 90:4">i olsem yestedei we i pas finis,</para>
  <para style="q4" vid="PSA 90:4">i olsem wan aoa nomo long naet,</para>
  <para style="q3" vid="PSA 90:4">we i pas kwiktaem nomo.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Yu yu stap tekemaot mifala,</para>
  <para style="q2" vid="PSA 90:5">olsem wota we i ron bigwan,</para>
  <para style="q3" vid="PSA 90:5">we i brumumaot ol samting.</para>
  <para style="q1" vid="PSA 90:5">Mifala i no save stap longtaem,</para>
  <para style="q2" vid="PSA 90:5">mifala i olsem drim nomo.</para>
  <para style="q1" vid="PSA 90:5">Mifala i olsem gras we i stap gru olbaot.<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />Long moning, hem i karem flaoa,</para>
  <para style="q2" vid="PSA 90:6">be long sapa, flaoa ya i drae,</para>
  <para style="q3" vid="PSA 90:6">i foldaon.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Yu yu kros,</para>
  <para style="q2" vid="PSA 90:7">nao yu spolem mifala.</para>
  <para style="q1" vid="PSA 90:7">Yu yu kros tumas long mifala,</para>
  <para style="q2" vid="PSA 90:7">nao mifala i fraet we i fraet nogud.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Yu stap mekem</para>
  <para style="q3" vid="PSA 90:8">we ol sin blong mifala i kamaot klia long fes blong yu,</para>
  <para style="q2" vid="PSA 90:8">yu stap luk ol rabis fasin ya</para>
  <para style="q4" vid="PSA 90:8">we mifala i stap mekem long haed nomo.<verse eid="PSA 90:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Yu yu kros,</para>
  <para style="q2" vid="PSA 90:9">nao yu stap katem</para>
  <para style="q3" vid="PSA 90:9">laef blong mifala i kam sotfala.</para>
  <para style="q1" vid="PSA 90:9">Mifala i stap lus,</para>
  <para style="q2" vid="PSA 90:9">olsem win we i godaon, i finis.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Yia blong mifala i save kasem seventi nomo,</para>
  <para style="q2" vid="PSA 90:10">no sipos bodi blong mifala i stap strong oltaem,</para>
  <para style="q4" vid="PSA 90:10">mifala i save kasem eiti,</para>
  <para style="q3" vid="PSA 90:10">be oltaem mifala i stap kasem trabol,</para>
  <para style="q3" vid="PSA 90:10">mifala i stap harem nogud nomo.</para>
  <para style="q1" vid="PSA 90:10">Laef blong mifala i save finis kwiktaem nomo,</para>
  <para style="q2" vid="PSA 90:10">nao mifala i go lus olgeta.<verse eid="PSA 90:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />I no gat man samtaem</para>
  <para style="q2" vid="PSA 90:11">we i kasem fulpaoa blong kros blong yu.</para>
  <para style="q1" vid="PSA 90:11">I no gat man yet</para>
  <para style="q2" vid="PSA 90:11">we i savegud fasin blong yu blong kros,</para>
  <para style="q3" vid="PSA 90:11">nao i fraet gud long yu from.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Plis yu mekem mifala i save</para>
  <para style="q3" vid="PSA 90:12">we laef blong mifala i sotfala nomo,</para>
  <para style="q2" vid="PSA 90:12">blong mifala i save kam waes.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Hae God.</para>
  <para style="q1" vid="PSA 90:13">?Bambae yu yu stap kros long mifala</para>
  <para style="q3" vid="PSA 90:13">gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 90:13">Mifala i man blong wok blong yu,</para>
  <para style="q2" vid="PSA 90:13">plis yu sore long mifala.<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Plis yu mekem</para>
  <para style="q2" vid="PSA 90:14">we evri moning, mifala i savegud</para>
  <para style="q3" vid="PSA 90:14">we oltaem yu yu lavem mifala tumas,</para>
  <para style="q2" vid="PSA 90:14">nao bambae mifala i save singsing,</para>
  <para style="q3" vid="PSA 90:14">mifala i save glad oltaem long laef blong mifala.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Long ol yia we i pas finis,</para>
  <para style="q2" vid="PSA 90:15">yu yu stap mekem mifala i harem nogud tumas.</para>
  <para style="q1" vid="PSA 90:15">Plis naoia,</para>
  <para style="q2" vid="PSA 90:15">yu mekem mifala i harem gud,</para>
  <para style="q3" vid="PSA 90:15">stret long mak we bifo</para>
  <para style="q4" vid="PSA 90:15">yu bin mekem mifala i harem nogud.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Mifala i man blong wok blong yu.</para>
  <para style="q1" vid="PSA 90:16">Plis yu letem mifala i luk</para>
  <para style="q3" vid="PSA 90:16">ol bigbigfala wok blong yu,</para>
  <para style="q2" vid="PSA 90:16">mo yu letem olgeta</para>
  <para style="q3" vid="PSA 90:16">we bambae oli stap kamaot biaen long mifala</para>
  <para style="q4" vid="PSA 90:16">oli luk bigfala paoa blong yu.<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />God,</para>
  <para style="q2" vid="PSA 90:17">yu yu Masta* blong mifala.</para>
  <para style="q1" vid="PSA 90:17">Plis yu givim ol gudgudfala samting blong yu long mifala,</para>
  <para style="q2" vid="PSA 90:17">mo yu mekem we bambae mifala i stap win oltaem</para>
  <para style="q4" vid="PSA 90:17">long olgeta samting we mifala i stap mekem.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">Hae God i stap lukaot gud long yumi</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 91:1-2" />Hae God i hae we i hae,</para>
  <para style="q2" vid="PSA 91:1-2">mo hem i gat olgeta paoa.</para>
  <para style="q1" vid="PSA 91:1-2">Mo man we i stap aninit long han blong hem,</para>
  <para style="q2" vid="PSA 91:1-2">mo i stap trastem hem blong i lukaot gud long hem,</para>
  <para style="q2" vid="PSA 91:1-2">hem i save talem se,</para>
  <para style="q2" vid="PSA 91:1-2">“Yu yu God blong mi,</para>
  <para style="q3" vid="PSA 91:1-2">mo mi mi trastem yu.</para>
  <para style="q2" vid="PSA 91:1-2">Yu yu stap lukaot gud long mi,</para>
  <para style="q3" vid="PSA 91:1-2">mo yu stap blokemgud mi.”<verse eid="PSA 91:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Sipos yu yu mekem olsem,</para>
  <para style="q2" vid="PSA 91:3">Hae God bambae i lukaot gud long yu,</para>
  <para style="q3" vid="PSA 91:3">i sevem yu long olgeta samting</para>
  <para style="q4" vid="PSA 91:3">we i stap haed blong kasem yu,</para>
  <para style="q3" vid="PSA 91:3">mo bambae i tekemaot yu long olgeta sik</para>
  <para style="q3" vid="PSA 91:3">we oli blong kilim man i ded.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />Bambae hem i blokem yu yu stap gud</para>
  <para style="q2" vid="PSA 91:4">olsem we pikinini blong faol i stap gud</para>
  <para style="q3" vid="PSA 91:4">aninit long wing blong mama blong hem.</para>
  <para style="q1" vid="PSA 91:4">Oltaem tingting blong hem</para>
  <para style="q3" vid="PSA 91:4">bambae i stap strong long yu,</para>
  <para style="q2" vid="PSA 91:4">nao bambae hem i lukaot gud long yu,</para>
  <para style="q4" vid="PSA 91:4">i blokemgud yu.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Nao long naet,</para>
  <para style="q2" vid="PSA 91:5">bambae yu no save fraet long ol samting</para>
  <para style="q3" vid="PSA 91:5">we oli stap mekem man i fraet,</para>
  <para style="q2" vid="PSA 91:5">mo long dei,</para>
  <para style="q3" vid="PSA 91:5">bambae yu no save fraet long ol man</para>
  <para style="q4" vid="PSA 91:5">we oli girap blong kam kilim yu.<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />Bambae yu no moa save fraet nating</para>
  <para style="q2" vid="PSA 91:6">long ol rabis sik ya</para>
  <para style="q4" vid="PSA 91:6">we oli stap kasem man long tudak,</para>
  <para style="q3" vid="PSA 91:6">mo long ol rabis fasin ya</para>
  <para style="q3" vid="PSA 91:6">we oli stap kilim man long delaet.<verse eid="PSA 91:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Maet wan taosen man</para>
  <para style="q2" vid="PSA 91:7">we oli stap klosap long yu</para>
  <para style="q3" vid="PSA 91:7">oli save foldaon, oli ded.</para>
  <para style="q1" vid="PSA 91:7">Maet ten taosen man</para>
  <para style="q2" vid="PSA 91:7">we oli stap raonabaot long yu</para>
  <para style="q3" vid="PSA 91:7">oli save lus evriwan,</para>
  <para style="q2" vid="PSA 91:7">be ol trabol ya</para>
  <para style="q3" vid="PSA 91:7">bambae oli no save spolem yu.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Bambae yu save luk stret long ae blong yu,</para>
  <para style="q2" vid="PSA 91:8">we ol man nogud oli stap kasem panis.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Hae God i hae we i hae,</para>
  <para style="q2" vid="PSA 91:9">mo from we yu yu stap putum</para>
  <para style="q4" vid="PSA 91:9">tingting blong yu i stap long hem,</para>
  <para style="q3" vid="PSA 91:9">hem bambae i stap blokemgud yu,</para>
  <para style="q3" vid="PSA 91:9">i stap lukaot gud long yu.<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />Nao from samting ya,</para>
  <para style="q2" vid="PSA 91:10">i no gat wan samting nogud</para>
  <para style="q3" vid="PSA 91:10">we bambae i save kam spolem yu,</para>
  <para style="q2" vid="PSA 91:10">i no gat wan rabis sik</para>
  <para style="q3" vid="PSA 91:10">we bambae i save kam klosap</para>
  <para style="q4" vid="PSA 91:10">long haos blong yu.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91.11: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:6">Mat 4.6</ref>; <ref loc="LUK 4:10">Luk 4.10</ref></char>
    </note>Hae God bambae i putum</para>
  <para style="q2" vid="PSA 91:11">ol enjel blong hem oli stap raonabaot long yu</para>
  <para style="q3" vid="PSA 91:11">blong oli stap lukaot gud long yu</para>
  <para style="q4" vid="PSA 91:11">long weples yu yu pas long hem.<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91.12: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:6">Mat 4.6</ref>; <ref loc="LUK 4:11">Luk 4.11</ref></char>
    </note>Bambae oli holem yu long han blong olgeta,</para>
  <para style="q2" vid="PSA 91:12">oli leftemap yu i go antap,</para>
  <para style="q3" vid="PSA 91:12">blong yu no save kikim ston long leg blong yu.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91.13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:19">Luk 10.19</ref>
      </char>
    </note>Bambae yu save purumbut</para>
  <para style="q3" vid="PSA 91:13">long ol laeon mo long ol snek</para>
  <para style="q2" vid="PSA 91:13">blong kilim olgeta.</para>
  <para style="q1" vid="PSA 91:13">Ol laeon ya we ol man oli fraet long olgeta,</para>
  <para style="q3" vid="PSA 91:13">mo ol posen snek ya,</para>
  <para style="q2" vid="PSA 91:13">be bambae yu save purumpurumbut</para>
  <para style="q4" vid="PSA 91:13">long olgeta</para>
  <para style="q3" vid="PSA 91:13">blong kilim olgeta oli ded.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />Hae God i talem se,</para>
  <para style="q2" vid="PSA 91:14">“Mi bambae mi sevem olgeta</para>
  <para style="q4" vid="PSA 91:14">we oli stap lavem mi,</para>
  <para style="q3" vid="PSA 91:14">mo bambae mi lukaot gud long olgeta</para>
  <para style="q3" vid="PSA 91:14">we oli save we mi mi Hae God.<verse eid="PSA 91:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 91:15" />Sipos oli singaot long mi,</para>
  <para style="q4" vid="PSA 91:15">mi bambae mi ansa long olgeta,</para>
  <para style="q3" vid="PSA 91:15">mo sipos oli stap long trabol, mi bambae mi stap wetem olgeta.</para>
  <para style="q2" vid="PSA 91:15">Mi bambae mi tekemaot olgeta long trabol,</para>
  <para style="q3" vid="PSA 91:15">mi leftemap olgeta,</para>
  <para style="q4" vid="PSA 91:15">mi givim hae nem long olgeta.<verse eid="PSA 91:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 91:16" />Mi bambae mi sevem olgeta,</para>
  <para style="q3" vid="PSA 91:16">mi givim longfala laef long olgeta,</para>
  <para style="q4" vid="PSA 91:16">olsem pei blong olgeta.”<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Sing blong singsing long hem long Sabat* dei.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />Hae God.</para>
  <para style="q1" vid="PSA 92:1">Yu yu God we yu hae we yu hae.</para>
  <para style="q1" vid="PSA 92:1">I gud tumas blong talem tangkiu long yu,</para>
  <para style="q2" vid="PSA 92:1">mo blong sing blong leftemap nem blong yu.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />I gud tumas blong talemaot evri moning</para>
  <para style="q3" vid="PSA 92:2">we oltaem yu yu lavem man tumas,</para>
  <para style="q2" vid="PSA 92:2">mo blong talemaot evri naet</para>
  <para style="q4" vid="PSA 92:2">we yu stap holem ol promes blong yu.<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />I gud tumas blong singsing wetem gita</para>
  <para style="q3" vid="PSA 92:3">mo yukalele mo mandolin</para>
  <para style="q2" vid="PSA 92:3">blong talemaot ol fasin ya blong yu.<verse eid="PSA 92:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Hae God,</para>
  <para style="q2" vid="PSA 92:4">ol bigbigfala wok blong yu</para>
  <para style="q3" vid="PSA 92:4">oli stap mekem mi mi glad tumas.</para>
  <para style="q1" vid="PSA 92:4">Oltaem mi mi harem gud,</para>
  <para style="q2" vid="PSA 92:4">mi stap sing from ol samting ya</para>
  <para style="q3" vid="PSA 92:4">we yu yu mekem.<verse eid="PSA 92:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />Hae God.</para>
  <para style="q1" vid="PSA 92:5">!Ol wok blong yu oli bigfala tumas!</para>
  <para style="q1" vid="PSA 92:5">!Tingting blong yu i dip we i dip!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Samting ya,</para>
  <para style="q2" vid="PSA 92:6">man we i no gat hed neva bambae hem i save,</para>
  <para style="q3" vid="PSA 92:6">man we i krangke bambae i no save luksave samtaem.<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7-8" style="v" sid="PSA 92:7-8" />Hae God,</para>
  <para style="q2" vid="PSA 92:7-8">ol man nogud oli save gru kwik</para>
  <para style="q4" vid="PSA 92:7-8">olsem rabis gras,</para>
  <para style="q3" vid="PSA 92:7-8">olgeta evriwan we oli stap mekem ol fasin nogud</para>
  <para style="q3" vid="PSA 92:7-8">oli save win long plante samting,</para>
  <para style="q2" vid="PSA 92:7-8">be bambae yu yu spolemgud olgeta,</para>
  <para style="q4" vid="PSA 92:7-8">from we yu yu hae we yu hae,</para>
  <para style="q3" vid="PSA 92:7-8">mo bambae yu stap olsem oltaem nomo,</para>
  <para style="q3" vid="PSA 92:7-8">gogo i no save finis.<verse eid="PSA 92:7-8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />Mifala i save</para>
  <para style="q2" vid="PSA 92:9">we ol enemi blong yu bambae oli ded.</para>
  <para style="q1" vid="PSA 92:9">Yu bambae yu winim olgeta man nogud.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Yu yu mekem mi mi strong olsem wael buluk,</para>
  <para style="q2" vid="PSA 92:10">mo yu blesem mi,</para>
  <para style="q3" vid="PSA 92:10">yu mekem mi mi harem gud tumas.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Mi mi luk finis</para>
  <para style="q3" vid="PSA 92:11">we ol enemi blong mi oli lus.</para>
  <para style="q1" vid="PSA 92:11">Olgeta oli man nogud,</para>
  <para style="q2" vid="PSA 92:11">mo mi harem finis we oli stap krae.<verse eid="PSA 92:11" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="12-13" style="v" sid="PSA 92:12-13" />Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 92:12-13">mo ol man we fasin blong olgeta i stret</para>
  <para style="q3" vid="PSA 92:12-13">oli stap oltaem long haos* blong hem.</para>
  <para style="q1" vid="PSA 92:12-13">Bambae oli gru gud olsem pamtri,*</para>
  <para style="q2" vid="PSA 92:12-13">bambae oli gru olsem ol sida* ya long Lebanon.</para>
  <para style="q1" vid="PSA 92:12-13">Oltaem oli stap kam strong moa,</para>
  <para style="q2" vid="PSA 92:12-13">olsem ol tri we man i planem long gudfala graon,</para>
  <para style="q3" vid="PSA 92:12-13">mo oli stap gru gud oltaem.<verse eid="PSA 92:12-13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Olgeta oli strong olsem olfala tri</para>
  <para style="q2" vid="PSA 92:14">we lif blong hem i stap grin oltaem</para>
  <para style="q3" vid="PSA 92:14">mo i stap karem plante frut yet.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />Hemia i soemaot we Hae God,</para>
  <para style="q2" vid="PSA 92:15">fasin blong hem i stret gud olgeta,</para>
  <para style="q3" vid="PSA 92:15">i no gat wan samting nating long hem</para>
  <para style="q4" vid="PSA 92:15">we i no stret.</para>
  <para style="q1" vid="PSA 92:15">Oltaem hem i stap lukaot gud long mi.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">Hae God, hem i king</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />!Hae God, yu yu king!</para>
  <para style="q1" vid="PSA 93:1">Hae nem blong yu mo paoa blong yu</para>
  <para style="q2" vid="PSA 93:1">i stap oltaem long yu,</para>
  <para style="q3" vid="PSA 93:1">olsem klos blong yu nomo.</para>
  <para style="q1" vid="PSA 93:1">Yu yu stanemap wol ya,</para>
  <para style="q2" vid="PSA 93:1">mo hem i stanap strong long ples blong hem</para>
  <para style="q3" vid="PSA 93:1">we i no save muf.<verse eid="PSA 93:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Hae God, yu yu King.</para>
  <para style="q1" vid="PSA 93:2">Yu yu stap rul bifo olgeta kam kasem naoia,</para>
  <para style="q2" vid="PSA 93:2">mo paoa blong yu i no save foldaon.</para>
  <para style="q1" vid="PSA 93:2">Yu yu stap bifo we bifo olgeta,</para>
  <para style="q2" vid="PSA 93:2">kam kasem tede.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />Hae God.</para>
  <para style="q1" vid="PSA 93:3">Noes blong dipsi i go antap,</para>
  <para style="q3" vid="PSA 93:3">we i go antap olgeta.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Be yu yu stap rul long heven,</para>
  <para style="q2" vid="PSA 93:4">mo yu yu hae moa.</para>
  <para style="q1" vid="PSA 93:4">Mo voes blong yu i strong moa</para>
  <para style="q2" vid="PSA 93:4">i winim noes blong dipsi.</para>
  <para style="q1" vid="PSA 93:4">Paoa blong yu i strong moa,</para>
  <para style="q2" vid="PSA 93:4">i winim paoa blong ol bigsi.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />Hae God,</para>
  <para style="q2" vid="PSA 93:5">ol loa blong yu oli blong oltaem nomo.</para>
  <para style="q1" vid="PSA 93:5">Haos* blong yu i tabu we i tabu,</para>
  <para style="q2" vid="PSA 93:5">mo bambae i stap oltaem nomo,</para>
  <para style="q3" vid="PSA 93:5">gogo i no save finis.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">God i stap jajem olgeta man</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />Hae God.</para>
  <para style="q1" vid="PSA 94:1">Yu yu God we yu stap givim panis</para>
  <para style="q3" vid="PSA 94:1">long ol man nogud.</para>
  <para style="q1" vid="PSA 94:1">!I gud yu soemaot paoa blong yu long olgeta!<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Yu yu stap jajem olgeta man.</para>
  <para style="q1" vid="PSA 94:2">Plis yu girap,</para>
  <para style="q2" vid="PSA 94:2">yu givim panis long ol praod man,</para>
  <para style="q3" vid="PSA 94:2">we i stret long olgeta.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />Hae God.</para>
  <para style="q1" vid="PSA 94:3">?Ol man nogud ya oli laen blong mifala nomo,</para>
  <para style="q2" vid="PSA 94:3">be bambae oli stap glad</para>
  <para style="q3" vid="PSA 94:3">gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 94:3">?Bambae oli stap mekem olsem</para>
  <para style="q2" vid="PSA 94:3">go kasem wetaem?<verse eid="PSA 94:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Olgeta oli stap brekem loa.</para>
  <para style="q1" vid="PSA 94:4">?Bambae oli stap praod olsem</para>
  <para style="q3" vid="PSA 94:4">gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 94:4">?Bambae oli stap tok flas</para>
  <para style="q2" vid="PSA 94:4">from ol rabis fasin blong olgeta</para>
  <para style="q3" vid="PSA 94:4">go kasem wetaem?<verse eid="PSA 94:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />Hae God,</para>
  <para style="q2" vid="PSA 94:5">mifala i man blong yu,</para>
  <para style="q3" vid="PSA 94:5">be olgeta ya oli stap flatemgud mifala.</para>
  <para style="q1" vid="PSA 94:5">Nem blong yu i stap long mifala,</para>
  <para style="q2" vid="PSA 94:5">be oli stap mekem mifala i harem nogud</para>
  <para style="q3" vid="PSA 94:5">aninit long han blong olgeta.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Oli stap kilim ol wido,</para>
  <para style="q2" vid="PSA 94:6">mo ol pikinini we ol papa blong olgeta oli ded,</para>
  <para style="q3" vid="PSA 94:6">mo ol strenja we oli stap long ples blong mifala.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Olgeta oli talem se,</para>
  <para style="q2" vid="PSA 94:7">“Hae God i God blong yumi ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 94:7">be hem i no save luk yumi.</para>
  <para style="q2" vid="PSA 94:7">!Hem i no save luksave ya!”<verse eid="PSA 94:7" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />!Olgeta!</para>
  <para style="q1" vid="PSA 94:8">!Yufala i krangke ya!</para>
  <para style="q1" vid="PSA 94:8">!Yufala i lusum hed finis!</para>
  <para style="q1" vid="PSA 94:8">?Wetaem bambae yufala i save samting?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />?Yufala i ting se God i no save harem samting?</para>
  <para style="q1" vid="PSA 94:9">!Hem nao i mekem sora blong yumi!</para>
  <para style="q1" vid="PSA 94:9">?Yufala i ting se hem i no save lukluk?</para>
  <para style="q2" vid="PSA 94:9">!Hem nao i mekem ae blong yumi!<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />?Yufala i ting</para>
  <para style="q2" vid="PSA 94:10">se hem i no save givim panis long yufala?</para>
  <para style="q1" vid="PSA 94:10">!Hem nao i stap stretem</para>
  <para style="q2" vid="PSA 94:10">ol man blong olgeta kantri!</para>
  <para style="q1" vid="PSA 94:10">?Yufala i ting se hem i no gat save?</para>
  <para style="q1" vid="PSA 94:10">!Hem nao i tija blong olgeta man!<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94.11: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 3:20">1 Kor 3.20</ref>
      </char>
    </note>Hae God i save tingting blong man.</para>
  <para style="q1" vid="PSA 94:11">Hem i savegud we man i no gat hed.<verse eid="PSA 94:11" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />Hae God.</para>
  <para style="q1" vid="PSA 94:12">Man we yu stap panisim hem blong stretem hem,</para>
  <para style="q3" vid="PSA 94:12">mo we yu stap tijim hem long ol loa blong yu,</para>
  <para style="q2" vid="PSA 94:12">hem i save harem gud.<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />Oltaem bambae yu stap blokem</para>
  <para style="q3" vid="PSA 94:13">ol trabol oli no kam long hem,</para>
  <para style="q2" vid="PSA 94:13">yu mekem we hem bambae i stap gud</para>
  <para style="q3" vid="PSA 94:13">go kasem taem we bambae yu digim hol</para>
  <para style="q4" vid="PSA 94:13">blong mekem trap blong kasem ol man nogud.<verse eid="PSA 94:13" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Hae God bambae i no save lego yumi ya</para>
  <para style="q3" vid="PSA 94:14">we yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 94:14">hem bambae i no save gowe long yumi ya</para>
  <para style="q4" vid="PSA 94:14">we nem blong hem i stap finis long yumi.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Ol jaj bambae oli mekem kot bakegen</para>
  <para style="q3" vid="PSA 94:15">we bambae oli jajem ol man long stret fasin,</para>
  <para style="q2" vid="PSA 94:15">mo taem ol stret man oli luk fasin ya,</para>
  <para style="q4" vid="PSA 94:15">bambae oli glad long hem.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Bifo i no gat man i stanap,</para>
  <para style="q2" vid="PSA 94:16">i givhan long mi</para>
  <para style="q3" vid="PSA 94:16">blong mi agensem ol man nogud.</para>
  <para style="q1" vid="PSA 94:16">I no gat wan man nating</para>
  <para style="q2" vid="PSA 94:16">i stanap long saed blong mi,</para>
  <para style="q3" vid="PSA 94:16">i agensem ol rabis man ya.<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />Sipos Hae God i no bin givhan long mi,</para>
  <para style="q2" vid="PSA 94:17">bambae mi go kwiktaem nomo</para>
  <para style="q3" vid="PSA 94:17">long Hom* blong ol Dedman.<verse eid="PSA 94:17" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />Hae God.</para>
  <para style="q1" vid="PSA 94:18">Taem mi talem se,</para>
  <para style="q3" vid="PSA 94:18">“!Mi glis, mi foldaon!”</para>
  <para style="q2" vid="PSA 94:18">be yu yu holem mi mi stap gud,</para>
  <para style="q4" vid="PSA 94:18">from we oltaem yu yu lavem mi tumas.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Taem we mi mi wari,</para>
  <para style="q3" vid="PSA 94:19">mo mi stap tingting tumas,</para>
  <para style="q2" vid="PSA 94:19">oltaem yu yu mekem tingting blong mi</para>
  <para style="q4" vid="PSA 94:19">i kam gud bakegen,</para>
  <para style="q3" vid="PSA 94:19">yu stap mekem mi mi glad.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Yu yu no glad nating</para>
  <para style="q2" vid="PSA 94:20">long ol jaj ya we oli no stret,</para>
  <para style="q3" vid="PSA 94:20">we fasin blong olgeta i krangke.</para>
  <para style="q1" vid="PSA 94:20">Olgeta ya oli stap mekem ol loa</para>
  <para style="q3" vid="PSA 94:20">blong stanemap ol fasin nogud,<verse eid="PSA 94:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="PSA 94:21" />mo oli stap mekem plan long haed</para>
  <para style="q4" vid="PSA 94:21">blong spolem ol gudfala man,</para>
  <para style="q3" vid="PSA 94:21">mo oli stap jajem ol man</para>
  <para style="q3" vid="PSA 94:21">we oli no mekem wan samting nogud,</para>
  <para style="q4" vid="PSA 94:21">se oli mas ded.</para>
  <para style="q1" vid="PSA 94:21">Ol jaj olsem,</para>
  <para style="q2" vid="PSA 94:21">yu yu stap agens long olgeta.<verse eid="PSA 94:21" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Be Hae God i God blong mi,</para>
  <para style="q2" vid="PSA 94:22">mo hem i stap blokem mi</para>
  <para style="q4" vid="PSA 94:22">i stap lukaot gud long mi.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />Hem bambae i panisim olgeta ya</para>
  <para style="q3" vid="PSA 94:23">from ol fasin nogud blong olgeta,</para>
  <para style="q2" vid="PSA 94:23">bambae hem i spolem olgeta</para>
  <para style="q4" vid="PSA 94:23">from ol sin blong olgeta.</para>
  <para style="q1" vid="PSA 94:23">Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 94:23">mo hem bambae i spolemgud olgeta.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">Sing blong presem God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />!Yufala i kam,</para>
  <para style="q2" vid="PSA 95:1">yumi presem Hae God!</para>
  <para style="q1" vid="PSA 95:1">!Yumi glad, yumi singsing long hem!</para>
  <para style="q1" vid="PSA 95:1">!Hem i stap blokemgud yumi,</para>
  <para style="q2" vid="PSA 95:1">i stap sevem yumi!<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Yumi kam long fes blong hem,</para>
  <para style="q3" vid="PSA 95:2">yumi talem tangkiu long hem.</para>
  <para style="q1" vid="PSA 95:2">Yumi presem hem,</para>
  <para style="q2" vid="PSA 95:2">yumi sing long hem</para>
  <para style="q3" vid="PSA 95:2">long ol singsing blong glad.<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Hae God, hem i God we i gat paoa.</para>
  <para style="q1" vid="PSA 95:3">Hem i king, mo i gat paoa moa</para>
  <para style="q2" vid="PSA 95:3">i winim olgeta narafala god.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Graon ya i stap long han blong hem,</para>
  <para style="q2" vid="PSA 95:4">i stat daon long stamba blong hem</para>
  <para style="q4" vid="PSA 95:4">we i daon we i daon olgeta,</para>
  <para style="q3" vid="PSA 95:4">i go antap kasem ol hil</para>
  <para style="q3" vid="PSA 95:4">we oli hae we i hae.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Hem i mekem solwota,</para>
  <para style="q2" vid="PSA 95:5">mo i stap lukaot long hem.</para>
  <para style="q1" vid="PSA 95:5">Ol aelan tu, hem nomo i mekem olgeta,</para>
  <para style="q3" vid="PSA 95:5">mo oli stap long han blong hem.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Hae God, hem i mekem yumi.</para>
  <para style="q1" vid="PSA 95:6">Yufala i kam, yumi bodaon,</para>
  <para style="q2" vid="PSA 95:6">yumi nildaon long fes blong hem,</para>
  <para style="q3" vid="PSA 95:6">yumi mekem wosip long hem.<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95.7: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 3:7-11">Hib 3.7-11</ref>
      </char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">95.7: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 3:15">Hib 3.15</ref>; <ref loc="HEB 4:7">4.7</ref></char>
    </note>Hem i God blong yumi.</para>
  <para style="q1" vid="PSA 95:7">Yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 95:7">mo hem i stap lukaot gud long yumi.</para>
  <para style="q1" vid="PSA 95:7">Yumi ol sipsip blong hem,</para>
  <para style="q2" vid="PSA 95:7">mo yumi stap long han blong hem.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q1" vid="PSA 95:7">Tede, yufala i mas lesin long tok blong hem.</para>
  <para style="q1" vid="PSA 95:7">Hem i talem se,<verse eid="PSA 95:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 95:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95.8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Eks 17.1-7</ref>; <ref loc="NUM 20:2-13">Nam 20.2-13</ref></char>
    </note>“Yufala i no mekem stronghed,</para>
  <para style="q3" vid="PSA 95:8">olsem we ol bubu blong yufala bifo</para>
  <para style="q4" vid="PSA 95:8">oli mekem long draeples ya Meriba,</para>
  <para style="q3" vid="PSA 95:8">we narafala nem blong hem Masaha.<verse eid="PSA 95:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 95:9" />Olgeta ya oli luk finis</para>
  <para style="q4" vid="PSA 95:9">ol samting we mi mi mekem long olgeta,</para>
  <para style="q3" vid="PSA 95:9">be long ples ya,</para>
  <para style="q4" vid="PSA 95:9">oli wantem traem mi,</para>
  <para style="q3" vid="PSA 95:9">oli wantem luk paoa blong mi bakegen.<verse eid="PSA 95:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 95:10" />Nao mi mi kros long olgeta foti yia,</para>
  <para style="q3" vid="PSA 95:10">mo mi talem se,</para>
  <para style="q3" vid="PSA 95:10">‘Ol man ya oli no holem promes</para>
  <para style="q3" vid="PSA 95:10">blong olgeta nating,</para>
  <para style="q4" vid="PSA 95:10">oli no wantem nating <optbreak /> blong obei long ol tok blong mi.’<verse eid="PSA 95:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 95:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95.11 a: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:20-23">Nam 14.20-23</ref>; <ref loc="DEU 1:34-36">Dut 1.34-36</ref>; <ref loc="HEB 4:3">Hib 4.3</ref>,<ref loc="HEB 4:5">5</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 12:9">Dut 12.9</ref>,<ref loc="DEU 12:10">10</ref></char>
    </note>Mi mi kros gud long olgeta,</para>
  <para style="q3" vid="PSA 95:11">nao mi mekem wan strong tok,</para>
  <para style="q3" vid="PSA 95:11">mi talem se, ‘Yufala ya,</para>
  <para style="q4" vid="PSA 95:11">neva bambae yufala i go insaed long graon ya</para>
  <para style="q3" vid="PSA 95:11">we mi mi wantem givim long yufala <optbreak /> blong yufala i go spel long hem.’ ”<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">Hae God i Hae King, mo hem i rulum olgeta man</para>
  <para style="r">(<ref loc="1CH 16:23-33">1 Kronikel 16.23-33</ref>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />!Olgeta man long wol!</para>
  <para style="q1" vid="PSA 96:1">!Yumi sing long Hae God!</para>
  <para style="q1" vid="PSA 96:1">!Yumi wokem wan niufala singsing!</para>
  <para style="q1" vid="PSA 96:1">!Yumi sing blong presem hem!<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />!Yumi sing long Hae God!</para>
  <para style="q1" vid="PSA 96:2">!Yumi leftemap nem blong hem!</para>
  <para style="q1" vid="PSA 96:2">Evri dei bambae yumi talemaot gud nius ya</para>
  <para style="q2" vid="PSA 96:2">we hem i sevem yumi.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Bambae yumi talemaot paoa blong hem</para>
  <para style="q2" vid="PSA 96:3">long ol man blong ol narafala kantri.</para>
  <para style="q1" vid="PSA 96:3">Bambae yumi talemaot ol bigbigfala wok blong hem</para>
  <para style="q2" vid="PSA 96:3">long fes blong olgeta man.<verse eid="PSA 96:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Hae God i hae we i hae,</para>
  <para style="q2" vid="PSA 96:4">mo yumi mas presem hem,</para>
  <para style="q3" vid="PSA 96:4">yumi mas leftemap nem blong hem.</para>
  <para style="q1" vid="PSA 96:4">Hem i hae moa long ol narafala god,</para>
  <para style="q2" vid="PSA 96:4">mo i stret blong yumi ona moa long hem,</para>
  <para style="q3" vid="PSA 96:4">i winim we yumi ona long ol narafala god.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Olgeta god ya</para>
  <para style="q3" vid="PSA 96:5">blong ol man blong ol narafala kantri</para>
  <para style="q2" vid="PSA 96:5">oli giaman god nomo,</para>
  <para style="q4" vid="PSA 96:5">oli no save mekem wan samting,</para>
  <para style="q2" vid="PSA 96:5">be Hae God ya,</para>
  <para style="q3" vid="PSA 96:5">hem i mekem skae</para>
  <para style="q4" vid="PSA 96:5">wetem olgeta samting we i stap long hem.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Bigfala laet i stap saen raonabaot long hem</para>
  <para style="q2" vid="PSA 96:6">i soemaot we hem i King,</para>
  <para style="q3" vid="PSA 96:6">nem blong hem i hae we i hae.</para>
  <para style="q1" vid="PSA 96:6">Olgeta samting long haos* blong hem</para>
  <para style="q2" vid="PSA 96:6">oli soemaot we paoa blong hem i bigfala tumas,</para>
  <para style="q3" vid="PSA 96:6">mo we hem i gud we i gud.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96.7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:1">Sam 29.1</ref>,<ref loc="PSA 29:2">2</ref></char>
    </note>!Olgeta man long wol,</para>
  <para style="q2" vid="PSA 96:7">yumi presem Hae God!</para>
  <para style="q1" vid="PSA 96:7">Yumi leftemap nem blong hem</para>
  <para style="q2" vid="PSA 96:7">from ol gudgudfala samting blong</para>
  <para style="q3" vid="PSA 96:7">hem mo from paoa blong hem.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />!Nem blong hem i hae we i hae!</para>
  <para style="q1" vid="PSA 96:8">!Yumi presem hem!</para>
  <para style="q1" vid="PSA 96:8">Yumi tekem presen blong yumi,</para>
  <para style="q2" vid="PSA 96:8">yumi kam long haos blong hem,</para>
  <para style="q3" vid="PSA 96:8">yumi givim long hem.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />!Hae God ya i tabu we i tabu!</para>
  <para style="q1" vid="PSA 96:9">!Yumi mas bodaon long fes blong hem,</para>
  <para style="q2" vid="PSA 96:9">yumi mas wosipim hem!</para>
  <para style="q1" vid="PSA 96:9">!I gud yumi tinghevi long hem,</para>
  <para style="q2" vid="PSA 96:9">yumi ona gud long hem!<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Yumi mas talemaot long olgeta man</para>
  <para style="q3" vid="PSA 96:10">blong ol narafala kantri se,</para>
  <para style="q2" vid="PSA 96:10">“!Hae God, hem i King!</para>
  <para style="q2" vid="PSA 96:10">Hem i putum wol ya</para>
  <para style="q3" vid="PSA 96:10">i stanap strong long ples blong hem,</para>
  <para style="q4" vid="PSA 96:10">mo i no save muf.</para>
  <para style="q2" vid="PSA 96:10">Hem bambae i jajem olgeta man</para>
  <para style="q3" vid="PSA 96:10">long stret fasin.”<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Skae mo graon.</para>
  <para style="q1" vid="PSA 96:11">!Yutufala i harem gud,</para>
  <para style="q2" vid="PSA 96:11">yutufala i glad!</para>
  <para style="q1" vid="PSA 96:11">Solwota.</para>
  <para style="q1" vid="PSA 96:11">!Yu wetem evri samting we i stap long yu,</para>
  <para style="q3" vid="PSA 96:11">yufala i mekem bigfala noes!<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12-13" style="v" sid="PSA 96:12-13" />Ol garen.</para>
  <para style="q1" vid="PSA 96:12-13">!Yufala wetem evri samting we i stap long yufala,</para>
  <para style="q3" vid="PSA 96:12-13">yufala i glad!</para>
  <para style="q1" vid="PSA 96:12-13">Taem Hae God i kam blong rul</para>
  <para style="q3" vid="PSA 96:12-13">long olgeta man long wol ya,</para>
  <para style="q2" vid="PSA 96:12-13">olgeta tri long bus bambae oli glad,</para>
  <para style="q4" vid="PSA 96:12-13">oli stap singsingaot blong presem hem.</para>
  <para style="q1" vid="PSA 96:12-13">Long taem ya,</para>
  <para style="q2" vid="PSA 96:12-13">bambae hem i rulum olgeta man blong wol</para>
  <para style="q4" vid="PSA 96:12-13">long stret fasin,</para>
  <para style="q3" vid="PSA 96:12-13">mo bambae hem i jajem</para>
  <para style="q4" vid="PSA 96:12-13">olgeta man blong ol narafala kantri</para>
  <para style="q1" vid="PSA 96:12-13">ong trutok blong hem.<verse eid="PSA 96:12-13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">Hae God, hem i Hae King</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />!Hae God, hem i King!<note caller="+" style="f"><char style="fr" closed="false">97.1: </char><char style="ft" closed="false">Plante toktok blong Sam 97 ya i pija tok blong talemaot fasin blong God blong i rul.</char></note></para>
  <para style="q1" vid="PSA 97:1">!Wol,</para>
  <para style="q2" vid="PSA 97:1">i gud yu yu glad long hem!</para>
  <para style="q1" vid="PSA 97:1">!Ol aelan,</para>
  <para style="q2" vid="PSA 97:1">i gud yufala i glad we i glad</para>
  <para style="q3" vid="PSA 97:1">from samting ya!<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />I gat klaod mo tudak i stap raonabaot long hem.</para>
  <para style="q1" vid="PSA 97:2">Hem i stap rul long stret fasin,</para>
  <para style="q2" vid="PSA 97:2">mo i stap jajem ol man</para>
  <para style="q3" vid="PSA 97:2">long fasin we i stret gud olgeta.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Faea i stap go fastaem long hem,</para>
  <para style="q2" vid="PSA 97:3">i stap bonem ol enemi raon long hem.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Laetning blong hem</para>
  <para style="q3" vid="PSA 97:4">i stap mekem olgeta ples i saen,</para>
  <para style="q2" vid="PSA 97:4">mo taem graon i luk samting ya,</para>
  <para style="q4" vid="PSA 97:4">hem i seksek from.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Hae God i Masta* blong olgeta ples long wol,</para>
  <para style="q2" vid="PSA 97:5">mo long fes blong hem,</para>
  <para style="q3" vid="PSA 97:5">ol hil oli stap ronaot olsem gris.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Olgeta samting long skae</para>
  <para style="q3" vid="PSA 97:6">oli stap talemaot stret fasin blong hem,</para>
  <para style="q2" vid="PSA 97:6">mo olgeta man long wol</para>
  <para style="q4" vid="PSA 97:6">oli stap luk bigfala paoa blong hem.<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Olgeta we oli stap mekem wosip long ol narafala god,</para>
  <para style="q2" vid="PSA 97:7">mo oli stap tok flas from olgeta,</para>
  <para style="q3" vid="PSA 97:7">olgeta ya evriwan oli stap sem bigwan.</para>
  <para style="q1" vid="PSA 97:7">Ol narafala god ya oli stap bodaon</para>
  <para style="q2" vid="PSA 97:7">long fes blong Hae God.<note caller="+" style="f"><char style="fr" closed="false">97.7: </char><char style="ft" closed="false">Narafala rod blong tanem tok long las haf blong vas ya i olsem. <char style="bd">!Ol</char> </char><char style="fqa" closed="false">narafala <char style="bd">god! !Yufala i kam</char> </char><char style="fqa" closed="false">bodaon long fes blong Hae God!</char></note><verse eid="PSA 97:7" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Hae God.</para>
  <para style="q1" vid="PSA 97:8">Ol man Saeon* oli glad we i glad,</para>
  <para style="q2" vid="PSA 97:8">mo ol taon long Juda* oli harem gud tumas,</para>
  <para style="q3" vid="PSA 97:8">from fasin ya blong yu blong jajem man.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Hae God, yu yu hae we yu hae,</para>
  <para style="q2" vid="PSA 97:9">yu yu King blong olgeta ples long wol.</para>
  <para style="q1" vid="PSA 97:9">Yu yu hae moa,</para>
  <para style="q2" vid="PSA 97:9">yu winim ol narafala god.<verse eid="PSA 97:9" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Hae God i lavem ol man blong hem.</para>
  <para style="q1" vid="PSA 97:10">Olgeta oli stap agens long ol rabis fasin,</para>
  <para style="q2" vid="PSA 97:10">mo hem i stap lukaot gud long laef blong olgeta,</para>
  <para style="q3" vid="PSA 97:10">mo taem we olgeta oli stap long</para>
  <para style="q3" vid="PSA 97:10">paoa blong ol man nogud,</para>
  <para style="q4" vid="PSA 97:10">hem i stap tekemaot olgeta.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Laet blong hem i stap saen long ol stret man,</para>
  <para style="q2" vid="PSA 97:11">mo hem i stap mekem olgeta</para>
  <para style="q3" vid="PSA 97:11">oli glad we i glad.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Yufala we fasin blong yufala i stret,</para>
  <para style="q2" vid="PSA 97:12">yufala i joen long Hae God,</para>
  <para style="q3" vid="PSA 97:12">yufala i mas glad.</para>
  <para style="q1" vid="PSA 97:12">Yufala i mas tingbaot</para>
  <para style="q3" vid="PSA 97:12">we fasin blong hem i stret gud, i tabu,</para>
  <para style="q2" vid="PSA 97:12">mo yufala i mas talem tangkiu long hem from.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">Hae God, hem i King blong wol</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Yumi wokem wan niufala sing,</para>
  <para style="q2" vid="PSA 98:1">yumi singsing long hem blong presem Hae God,</para>
  <para style="q3" vid="PSA 98:1">from we hem i stap mekem ol bigbigfala wok.</para>
  <para style="q1" vid="PSA 98:1">Paoa blong hem i strong mo i tabu,</para>
  <para style="q2" vid="PSA 98:1">mo long paoa ya blong hem,</para>
  <para style="q3" vid="PSA 98:1">hem i win long faet, i sevem yumi.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />Hae God i talemaot finis we hem i win.</para>
  <para style="q1" vid="PSA 98:2">Hem i soemaot long ol man blong ol narafala kantri,</para>
  <para style="q3" vid="PSA 98:2">we hem i gat paoa blong sevem yumi.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />Hem i stap holem ol promes blong hem</para>
  <para style="q2" vid="PSA 98:3">we i mekem long yumi ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 98:3">mo oltaem hem i stap lavem yumi.</para>
  <para style="q1" vid="PSA 98:3">Nao olgeta man long evri ples oli</para>
  <para style="q2" vid="PSA 98:3">luk we God blong yumi hem i win.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4-6" style="v" sid="PSA 98:4-6" />!Hae God i King blong yumi!</para>
  <para style="q1" vid="PSA 98:4-6">!Olgeta man long wol, yumi glad!</para>
  <para style="q1" vid="PSA 98:4-6">!Yumi sing long hem!</para>
  <para style="q1" vid="PSA 98:4-6">!Yumi presem hem long ol singsing!</para>
  <para style="q1" vid="PSA 98:4-6">!Yumi glad, we yumi singsingaot from!</para>
  <para style="q1" vid="PSA 98:4-6">!Yumi plei long gita!</para>
  <para style="q1" vid="PSA 98:4-6">!Yumi sing, yumi presem hem!</para>
  <para style="q1" vid="PSA 98:4-6">!Yumi blu long trampet mo long pupu!</para>
  <para style="q1" vid="PSA 98:4-6">!Yumi glad, yumi singsing long hem!<verse eid="PSA 98:4-6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Solwota.</para>
  <para style="q1" vid="PSA 98:7">!Yu wetem evri samting we i stap long yu,</para>
  <para style="q2" vid="PSA 98:7">yufala i mekem bigfala noes!</para>
  <para style="q1" vid="PSA 98:7">Graon.</para>
  <para style="q1" vid="PSA 98:7">!Yu wetem olgeta samting we i stap long yu,</para>
  <para style="q3" vid="PSA 98:7">yufala i singsing!<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8-9" style="v" sid="PSA 98:8-9" />!Ol reva, yufala i klaphan!</para>
  <para style="q1" vid="PSA 98:8-9">!Ol hil, yufala i glad!</para>
  <para style="q1" vid="PSA 98:8-9">!Hae God i kam blong rulum wol!</para>
  <para style="q1" vid="PSA 98:8-9">Yufala i kam long fes blong hem,</para>
  <para style="q2" vid="PSA 98:8-9">yufala i joen blong singsing.</para>
  <para style="q1" vid="PSA 98:8-9">Bambae hem i jajem olgeta man long wol</para>
  <para style="q3" vid="PSA 98:8-9">long stret fasin nomo.<verse eid="PSA 98:8-9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">Hae God, hem i Hae King</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99.1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:22">Eks 25.22</ref>
      </char>
    </note>!Hae God, hem i king!</para>
  <para style="q1" vid="PSA 99:1">Hem i stap sidaon long ples blong hem</para>
  <para style="q3" vid="PSA 99:1">antap long tufala jerubim* ya,</para>
  <para style="q2" vid="PSA 99:1">i stap rul,</para>
  <para style="q3" vid="PSA 99:1">mo olgeta man oli fraet long hem,</para>
  <para style="q3" vid="PSA 99:1">oli stap seksek,</para>
  <para style="q4" vid="PSA 99:1">mo graon tu i seksek.<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />Hae God i stap long Saeon.*</para>
  <para style="q1" vid="PSA 99:2">Hem i gat paoa,</para>
  <para style="q2" vid="PSA 99:2">mo i hae moa long ol man blong ol narafala kantri.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Hem i King,</para>
  <para style="q2" vid="PSA 99:3">mo nem blong hem i hae we i hae.</para>
  <para style="q1" vid="PSA 99:3">Olgeta man bambae oli presem hem,</para>
  <para style="q2" vid="PSA 99:3">from we hem i tabu we i tabu.<verse eid="PSA 99:3" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />King blong mifala.</para>
  <para style="q1" vid="PSA 99:4">Yu yu gat olgeta paoa.</para>
  <para style="q1" vid="PSA 99:4">Oltaem yu yu laekem ol fasin</para>
  <para style="q2" vid="PSA 99:4">we i stret.</para>
  <para style="q1" vid="PSA 99:4">Stret fasin ya blong jajem man,</para>
  <para style="q2" vid="PSA 99:4">yu nomo yu tekem i kam,</para>
  <para style="q3" vid="PSA 99:4">yu stanemap long kantri blong mifala.<verse eid="PSA 99:4" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />!Hae God i God blong yumi!</para>
  <para style="q1" vid="PSA 99:5">!Yumi presem hem!</para>
  <para style="q1" vid="PSA 99:5">Hem i stap sidaon long ples blong hem,</para>
  <para style="q3" vid="PSA 99:5">i stap rul.</para>
  <para style="q1" vid="PSA 99:5">!Hem i tabu we i tabu!</para>
  <para style="q1" vid="PSA 99:5">Yumi kam bodaon long fes blong hem,</para>
  <para style="q3" vid="PSA 99:5">yumi wosipim hem.<verse eid="PSA 99:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Bifo, Moses mo Eron,</para>
  <para style="q2" vid="PSA 99:6">tufala i pris blong Hae God.</para>
  <para style="q1" vid="PSA 99:6">Samuel tu i wan long olgeta</para>
  <para style="q2" vid="PSA 99:6">we oli stap prea long hem.</para>
  <para style="q1" vid="PSA 99:6">Ol man ya blong Hae God</para>
  <para style="q2" vid="PSA 99:6">oli stap krae i go long hem,</para>
  <para style="q3" vid="PSA 99:6">mo hem i stap ansa long olgeta.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99.7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 33:9">Eks 33.9</ref>
      </char>
    </note>Hem i kamtru long olgeta</para>
  <para style="q2" vid="PSA 99:7">long bigfala klaod ya we i stanap stret nomo,</para>
  <para style="q3" vid="PSA 99:7">nao i toktok long olgeta.</para>
  <para style="q1" vid="PSA 99:7">Mo olgeta oli obei long ol loa blong hem,</para>
  <para style="q2" vid="PSA 99:7">mo oli holem ol tok ya</para>
  <para style="q3" vid="PSA 99:7">we hem i talem long olgeta.<verse eid="PSA 99:7" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />Hae God.</para>
  <para style="q1" vid="PSA 99:8">Yu yu God blong mifala.</para>
  <para style="q1" vid="PSA 99:8">Long taem ya,</para>
  <para style="q2" vid="PSA 99:8">yu yu ansa long ol man ya blong yu.</para>
  <para style="q1" vid="PSA 99:8">Nating we yu stap panisim olgeta</para>
  <para style="q3" vid="PSA 99:8">from ol sin blong olgeta,</para>
  <para style="q2" vid="PSA 99:8">be yu stap soemaot bakegen long olgeta</para>
  <para style="q4" vid="PSA 99:8">we yu yu save fogivim olgeta,</para>
  <para style="q3" vid="PSA 99:8">yu tekemaot ol sin blong olgeta.<verse eid="PSA 99:8" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 99:9">mo hem i tabu we i tabu.</para>
  <para style="q1" vid="PSA 99:9">Yufala i kam,</para>
  <para style="q2" vid="PSA 99:9">yumi presem nem blong hem,</para>
  <para style="q3" vid="PSA 99:9">yumi mekem wosip long hem</para>
  <para style="q4" vid="PSA 99:9">long tabu hil* ya blong hem.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />!Olgeta man long wol,</para>
  <para style="q2" vid="PSA 100:1">yumi sing long Hae God!<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />!Yumi glad,</para>
  <para style="q2" vid="PSA 100:2">yumi mekem wosip long hem!</para>
  <para style="q1" vid="PSA 100:2">!Yumi kam long fes blong hem,</para>
  <para style="q2" vid="PSA 100:2">yumi singsing!<verse eid="PSA 100:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Yumi mas tingbaot</para>
  <para style="q2" vid="PSA 100:3">we Hae God, hem i God.</para>
  <para style="q1" vid="PSA 100:3">Hem nomo i mekem yumi,</para>
  <para style="q2" vid="PSA 100:3">mo yumi man blong hem.</para>
  <para style="q1" vid="PSA 100:3">Yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 100:3">yumi olsem ol sipsip blong hem.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />!Yufala i kam!</para>
  <para style="q1" vid="PSA 100:4">Yumi go insaed long yad blong haos* blong hem,</para>
  <para style="q2" vid="PSA 100:4">mo yumi wokbaot i go</para>
  <para style="q3" vid="PSA 100:4">we yumi stap talem tangkiu long hem.</para>
  <para style="q1" vid="PSA 100:4">Yumi go insaed long ples blong wosip,</para>
  <para style="q2" vid="PSA 100:4">mo yumi wokbaot i go</para>
  <para style="q3" vid="PSA 100:4">we yumi stap presem hem.</para>
  <para style="q1" vid="PSA 100:4">Yumi talem tangkiu long hem,</para>
  <para style="q2" vid="PSA 100:4">yumi leftemap nem blong hem.<verse eid="PSA 100:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">100.5: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Kron 16.34</ref>; <ref loc="2CH 5:13">2 Kron 5.13</ref>; <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Esra 3.11</ref>; <ref loc="PSA 106:1">Sam 106.1</ref>; <ref loc="PSA 107:1">107.1</ref>; <ref loc="PSA 118:1">118.1</ref>; <ref loc="PSA 136:1">136.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char>
    </note>Hae God, hem i gud tumas.</para>
  <para style="q1" vid="PSA 100:5">Fasin blong hem,</para>
  <para style="q2" vid="PSA 100:5">we hem i stap lavem man tumas,</para>
  <para style="q3" vid="PSA 100:5">bambae i stap oltaem nomo.</para>
  <para style="q1" vid="PSA 100:5">Hem bambae i holem ol promes blong hem oltaem,</para>
  <para style="q2" vid="PSA 100:5">gogo i no save finis.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">Promes blong king</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />Hae God.</para>
  <para style="q1" vid="PSA 101:1">Sing ya blong mi i blong tokbaot fasin ya</para>
  <para style="q3" vid="PSA 101:1">we mi wantem holem ol promes we mi mekem wetem yu,</para>
  <para style="q4" vid="PSA 101:1">mo we mi wantem jajem ol man long stret fasin.</para>
  <para style="q1" vid="PSA 101:1">Bambae mi sing long hem</para>
  <para style="q2" vid="PSA 101:1">blong presem yu.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Mi wantem</para>
  <para style="q2" vid="PSA 101:2">se bambae mi stap folem rod</para>
  <para style="q3" vid="PSA 101:2">we i stret olgeta.</para>
  <para style="q1" vid="PSA 101:2">Mi mi wantem tumas,</para>
  <para style="q2" vid="PSA 101:2">se bambae yu kam stap wetem mi.</para>
  <para style="b" vid="PSA 101:2" />
  <para style="q1" vid="PSA 101:2">Long haos blong mi,</para>
  <para style="q2" vid="PSA 101:2">bambae mi stap folem ol fasin</para>
  <para style="q3" vid="PSA 101:2">we i klin gud long fes blong yu,<verse eid="PSA 101:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 101:3" />neva bambae mi letem rabis fasin</para>
  <para style="q3" vid="PSA 101:3">i kam spolem mi.</para>
  <para style="q1" vid="PSA 101:3">Mi mi no laekem nating</para>
  <para style="q2" vid="PSA 101:3">wok blong olgeta ya we oli gowe long yu,</para>
  <para style="q3" vid="PSA 101:3">mo bambae mi no save go joen wetem olgeta.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Bambae mi no save mekem ol giaman fasin</para>
  <para style="q2" vid="PSA 101:4">mo bambae mi no save go joen wetem ol man nogud.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Man we i stap tok smosmol</para>
  <para style="q2" vid="PSA 101:5">blong spolem nem blong narafala man,</para>
  <para style="q3" vid="PSA 101:5">bambae mi sakemaot hem.</para>
  <para style="q1" vid="PSA 101:5">Mo man we i stap praod,</para>
  <para style="q2" vid="PSA 101:5">no we i stap tok flas,</para>
  <para style="q3" vid="PSA 101:5">bambae mi no save letem hem i stap.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Be olgeta we tingting blong olgeta</para>
  <para style="q3" vid="PSA 101:6">i stap strong long yu,</para>
  <para style="q2" vid="PSA 101:6">bambae mi tekem olgeta</para>
  <para style="q4" vid="PSA 101:6">oli kam stap wetem mi.</para>
  <para style="q1" vid="PSA 101:6">Olgeta we fasin blong olgeta i stret gud,</para>
  <para style="q2" vid="PSA 101:6">bambae mi letem olgeta oli wok blong mi.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Man we i stap wokem trik</para>
  <para style="q3" vid="PSA 101:7">bambae i no save stap long haos blong mi,</para>
  <para style="q2" vid="PSA 101:7">mo man we i stap giaman</para>
  <para style="q4" vid="PSA 101:7">bambae i no save stap wetem mi.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Hae God.</para>
  <para style="q1" vid="PSA 101:8">Evri dei bambae mi stap spolem ol man nogud</para>
  <para style="q2" vid="PSA 101:8">long kantri blong mifala.</para>
  <para style="q1" vid="PSA 101:8">Bambae mi stap sakemaot olgeta man</para>
  <para style="q3" vid="PSA 101:8">we oli stap mekem i no stret,</para>
  <para style="q2" vid="PSA 101:8">oli gowe long taon blong yu.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">Prea blong wan yang man we i stap long trabol</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />Hae God.</para>
  <para style="q1" vid="PSA 102:1">Plis yu lesin long prea blong mi.</para>
  <para style="q1" vid="PSA 102:1">Mi mi stap krae blong yu givhan long mi,</para>
  <para style="q2" vid="PSA 102:1">plis yu harem mi.<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Mi mi stap long trabol.</para>
  <para style="q1" vid="PSA 102:2">Plis yu no tanem</para>
  <para style="q2" vid="PSA 102:2">fes blong yu i gowe long mi.</para>
  <para style="q1" vid="PSA 102:2">Mi mi stap krae long yu.</para>
  <para style="q1" vid="PSA 102:2">Plis yu lesin long mi,</para>
  <para style="q2" vid="PSA 102:2">yu ansa long mi kwiktaem.<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Bodi blong mi i stap hot olsem faea,</para>
  <para style="q2" vid="PSA 102:3">mo laef blong mi i olsem smok</para>
  <para style="q3" vid="PSA 102:3">we win i karem i go.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Mi mi kam olsem gras</para>
  <para style="q2" vid="PSA 102:4">we san i bonem i drae.</para>
  <para style="q1" vid="PSA 102:4">Mo mi no moa save harem nating</para>
  <para style="q2" vid="PSA 102:4">se mi hanggri.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Mi stap harem nogud mi krae gogo</para>
  <para style="q3" vid="PSA 102:5">mi kam bunbun olgeta,</para>
  <para style="q2" vid="PSA 102:5">we skin blong mi i go fas gud</para>
  <para style="q4" vid="PSA 102:5">long ol bun blong mi.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Mi mi stap mi wan,</para>
  <para style="q2" vid="PSA 102:6">olsem wael pijin we i stap long draeples,</para>
  <para style="q3" vid="PSA 102:6">olsem hoknaet we i stap hem wan long olfala haos,</para>
  <para style="q4" vid="PSA 102:6">we i no moa gat man i stap long hem.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Mi stap ledaon, be mi no save slip.</para>
  <para style="q1" vid="PSA 102:7">Mi olsem wan pijin we i no gat fren blong hem,</para>
  <para style="q2" vid="PSA 102:7">we hem i stap sidaon antap long haos.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Oltaem ol enemi blong mi</para>
  <para style="q2" vid="PSA 102:8">oli stap tok nogud long mi,</para>
  <para style="q3" vid="PSA 102:8">i stat long moning go kasem sapa.</para>
  <para style="q1" vid="PSA 102:8">Olgeta we oli stap laf long mi</para>
  <para style="q2" vid="PSA 102:8">oli stap yusum nem blong mi</para>
  <para style="q3" vid="PSA 102:8">blong singaot* trabol i kam long man.<verse eid="PSA 102:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9-10" style="v" sid="PSA 102:9-10" />Yu yu harem nogud long mi,</para>
  <para style="q3" vid="PSA 102:9-10">mo yu kros tumas long mi,</para>
  <para style="q2" vid="PSA 102:9-10">nao asis i kam kakae blong mi</para>
  <para style="q3" vid="PSA 102:9-10">mo wota blong ae blong mi i miksap</para>
  <para style="q4" vid="PSA 102:9-10">wetem wota blong mi blong dring.</para>
  <para style="q1" vid="PSA 102:9-10">Yu yu holem mi,</para>
  <para style="q2" vid="PSA 102:9-10">yu sakem mi mi go longwe.<verse eid="PSA 102:9-10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Laef blong mi i stap go kwiktaem</para>
  <para style="q2" vid="PSA 102:11">olsem san we klosap i go lus.</para>
  <para style="q1" vid="PSA 102:11">Mi mi olsem gras we i drae finis.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Be yu, Hae God,</para>
  <para style="q2" vid="PSA 102:12">bambae yu yu King oltaem</para>
  <para style="q3" vid="PSA 102:12">gogo i no save finis.</para>
  <para style="q1" vid="PSA 102:12">Olgeta man we bambae oli stap kam biaen</para>
  <para style="q2" vid="PSA 102:12">bambae oli stap tingbaot yu.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Naoia, i gud yu yu sore long Saeon,*</para>
  <para style="q2" vid="PSA 102:13">yu girap, yu givhan long hem,</para>
  <para style="q3" vid="PSA 102:13">from we taem i kam finis blong yu sore long hem,</para>
  <para style="q4" vid="PSA 102:13">naoia i prapa taem blong hem.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />I nomata we ol enemi blong yu</para>
  <para style="q3" vid="PSA 102:14">oli spolem ples ya finis,</para>
  <para style="q2" vid="PSA 102:14">be mifala ol man blong yu,</para>
  <para style="q4" vid="PSA 102:14">mifala i stap laekem hem yet.</para>
  <para style="q1" vid="PSA 102:14">Nating we ples ya i kam nogud finis,</para>
  <para style="q3" vid="PSA 102:14">be mifala i stap sore long hem yet.<verse eid="PSA 102:14" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Olgeta man blong ol narafala kantri</para>
  <para style="q3" vid="PSA 102:15">bambae oli fraet gud long Hae God,</para>
  <para style="q2" vid="PSA 102:15">mo olgeta king long wol</para>
  <para style="q4" vid="PSA 102:15">bambae oli fraet long bigfala paoa blong hem.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Taem hem i wokem Saeon i gud bakegen,</para>
  <para style="q2" vid="PSA 102:16">bambae hem i kamtru</para>
  <para style="q3" vid="PSA 102:16">long bigfala laet ya we i soemaot paoa blong hem.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Yumi ol man blong hem</para>
  <para style="q3" vid="PSA 102:17">mo hem i bin lego yumi</para>
  <para style="q2" vid="PSA 102:17">be bambae hem i harem prea blong yumi,</para>
  <para style="q4" vid="PSA 102:17">bambae hem i lesin long yumi.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18-20" style="v" sid="PSA 102:18-20" />Hae God i stap long tabu ples blong hem long heven,</para>
  <para style="q2" vid="PSA 102:18-20">i lukluk i kamdaon long wol.</para>
  <para style="q1" vid="PSA 102:18-20">Hem i harem krae blong ol man</para>
  <para style="q2" vid="PSA 102:18-20">we oli stap long kalabus.</para>
  <para style="q1" vid="PSA 102:18-20">Olgeta we kot i jajem olgeta finis</para>
  <para style="q3" vid="PSA 102:18-20">se oli mas ded,</para>
  <para style="q2" vid="PSA 102:18-20">hem i mekem olgeta oli fri.<note caller="+" style="f"><char style="fr" closed="false">102.18-20: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya long medel blong trifala vas ya i olsem. </char><char style="fqa" closed="false">Hem i harem krae blong <char style="bd">yumi,</char> </char><char style="fqa" closed="false">we <char style="bd">yumi</char> s</char><char style="fqa" closed="false">tap long kalabus. <char style="bd">Yumi ya</char> </char><char style="fqa" closed="false">we kot i jajem <char style="bd">yumi</char> </char><char style="fqa" closed="false">finis se <char style="bd">yumi</char> </char><char style="fqa" closed="false">mas ded, hem i mekem <char style="bd">yumi</char> </char><char style="fqa" closed="false">fri.</char></note></para>
  <para style="q1" vid="PSA 102:18-20">I gud yumi raetemdaon ol samting ya</para>
  <para style="q3" vid="PSA 102:18-20">we Hae God i mekem,</para>
  <para style="q2" vid="PSA 102:18-20">blong ol man we oli no bon yet</para>
  <para style="q4" vid="PSA 102:18-20">bambae oli save ridim,</para>
  <para style="q3" vid="PSA 102:18-20">nao bambae oli stap presem hem from.<verse eid="PSA 102:18-20" /></para>
  <para style="q1">
    <verse number="21-22" style="v" sid="PSA 102:21-22" />Nao sipos ol man blong olgeta kantri mo olgeta kingdom</para>
  <para style="q2" vid="PSA 102:21-22">oli kam wanples blong mekem wosip long Hae God</para>
  <para style="q4" vid="PSA 102:21-22">long Saeon,</para>
  <para style="q3" vid="PSA 102:21-22">bambae oli save talemaot nem blong hem</para>
  <para style="q4" vid="PSA 102:21-22">mo bambae oli save presem hem.<verse eid="PSA 102:21-22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Mi mi yangfala yet,</para>
  <para style="q2" vid="PSA 102:23">be Hae God i mekem mi mi no moa strong,</para>
  <para style="q3" vid="PSA 102:23">hem i katem laef blong mi i kam sotfala.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Mi mi talem se,</para>
  <para style="q2" vid="PSA 102:24">“Hae God, yu yu God blong mi.</para>
  <para style="q2" vid="PSA 102:24">Yu yu no save ded,</para>
  <para style="q3" vid="PSA 102:24">bambae yu stap oltaem.</para>
  <para style="q2" vid="PSA 102:24">Plis yu no tekemaot mi naoia</para>
  <para style="q3" vid="PSA 102:24">we mi mi no olfala yet.<verse eid="PSA 102:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="PSA 102:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102.25: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:10-12">Hib 1.10-12</ref>
      </char>
    </note>Bifo olgeta,</para>
  <para style="q3" vid="PSA 102:25">yu yu mekem wol ya,</para>
  <para style="q4" vid="PSA 102:25">mo long han blong yu nomo</para>
  <para style="q3" vid="PSA 102:25">yu mekem evri samting we i stap long skae.<verse eid="PSA 102:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="PSA 102:26" />Olgeta samting ya bambae oli lus,</para>
  <para style="q3" vid="PSA 102:26">bambae oli brobrok olsem klos,</para>
  <para style="q4" vid="PSA 102:26">be yu bambae yu stap oltaem nomo.</para>
  <para style="q2" vid="PSA 102:26">Bambae yu yu sakem olgeta samting ya</para>
  <para style="q3" vid="PSA 102:26">olsem klos we i kam olfala finis</para>
  <para style="q4" vid="PSA 102:26">nao bambae oli lus olgeta.<verse eid="PSA 102:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="PSA 102:27" />Be yu,</para>
  <para style="q3" vid="PSA 102:27">oltaem yu yu stap sem mak nomo,</para>
  <para style="q4" vid="PSA 102:27">mo neva bambae laef blong yu i finis.<verse eid="PSA 102:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="PSA 102:28" />Mifala i man blong wok blong yu.</para>
  <para style="q2" vid="PSA 102:28">Ol pikinini blong mifala</para>
  <para style="q4" vid="PSA 102:28">bambae oli stap gud, oli sef,</para>
  <para style="q3" vid="PSA 102:28">mo olgeta we bambae oli stap kamaot biaen long olgeta,</para>
  <para style="q4" vid="PSA 102:28">bambae yu yu lukaot gud long olgeta.</para>
  <para style="q2" vid="PSA 102:28">Bambae oli stap gud oltaem long han blong yu.”<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">Hae God i lavem yumi tumas</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />!Oltaem mi mi mas presem Hae God!</para>
  <para style="q1" vid="PSA 103:1">!Long olgeta laef blong mi,</para>
  <para style="q2" vid="PSA 103:1">mi mas presem tabu nem blong hem!<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Mi mi mas presem hem,</para>
  <para style="q2" vid="PSA 103:2">mo mi no save fogetem</para>
  <para style="q3" vid="PSA 103:2">we hem i kaen tumas long mi.<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />Hem i stap fogivim mi,</para>
  <para style="q3" vid="PSA 103:3">i stap tekemaot ol sin blong mi.</para>
  <para style="q1" vid="PSA 103:3">Hem i stap tekemaot ol sik blong mi,</para>
  <para style="q2" vid="PSA 103:3">i mekem mi mi gud bakegen,<verse eid="PSA 103:3" /></para>
  <para style="q3">
    <verse number="4" style="v" sid="PSA 103:4" />mo i stap lukaot gud long mi</para>
  <para style="q3" vid="PSA 103:4">blong mi mi no ded.</para>
  <para style="q1" vid="PSA 103:4">Hem i lavem mi tumas,</para>
  <para style="q3" vid="PSA 103:4">mo i sore tumas long mi,</para>
  <para style="q2" vid="PSA 103:4">nao oltaem hem i stap mekem</para>
  <para style="q4" vid="PSA 103:4">i gud tumas long mi.<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />Oltaem hem i stap mekem mi mi harem gud</para>
  <para style="q2" vid="PSA 103:5">long ol gudgudfala samting ya</para>
  <para style="q3" vid="PSA 103:5">we hem i stap givim long mi,</para>
  <para style="q2" vid="PSA 103:5">mo i mekem mi mi stap yang,</para>
  <para style="q3" vid="PSA 103:5">mi stap strong oltaem,</para>
  <para style="q4" vid="PSA 103:5">olsem bigfala pijin ya igel.*<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />Taem Hae God i mekem kot,</para>
  <para style="q2" vid="PSA 103:6">oltaem hem i stap givhan long man</para>
  <para style="q3" vid="PSA 103:6">we narafala man i stap mekem</para>
  <para style="q4" vid="PSA 103:6">i no stret long hem.</para>
  <para style="q1" vid="PSA 103:6">Oltaem hem i stap mekem rod</para>
  <para style="q2" vid="PSA 103:6">blong man olsem i kasem ol samting</para>
  <para style="q3" vid="PSA 103:6">we hem i gat raet blong kasem.<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />Bifo, hem i stap soemaot ol plan blong hem long Moses,</para>
  <para style="q2" vid="PSA 103:7">mo i letem ol laen* blong Isrel*</para>
  <para style="q3" vid="PSA 103:7">oli luk ol bigbigfala wok blong hem.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103.8: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:11">Jem 5.11</ref>
      </char>
    </note>Hae God, hem i gat sore,</para>
  <para style="q2" vid="PSA 103:8">mo oltaem hem i glad tumas</para>
  <para style="q3" vid="PSA 103:8">blong mekem i gud long man.</para>
  <para style="q1" vid="PSA 103:8">Hem i no save kros kwik,</para>
  <para style="q2" vid="PSA 103:8">fasin blong hem we oltaem i stap lavem man tumas,</para>
  <para style="q3" vid="PSA 103:8">hem i gud we i gud, i bitim mak.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />Hem i no save gohed oltaem</para>
  <para style="q3" vid="PSA 103:9">blong tok strong long man,</para>
  <para style="q2" vid="PSA 103:9">mo kros blong hem</para>
  <para style="q4" vid="PSA 103:9">i no save stap olwe.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />Hem i no save panisim yumi</para>
  <para style="q3" vid="PSA 103:10">stret long mak blong ol sin blong yumi,</para>
  <para style="q2" vid="PSA 103:10">mo hem i no save givimbak</para>
  <para style="q3" vid="PSA 103:10">ol fasin nogud ya long yumi</para>
  <para style="q4" vid="PSA 103:10">we yumi stap mekem long hem.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Fasin ya blong hem</para>
  <para style="q3" vid="PSA 103:11">we oltaem hem i stap lavem ol man</para>
  <para style="q3" vid="PSA 103:11">we oli stap ona long hem,</para>
  <para style="q2" vid="PSA 103:11">hem i gud tumas.</para>
  <para style="q1" vid="PSA 103:11">Lav ya blong hem i bigfala tumas,</para>
  <para style="q2" vid="PSA 103:11">i hae moa i bitim skae antap.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Ol sin ya blong yumi,</para>
  <para style="q2" vid="PSA 103:12">hem i stap tekemaot olgeta</para>
  <para style="q4" vid="PSA 103:12">i go longwe we longwe long yumi,</para>
  <para style="q3" vid="PSA 103:12">olsem we saed long is</para>
  <para style="q3" vid="PSA 103:12">i stap longwe long saed long wes.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Fasin blong Hae God,</para>
  <para style="q2" vid="PSA 103:13">oltaem hem i stap mekem i gud tumas</para>
  <para style="q4" vid="PSA 103:13">long olgeta we oli stap ona long hem,</para>
  <para style="q3" vid="PSA 103:13">olsem we ol papa oli stap mekem</para>
  <para style="q3" vid="PSA 103:13">long ol pikinini blong olgeta.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />Hem i savegud</para>
  <para style="q2" vid="PSA 103:14">we hem i mekem yumi long graon.</para>
  <para style="q1" vid="PSA 103:14">Oltaem hem i stap tingbaot</para>
  <para style="q2" vid="PSA 103:14">we yumi kamaot long asis nomo.<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Yumi man,</para>
  <para style="q2" vid="PSA 103:15">laef blong yumi i olsem gras nomo.</para>
  <para style="q1" vid="PSA 103:15">Yumi olsem wael flaoa,</para>
  <para style="q3" vid="PSA 103:15">we i gru, i kam strong,<verse eid="PSA 103:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 103:16" />be win i blu long hem,</para>
  <para style="q4" vid="PSA 103:16">nao i lus, man i no moa save luk bakegen.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17-18" style="v" sid="PSA 103:17-18" />Be ol man we oli stap ona long Hae God,</para>
  <para style="q2" vid="PSA 103:17-18">oltaem bambae hem i stap lavem olgeta,</para>
  <para style="q3" vid="PSA 103:17-18">gogo i no save finis.</para>
  <para style="q1" vid="PSA 103:17-18">Mo sipos olgeta we oli stap kamaot biaen long olgeta</para>
  <para style="q2" vid="PSA 103:17-18">oli stap holem promes* ya</para>
  <para style="q4" vid="PSA 103:17-18">we hem i mekem wetem ol olfala blong olgeta,</para>
  <para style="q3" vid="PSA 103:17-18">mo oli stap obei long ol loa blong hem,</para>
  <para style="q2" vid="PSA 103:17-18">gudfala fasin blong hem</para>
  <para style="q3" vid="PSA 103:17-18">bambae i stap oltaem long olgeta,</para>
  <para style="q4" vid="PSA 103:17-18">gogo i no save finis.<verse eid="PSA 103:17-18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />Hae God, hem i King.</para>
  <para style="q1" vid="PSA 103:19">Hem i stap long ples blong hem long heven,</para>
  <para style="q2" vid="PSA 103:19">mo i stap rul long olgeta samting.<verse eid="PSA 103:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Yufala ol enjel, yufala i strong,</para>
  <para style="q2" vid="PSA 103:20">mo yufala i gat paoa.</para>
  <para style="q1" vid="PSA 103:20">Oltaem yufala i stap obei</para>
  <para style="q3" vid="PSA 103:20">long ol tok blong Hae God,</para>
  <para style="q2" vid="PSA 103:20">mo yufala i stap lesin</para>
  <para style="q4" vid="PSA 103:20">long ol samting we hem i talem.</para>
  <para style="q1" vid="PSA 103:20">!Yufala i mas presem hem!<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Yufala olgeta long heven,</para>
  <para style="q2" vid="PSA 103:21">yufala i man blong wok blong Hae God.</para>
  <para style="q1" vid="PSA 103:21">Yufala i gat paoa,</para>
  <para style="q2" vid="PSA 103:21">mo yufala i stap mekem ol samting we hem i wantem.</para>
  <para style="q1" vid="PSA 103:21">!Yufala i mas presem hem!<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Yufala olgeta samting</para>
  <para style="q3" vid="PSA 103:22">we Hae God i mekem yufala,</para>
  <para style="q2" vid="PSA 103:22">yufala i stap long evri ples</para>
  <para style="q4" vid="PSA 103:22">we hem i stap rul long hem.</para>
  <para style="q1" vid="PSA 103:22">!Yufala i mas presem hem!</para>
  <para style="q1" vid="PSA 103:22">!Mi mi mas presem Hae God!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">Sing blong presem Hae God from we hem i mekem evri samting</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />!Hae God.</para>
  <para style="q1" vid="PSA 104:1">Oltaem mi mi mas presem yu!</para>
  <para style="q1" vid="PSA 104:1">!Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 104:1">mo yu yu hae tumas!</para>
  <para style="q1" vid="PSA 104:1">!Yu yu King!</para>
  <para style="q1" vid="PSA 104:1">Hae nem blong yu mo paoa blong yu,</para>
  <para style="q3" vid="PSA 104:1">tufala i olsem klos blong yu,<verse eid="PSA 104:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 104:2" />mo laet ya we i stap soemaot bigfala paoa blong yu,</para>
  <para style="q4" vid="PSA 104:2">hem i olsem klos we yu yu stap putum.</para>
  <para style="q1" vid="PSA 104:2">Yu yu putumap skae</para>
  <para style="q2" vid="PSA 104:2">olsem haos tapolen blong yu.<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />Yu mekem haos ya blong yu</para>
  <para style="q2" vid="PSA 104:3">antap long wota we i stap antap.<note caller="+" style="f"><char style="fr" closed="false">104.3: </char><char style="ft" closed="false">Wota ya we i stap antap, yu luk tok blong hem long Jenesis 1.6-7.</char></note></para>
  <para style="q1" vid="PSA 104:3">Yu stap yusum klaod</para>
  <para style="q3" vid="PSA 104:3">olsem kat blong yu we hos i pulum,</para>
  <para style="q2" vid="PSA 104:3">mo taem win i blu,</para>
  <para style="q4" vid="PSA 104:3">yu stap raed long hem olsem hos blong yu.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104.4: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:7">Hib 1.7</ref>
      </char>
    </note>Yu stap yusum ol win</para>
  <para style="q3" vid="PSA 104:4">olsem ol man blong karem tok blong yu,</para>
  <para style="q2" vid="PSA 104:4">mo yu yusum ol laetning</para>
  <para style="q4" vid="PSA 104:4">olsem ol man blong wok blong yu.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Yu yu putum wol ya</para>
  <para style="q2" vid="PSA 104:5">i stap strong long fandesen blong hem,</para>
  <para style="q3" vid="PSA 104:5">we bambae hem i no save muf nating.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Yu putum bigfala solwota</para>
  <para style="q3" vid="PSA 104:6">blong kavremap hem olsem klos blong hem,</para>
  <para style="q2" vid="PSA 104:6">mo solwota ya i kavremap olgeta hil.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Be taem yu tok strong long solwota ya,</para>
  <para style="q2" vid="PSA 104:7">hem i godaon.</para>
  <para style="q1" vid="PSA 104:7">Voes blong yu i olsem tanda,</para>
  <para style="q2" vid="PSA 104:7">mo taem hem i harem, hem i ronwe.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />Solwota ya i ron i godaon,</para>
  <para style="q2" vid="PSA 104:8">nao ol hil mo ol krik</para>
  <para style="q4" vid="PSA 104:8">oli kamkamaot,</para>
  <para style="q3" vid="PSA 104:8">mo hem i go stap long ples</para>
  <para style="q4" vid="PSA 104:8">we yu yu makem blong hem i stap long hem.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Yu yu putum mak</para>
  <para style="q3" vid="PSA 104:9">we solwota bambae i go finis long hem,</para>
  <para style="q2" vid="PSA 104:9">mo yu blokem hem</para>
  <para style="q4" vid="PSA 104:9">blong i no save kam kavremap wol ya bakegen.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Yu yu mekem ol springwota</para>
  <para style="q3" vid="PSA 104:10">oli stap ron long ol krik,</para>
  <para style="q2" vid="PSA 104:10">mo yu mekem ol reva</para>
  <para style="q4" vid="PSA 104:10">oli stap ron long medel blong ol hil.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Ol wael dongki wetem ol narafala wael anamol</para>
  <para style="q2" vid="PSA 104:11">oli stap dring long ol wota ya,</para>
  <para style="q3" vid="PSA 104:11">blong oli harem gud.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Ol pijin oli stap mekem nes blong olgeta,</para>
  <para style="q2" vid="PSA 104:12">long ol tri long saed blong ol wota ya,</para>
  <para style="q3" vid="PSA 104:12">mo oltaem oli stap singsing.<verse eid="PSA 104:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Yu yu sanem ren i aot long skae i kam,</para>
  <para style="q3" vid="PSA 104:13">i wasem ol hil,</para>
  <para style="q2" vid="PSA 104:13">mo graon i fulap long ol gudgudfala samting</para>
  <para style="q4" vid="PSA 104:13">we yu yu mekem.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Yu mekem gras i gru</para>
  <para style="q3" vid="PSA 104:14">blong ol anamol oli kakae,</para>
  <para style="q2" vid="PSA 104:14">mo yu mekem ol samting</para>
  <para style="q4" vid="PSA 104:14">we man i save planem.</para>
  <para style="q1" vid="PSA 104:14">From samting ya,</para>
  <para style="q2" vid="PSA 104:14">man i save wokem ol garen blong hem,<verse eid="PSA 104:14" /></para>
  <para style="q3">
    <verse number="15" style="v" sid="PSA 104:15" />nao i save mekem waen</para>
  <para style="q3" vid="PSA 104:15">blong mekem hem i glad,</para>
  <para style="q4" vid="PSA 104:15">mo i save tekem olifoel* <optbreak /> blong mekem fes blong hem i saen,</para>
  <para style="q3" vid="PSA 104:15">mo i save tekem kakae <optbreak /> blong mekem hem i strong.<verse eid="PSA 104:15" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Ol sida* long Lebanon oli blong Hae God,</para>
  <para style="q3" vid="PSA 104:16">hem nomo i planem,</para>
  <para style="q2" vid="PSA 104:16">mo oltaem ren i stap kasemgud olgeta.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Ol pijin oli stap mekem nes blong olgeta</para>
  <para style="q3" vid="PSA 104:17">long ples ya,</para>
  <para style="q2" vid="PSA 104:17">mo ol bigfala pijin oli stap mekem nes blong olgeta</para>
  <para style="q4" vid="PSA 104:17">long ol bigbigfala paentri* long ples ya.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Ol bigfala hil i ples blong wael nani,</para>
  <para style="q2" vid="PSA 104:18">mo ol klif i ples blong haed blong anamol ya baja.*<verse eid="PSA 104:18" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Hae God.</para>
  <para style="q1" vid="PSA 104:19">Yu yu mekem mun blong makem ol manis.</para>
  <para style="q1" vid="PSA 104:19">Evri dei, san i savegud</para>
  <para style="q2" vid="PSA 104:19">taem blong hem blong go draon.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Yu yu mekem naet,</para>
  <para style="q2" vid="PSA 104:20">mo long tudak,</para>
  <para style="q3" vid="PSA 104:20">olgeta wael anamol oli stap kamkamaot.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Taem ol yang laeon oli go blong lukaot kakae,</para>
  <para style="q2" vid="PSA 104:21">oli stap singsingaot bigwan.</para>
  <para style="q1" vid="PSA 104:21">Oli stap lukaot kakae ya</para>
  <para style="q2" vid="PSA 104:21">we yu yu stap givim long olgeta.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Be taem san i girap,</para>
  <para style="q2" vid="PSA 104:22">oli gobak long ol hol blong olgeta,</para>
  <para style="q3" vid="PSA 104:22">oli stap slip.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Nao ol man oli go blong mekem ol wok blong olgeta,</para>
  <para style="q2" vid="PSA 104:23">mo oli stap wok gogo kasem sapa.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />Hae God.</para>
  <para style="q1" vid="PSA 104:24">Yu yu mekem plante naranarafala samting,</para>
  <para style="q2" vid="PSA 104:24">mo olgeta evriwan oli stap soemaot</para>
  <para style="q3" vid="PSA 104:24">we fasin blong yu blong wokem</para>
  <para style="q4" vid="PSA 104:24">olgeta i waes we i waes.</para>
  <para style="q1" vid="PSA 104:24">Wol ya i fulap long olgeta samting</para>
  <para style="q2" vid="PSA 104:24">we yu yu mekem.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />I gat solwota i stap</para>
  <para style="q3" vid="PSA 104:25">we i bigfala tumas,</para>
  <para style="q2" vid="PSA 104:25">mo i gat plante samting we yu yu mekem</para>
  <para style="q4" vid="PSA 104:25">oli stap insaed long hem.</para>
  <para style="q1" vid="PSA 104:25">Ol samting ya, samfala oli bigbigwan,</para>
  <para style="q2" vid="PSA 104:25">mo samfala oli smosmol.</para>
  <para style="q1" vid="PSA 104:25">Olgeta oli plante tumas,</para>
  <para style="q2" vid="PSA 104:25">we man i no save kaontem olgeta.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104.26: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 41:1">Job 41.1</ref>; <ref loc="PSA 74:14">Sam 74.14</ref>; <ref loc="ISA 27:1">Aes 27.1</ref></char>
    </note>Ol sip oli stap ron long solwota ya,</para>
  <para style="q2" vid="PSA 104:26">mo leviatan,*</para>
  <para style="q3" vid="PSA 104:26">bigfala anamol ya blong solwota</para>
  <para style="q4" vid="PSA 104:26">we yu yu mekem,</para>
  <para style="q2" vid="PSA 104:26">hem i stap pleplei insaed long hem.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Olgeta ya evriwan,</para>
  <para style="q2" vid="PSA 104:27">taem oli hanggri, oli stap luk long yu,</para>
  <para style="q3" vid="PSA 104:27">blong yu givim kakae long olgeta.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Taem yu givim kakae long olgeta,</para>
  <para style="q2" vid="PSA 104:28">olgeta oli kakae, mo oli harem gud.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Taem yu gowe long olgeta,</para>
  <para style="q2" vid="PSA 104:29">olgeta oli harem nogud.</para>
  <para style="q1" vid="PSA 104:29">Taem yu tekemaot win blong olgeta,</para>
  <para style="q2" vid="PSA 104:29">olgeta oli ded,</para>
  <para style="q3" vid="PSA 104:29">oli gobak long asis</para>
  <para style="q4" vid="PSA 104:29">we oli kamaot long hem.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Taem yu givim win blong yu long olgeta,</para>
  <para style="q2" vid="PSA 104:30">yu mekem olgeta oli laef.<note caller="+" style="f"><char style="fr" closed="false">104.30: </char><char style="ft" closed="false">Narafala rod blong tanem tok long fas haf blong vas ya i olsem. </char><char style="fqa" closed="false">Taem yu <char style="bd">sanem Spirit</char> </char><char style="fqa" closed="false">blong yu <char style="bd">i kam</char> </char><char style="fqa" closed="false">long olgeta, yu mekem olgeta oli laef.</char></note></para>
  <para style="q1" vid="PSA 104:30">Oltaem yu yu mekem olgeta samting long graon ya</para>
  <para style="q2" vid="PSA 104:30">oli gat niufala laef.<verse eid="PSA 104:30" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Prea blong mi,</para>
  <para style="q2" vid="PSA 104:31">we ol gudgudfala samting ya</para>
  <para style="q4" vid="PSA 104:31">we oli stap soemaot paoa blong Hae God,</para>
  <para style="q3" vid="PSA 104:31">bambae oli stap oltaem nomo</para>
  <para style="q3" vid="PSA 104:31">gogo i no save finis.</para>
  <para style="q1" vid="PSA 104:31">Mi mi wantem</para>
  <para style="q2" vid="PSA 104:31">we oltaem bambae hem i glad</para>
  <para style="q3" vid="PSA 104:31">long olgeta samting ya we hem i mekem.<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />Taem hem i lukluk i kam long wol,</para>
  <para style="q2" vid="PSA 104:32">graon i seksek.</para>
  <para style="q1" vid="PSA 104:32">Taem hem i tajem ol hil,</para>
  <para style="q2" vid="PSA 104:32">smok i kamaot long olgeta.<verse eid="PSA 104:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Oltaem long laef blong mi,</para>
  <para style="q2" vid="PSA 104:33">bambae mi stap singsing blong presem Hae God,</para>
  <para style="q3" vid="PSA 104:33">gogo laef blong mi i finis.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Mi wantem we hem bambae i harem gud</para>
  <para style="q3" vid="PSA 104:34">long sing ya blong mi,</para>
  <para style="q2" vid="PSA 104:34">from we oltaem,</para>
  <para style="q4" vid="PSA 104:34">hem i stap mekem mi mi glad.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Prea blong mi</para>
  <para style="q2" vid="PSA 104:35">we hem bambae i brumumaot ol man nogud</para>
  <para style="q3" vid="PSA 104:35">oli gowe long wol ya,</para>
  <para style="q4" vid="PSA 104:35">we bambae i no moa gat wan long olgeta i stap.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">!Mi mi mas presem Hae God!</para>
  <para style="q1" vid="PSA 104:35">!Oltaem yumi evriwan i mas presem hem!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">Hae God i stap givhan gud long ol man blong hem</para>
  <para style="r">(<ref loc="1CH 16:8-22">1 Kronikel 16.8-22</ref>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />!Yumi talem tangkiu long Hae God!</para>
  <para style="q1" vid="PSA 105:1">!Yumi talemaot hae nem blong hem!</para>
  <para style="q1" vid="PSA 105:1">Yumi go long olgeta man blong ol narafala kantri,</para>
  <para style="q2" vid="PSA 105:1">yumi talemaot ol samting ya we hem i bin mekem.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Yumi sing, yumi presem hem.</para>
  <para style="q1" vid="PSA 105:2">Yumi talemaot ol bigbigfala samting ya</para>
  <para style="q2" vid="PSA 105:2">we hem i bin mekem.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Yumi evriwan ya</para>
  <para style="q3" vid="PSA 105:3">we yumi stap mekem wosip long hem,</para>
  <para style="q2" vid="PSA 105:3">yumi mas glad,</para>
  <para style="q3" vid="PSA 105:3">from we tabu nem blong hem</para>
  <para style="q4" vid="PSA 105:3">i stap long yumi.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Yumi mas luk long Hae God</para>
  <para style="q2" vid="PSA 105:4">blong hem i givhan long yumi,</para>
  <para style="q3" vid="PSA 105:4">mo oltaem,</para>
  <para style="q4" vid="PSA 105:4">yumi mas mekem wosip long hem.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 105:5-6" />Yumi ya,</para>
  <para style="q2" vid="PSA 105:5-6">yumi laen* blong Ebraham,</para>
  <para style="q4" vid="PSA 105:5-6">we i man blong wok blong Hae God,</para>
  <para style="q3" vid="PSA 105:5-6">mo yumi laen blong Isrel,*</para>
  <para style="q3" vid="PSA 105:5-6">we Hae God i jusumaot hem.</para>
  <para style="q1" vid="PSA 105:5-6">Oltaem yumi mas tingbaot ol merikel</para>
  <para style="q2" vid="PSA 105:5-6">we hem i mekem,</para>
  <para style="q3" vid="PSA 105:5-6">mo ol rul blong hem</para>
  <para style="q4" vid="PSA 105:5-6">we hem i givim blong jajem man.<verse eid="PSA 105:5-6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />Hae God,</para>
  <para style="q2" vid="PSA 105:7">hem i God blong yumi.</para>
  <para style="q1" vid="PSA 105:7">Ol tok we hem i talem</para>
  <para style="q2" vid="PSA 105:7">i blong olgeta man long wol.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />Promes* ya we hem i mekem wetem yumi</para>
  <para style="q2" vid="PSA 105:8">bambae hem i no save fogetem samtaem.</para>
  <para style="q1" vid="PSA 105:8">Oltaem bambae hem i stap holem promes ya</para>
  <para style="q2" vid="PSA 105:8">we i mekem wetem yumi,</para>
  <para style="q3" vid="PSA 105:8">mo wetem olgeta we bambae oli kamaot biaen long yumi,</para>
  <para style="q4" vid="PSA 105:8">gogo i no save finis.<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.9 a: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:7">Jen 12.7</ref>; <ref loc="GEN 17:8">17.8</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 26:3">Jen 26.3</ref>
      </char>
    </note>Promes ya,</para>
  <para style="q2" vid="PSA 105:9">hem i mekem fastaem wetem Ebraham bifo,</para>
  <para style="q2" vid="PSA 105:9">mo biaen, i mekem bakegen wetem Aesak,</para>
  <para style="q3" vid="PSA 105:9">mo i givim strong tok long hem</para>
  <para style="q4" vid="PSA 105:9">blong mekem promes ya i stanap.<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.10: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 28:13">Jen 28.13</ref>
      </char>
    </note>Mo biaen bakegen,</para>
  <para style="q2" vid="PSA 105:10">hem i mekem promes ya wetem Jekob,*</para>
  <para style="q3" vid="PSA 105:10">we promes ya i kam olsem wan loa</para>
  <para style="q4" vid="PSA 105:10">we bambae i no save lus samtaem.<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />Hem i talem se,</para>
  <para style="q2" vid="PSA 105:11">“Bambae mi givim kantri ya Kenan* long yu,</para>
  <para style="q3" vid="PSA 105:11">mo kantri ya bambae i blong yufala</para>
  <para style="q4" vid="PSA 105:11">oltaem nomo.”<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Be long taem ya,</para>
  <para style="q2" vid="PSA 105:12">ol bubu ya blong yumi oli no plante,</para>
  <para style="q3" vid="PSA 105:12">namba blong olgeta i smol nomo,</para>
  <para style="q4" vid="PSA 105:12">mo oli strenja nomo long kantri ya.<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />Oltaem oli stap muvum ples blong olgeta.</para>
  <para style="q1" vid="PSA 105:13">Oltaem, oli aot long wan ples,</para>
  <para style="q3" vid="PSA 105:13">oli go long narafala ples,</para>
  <para style="q2" vid="PSA 105:13">oli lego wan kingdom</para>
  <para style="q4" vid="PSA 105:13">oli go long narafala kingdom.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.14: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 20:3-7">Jen 20.3-7</ref>
      </char>
    </note>Be Hae God i no letem</para>
  <para style="q2" vid="PSA 105:14">ol man long ol ples ya oli spolem olgeta.</para>
  <para style="q1" vid="PSA 105:14">Hem i tok long ol king from olgeta,<verse eid="PSA 105:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 105:15" />i talem se, “!Yufala i lukaot!</para>
  <para style="q2" vid="PSA 105:15">Yufala i no spolem ol man blong mi</para>
  <para style="q4" vid="PSA 105:15">we mi mi jusumaot olgeta,</para>
  <para style="q3" vid="PSA 105:15">mo yufala i no tajem</para>
  <para style="q3" vid="PSA 105:15">ol profet ya blong mi.”<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.16: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:53-57">Jen 41.53-57</ref>
      </char>
    </note>Hae God i sanem hadtaem i kam</para>
  <para style="q3" vid="PSA 105:16">we i no gat kakae nating long ples blong olgeta,</para>
  <para style="q2" vid="PSA 105:16">mo hem i tekemaot</para>
  <para style="q4" vid="PSA 105:16">olgeta kakae blong olgeta.<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.17: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 37:28">Jen 37.28</ref>; <ref loc="GEN 45:5">45.5</ref></char>
    </note>Be hem i sanem wan long olgeta</para>
  <para style="q2" vid="PSA 105:17">i go long Ijip fastaem</para>
  <para style="q3" vid="PSA 105:17">blong mekem rod blong olgeta.</para>
  <para style="q1" vid="PSA 105:17">Man ya, nem blong hem Josef,</para>
  <para style="q2" vid="PSA 105:17">we ol brata blong hem oli salemaot</para>
  <para style="q3" vid="PSA 105:17">hem blong i go wok slef.*<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.18: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 39:20-40:23">Jen 39.20—40.23</ref>
      </char>
    </note>Hem i stap long Ijip,</para>
  <para style="q2" vid="PSA 105:18">i stap harem nogud tumas,</para>
  <para style="q3" vid="PSA 105:18">we ol jen oli fasemtaet leg blong hem,</para>
  <para style="q4" vid="PSA 105:18">mo bigfala aean i holemtaet nek blong hem.<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />Hem i stap olsem gogo</para>
  <para style="q2" vid="PSA 105:19">tok we hem i talemaot i kamtru.</para>
  <para style="q1" vid="PSA 105:19">Tok blong Hae God i soemaot</para>
  <para style="q2" vid="PSA 105:19">we man ya i stret nomo.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.20: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:14">Jen 41.14</ref>
      </char>
    </note>Nao king blong Ijip</para>
  <para style="q3" vid="PSA 105:20">we i rulum plante kantri,</para>
  <para style="q2" vid="PSA 105:20">hem i tekemaot hem long kalabus,</para>
  <para style="q4" vid="PSA 105:20">i letem hem i go fri.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.21: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:39-41">Jen 41.39-41</ref>
      </char>
    </note>King ya i givim wan wok long hem</para>
  <para style="q3" vid="PSA 105:21">blong i gavman long ples ya,</para>
  <para style="q2" vid="PSA 105:21">i putumap hem</para>
  <para style="q4" vid="PSA 105:21">blong i rul long olgeta ples.<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />Nao Josef i gat paoa moa,</para>
  <para style="q3" vid="PSA 105:22">i winim ol narafala haeman blong king,</para>
  <para style="q2" vid="PSA 105:22">mo hem i gat raet</para>
  <para style="q4" vid="PSA 105:22">blong tijim ol advaesa blong king.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.23 a: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:6">Jen 46.6</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 47:11">Jen 47.11</ref>
      </char>
    </note>Nao biaen,</para>
  <para style="q2" vid="PSA 105:23">Jekob wetem ol pikinini blong hem</para>
  <para style="q3" vid="PSA 105:23">oli go stap longtaem long kantri ya Ijip,</para>
  <para style="q1" vid="PSA 105:23">we i ples blong ol laen blong Ham.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.24: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:7-14">Eks 1.7-14</ref>
      </char>
    </note>Nao Hae God i mekem</para>
  <para style="q2" vid="PSA 105:24">we ol man ya blong hem oli kam plante,</para>
  <para style="q3" vid="PSA 105:24">mo i mekem olgeta oli strong moa,</para>
  <para style="q4" vid="PSA 105:24">i winim ol enemi blong olgeta.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />Nao hem i mekem we ol man Ijip</para>
  <para style="q2" vid="PSA 105:25">oli no moa laekem ol man blong hem,</para>
  <para style="q3" vid="PSA 105:25">oli agens long olgeta,</para>
  <para style="q4" vid="PSA 105:25">mo oli stap ravem olgeta.<verse eid="PSA 105:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.26: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:1-4:17">Eks 3.1—4.17</ref>
      </char>
    </note>Nao Hae God i jusum tu man,</para>
  <para style="q2" vid="PSA 105:26">Moses we i man blong wok blong hem</para>
  <para style="q3" vid="PSA 105:26">mo Eron we hem i bin jusumaot hem finis,</para>
  <para style="q2" vid="PSA 105:26">nao i sanem tufala i go long Ijip.<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Nao tufala i mekem ol bigbigfala wok</para>
  <para style="q3" vid="PSA 105:27">long nem blong hem,</para>
  <para style="q2" vid="PSA 105:27">tufala i stap mekem ol merikel</para>
  <para style="q4" vid="PSA 105:27">long ples ya.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.28: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:21-23">Eks 10.21-23</ref>
      </char>
    </note>Hae God i sanem tudak</para>
  <para style="q3" vid="PSA 105:28">i kam kavremapgud kantri ya,</para>
  <para style="q2" vid="PSA 105:28">be ol man Ijip oli no obei</para>
  <para style="q4" vid="PSA 105:28">long tok blong hem.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.29: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Eks 7.17-21</ref>
      </char>
    </note>Hem i mekem ol reva blong olgeta i kam blad,</para>
  <para style="q2" vid="PSA 105:29">mo i kilim olgeta fis oli ded.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.30: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:1-6">Eks 8.1-6</ref>
      </char>
    </note>Kantri blong olgeta i kam fulap</para>
  <para style="q2" vid="PSA 105:30">long ol frog.</para>
  <para style="q1" vid="PSA 105:30">Nating we haos blong king,</para>
  <para style="q2" vid="PSA 105:30">be oli fulap gud long hem.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.31 a: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:20-24">Eks 8.20-24</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:16">Eks 8.16</ref>,<ref loc="EXO 8:17">17</ref></char>
    </note>Hae God i tok,</para>
  <para style="q2" vid="PSA 105:31">nao ol flae mo ol mostik</para>
  <para style="q3" vid="PSA 105:31">oli kam kavremap olgeta ples long kantri ya.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.32: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Eks 9.22-25</ref>
      </char>
    </note>Hem i mekem we oli no moa save kasem ren,</para>
  <para style="q2" vid="PSA 105:32">ston blong aes* nomo i stap folfoldaon,</para>
  <para style="q3" vid="PSA 105:32">mo laetning i stap laet bigwan</para>
  <para style="q4" vid="PSA 105:32">olbaot long ples blong olgeta.<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />Hem i spolem ol rop ya grep*</para>
  <para style="q2" vid="PSA 105:33">mo i brebrekem ol figtri* blong olgeta.</para>
  <para style="q1" vid="PSA 105:33">Hem i spolemgud olgeta tri long ples blong olgeta</para>
  <para style="q2" vid="PSA 105:33">long tufala samting ya.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.34: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Eks 10.12-15</ref>
      </char>
    </note>Hem i tok,</para>
  <para style="q2" vid="PSA 105:34">nao olgeta lokis* oli kam.</para>
  <para style="q1" vid="PSA 105:34">Oli plante we i plante,</para>
  <para style="q3" vid="PSA 105:34">we man i no save kaontem olgeta,<verse eid="PSA 105:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="PSA 105:35" />nao oli kakae olgeta samting</para>
  <para style="q4" vid="PSA 105:35">we man i planem long garen,</para>
  <para style="q3" vid="PSA 105:35">wetem ol narafala samting</para>
  <para style="q3" vid="PSA 105:35">we oli stap gru olbaot.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.36: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Eks 12.29</ref>
      </char>
    </note>Nao hem i kilim</para>
  <para style="q2" vid="PSA 105:36">olgeta fasbon pikinini boe blong ol man Ijip oli ded<note caller="+" style="f"><char style="fr" closed="false">105.36: </char><char style="ft" closed="false">God i mekem olsem blong panisim ol man Ijip, from we oli givim ol fasbon pikinini boe blong olgeta long ol narafala god. Yu luk Eksodas 12.12.</char></note><verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.37: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:33-36">Eks 12.33-36</ref>
      </char>
    </note>Nao hem i lidim ol laen blong Isrel</para>
  <para style="q2" vid="PSA 105:37">oli aot long kantri ya oli go,</para>
  <para style="q3" vid="PSA 105:37">we oli karem ol silva mo gol,</para>
  <para style="q2" vid="PSA 105:37">mo olgeta evriwan oli stap gud,</para>
  <para style="q3" vid="PSA 105:37">oli no sik, oli stap strong oltaem.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Ol man Ijip oli stap fraet long olgeta,</para>
  <para style="q2" vid="PSA 105:38">mo taem oli luk olgeta oli go,</para>
  <para style="q3" vid="PSA 105:38">oli harem gud tumas.<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.39: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Eks 13.21</ref>,<ref loc="EXO 13:22">22</ref></char>
    </note>Hae God i putum klaod antap long ol man blong hem</para>
  <para style="q3" vid="PSA 105:39">blong kavremap olgeta,</para>
  <para style="q2" vid="PSA 105:39">mo long naet, hem i putum faea</para>
  <para style="q4" vid="PSA 105:39">blong givim laet long olgeta.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.40: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:2-15">Eks 16.2-15</ref>
      </char>
    </note>Oli askem kakae long hem</para>
  <para style="q2" vid="PSA 105:40">nao hem i sanem ol pijin i kam long olgeta</para>
  <para style="q3" vid="PSA 105:40">blong oli kakae,</para>
  <para style="q2" vid="PSA 105:40">mo i sanem kakae blong heven i kam,</para>
  <para style="q3" vid="PSA 105:40">i givim long olgeta</para>
  <para style="q4" vid="PSA 105:40">blong oli kakae, oli harem gud.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.41: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Eks 17.1-7</ref>; <ref loc="NUM 20:2-13">Nam 20.2-13</ref></char>
    </note>Hem i brekem wan bigfala ston,</para>
  <para style="q2" vid="PSA 105:41">nao wota i ron i kamaot,</para>
  <para style="q3" vid="PSA 105:41">i ron i gotru long draeples</para>
  <para style="q4" vid="PSA 105:41">olsem wan reva.<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Oltaem hem i stap tingbaot promes ya blong hem</para>
  <para style="q2" vid="PSA 105:42">we i mekem bifo wetem Ebraham,</para>
  <para style="q3" vid="PSA 105:42">man blong wok blong hem,</para>
  <para style="q2" vid="PSA 105:42">se promes ya i tabu,</para>
  <para style="q4" vid="PSA 105:42">i no save brekem.<verse eid="PSA 105:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Hae God,</para>
  <para style="q2" vid="PSA 105:43">hem i lidim ol man blong hem</para>
  <para style="q4" vid="PSA 105:43">we hem i bin jusumaot olgeta,</para>
  <para style="q3" vid="PSA 105:43">oli goaot we oli stap singsing,</para>
  <para style="q4" vid="PSA 105:43">oli glad,</para>
  <para style="q3" vid="PSA 105:43">oli stap singsingaot from.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105.44: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 11:16-23">Jos 11.16-23</ref>
      </char>
    </note>Nao hem i givim graon blong ol narafala man</para>
  <para style="q4" vid="PSA 105:44">i go long olgeta,</para>
  <para style="q3" vid="PSA 105:44">mo i letem olgeta oli tekem ol garen blong olgeta,<verse eid="PSA 105:44" /></para>
  <para style="q2">
    <verse number="45" style="v" sid="PSA 105:45" />blong ol man blong hem</para>
  <para style="q3" vid="PSA 105:45">bambae oli obei long ol loa blong hem,</para>
  <para style="q4" vid="PSA 105:45">mo oli folem ol tok blong hem.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q1" vid="PSA 105:45">!Oltaem yumi mas presem Hae God!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">Hae God i stap mekem i gud tumas long ol man blong hem, be olgeta oli stap mekem i nogud long hem</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Kron 16.34</ref>; <ref loc="2CH 5:13">2 Kron 5.13</ref>; <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Esra 3.11</ref>; <ref loc="PSA 100:5">Sam 100.5</ref>; <ref loc="PSA 107:1">107.1</ref>; <ref loc="PSA 118:1">118.1</ref>; <ref loc="PSA 136:1">136.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char>
    </note>!Yumi presem Hae God!</para>
  <para style="q1" vid="PSA 106:1">Yumi mas talem tangkiu long hem,</para>
  <para style="q2" vid="PSA 106:1">from we hem i gud,</para>
  <para style="q3" vid="PSA 106:1">fasin blong hem blong lavem man,</para>
  <para style="q4" vid="PSA 106:1">hem i no save finis.<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />?Hu man i naf blong talemaot</para>
  <para style="q2" vid="PSA 106:2">ol gudgudfala fasin we hem i mekem?</para>
  <para style="q1" vid="PSA 106:2">?Hu man i save presem hem</para>
  <para style="q2" vid="PSA 106:2">stret long mak blong gudfala fasin blong hem?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Olgeta we oli stap obei</para>
  <para style="q3" vid="PSA 106:3">long ol tok blong hem,</para>
  <para style="q2" vid="PSA 106:3">mo we oltaem oli stap mekem</para>
  <para style="q4" vid="PSA 106:3">ol fasin we i stret,</para>
  <para style="q3" vid="PSA 106:3">bambae oli save harem gud.<verse eid="PSA 106:3" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />Hae God.</para>
  <para style="q1" vid="PSA 106:4">Taem yu kam blong givhan long ol man blong yu,</para>
  <para style="q2" vid="PSA 106:4">plis yu tingbaot mi.</para>
  <para style="q1" vid="PSA 106:4">Taem yu kam blong sevem olgeta,</para>
  <para style="q2" vid="PSA 106:4">plis yu kaontem mi wetem olgeta.<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />Yu yu jusumaot olgeta</para>
  <para style="q2" vid="PSA 106:5">blong oli man blong yu,</para>
  <para style="q3" vid="PSA 106:5">nao oli stap glad from samting ya,</para>
  <para style="q4" vid="PSA 106:5">mo oli stap presem yu,</para>
  <para style="q3" vid="PSA 106:5">from we nem blong yu i stap long olgeta.</para>
  <para style="q1" vid="PSA 106:5">Plis yu letem mi mi luk</para>
  <para style="q3" vid="PSA 106:5">gudfala laef blong olgeta,</para>
  <para style="q2" vid="PSA 106:5">mo yu letem mi mi joen wetem olgeta</para>
  <para style="q4" vid="PSA 106:5">blong presem yu.<verse eid="PSA 106:5" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Yumi ya, yumi man nogud,</para>
  <para style="q3" vid="PSA 106:6">yumi mekem i no stret.</para>
  <para style="q1" vid="PSA 106:6">Oltaem yumi stap mekem ol rabis fasin</para>
  <para style="q2" vid="PSA 106:6">olsem we ol bubu blong yumi bifo oli bin mekem,</para>
  <para style="q3" vid="PSA 106:6">yumi man nogud, yumi rabis.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:10-12">Eks 14.10-12</ref>
      </char>
    </note>Hae God, hem i hae we i hae.</para>
  <para style="q1" vid="PSA 106:7">Bifo long Ijip,</para>
  <para style="q2" vid="PSA 106:7">ol bubu ya blong yumi oli no luksave</para>
  <para style="q3" vid="PSA 106:7">ol bigbigfala wok blong hem.</para>
  <para style="q1" vid="PSA 106:7">Plante taem, hem i stap soemaot long olgeta</para>
  <para style="q3" vid="PSA 106:7">we hem i lavem olgeta,</para>
  <para style="q2" vid="PSA 106:7">be olgeta oli fogetem samting ya,</para>
  <para style="q3" vid="PSA 106:7">nao long Red Si,</para>
  <para style="q4" vid="PSA 106:7">oli girap oli agensem hem.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Be hem i sevem olgeta</para>
  <para style="q2" vid="PSA 106:8">olsem we hem i bin promes.</para>
  <para style="q1" vid="PSA 106:8">Hemia i blong soemaot</para>
  <para style="q2" vid="PSA 106:8">bigfala paoa blong hem.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-31">Eks 14.21-31</ref>
      </char>
    </note>Hem i tok long Red Si,</para>
  <para style="q2" vid="PSA 106:9">nao solwota i seraot,</para>
  <para style="q4" vid="PSA 106:9">ples i kam drae,</para>
  <para style="q2" vid="PSA 106:9">nao hem i lidim ol man blong hem,</para>
  <para style="q3" vid="PSA 106:9">oli wokbaot oli gokros long narasaed.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />Ol enemi blong olgeta oli no laekem olgeta nating,</para>
  <para style="q3" vid="PSA 106:10">oli agens long olgeta,</para>
  <para style="q2" vid="PSA 106:10">be hem i tekemaot olgeta long han blong ol enemi ya,</para>
  <para style="q3" vid="PSA 106:10">i sevem olgeta.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Solwota i kambak,</para>
  <para style="q2" vid="PSA 106:11">i draonem ol enemi ya blong olgeta,</para>
  <para style="q3" vid="PSA 106:11">we i no gat wan i stap.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.12: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:1-21">Eks 15.1-21</ref>
      </char>
    </note>Nao ol man blong hem oli bilif</para>
  <para style="q3" vid="PSA 106:12">long ol promes blong hem,</para>
  <para style="q2" vid="PSA 106:12">mo oli sing, oli presem hem.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Be i no longtaem,</para>
  <para style="q2" vid="PSA 106:13">olgeta oli fogetem ol samting ya</para>
  <para style="q3" vid="PSA 106:13">we hem i mekem,</para>
  <para style="q2" vid="PSA 106:13">nao oli no wet fastaem</para>
  <para style="q4" vid="PSA 106:13">blong harem tok blong hem,</para>
  <para style="q3" vid="PSA 106:13">oli girap oli folem tingting blong olgeta nomo.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.14: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 11:4-34">Nam 11.4-34</ref>
      </char>
    </note>Taem oli stap long draeples,</para>
  <para style="q3" vid="PSA 106:14">oli hanggri tumas,</para>
  <para style="q2" vid="PSA 106:14">nao oli askem kakae long God</para>
  <para style="q4" vid="PSA 106:14">blong traem hem.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Mo hem i givim ol samting long olgeta we oli askem,</para>
  <para style="q2" vid="PSA 106:15">be hem i givim wan rabis sik tu long olgeta.<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.16: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:1-35">Nam 16.1-35</ref>
      </char>
    </note>Long draeples ya,</para>
  <para style="q2" vid="PSA 106:16">olgeta oli jalus tumas long Moses,</para>
  <para style="q3" vid="PSA 106:16">mo long Eron we i pris blong Hae God,</para>
  <para style="q4" vid="PSA 106:16">mo i stap wok blong hem.<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />Nao graon i open bigwan,</para>
  <para style="q2" vid="PSA 106:17">nao Datan mo Abiram wetem grup blong tufala</para>
  <para style="q4" vid="PSA 106:17">oli foldaon i go long hol ya,</para>
  <para style="q3" vid="PSA 106:17">nao graon i berem olgeta.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Mo faea i kamdaon long ol man nogud ya</para>
  <para style="q3" vid="PSA 106:18">we oli biaen long tufala,</para>
  <para style="q2" vid="PSA 106:18">i bonem olgeta oli ded.<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.19: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:1-14">Eks 32.1-14</ref>
      </char>
    </note>Long bigfala hil ya Sinae,</para>
  <para style="q2" vid="PSA 106:19">olgeta oli wokem wan pija blong bul long gol,</para>
  <para style="q3" vid="PSA 106:19">nao oli stap wosipim pija ya.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />God i hae we i hae,</para>
  <para style="q2" vid="PSA 106:20">be olgeta oli lego hem,</para>
  <para style="q3" vid="PSA 106:20">blong go mekem wosip long pija blong bul</para>
  <para style="q4" vid="PSA 106:20">we kakae blong hem gras.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />God i bin mekem ol bigbigfala wok long Ijip</para>
  <para style="q3" vid="PSA 106:21">blong sevem olgeta,</para>
  <para style="q2" vid="PSA 106:21">be oli no moa tingbaot hem.<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />!Ol wok we hem i mekem long ples ya</para>
  <para style="q2" vid="PSA 106:22">i bigfala tumas!</para>
  <para style="q1" vid="PSA 106:22">!Ol wok ya we hem i mekem long Red Si,</para>
  <para style="q2" vid="PSA 106:22">i samting blong sapraes</para>
  <para style="q3" vid="PSA 106:22">we man i seksek from!<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Taem hem i talem</para>
  <para style="q3" vid="PSA 106:23">se hem bambae i spolem ol man blong hem,</para>
  <para style="q2" vid="PSA 106:23">Moses,</para>
  <para style="q3" vid="PSA 106:23">man ya we hem i bin jusumaot</para>
  <para style="q4" vid="PSA 106:23">blong i man blong wok blong hem,</para>
  <para style="q3" vid="PSA 106:23">hem i agens long tingting ya blong hem,</para>
  <para style="q2" vid="PSA 106:23">nao hem i prea i askem long God</para>
  <para style="q3" vid="PSA 106:23">blong i no moa kros long olgeta,</para>
  <para style="q4" vid="PSA 106:23">i no kam spolem olgeta,</para>
  <para style="q3" vid="PSA 106:23">mo God i harem hem.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.24: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:1-35">Nam 14.1-35</ref>
      </char>
    </note>Be biaen oli no wantem go insaed long gudfala kantri ya</para>
  <para style="q3" vid="PSA 106:24">we God i promes finis blong givim long olgeta,</para>
  <para style="q2" vid="PSA 106:24">from we oli no bilif long promes ya blong hem</para>
  <para style="q4" vid="PSA 106:24">we i talem se bambae i givhan long olgeta.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Oli stap long haos tapolen blong olgeta,</para>
  <para style="q2" vid="PSA 106:25">oli stap tok smosmol</para>
  <para style="q4" vid="PSA 106:25">agens long Hae God,</para>
  <para style="q3" vid="PSA 106:25">mo oli no save lesin long hem.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Nao hem i mekem wan strong tok long olgeta.</para>
  <para style="q1" vid="PSA 106:26">Hem i talem se,</para>
  <para style="q2" vid="PSA 106:26">“Bambae mi kilim yufala long draeples,<verse eid="PSA 106:26" /></para>
  <para style="q3">
    <verse number="27" style="v" sid="PSA 106:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.27: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:33">Lev 26.33</ref>
      </char>
    </note>mo bambae mi mekem olgeta</para>
  <para style="q4" vid="PSA 106:27">we bambae oli kamaot biaen long yufala</para>
  <para style="q3" vid="PSA 106:27">oli stap olbaot wetem ol hiten man,</para>
  <para style="q4" vid="PSA 106:27">mo bambae mi letem olgeta oli ded <optbreak /> long ol narafala kantri.”<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.28: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 25:1-13">Nam 25.1-13</ref>
      </char>
    </note>Nao long hil ya Peoro,</para>
  <para style="q2" vid="PSA 106:28">ol man ya blong God oli joen</para>
  <para style="q4" vid="PSA 106:28">long ol man blong ples ya</para>
  <para style="q3" vid="PSA 106:28">we oli stap mekem wosip</para>
  <para style="q3" vid="PSA 106:28">long ol god ya Bal.*</para>
  <para style="q1" vid="PSA 106:28">Ol god ya oli no gat laef nating,</para>
  <para style="q2" vid="PSA 106:28">be olgeta ya oli stap kakae mit blong ol anamol</para>
  <para style="q3" vid="PSA 106:28">we ol man Peoro oli stap kilim</para>
  <para style="q4" vid="PSA 106:28">blong mekem sakrefaes long hem.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Ol samting ya we oli mekem</para>
  <para style="q2" vid="PSA 106:29">i mekem Hae God i kros tumas long olgeta,</para>
  <para style="q3" vid="PSA 106:29">nao wan rabis sik i kasem olgeta.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Be Finehas i jajem tufala ya</para>
  <para style="q3" vid="PSA 106:30">we i stamba blong trabol ya,</para>
  <para style="q2" vid="PSA 106:30">i kilim tufala i ded,</para>
  <para style="q4" vid="PSA 106:30">nao sik ya finis.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Gudfala wok ya we hem i mekem</para>
  <para style="q3" vid="PSA 106:31">i soemaot we fasin blong hem i stret,</para>
  <para style="q2" vid="PSA 106:31">mo stori blong samting ya</para>
  <para style="q4" vid="PSA 106:31">bambae i no save lus samtaem.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.32: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 20:2-13">Nam 20.2-13</ref>
      </char>
    </note>Long springwota ya Meriba,</para>
  <para style="q2" vid="PSA 106:32">olgeta oli mekem Hae God i kros tumas,</para>
  <para style="q3" vid="PSA 106:32">nao Moses i kasem trabol</para>
  <para style="q4" vid="PSA 106:32">from ol samting ya we oli mekem.<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />Olgeta oli mekem</para>
  <para style="q3" vid="PSA 106:33">tingting blong Moses i kam nogud,</para>
  <para style="q2" vid="PSA 106:33">nao hem i gohed</para>
  <para style="q4" vid="PSA 106:33">i sakem toktok long olgeta</para>
  <para style="q3" vid="PSA 106:33">we i no tingbaot.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.34: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:1-3">Jaj 2.1-3</ref>; <ref loc="JDG 3:5">3.5</ref>,<ref loc="JDG 3:6">6</ref></char>
    </note>Hae God i bin talem long olgeta,</para>
  <para style="q3" vid="PSA 106:34">se oli mas kilim ol hiten man</para>
  <para style="q4" vid="PSA 106:34">oli ded,<verse eid="PSA 106:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="PSA 106:35" />be oli no mekem olsem,</para>
  <para style="q3" vid="PSA 106:35">oli girap oli stap mared long olgeta,</para>
  <para style="q4" vid="PSA 106:35">nao oli stap folem ol kastom blong olgeta.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />Olgeta oli stap mekem wosip</para>
  <para style="q3" vid="PSA 106:36">long ol narafala god ya,</para>
  <para style="q2" vid="PSA 106:36">nao fasin ya i kam olsem wan trap</para>
  <para style="q4" vid="PSA 106:36">we i kasemgud olgeta.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.37: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 17:17">2 King 17.17</ref>
      </char>
    </note>Nao oli stap kilim ol pikinini blong olgeta</para>
  <para style="q2" vid="PSA 106:37">blong mekem sakrefaes long ol giaman god ya.<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.38: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 35:33">Nam 35.33</ref>
      </char>
    </note>Ol pikinini ya,</para>
  <para style="q3" vid="PSA 106:38">laef blong olgeta i stret nomo</para>
  <para style="q2" vid="PSA 106:38">be olgeta oli girap oli stap kilim olgeta</para>
  <para style="q3" vid="PSA 106:38">blong mekem sakrefaes long ol god ya,</para>
  <para style="q2" vid="PSA 106:38">nao fasin ya i mekem ples blong olgeta</para>
  <para style="q3" vid="PSA 106:38">i kam doti long fes blong God.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Olgeta oli no moa holem promes ya</para>
  <para style="q3" vid="PSA 106:39">we oli mekem wetem hem</para>
  <para style="q2" vid="PSA 106:39">nao fasin ya we oli stap mekem</para>
  <para style="q4" vid="PSA 106:39">i mekem olgeta tu oli doti long fes blong hem.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.40: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:14-18">Jaj 2.14-18</ref>
      </char>
    </note>Nao from ol samting ya,</para>
  <para style="q2" vid="PSA 106:40">Hae God i no glad nating long olgeta,</para>
  <para style="q3" vid="PSA 106:40">hem i kros tumas long olgeta.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Hem i lego olgeta i go long han blong ol hiten man,</para>
  <para style="q3" vid="PSA 106:41">we oli enemi blong olgeta,</para>
  <para style="q2" vid="PSA 106:41">nao olgeta ya oli rulum olgeta.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Olgeta ya oli stap spolem olgeta,</para>
  <para style="q2" vid="PSA 106:42">oli mekem olgeta oli stap harem nogud,</para>
  <para style="q3" vid="PSA 106:42">aninit long han blong olgeta.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Plante taem,</para>
  <para style="q3" vid="PSA 106:43">Hae God i stap sevem ol man blong hem,</para>
  <para style="q2" vid="PSA 106:43">be oltaem,</para>
  <para style="q3" vid="PSA 106:43">oli stap jusum rod blong olgeta,</para>
  <para style="q4" vid="PSA 106:43">we oli stap agensem hem,</para>
  <para style="q3" vid="PSA 106:43">nao ol sin blong olgeta</para>
  <para style="q3" vid="PSA 106:43">i stap kam plante moa.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Be taem olgeta oli krae long hem,</para>
  <para style="q2" vid="PSA 106:44">hem i harem olgeta,</para>
  <para style="q3" vid="PSA 106:44">nao i sore long olgeta</para>
  <para style="q4" vid="PSA 106:44">from we oli stap long trabol.<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />Fasin blong hem blong lavem man</para>
  <para style="q3" vid="PSA 106:45">i bigfala tumas,</para>
  <para style="q2" vid="PSA 106:45">nao from we hem i stap lavem olgeta yet,</para>
  <para style="q3" vid="PSA 106:45">hem i stap tingbaot promes ya blong hem</para>
  <para style="q4" vid="PSA 106:45">we i mekem wetem olgeta bifo,</para>
  <para style="q3" vid="PSA 106:45">nao i jenisim tingting blong hem,</para>
  <para style="q4" vid="PSA 106:45">i no moa panisim olgeta.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Hem i mekem olgeta man ya</para>
  <para style="q2" vid="PSA 106:46">we oli stap spolem olgeta</para>
  <para style="q3" vid="PSA 106:46">oli sore long olgeta.<verse eid="PSA 106:46" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106.47: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:35">1 Kron 16.35</ref>,<ref loc="1CH 16:36">36</ref></char>
    </note>Hae God. Yu yu God blong mifala.</para>
  <para style="q1" vid="PSA 106:47">Plis yu sevem mifala,</para>
  <para style="q2" vid="PSA 106:47">yu tekemaot mifala long han blong ol hiten man ya,</para>
  <para style="q3" vid="PSA 106:47">yu tekem mifala i gobak long ples blong mifala.</para>
  <para style="q1" vid="PSA 106:47">Nao bambae mifala i save talem tangkiu long yu,</para>
  <para style="q2" vid="PSA 106:47">mifala i save presem tabu nem blong yu,</para>
  <para style="q3" vid="PSA 106:47">we bambae mifala i harem gud tumas from.<verse eid="PSA 106:47" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />!Olgeta laen* blong Isrel*!</para>
  <para style="q1" vid="PSA 106:48">!Hae God i God blong yumi!</para>
  <para style="q1" vid="PSA 106:48">!Yumi mas presem hem!</para>
  <para style="q1" vid="PSA 106:48">!Naoia yumi mas presem hem!</para>
  <para style="q1" vid="PSA 106:48">!Mo bambae yumi mas presem hem oltaem,</para>
  <para style="q2" vid="PSA 106:48">gogo i no save finis!</para>
  <para style="q1" vid="PSA 106:48">!Yufala evriwan i talem se, “Amen”!</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q1" vid="PSA 106:48">!Oltaem yumi mas presem Hae God!<verse eid="PSA 106:48" /></para>
  <para style="b" />
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">BUK FAEF</para>
  <para style="mr">(<ref loc="PSA 107-150">Sam 107—150</ref>)</para>
  <para style="s">Sing blong presem Hae God from gudfala fasin blong hem</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107.1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Kron 16.34</ref>; <ref loc="2CH 5:13">2 Kron 5.13</ref>; <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Esra 3.11</ref>; <ref loc="PSA 100:5">Sam 100.5</ref>; <ref loc="PSA 106:1">106.1</ref>; <ref loc="PSA 118:1">118.1</ref>; <ref loc="PSA 136:1">136.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char>
    </note>Olgeta.</para>
  <para style="q1" vid="PSA 107:1">!Oltaem yumi mas talem</para>
  <para style="q3" vid="PSA 107:1">tangkiu long Hae God,</para>
  <para style="q2" vid="PSA 107:1">from we hem i gud tumas!</para>
  <para style="q1" vid="PSA 107:1">!Oltaem bambae hem i lavem yumi</para>
  <para style="q2" vid="PSA 107:1">gogo i no save finis!<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Yumi evriwan ya we hem i sevem yumi,</para>
  <para style="q2" vid="PSA 107:2">i gud yumi stap taltalem tok ya long yumi oltaem</para>
  <para style="q3" vid="PSA 107:2">blong leftemap nem blong hem.</para>
  <para style="q1" vid="PSA 107:2">Fastaem yumi stap long han blong ol enemi blong yumi,</para>
  <para style="q2" vid="PSA 107:2">be hem i tekemaot yumi i mekem yumi fri.<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />Hem i tekemaot yumi long ol narafala kantri,</para>
  <para style="q2" vid="PSA 107:3">long is mo long wes mo long not mo long saot,</para>
  <para style="q3" vid="PSA 107:3">nao yumi kambak long kantri blong yumi bakegen.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />I gat sam long yumi</para>
  <para style="q2" vid="PSA 107:4">we fastaem oli stap wokbaot krangke long draeples</para>
  <para style="q3" vid="PSA 107:4">we oli no save faenem rod blong gotru long wan taon</para>
  <para style="q4" vid="PSA 107:4">we bambae oli save stap gud long hem.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Olgeta ya oli hanggri mo oli tosta,</para>
  <para style="q2" vid="PSA 107:5">nao tingting blong olgeta i foldaon olgeta.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Be taem oli stap long trabol ya,</para>
  <para style="q3" vid="PSA 107:6">oli singaot long Hae God,</para>
  <para style="q2" vid="PSA 107:6">nao hem i tekemaot olgeta</para>
  <para style="q4" vid="PSA 107:6">long trabol ya.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />Hem i lidim olgeta long wan stret rod,</para>
  <para style="q2" vid="PSA 107:7">i tekem olgeta oli go long wan taon</para>
  <para style="q3" vid="PSA 107:7">we oli save stap gud long hem.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />I gud olgeta oli talem tangkiu long Hae God</para>
  <para style="q2" vid="PSA 107:8">from fasin blong hem we oltaem hem i lavem olgeta tumas,</para>
  <para style="q3" vid="PSA 107:8">mo from ol bigbigfala samting</para>
  <para style="q4" vid="PSA 107:8">we hem i stap mekem</para>
  <para style="q3" vid="PSA 107:8">blong givhan long olgeta.<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />Hem i stap givim wota</para>
  <para style="q2" vid="PSA 107:9">long olgeta we oli tosta,</para>
  <para style="q3" vid="PSA 107:9">blong oli dring, oli harem gud,</para>
  <para style="q2" vid="PSA 107:9">mo i stap givim gudfala kakae</para>
  <para style="q3" vid="PSA 107:9">long olgeta we oli hanggri,</para>
  <para style="q4" vid="PSA 107:9">blong oli kakae, oli fulap gud.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10-11" style="v" sid="PSA 107:10-11" />God i hae we i hae,</para>
  <para style="q2" vid="PSA 107:10-11">be i gat sam long yumi</para>
  <para style="q3" vid="PSA 107:10-11">we fastaem oli girap</para>
  <para style="q4" vid="PSA 107:10-11">oli tanem baksaed long ol tok blong hem</para>
  <para style="q3" vid="PSA 107:10-11">oli agens long hem.</para>
  <para style="q1" vid="PSA 107:10-11">Nao from samting ya,</para>
  <para style="q2" vid="PSA 107:10-11">olgeta oli stap long tudak,</para>
  <para style="q4" vid="PSA 107:10-11">long laef we i nogud.</para>
  <para style="q1" vid="PSA 107:10-11">Olgeta oli stap long kalabus,</para>
  <para style="q2" vid="PSA 107:10-11">mo ol man oli fasem olgeta long jen,</para>
  <para style="q3" vid="PSA 107:10-11">nao oli stap harem nogud.<verse eid="PSA 107:10-11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Olgeta ya oli hadwok tumas</para>
  <para style="q2" vid="PSA 107:12">nao oli slak from.</para>
  <para style="q1" vid="PSA 107:12">Oli stap folfoldaon,</para>
  <para style="q2" vid="PSA 107:12">be i no gat man i givhan long olgeta.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Be taem oli stap long trabol ya,</para>
  <para style="q3" vid="PSA 107:13">oli singaot long Hae God,</para>
  <para style="q2" vid="PSA 107:13">nao hem i tekemaot olgeta</para>
  <para style="q4" vid="PSA 107:13">long trabol ya.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Hem i brebrekem ol jen blong olgeta,</para>
  <para style="q2" vid="PSA 107:14">mo i tekemaot olgeta long tudak,</para>
  <para style="q3" vid="PSA 107:14">long laef ya we i nogud.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />I gud olgeta oli talem tangkiu long Hae God</para>
  <para style="q2" vid="PSA 107:15">from fasin blong hem we oltaem hem i lavem olgeta tumas,</para>
  <para style="q3" vid="PSA 107:15">mo from ol bigbigfala samting</para>
  <para style="q4" vid="PSA 107:15">we hem i stap mekem</para>
  <para style="q3" vid="PSA 107:15">blong givhan long olgeta.<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />Hem i stap brebrekem ol doa blong kalabus</para>
  <para style="q2" vid="PSA 107:16">we ol man oli wokem long bras,</para>
  <para style="q3" vid="PSA 107:16">mo i stap smasem ol aean</para>
  <para style="q4" vid="PSA 107:16">we oli putum blong lokem olgeta.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Mo i gat sam long yumi</para>
  <para style="q2" vid="PSA 107:17">we fastaem oli no gat hed.</para>
  <para style="q1" vid="PSA 107:17">Olgeta ya oli stap mekem sin,</para>
  <para style="q3" vid="PSA 107:17">mo oli stap folem ol rabis fasin,</para>
  <para style="q2" vid="PSA 107:17">nao ol samting ya i stap mekem</para>
  <para style="q4" vid="PSA 107:17">we olgeta oli harem nogud tumas</para>
  <para style="q3" vid="PSA 107:17">long bodi blong olgeta.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Olgeta oli luk kakae</para>
  <para style="q2" vid="PSA 107:18">be oli no wantem kakae nating,</para>
  <para style="q3" vid="PSA 107:18">oli sik tumas we klosap oli ded.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Be taem oli stap long trabol ya</para>
  <para style="q3" vid="PSA 107:19">oli singaot long Hae God,</para>
  <para style="q2" vid="PSA 107:19">nao hem i tekemaot olgeta</para>
  <para style="q4" vid="PSA 107:19">long trabol ya.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />Hem i tok, nao oli kam gud bakegen.</para>
  <para style="q1" vid="PSA 107:20">Hem i sevem olgeta blong oli no ded.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />I gud olgeta oli talem tangkiu long Hae God</para>
  <para style="q2" vid="PSA 107:21">from fasin blong hem we oltaem hem i lavem olgeta tumas,</para>
  <para style="q3" vid="PSA 107:21">mo from ol bigbigfala samting</para>
  <para style="q4" vid="PSA 107:21">we hem i stap mekem</para>
  <para style="q3" vid="PSA 107:21">blong givhan long olgeta.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Oli mas mekem ol sakrefaes</para>
  <para style="q3" vid="PSA 107:22">blong talem tangkiu long hem,</para>
  <para style="q2" vid="PSA 107:22">mo oli mas glad, oli mas singsing,</para>
  <para style="q3" vid="PSA 107:22">mo oli mas talemaot olgeta samting</para>
  <para style="q3" vid="PSA 107:22">we hem i mekem.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Mo i gat sam long yumi</para>
  <para style="q2" vid="PSA 107:23">we fastaem oli stap go olbaot long solwota,</para>
  <para style="q3" vid="PSA 107:23">oli stap boskru long ol sip,</para>
  <para style="q4" vid="PSA 107:23">blong kasem mane blong oli laef long hem.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Olgeta ya oli stap luk ol samting</para>
  <para style="q3" vid="PSA 107:24">we Hae God i mekem.</para>
  <para style="q1" vid="PSA 107:24">Oli savegud ol bigbigfala wok ya blong hem</para>
  <para style="q4" vid="PSA 107:24">we hem i stap mekem long solwota.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />Taem hem i tok,</para>
  <para style="q2" vid="PSA 107:25">strong win i stat blu,</para>
  <para style="q3" vid="PSA 107:25">nao i mekem si i girap,<verse eid="PSA 107:25" /></para>
  <para style="q4">
    <verse number="26" style="v" sid="PSA 107:26" />i stap leftemap ol sip <optbreak /> oli go antap we antap olgeta,</para>
  <para style="q3" vid="PSA 107:26">mo i stap sakem olgeta</para>
  <para style="q4" vid="PSA 107:26">oli godaon we daon olgeta.</para>
  <para style="q1" vid="PSA 107:26">Samting ya i mekem</para>
  <para style="q2" vid="PSA 107:26">tingting blong ol man long sip i foldaon.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Olgeta oli stap folfoldaon olbaot,</para>
  <para style="q2" vid="PSA 107:27">mo oli stap wokbaot krangke,</para>
  <para style="q3" vid="PSA 107:27">olsem man we i drong.</para>
  <para style="q1" vid="PSA 107:27">Waes blong olgeta long solwota</para>
  <para style="q2" vid="PSA 107:27">i no save givhan long olgeta.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Be taem oli stap long trabol ya,</para>
  <para style="q3" vid="PSA 107:28">oli singaot long Hae God,</para>
  <para style="q2" vid="PSA 107:28">nao hem i tekemaot olgeta</para>
  <para style="q4" vid="PSA 107:28">long trabol ya.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />Hem i mekem strong win ya i godaon,</para>
  <para style="q2" vid="PSA 107:29">mo si i kam kwaet.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Nao ol man ya oli glad tumas</para>
  <para style="q3" vid="PSA 107:30">from we ples i kwaet,</para>
  <para style="q2" vid="PSA 107:30">mo hem i tekem olgeta oli gotru gud nomo</para>
  <para style="q4" vid="PSA 107:30">long pasis we oli wantem go long hem.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />I gud olgeta oli talem tangkiu long Hae God</para>
  <para style="q2" vid="PSA 107:31">from fasin blong hem we oltaem hem i lavem olgeta tumas,</para>
  <para style="q2" vid="PSA 107:31">mo from ol bigbigfala samting</para>
  <para style="q4" vid="PSA 107:31">we hem i stap mekem</para>
  <para style="q3" vid="PSA 107:31">blong givhan long olgeta.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />I gud olgeta oli leftemap hae nem blong hem</para>
  <para style="q3" vid="PSA 107:32">long medel blong olgeta man,</para>
  <para style="q2" vid="PSA 107:32">mo oli presem hem long fes blong ol lida blong olgeta</para>
  <para style="q4" vid="PSA 107:32">insaed long kaonsel blong olgeta.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />Oltaem Hae God i stap mekem</para>
  <para style="q3" vid="PSA 107:33">ol wota oli drae olgeta,</para>
  <para style="q2" vid="PSA 107:33">mo i stap blokem ol springwota</para>
  <para style="q4" vid="PSA 107:33">blong oli no moa ron.<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />Hem i stap mekem gudfala graon</para>
  <para style="q2" vid="PSA 107:34">i kam fulap long sol</para>
  <para style="q3" vid="PSA 107:34">we i no gat samting i save gru long hem,</para>
  <para style="q4" vid="PSA 107:34">from ol rabis fasin blong ol man</para>
  <para style="q3" vid="PSA 107:34">we oli stap long ples ya.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />Oltaem hem i stap mekem ol hol long draeples</para>
  <para style="q3" vid="PSA 107:35">i kam fulap long wota,</para>
  <para style="q2" vid="PSA 107:35">mo i stap mekem ol ples we i no gat wota</para>
  <para style="q4" vid="PSA 107:35">i kam fulap long ol springwota.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />Hem i stap letem olgeta we oli hanggri</para>
  <para style="q2" vid="PSA 107:36">oli stap long ol ples olsem,</para>
  <para style="q3" vid="PSA 107:36">mo oli mekem taon blong olgeta</para>
  <para style="q4" vid="PSA 107:36">blong oli stap long hem.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Oli stap wokem ol garen blong olgeta</para>
  <para style="q2" vid="PSA 107:37">mo oli stap planem grep,*</para>
  <para style="q3" vid="PSA 107:37">nao oli stap kasem plante kakae mo waen</para>
  <para style="q4" vid="PSA 107:37">long ol garen ya.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />Oltaem hem i stap blesem olgeta</para>
  <para style="q3" vid="PSA 107:38">nao oli gat plante pikinini,</para>
  <para style="q2" vid="PSA 107:38">mo i stap lukaot gud long ol buluk blong olgeta</para>
  <para style="q4" vid="PSA 107:38">blong namba blong olgeta i no godaon.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Ol man blong Hae God.</para>
  <para style="q1" vid="PSA 107:39">Samtaem ol man oli winim yumi long faet.</para>
  <para style="q1" vid="PSA 107:39">Olgeta oli smasem yumi,</para>
  <para style="q2" vid="PSA 107:39">nao oli mekem yumi stap daon,</para>
  <para style="q3" vid="PSA 107:39">yumi stap harem nogud</para>
  <para style="q4" vid="PSA 107:39">aninit long han blong olgeta.<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />Be oltaem, taem oli mekem olsem,</para>
  <para style="q2" vid="PSA 107:40">hem i stap soemaot</para>
  <para style="q3" vid="PSA 107:40">we hem i no laekem nating olgeta ya</para>
  <para style="q4" vid="PSA 107:40">we oli stap spolem yumi,</para>
  <para style="q3" vid="PSA 107:40">hem i stap mekem</para>
  <para style="q4" vid="PSA 107:40">we olgeta oli stap wokbaot krangke long draeples</para>
  <para style="q3" vid="PSA 107:40">we i no gat rod long hem.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Yumi pua tumas,</para>
  <para style="q2" vid="PSA 107:41">be hem i stap tekemaot yumi</para>
  <para style="q4" vid="PSA 107:41">long ol trabol blong yumi,</para>
  <para style="q3" vid="PSA 107:41">nao hem i stap mekem ol pikinini blong yumi</para>
  <para style="q3" vid="PSA 107:41">oli kam plante we plante.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Taem ol stret man oli luk ol samting ya,</para>
  <para style="q3" vid="PSA 107:42">oli glad tumas,</para>
  <para style="q2" vid="PSA 107:42">be taem ol man nogud oli luk,</para>
  <para style="q4" vid="PSA 107:42">olgeta evriwan oli no save tok.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />I gud olgeta we oli waes</para>
  <para style="q3" vid="PSA 107:43">oli stap tingbaot ol samting ya,</para>
  <para style="q2" vid="PSA 107:43">i gud oli luksave fasin blong Hae God</para>
  <para style="q3" vid="PSA 107:43">we oltaem hem i lavem man tumas.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">Prea we man i mekem blong God i givhan long ol man blong hem</para>
  <para style="r">(<ref loc="PSA 57:7-11">Sam 57.7-11</ref>; <ref loc="PSA 60:5-12">60.5-12</ref>)</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />God.</para>
  <para style="q1" vid="PSA 108:1">!Oltaem tingting blong mi i stap strong long yu!</para>
  <para style="q1" vid="PSA 108:1">!Bambae mi sing, mi presem yu!</para>
  <para style="q1" vid="PSA 108:1">!Naoia mi mi mas wekap!<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />!Gita mo mandolin blong mi,</para>
  <para style="q3" vid="PSA 108:2">tufala i mas wekap!</para>
  <para style="q1" vid="PSA 108:2">!Bambae mi wekemap san ya!<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Hae God.</para>
  <para style="q1" vid="PSA 108:3">Bambae mi mi talem tangkiu long yu</para>
  <para style="q3" vid="PSA 108:3">long fes blong olgeta man,</para>
  <para style="q2" vid="PSA 108:3">bambae mi sing blong presem yu</para>
  <para style="q4" vid="PSA 108:3">long fes blong ol man blong ol narafala kantri.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Fasin blong yu</para>
  <para style="q3" vid="PSA 108:4">we oltaem yu lavem man</para>
  <para style="q2" vid="PSA 108:4">i hae we i hae,</para>
  <para style="q4" vid="PSA 108:4">i go bitim skae antap.</para>
  <para style="q1" vid="PSA 108:4">Fasin blong yu</para>
  <para style="q3" vid="PSA 108:4">we oltaem yu stap holem ol promes blong yu,</para>
  <para style="q2" vid="PSA 108:4">hem i hae we i hae,</para>
  <para style="q4" vid="PSA 108:4">i go antap i kasem ol klaod.<verse eid="PSA 108:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />God.</para>
  <para style="q1" vid="PSA 108:5">Mi mi wantem tumas</para>
  <para style="q2" vid="PSA 108:5">blong yu yu soemaot</para>
  <para style="q3" vid="PSA 108:5">we yu hae we yu hae</para>
  <para style="q3" vid="PSA 108:5">i bitim skae,</para>
  <para style="q4" vid="PSA 108:5">mo we bigfala paoa blong yu <optbreak /> i kasem olgeta ples long wol.<note caller="+" style="f"><char style="fr" closed="false">108.5: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">Mi mi wantem tumas <char style="bd">blong ol man oli leftemap nem blong yu i go antap i winim skae, mo blong yu bambae yu soemaot</char> </char><char style="fqa" closed="false">bigfala paoa blong yu <char style="bd">long</char> </char><char style="fqa" closed="false">olgeta ples long wol.</char></note><verse eid="PSA 108:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Yu yu lavem mifala tumas.</para>
  <para style="q1" vid="PSA 108:6">Plis yu sevem mifala</para>
  <para style="q3" vid="PSA 108:6">long paoa blong yu,</para>
  <para style="q2" vid="PSA 108:6">yu ansa long prea blong mi,</para>
  <para style="q4" vid="PSA 108:6">blong mifala i save stap gud.<verse eid="PSA 108:6" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Olgeta.</para>
  <para style="q1" vid="PSA 108:7">God i stap long tabu ples blong hem,</para>
  <para style="q2" vid="PSA 108:7">i talem se, “Bambae mi mi win,</para>
  <para style="q3" vid="PSA 108:7">nao mi seraot ples ya Sekem</para>
  <para style="q3" vid="PSA 108:7">i go long ol man blong mi,</para>
  <para style="q4" vid="PSA 108:7">mo bambae mi makemaot ol haf</para>
  <para style="q3" vid="PSA 108:7">blong bigfala levelples ya Sukot <optbreak /> i go long olgeta.<verse eid="PSA 108:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 108:8" />Ples ya Gilead i blong mi</para>
  <para style="q4" vid="PSA 108:8">mo ples ya Manase* tu i blong mi.</para>
  <para style="q2" vid="PSA 108:8">Ples ya Efrem* i olsem hat blong faet blong mi,</para>
  <para style="q3" vid="PSA 108:8">mo ples ya Juda* i olsem wokingstik blong mi</para>
  <para style="q3" vid="PSA 108:8">we mi mi King.<verse eid="PSA 108:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 108:9" />Be bambae mi yusum kantri ya Moab</para>
  <para style="q3" vid="PSA 108:9">olsem besin blong wasem fes blong mi,</para>
  <para style="q4" vid="PSA 108:9">mo bambae mi sakem sus blong mi</para>
  <para style="q3" vid="PSA 108:9">i go stap long kantri ya Edom <optbreak /> olsem saen we ples ya i blong mi.</para>
  <para style="q2" vid="PSA 108:9">Bambae mi mi winim ol man Filistia,</para>
  <para style="q3" vid="PSA 108:9">nao bambae mi singsingaot from.”<verse eid="PSA 108:9" /></para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />God.</para>
  <para style="q2" vid="PSA 108:10">?Hu nao bambae i lidim mifala</para>
  <para style="q3" vid="PSA 108:10">i go long kantri ya Edom?</para>
  <para style="q2" vid="PSA 108:10">?Hu nao bambae i tekem mifala i go insaed</para>
  <para style="q3" vid="PSA 108:10">long taon ya blong olgeta</para>
  <para style="q4" vid="PSA 108:10">we i strong tumas?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />?Olsem wanem?</para>
  <para style="q2" vid="PSA 108:11">?I tru we yu yu lego mifala finis?</para>
  <para style="q1" vid="PSA 108:11">?Bambae yu no moa go</para>
  <para style="q2" vid="PSA 108:11">wetem ol soldia blong mifala bakegen long faet?<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Plis yu halpem mifala,</para>
  <para style="q3" vid="PSA 108:12">yu agensem ol enemi blong mifala,</para>
  <para style="q2" vid="PSA 108:12">from we ol samting</para>
  <para style="q3" vid="PSA 108:12">we ol man nomo oli save mekem</para>
  <para style="q4" vid="PSA 108:12">blong givhan long mifala</para>
  <para style="q3" vid="PSA 108:12">i blong nating nomo.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />God,</para>
  <para style="q2" vid="PSA 108:13">sipos yu yu stap wetem mifala,</para>
  <para style="q3" vid="PSA 108:13">bambae mifala i win,</para>
  <para style="q2" vid="PSA 108:13">from we yu bambae yu winim ol enemi blong mifala.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">Prea blong man we i stap long trabol</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />God.</para>
  <para style="q1" vid="PSA 109:1">!Oltaem mi mi stap presem yu!</para>
  <para style="q1" vid="PSA 109:1">!Plis yu no stap kwaet!<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />Ol man nogud mo ol man blong giaman</para>
  <para style="q2" vid="PSA 109:2">oli girap oli tok agens long mi.</para>
  <para style="q1" vid="PSA 109:2">Oli stap mekem ol giaman toktok</para>
  <para style="q3" vid="PSA 109:2">blong spolem mi,<verse eid="PSA 109:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 109:3" />mo oli stap talem ol rabis tok</para>
  <para style="q4" vid="PSA 109:3">blong spolem nem blong mi.</para>
  <para style="q1" vid="PSA 109:3">Olgeta oli stap spolem mi,</para>
  <para style="q2" vid="PSA 109:3">be blong nating nomo.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Nating we mi mi lavem olgeta</para>
  <para style="q3" vid="PSA 109:4">mo mi stap prea from olgeta,</para>
  <para style="q2" vid="PSA 109:4">be olgeta oli stap agens long mi tumas.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Mi mi stap mekem i gud long olgeta,</para>
  <para style="q2" vid="PSA 109:5">be olgeta oli stap mekem i nogud long mi.</para>
  <para style="q1" vid="PSA 109:5">Mi mi lavem olgeta tumas,</para>
  <para style="q2" vid="PSA 109:5">be olgeta oli no lavem mi nating,</para>
  <para style="q3" vid="PSA 109:5">oli agens long mi.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Plis yu jusumaot wan rabis jaj</para>
  <para style="q3" vid="PSA 109:6">blong i jajem enemi ya blong mi,</para>
  <para style="q2" vid="PSA 109:6">yu letem wan enemi blong hem nomo</para>
  <para style="q4" vid="PSA 109:6">i jajem hem.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />!I gud jaj ya i traem hem,</para>
  <para style="q2" vid="PSA 109:7">i faenemaot we hem i mekem ol samting nogud!</para>
  <para style="q1" vid="PSA 109:7">!Mo i gud i jajem prea blong hem tu,</para>
  <para style="q2" vid="PSA 109:7">se i no stret!<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109.8: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Wok 1.20</ref>
      </char>
    </note>!I gud laef blong hem i finis kwiktaem!</para>
  <para style="q1" vid="PSA 109:8">!I gud narafala man i kam,</para>
  <para style="q2" vid="PSA 109:8">i tekem ples blong hem,</para>
  <para style="q3" vid="PSA 109:8">i holem wok blong hem!<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />!I gud ol pikinini blong hem</para>
  <para style="q2" vid="PSA 109:9">oli stap we oli no gat papa!</para>
  <para style="q1" vid="PSA 109:9">!Mo i gud woman blong hem tu</para>
  <para style="q2" vid="PSA 109:9">i stap we i wido nomo!<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />!I gud ol haos blong ol pikinini ya blong hem</para>
  <para style="q2" vid="PSA 109:10">oli kam nogud olgeta,</para>
  <para style="q3" vid="PSA 109:10">nao ol man oli ronemaot olgeta!</para>
  <para style="q1" vid="PSA 109:10">!I gud ol pikinini ya blong hem</para>
  <para style="q2" vid="PSA 109:10">oli no moa gat ples blong olgeta,</para>
  <para style="q3" vid="PSA 109:10">nao oli stap asaskem kakae olbaot!<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />!I gud ol man we hem i kaon long olgeta</para>
  <para style="q2" vid="PSA 109:11">oli kam holem olting blong hem!</para>
  <para style="q1" vid="PSA 109:11">!Mo i gud ol strenja oli kam karemaot</para>
  <para style="q2" vid="PSA 109:11">evri samting we hem i bin wok from!<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />!I gud ol man oli no kaen long hem!</para>
  <para style="q1" vid="PSA 109:12">!Mo sipos hem i ded,</para>
  <para style="q2" vid="PSA 109:12">i gud ol man oli no givhan</para>
  <para style="q3" vid="PSA 109:12">long ol pikinini blong hem!<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />!I gud hem wetem olgeta</para>
  <para style="q3" vid="PSA 109:13">we bambae oli kamaot biaen long hem</para>
  <para style="q2" vid="PSA 109:13">oli lus evriwan!</para>
  <para style="q1" vid="PSA 109:13">!I gud ol man we oli stap biaen long hem</para>
  <para style="q2" vid="PSA 109:13">oli no moa save tingbaot nem blong hem bakegen!<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14-15" style="v" sid="PSA 109:14-15" />Hae God.</para>
  <para style="q1" vid="PSA 109:14-15">!Plis yu no fogetem ol fasin nogud</para>
  <para style="q2" vid="PSA 109:14-15">blong ol bubu blong hem!</para>
  <para style="q1" vid="PSA 109:14-15">!Plis yu no tekemaot ol sin blong mama blong hem samtaem!</para>
  <para style="q1" vid="PSA 109:14-15">!Plis yu stap tingbaot ol sin blong olgeta oltaem,</para>
  <para style="q2" vid="PSA 109:14-15">gogo i no save finis!</para>
  <para style="q1" vid="PSA 109:14-15">!Be olgeta,</para>
  <para style="q2" vid="PSA 109:14-15">yu mekem we ol man oli fogetemgud olgeta!<verse eid="PSA 109:14-15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Man ya,</para>
  <para style="q2" vid="PSA 109:16">neva hem i tingbaot samtaem</para>
  <para style="q3" vid="PSA 109:16">blong i kaen long man.</para>
  <para style="q1" vid="PSA 109:16">Oltaem hem i stap ronem ol puaman,</para>
  <para style="q2" vid="PSA 109:16">mo ol man we oli sot long ol samting,</para>
  <para style="q3" vid="PSA 109:16">mo ol man we oli no gat paoa,</para>
  <para style="q2" vid="PSA 109:16">i stap kilim olgeta oli ded.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />Hem i laekem tumas</para>
  <para style="q2" vid="PSA 109:17">blong singaot trabol i kam long man.</para>
  <para style="q1" vid="PSA 109:17">!Plis yu letem ol trabol ya</para>
  <para style="q2" vid="PSA 109:17">oli kam kasem hem bakegen!</para>
  <para style="q1" vid="PSA 109:17">Hem i no laekem nating blong blesem ol man.</para>
  <para style="q1" vid="PSA 109:17">!Plis yu no letem man i blesem hem!<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Fasin ya blong singaot trabol i kam long man,</para>
  <para style="q2" vid="PSA 109:18">hem i kam olsem klos blong hem finis.</para>
  <para style="q1" vid="PSA 109:18">!Plis yu letem ol trabol ya</para>
  <para style="q2" vid="PSA 109:18">oli kam kakae hem bakegen</para>
  <para style="q3" vid="PSA 109:18">we oli spolemgud hem!<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Plis yu letem ol trabol ya</para>
  <para style="q2" vid="PSA 109:19">oli stap oltaem long hem,</para>
  <para style="q3" vid="PSA 109:19">olsem klos blong hem wetem strap blong hem</para>
  <para style="q4" vid="PSA 109:19">we hem i stap putum evri dei.<verse eid="PSA 109:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Hae God.</para>
  <para style="q1" vid="PSA 109:20">Hemia nao fasin ya we mi wantem</para>
  <para style="q2" vid="PSA 109:20">blong yu mekem long ol man ya.</para>
  <para style="q1" vid="PSA 109:20">Olgeta ya oli stap talem</para>
  <para style="q2" vid="PSA 109:20">ol rabis samting agens long mi.</para>
  <para style="q1" vid="PSA 109:20">!Plis yu panisim olgeta!<verse eid="PSA 109:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />!Hae God, yu yu Masta blong mi!</para>
  <para style="q1" vid="PSA 109:21">Plis yu givhan long mi olsem we yu yu promes.</para>
  <para style="q1" vid="PSA 109:21">Fasin blong yu blong lavem man i gud tumas,</para>
  <para style="q2" vid="PSA 109:21">plis yu sevem mi.<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Mi mi puaman, mi no gat samting,</para>
  <para style="q2" vid="PSA 109:22">mo tingting blong mi i kam nogud we i nogud.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Mi mi olsem sado long sapa,</para>
  <para style="q2" vid="PSA 109:23">we klosap i lus.</para>
  <para style="q1" vid="PSA 109:23">Mi olsem nambembe,</para>
  <para style="q2" vid="PSA 109:23">we win i blu long hem,</para>
  <para style="q3" vid="PSA 109:23">i karem i go.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />Oltaem mi stap livim kakae blong mi</para>
  <para style="q3" vid="PSA 109:24">blong mekem prea long yu,</para>
  <para style="q2" vid="PSA 109:24">nao mi kam bunbun olgeta,</para>
  <para style="q4" vid="PSA 109:24">mo leg blong mi i no moa strong.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109.25: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:39">Mat 27.39</ref>; <ref loc="MRK 15:29">Mak 15.29</ref></char>
    </note>Taem ol man oli luk mi,</para>
  <para style="q2" vid="PSA 109:25">oli stap jikim mi,</para>
  <para style="q3" vid="PSA 109:25">oli stap saksakem hed blong olgeta,</para>
  <para style="q4" vid="PSA 109:25">oli stap laf long mi.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Hae God, yu yu God blong mi.</para>
  <para style="q1" vid="PSA 109:26">Plis yu givhan long mi.</para>
  <para style="q1" vid="PSA 109:26">Oltaem yu yu lavem mi tumas,</para>
  <para style="q2" vid="PSA 109:26">plis yu sevem mi.<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Plis yu mekem</para>
  <para style="q2" vid="PSA 109:27">ol enemi blong mi oli save</para>
  <para style="q3" vid="PSA 109:27">we yu nao yu stap sevem mi.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Olgeta ya oli save singaot trabol i kam long mi,</para>
  <para style="q2" vid="PSA 109:28">be yu bambae yu blesem mi.</para>
  <para style="q1" vid="PSA 109:28">Plis yu mekem</para>
  <para style="q2" vid="PSA 109:28">olgeta ya we oli stap ronem mi</para>
  <para style="q3" vid="PSA 109:28">oli sem.</para>
  <para style="q1" vid="PSA 109:28">Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 109:28">plis yu mekem mi mi glad.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Plis yu mekem</para>
  <para style="q2" vid="PSA 109:29">ol enemi ya blong mi oli sem bigwan</para>
  <para style="q3" vid="PSA 109:29">we ol man bambae oli stap tokbaot olgeta from,</para>
  <para style="q4" vid="PSA 109:29">mo we sem ya bambae i no save lus long olgeta samtaem.<verse eid="PSA 109:29" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Olgeta.</para>
  <para style="q1" vid="PSA 109:30">Bambae mi singaot bigwan,</para>
  <para style="q3" vid="PSA 109:30">mi talem tangkiu tumas long Hae God.</para>
  <para style="q1" vid="PSA 109:30">Bambae mi presem hem</para>
  <para style="q3" vid="PSA 109:30">long fes blong olgeta man,<verse eid="PSA 109:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="PSA 109:31" />from we taem ol man</para>
  <para style="q4" vid="PSA 109:31">oli stap jajem ol puaman <optbreak /> se oli mas ded,</para>
  <para style="q3" vid="PSA 109:31">be hem i stap lukaot gud long olgeta,</para>
  <para style="q4" vid="PSA 109:31">i stap sevem olgeta.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">King we Hae God i jusumaot</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long king.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110.1: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:44">Mat 22.44</ref>; <ref loc="MRK 12:36">Mak 12.36</ref>; <ref loc="LUK 20:42">Luk 20.42</ref>,<ref loc="LUK 20:43">43</ref>; <ref loc="ACT 2:34">Wok 2.34</ref>,<ref loc="ACT 2:35">35</ref>; <ref loc="1CO 15:25">1 Kor 15.25</ref>; <ref loc="EPH 1:20-22">Efes 1.20-22</ref>; <ref loc="COL 3:1">Kol 3.1</ref>; <ref loc="HEB 1:13">Hib 1.13</ref>; <ref loc="HEB 8:1">8.1</ref>; <ref loc="HEB 10:12">10.12</ref>,<ref loc="HEB 10:13">13</ref></char>
    </note>King.</para>
  <para style="q1" vid="PSA 110:1">Yu yu Masta blong mi.</para>
  <para style="q1" vid="PSA 110:1">Hae God i talem long yu se,</para>
  <para style="q2" vid="PSA 110:1">“King.</para>
  <para style="q2" vid="PSA 110:1">Yu sidaon long raet saed blong mi,</para>
  <para style="q3" vid="PSA 110:1">yu wet.</para>
  <para style="q2" vid="PSA 110:1">Bambae mi mekem ol enemi blong yu</para>
  <para style="q2" vid="PSA 110:1">oli stap aninit long paoa blong yu,</para>
  <para style="q4" vid="PSA 110:1">oli slef* blong yu.”<verse eid="PSA 110:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />Hae God i stap long Saeon,*</para>
  <para style="q2" vid="PSA 110:2">mo hem bambae i mekem</para>
  <para style="q3" vid="PSA 110:2">paoa blong yu i kam bigwan moa.</para>
  <para style="q1" vid="PSA 110:2">Hem i talem se,</para>
  <para style="q2" vid="PSA 110:2">“Yu bambae yu rulum ol enemi blong yu.”<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Long dei ya we bambae yu go faet</para>
  <para style="q3" vid="PSA 110:3">long ol enemi blong yu,</para>
  <para style="q2" vid="PSA 110:3">ol man blong yu bambae oli glad</para>
  <para style="q4" vid="PSA 110:3">blong kam joen long yu.</para>
  <para style="q1" vid="PSA 110:3">Olsem we wota blong naet</para>
  <para style="q3" vid="PSA 110:3">i stap mekem gras i gru gud,</para>
  <para style="q2" vid="PSA 110:3">long sem fasin,</para>
  <para style="q3" vid="PSA 110:3">yu bambae yu kasem ol nambawan man blong faet</para>
  <para style="q4" vid="PSA 110:3">oli kam joen long yu long ol hil ya we oli tabu.<verse eid="PSA 110:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110.4: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 5:6">Hib 5.6</ref>; <ref loc="HEB 6:20">6.20</ref>; <ref loc="HEB 7:17">7.17</ref>,<ref loc="HEB 7:21">21</ref></char>
    </note>Hae God i bin mekem wan strong promes* long yu,</para>
  <para style="q2" vid="PSA 110:4">mo bambae hem i no save jenisim tingting blong hem.</para>
  <para style="q1" vid="PSA 110:4">Hem i talem se, “Yu yu pris*</para>
  <para style="q4" vid="PSA 110:4">olsem pris ya Melkisedek bifo,</para>
  <para style="q3" vid="PSA 110:4">mo bambae yu holem wok blong pris oltaem</para>
  <para style="q3" vid="PSA 110:4">gogo i no save finis.”<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />King.</para>
  <para style="q2" vid="PSA 110:5">Masta* blong yumi i stap long raet saed blong yu,</para>
  <para style="q3" vid="PSA 110:5">mo taem hem i kros,</para>
  <para style="q4" vid="PSA 110:5">bambae hem i save daonem ol narafala king.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Hem bambae i jajem</para>
  <para style="q3" vid="PSA 110:6">ol man blong ol narafala kantri,</para>
  <para style="q2" vid="PSA 110:6">mo bambae i mekem ples blong faet</para>
  <para style="q4" vid="PSA 110:6">i kam fulap long ol dedman.</para>
  <para style="q1" vid="PSA 110:6">Hem bambae i daonem ol king</para>
  <para style="q2" vid="PSA 110:6">long olgeta ples long wol.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Yu bambae yu dring</para>
  <para style="q3" vid="PSA 110:7">long smol wota ya klosap long rod,</para>
  <para style="q2" vid="PSA 110:7">nao bambae yu yu strong,</para>
  <para style="q4" vid="PSA 110:7">gogo yu win.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Olgeta.</para>
  <para style="q1" vid="PSA 111:1">!Yumi presem Hae God!</para>
  <para style="b" vid="PSA 111:1" />
  <para style="q1" vid="PSA 111:1">Bambae mi mi stanap</para>
  <para style="q3" vid="PSA 111:1">long fes blong olgeta man blong hem,</para>
  <para style="q2" vid="PSA 111:1">mi talem tangkiu long hem</para>
  <para style="q4" vid="PSA 111:1">long olgeta tingting blong mi.<verse eid="PSA 111:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Olgeta samting we hem i mekem</para>
  <para style="q3" vid="PSA 111:2">oli gud tumas,</para>
  <para style="q2" vid="PSA 111:2">mo olgeta man we oli glad long ol samting ya,</para>
  <para style="q4" vid="PSA 111:2">oli wantem tumas blong savegud olgeta.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Olgeta samting we hem i mekem</para>
  <para style="q3" vid="PSA 111:3">oli stap leftemap hae nem blong hem,</para>
  <para style="q2" vid="PSA 111:3">mo oli stap soemaot paoa blong hem</para>
  <para style="q4" vid="PSA 111:3">we hem i King.</para>
  <para style="q1" vid="PSA 111:3">Stret fasin blong hem bambae i stap oltaem,</para>
  <para style="q2" vid="PSA 111:3">gogo i no save finis.<verse eid="PSA 111:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />Oltaem hem i stap mekem</para>
  <para style="q2" vid="PSA 111:4">we yumi stap tingbaot</para>
  <para style="q3" vid="PSA 111:4">ol bigbigfala wok blong hem.</para>
  <para style="q1" vid="PSA 111:4">Hem i kaen tumas,</para>
  <para style="q2" vid="PSA 111:4">mo hem i gat sore long man.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 111:5">mo neva bambae hem i fogetem promes* ya</para>
  <para style="q3" vid="PSA 111:5">we hem i mekem wetem yumi.</para>
  <para style="q1" vid="PSA 111:5">Oltaem hem i stap givim kakae long olgeta</para>
  <para style="q2" vid="PSA 111:5">we oli stap ona long hem.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Mo hem i soemaot paoa blong hem long yumi</para>
  <para style="q2" vid="PSA 111:6">long fasin ya we hem i givim kantri ya long yumi</para>
  <para style="q3" vid="PSA 111:6">we fastaem i ples blong ol narafala man.<verse eid="PSA 111:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Olgeta samting we hem i mekem</para>
  <para style="q2" vid="PSA 111:7">i soemaot we hem i stap holem promes blong hem,</para>
  <para style="q3" vid="PSA 111:7">mo i stap jajem man long stret fasin.</para>
  <para style="q1" vid="PSA 111:7">Olgeta tok we hem i putum,</para>
  <para style="q2" vid="PSA 111:7">yumi save trastem olgeta.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Hem i putum olgeta</para>
  <para style="q3" vid="PSA 111:8">long fasin we i tru mo i stret,</para>
  <para style="q2" vid="PSA 111:8">mo bambae oli stap oltaem nomo,</para>
  <para style="q4" vid="PSA 111:8">gogo i no save finis.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />Yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 111:9">mo hem i mekem yumi fri.</para>
  <para style="q1" vid="PSA 111:9">Hem i mekem wan promes wetem yumi</para>
  <para style="q3" vid="PSA 111:9">we bambae i no save finis.</para>
  <para style="q1" vid="PSA 111:9">!Nem blong hem i tabu,</para>
  <para style="q2" vid="PSA 111:9">mo hem i gat olgeta paoa!<verse eid="PSA 111:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111.10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Job 28.28</ref>; <ref loc="PRO 1:7">Prov 1.7</ref>; <ref loc="PRO 9:10">9.10</ref></char>
    </note>Man we i wantem kam waes,</para>
  <para style="q2" vid="PSA 111:10">nambawan samting blong hem i mekem,</para>
  <para style="q3" vid="PSA 111:10">hem i mas tinghevi long Hae God,</para>
  <para style="q4" vid="PSA 111:10">mo i mas ona gud long hem.</para>
  <para style="q1" vid="PSA 111:10">Hae God i stap givim gudfala tingting</para>
  <para style="q2" vid="PSA 111:10">long olgeta we oli stap obei</para>
  <para style="q4" vid="PSA 111:10">long ol tok blong hem,</para>
  <para style="q3" vid="PSA 111:10">blong oli save skelemgud</para>
  <para style="q3" vid="PSA 111:10">evri samting long laef blong man.</para>
  <para style="b" vid="PSA 111:10" />
  <para style="q1" vid="PSA 111:10">!Oltaem bambae yumi presem hem,</para>
  <para style="q2" vid="PSA 111:10">gogo i no save finis!<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">Gudfala man i save harem gud</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Olgeta.</para>
  <para style="q1" vid="PSA 112:1">!Yumi presem Hae God!</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q1" vid="PSA 112:1">Man we i stap ona long hem,</para>
  <para style="q2" vid="PSA 112:1">mo we i glad blong obei long ol tok blong hem,</para>
  <para style="q3" vid="PSA 112:1">hem i save harem gud.<verse eid="PSA 112:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Ol pikinini blong hem</para>
  <para style="q3" vid="PSA 112:2">bambae oli gat paoa long kantri blong olgeta,</para>
  <para style="q2" vid="PSA 112:2">mo olgeta we bambae oli kamaot biaen long hem,</para>
  <para style="q4" vid="PSA 112:2">Hae God bambae i blesem olgeta.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Ol pikinini ya blong hem</para>
  <para style="q3" vid="PSA 112:3">bambae oli rij,</para>
  <para style="q3" vid="PSA 112:3">oli gat plante samting,</para>
  <para style="q2" vid="PSA 112:3">mo gudfala fasin blong hem</para>
  <para style="q4" vid="PSA 112:3">neva bambae i foldaon.<verse eid="PSA 112:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />Man we i stap folem ol gudfala fasin,</para>
  <para style="q2" vid="PSA 112:4">we i gat sore long man,</para>
  <para style="q3" vid="PSA 112:4">mo i kaen long man,</para>
  <para style="q4" vid="PSA 112:4">mo i stap mekem i stret,</para>
  <para style="q2" vid="PSA 112:4">hem i olsem laet we i saen long tudak.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Man we i stap wokem bisnes blong hem</para>
  <para style="q3" vid="PSA 112:5">long rod we i stret,</para>
  <para style="q2" vid="PSA 112:5">mo i stap givim lon long plante narafala man,</para>
  <para style="q3" vid="PSA 112:5">hem i save harem gud.<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Gudfala man olsem,</para>
  <para style="q2" vid="PSA 112:6">neva bambae laef blong hem i foldaon.</para>
  <para style="q1" vid="PSA 112:6">Oltaem ol man bambae oli stap tingbaot</para>
  <para style="q2" vid="PSA 112:6">gudfala fasin blong hem.<verse eid="PSA 112:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Man olsem,</para>
  <para style="q2" vid="PSA 112:7">hem i no save fraet</para>
  <para style="q3" vid="PSA 112:7">se badnius bambae i kasem hem,</para>
  <para style="q2" vid="PSA 112:7">from we hem i stap trastem Hae God,</para>
  <para style="q3" vid="PSA 112:7">mo oltaem bilif blong hem</para>
  <para style="q4" vid="PSA 112:7">i stap strong long hem.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Hem i no save wari,</para>
  <para style="q2" vid="PSA 112:8">mo i no save fraet.</para>
  <para style="q1" vid="PSA 112:8">Hem i savegud we bambae hem i luk</para>
  <para style="q2" vid="PSA 112:8">we Hae God bambae i winim ol enemi blong hem.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112.9: </char>
      <char style="xt" closed="false">
        <ref loc="2CO 9:9">2 Kor 9.9</ref>
      </char>
    </note>Man olsem,</para>
  <para style="q3" vid="PSA 112:9">hem i stap givhan gud long ol puaman,</para>
  <para style="q3" vid="PSA 112:9">long gladhat blong hem,</para>
  <para style="q2" vid="PSA 112:9">mo gudfala fasin blong hem</para>
  <para style="q4" vid="PSA 112:9">neva bambae i foldaon.</para>
  <para style="q1" vid="PSA 112:9">Hem bambae i gat paoa,</para>
  <para style="q2" vid="PSA 112:9">mo ol man bambae oli ona long hem.<verse eid="PSA 112:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Be taem ol man nogud oli luk fasin ya</para>
  <para style="q2" vid="PSA 112:10">oli kros tumas.</para>
  <para style="q1" vid="PSA 112:10">Oli stap lukluk nogud long man olsem,</para>
  <para style="q2" vid="PSA 112:10">nao oli go lus.</para>
  <para style="q1" vid="PSA 112:10">Ol man nogud oli no save kasem ol samting</para>
  <para style="q2" vid="PSA 112:10">we tingting blong olgeta i stap long hem.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">Sing blong presem Hae God from gudfala fasin blong hem</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Olgeta.</para>
  <para style="q1" vid="PSA 113:1">!Yumi presem Hae God!</para>
  <para style="b" vid="PSA 113:1" />
  <para style="q1" vid="PSA 113:1">Yumi ol man blong wok blong hem,</para>
  <para style="q2" vid="PSA 113:1">yumi mas presem nem blong hem.<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Bambae yumi presem nem blong hem oltaem,</para>
  <para style="q2" vid="PSA 113:2">i stat naoia, gogo i no save finis.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Yumi evriwan,</para>
  <para style="q2" vid="PSA 113:3">i stat long is,</para>
  <para style="q3" vid="PSA 113:3">i go kasem long wes,</para>
  <para style="q2" vid="PSA 113:3">yumi presem nem blong Hae God.<note caller="+" style="f"><char style="fr" closed="false">113.3: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">Yumi evriwan <char style="bd">i mas</char> </char><char style="fqa" closed="false">presem nem blong Hae God, i stat long taem we san i kam antap, gogo kasem we hem i godaon bakegen.</char></note><verse eid="PSA 113:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />Hem nomo i stap rulum olgeta man</para>
  <para style="q2" vid="PSA 113:4">long evri ples.</para>
  <para style="q1" vid="PSA 113:4">Nem blong hem i hae we i hae,</para>
  <para style="q2" vid="PSA 113:4">i bitim skae antap.<verse eid="PSA 113:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 113:5">mo i no gat man we i olsem hem.</para>
  <para style="q1" vid="PSA 113:5">Hem i King,</para>
  <para style="q2" vid="PSA 113:5">i stap sidaon long bigfala jea blong hem</para>
  <para style="q3" vid="PSA 113:5">long ples blong hem antap,<verse eid="PSA 113:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 113:6" />be hem i glad blong lukluk i kamdaon</para>
  <para style="q3" vid="PSA 113:6">long skae mo graon.<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />Hem i stap leftemap ol puaman,</para>
  <para style="q2" vid="PSA 113:7">i stap tekemaot olgeta</para>
  <para style="q3" vid="PSA 113:7">long ol trabol blong olgeta.<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />Hem i stap mekem olgeta</para>
  <para style="q2" vid="PSA 113:8">oli joen wetem ol pikinini blong king,</para>
  <para style="q3" vid="PSA 113:8">we oli haeman blong ol man blong hem.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Hem i stap mekem ol woman</para>
  <para style="q2" vid="PSA 113:9">we oli no save karem pikinini</para>
  <para style="q3" vid="PSA 113:9">oli stap long hom blong olgeta,</para>
  <para style="q4" vid="PSA 113:9">oli glad.</para>
  <para style="q1" vid="PSA 113:9">Hem i stap mekem olgeta</para>
  <para style="q2" vid="PSA 113:9">oli karem pikinini,</para>
  <para style="q3" vid="PSA 113:9">nao oli glad tumas from.</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q1" vid="PSA 113:9">!Oltaem yumi mas presem Hae God!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">Sing blong Lafet blong Pasova</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 114:1-2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114.1-2: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:51">Eks 12.51</ref>
      </char>
    </note>Yumi ya,</para>
  <para style="q3" vid="PSA 114:1-2">we yumi ol man Juda,*</para>
  <para style="q2" vid="PSA 114:1-2">yumi ol laen* blong Isrel,*</para>
  <para style="q4" vid="PSA 114:1-2">we narafala nem blong hem Jekob.*</para>
  <para style="q1" vid="PSA 114:1-2">Be taem yumi aot long Ijip,</para>
  <para style="q3" vid="PSA 114:1-2">ples ya we i no ples blong yumi,</para>
  <para style="q2" vid="PSA 114:1-2">God i mekem yumi kam tabu,</para>
  <para style="q3" vid="PSA 114:1-2">yumi man blong hem nomo,</para>
  <para style="q4" vid="PSA 114:1-2">we hem nomo i God blong yumi.<verse eid="PSA 114:1-2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114.3 a: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Eks 14.21</ref>; </char>
      <char style="xo" closed="false">b: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 3:16">Jos 3.16</ref>
      </char>
    </note>Red Si i lukluk, nao i ronwe,</para>
  <para style="q2" vid="PSA 114:3">mo Jodan Reva tu, hem i no moa ron.<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />Ol bigbigfala hil wetem ol smosmol hil</para>
  <para style="q2" vid="PSA 114:4">oli fraet, oli stap seksek,</para>
  <para style="q3" vid="PSA 114:4">oli olsem ol sipsip wetem ol pikinini blong olgeta</para>
  <para style="q4" vid="PSA 114:4">we oli fraet,</para>
  <para style="q3" vid="PSA 114:4">oli stap resis olbaot.<verse eid="PSA 114:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Red Si.</para>
  <para style="q1" vid="PSA 114:5">?Wanem nao i mekem yu yu ronwe?</para>
  <para style="q1" vid="PSA 114:5">Jodan Reva.</para>
  <para style="q1" vid="PSA 114:5">?From wanem yu no moa ron?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />!Ol bigbigfala hil wetem ol smosmol hil!</para>
  <para style="q1" vid="PSA 114:6">?From wanem yufala i fraet,</para>
  <para style="q2" vid="PSA 114:6">yufala i seksek olsem?</para>
  <para style="q1" vid="PSA 114:6">Yufala i olsem ol sipsip wetem ol pikinini blong olgeta</para>
  <para style="q2" vid="PSA 114:6">we oli fraet,</para>
  <para style="q3" vid="PSA 114:6">oli stap resis olbaot.<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7-8" style="v" sid="PSA 114:7-8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114.7-8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-7">Eks 17.1-7</ref>; <ref loc="NUM 20:2-13">Nam 20.2-13</ref></char>
    </note>Graon.</para>
  <para style="q1" vid="PSA 114:7-8">!God blong Jekob,</para>
  <para style="q2" vid="PSA 114:7-8">hem i Masta* blong yumi!</para>
  <para style="q1" vid="PSA 114:7-8">Hem i save mekem ol ston oli kam hol blong wota,</para>
  <para style="q2" vid="PSA 114:7-8">mo i save mekem ol klif oli kam springwota.</para>
  <para style="q1" vid="PSA 114:7-8">Taem hem i kamtru,</para>
  <para style="q2" vid="PSA 114:7-8">i gud yu ona long hem, yu seksek,</para>
  <para style="q3" vid="PSA 114:7-8">yu foldaon long fes blong hem.<verse eid="PSA 114:7-8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">Ol man oli mas leftemap nem blong Hae God nomo, from we hem nomo i tru God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Hae God.</para>
  <para style="q1" vid="PSA 115:1">Oltaem yu yu lavem man tumas,</para>
  <para style="q3" vid="PSA 115:1">mo oltaem yu stap holem ol promes blong yu.</para>
  <para style="q1" vid="PSA 115:1">From samting ya,</para>
  <para style="q2" vid="PSA 115:1">mifala i no save leftemap nem blong mifala,</para>
  <para style="q3" vid="PSA 115:1">mifala i mas leftemap nem blong yu nomo.<verse eid="PSA 115:1" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Olgeta.</para>
  <para style="q1" vid="PSA 115:2">I no stret blong ol hiten man</para>
  <para style="q3" vid="PSA 115:2">oli stap jikim yumi se,</para>
  <para style="q2" vid="PSA 115:2">“?Wehem God ya blong yufala?”<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />God blong yumi,</para>
  <para style="q3" vid="PSA 115:3">hem i stap long heven,</para>
  <para style="q2" vid="PSA 115:3">mo hem i save mekem evri samting</para>
  <para style="q4" vid="PSA 115:3">we hem i wantem mekem.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115.4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:15-18">Sam 135.15-18</ref>; <ref loc="REV 9:20">Rev 9.20</ref></char>
    </note>Be ol god blong ol hiten man ya,</para>
  <para style="q2" vid="PSA 115:4">olgeta nomo oli wokem long silva mo long gol.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Ol god ya oli gat maot,</para>
  <para style="q2" vid="PSA 115:5">be oli no save toktok.</para>
  <para style="q1" vid="PSA 115:5">Oli gat ae,</para>
  <para style="q2" vid="PSA 115:5">be oli no save lukluk.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Oli gat sora,</para>
  <para style="q2" vid="PSA 115:6">be oli no save harem samting.</para>
  <para style="q1" vid="PSA 115:6">Oli gat nus,</para>
  <para style="q2" vid="PSA 115:6">be oli no save harem smel blong samting.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Oli gat han</para>
  <para style="q2" vid="PSA 115:7">be oli no save holem samting.</para>
  <para style="q1" vid="PSA 115:7">Oli gat leg,</para>
  <para style="q2" vid="PSA 115:7">be oli no save wokbaot.</para>
  <para style="q1" vid="PSA 115:7">Olgeta oli no save talem wan tok nating.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />I gud ol man we oli mekem ol aedol ya,</para>
  <para style="q3" vid="PSA 115:8">wetem ol man we oli stap wosipim olgeta,</para>
  <para style="q2" vid="PSA 115:8">olgeta evriwan oli kam olsem ol aedol ya nomo.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 115:9">yumi mas trastem Hae God.</para>
  <para style="q1" vid="PSA 115:9">Oltaem hem i stap givhan long yumi,</para>
  <para style="q2" vid="PSA 115:9">i stap lukaot gud long yumi,<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Yufala ol pris* blong hem,</para>
  <para style="q2" vid="PSA 115:10">yufala i mas trastem hem.</para>
  <para style="q1" vid="PSA 115:10">Oltaem hem i stap givhan long yumi,</para>
  <para style="q2" vid="PSA 115:10">i stap lukaot gud long yumi.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Yumi evriwan we i stap mekem wosip long hem,</para>
  <para style="q2" vid="PSA 115:11">yumi mas trastem hem.</para>
  <para style="q1" vid="PSA 115:11">Oltaem hem i stap givhan long yumi,</para>
  <para style="q2" vid="PSA 115:11">i stap lukaot gud long yumi.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />Oltaem hem i stap tingbaot yumi,</para>
  <para style="q2" vid="PSA 115:12">mo bambae hem i blesem yumi.</para>
  <para style="q1" vid="PSA 115:12">Yumi wetem ol pris blong hem,</para>
  <para style="q2" vid="PSA 115:12">hem bambae i blesem yumi.<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115.13: </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:18">Rev 11.18</ref>; <ref loc="REV 19:5">19.5</ref></char>
    </note>Hem bambae i blesem yumi evriwan</para>
  <para style="q2" vid="PSA 115:13">we yumi stap ona long hem.</para>
  <para style="q1" vid="PSA 115:13">Ol haeman wetem ol man we oli no gat nem,</para>
  <para style="q2" vid="PSA 115:13">be hem bambae i mekem i sem mak nomo</para>
  <para style="q4" vid="PSA 115:13">long yumi evriwan.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />Prea blong mi,</para>
  <para style="q2" vid="PSA 115:14">we Hae God bambae i mekem</para>
  <para style="q4" vid="PSA 115:14">we yufala i gat plante pikinini,</para>
  <para style="q3" vid="PSA 115:14">mo we yufala</para>
  <para style="q3" vid="PSA 115:14">wetem olgeta we bambae oli kamaot biaen long yufala,</para>
  <para style="q4" vid="PSA 115:14">bambae yufala i kam plante we plante.<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Hem i mekem heven mo wol,</para>
  <para style="q2" vid="PSA 115:15">mo prea blong mi,</para>
  <para style="q3" vid="PSA 115:15">we hem bambae i blesem yufala.<verse eid="PSA 115:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Heven i ples blong Hae God nomo,</para>
  <para style="q2" vid="PSA 115:16">be wol ya, hem i givim long man.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Olgeta we oli stap long Hom* blong ol Dedman</para>
  <para style="q2" vid="PSA 115:17">oli no save presem hem,</para>
  <para style="q3" vid="PSA 115:17">from we oli ded finis.<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />Be yumi ya we yumi stap laef,</para>
  <para style="q2" vid="PSA 115:18">bambae yumi stap talem tangkiu long hem oltaem,</para>
  <para style="q3" vid="PSA 115:18">i stat naoia gogo i no save finis.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q1" vid="PSA 115:18">!Oltaem yumi mas presem Hae God!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">Man we klosap i ded i talem tangkiu long Hae God, from we hem i sevem hem</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Olgeta.</para>
  <para style="q1" vid="PSA 116:1">Mi mi lavem Hae God tumas,</para>
  <para style="q2" vid="PSA 116:1">from we oltaem hem i stap lesin long mi,</para>
  <para style="q3" vid="PSA 116:1">oltaem hem i stap harem prea blong mi.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Oltaem hem i stap lesin long mi,</para>
  <para style="q2" vid="PSA 116:2">mo from samting ya,</para>
  <para style="q3" vid="PSA 116:2">bambae mi stap prea long hem</para>
  <para style="q4" vid="PSA 116:2">oltaem long laef blong mi.<verse eid="PSA 116:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Bifo, bigfala trabol i kasem mi</para>
  <para style="q2" vid="PSA 116:3">we klosap mi ded from.</para>
  <para style="q1" vid="PSA 116:3">Mi mi luk ded i olsem wan trap</para>
  <para style="q3" vid="PSA 116:3">we klosap i kasem mi,</para>
  <para style="q2" vid="PSA 116:3">nao mi harem nogud tumas,</para>
  <para style="q4" vid="PSA 116:3">mi fraet we mi fraet.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />Nao mi krae long hem,</para>
  <para style="q2" vid="PSA 116:4">mi talem se, “Hae God.</para>
  <para style="q2" vid="PSA 116:4">Plis yu sevem mi.”<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 116:5">mo hem i gud tumas.</para>
  <para style="q1" vid="PSA 116:5">Hem i kaen, mo i gat sore long man.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />Hem i stap lukaot long olgeta</para>
  <para style="q2" vid="PSA 116:6">we oli no gat paoa.</para>
  <para style="q1" vid="PSA 116:6">Taem trabol i kasem mi,</para>
  <para style="q2" vid="PSA 116:6">hem i sevem mi.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Mo naoia mi mi save harem gud bakegen,</para>
  <para style="q2" vid="PSA 116:7">from we hem i stap mekem i gud tumas long mi.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />Klosap mi mi ded,</para>
  <para style="q2" vid="PSA 116:8">be hem i sevem mi.</para>
  <para style="q1" vid="PSA 116:8">Hem i leftemap tingting blong mi,</para>
  <para style="q2" vid="PSA 116:8">nao mi no moa krae.</para>
  <para style="q1" vid="PSA 116:8">Klosap mi mi foldaon,</para>
  <para style="q2" vid="PSA 116:8">be hem i holem mi mi stap gud.<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Nao from samting ya,</para>
  <para style="q2" vid="PSA 116:9">mi mi stap wokbaot wetem hem</para>
  <para style="q3" vid="PSA 116:9">oltaem long laef blong mi.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="PSA 116:10-11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116.10-11: </char>
      <char style="xt" closed="false">
        <ref loc="2CO 4:13">2 Kor 4.13</ref>
      </char>
    </note>Nating we mi harem</para>
  <para style="q3" vid="PSA 116:10-11">se olgeta oli flatemgud mi,</para>
  <para style="q2" vid="PSA 116:10-11">mo nating we mi fraet tumas,</para>
  <para style="q3" vid="PSA 116:10-11">mi ting se i no gat wan man nating</para>
  <para style="q4" vid="PSA 116:10-11">we mi save trastem hem,</para>
  <para style="q2" vid="PSA 116:10-11">be tingting blong mi i no foldaon,</para>
  <para style="q3" vid="PSA 116:10-11">mi mi stap bilif strong yet.<verse eid="PSA 116:10-11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />Hae God i stap mekem i gud tumas long mi.</para>
  <para style="q1" vid="PSA 116:12">?Bambae mi save givim wanem presen long hem?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />Bambae mi tekem kap waen,</para>
  <para style="q2" vid="PSA 116:13">mi givim long hem</para>
  <para style="q3" vid="PSA 116:13">blong talem tangkiu long hem</para>
  <para style="q4" vid="PSA 116:13">from we hem i sevem mi.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Long fes blong olgeta man blong hem,</para>
  <para style="q2" vid="PSA 116:14">bambae mi givim olgeta samting ya long hem</para>
  <para style="q3" vid="PSA 116:14">we mi mi promes finis blong givim.<verse eid="PSA 116:14" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />Hae God.</para>
  <para style="q1" vid="PSA 116:15">Taem wan long ol man blong yu i ded,</para>
  <para style="q2" vid="PSA 116:15">yu yu harem nogud tumas.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Mi mi man blong wok blong yu</para>
  <para style="q2" vid="PSA 116:16">olsem mama blong mi bifo,</para>
  <para style="q3" vid="PSA 116:16">mo yu yu sevem mi mi no ded.<verse eid="PSA 116:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Bambae mi mi mekem sakrefaes long yu</para>
  <para style="q2" vid="PSA 116:17">blong talem tangkiu long yu.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18-19" style="v" sid="PSA 116:18-19" />Long Jerusalem,*</para>
  <para style="q2" vid="PSA 116:18-19">long yad blong haos* ya blong yu,</para>
  <para style="q3" vid="PSA 116:18-19">long fes blong olgeta man blong yu,</para>
  <para style="q2" vid="PSA 116:18-19">bambae mi givim olgeta samting ya long yu</para>
  <para style="q3" vid="PSA 116:18-19">we mi mi promes finis blong givim.</para>
  <para style="sp" vid="PSA 116:18-19">(Tok i go long ol man.)</para>
  <para style="q1" vid="PSA 116:18-19">!Oltaem yumi mas presem Hae God!<verse eid="PSA 116:18-19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">Yumi presem Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">117.1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:11">Rom 15.11</ref>
      </char>
    </note>!Olgeta man blong evri ples long wol!</para>
  <para style="q1" vid="PSA 117:1">!Yumi presem Hae God!</para>
  <para style="q2" vid="PSA 117:1">!Yumi leftemap nem blong hem!<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Oltaem hem i lavem yumi tumas,</para>
  <para style="q2" vid="PSA 117:2">mo bambae hem i stap holem</para>
  <para style="q4" vid="PSA 117:2">ol promes blong hem</para>
  <para style="q3" vid="PSA 117:2">long yumi,</para>
  <para style="q3" vid="PSA 117:2">gogo i no save finis.</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q1" vid="PSA 117:2">!Oltaem yumi mas presem Hae God!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">Man i talem tangkiu long Hae God from we hem i win long faet</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118.1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Kron 16.34</ref>; <ref loc="2CH 5:13">2 Kron 5.13</ref>; <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Esra 3.11</ref>; <ref loc="PSA 100:5">Sam 100.5</ref>; <ref loc="PSA 106:1">106.1</ref>; <ref loc="PSA 107:1">107.1</ref>; <ref loc="PSA 136:1">136.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char>
    </note>Olgeta.</para>
  <para style="q1" vid="PSA 118:1">Yumi talem tangkiu long Hae God,</para>
  <para style="q2" vid="PSA 118:1">from we hem i gud tumas.</para>
  <para style="q1" vid="PSA 118:1">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 118:1">gogo i no save finis.<verse eid="PSA 118:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 118:2">yumi talem se,</para>
  <para style="q2" vid="PSA 118:2">“Oltaem bambae hem i lavem yumi,</para>
  <para style="q3" vid="PSA 118:2">gogo i no save finis”<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Yufala ol pris* blong hem,</para>
  <para style="q2" vid="PSA 118:3">yufala i talem se,</para>
  <para style="q2" vid="PSA 118:3">“Oltaem bambae hem i lavem yumi,</para>
  <para style="q3" vid="PSA 118:3">gogo i no save finis.”<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Yumi evriwan we yumi stap mekem wosip long hem,</para>
  <para style="q2" vid="PSA 118:4">yumi talem se,</para>
  <para style="q2" vid="PSA 118:4">“Oltaem bambae hem i lavem yumi,</para>
  <para style="q3" vid="PSA 118:4">gogo i no save finis.”<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Taem mi mi stap long trabol,</para>
  <para style="q3" vid="PSA 118:5">mi krae i go long hem,</para>
  <para style="q2" vid="PSA 118:5">mo hem i harem krae blong mi,</para>
  <para style="q4" vid="PSA 118:5">i mekem mi mi fri.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118.6: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 13:6">Hib 13.6</ref>
      </char>
    </note>Oltaem hem i stap wetem mi,</para>
  <para style="q2" vid="PSA 118:6">nao bambae mi mi no save fraet.</para>
  <para style="q1" vid="PSA 118:6">Man i no save mekem wan samting</para>
  <para style="q2" vid="PSA 118:6">blong spolem mi.<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />Hae God nomo i stap givhan long mi.</para>
  <para style="q1" vid="PSA 118:7">Mi mi savegud</para>
  <para style="q2" vid="PSA 118:7">we hem bambae i winim ol enemi blong mi.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />I nogud we man i putum tingting blong hem</para>
  <para style="q3" vid="PSA 118:8">long man nomo,</para>
  <para style="q2" vid="PSA 118:8">i moa gud hem i trastem Hae God.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />I nogud we man i putum tingting blong hem</para>
  <para style="q3" vid="PSA 118:9">long ol lida we oli man nomo,</para>
  <para style="q2" vid="PSA 118:9">i moa gud hem i trastem Hae God.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Ol man blong ol narafala kantri</para>
  <para style="q3" vid="PSA 118:10">oli kam plante raonabaot long mi,</para>
  <para style="q2" vid="PSA 118:10">be mi mi flatemgud olgeta</para>
  <para style="q4" vid="PSA 118:10">long paoa blong hem.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Oli kam plante raonabaot long mi</para>
  <para style="q3" vid="PSA 118:11">we oli plante we plante,</para>
  <para style="q2" vid="PSA 118:11">be mi mi flatemgud olgeta</para>
  <para style="q4" vid="PSA 118:11">long paoa blong hem.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Oli kam hivap raon long mi</para>
  <para style="q3" vid="PSA 118:12">olsem ol sugabag,*</para>
  <para style="q2" vid="PSA 118:12">be mi mi flatemgud olgeta</para>
  <para style="q4" vid="PSA 118:12">long paoa blong hem.</para>
  <para style="q1" vid="PSA 118:12">Olgeta oli finis kwiktaem nomo,</para>
  <para style="q2" vid="PSA 118:12">olsem we faea i bonem waetgras.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Olgeta oli strong tumas,</para>
  <para style="q2" vid="PSA 118:13">mo oli kam faet long mi</para>
  <para style="q3" vid="PSA 118:13">we klosap oli winim mi,</para>
  <para style="q2" vid="PSA 118:13">be hem i givhan long mi.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118.14: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:2">Eks 15.2</ref>; <ref loc="ISA 12:2">Aes 12.2</ref></char>
    </note>Hem i stap givim paoa long mi,</para>
  <para style="q2" vid="PSA 118:14">i stap mekem mi mi strong.</para>
  <para style="q1" vid="PSA 118:14">Hem nao i stap sevem mi.<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Mifala ol man blong Hae God,</para>
  <para style="q2" vid="PSA 118:15">mifala i stap long ol haos tapolen blong mifala.</para>
  <para style="q1" vid="PSA 118:15">Mifala i win finis,</para>
  <para style="q3" vid="PSA 118:15">mo mifala i glad tumas from,</para>
  <para style="q2" vid="PSA 118:15">nao mifala i stap singsingaot se,</para>
  <para style="q2" vid="PSA 118:15">“Hae God i gat bigfala paoa,</para>
  <para style="q3" vid="PSA 118:15">mo hem i mekem mifala i win.<verse eid="PSA 118:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16" />Hem i mekem samting ya</para>
  <para style="q3" vid="PSA 118:16">long paoa blong hem.</para>
  <para style="q2" vid="PSA 118:16">!Paoa blong hem i strong tumas long faet!”<verse eid="PSA 118:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Bambae mi no save ded,</para>
  <para style="q2" vid="PSA 118:17">bambae mi stap,</para>
  <para style="q3" vid="PSA 118:17">mi talemaot ol samting</para>
  <para style="q4" vid="PSA 118:17">we Hae God i mekem.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />Hem i panisim mi we i meksave mi,</para>
  <para style="q3" vid="PSA 118:18">be hem i no letem mi mi ded.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Plis yufala i openem ol doa blong yad</para>
  <para style="q3" vid="PSA 118:19">blong haos* blong Hae God long mi,</para>
  <para style="q2" vid="PSA 118:19">nao bambae mi go insaed,</para>
  <para style="q3" vid="PSA 118:19">mi talem tangkiu long hem.<verse eid="PSA 118:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Hemia ol doa blong Hae God ya.</para>
  <para style="q1" vid="PSA 118:20">Ol stret man nomo oli save kam insaed long hem.<verse eid="PSA 118:20" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Hae God.</para>
  <para style="q1" vid="PSA 118:21">Oltaem mi mi presem yu,</para>
  <para style="q2" vid="PSA 118:21">from we yu yu harem mi,</para>
  <para style="q3" vid="PSA 118:21">yu mekem mi mi win.<verse eid="PSA 118:21" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118.22: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 20:17">Luk 20.17</ref>; <ref loc="ACT 4:11">Wok 4.11</ref>; <ref loc="1PE 2:7">1 Pita 2.7</ref></char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">118.22: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:42">Mat 21.42</ref>; <ref loc="MRK 12:10">Mak 12.10</ref>,<ref loc="MRK 12:11">11</ref></char>
    </note>Olgeta.</para>
  <para style="q1" vid="PSA 118:22">Pos ya we ol man blong wokem haos oli sakem finis,</para>
  <para style="q2" vid="PSA 118:22">naoia hem i kam nambawan pos blong haos.<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Samting ya, Hae God i mekem,</para>
  <para style="q3" vid="PSA 118:23">mo yumi luk we i gud tumas.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Dei ya,</para>
  <para style="q2" vid="PSA 118:24">hem i dei we hem i win long hem,</para>
  <para style="q3" vid="PSA 118:24">i gud yumi glad,</para>
  <para style="q4" vid="PSA 118:24">yumi mekem lafet.<verse eid="PSA 118:24" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118.25: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mat 21.9</ref>; <ref loc="MRK 11:9">Mak 11.9</ref>; <ref loc="JHN 12:13">Jon 12.13</ref></char>
    </note>Hae God.</para>
  <para style="q1" vid="PSA 118:25">Plis yu sevem mifala.</para>
  <para style="q1" vid="PSA 118:25">Plis yu mekem mifala i win.<verse eid="PSA 118:25" /></para>
  <para style="sp">(Pris i toktok long ol man.)</para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118.26: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:9">Mat 21.9</ref>; <ref loc="MAT 23:39">23.39</ref>; <ref loc="MRK 11:9">Mak 11.9</ref>; <ref loc="LUK 13:35">Luk 13.35</ref>; <ref loc="LUK 19:38">19.38</ref>; <ref loc="JHN 12:13">Jon 12.13</ref></char>
    </note>Olgeta.</para>
  <para style="q1" vid="PSA 118:26">Mifala i stap long haos blong Hae God,</para>
  <para style="q2" vid="PSA 118:26">mo prea blong mifala</para>
  <para style="q3" vid="PSA 118:26">we hem bambae i blesem man ya</para>
  <para style="q4" vid="PSA 118:26">we i kam long nem blong hem,</para>
  <para style="q3" vid="PSA 118:26">mo we bambae i blesem yufala.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />Hae God, hem nao i God,</para>
  <para style="q2" vid="PSA 118:27">mo hem i mekem laet blong hem</para>
  <para style="q3" vid="PSA 118:27">i saenaot i kam long yumi.</para>
  <para style="q1" vid="PSA 118:27">Yufala i kam mekem wosip,</para>
  <para style="q2" vid="PSA 118:27">yufala i holem ol han blong tri,</para>
  <para style="q3" vid="PSA 118:27">yufala i maj i goraon long olta.<verse eid="PSA 118:27" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Hae God.</para>
  <para style="q1" vid="PSA 118:28">Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 118:28">oltaem bambae mi talem tangkiu long yu,</para>
  <para style="q3" vid="PSA 118:28">oltaem bambae mi talemaot hae nem blong yu.<verse eid="PSA 118:28" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Olgeta.</para>
  <para style="q1" vid="PSA 118:29">Yumi talem tangkiu long Hae God</para>
  <para style="q2" vid="PSA 118:29">from we hem i gud tumas.</para>
  <para style="q1" vid="PSA 118:29">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 118:29">gogo i no save finis.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">Loa blong Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Olgeta.</para>
  <para style="q1" vid="PSA 119:1">Ol man we laef blong olgeta i stret,</para>
  <para style="q2" vid="PSA 119:1">we oltaem oli stap folem Loa* blong Hae God,</para>
  <para style="q3" vid="PSA 119:1">bambae oli save harem gud.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Ol man we oli stap obei long hem</para>
  <para style="q3" vid="PSA 119:2">long olgeta tingting blong olgeta,</para>
  <para style="q2" vid="PSA 119:2">mo we oli stap folem ol rul</para>
  <para style="q4" vid="PSA 119:2">we hem i mekem,</para>
  <para style="q3" vid="PSA 119:2">bambae oli save harem gud.<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />Neva oli mekem samting we i rong,</para>
  <para style="q2" vid="PSA 119:3">oltaem oli stap folem fasin blong hem.<verse eid="PSA 119:3" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Hae God.</para>
  <para style="q1" vid="PSA 119:4">Yu yu givim ol loa blong yu long mi,</para>
  <para style="q2" vid="PSA 119:4">blong mi mi holemstrong olgeta,</para>
  <para style="q3" vid="PSA 119:4">mi obei long olgeta.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Mi mi wantem tumas</para>
  <para style="q2" vid="PSA 119:5">blong mi stap strong oltaem</para>
  <para style="q3" vid="PSA 119:5">blong folem ol tijing blong yu.<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Sipos mi stap lesin gud long ol tok</para>
  <para style="q3" vid="PSA 119:6">we yu yu putum,</para>
  <para style="q2" vid="PSA 119:6">bambae ol man oli no save mekem</para>
  <para style="q4" vid="PSA 119:6">mi mi sem.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Ol tingting blong yu i stret,</para>
  <para style="q2" vid="PSA 119:7">mo sipos mi stap lanem olgeta,</para>
  <para style="q3" vid="PSA 119:7">bambae tingting blong mi i kam klin,</para>
  <para style="q4" vid="PSA 119:7">nao bambae mi presemgud yu.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Oltaem bambae mi obei long ol tijing blong yu.</para>
  <para style="q2" vid="PSA 119:8">!Plis yu no lego mi!<verse eid="PSA 119:8" /></para>
  <para style="s">Yumi mas obei long Loa blong Hae God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Hae God.</para>
  <para style="q1" vid="PSA 119:9">Mi mi yangfala nomo.</para>
  <para style="q1" vid="PSA 119:9">?Bambae mi save mekem</para>
  <para style="q2" vid="PSA 119:9">laef blong mi i klin olsem wanem?</para>
  <para style="q1" vid="PSA 119:9">Mi mi mas obei long ol tok blong yu.<note caller="+" style="f"><char style="fr" closed="false">119.9: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya biaen long “Hae God” i olsem. </char><char style="fqa" closed="false">?<char style="bd">Bambae yang man</char> </char><char style="fqa" closed="false">i save mekem laef blong <char style="bd">hem i</char> </char><char style="fqa" closed="false">klin olsem wanem? <char style="bd">Hem</char> </char><char style="fqa" closed="false">i mas obei long ol tok blong yu.</char></note><verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Mi mi stap traehad</para>
  <para style="q2" vid="PSA 119:10">long olgeta tingting blong mi,</para>
  <para style="q3" vid="PSA 119:10">blong mekem wok blong yu.</para>
  <para style="q1" vid="PSA 119:10">Plis yu halpem mi,</para>
  <para style="q2" vid="PSA 119:10">blong mi no lego</para>
  <para style="q3" vid="PSA 119:10">ol tok we yu yu putum.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />Oltaem mi stap holem ol tok blong yu</para>
  <para style="q3" vid="PSA 119:11">long tingting blong mi,</para>
  <para style="q2" vid="PSA 119:11">blong bambae mi no save mekem sin agens long yu.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Hae God, mi mi presem yu.</para>
  <para style="q1" vid="PSA 119:12">Plis yu tijim mi long ol rod blong yu.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Bambae mi stap talemaot bakegen</para>
  <para style="q2" vid="PSA 119:13">ol tingting blong yu we yu yu talem.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Mi mi glad blong folem ol rul</para>
  <para style="q3" vid="PSA 119:14">we yu yu mekem,</para>
  <para style="q2" vid="PSA 119:14">i winim we mi mi glad</para>
  <para style="q4" vid="PSA 119:14">from we mi rijman.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Oltaem mi stap tingting long ol loa blong yu,</para>
  <para style="q2" vid="PSA 119:15">mo mi stap tingbaot ol fasin blong yu.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Oltaem mi mi glad tumas</para>
  <para style="q3" vid="PSA 119:16">long ol tijing blong yu,</para>
  <para style="q2" vid="PSA 119:16">mi no save fogetem ol tok blong yu.<verse eid="PSA 119:16" /></para>
  <para style="s">Prea blong man we i obei long Loa blong Hae God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Hae God.</para>
  <para style="q1" vid="PSA 119:17">Mi mi man blong wok blong yu.</para>
  <para style="q1" vid="PSA 119:17">Plis yu mekem i gud long mi,</para>
  <para style="q2" vid="PSA 119:17">nao bambae mi save stap laef,</para>
  <para style="q3" vid="PSA 119:17">mi save obei long ol tok blong yu.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Plis yu openem ae blong mi</para>
  <para style="q2" vid="PSA 119:18">blong mi save luk ol gudgudfala samting</para>
  <para style="q3" vid="PSA 119:18">long Loa* blong yu.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />Bambae mi mi stap long wol ya</para>
  <para style="q3" vid="PSA 119:19">blong smol taem nomo,</para>
  <para style="q2" vid="PSA 119:19">plis yu no haedem ol tok ya long mi</para>
  <para style="q4" vid="PSA 119:19">we yu yu putum.<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Oltaem nomo,</para>
  <para style="q2" vid="PSA 119:20">mi mi wantem we mi wantem tumas</para>
  <para style="q3" vid="PSA 119:20">blong savegud ol tingting blong yu.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Ol praod man oli no save obei</para>
  <para style="q3" vid="PSA 119:21">long ol tok we yu yu putum,</para>
  <para style="q2" vid="PSA 119:21">nao yu tok long olgeta,</para>
  <para style="q3" vid="PSA 119:21">yu talem long olgeta</para>
  <para style="q4" vid="PSA 119:21">se oli mas lus.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Olgeta ya oli stap sakem ol rabis tok long mi,</para>
  <para style="q2" vid="PSA 119:22">mo oli stap laf nogud long mi.</para>
  <para style="q1" vid="PSA 119:22">Plis yu sevem mi</para>
  <para style="q3" vid="PSA 119:22">blong ol tok ya i no spolem mi,</para>
  <para style="q2" vid="PSA 119:22">from we mi mi stap holem ol rul</para>
  <para style="q4" vid="PSA 119:22">we yu yu mekem.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Nating we ol haeman oli sidaon,</para>
  <para style="q3" vid="PSA 119:23">oli mekem plan agens long mi,</para>
  <para style="q2" vid="PSA 119:23">be mi mi man blong wok blong yu,</para>
  <para style="q4" vid="PSA 119:23">mo oltaem bambae mi stap tingting</para>
  <para style="q3" vid="PSA 119:23">long ol loa blong yu.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Ol rul we yu yu mekem,</para>
  <para style="q2" vid="PSA 119:24">oltaem oli stap mekem mi mi harem gud.</para>
  <para style="q1" vid="PSA 119:24">Oli olsem man blong givim waestok long mi.<verse eid="PSA 119:24" /></para>
  <para style="s">Prea blong man we i mekem tingting blong hem i strong blong obei long Loa blong Hae God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Hae God.</para>
  <para style="q1" vid="PSA 119:25">Mi harem se klosap mi mi ded.</para>
  <para style="q1" vid="PSA 119:25">Plis yu mekem mi mi laef bakegen,</para>
  <para style="q2" vid="PSA 119:25">olsem we tok blong yu i talem.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Mi mi talemaot olgeta samting nogud</para>
  <para style="q2" vid="PSA 119:26">we mi bin mekem,</para>
  <para style="q3" vid="PSA 119:26">mo yu yu harem prea blong mi.</para>
  <para style="q1" vid="PSA 119:26">Plis yu tijim mi</para>
  <para style="q2" vid="PSA 119:26">long ol rod blong yu.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Plis yu givhan long mi</para>
  <para style="q3" vid="PSA 119:27">blong mi savegud ol loa blong yu,</para>
  <para style="q2" vid="PSA 119:27">nao bambae mi stap tingting</para>
  <para style="q4" vid="PSA 119:27">long ol bigbigfala wok blong yu.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Mi mi harem nogud we i nogud.</para>
  <para style="q1" vid="PSA 119:28">Plis yu mekem mi mi strong,</para>
  <para style="q2" vid="PSA 119:28">olsem we tok blong yu i talem.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Plis yu lukaot long mi</para>
  <para style="q3" vid="PSA 119:29">blong mi no folem rod blong giaman,</para>
  <para style="q2" vid="PSA 119:29">yu kaen long mi</para>
  <para style="q4" vid="PSA 119:29">yu tijim mi long Loa* blong yu.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Mi mi jusumaot finis,</para>
  <para style="q2" vid="PSA 119:30">se bambae mi holem ol fasin we yu yu wantem,</para>
  <para style="q3" vid="PSA 119:30">mo bambae mi stap lesin long ol tingting blong yu.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />Hae God,</para>
  <para style="q2" vid="PSA 119:31">mi mi stap folem ol rul we yu yu mekem.</para>
  <para style="q1" vid="PSA 119:31">Plis yu no letem</para>
  <para style="q2" vid="PSA 119:31">ol man oli mekem mi mi sem.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Mi wantem tumas</para>
  <para style="q2" vid="PSA 119:32">blong obei long ol tok we yu yu putum,</para>
  <para style="q3" vid="PSA 119:32">from we yu bambae yu mekem</para>
  <para style="q4" vid="PSA 119:32">mi mi save olgeta moa.<verse eid="PSA 119:32" /></para>
  <para style="s">Prea blong man we i wantem kasem save</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />Hae God.</para>
  <para style="q1" vid="PSA 119:33">Plis yu lanem mi long mining</para>
  <para style="q3" vid="PSA 119:33">blong ol tok we yu tijim mi long hem,</para>
  <para style="q2" vid="PSA 119:33">nao bambae mi obei long hem oltaem.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Yu talemaot mining blong Loa* blong yu long mi,</para>
  <para style="q2" vid="PSA 119:34">nao bambae mi obei long hem,</para>
  <para style="q3" vid="PSA 119:34">mi holemgud long olgeta tingting blong mi.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Plis yu givhan long mi</para>
  <para style="q3" vid="PSA 119:35">blong oltaem mi stap obei</para>
  <para style="q4" vid="PSA 119:35">long ol tok we yu yu putum,</para>
  <para style="q2" vid="PSA 119:35">from we oli stap mekem mi mi glad.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Plis yu mekem</para>
  <para style="q2" vid="PSA 119:36">we oltaem bambae mi wantem moa</para>
  <para style="q3" vid="PSA 119:36">blong obei long ol rul we yu yu mekem,</para>
  <para style="q2" vid="PSA 119:36">i winim we mi wantem kam rijman.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Plis yu blokem mi</para>
  <para style="q2" vid="PSA 119:37">blong mi no save folem ol fasin ya</para>
  <para style="q3" vid="PSA 119:37">we i nogat wan gudfala samting</para>
  <para style="q4" vid="PSA 119:37">i save kamaot long hem.</para>
  <para style="q1" vid="PSA 119:37">Plis yu mekem</para>
  <para style="q2" vid="PSA 119:37">we mi mi gat gudfala laef,</para>
  <para style="q3" vid="PSA 119:37">we i folemgud ol fasin blong yu.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 119:38">plis yu holem promes blong yu</para>
  <para style="q3" vid="PSA 119:38">we yu mekem long mi.</para>
  <para style="q1" vid="PSA 119:38">Promes ya i stap long olgeta</para>
  <para style="q2" vid="PSA 119:38">we oli stap obei long yu.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Mi mi fraet tumas</para>
  <para style="q2" vid="PSA 119:39">long ol tok nogud blong ol man</para>
  <para style="q3" vid="PSA 119:39">we oli stap agens long mi.</para>
  <para style="q1" vid="PSA 119:39">Plis yu sevem mi,</para>
  <para style="q2" vid="PSA 119:39">from we ol tingting blong yu i gud tumas.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Mi mi wantem tumas</para>
  <para style="q2" vid="PSA 119:40">blong obei long ol loa blong yu.</para>
  <para style="q1" vid="PSA 119:40">Plis yu mekem laef blong mi i kam niuwan,</para>
  <para style="q2" vid="PSA 119:40">from we fasin blong yu i stret gud.<verse eid="PSA 119:40" /></para>
  <para style="s">Prea blong man we i trastem Loa blong Hae God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />Hae God.</para>
  <para style="q1" vid="PSA 119:41">Plis yu soemaot long mi</para>
  <para style="q2" vid="PSA 119:41">we oltaem nomo, yu yu lavem mi.</para>
  <para style="q1" vid="PSA 119:41">Plis yu sevem mi</para>
  <para style="q2" vid="PSA 119:41">olsem we yu yu promes.<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />Nao from we mi mi trastem tok blong yu,</para>
  <para style="q2" vid="PSA 119:42">bambae mi save ansa long olgeta</para>
  <para style="q3" vid="PSA 119:42">we oli stap tok nogud long mi.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Plis yu givhan long mi</para>
  <para style="q3" vid="PSA 119:43">blong mi save talem trutok oltaem nomo,</para>
  <para style="q2" vid="PSA 119:43">from we oltaem,</para>
  <para style="q3" vid="PSA 119:43">mi mi trastem ol tingting blong yu.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Mi bambae mi stap obei long Loa* blong yu oltaem,</para>
  <para style="q2" vid="PSA 119:44">gogo i no save finis.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Bambae mi stap gud we mi fri olgeta,</para>
  <para style="q2" vid="PSA 119:45">from we mi stap traem</para>
  <para style="q3" vid="PSA 119:45">blong obei long ol loa blong yu.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Bambae mi stanap long fes blong ol king,</para>
  <para style="q2" vid="PSA 119:46">mi talemaot ol rul we yu yu mekem,</para>
  <para style="q3" vid="PSA 119:46">we bambae mi no save sem from.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Taem mi stap obei long ol tok we yu yu putum,</para>
  <para style="q2" vid="PSA 119:47">mi luk we oltaem mi mi stap harem gud</para>
  <para style="q3" vid="PSA 119:47">from we mi laekem ol tok blong yu tumas.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />Mi mi stap tinghevi</para>
  <para style="q3" vid="PSA 119:48">long ol tok we yu yu putum,</para>
  <para style="q2" vid="PSA 119:48">mo mi laekem olgeta tumas.</para>
  <para style="q1" vid="PSA 119:48">Oltaem nomo,</para>
  <para style="q2" vid="PSA 119:48">bambae mi stap tingting gud</para>
  <para style="q3" vid="PSA 119:48">long ol tijing ya blong yu.<verse eid="PSA 119:48" /></para>
  <para style="s">Prea blong man we i bilif strong long Loa blong Hae God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Hae God.</para>
  <para style="q1" vid="PSA 119:49">Mi mi man blong wok blong yu.</para>
  <para style="q1" vid="PSA 119:49">Plis yu tingbaot ol tok blong yu</para>
  <para style="q3" vid="PSA 119:49">we yu talem long mi,</para>
  <para style="q2" vid="PSA 119:49">from we hem i mekem</para>
  <para style="q4" vid="PSA 119:49">tingting blong mi i strong.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Nating we mi mi harem nogud,</para>
  <para style="q2" vid="PSA 119:50">be yu yu mekem mi mi harem gud bakegen,</para>
  <para style="q3" vid="PSA 119:50">from we promes blong yu i mekem mi mi laef.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Oltaem ol praod man oli stap laf nogud long mi,</para>
  <para style="q2" vid="PSA 119:51">be mi mi no gowe long Loa* blong yu.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />Hae God,</para>
  <para style="q2" vid="PSA 119:52">taem mi tingbaot ol tingting blong</para>
  <para style="q4" vid="PSA 119:52">yu we yu mekem bifo olgeta,</para>
  <para style="q3" vid="PSA 119:52">be oli mekem tingting blong mi i kam strong bakegen.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Taem mi luk</para>
  <para style="q2" vid="PSA 119:53">we ol man nogud oli tanem baksaed</para>
  <para style="q4" vid="PSA 119:53">long Loa blong yu,</para>
  <para style="q3" vid="PSA 119:53">mi mi kros we mi kros.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Long smoltaem ya we mi stap long wol ya,</para>
  <para style="q2" vid="PSA 119:54">mi mi wokem plante singsing</para>
  <para style="q4" vid="PSA 119:54">we oli tokbaot ol loa blong yu.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />Hae God,</para>
  <para style="q2" vid="PSA 119:55">long naet mi stap tingbaot yu,</para>
  <para style="q3" vid="PSA 119:55">mo mi stap tingting long Loa blong yu.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Taem mi stap obei long ol loa blong yu,</para>
  <para style="q2" vid="PSA 119:56">mi mi harem we mi glad we mi glad.<verse eid="PSA 119:56" /></para>
  <para style="s">Prea blong man we i laekem Loa blong Hae God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />Hae God.</para>
  <para style="q1" vid="PSA 119:57">Olgeta laef blong mi, yu nao.</para>
  <para style="q1" vid="PSA 119:57">Mi mi promes</para>
  <para style="q2" vid="PSA 119:57">blong obei long ol tok blong yu.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Long olgeta tingting blong mi,</para>
  <para style="q2" vid="PSA 119:58">mi askem long yu blong yu sore long mi,</para>
  <para style="q3" vid="PSA 119:58">olsem we yu yu promes.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Mi mi tingting gud finis</para>
  <para style="q3" vid="PSA 119:59">long ol fasin blong yu,</para>
  <para style="q2" vid="PSA 119:59">nao mi tanem tingting blong mi</para>
  <para style="q4" vid="PSA 119:59">blong folem ol rul we yu yu mekem.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Mi mi no tektaem,</para>
  <para style="q2" vid="PSA 119:60">mi girap mi obei long ol tok we yu yu putum.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Ol man nogud oli putum wan trap finis blong kasem mi,</para>
  <para style="q2" vid="PSA 119:61">be mi mi no fogetem Loa* blong yu.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />Long medel naet,</para>
  <para style="q2" vid="PSA 119:62">mi wekap mi presem yu,</para>
  <para style="q3" vid="PSA 119:62">from we ol tingting blong yu oli stret gud.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />Mi mi stap fren long olgeta man</para>
  <para style="q2" vid="PSA 119:63">we oli stap wok blong yu</para>
  <para style="q3" vid="PSA 119:63">mo oli stap obei long ol loa blong yu.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />Hae God,</para>
  <para style="q2" vid="PSA 119:64">wol ya i fulap long fasin ya blong yu</para>
  <para style="q3" vid="PSA 119:64">we yu yu lavem man tumas.</para>
  <para style="q1" vid="PSA 119:64">Plis yu tijim mi long ol rod blong yu.<verse eid="PSA 119:64" /></para>
  <para style="s">Loa blong Hae God i wan gudfala samting</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />Hae God.</para>
  <para style="q1" vid="PSA 119:65">Yu yu stap holem tok blong yu.</para>
  <para style="q1" vid="PSA 119:65">Mi mi man blong wok nomo blong yu,</para>
  <para style="q2" vid="PSA 119:65">be yu yu kaen gud long mi.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Plis yu givim waes mo save long mi</para>
  <para style="q2" vid="PSA 119:66">from we mi mi trastem ol tok we yu yu putum.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Bifo, taem yu no panisim mi yet,</para>
  <para style="q3" vid="PSA 119:67">mi stap folem rod we i no stret,</para>
  <para style="q2" vid="PSA 119:67">be naoia,</para>
  <para style="q4" vid="PSA 119:67">mi stap obei long tok blong yu.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />Yu yu gud tumas, yu kaen tumas.</para>
  <para style="q1" vid="PSA 119:68">Plis yu tijim mi long ol rod blong yu.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Ol praod man oli stap tokbaot mi</para>
  <para style="q3" vid="PSA 119:69">long ol giaman toktok.</para>
  <para style="q1" vid="PSA 119:69">Be mi mi stap holem ol loa blong yu,</para>
  <para style="q2" vid="PSA 119:69">mi stap folem olgeta</para>
  <para style="q4" vid="PSA 119:69">long olgeta tingting blong mi.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Ol man ya oli no gat hed,</para>
  <para style="q2" vid="PSA 119:70">be mi mi stap harem gud tumas</para>
  <para style="q3" vid="PSA 119:70">long Loa* blong yu.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />I gud tumas we yu yu panisim mi,</para>
  <para style="q2" vid="PSA 119:71">from we panis ya i mekem</para>
  <para style="q3" vid="PSA 119:71">we mi mi lanem ol tok ya</para>
  <para style="q4" vid="PSA 119:71">we yu tijim mi long hem.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Long mi,</para>
  <para style="q2" vid="PSA 119:72">Loa blong yu i gud moa,</para>
  <para style="q3" vid="PSA 119:72">i winim olgeta mane long wol ya.<verse eid="PSA 119:72" /></para>
  <para style="s">Loa blong Hae God i jajem man long stret fasin</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Hae God.</para>
  <para style="q1" vid="PSA 119:73">Yu yu mekem mi,</para>
  <para style="q2" vid="PSA 119:73">mo yu stap lukaot gud long mi</para>
  <para style="q3" vid="PSA 119:73">blong mi mi sef.</para>
  <para style="q1" vid="PSA 119:73">Plis yu givim save long mi</para>
  <para style="q2" vid="PSA 119:73">blong mi save lanem ol tok</para>
  <para style="q3" vid="PSA 119:73">we yu yu putum.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Taem olgeta we oli stap ona long yu</para>
  <para style="q2" vid="PSA 119:74">oli luk mi,</para>
  <para style="q3" vid="PSA 119:74">bambae oli glad</para>
  <para style="q2" vid="PSA 119:74">from we mi mi stap trastem ol tok blong yu oltaem.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />Hae God,</para>
  <para style="q2" vid="PSA 119:75">mi mi save we yu stap jajem man long stret fasin,</para>
  <para style="q3" vid="PSA 119:75">mo we yu yu panisim mi,</para>
  <para style="q4" vid="PSA 119:75">from we yu stap holem tok blong yu.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 119:76">mo oltaem yu yu lavem mi tumas.</para>
  <para style="q1" vid="PSA 119:76">Plis yu mekem</para>
  <para style="q2" vid="PSA 119:76">tingting blong mi i strong bakegen,</para>
  <para style="q3" vid="PSA 119:76">olsem we yu yu promes.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Oltaem mi mi stap harem gud</para>
  <para style="q2" vid="PSA 119:77">long Loa* blong yu.</para>
  <para style="q1" vid="PSA 119:77">Plis yu sore long mi,</para>
  <para style="q3" vid="PSA 119:77">yu givhan long mi,</para>
  <para style="q2" vid="PSA 119:77">nao bambae mi save stap laef.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Ol praod man ya</para>
  <para style="q2" vid="PSA 119:78">oli stap spolem nem blong mi</para>
  <para style="q3" vid="PSA 119:78">long ol giaman toktok blong olgeta.</para>
  <para style="q1" vid="PSA 119:78">Plis yu mekem olgeta oli sem from.</para>
  <para style="q1" vid="PSA 119:78">Be mi,</para>
  <para style="q2" vid="PSA 119:78">oltaem bambae mi stap tingting gud</para>
  <para style="q3" vid="PSA 119:78">long ol loa ya blong yu.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Mi mi wantem</para>
  <para style="q2" vid="PSA 119:79">se olgeta we oli stap ona long yu,</para>
  <para style="q4" vid="PSA 119:79">mo we oli save ol rul we yu yu mekem,</para>
  <para style="q3" vid="PSA 119:79">bambae oli kam long mi.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Plis, mi mi wantem</para>
  <para style="q2" vid="PSA 119:80">blong obei long ol tijing blong yu,</para>
  <para style="q3" vid="PSA 119:80">blong ol man oli no save mekem</para>
  <para style="q4" vid="PSA 119:80">mi mi sem.<verse eid="PSA 119:80" /></para>
  <para style="s">Man i prea blong Hae God i sevem hem</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />Hae God.</para>
  <para style="q1" vid="PSA 119:81">Mi mi slak tumas,</para>
  <para style="q2" vid="PSA 119:81">from we mi stap wet long yu</para>
  <para style="q3" vid="PSA 119:81">blong yu sevem mi.</para>
  <para style="q1" vid="PSA 119:81">Be mi mi putum tingting blong mi</para>
  <para style="q2" vid="PSA 119:81">i stap long tok blong yu.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />Oltaem mi stap waj blong luk</para>
  <para style="q2" vid="PSA 119:82">we promes blong yu i kamtru,</para>
  <para style="q3" vid="PSA 119:82">gogo ae blong mi i soa from.</para>
  <para style="q1" vid="PSA 119:82">Mi stap askem se,</para>
  <para style="q2" vid="PSA 119:82">“?Wetaem bambae yu yu halpem mi?”<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Mi mi kam nogud finis,</para>
  <para style="q2" vid="PSA 119:83">olsem olfala skin* blong nani,</para>
  <para style="q3" vid="PSA 119:83">we i no moa gud</para>
  <para style="q4" vid="PSA 119:83">blong putum waen long hem bakegen,</para>
  <para style="q2" vid="PSA 119:83">be mi stap tingbaot ol tijing blong yu yet.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />?Bambae mi wet gogo kasem wetaem?</para>
  <para style="q1" vid="PSA 119:84">?Wetaem bambae yu panisim olgeta</para>
  <para style="q2" vid="PSA 119:84">we oli stap mekem i nogud tumas long mi?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Ol praod man ya</para>
  <para style="q3" vid="PSA 119:85">we oli no save ona long Loa* blong yu,</para>
  <para style="q2" vid="PSA 119:85">oli putum ol trap finis blong kasem mi.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Olgeta tok we yu yu putum oli stret,</para>
  <para style="q3" vid="PSA 119:86">man i save trastem olgeta,</para>
  <para style="q2" vid="PSA 119:86">be ol man ya oli stap mekem ol giaman toktok</para>
  <para style="q3" vid="PSA 119:86">agens long mi.</para>
  <para style="q1" vid="PSA 119:86">Plis yu givhan long mi.<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Klosap nomo olgeta oli win,</para>
  <para style="q3" vid="PSA 119:87">oli kilim mi mi ded,</para>
  <para style="q2" vid="PSA 119:87">be mi no tanem baksaed nating</para>
  <para style="q4" vid="PSA 119:87">long ol loa blong yu.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Oltaem yu yu lavem mi tumas.</para>
  <para style="q1" vid="PSA 119:88">Plis yu no letem mi mi ded,</para>
  <para style="q2" vid="PSA 119:88">yu holem mi mi stap laef,</para>
  <para style="q3" vid="PSA 119:88">blong mi save obei long ol rul</para>
  <para style="q4" vid="PSA 119:88">we yu yu mekem.<verse eid="PSA 119:88" /></para>
  <para style="s">Prea blong man we i bilif long Loa blong Hae God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />Hae God.</para>
  <para style="q1" vid="PSA 119:89">Tok blong yu bambae i stap</para>
  <para style="q3" vid="PSA 119:89">gogo i no save finis.</para>
  <para style="q1" vid="PSA 119:89">Tok ya i stap long heven,</para>
  <para style="q2" vid="PSA 119:89">mo hem i no gat stat blong hem,</para>
  <para style="q3" vid="PSA 119:89">mo i no gat en blong hem.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Fasin blong yu</para>
  <para style="q3" vid="PSA 119:90">we oltaem yu stap holem ol promes blong yu,</para>
  <para style="q2" vid="PSA 119:90">hem i stap oltaem,</para>
  <para style="q3" vid="PSA 119:90">mo bambae i no save finis.</para>
  <para style="q1" vid="PSA 119:90">Yu yu stanemap wol ya long ples blong hem,</para>
  <para style="q2" vid="PSA 119:90">mo hem i stap kam kasem tede.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Mo from we tingting blong yu i olsem,</para>
  <para style="q2" vid="PSA 119:91">oltaem olgeta samting oli stap mekem wok blong yu.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Bifo,</para>
  <para style="q2" vid="PSA 119:92">mi mi stap harem nogud tumas</para>
  <para style="q3" vid="PSA 119:92">long bodi blong mi,</para>
  <para style="q2" vid="PSA 119:92">mo sipos Loa* blong yu i no stap mekem mi mi glad,</para>
  <para style="q3" vid="PSA 119:92">mi mi ded finis.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Neva bambae mi tanem baksaed</para>
  <para style="q3" vid="PSA 119:93">long ol loa blong yu,</para>
  <para style="q2" vid="PSA 119:93">from we yu yu stap yusum olgeta</para>
  <para style="q4" vid="PSA 119:93">blong holem mi mi stap laef.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Mi mi man blong yu,</para>
  <para style="q2" vid="PSA 119:94">plis yu sevem mi.</para>
  <para style="q1" vid="PSA 119:94">Oltaem mi stap traehad</para>
  <para style="q2" vid="PSA 119:94">blong obei long ol loa ya.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Ol man nogud oli stap wet</para>
  <para style="q3" vid="PSA 119:95">blong kilim mi,</para>
  <para style="q2" vid="PSA 119:95">be mi bambae mi stap tingting</para>
  <para style="q4" vid="PSA 119:95">long ol rul we yu yu mekem.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Mi mi luk finis</para>
  <para style="q3" vid="PSA 119:96">we ol gudgudfala samting oli gat en blong hem,</para>
  <para style="q2" vid="PSA 119:96">be tok we yu yu putum i no gat en blong hem,</para>
  <para style="q3" vid="PSA 119:96">mo bambae i no save finis samtaem.<verse eid="PSA 119:96" /></para>
  <para style="s">Prea blong man we i laekem Loa blong Hae God</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Hae God.</para>
  <para style="q1" vid="PSA 119:97">Mi mi laekem Loa* blong yu tumas,</para>
  <para style="q2" vid="PSA 119:97">mi stap tingting long hem</para>
  <para style="q3" vid="PSA 119:97">i stat long moning, gogo kasem sapa.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Tok ya we yu yu putum</para>
  <para style="q2" vid="PSA 119:98">i stap oltaem long tingting blong mi,</para>
  <para style="q3" vid="PSA 119:98">i stap mekem mi mi waes moa,</para>
  <para style="q4" vid="PSA 119:98">i winim ol enemi blong mi.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />From we oltaem mi mi stap tingting</para>
  <para style="q3" vid="PSA 119:99">long ol rul we yu yu mekem,</para>
  <para style="q2" vid="PSA 119:99">mi mi save plante samting moa,</para>
  <para style="q4" vid="PSA 119:99">i winim ol tija blong mi.</para>
  <para style="q1" vid="PSA 119:99">Psalms <verse eid="PSA 119:99" /><verse number="100" style="v" sid="PSA 119:100" />Oltaem, mi mi stap obei</para>
  <para style="q3" vid="PSA 119:100">long ol loa blong yu</para>
  <para style="q2" vid="PSA 119:100">nao mi mi waes moa,</para>
  <para style="q4" vid="PSA 119:100">i winim ol ololfala.</para>
  <para style="q1" vid="PSA 119:100">Psalms <verse eid="PSA 119:100" /><verse number="101" style="v" sid="PSA 119:101" />Mi mi no save folem ol fasin nogud,</para>
  <para style="q2" vid="PSA 119:101">from we mi wantem obei long ol tok blong yu.</para>
  <para style="q1" vid="PSA 119:101">Psalms <verse eid="PSA 119:101" /><verse number="102" style="v" sid="PSA 119:102" />Mi no save tanem baksaed</para>
  <para style="q3" vid="PSA 119:102">long ol tingting blong yu,</para>
  <para style="q2" vid="PSA 119:102">from we yu yu tija blong mi.</para>
  <para style="q1" vid="PSA 119:102">Psalms <verse eid="PSA 119:102" /><verse number="103" style="v" sid="PSA 119:103" />Mi traem ol tok blong yu,</para>
  <para style="q2" vid="PSA 119:103">mi harem i swit gud.</para>
  <para style="q1" vid="PSA 119:103">Hem i swit we i swit,</para>
  <para style="q2" vid="PSA 119:103">i winim hani.*</para>
  <para style="q1" vid="PSA 119:103">Psalms <verse eid="PSA 119:103" /><verse number="104" style="v" sid="PSA 119:104" />Mi mi kasem waes long ol loa blong yu,</para>
  <para style="q2" vid="PSA 119:104">nao mi no laekem nating ol rabis fasin,</para>
  <para style="q3" vid="PSA 119:104">mi agens long olgeta.</para>
  <para style="s" vid="PSA 119:104">Loa blong Hae God i givim laet long man</para>
  <para style="sp" vid="PSA 119:104">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:104">Psalms <verse eid="PSA 119:104" /><verse number="105" style="v" sid="PSA 119:105" />Hae God.</para>
  <para style="q1" vid="PSA 119:105">Tok blong yu i olsem laet.</para>
  <para style="q1" vid="PSA 119:105">Oltaem hem i stap soemaot rod blong mi,</para>
  <para style="q2" vid="PSA 119:105">mo i stap lidim mi.</para>
  <para style="q1" vid="PSA 119:105">Psalms <verse eid="PSA 119:105" /><verse number="106" style="v" sid="PSA 119:106" />Ol tingting blong yu i stret olgeta.</para>
  <para style="q1" vid="PSA 119:106">Mi mi mekem wan strong promes finis blong folem olgeta,</para>
  <para style="q2" vid="PSA 119:106">mo oltaem bambae mi stap holemgud promes ya.</para>
  <para style="q1" vid="PSA 119:106">Psalms <verse eid="PSA 119:106" /><verse number="107" style="v" sid="PSA 119:107" />Hae God,</para>
  <para style="q2" vid="PSA 119:107">mi mi stap harem nogud tumas long bodi blong mi.</para>
  <para style="q1" vid="PSA 119:107">Plis yu holem mi mi stap laef,</para>
  <para style="q2" vid="PSA 119:107">olsem we tok blong yu i talem.</para>
  <para style="q1" vid="PSA 119:107">Psalms <verse eid="PSA 119:107" /><verse number="108" style="v" sid="PSA 119:108" />Hae God,</para>
  <para style="q2" vid="PSA 119:108">mi mi presem nem blong yu.</para>
  <para style="q1" vid="PSA 119:108">Plis yu harem prea blong mi,</para>
  <para style="q2" vid="PSA 119:108">mo yu tijim mi,</para>
  <para style="q3" vid="PSA 119:108">blong mi savegud ol tingting blong yu.</para>
  <para style="q1" vid="PSA 119:108">Psalms <verse eid="PSA 119:108" /><verse number="109" style="v" sid="PSA 119:109" />Oltaem mi mi stap pas klosap nomo long ded,</para>
  <para style="q2" vid="PSA 119:109">be mi no save fogetem Loa* blong yu.</para>
  <para style="q1" vid="PSA 119:109">Psalms <verse eid="PSA 119:109" /><verse number="110" style="v" sid="PSA 119:110" />Ol man nogud oli putum wan trap</para>
  <para style="q3" vid="PSA 119:110">blong kasem mi,</para>
  <para style="q2" vid="PSA 119:110">be mi mi no tanem baksaed</para>
  <para style="q4" vid="PSA 119:110">long ol loa blong yu.</para>
  <para style="q1" vid="PSA 119:110">Psalms <verse eid="PSA 119:110" /><verse number="111" style="v" sid="PSA 119:111" />Ol rul we yu yu mekem,</para>
  <para style="q2" vid="PSA 119:111">bambae oli rul blong mi oltaem nomo.</para>
  <para style="q1" vid="PSA 119:111">Oltaem oli stap mekem tingting</para>
  <para style="q2" vid="PSA 119:111">blong mi i glad tumas.</para>
  <para style="q1" vid="PSA 119:111">Psalms <verse eid="PSA 119:111" /><verse number="112" style="v" sid="PSA 119:112" />Mi talem finis,</para>
  <para style="q2" vid="PSA 119:112">se oltaem, bambae mi mi stap obei</para>
  <para style="q3" vid="PSA 119:112">long ol tijing blong yu,</para>
  <para style="q4" vid="PSA 119:112">gogo kasem we mi mi ded.</para>
  <para style="s" vid="PSA 119:112">Loa blong Hae God i save sevem man</para>
  <para style="sp" vid="PSA 119:112">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:112">Psalms <verse eid="PSA 119:112" /><verse number="113" style="v" sid="PSA 119:113" />Hae God.</para>
  <para style="q1" vid="PSA 119:113">Mi mi laekem Loa* blong yu tumas,</para>
  <para style="q2" vid="PSA 119:113">be olgeta we oli gat tu tingting,</para>
  <para style="q3" vid="PSA 119:113">mi mi no laekem olgeta nating.</para>
  <para style="q1" vid="PSA 119:113">Psalms <verse eid="PSA 119:113" /><verse number="114" style="v" sid="PSA 119:114" />Yu yu stap lukaot gud long mi,</para>
  <para style="q2" vid="PSA 119:114">mo yu stap blokemgud mi.</para>
  <para style="q1" vid="PSA 119:114">Oltaem mi mi putum tingting blong mi</para>
  <para style="q2" vid="PSA 119:114">i stap long tok blong yu nomo.</para>
  <para style="sp" vid="PSA 119:114">(Tok i go long ol man.)</para>
  <para style="q1" vid="PSA 119:114">Psalms <verse eid="PSA 119:114" /><verse number="115" style="v" sid="PSA 119:115" />!Ol man nogud!</para>
  <para style="q1" vid="PSA 119:115">Yufala i gowe long mi,</para>
  <para style="q2" vid="PSA 119:115">blong mi save obei long ol tok</para>
  <para style="q3" vid="PSA 119:115">we God blong mi i putum.<verse eid="PSA 119:115" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Hae God.</para>
  <para style="q1" vid="PSA 119:116">Plis yu mekem mi mi strong</para>
  <para style="q2" vid="PSA 119:116">olsem we yu yu promes,</para>
  <para style="q3" vid="PSA 119:116">nao bambae mi stap laef.</para>
  <para style="q1" vid="PSA 119:116">Mi mi putum tingting blong mi i stap long yu.</para>
  <para style="q1" vid="PSA 119:116">Plis yu no letem</para>
  <para style="q2" vid="PSA 119:116">tingting blong mi i foldaon bakegen.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Plis yu holem han blong mi</para>
  <para style="q3" vid="PSA 119:117">blong mi save sef,</para>
  <para style="q2" vid="PSA 119:117">nao oltaem</para>
  <para style="q3" vid="PSA 119:117">bambae mi stap tingbaot ol tijing blong yu.</para>
  <para style="q1" vid="PSA 119:117">Psalms <verse eid="PSA 119:117" /><verse number="118" style="v" sid="PSA 119:118" />Yu yu stap tanem baksaed long olgeta</para>
  <para style="q3" vid="PSA 119:118">we oli no save obei long ol tijing blong yu,</para>
  <para style="q2" vid="PSA 119:118">nao ol rabis trik blong olgeta</para>
  <para style="q4" vid="PSA 119:118">oli blong nating nomo.</para>
  <para style="q1" vid="PSA 119:118">Psalms <verse eid="PSA 119:118" /><verse number="119" style="v" sid="PSA 119:119" />Olgeta man nogud long wol ya,</para>
  <para style="q2" vid="PSA 119:119">yu yu stap luk olgeta olsem rabis nomo,</para>
  <para style="q3" vid="PSA 119:119">taswe mi mi laekem ol rul</para>
  <para style="q4" vid="PSA 119:119">we yu yu mekem.</para>
  <para style="q1" vid="PSA 119:119">Psalms <verse eid="PSA 119:119" /><verse number="120" style="v" sid="PSA 119:120" />Taem mi tingbaot fasin blong yu blong jajem man,</para>
  <para style="q2" vid="PSA 119:120">mi mi fraet we mi fraet,</para>
  <para style="q3" vid="PSA 119:120">nao mi seksek from.</para>
  <para style="s" vid="PSA 119:120">Prea blong man we i obei long Loa blong Hae God</para>
  <para style="sp" vid="PSA 119:120">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:120">Psalms <verse eid="PSA 119:120" /><verse number="121" style="v" sid="PSA 119:121" />Hae God.</para>
  <para style="q1" vid="PSA 119:121">Oltaem mi mi stap mekem ol samting</para>
  <para style="q2" vid="PSA 119:121">we i gud mo i stret.</para>
  <para style="q1" vid="PSA 119:121">Plis yu no letem</para>
  <para style="q2" vid="PSA 119:121">mi mi go long han blong olgeta</para>
  <para style="q3" vid="PSA 119:121">we oli wantem spolem mi.</para>
  <para style="q1" vid="PSA 119:121">Psalms <verse eid="PSA 119:121" /><verse number="122" style="v" sid="PSA 119:122" />Mi mi man blong wok blong yu.</para>
  <para style="q1" vid="PSA 119:122">Mi wantem blong yu yu promes</para>
  <para style="q2" vid="PSA 119:122">se bambae yu givhan long mi.</para>
  <para style="q1" vid="PSA 119:122">Plis yu no letem</para>
  <para style="q2" vid="PSA 119:122">ol praod man oli daonem mi,</para>
  <para style="q3" vid="PSA 119:122">oli spolem mi.</para>
  <para style="q1" vid="PSA 119:122">Psalms <verse eid="PSA 119:122" /><verse number="123" style="v" sid="PSA 119:123" />Yu yu promes finis blong sevem mi,</para>
  <para style="q2" vid="PSA 119:123">mo oltaem mi stap waj</para>
  <para style="q3" vid="PSA 119:123">blong luk gudfala promes ya blong yu i kamtru,</para>
  <para style="q4" vid="PSA 119:123">gogo ae blong mi i soa from.</para>
  <para style="q1" vid="PSA 119:123">Psalms <verse eid="PSA 119:123" /><verse number="124" style="v" sid="PSA 119:124" />Oltaem yu yu lavem man tumas.</para>
  <para style="q1" vid="PSA 119:124">Plis yu mekem olsem long mi,</para>
  <para style="q2" vid="PSA 119:124">mo yu tijim mi long ol rod blong yu.</para>
  <para style="q1" vid="PSA 119:124">Psalms <verse eid="PSA 119:124" /><verse number="125" style="v" sid="PSA 119:125" />Mi mi man blong wok blong yu.</para>
  <para style="q1" vid="PSA 119:125">Plis yu givhan long mi</para>
  <para style="q2" vid="PSA 119:125">blong mi savegud ol tok blong yu,</para>
  <para style="q3" vid="PSA 119:125">blong mi save kasem ol rul</para>
  <para style="q4" vid="PSA 119:125">we yu yu mekem.</para>
  <para style="q1" vid="PSA 119:125">Psalms <verse eid="PSA 119:125" /><verse number="126" style="v" sid="PSA 119:126" />Hae God,</para>
  <para style="q2" vid="PSA 119:126">naoia i taem blong yu yu mekem</para>
  <para style="q3" vid="PSA 119:126">wan samting long ol man ya,</para>
  <para style="q2" vid="PSA 119:126">from we oli no save obei long Loa* blong yu.</para>
  <para style="q1" vid="PSA 119:126">Psalms <verse eid="PSA 119:126" /><verse number="127" style="v" sid="PSA 119:127" />Ol tok we yu yu putum,</para>
  <para style="q2" vid="PSA 119:127">mi mi laekem olgeta</para>
  <para style="q3" vid="PSA 119:127">i winim we mi laekem gol,</para>
  <para style="q4" vid="PSA 119:127">i winim we mi laekem gudfala gol ya</para>
  <para style="q3" vid="PSA 119:127">we i klin gud, i beswan,</para>
  <para style="q1" vid="PSA 119:127">Psalms <verse eid="PSA 119:127" /><verse number="128" style="v" sid="PSA 119:128" />taswe mi stap folem ol loa blong yu.</para>
  <para style="q1" vid="PSA 119:128">Be olgeta fasin we i no stret,</para>
  <para style="q2" vid="PSA 119:128">mi mi no laekem olgeta nating,</para>
  <para style="q3" vid="PSA 119:128">mi agens long olgeta.</para>
  <para style="s" vid="PSA 119:128">Prea blong man we i wantem obei long Loa blong Hae God</para>
  <para style="sp" vid="PSA 119:128">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:128">Psalms <verse eid="PSA 119:128" /><verse number="129" style="v" sid="PSA 119:129" />Hae God.</para>
  <para style="q1" vid="PSA 119:129">Ol rul we yu yu mekem</para>
  <para style="q3" vid="PSA 119:129">oli gud we i gud,</para>
  <para style="q2" vid="PSA 119:129">taswe mi mi glad tumas</para>
  <para style="q4" vid="PSA 119:129">blong obei long olgeta.</para>
  <para style="q1" vid="PSA 119:129">Psalms <verse eid="PSA 119:129" /><verse number="130" style="v" sid="PSA 119:130" />Taem mining blong ol tok blong yu i klia,</para>
  <para style="q2" vid="PSA 119:130">hem i givim laet long man,</para>
  <para style="q3" vid="PSA 119:130">mo i mekem</para>
  <para style="q4" vid="PSA 119:130">man we i no gat save i kam waes.</para>
  <para style="q1" vid="PSA 119:130">Psalms <verse eid="PSA 119:130" /><verse number="131" style="v" sid="PSA 119:131" />Mi mi wantem tumas</para>
  <para style="q3" vid="PSA 119:131">blong kasem ol tok we yu yu putum,</para>
  <para style="q2" vid="PSA 119:131">olsem anamol we i tosta tumas</para>
  <para style="q4" vid="PSA 119:131">i wantem dring.</para>
  <para style="q1" vid="PSA 119:131">Psalms <verse eid="PSA 119:131" /><verse number="132" style="v" sid="PSA 119:132" />Plis yu lukluk i kam long mi,</para>
  <para style="q2" vid="PSA 119:132">yu givhan long mi long gladhat blong yu,</para>
  <para style="q3" vid="PSA 119:132">olsem we yu stap mekem oltaem</para>
  <para style="q4" vid="PSA 119:132">long olgeta we oli lavem yu.</para>
  <para style="q1" vid="PSA 119:132">Psalms <verse eid="PSA 119:132" /><verse number="133" style="v" sid="PSA 119:133" />Plis yu lukaot gud long mi</para>
  <para style="q2" vid="PSA 119:133">blong mi no foldaon long sin.</para>
  <para style="q1" vid="PSA 119:133">Plis yu holem promes blong yu,</para>
  <para style="q2" vid="PSA 119:133">yu no letem rabis fasin i winim mi.</para>
  <para style="q1" vid="PSA 119:133">Psalms <verse eid="PSA 119:133" /><verse number="134" style="v" sid="PSA 119:134" />Plis yu tekemaot mi long han blong olgeta</para>
  <para style="q3" vid="PSA 119:134">we oli stap spolem mi,</para>
  <para style="q2" vid="PSA 119:134">blong mi save obei long ol loa blong yu.</para>
  <para style="q1" vid="PSA 119:134">Psalms <verse eid="PSA 119:134" /><verse number="135" style="v" sid="PSA 119:135" />Yu yu stap wetem mi.</para>
  <para style="q1" vid="PSA 119:135">Plis yu tijim mi long ol rod blong yu,</para>
  <para style="q2" vid="PSA 119:135">mo yu mekem mi mi harem gud.</para>
  <para style="q1" vid="PSA 119:135">Psalms <verse eid="PSA 119:135" /><verse number="136" style="v" sid="PSA 119:136" />Oltaem mi mi stap krae tumas,</para>
  <para style="q2" vid="PSA 119:136">from we ol man oli no save obei</para>
  <para style="q3" vid="PSA 119:136">long Loa* blong yu.</para>
  <para style="s" vid="PSA 119:136">Stret fasin i kamaot long Loa blong Hae God</para>
  <para style="sp" vid="PSA 119:136">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:136">Psalms <verse eid="PSA 119:136" /><verse number="137" style="v" sid="PSA 119:137" />Hae God.</para>
  <para style="q1" vid="PSA 119:137">Yu yu stret olgeta,</para>
  <para style="q2" vid="PSA 119:137">mo yu stap jajem man long stret fasin.</para>
  <para style="q1" vid="PSA 119:137">Psalms <verse eid="PSA 119:137" /><verse number="138" style="v" sid="PSA 119:138" />Ol rul we yu yu mekem oli stret gud,</para>
  <para style="q2" vid="PSA 119:138">mo oli wok sem mak nomo long olgeta man.</para>
  <para style="q1" vid="PSA 119:138">Psalms <verse eid="PSA 119:138" /><verse number="139" style="v" sid="PSA 119:139" />Mi mi kros</para>
  <para style="q3" vid="PSA 119:139">we tingting blong mi i hot we i hot,</para>
  <para style="q2" vid="PSA 119:139">from we ol enemi blong mi</para>
  <para style="q4" vid="PSA 119:139">oli fogetem ol tok blong yu.</para>
  <para style="q1" vid="PSA 119:139">Psalms <verse eid="PSA 119:139" /><verse number="140" style="v" sid="PSA 119:140" />!Promes blong yu i tru we i tru!</para>
  <para style="q2" vid="PSA 119:140">!Mi mi laekem tumas!</para>
  <para style="q1" vid="PSA 119:140">Psalms <verse eid="PSA 119:140" /><verse number="141" style="v" sid="PSA 119:141" />Mi mi man nating nomo,</para>
  <para style="q2" vid="PSA 119:141">mo ol man oli stap lukluk nogud long mi,</para>
  <para style="q3" vid="PSA 119:141">be mi mi no save lego ol loa blong yu.</para>
  <para style="q1" vid="PSA 119:141">Psalms <verse eid="PSA 119:141" /><verse number="142" style="v" sid="PSA 119:142" />Stret fasin blong yu bambae i stap olwe</para>
  <para style="q3" vid="PSA 119:142">gogo i no save finis,</para>
  <para style="q2" vid="PSA 119:142">mo Loa* blong yu i tru olgeta.</para>
  <para style="q1" vid="PSA 119:142">Psalms <verse eid="PSA 119:142" /><verse number="143" style="v" sid="PSA 119:143" />Oltaem mi mi trabol mo mi wari tumas,</para>
  <para style="q2" vid="PSA 119:143">be ol tok we yu yu putum</para>
  <para style="q3" vid="PSA 119:143">oli stap mekem mi mi glad.</para>
  <para style="q1" vid="PSA 119:143">Psalms <verse eid="PSA 119:143" /><verse number="144" style="v" sid="PSA 119:144" />Oltaem ol rul we yu yu mekem oli stret nomo.</para>
  <para style="q1" vid="PSA 119:144">Plis yu givhan long mi blong mi savegud olgeta,</para>
  <para style="q2" vid="PSA 119:144">nao bambae mi save stap gud long laef blong mi.</para>
  <para style="s" vid="PSA 119:144">Man i prea blong Hae God i sevem hem</para>
  <para style="sp" vid="PSA 119:144">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:144">Psalms <verse eid="PSA 119:144" /><verse number="145" style="v" sid="PSA 119:145" />Hae God.</para>
  <para style="q1" vid="PSA 119:145">Mi mi stap krae long yu</para>
  <para style="q3" vid="PSA 119:145">long olgeta tingting blong mi.</para>
  <para style="q1" vid="PSA 119:145">Plis yu harem krae blong mi.</para>
  <para style="q1" vid="PSA 119:145">Mi mi promes blong obei long ol tijing blong yu.</para>
  <para style="q1" vid="PSA 119:145">Psalms <verse eid="PSA 119:145" /><verse number="146" style="v" sid="PSA 119:146" />Mi mi stap krae long yu.</para>
  <para style="q1" vid="PSA 119:146">Plis yu sevem mi,</para>
  <para style="q2" vid="PSA 119:146">blong mi save holem ol rul</para>
  <para style="q3" vid="PSA 119:146">we yu yu mekem.</para>
  <para style="q1" vid="PSA 119:146">Psalms <verse eid="PSA 119:146" /><verse number="147" style="v" sid="PSA 119:147" />Oltaem, taem san i no girap yet,</para>
  <para style="q2" vid="PSA 119:147">mi stap krae long yu</para>
  <para style="q3" vid="PSA 119:147">blong yu givhan long mi.</para>
  <para style="q1" vid="PSA 119:147">Mi putum tingting blong mi</para>
  <para style="q2" vid="PSA 119:147">i stap long ol tok blong yu.</para>
  <para style="q1" vid="PSA 119:147">Psalms <verse eid="PSA 119:147" /><verse number="148" style="v" sid="PSA 119:148" />Oltaem, long naet,</para>
  <para style="q3" vid="PSA 119:148">mi no save slip,</para>
  <para style="q2" vid="PSA 119:148">mi stap tingting long ol promes blong yu.</para>
  <para style="q1" vid="PSA 119:148">Psalms <verse eid="PSA 119:148" /><verse number="149" style="v" sid="PSA 119:149" />Hae God,</para>
  <para style="q2" vid="PSA 119:149">oltaem yu yu lavem man tumas,</para>
  <para style="q3" vid="PSA 119:149">plis yu harem mi.</para>
  <para style="q1" vid="PSA 119:149">Yu yu stap jajem man long stret fasin.</para>
  <para style="q1" vid="PSA 119:149">Plis yu lukaot gud long laef blong mi.</para>
  <para style="q1" vid="PSA 119:149">Psalms <verse eid="PSA 119:149" /><verse number="150" style="v" sid="PSA 119:150" />Ol man nogud ya we oli stap spolem mi,</para>
  <para style="q2" vid="PSA 119:150">naoia oli kam klosap long mi.</para>
  <para style="q1" vid="PSA 119:150">Be olgeta ya,</para>
  <para style="q2" vid="PSA 119:150">neva oli holem Loa* blong yu.</para>
  <para style="q1" vid="PSA 119:150">Psalms <verse eid="PSA 119:150" /><verse number="151" style="v" sid="PSA 119:151" />Be yu, Hae God,</para>
  <para style="q3" vid="PSA 119:151">oltaem yu stap klosap moa long mi,</para>
  <para style="q2" vid="PSA 119:151">mo ol tok we yu yu putum</para>
  <para style="q4" vid="PSA 119:151">oli tru olgeta.</para>
  <para style="q1" vid="PSA 119:151">Psalms <verse eid="PSA 119:151" /><verse number="152" style="v" sid="PSA 119:152" />Ol rul ya we yu yu mekem,</para>
  <para style="q2" vid="PSA 119:152">mi mi save olgeta longtaem finis.</para>
  <para style="q1" vid="PSA 119:152">Yu yu putum olgeta blong oli stap oltaem,</para>
  <para style="q2" vid="PSA 119:152">gogo i no save finis.</para>
  <para style="s" vid="PSA 119:152">Man i prea blong Hae God i givhan long hem</para>
  <para style="sp" vid="PSA 119:152">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:152">Psalms <verse eid="PSA 119:152" /><verse number="153" style="v" sid="PSA 119:153" />Hae God.</para>
  <para style="q1" vid="PSA 119:153">Mi mi stap harem nogud tumas</para>
  <para style="q3" vid="PSA 119:153">long bodi blong mi.</para>
  <para style="q1" vid="PSA 119:153">Plis yu luk long mi,</para>
  <para style="q2" vid="PSA 119:153">yu tekemaot mi long trabol ya,</para>
  <para style="q3" vid="PSA 119:153">from we mi no save lego Loa* blong yu.</para>
  <para style="q1" vid="PSA 119:153">Psalms <verse eid="PSA 119:153" /><verse number="154" style="v" sid="PSA 119:154" />Plis yu givhan long mi,</para>
  <para style="q2" vid="PSA 119:154">yu mekem mi mi fri,</para>
  <para style="q3" vid="PSA 119:154">yu sevem mi olsem we yu yu promes.</para>
  <para style="q1" vid="PSA 119:154">Psalms <verse eid="PSA 119:154" /><verse number="155" style="v" sid="PSA 119:155" />Ol man nogud,</para>
  <para style="q3" vid="PSA 119:155">yu no save sevem olgeta,</para>
  <para style="q2" vid="PSA 119:155">from we oli no save obei</para>
  <para style="q4" vid="PSA 119:155">long ol tijing blong yu.</para>
  <para style="q1" vid="PSA 119:155">Psalms <verse eid="PSA 119:155" /><verse number="156" style="v" sid="PSA 119:156" />Hae God,</para>
  <para style="q2" vid="PSA 119:156">fasin blong yu we yu gat sore long man,</para>
  <para style="q3" vid="PSA 119:156">hem i bigfala tumas.</para>
  <para style="q1" vid="PSA 119:156">Plis yu jajem mi long stret fasin,</para>
  <para style="q2" vid="PSA 119:156">yu sevem mi.</para>
  <para style="q1" vid="PSA 119:156">Psalms <verse eid="PSA 119:156" /><verse number="157" style="v" sid="PSA 119:157" />Mi mi gat plante enemi blong mi</para>
  <para style="q3" vid="PSA 119:157">we oli stap traem blong spolem mi,</para>
  <para style="q2" vid="PSA 119:157">be mi mi no foldaon nating,</para>
  <para style="q3" vid="PSA 119:157">oltaem mi stap obei long ol rul</para>
  <para style="q4" vid="PSA 119:157">we yu yu mekem.</para>
  <para style="q1" vid="PSA 119:157">Psalms <verse eid="PSA 119:157" /><verse number="158" style="v" sid="PSA 119:158" />Taem mi luk ol man blong yu</para>
  <para style="q3" vid="PSA 119:158">we oli stap joen wetem ol enemi blong yu,</para>
  <para style="q2" vid="PSA 119:158">mi no wantem olgeta nating,</para>
  <para style="q3" vid="PSA 119:158">from we oli no moa holem ol tok blong yu.</para>
  <para style="q1" vid="PSA 119:158">Psalms <verse eid="PSA 119:158" /><verse number="159" style="v" sid="PSA 119:159" />Hae God,</para>
  <para style="q2" vid="PSA 119:159">oltaem yu yu lavem man tumas.</para>
  <para style="q1" vid="PSA 119:159">Plis yu lukluk gud long mi.</para>
  <para style="q1" vid="PSA 119:159">Mi mi laekem ol loa blong yu tumas,</para>
  <para style="q2" vid="PSA 119:159">plis yu sevem mi.</para>
  <para style="q1" vid="PSA 119:159">Psalms <verse eid="PSA 119:159" /><verse number="160" style="v" sid="PSA 119:160" />Stamba blong ol tok blong yu,</para>
  <para style="q2" vid="PSA 119:160">hem i trutok.</para>
  <para style="q1" vid="PSA 119:160">Ol tingting blong yu oli stret nomo,</para>
  <para style="q2" vid="PSA 119:160">mo bambae oli stap oltaem,</para>
  <para style="q3" vid="PSA 119:160">gogo i no save finis.</para>
  <para style="s" vid="PSA 119:160">Prea blong man we i laekem Loa blong Hae God</para>
  <para style="sp" vid="PSA 119:160">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:160">Psalms <verse eid="PSA 119:160" /><verse number="161" style="v" sid="PSA 119:161" />Hae God.</para>
  <para style="q1" vid="PSA 119:161">Ol haeman oli stap spolem mi tumas,</para>
  <para style="q2" vid="PSA 119:161">be from nating nomo.</para>
  <para style="q1" vid="PSA 119:161">Oltaem mi stap tinghevi</para>
  <para style="q2" vid="PSA 119:161">long ol tok blong yu.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Mi mi glad tumas long ol tok blong yu.</para>
  <para style="q1" vid="PSA 119:162">Mi glad we mi glad,</para>
  <para style="q2" vid="PSA 119:162">olsem man we i win long faet,</para>
  <para style="q3" vid="PSA 119:162">i karem plante gudgudfala samting i kamhom.</para>
  <para style="q1" vid="PSA 119:162">Psalms <verse eid="PSA 119:162" /><verse number="163" style="v" sid="PSA 119:163" />Mi mi no laekem nating</para>
  <para style="q2" vid="PSA 119:163">ol fasin blong giaman,</para>
  <para style="q3" vid="PSA 119:163">mi agens long olgeta,</para>
  <para style="q2" vid="PSA 119:163">be mi laekem Loa* blong yu tumas.</para>
  <para style="q1" vid="PSA 119:163">Psalms <verse eid="PSA 119:163" /><verse number="164" style="v" sid="PSA 119:164" />Ol tingting blong yu i stret gud,</para>
  <para style="q2" vid="PSA 119:164">mo from samting ya,</para>
  <para style="q3" vid="PSA 119:164">mi mi stap leftemap nem blong yu</para>
  <para style="q4" vid="PSA 119:164">seven taem long wan dei.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Olgeta we oli laekem Loa blong yu</para>
  <para style="q2" vid="PSA 119:165">oli stap gud oltaem nomo,</para>
  <para style="q3" vid="PSA 119:165">i no gat wan samting</para>
  <para style="q4" vid="PSA 119:165">we i save mekem olgeta oli foldaon.</para>
  <para style="q1" vid="PSA 119:165">Psalms <verse eid="PSA 119:165" /><verse number="166" style="v" sid="PSA 119:166" />Hae God,</para>
  <para style="q2" vid="PSA 119:166">mi mi stap wet long yu blong yu sevem mi,</para>
  <para style="q3" vid="PSA 119:166">mo oltaem mi stap folem ol tok we yu yu putum.</para>
  <para style="q1" vid="PSA 119:166">Psalms <verse eid="PSA 119:166" /><verse number="167" style="v" sid="PSA 119:167" />Mi stap obei long ol rul we yu yu mekem,</para>
  <para style="q2" vid="PSA 119:167">mo mi laekem olgeta tumas.</para>
  <para style="q1" vid="PSA 119:167">Psalms <verse eid="PSA 119:167" /><verse number="168" style="v" sid="PSA 119:168" />Mi stap obei long ol rul mo ol loa blong yu.</para>
  <para style="q1" vid="PSA 119:168">Yu yu stap luk evri samting we mi mi mekem.</para>
  <para style="s" vid="PSA 119:168">Man i prea blong Hae God givhan long hem</para>
  <para style="sp" vid="PSA 119:168">(Tok i go long Hae God.)</para>
  <para style="q1" vid="PSA 119:168">Psalms <verse eid="PSA 119:168" /><verse number="169" style="v" sid="PSA 119:169" />Hae God.</para>
  <para style="q1" vid="PSA 119:169">Plis yu harem krae blong mi,</para>
  <para style="q2" vid="PSA 119:169">yu givhan long mi.</para>
  <para style="q1" vid="PSA 119:169">Plis yu mekem</para>
  <para style="q2" vid="PSA 119:169">mi mi savegud ol tok blong yu,</para>
  <para style="q3" vid="PSA 119:169">olsem we yu yu promes.</para>
  <para style="q1" vid="PSA 119:169">Psalms <verse eid="PSA 119:169" /><verse number="170" style="v" sid="PSA 119:170" />Plis yu lesin long prea blong mi,</para>
  <para style="q2" vid="PSA 119:170">mo yu sevem mi,</para>
  <para style="q3" vid="PSA 119:170">olsem we tok blong yu i talem.</para>
  <para style="q1" vid="PSA 119:170">Psalms <verse eid="PSA 119:170" /><verse number="171" style="v" sid="PSA 119:171" />Oltaem bambae mi stap presem yu,</para>
  <para style="q2" vid="PSA 119:171">from we yu stap tijim mi</para>
  <para style="q3" vid="PSA 119:171">long ol rod blong yu.</para>
  <para style="q1" vid="PSA 119:171">Psalms <verse eid="PSA 119:171" /><verse number="172" style="v" sid="PSA 119:172" />Bambae mi singsing</para>
  <para style="q3" vid="PSA 119:172">blong tokbaot ol tok blong yu,</para>
  <para style="q2" vid="PSA 119:172">from we olgeta tok we yu yu putum</para>
  <para style="q4" vid="PSA 119:172">oli stret nomo.</para>
  <para style="q1" vid="PSA 119:172">Psalms <verse eid="PSA 119:172" /><verse number="173" style="v" sid="PSA 119:173" />Plis yu mas rere oltaem blong givhan long mi,</para>
  <para style="q2" vid="PSA 119:173">from we mi stap folem ol loa blong yu.</para>
  <para style="q1" vid="PSA 119:173">Psalms <verse eid="PSA 119:173" /><verse number="174" style="v" sid="PSA 119:174" />Hae God,</para>
  <para style="q2" vid="PSA 119:174">mi mi wantem tumas blong yu sevem mi,</para>
  <para style="q3" vid="PSA 119:174">from we oltaem,</para>
  <para style="q4" vid="PSA 119:174">Loa* blong yu i stap mekem</para>
  <para style="q3" vid="PSA 119:174">mi mi glad tumas.</para>
  <para style="q1" vid="PSA 119:174">Psalms <verse eid="PSA 119:174" /><verse number="175" style="v" sid="PSA 119:175" />Plis yu holem mi mi stap laef</para>
  <para style="q3" vid="PSA 119:175">blong mi save presem yu,</para>
  <para style="q2" vid="PSA 119:175">mo yu letem</para>
  <para style="q4" vid="PSA 119:175">ol tingting blong yu i lidim mi.</para>
  <para style="q1" vid="PSA 119:175">Psalms <verse eid="PSA 119:175" /><verse number="176" style="v" sid="PSA 119:176" />Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 119:176">be mi lusum rod olsem wan sipsip we i lus.</para>
  <para style="q1" vid="PSA 119:176">Plis yu kam lukaot mi,</para>
  <para style="q2" vid="PSA 119:176">from we mi mi no tanem baksaed</para>
  <para style="q3" vid="PSA 119:176">long ol tok we yu yu putum.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">Man i prea blong Hae God i givhan long hem</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet*<note caller="+" style="f"><char style="fr" closed="false">120.0 </char><char style="fqa" closed="false">Fastok: </char><char style="ft" closed="false">Loa blong God i talem se evri yia, ol laen blong Isrel oli mas kam wanples tri taem, blong mekem lafet blong olgeta blong mekem wosip long God. Ol lafet ya, i gat Lafet blong Pasova, mo Lafet blong Tekemaot Kakae long Garen we biaen oli kolem Lafet blong Pentekos, mo Lafet blong Wokem ol Wansaed Haos. Yu luk Eksodas 23.14-17. Taem olgeta oli stap wokbaot blong go antap long Jerusalem blong mekem ol lafet ya, i gat fiftin sam we oli stap singsing long olgeta. Ol sam ya i stat long Sam 120 i go kasem Sam 134.</char></note>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Olgeta.</para>
  <para style="q1" vid="PSA 120:1">Taem mi mi stap long trabol,</para>
  <para style="q2" vid="PSA 120:1">mi krae long Hae God,</para>
  <para style="q3" vid="PSA 120:1">mo hem i harem krae blong mi.<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />Mi talem se, “Hae God,</para>
  <para style="q3" vid="PSA 120:2">plis yu blokemgud mi</para>
  <para style="q4" vid="PSA 120:2">blong ol man blong giaman <optbreak /> mo ol man blong mekem trik</para>
  <para style="q3" vid="PSA 120:2">oli no save spolem mi.”<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />?Yufala ol man blong giaman,</para>
  <para style="q2" vid="PSA 120:3">yufala i save ol samting ya</para>
  <para style="q3" vid="PSA 120:3">we God bambae i mekem long yufala?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Panis blong yufala bambae i olsem</para>
  <para style="q2" vid="PSA 120:4">we sap ara blong soldia i stikim yufala.</para>
  <para style="q1" vid="PSA 120:4">Bambae yufala i harem</para>
  <para style="q2" vid="PSA 120:4">olsem we faea i bonem yufala.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Taem mi stap wetem yufala,</para>
  <para style="q3" vid="PSA 120:5">mi harem nogud tumas,</para>
  <para style="q2" vid="PSA 120:5">olsem we mi stap long kantri ya Mesek<note caller="+" style="f"><char style="fr" closed="false">120.5: </char><char style="ft" closed="false">Tufala ples ya Mesek mo Kedara, tufala i stap longlongwe long tufala, mo tufala i longwe long Isrel tu, be tufala i ples blong ol hiten man we oli no save God nating.</char></note>,</para>
  <para style="q3" vid="PSA 120:5">no mi go stap wetem ol man Kedara<char style="fm">F.</char><verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Mi mi stap longtaem tumas wetem yufala</para>
  <para style="q2" vid="PSA 120:6">we i no laekem pis nating.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Taem mi mi tokbaot pis,</para>
  <para style="q2" vid="PSA 120:7">be yufala i wantem mekem faet nomo.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">Hae God i blokemgud yumi, i stap lukaot gud long yumi</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Olgeta.</para>
  <para style="q1" vid="PSA 121:1">?Man blong givhan long mi</para>
  <para style="q2" vid="PSA 121:1">bambae i kamaot long weples?</para>
  <para style="q1" vid="PSA 121:1">Mi mi lukluk i go antap long ol hil,</para>
  <para style="q2" vid="PSA 121:1">be no, i nogat.<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Hae God ya we i mekem skae mo graon,</para>
  <para style="q2" vid="PSA 121:2">hem nomo i stap givhan long mi.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Hem bambae i no save letem yumi foldaon.</para>
  <para style="q1" vid="PSA 121:3">Hem i no save slip,</para>
  <para style="q2" vid="PSA 121:3">mo oltaem hem i stap lukaot gud long yumi.<verse eid="PSA 121:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 121:4">mo oltaem hem i stap lukaot gud long yumi.</para>
  <para style="q1" vid="PSA 121:4">Neva ae blong hem i kam hevi,</para>
  <para style="q2" vid="PSA 121:4">mo neva hem i slip.<verse eid="PSA 121:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />Hem bambae i glad long yumi,</para>
  <para style="q2" vid="PSA 121:5">hem bambae i stap long raet saed blong yumi</para>
  <para style="q3" vid="PSA 121:5">blong lukaot long yumi.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Long dei,</para>
  <para style="q3" vid="PSA 121:6">san bambae i no save spolem yumi,</para>
  <para style="q2" vid="PSA 121:6">mo long naet,</para>
  <para style="q4" vid="PSA 121:6">mun<note caller="+" style="f"><char style="fr" closed="false">121.6: </char><char style="ft" closed="false">Long plante ples, ol man oli ting se mun i stap mekem man we i hafhafkrangke i kam krangke moa.</char></note> tu bambae i no save mekem i nogud long yumi.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />Hae God bambae i blokemgud yumi</para>
  <para style="q3" vid="PSA 121:7">blong trabol i no save kasem yumi.</para>
  <para style="q1" vid="PSA 121:7">Hem bambae i lukaot gud long yumi,</para>
  <para style="q4" vid="PSA 121:7">i sevem yumi.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />Taem yumi goaot long haos blong yumi,</para>
  <para style="q3" vid="PSA 121:8">gogo yumi kambak bakegen,</para>
  <para style="q2" vid="PSA 121:8">be hem i stap lukaot gud long yumi.</para>
  <para style="q1" vid="PSA 121:8">Hem bambae i save lukaot gud long yumi oltaem nomo,</para>
  <para style="q2" vid="PSA 121:8">i stat naoia,</para>
  <para style="q4" vid="PSA 121:8">gogo i no save finis.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">Man i presem Hae God from we i go insaed long Jerusalem</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long taon ya Jerusalem, ples blong haos blong Hae God.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 122:1-2" />!Jerusalem!</para>
  <para style="q1" vid="PSA 122:1-2">Taem ol man oli talem long mi se,</para>
  <para style="q2" vid="PSA 122:1-2">“Yumi go long haos* blong Hae God,”</para>
  <para style="q3" vid="PSA 122:1-2">mi mi glad tumas.</para>
  <para style="q1" vid="PSA 122:1-2">Mo naoia mifala i kamtru long yu finis,</para>
  <para style="q2" vid="PSA 122:1-2">mifala i stap stanap</para>
  <para style="q3" vid="PSA 122:1-2">insaed long ol doa* blong stonwol blong yu.<verse eid="PSA 122:1-2" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Olgeta.</para>
  <para style="q1" vid="PSA 122:3">Taon ya Jerusalem,</para>
  <para style="q2" vid="PSA 122:3">oli wokem i gud tumas.</para>
  <para style="q1" vid="PSA 122:3">Ol man blong hem oli stap joen gud</para>
  <para style="q2" vid="PSA 122:3">blong mekem wan gudfala taon.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Yumi ol man blong Hae God,</para>
  <para style="q2" vid="PSA 122:4">mo hemia ples we yumi stap kam</para>
  <para style="q3" vid="PSA 122:4">blong talem tangkiu long hem,</para>
  <para style="q3" vid="PSA 122:4">olsem we hem i talem.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Long ples ya nao,</para>
  <para style="q2" vid="PSA 122:5">oltaem, ol king blong yumi</para>
  <para style="q3" vid="PSA 122:5">oli stap mekem kot</para>
  <para style="q4" vid="PSA 122:5">blong jajem yumi long stret fasin.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Naoia yumi mas prea</para>
  <para style="q2" vid="PSA 122:6">blong taon ya bambae i gat pis.</para>
  <para style="q1" vid="PSA 122:6">Yumi mas talem se, “Hae God.</para>
  <para style="q2" vid="PSA 122:6">Plis yu mekem olgeta</para>
  <para style="q3" vid="PSA 122:6">we oli laekem taon ya tumas,</para>
  <para style="q4" vid="PSA 122:6">bambae oli save stap gud.<verse eid="PSA 122:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 122:7" />Plis yu mekem</para>
  <para style="q3" vid="PSA 122:7">we ol man blong taon ya</para>
  <para style="q4" vid="PSA 122:7">bambae oli stap long gudfala laef,</para>
  <para style="q3" vid="PSA 122:7">mo we ol king long ples ya</para>
  <para style="q4" vid="PSA 122:7">bambae oli stap gud</para>
  <para style="q3" vid="PSA 122:7">long ol haos blong olgeta.”<verse eid="PSA 122:7" /></para>
  <para style="sp">(Tok i go long taon ya Jerusalem bakegen.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Jerusalem,</para>
  <para style="q2" vid="PSA 122:8">mi mi stap tingbaot ol famle mo ol fren blong mi</para>
  <para style="q4" vid="PSA 122:8">we oli stap long yu,</para>
  <para style="q3" vid="PSA 122:8">mo mi prea blong oli gat gudfala laef.<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Hae God i God blong mifala,</para>
  <para style="q2" vid="PSA 122:9">mo haos blong hem i stap long yu.</para>
  <para style="q1" vid="PSA 122:9">Mo from samting ya,</para>
  <para style="q2" vid="PSA 122:9">mi bambae mi prea</para>
  <para style="q3" vid="PSA 122:9">blong yu yu save stap gud oltaem.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">Man i prea blong Hae God i sore long hem</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 123:1-2" />Hae God.</para>
  <para style="q1" vid="PSA 123:1-2">Oltaem mi mi stap lukluk i kam long yu.</para>
  <para style="q1" vid="PSA 123:1-2">Mi stap lukluk i kam antap long heven,</para>
  <para style="q2" vid="PSA 123:1-2">long ples ya we yu yu stap rul long hem.</para>
  <para style="q1" vid="PSA 123:1-2">Yu yu God blong mifala,</para>
  <para style="q2" vid="PSA 123:1-2">mo olsem we boe blong wok</para>
  <para style="q3" vid="PSA 123:1-2">i stap luk long masta blong hem</para>
  <para style="q4" vid="PSA 123:1-2">blong i givhan long hem,</para>
  <para style="q3" vid="PSA 123:1-2">mo haosgel i stap luk</para>
  <para style="q3" vid="PSA 123:1-2">long misis blong hem,</para>
  <para style="q2" vid="PSA 123:1-2">nao long sem fasin,</para>
  <para style="q3" vid="PSA 123:1-2">bambae mifala i stap lukluk long yu,</para>
  <para style="q4" vid="PSA 123:1-2">gogo yu yu sore long mifala.<verse eid="PSA 123:1-2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Hae God.</para>
  <para style="q1" vid="PSA 123:3">Plis yu sore long mifala,</para>
  <para style="q2" vid="PSA 123:3">plis yu sore long mifala.</para>
  <para style="q1" vid="PSA 123:3">Mifala i taedgud long ol man ya</para>
  <para style="q2" vid="PSA 123:3">we oltaem oli stap lukluk rabis long mifala.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Longtaem tumas,</para>
  <para style="q2" vid="PSA 123:4">ol rijman oli stap mekemplei long mifala,</para>
  <para style="q3" vid="PSA 123:4">oli stap laf nogud long mifala.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">Hae God i stap lukaot gud long ol man blong hem</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Olgeta.</para>
  <para style="q1" vid="PSA 124:1">?Sipos Hae God i no bin</para>
  <para style="q4" vid="PSA 124:1">givhan long yumi long faet,</para>
  <para style="q2" vid="PSA 124:1">bambae i olsem wanem long yumi?</para>
  <para style="q1" vid="PSA 124:1">!Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 124:1">yumi mas gat ansa long samting ya!<verse eid="PSA 124:1" /></para>
  <para style="b" />
  <para style="sp">(Ol man oli givim ansa.)</para>
  <para style="q1">
    <verse number="2-3" style="v" sid="PSA 124:2-3" />Ol enemi ya blong yumi oli kros tumas long yumi,</para>
  <para style="q2" vid="PSA 124:2-3">mo long taem ya we olgeta ya oli kam faet long yumi,</para>
  <para style="q3" vid="PSA 124:2-3">sipos Hae God i no givhan long yumi</para>
  <para style="q3" vid="PSA 124:2-3">bambae oli flatemgud yumi,</para>
  <para style="q3" vid="PSA 124:2-3">we yumi no save mekem wan samting nating.<verse eid="PSA 124:2-3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />Bambae oli kam spolem yumi</para>
  <para style="q2" vid="PSA 124:4">olsem we wota i ron bigwan,</para>
  <para style="q3" vid="PSA 124:4">i karemaot yumi,</para>
  <para style="q4" vid="PSA 124:4">i kavremap yumi,<verse eid="PSA 124:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 124:5" />mo i kam strong tumas,</para>
  <para style="q3" vid="PSA 124:5">i draonem yumi.<verse eid="PSA 124:5" /></para>
  <para style="sp">(Olgeta evriwan oli tok.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />Yumi mas talem tangkiu long Hae God,</para>
  <para style="q2" vid="PSA 124:6">from we hem i no letem</para>
  <para style="q3" vid="PSA 124:6">ol enemi blong yumi oli spolem yumi.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Yumi bin ronwe olsem wan pijin</para>
  <para style="q2" vid="PSA 124:7">we i kamaot long trap, i ronwe.</para>
  <para style="q1" vid="PSA 124:7">Trap ya i brok, nao yumi go fri.<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Hae God i mekem skae mo graon,</para>
  <para style="q2" vid="PSA 124:8">mo hem nao i stap givhan long yumi.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">Ol man we oli stap trastem Hae God oli save stap gud</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Olgeta.</para>
  <para style="q1" vid="PSA 125:1">Ol man we oli stap trastem Hae God</para>
  <para style="q2" vid="PSA 125:1">oli olsem hil ya Saeon,*</para>
  <para style="q3" vid="PSA 125:1">we i no save seksek samtaem,</para>
  <para style="q4" vid="PSA 125:1">i no save kamaot long ples blong hem.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Ol hil ya raon long Jerusalem</para>
  <para style="q3" vid="PSA 125:2">oli stap blokemgud hem,</para>
  <para style="q2" vid="PSA 125:2">mo long sem fasin,</para>
  <para style="q3" vid="PSA 125:2">Hae God tu bambae i stap blokemgud</para>
  <para style="q3" vid="PSA 125:2">ol man blong hem,</para>
  <para style="q4" vid="PSA 125:2">i stat naoia, <optbreak /> gogo i no save finis.<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Yumi ol stret man,</para>
  <para style="q2" vid="PSA 125:3">mo ol man nogud oli no save rul longtaem</para>
  <para style="q3" vid="PSA 125:3">long ples blong yumi.</para>
  <para style="q1" vid="PSA 125:3">Sipos oli stap mekem olsem,</para>
  <para style="q2" vid="PSA 125:3">maet yumi tu i mekem samting nogud.<verse eid="PSA 125:3" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />Hae God.</para>
  <para style="q1" vid="PSA 125:4">Plis yu mekem i gud long ol gudfala man,</para>
  <para style="q3" vid="PSA 125:4">we oli stap obei long ol tok blong yu.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Be taem yu panisim ol man nogud,</para>
  <para style="q2" vid="PSA 125:5">plis yu panisim olgeta tu</para>
  <para style="q3" vid="PSA 125:5">we oli lego ol fasin blong yu.</para>
  <para style="sp" vid="PSA 125:5">(Tok i go long ol man.)</para>
  <para style="q1" vid="PSA 125:5">Prea blong mi,</para>
  <para style="q2" vid="PSA 125:5">we yumi ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 125:5">bambae yumi gat gudfala laef.<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">Ol laen blong Isrel oli glad from we Hae God i sevem olgeta</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet* <char style="ord">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Olgeta.</para>
  <para style="q1" vid="PSA 126:1">Bifo,</para>
  <para style="q2" vid="PSA 126:1">taem Hae God i tekem yumi i kambak long Jerusalem,</para>
  <para style="q3" vid="PSA 126:1">samting ya i olsem wan drim nomo.<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />Long taem ya,</para>
  <para style="q2" vid="PSA 126:2">yumi stap laf, yumi stap singsing,</para>
  <para style="q3" vid="PSA 126:2">from we yumi glad tumas.</para>
  <para style="q1" vid="PSA 126:2">Nao ol man blong ol narafala kantri oli talem se,</para>
  <para style="q2" vid="PSA 126:2">“Hae God i mekem ol bigbigfala wok</para>
  <para style="q3" vid="PSA 126:2">blong givhan long olgeta.”<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Mo i tru,</para>
  <para style="q2" vid="PSA 126:3">hem i mekem ol bigbigfala wok</para>
  <para style="q3" vid="PSA 126:3">blong givhan long yumi.</para>
  <para style="q1" vid="PSA 126:3">!Long taem ya,</para>
  <para style="q2" vid="PSA 126:3">yumi glad we yumi glad!<verse eid="PSA 126:3" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />Hae God.</para>
  <para style="q1" vid="PSA 126:4">Plis yu mekem</para>
  <para style="q3" vid="PSA 126:4">laef blong mifala i gud bakegen,</para>
  <para style="q2" vid="PSA 126:4">olsem we ren i mekem</para>
  <para style="q4" vid="PSA 126:4">wota i kambak long krik we i drae.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />I gat ol man blong mifala</para>
  <para style="q2" vid="PSA 126:5">we taem oli stap planem kakae long garen blong olgeta,</para>
  <para style="q3" vid="PSA 126:5">oli stap harem nogud,</para>
  <para style="q4" vid="PSA 126:5">oli stap krae.</para>
  <para style="q1" vid="PSA 126:5">Be taem oli tekemaot kakae long garen ya,</para>
  <para style="q2" vid="PSA 126:5">plis yu mekem olgeta oli glad.<verse eid="PSA 126:5" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Olgeta.</para>
  <para style="q1" vid="PSA 126:6">Ol man ya,</para>
  <para style="q2" vid="PSA 126:6">taem oli go planem kakae long garen,</para>
  <para style="q3" vid="PSA 126:6">oli stap harem nogud,</para>
  <para style="q4" vid="PSA 126:6">oli stap krae.</para>
  <para style="q1" vid="PSA 126:6">Be biaen,</para>
  <para style="q2" vid="PSA 126:6">taem oli go tekemaot kakae long garen ya oli karem i kam,</para>
  <para style="q3" vid="PSA 126:6">bambae oli singsing</para>
  <para style="q4" vid="PSA 126:6">from we oli glad we i glad long kakae ya.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">Sing blong presem Hae God from gudfala fasin blong hem</para>
  <para style="sp">(Sing ya, Solomon i wokem. Hemia i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />Olgeta.</para>
  <para style="q1" vid="PSA 127:1">Sipos Hae God i no givhan</para>
  <para style="q3" vid="PSA 127:1">long man blong wokem haos,</para>
  <para style="q2" vid="PSA 127:1">wok blong man ya i blong nating nomo.</para>
  <para style="q1" vid="PSA 127:1">Mo sipos Hae God i no givhan long wajman</para>
  <para style="q3" vid="PSA 127:1">we i stap lukaot long taon,</para>
  <para style="q2" vid="PSA 127:1">wok blong man ya i blong nating nomo.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Oltaem yumi stap hadwok tumas,</para>
  <para style="q3" vid="PSA 127:2">yumi wari from laef blong yumi.</para>
  <para style="q1" vid="PSA 127:2">Yumi stap girap long eli moning,</para>
  <para style="q2" vid="PSA 127:2">mo yumi stap go slip we i let olgeta.</para>
  <para style="q1" vid="PSA 127:2">Be ol samting ya i blong nating nomo,</para>
  <para style="q2" vid="PSA 127:2">from we taem ol man we Hae God i lavem olgeta</para>
  <para style="q4" vid="PSA 127:2">oli stap slip,</para>
  <para style="q2" vid="PSA 127:2">be hem i stap givim ol samting long olgeta</para>
  <para style="q4" vid="PSA 127:2">we oli sot long hem.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Ol pikinini ya blong yumi,</para>
  <para style="q2" vid="PSA 127:3">hemia wan presen</para>
  <para style="q4" vid="PSA 127:3">we Hae God i givim long yumi,</para>
  <para style="q3" vid="PSA 127:3">wan gudfala samting</para>
  <para style="q3" vid="PSA 127:3">we hem i givim blong leftemap yumi.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Ol pikinini we man i bonem taem i yang yet,</para>
  <para style="q2" vid="PSA 127:4">be taem hem i kam olfala,</para>
  <para style="q3" vid="PSA 127:4">olgeta oli olsem ol ara long han blong soldia.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Man we i gat plante pikinini olsem,</para>
  <para style="q2" vid="PSA 127:5">bambae i save harem gud.</para>
  <para style="q1" vid="PSA 127:5">Sipos ol enemi blong hem oli tekem</para>
  <para style="q3" vid="PSA 127:5">hem i go long kot,</para>
  <para style="q2" vid="PSA 127:5">be neva bambae oli save winim hem.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">Pei blong man we i obei long Hae God</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Olgeta.</para>
  <para style="q1" vid="PSA 128:1">Ol man we oli stap ona long Hae God,</para>
  <para style="q2" vid="PSA 128:1">mo we oli stap folem ol tok we hem i putum,</para>
  <para style="q3" vid="PSA 128:1">bambae oli save harem gud.<verse eid="PSA 128:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Sipos yu yu stap mekem olsem,</para>
  <para style="q2" vid="PSA 128:2">bambae wok blong yu i gat frut blong hem,</para>
  <para style="q3" vid="PSA 128:2">mo oltaem,</para>
  <para style="q4" vid="PSA 128:2">long olgeta laef blong yu,</para>
  <para style="q3" vid="PSA 128:2">bambae yu yu harem gud, <optbreak /> yu glad.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Long hom blong yu,</para>
  <para style="q2" vid="PSA 128:3">woman blong yu bambae i olsem rop ya grep*</para>
  <para style="q4" vid="PSA 128:3">we i gat plante frut blong hem,</para>
  <para style="q3" vid="PSA 128:3">mo ol pikinini blong yu</para>
  <para style="q4" vid="PSA 128:3">bambae oli stap raon long tebol blong yu</para>
  <para style="q3" vid="PSA 128:3">olsem ol yang olif tri <optbreak /> raonabaot long stamba blong hem.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Man we i stap obei long Hae God oltaem,</para>
  <para style="q2" vid="PSA 128:4">hemia nao fasin we Hae God bambae i folem</para>
  <para style="q3" vid="PSA 128:4">blong blesem hem.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Hae God i stap long Saeon,*</para>
  <para style="q2" vid="PSA 128:5">mo prea blong mi,</para>
  <para style="q3" vid="PSA 128:5">we hem bambae i blesem yufala.</para>
  <para style="q1" vid="PSA 128:5">Mi wantem</para>
  <para style="q2" vid="PSA 128:5">we oltaem long laef blong yufala,</para>
  <para style="q3" vid="PSA 128:5">bambae yufala i save luk</para>
  <para style="q4" vid="PSA 128:5">we olgeta samting long Jerusalem</para>
  <para style="q3" vid="PSA 128:5">i stap gohed gud.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Mi wantem</para>
  <para style="q2" vid="PSA 128:6">we bambae yufala i stap gogo,</para>
  <para style="q3" vid="PSA 128:6">yufala i luk ol pikinini blong ol pikinini blong yufala.</para>
  <para style="b" vid="PSA 128:6" />
  <para style="q1" vid="PSA 128:6">Prea blong mi,</para>
  <para style="q2" vid="PSA 128:6">we yumi ol laen* blong Isrel,*</para>
  <para style="q3" vid="PSA 128:6">bambae yumi gat gudfala laef.<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">Man i prea blong Hae God i panisim ol enemi blong hem</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />Olgeta.</para>
  <para style="q1" vid="PSA 129:1">?Yumi ol laen blong Isrel ya,</para>
  <para style="q2" vid="PSA 129:1">ol enemi blong yumi</para>
  <para style="q3" vid="PSA 129:1">oli stap spolem yumi olsem wanem?</para>
  <para style="q1" vid="PSA 129:1">Yufala i traem talem stori blong hem,</para>
  <para style="q2" vid="PSA 129:1">i stat long taem we ol bubu blong yumi oli slef* long Ijip,</para>
  <para style="q3" vid="PSA 129:1">i kam kasem tede.<verse eid="PSA 129:1" /></para>
  <para style="sp">(Ol man oli givim ansa.)</para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />I stat long taem ya kam kasem tede,</para>
  <para style="q2" vid="PSA 129:2">ol enemi blong yumi oli stap ronem yumi</para>
  <para style="q4" vid="PSA 129:2">we oli stap spolemgud yumi,</para>
  <para style="q3" vid="PSA 129:2">be oli no save winim yumi.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Oli wipim yumi plante taem long baksaed blong yumi,</para>
  <para style="q3" vid="PSA 129:3">we oli spolemgud yumi,</para>
  <para style="q2" vid="PSA 129:3">oli mekem baksaed blong yumi i kam olsem garen</para>
  <para style="q4" vid="PSA 129:3">we man i brebrekem graon blong hem.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Be Hae God,</para>
  <para style="q3" vid="PSA 129:4">fasin blong hem i stret gud,</para>
  <para style="q2" vid="PSA 129:4">mo hem i mekem</para>
  <para style="q4" vid="PSA 129:4">yumi fri finis long fasin blong slef.<verse eid="PSA 129:4" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Hae God.</para>
  <para style="q1" vid="PSA 129:5">Olgeta evriwan we oli agens long Saeon,*</para>
  <para style="q2" vid="PSA 129:5">plis yu faet long olgeta,</para>
  <para style="q3" vid="PSA 129:5">yu flatemgud olgeta,</para>
  <para style="q4" vid="PSA 129:5">yu ronem olgeta oli gobak.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Yu letem olgeta i kam olsem gras</para>
  <para style="q2" vid="PSA 129:6">we i stap gru antap long haos,</para>
  <para style="q3" vid="PSA 129:6">we i wantem gru bigwan</para>
  <para style="q4" vid="PSA 129:6">be smoltaem nomo i drae bakegen.<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />Gras olsem,</para>
  <para style="q2" vid="PSA 129:7">i no gat man i save pikimap olgeta,</para>
  <para style="q3" vid="PSA 129:7">no i putum olgeta wanples,</para>
  <para style="q4" vid="PSA 129:7">nao i karem i go.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Mi mi wantem</para>
  <para style="q2" vid="PSA 129:8">we bambae i no gat man i pas klosap long olgeta,</para>
  <para style="q3" vid="PSA 129:8">i talem long olgeta se,</para>
  <para style="q2" vid="PSA 129:8">“Prea blong mifala</para>
  <para style="q3" vid="PSA 129:8">we Hae God bambae i blesem yufala.</para>
  <para style="q2" vid="PSA 129:8">Mifala i blesem yufala</para>
  <para style="q3" vid="PSA 129:8">long nem blong hem.”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">Man i prea blong Hae God i givhan long hem</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1-3" style="v" sid="PSA 130:1-3" />Hae God.</para>
  <para style="q1" vid="PSA 130:1-3">Yu yu Masta* blong mi.</para>
  <para style="q1" vid="PSA 130:1-3">Tingting blong mi i foldaon we i foldaon olgeta,</para>
  <para style="q2" vid="PSA 130:1-3">be mi mi stap krae i kam long yu.</para>
  <para style="q1" vid="PSA 130:1-3">Plis yu harem krae blong mi,</para>
  <para style="q2" vid="PSA 130:1-3">yu lesin long mi we mi stap krae i kam long yu</para>
  <para style="q4" vid="PSA 130:1-3">blong yu sore long mi.</para>
  <para style="q1" vid="PSA 130:1-3">?Sipos yu yu stap raetemdaon ol sin blong mifala,</para>
  <para style="q2" vid="PSA 130:1-3">hu bambae i save stanap long fes blong yu,</para>
  <para style="q3" vid="PSA 130:1-3">we yu yu no save jajem hem?<verse eid="PSA 130:1-3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Be yu yu stap fogivim mifala,</para>
  <para style="q3" vid="PSA 130:4">yu stap tekemaot ol sin blong mifala,</para>
  <para style="q2" vid="PSA 130:4">nao mifala i stap bodaon long yu,</para>
  <para style="q4" vid="PSA 130:4">mifala i stap ona long yu.<verse eid="PSA 130:4" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 130:5-6" />Hae God i Masta blong mi,</para>
  <para style="q1" vid="PSA 130:5-6">mo mi mi stap wet long hem.</para>
  <para style="q1" vid="PSA 130:5-6">Mi wantem tumas blong hem i givhan long mi,</para>
  <para style="q2" vid="PSA 130:5-6">mo mi putum tingting blong mi</para>
  <para style="q3" vid="PSA 130:5-6">i stap long tok blong hem.</para>
  <para style="q1" vid="PSA 130:5-6">Mi mi wantem tumas blong luk hem,</para>
  <para style="q2" vid="PSA 130:5-6">i winim we wajman long naet</para>
  <para style="q3" vid="PSA 130:5-6">i wantem luk delaet i kamtru.</para>
  <para style="q1" vid="PSA 130:5-6">I tru, mi wantem moa,</para>
  <para style="q2" vid="PSA 130:5-6">i winim we wajman long naet,</para>
  <para style="q3" vid="PSA 130:5-6">i wantem luk delaet i kamtru.<verse eid="PSA 130:5-6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 130:7">yumi mas trastem Hae God,</para>
  <para style="q3" vid="PSA 130:7">from we oltaem hem i lavem man tumas,</para>
  <para style="q4" vid="PSA 130:7">mo oltaem hem i glad blong sevem man.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130.8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 1:21">Mat 1.21</ref>; <ref loc="TIT 2:14">Taet 2.14</ref></char>
    </note>Yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 130:8">mo hem bambae i sevem yumi</para>
  <para style="q3" vid="PSA 130:8">i tekemaot yumi long olgeta sin blong yumi.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">Man we i no moa praod, i prea long Hae God</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />Hae God.</para>
  <para style="q1" vid="PSA 131:1">Fastaem mi mi praod tumas,</para>
  <para style="q2" vid="PSA 131:1">be mi lego fasin ya olgeta,</para>
  <para style="q3" vid="PSA 131:1">mo mi livim finis ol tok flas blong mi.</para>
  <para style="q1" vid="PSA 131:1">Mi no moa save tingbaot ol bigbigfala wok</para>
  <para style="q2" vid="PSA 131:1">mo ol samting we i strong tumas blong mi mekem.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Mo naoia, mi mi harem gud,</para>
  <para style="q3" vid="PSA 131:2">tingting blong mi i stap kwaet.</para>
  <para style="q1" vid="PSA 131:2">Tingting blong mi i kwaet we i kwaet,</para>
  <para style="q2" vid="PSA 131:2">olsem pikinini we i ledaon kwaet</para>
  <para style="q3" vid="PSA 131:2">long han blong mama blong hem.<verse eid="PSA 131:2" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 131:3">yumi mas trastem Hae God,</para>
  <para style="q3" vid="PSA 131:3">i stat naoia, gogo i no save finis.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">Man i glad tumas long haos blong Hae God</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />Hae God.</para>
  <para style="q1" vid="PSA 132:1">Plis yu no fogetem King Deved</para>
  <para style="q3" vid="PSA 132:1">mo ol hadlaef we hem i kasem.<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Hae God,</para>
  <para style="q2" vid="PSA 132:2">yu yu God blong Jekob,*</para>
  <para style="q3" vid="PSA 132:2">mo yu yu gat paoa.</para>
  <para style="q1" vid="PSA 132:2">Plis yu tingbaot promes ya blong hem</para>
  <para style="q3" vid="PSA 132:2">we hem i mekem long yu.<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3-5" style="v" sid="PSA 132:3-5" />Hem i talem se,</para>
  <para style="q2" vid="PSA 132:3-5">“Hae God,</para>
  <para style="q3" vid="PSA 132:3-5">yu yu God blong Jekob</para>
  <para style="q4" vid="PSA 132:3-5">mo yu yu gat paoa.</para>
  <para style="q2" vid="PSA 132:3-5">Bambae mi no save gohom,</para>
  <para style="q3" vid="PSA 132:3-5">mi no save ledaon,</para>
  <para style="q3" vid="PSA 132:3-5">mo mi no save slip.</para>
  <para style="q2" vid="PSA 132:3-5">Bambae mi no save spel,</para>
  <para style="q3" vid="PSA 132:3-5">gogo kasem we mi faenem wan ples blong yu</para>
  <para style="q4" vid="PSA 132:3-5">we yu save stap long hem oltaem.”<verse eid="PSA 132:3-5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132.6: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 6:41">2 Kron 6.41</ref>,<ref loc="2CH 6:42">42</ref></char>
    </note>Bifo, taem mifala i stap long Betlehem,</para>
  <para style="q2" vid="PSA 132:6">mifala i harem nius blong Bokis ya</para>
  <para style="q3" vid="PSA 132:6">we i Saen blong Promes* blong yu,</para>
  <para style="q2" vid="PSA 132:6">mo taem mifala i kam long Jearim,</para>
  <para style="q3" vid="PSA 132:6">mifala i faenem Bokis ya</para>
  <para style="q4" vid="PSA 132:6">long garen blong wan man,</para>
  <para style="q3" vid="PSA 132:6">nao mifala i karem.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />Nao mifala i talem se,</para>
  <para style="q2" vid="PSA 132:7">“Yumi go long haos* tapolen blong Hae God.</para>
  <para style="q2" vid="PSA 132:7">Yumi mekem wosip long fes blong hem,</para>
  <para style="q3" vid="PSA 132:7">we hem i stap sidaon long ples ya,</para>
  <para style="q4" vid="PSA 132:7">i stap rul.”<verse eid="PSA 132:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />Hae God.</para>
  <para style="q1" vid="PSA 132:8">Ples ya nao i ples blong yu.</para>
  <para style="q1" vid="PSA 132:8">Plis yu kam stap olwe long ples ya,</para>
  <para style="q2" vid="PSA 132:8">wetem Bokis ya we i saen blong paoa blong yu.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Plis yu mekem</para>
  <para style="q2" vid="PSA 132:9">we oltaem ol pris* blong yu</para>
  <para style="q4" vid="PSA 132:9">oli stap holem ol stret fasin,</para>
  <para style="q3" vid="PSA 132:9">mo we ol man blong yu oli glad tumas,</para>
  <para style="q3" vid="PSA 132:9">oli stap singsingaot from.<verse eid="PSA 132:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Bifo, yu yu mekem wan promes long King Deved,</para>
  <para style="q2" vid="PSA 132:10">man blong wok blong yu.</para>
  <para style="q1" vid="PSA 132:10">From samting ya,</para>
  <para style="q2" vid="PSA 132:10">plis yu no tanem baksaed long king blong mifala,</para>
  <para style="q3" vid="PSA 132:10">we yu yu jusumaot hem,</para>
  <para style="q4" vid="PSA 132:10">yu putumap hem i kam king.<verse eid="PSA 132:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132.11: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:12-16">2 Saml 7.12-16</ref>; <ref loc="1CH 17:11-14">1 Kron 17.11-14</ref>; <ref loc="PSA 89:3">Sam 89.3</ref>,<ref loc="PSA 89:4">4</ref>; <ref loc="ACT 2:30">Wok 2.30</ref></char>
    </note>Yu yu mekem wan tabu promes long hem,</para>
  <para style="q2" vid="PSA 132:11">mo yu no save brekem promes ya.</para>
  <para style="q1" vid="PSA 132:11">Yu yu talem se,</para>
  <para style="q2" vid="PSA 132:11">“Bambae mi mekem</para>
  <para style="q3" vid="PSA 132:11">wan pikinini blong yu i kam king,</para>
  <para style="q4" vid="PSA 132:11">mo bambae hem i rul biaen long yu.<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Mo sipos hem wetem olgeta we oli stap kamaot biaen long yu</para>
  <para style="q3" vid="PSA 132:12">oli stap holem promes blong mi,</para>
  <para style="q4" vid="PSA 132:12">mo oli stap folem ol rul we mi mi mekem,</para>
  <para style="q3" vid="PSA 132:12">bambae oli kam king,</para>
  <para style="q4" vid="PSA 132:12">mo bambae oli stap rul biaen long yu</para>
  <para style="q3" vid="PSA 132:12">gogo i no save finis.”<verse eid="PSA 132:12" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />Olgeta.</para>
  <para style="q1" vid="PSA 132:13">Hae God i jusumaot Saeon* finis</para>
  <para style="q2" vid="PSA 132:13">blong mekem i kam hom blong hem.<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />Hem i talem se,</para>
  <para style="q2" vid="PSA 132:14">“Ples ya Saeon,</para>
  <para style="q3" vid="PSA 132:14">bambae mi mi stap olwe long hem.</para>
  <para style="q2" vid="PSA 132:14">Hem bambae i hom blong mi,</para>
  <para style="q3" vid="PSA 132:14">from we mi mi wantem ples ya tumas.<verse eid="PSA 132:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 132:15" />Olgeta samting we ples ya i sot long hem,</para>
  <para style="q3" vid="PSA 132:15">mi bambae mi givim long hem</para>
  <para style="q4" vid="PSA 132:15">we bambae i plante we plante.</para>
  <para style="q2" vid="PSA 132:15">Ol puaman blong ples ya,</para>
  <para style="q3" vid="PSA 132:15">bambae mi givim plante kakae long olgeta,</para>
  <para style="q4" vid="PSA 132:15">we bambae oli harem gud long hem.<verse eid="PSA 132:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 132:16" />Ol pris blong ples ya</para>
  <para style="q3" vid="PSA 132:16">bambae mi stap blesem olgeta oltaem,</para>
  <para style="q4" vid="PSA 132:16">long olgeta samting we oli mekem.</para>
  <para style="q2" vid="PSA 132:16">Mo ol man blong mi long ples ya</para>
  <para style="q3" vid="PSA 132:16">bambae oli glad tumas,</para>
  <para style="q4" vid="PSA 132:16">oli stap singsingaot bigwan from.<verse eid="PSA 132:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PSA 132:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132.17: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 11:36">1 King 11.36</ref>
      </char>
    </note>Long ples ya Saeon,</para>
  <para style="q3" vid="PSA 132:17">bambae mi mi putumap wan long olgeta</para>
  <para style="q3" vid="PSA 132:17">we i kamaot biaen long King Deved,</para>
  <para style="q4" vid="PSA 132:17">mo hem bambae i wan hae king.</para>
  <para style="q2" vid="PSA 132:17">Long ples ya nao,</para>
  <para style="q3" vid="PSA 132:17">bambae mi mi stap lukaot gud long hem</para>
  <para style="q4" vid="PSA 132:17">blong bambae hem i stap rul oltaem.<verse eid="PSA 132:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="PSA 132:18" />Oltaem bambae mi stap mekem</para>
  <para style="q4" vid="PSA 132:18">ol enemi blong king ya oli sem,</para>
  <para style="q3" vid="PSA 132:18">be ol man blong hem</para>
  <para style="q4" vid="PSA 132:18">bambae mi mekem olgeta</para>
  <para style="q3" vid="PSA 132:18">oli stap long gudfala laef.”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">Man i presem Hae God from fasin ya we ol man oli stap lavlavem olgeta</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />!Olgeta!</para>
  <para style="q1" vid="PSA 133:1">I gud tumas</para>
  <para style="q2" vid="PSA 133:1">taem ol man blong God oli stap wanples,</para>
  <para style="q3" vid="PSA 133:1">we oli gat wan tingting nomo.</para>
  <para style="q1" vid="PSA 133:1">Fasin ya i gud tumas.<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Hem i olsem gudfala oel ya</para>
  <para style="q2" vid="PSA 133:2">we oli kafsaedem i go long hed blong Eron</para>
  <para style="q3" vid="PSA 133:2">blong makemaot hem i kam hae pris* blong God.</para>
  <para style="q1" vid="PSA 133:2">Oel ya i ron,</para>
  <para style="q2" vid="PSA 133:2">i godaon long mustas blong hem,</para>
  <para style="q3" vid="PSA 133:2">i go kasem klos blong hem,</para>
  <para style="q4" vid="PSA 133:2">i mekem evri samting i tabu.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Fasin ya i olsem we wota blong naet</para>
  <para style="q3" vid="PSA 133:3">we i stap folfoldaon bigwan</para>
  <para style="q4" vid="PSA 133:3">long bigfala hil ya Hemon,</para>
  <para style="q2" vid="PSA 133:3">i kam folfoldaon sem mak long ol hil ya long Saeon.*</para>
  <para style="q1" vid="PSA 133:3">Long ples ya Saeon,</para>
  <para style="q2" vid="PSA 133:3">Hae God i promes finis</para>
  <para style="q3" vid="PSA 133:3">blong givim wan gudfala samting blong hem</para>
  <para style="q3" vid="PSA 133:3">long ol man blong hem,</para>
  <para style="q4" vid="PSA 133:3">we hemia laef ya we i no save finis.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">Man i singaot ol man blong oli kam presem Hae God</para>
  <para style="sp">(Sing ya i blong ol man oli singsing long hem taem oli stap wokbaot blong go antap long Jerusalem* blong mekem lafet<char style="fm">E.</char>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Olgeta.</para>
  <para style="q1" vid="PSA 134:1">Yufala ol man blong wok blong Hae God,</para>
  <para style="q2" vid="PSA 134:1">we yufala i stap wok long haos* blong hem long naet,</para>
  <para style="q3" vid="PSA 134:1">yufala i kam presem hem.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Yufala i kam insaed long haos blong hem,</para>
  <para style="q2" vid="PSA 134:2">yufala i leftemap han blong yufala,</para>
  <para style="q3" vid="PSA 134:2">yufala i prea mo yufala i presem hem.<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Hae God i mekem heven mo wol,</para>
  <para style="q2" vid="PSA 134:3">mo hem i stap long Saeon.*</para>
  <para style="q1" vid="PSA 134:3">Prea blong mi,</para>
  <para style="q2" vid="PSA 134:3">we hem bambae i blesem yufala.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 135:1-2" />Olgeta.</para>
  <para style="q1" vid="PSA 135:1-2">!Yumi presem Hae God!</para>
  <para style="q1" vid="PSA 135:1-2">!Hem i God blong yumi!</para>
  <para style="q1" vid="PSA 135:1-2">Yufala ol man blong wok blong hem</para>
  <para style="q2" vid="PSA 135:1-2">we yufala i stap mekem wosip long hem</para>
  <para style="q3" vid="PSA 135:1-2">long yad blong haos* blong hem,</para>
  <para style="q2" vid="PSA 135:1-2">yufala i mas presem nem blong hem.<verse eid="PSA 135:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Yufala i mas presem hem,</para>
  <para style="q3" vid="PSA 135:3">from we fasin blong hem i gud tumas,</para>
  <para style="q2" vid="PSA 135:3">yufala i mas sing blong presem nem blong hem</para>
  <para style="q4" vid="PSA 135:3">from we hem i kaen tumas.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Hem i jusumaot Jekob* we narafala nem blong hem Isrel,*</para>
  <para style="q3" vid="PSA 135:4">blong i kam man blong hem,</para>
  <para style="q2" vid="PSA 135:4">nao yumi ol laen* blong Isrel ya,</para>
  <para style="q4" vid="PSA 135:4">yumi ol man blong hem nomo.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 135:5">mo mi mi save we hem i hae we i hae.</para>
  <para style="q1" vid="PSA 135:5">Hem i hae moa i winim olgeta narafala god.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />Hem i stap mekem olgeta samting we hem i wantem,</para>
  <para style="q2" vid="PSA 135:6">long skae mo long graon,</para>
  <para style="q3" vid="PSA 135:6">mo long solwota mo long dipsi daon.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Hem i stap mekem</para>
  <para style="q3" vid="PSA 135:7">ol klaod oli aot long narasaed wol oli kam,</para>
  <para style="q2" vid="PSA 135:7">mo i stap mekem</para>
  <para style="q4" vid="PSA 135:7">laetning i kam long hariken,</para>
  <para style="q3" vid="PSA 135:7">mo i stap tekemaot win long ples blong hem,</para>
  <para style="q3" vid="PSA 135:7">i mekem i blu i kam long yumi.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Bifo, long Ijip</para>
  <para style="q2" vid="PSA 135:8">hem nao i kilim ol fasbon pikinini</para>
  <para style="q3" vid="PSA 135:8">blong ol man blong kantri ya,</para>
  <para style="q2" vid="PSA 135:8">wetem ol fasbon pikinini</para>
  <para style="q4" vid="PSA 135:8">blong ol anamol blong olgeta tu</para>
  <para style="q3" vid="PSA 135:8">oli ded<note caller="+" style="f"><char style="fr" closed="false">135.8: </char><char style="ft" closed="false">Yu luk futnot <char style="bd">Y</char> long 105.36.</char></note>.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Long ples ya,</para>
  <para style="q2" vid="PSA 135:9">hem i mekem ol merikel mo ol bigbigfala wok tu,</para>
  <para style="q3" vid="PSA 135:9">blong panisim king blong olgeta</para>
  <para style="q4" vid="PSA 135:9">wetem olgeta haeman blong hem.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Hem i spolemgud ol man blong plante narafala kantri,</para>
  <para style="q2" vid="PSA 135:10">mo i kilim ol king we oli strong tumas,</para>
  <para style="q4" vid="PSA 135:10">oli ded.<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Hem i kilim King Sihon</para>
  <para style="q3" vid="PSA 135:11">we i king blong ol laen blong Amoro,*</para>
  <para style="q2" vid="PSA 135:11">mo King Og we i king blong Basan,</para>
  <para style="q3" vid="PSA 135:11">mo i kilim olgeta king blong Kenan* tu.<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />Hem i tekemaot graon blong ol king ya,</para>
  <para style="q2" vid="PSA 135:12">i givim i kam long yumi ol man blong hem,</para>
  <para style="q3" vid="PSA 135:12">blong yumi holem i blong yumi.</para>
  <para style="b" vid="PSA 135:12">Keep this one (Tok i go long Hae God.)<verse eid="PSA 135:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />Hae God.</para>
  <para style="q1" vid="PSA 135:13">Oltaem ol man bambae oli stap talemaot</para>
  <para style="q3" vid="PSA 135:13">we yu yu God.</para>
  <para style="q1" vid="PSA 135:13">Oltaem nomo,</para>
  <para style="q3" vid="PSA 135:13">bambae ol man oli stap tingbaot yu,<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />from we yu bambae yu blokemgud ol man blong yu,</para>
  <para style="q4" vid="PSA 135:14">yu stap lukaot gud long olgeta.</para>
  <para style="q1" vid="PSA 135:14">Mo yu bambae yu gat sore</para>
  <para style="q2" vid="PSA 135:14">long ol man blong wok blong yu.<verse eid="PSA 135:14" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135.15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:4-8">Sam 115.4-8</ref>; <ref loc="REV 9:20">Rev 9.20</ref></char>
    </note>Olgeta.</para>
  <para style="q1" vid="PSA 135:15">Ol god blong ol hiten man ya,</para>
  <para style="q2" vid="PSA 135:15">ol man nomo oli wokem olgeta</para>
  <para style="q3" vid="PSA 135:15">long silva mo long gol.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Ol god ya oli gat maot</para>
  <para style="q3" vid="PSA 135:16">be oli no save toktok,</para>
  <para style="q2" vid="PSA 135:16">mo oli gat ae</para>
  <para style="q4" vid="PSA 135:16">be oli no save lukluk.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Oli gat sora</para>
  <para style="q3" vid="PSA 135:17">be oli no save harem samting,</para>
  <para style="q2" vid="PSA 135:17">mo oli no save pulum win tu.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />I gud ol man we oli wokem ol aedol ya,</para>
  <para style="q3" vid="PSA 135:18">wetem ol man we oli stap wosipim olgeta,</para>
  <para style="q2" vid="PSA 135:18">olgeta evriwan oli kam olsem ol aedol ya nomo.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Yumi ol laen blong Isrel,</para>
  <para style="q2" vid="PSA 135:19">yumi mas presem Hae God.</para>
  <para style="q1" vid="PSA 135:19">Yufala ol pris* blong hem,</para>
  <para style="q2" vid="PSA 135:19">yufala i mas presem hem.<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Yufala ol Livaet,*</para>
  <para style="q2" vid="PSA 135:20">yufala i mas presem hem.</para>
  <para style="q1" vid="PSA 135:20">Yumi evriwan we yumi stap mekem wosip long hem,</para>
  <para style="q2" vid="PSA 135:20">yumi mas presem hem.<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Yumi mas presem hem long Jerusalem,*</para>
  <para style="q2" vid="PSA 135:21">long Saeon,* we i hom blong hem.</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q1" vid="PSA 135:21">!Oltaem yumi mas presem Hae God!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">Sing blong talem tangkiu long Hae God</para>
  <para style="sp">(Tok i stap go long ol man, mo ol man oli stap ansa, oli talem se, “Oltaem bambae hem i lavem yumi, gogo i no save finis.”)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Kron 16.34</ref>; <ref loc="2CH 5:13">2 Kron 5.13</ref>; <ref loc="2CH 7:3">7.3</ref>; <ref loc="EZR 3:11">Esra 3.11</ref>; <ref loc="PSA 100:5">Sam 100.5</ref>; <ref loc="PSA 106:1">106.1</ref>; <ref loc="PSA 107:1">107.1</ref>; <ref loc="PSA 118:1">118.1</ref>; <ref loc="JER 33:11">Jer 33.11</ref></char>
    </note>Olgeta.</para>
  <para style="q1" vid="PSA 136:1">Yumi talem tangkiu long Hae God,</para>
  <para style="q2" vid="PSA 136:1">from we hem i gud tumas.</para>
  <para style="q1" vid="PSA 136:1">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:1">gogo i no save finis.<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Yumi talem tangkiu long hem,</para>
  <para style="q2" vid="PSA 136:2">from we hem i hae moa,</para>
  <para style="q3" vid="PSA 136:2">i winim ol narafala god.</para>
  <para style="q1" vid="PSA 136:2">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:2">gogo i no save finis.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Yumi talem tangkiu long hem,</para>
  <para style="q2" vid="PSA 136:3">from we hem i gat paoa moa,</para>
  <para style="q3" vid="PSA 136:3">i winim olgeta masta.</para>
  <para style="q1" vid="PSA 136:3">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:3">gogo i no save finis.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Hem nomo i stap mekem</para>
  <para style="q2" vid="PSA 136:4">ol bigbigfala merikel.</para>
  <para style="q1" vid="PSA 136:4">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:4">gogo i no save finis.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.5: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:1">Jen 1.1</ref>
      </char>
    </note>Olgeta samting long skae,</para>
  <para style="q2" vid="PSA 136:5">hem i mekem long waes blong hem.</para>
  <para style="q1" vid="PSA 136:5">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:5">gogo i no save finis.<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:2">Jen 1.2</ref>
      </char>
    </note>Hem i stanemap graon ya,</para>
  <para style="q2" vid="PSA 136:6">antap long dipsi.</para>
  <para style="q1" vid="PSA 136:6">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:6">gogo i no save finis.<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.7: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:16">Jen 1.16</ref>
      </char>
    </note>Hem i mekem san mo mun.</para>
  <para style="q1" vid="PSA 136:7">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:7">gogo i no save finis.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Hem i mekem san blong i rul long dei.</para>
  <para style="q1" vid="PSA 136:8">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:8">gogo i no save finis.<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Mo i mekem mun wetem ol sta</para>
  <para style="q2" vid="PSA 136:9">blong oli rul long naet.</para>
  <para style="q1" vid="PSA 136:9">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:9">gogo i no save finis.<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.10: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:29">Eks 12.29</ref>
      </char>
    </note>Hem i kilim ol fasbon pikinini boe</para>
  <para style="q2" vid="PSA 136:10">blong ol man Ijip oli ded<note caller="+" style="f"><char style="fr" closed="false">136.10: </char><char style="ft" closed="false">Yu luk futnot <char style="bd">Y</char> long 105.36.</char></note>.</para>
  <para style="q1" vid="PSA 136:10">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:10">gogo i no save finis.<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.11: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:51">Eks 12.51</ref>
      </char>
    </note>Hem i lidim yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 136:11">yumi kamaot long Ijip.</para>
  <para style="q1" vid="PSA 136:11">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:11">gogo i no save finis.<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Hem i mekem long han blong hem</para>
  <para style="q2" vid="PSA 136:12">we i gat paoa.</para>
  <para style="q1" vid="PSA 136:12">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:12">gogo i no save finis.<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21-29">Eks 14.21-29</ref>
      </char>
    </note>Hem i mekem Red Si i seraot,</para>
  <para style="q2" vid="PSA 136:13">mo drae graon i kamaot.</para>
  <para style="q1" vid="PSA 136:13">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:13">gogo i no save finis.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Nao hem i lidim ol bubu blong yumi</para>
  <para style="q2" vid="PSA 136:14">oli wokbaot long drae graon nomo,</para>
  <para style="q3" vid="PSA 136:14">oli gokros.</para>
  <para style="q1" vid="PSA 136:14">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:14">gogo i no save finis.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Be king blong Ijip wetem ol soldia blong hem</para>
  <para style="q2" vid="PSA 136:15">hem i draonem olgeta long ples ya.</para>
  <para style="q1" vid="PSA 136:15">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:15">gogo i no save finis.<verse eid="PSA 136:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />Hem i lidim ol bubu ya blong yumi</para>
  <para style="q2" vid="PSA 136:16">oli wokbaot long draeples,</para>
  <para style="q3" vid="PSA 136:16">gogo oli kamtru long Kenan.*</para>
  <para style="q1" vid="PSA 136:16">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:16">gogo i no save finis.<verse eid="PSA 136:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />Ol king we oli gat paoa,</para>
  <para style="q2" vid="PSA 136:17">hem i kilim olgeta oli ded.</para>
  <para style="q1" vid="PSA 136:17">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:17">gogo i no save finis.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Ol king we oli gat hae nem,</para>
  <para style="q2" vid="PSA 136:18">hem i kilim olgeta evriwan oli ded.</para>
  <para style="q1" vid="PSA 136:18">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:18">gogo i no save finis.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.19: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:21-30">Nam 21.21-30</ref>
      </char>
    </note>Hem i kilim King Sihon,</para>
  <para style="q2" vid="PSA 136:19">we i king blong ol laen blong Amoro.*</para>
  <para style="q1" vid="PSA 136:19">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:19">gogo i no save finis.<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136.20: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:31-35">Nam 21.31-35</ref>
      </char>
    </note>Mo i kilim King Og,</para>
  <para style="q2" vid="PSA 136:20">we i king blong Basan.</para>
  <para style="q1" vid="PSA 136:20">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:20">gogo i no save finis.<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Hem i givim ol graon blong olgeta</para>
  <para style="q2" vid="PSA 136:21">i kam long yumi ol laen blong Isrel.</para>
  <para style="q1" vid="PSA 136:21">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:21">gogo i no save finis.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Hem i givim ol graon ya long yumi,</para>
  <para style="q2" vid="PSA 136:22">we yumi ol man blong wok blong hem.</para>
  <para style="q1" vid="PSA 136:22">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:22">gogo i no save finis.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Taem ol enemi blong yumi oli winim yumi,</para>
  <para style="q2" vid="PSA 136:23">be hem i no fogetem yumi.</para>
  <para style="q1" vid="PSA 136:23">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:23">gogo i no save finis.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Hem i tekemaot yumi long han blong olgeta,</para>
  <para style="q2" vid="PSA 136:24">i mekem yumi fri.</para>
  <para style="q1" vid="PSA 136:24">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:24">gogo i no save finis.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Hem i stap givim kakae</para>
  <para style="q2" vid="PSA 136:25">long olgeta samting long wol ya</para>
  <para style="q3" vid="PSA 136:25">we oli gat laef.</para>
  <para style="q1" vid="PSA 136:25">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:25">gogo i no save finis.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />God ya blong yumi,</para>
  <para style="q2" vid="PSA 136:26">hem i stap long heven,</para>
  <para style="q3" vid="PSA 136:26">mo yumi mas talem tangkiu long hem.</para>
  <para style="q1" vid="PSA 136:26">Oltaem bambae hem i lavem yumi,</para>
  <para style="q2" vid="PSA 136:26">gogo i no save finis.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">Ol laen blong Isrel oli stap krae from trabol we i kasem olgeta long Babilon</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 137:1-2" />Taem mifala i stap long Babilon,</para>
  <para style="q3" vid="PSA 137:1-2">mifala i tingbaot Saeon,*</para>
  <para style="q2" vid="PSA 137:1-2">nao mifala i hangem ol gita blong mifala</para>
  <para style="q3" vid="PSA 137:1-2">long ol tri long ples ya,</para>
  <para style="q4" vid="PSA 137:1-2">nao mifala i sidaon klosap long wota,</para>
  <para style="q3" vid="PSA 137:1-2">mifala i stap krae.<verse eid="PSA 137:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Olgeta we oli tekem</para>
  <para style="q2" vid="PSA 137:3">mifala i go wok slef* long ples ya</para>
  <para style="q3" vid="PSA 137:3">oli talem long mifala</para>
  <para style="q4" vid="PSA 137:3">blong mifala i singsing.</para>
  <para style="q1" vid="PSA 137:3">Be oli stap jikim mifala nomo,</para>
  <para style="q2" vid="PSA 137:3">oli wantem blong mifala i singsing</para>
  <para style="q3" vid="PSA 137:3">blong mekem olgeta i harem gud.</para>
  <para style="q1" vid="PSA 137:3">Oli talem se,</para>
  <para style="q2" vid="PSA 137:3">“Yufala i singsing long wan sing blong Saeon</para>
  <para style="q3" vid="PSA 137:3">blong mifala i harem.”<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Be mifala i talem se,</para>
  <para style="q2" vid="PSA 137:4">“?Olsem wanem</para>
  <para style="q2" vid="PSA 137:4">bambae mifala i save singsing long Hae God</para>
  <para style="q3" vid="PSA 137:4">long narafala kantri olsem?”<note caller="+" style="f"><char style="fr" closed="false">137.4: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. </char><char style="fqa" closed="false">?Olsem wanem bambae <char style="bd">yumi</char> save singsing long Hae God long narafala kantri olsem?</char></note><verse eid="PSA 137:4" /></para>
  <para style="sp">(Tok i go long taon ya Jerusalem,* ples ya we haos blong Hae God i stap long hem.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Jerusalem.</para>
  <para style="q1" vid="PSA 137:5">Sipos mi mi fogetem yu,</para>
  <para style="q3" vid="PSA 137:5">i gud raethan blong mi i kam nogud,</para>
  <para style="q4" vid="PSA 137:5">blong mi no moa save kilim gita blong mi bakegen.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Sipos mi no moa tingbaot yu,</para>
  <para style="q2" vid="PSA 137:6">no mi mekem we yu yu no moa nambawan samting</para>
  <para style="q3" vid="PSA 137:6">blong mekem mi mi glad,</para>
  <para style="q2" vid="PSA 137:6">i gud voes blong mi i kam nogud</para>
  <para style="q3" vid="PSA 137:6">we mi no moa save singsing bakegen samtaem.<verse eid="PSA 137:6" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />Hae God.</para>
  <para style="q1" vid="PSA 137:7">Plis yu tingbaot ol samting ya</para>
  <para style="q2" vid="PSA 137:7">we ol man Edom oli mekem</para>
  <para style="q3" vid="PSA 137:7">long dei ya we ol man Babilon</para>
  <para style="q4" vid="PSA 137:7">oli kam faet agens long Jerusalem,</para>
  <para style="q3" vid="PSA 137:7">oli holem ples ya.</para>
  <para style="q1" vid="PSA 137:7">Ol man Edom ya oli stap talem se,</para>
  <para style="q2" vid="PSA 137:7">“!Brekemdaon taon ya!</para>
  <para style="q2" vid="PSA 137:7">!Flatemgud hem!”<verse eid="PSA 137:7" /></para>
  <para style="sp">(Tok i go long taon ya Babilon.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">137.8: </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:6">Rev 18.6</ref>
      </char>
    </note>Babilon,</para>
  <para style="q2" vid="PSA 137:8">God bambae i spolem yu.</para>
  <para style="q1" vid="PSA 137:8">Man we bambae i givimbak long yu</para>
  <para style="q2" vid="PSA 137:8">ol samting ya we yu yu mekem long mifala,</para>
  <para style="q3" vid="PSA 137:8">hem bambae i harem gud.<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Man we bambae i tekem ol smol pikinini blong yu,</para>
  <para style="q2" vid="PSA 137:9">i stap smasem olgeta long bigfala ston,</para>
  <para style="q3" vid="PSA 137:9">hem bambae i harem gud.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">Prea we man i mekem blong talem tangkiu long Hae God</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />Hae God.</para>
  <para style="q1" vid="PSA 138:1">Mi mi talem tangkiu long yu</para>
  <para style="q3" vid="PSA 138:1">long olgeta tingting blong mi.</para>
  <para style="q1" vid="PSA 138:1">Mi stap sing blong presem yu</para>
  <para style="q2" vid="PSA 138:1">long fes blong ol narafala god.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Oltaem yu yu lavem man tumas,</para>
  <para style="q2" vid="PSA 138:2">mo yu stap holem ol promes* blong yu.</para>
  <para style="q1" vid="PSA 138:2">Yu yu bin soemaot</para>
  <para style="q2" vid="PSA 138:2">we nem blong yu mo ol tok we yu yu putum,</para>
  <para style="q3" vid="PSA 138:2">tufala i hae we i hae,</para>
  <para style="q4" vid="PSA 138:2">i winim ol narafala samting.</para>
  <para style="q1" vid="PSA 138:2">From ol samting ya,</para>
  <para style="q2" vid="PSA 138:2">oltaem mi stap lukluk i go</para>
  <para style="q4" vid="PSA 138:2">long haos* blong yu we i tabu,</para>
  <para style="q3" vid="PSA 138:2">mi stap bodaon,</para>
  <para style="q3" vid="PSA 138:2">mi stap presem nem blong yu.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Taem mi mi krae i go long yu,</para>
  <para style="q2" vid="PSA 138:3">yu yu harem krae blong mi,</para>
  <para style="q3" vid="PSA 138:3">yu mekem mi mi strong moa</para>
  <para style="q4" vid="PSA 138:3">long paoa blong yu.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />Hae God.</para>
  <para style="q1" vid="PSA 138:4">Olgeta king long wol</para>
  <para style="q2" vid="PSA 138:4">oli harem ol promes blong yu,</para>
  <para style="q3" vid="PSA 138:4">mo bambae oli presem yu.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Bambae oli singsing</para>
  <para style="q2" vid="PSA 138:5">blong talemaot ol fasin blong yu,</para>
  <para style="q3" vid="PSA 138:5">from we yu yu King,</para>
  <para style="q4" vid="PSA 138:5">mo yu hae we yu hae.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Be nating we yu yu hae olsem,</para>
  <para style="q2" vid="PSA 138:6">oltaem yu stap lukaot gud long ol man</para>
  <para style="q3" vid="PSA 138:6">we tingting blong olgeta i stap daon.</para>
  <para style="q1" vid="PSA 138:6">Be ol praod man oli no save haed</para>
  <para style="q3" vid="PSA 138:6">long fes blong yu.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Taem ol trabol i stap kam long mi</para>
  <para style="q2" vid="PSA 138:7">yu yu stap holem mi mi stap gud.</para>
  <para style="q1" vid="PSA 138:7">Yu stap agens long ol enemi blong mi</para>
  <para style="q3" vid="PSA 138:7">we oli stap kros tumas long mi,</para>
  <para style="q2" vid="PSA 138:7">mo yu stap sevem mi</para>
  <para style="q4" vid="PSA 138:7">long paoa blong yu.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />Hae God.</para>
  <para style="q1" vid="PSA 138:8">Oltaem bambae yu yu lavem man</para>
  <para style="q2" vid="PSA 138:8">gogo i no save finis.</para>
  <para style="q1" vid="PSA 138:8">Bambae yu yu mekem evri samting</para>
  <para style="q2" vid="PSA 138:8">we yu bin promes blong mekem long mi.</para>
  <para style="q1" vid="PSA 138:8">Yu yu statem wok ya finis,</para>
  <para style="q2" vid="PSA 138:8">plis yu gohed long hem</para>
  <para style="q3" vid="PSA 138:8">gogo i finis.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">Hae God i savegud mi, mo i stap lukaot gud long mi</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />Hae God.</para>
  <para style="q1" vid="PSA 139:1">Yu yu lukluk gud long mi finis,</para>
  <para style="q3" vid="PSA 139:1">mo yu savegud mi.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Yu yu save evri samting</para>
  <para style="q2" vid="PSA 139:2">we mi stap mekem.</para>
  <para style="q1" vid="PSA 139:2">Yu stap longwe,</para>
  <para style="q2" vid="PSA 139:2">be yu save olgeta tingting blong mi.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Nating we mi stap wok no mi stap spel,</para>
  <para style="q2" vid="PSA 139:3">be yu yu stap luk mi,</para>
  <para style="q3" vid="PSA 139:3">mo yu save olgeta samting we mi stap mekem.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Nating we mi no tok yet,</para>
  <para style="q2" vid="PSA 139:4">be yu yu save finis ol samting ya</para>
  <para style="q3" vid="PSA 139:4">we bambae mi talem.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Yu yu stap blokemgud mi long evri saed,</para>
  <para style="q2" vid="PSA 139:5">yu stap lukaot gud long mi long paoa blong yu.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Yu yu save mi we yu savegud mi,</para>
  <para style="q2" vid="PSA 139:6">fasin blong yu blong save mi i dip we i dip,</para>
  <para style="q2" vid="PSA 139:6">mi mi no naf blong save samting ya.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />?Weples bambae mi save go haed long hem</para>
  <para style="q2" vid="PSA 139:7">blong yu no luk mi?</para>
  <para style="q1" vid="PSA 139:7">?Weples bambae mi save go long hem</para>
  <para style="q2" vid="PSA 139:7">blong ronwe long yu?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Sipos mi go long heven,</para>
  <para style="q2" vid="PSA 139:8">be yu yu stap long ples ya,</para>
  <para style="q3" vid="PSA 139:8">bambae yu luk mi,</para>
  <para style="q2" vid="PSA 139:8">mo sipos mi go ledaon long Hom* blong ol Dedman,</para>
  <para style="q3" vid="PSA 139:8">be yu yu stap long ples ya tu,</para>
  <para style="q4" vid="PSA 139:8">bambae yu faenem mi.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Sipos mi ronwe, mi go long is,</para>
  <para style="q2" vid="PSA 139:9">we mi go bitim ples ya</para>
  <para style="q4" vid="PSA 139:9">we san i stap kam antap long hem,</para>
  <para style="q3" vid="PSA 139:9">no mi go longwe long wes,</para>
  <para style="q4" vid="PSA 139:9">mi go bitim ples ya</para>
  <para style="q3" vid="PSA 139:9">we san i stap godaon long hem,<verse eid="PSA 139:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 139:10" />be bambae yu yu stap long ples ya</para>
  <para style="q4" vid="PSA 139:10">blong lidim mi,</para>
  <para style="q3" vid="PSA 139:10">mo blong givhan long mi.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Mi mi save askem tudak i kam</para>
  <para style="q3" vid="PSA 139:11">blong mi haed long hem,</para>
  <para style="q2" vid="PSA 139:11">mo mi save askem delaet we i stap raon long mi</para>
  <para style="q3" vid="PSA 139:11">i kam naet,<verse eid="PSA 139:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 139:12" />be tudak,</para>
  <para style="q4" vid="PSA 139:12">hem i no dak nating long yu,</para>
  <para style="q3" vid="PSA 139:12">mo naet,</para>
  <para style="q3" vid="PSA 139:12">long yu hem i olsem dei nomo.</para>
  <para style="q1" vid="PSA 139:12">Tudak mo delaet,</para>
  <para style="q2" vid="PSA 139:12">long yu, tufala i sem mak nomo.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Taem mi stap yet long bel blong mama blong mi,</para>
  <para style="q2" vid="PSA 139:13">yu yu mekem evri haf blong bodi blong mi,</para>
  <para style="q3" vid="PSA 139:13">mo yu mekem olgeta oli joen gud.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Yu yu mekem mi</para>
  <para style="q2" vid="PSA 139:14">long fasin we i narafala,</para>
  <para style="q3" vid="PSA 139:14">mo i nambawan olgeta.</para>
  <para style="q1" vid="PSA 139:14">Mi mi ona long yu,</para>
  <para style="q2" vid="PSA 139:14">mo mi presem nem blong yu from.</para>
  <para style="q1" vid="PSA 139:14">Olgeta samting we yu yu mekem</para>
  <para style="q2" vid="PSA 139:14">oli gud we i gud tumas.</para>
  <para style="q1" vid="PSA 139:14">Samting ya,</para>
  <para style="q2" vid="PSA 139:14">mi mi save we mi savegud.<note caller="+" style="f"><char style="fr" closed="false">139.14: </char><char style="ft" closed="false">Narafala rod blong tanem tok long las haf blong vas ya i olsem. </char><char style="fqa" closed="false">Yu yu savegud evri samting long laef blong mi.</char></note><verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Taem mi mi stap long bel blong mama blong mi,</para>
  <para style="q3" vid="PSA 139:15">long ples ya we i haed we i haed,</para>
  <para style="q2" vid="PSA 139:15">nao ol bun blong mi oli stap joen gud,</para>
  <para style="q4" vid="PSA 139:15">mi stap gru,</para>
  <para style="q3" vid="PSA 139:15">be yu yu luk mi we mi stap long ples ya.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />Taem mi mi no bon yet,</para>
  <para style="q3" vid="PSA 139:16">be yu yu luk mi finis,</para>
  <para style="q2" vid="PSA 139:16">mo olgeta dei we yu yu makemaot</para>
  <para style="q4" vid="PSA 139:16">se oli blong mi,</para>
  <para style="q3" vid="PSA 139:16">nating we oli no kamtru yet,</para>
  <para style="q4" vid="PSA 139:16">be yu yu raetemdaon olgeta finis</para>
  <para style="q3" vid="PSA 139:16">long buk blong yu.<verse eid="PSA 139:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />God,</para>
  <para style="q2" vid="PSA 139:17">i strong tumas</para>
  <para style="q3" vid="PSA 139:17">blong mi kasem ol tingting blong yu.<note caller="+" style="f"><char style="fr" closed="false">139.17: </char><char style="ft" closed="false">Narafala rod blong tanem tok long fas haf blong vas ya i olsem. </char><char style="fqa" closed="false">God, <char style="bd">mi mi luk</char> </char><char style="fqa" closed="false">ol tingting blong yu oli gud we i gud tumas.</char></note></para>
  <para style="q1" vid="PSA 139:17">Olgeta oli plante we plante.<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Sipos mi kaontem olgeta,</para>
  <para style="q2" vid="PSA 139:18">bambae mi faenemaot se oli plante moa,</para>
  <para style="q3" vid="PSA 139:18">i winim sanbij long solwota.</para>
  <para style="q1" vid="PSA 139:18">Sipos mi mi slip,</para>
  <para style="q3" vid="PSA 139:18">nao mi wekap bakegen,</para>
  <para style="q2" vid="PSA 139:18">be bambae mi stap wetem yu yet.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />God.</para>
  <para style="q1" vid="PSA 139:19">!Mi wantem tumas</para>
  <para style="q2" vid="PSA 139:19">blong yu kilim ol man nogud ya oli ded!</para>
  <para style="q1" vid="PSA 139:19">!Mi wantem tumas</para>
  <para style="q2" vid="PSA 139:19">se ol man blong faet ya oli mas livim mi!<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Oli stap talem ol rabis tok</para>
  <para style="q3" vid="PSA 139:20">agens long yu,</para>
  <para style="q2" vid="PSA 139:20">oli stap tok nogud blong spolem nem blong yu.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />Hae God.</para>
  <para style="q1" vid="PSA 139:21">Mi mi no laekem nating olgeta ya</para>
  <para style="q2" vid="PSA 139:21">we oli no laekem yu,</para>
  <para style="q3" vid="PSA 139:21">mi mi agens long olgeta</para>
  <para style="q4" vid="PSA 139:21">from we oli stap agens long yu.</para>
  <para style="q1" vid="PSA 139:21">Oltaem mi stap harem nogud</para>
  <para style="q2" vid="PSA 139:21">from we olgeta ya oli stap mekem</para>
  <para style="q3" vid="PSA 139:21">i nogud long yu.<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Mi mi no laekem olgeta</para>
  <para style="q2" vid="PSA 139:22">we mi no laekem olgeta nating,</para>
  <para style="q3" vid="PSA 139:22">oltaem mi stap makem olgeta,</para>
  <para style="q4" vid="PSA 139:22">se oli enemi blong mi nomo.<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />God,</para>
  <para style="q2" vid="PSA 139:23">plis yu lukluk gud long mi,</para>
  <para style="q3" vid="PSA 139:23">blong yu savegud ol tingting blong mi.</para>
  <para style="q1" vid="PSA 139:23">Plis yu skelem laef blong mi,</para>
  <para style="q2" vid="PSA 139:23">blong yu faenemaot ol samting</para>
  <para style="q3" vid="PSA 139:23">we mi stap tingting long hem.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Mo sipos i gat sam samting nogud</para>
  <para style="q3" vid="PSA 139:24">long laef blong mi,</para>
  <para style="q2" vid="PSA 139:24">plis i gud yu traem faenemaot,</para>
  <para style="q3" vid="PSA 139:24">nao yu lidim mi long rod ya</para>
  <para style="q4" vid="PSA 139:24">we i no save lus.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">Prea we man i mekem blong Hae God i lukaot gud long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Hae God.</para>
  <para style="q1" vid="PSA 140:1">Plis yu tekemaot mi</para>
  <para style="q3" vid="PSA 140:1">long han blong ol man nogud.</para>
  <para style="q1" vid="PSA 140:1">Plis yu blokem ol man blong faet</para>
  <para style="q3" vid="PSA 140:1">oli no kam long mi,</para>
  <para style="q2" vid="PSA 140:1">mo yu lukaot gud long mi.<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />Oltaem olgeta ya oli stap mekem plan</para>
  <para style="q2" vid="PSA 140:2">blong mekem ol rabis fasin,</para>
  <para style="q3" vid="PSA 140:2">mo oltaem oli stap traem blong statem rao.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140.3: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:13">Rom 3.13</ref>
      </char>
    </note>Maot blong olgeta i sap tumas,</para>
  <para style="q3" vid="PSA 140:3">olsem tut blong rabis snek,</para>
  <para style="q2" vid="PSA 140:3">mo ol tok blong olgeta</para>
  <para style="q4" vid="PSA 140:3">i olsem posen blong snek.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />Hae God.</para>
  <para style="q1" vid="PSA 140:4">Ol man nogud ya oli man blong faet,</para>
  <para style="q2" vid="PSA 140:4">mo oli stap mekem plan</para>
  <para style="q3" vid="PSA 140:4">blong mekem mi mi foldaon.</para>
  <para style="q1" vid="PSA 140:4">Plis yu tekemaot mi long paoa blong olgeta,</para>
  <para style="q2" vid="PSA 140:4">mo yu blokemgud mi.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Ol praod man oli putum trap finis</para>
  <para style="q3" vid="PSA 140:5">blong kasem mi,</para>
  <para style="q2" vid="PSA 140:5">oli pulum ol net blong olgeta</para>
  <para style="q4" vid="PSA 140:5">oli stap rere,</para>
  <para style="q3" vid="PSA 140:5">mo oli taetem ol sling long rod blong mi,</para>
  <para style="q4" vid="PSA 140:5">blong holem mi.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6-8" style="v" sid="PSA 140:6-8" />Hae God, yu yu Masta* blong mi.</para>
  <para style="q1" vid="PSA 140:6-8">Oltaem mi stap talem se,</para>
  <para style="q2" vid="PSA 140:6-8">“Yu yu God blong mi.”</para>
  <para style="q1" vid="PSA 140:6-8">Plis yu harem prea blong mi.</para>
  <para style="q1" vid="PSA 140:6-8">Yu nao yu stap blokemgud mi</para>
  <para style="q2" vid="PSA 140:6-8">long paoa blong yu,</para>
  <para style="q3" vid="PSA 140:6-8">mo yu stap lukaot gud long mi</para>
  <para style="q4" vid="PSA 140:6-8">long taem blong faet.</para>
  <para style="q1" vid="PSA 140:6-8">Ol samting ya we ol man nogud oli wantem,</para>
  <para style="q3" vid="PSA 140:6-8">plis yu no givim long olgeta.</para>
  <para style="q1" vid="PSA 140:6-8">Plis yu no letem plan blong olgeta i kamtru</para>
  <para style="q3" vid="PSA 140:6-8">olsem we oli wantem.<verse eid="PSA 140:6-8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Plis yu no letem</para>
  <para style="q3" vid="PSA 140:9">ol enemi blong mi oli winim mi,</para>
  <para style="q2" vid="PSA 140:9">yu mekem</para>
  <para style="q3" vid="PSA 140:9">we ol strong tok blong olgeta</para>
  <para style="q3" vid="PSA 140:9">i kasem olgeta bakegen.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Mi wantem we faea i foldaon long olgeta,</para>
  <para style="q2" vid="PSA 140:10">i bonem olgeta.</para>
  <para style="q1" vid="PSA 140:10">Plis yu sakem olgeta i go insaed long wan hol</para>
  <para style="q2" vid="PSA 140:10">we neva oli save kamaot bakegen.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Mi wantem</para>
  <para style="q2" vid="PSA 140:11">se ol man we oli stap mekem giaman toktok</para>
  <para style="q3" vid="PSA 140:11">blong spolem nem blong narafala man,</para>
  <para style="q4" vid="PSA 140:11">bambae oli no save win.</para>
  <para style="q1" vid="PSA 140:11">Plis yu letem</para>
  <para style="q2" vid="PSA 140:11">ol samting nogud i kasem ol man blong faet,</para>
  <para style="q3" vid="PSA 140:11">i spolemgud olgeta wantaem nomo.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />Hae God.</para>
  <para style="q1" vid="PSA 140:12">Mi save we yu yu stap givhan</para>
  <para style="q2" vid="PSA 140:12">long ol puaman</para>
  <para style="q3" vid="PSA 140:12">long ol trabol blong olgeta,</para>
  <para style="q2" vid="PSA 140:12">mo yu stap mekem</para>
  <para style="q3" vid="PSA 140:12">we olgeta oli kasem ol samting</para>
  <para style="q4" vid="PSA 140:12">we oli gat raet blong kasem.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />I tru,</para>
  <para style="q2" vid="PSA 140:13">ol stret man bambae oli stap wetem yu,</para>
  <para style="q3" vid="PSA 140:13">mo oltaem bambae oli stap presem yu.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">Prea we man i prea long hem long naet</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />Hae God.</para>
  <para style="q1" vid="PSA 141:1">Mi mi stap krae i kam long yu.</para>
  <para style="q1" vid="PSA 141:1">Plis yu kwik, yu givhan long mi.</para>
  <para style="q1" vid="PSA 141:1">Mi stap krae i kam long yu,</para>
  <para style="q2" vid="PSA 141:1">plis yu lesin long mi.<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141.2: </char>
      <char style="xt" closed="false">
        <ref loc="REV 5:8">Rev 5.8</ref>
      </char>
    </note>Plis yu letem prea blong mi i kam long yu</para>
  <para style="q2" vid="PSA 141:2">olsem smok blong insens*</para>
  <para style="q3" vid="PSA 141:2">we man i bonem i kam long yu.</para>
  <para style="q1" vid="PSA 141:2">Taem mi leftemap han blong mi</para>
  <para style="q3" vid="PSA 141:2">blong prea long yu,</para>
  <para style="q2" vid="PSA 141:2">plis yu glad long mi</para>
  <para style="q3" vid="PSA 141:2">olsem we yu glad long ol sakrefaes ya</para>
  <para style="q4" vid="PSA 141:2">we pris* i stap bonem long sapa.<verse eid="PSA 141:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />Hae God, plis yu blokem mi</para>
  <para style="q2" vid="PSA 141:3">blong mi no stap talem ol rabis tok,</para>
  <para style="q1" vid="PSA 141:3">Plis yu givhan long mi</para>
  <para style="q2" vid="PSA 141:3">blong mi no save tok nogud long ol man.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Plis yu lukaot long mi</para>
  <para style="q2" vid="PSA 141:4">blong mi no mekem ol samting we i rong,</para>
  <para style="q3" vid="PSA 141:4">mo blong mi no go joen wetem ol man nogud</para>
  <para style="q4" vid="PSA 141:4">long ol rabis fasin blong olgeta.</para>
  <para style="q1" vid="PSA 141:4">Mi wantem</para>
  <para style="q2" vid="PSA 141:4">se neva bambae mi go joen long ol lafet blong olgeta.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Mi mi save letem gudfala man i kilim mi</para>
  <para style="q2" vid="PSA 141:5">no i tok strong long mi,</para>
  <para style="q3" vid="PSA 141:5">blong stretem mi.</para>
  <para style="q1" vid="PSA 141:5">Be ol man nogud,</para>
  <para style="q2" vid="PSA 141:5">oltaem mi stap prea</para>
  <para style="q3" vid="PSA 141:5">blong yu blokem ol rabis fasin blong olgeta,</para>
  <para style="q2" vid="PSA 141:5">mo from samting ya,</para>
  <para style="q3" vid="PSA 141:5">mi no save letem</para>
  <para style="q4" vid="PSA 141:5">olgeta oli leftemap nem blong mi.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Nao taem yu sakem ol haeman blong olgeta</para>
  <para style="q3" vid="PSA 141:6">oli godaon long klif,</para>
  <para style="q2" vid="PSA 141:6">bambae ol man oli luksave</para>
  <para style="q4" vid="PSA 141:6">se ol tok blong mi i tru.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Bambae yu sakem ol bun blong olgeta</para>
  <para style="q3" vid="PSA 141:7">olbaot long beregraon,</para>
  <para style="q2" vid="PSA 141:7">olsem wud we man i splitim,</para>
  <para style="q3" vid="PSA 141:7">i katkatem long ol smosmol pis.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Hae God, yu yu God blong mi,</para>
  <para style="q2" vid="PSA 141:8">mo mi mi stap trastem yu oltaem.</para>
  <para style="q1" vid="PSA 141:8">Mi wantem tumas</para>
  <para style="q3" vid="PSA 141:8">blong yu yu stap lukaot gud long mi.</para>
  <para style="q1" vid="PSA 141:8">Plis yu no letem mi mi ded.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Plis yu blokem mi</para>
  <para style="q2" vid="PSA 141:9">blong mi no foldaon long ol hol</para>
  <para style="q3" vid="PSA 141:9">we ol man nogud oli digim blong kasem mi,</para>
  <para style="q2" vid="PSA 141:9">mo blong mi no fas long ol sling</para>
  <para style="q3" vid="PSA 141:9">we olgeta oli putum.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Plis yu letem</para>
  <para style="q2" vid="PSA 141:10">olgeta oli foldaon bakegen</para>
  <para style="q3" vid="PSA 141:10">long ol trap blong olgeta,</para>
  <para style="q2" vid="PSA 141:10">be yu letem mi mi wokbaot i go,</para>
  <para style="q3" vid="PSA 141:10">we i no gat wan samting i spolem mi.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">Prea we man i mekem blong Hae God i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem. Hemia prea blong hem, long taem ya we hem i stap haed long hol blong ston.<note caller="+" style="f"><char style="fr" closed="false">142.0 </char><char style="fqa" closed="false">Fastok: </char><char style="ft" closed="false">Yu luk stori ya long 1 Samuel 22.1 mo 24.3.</char></note>)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Olgeta.</para>
  <para style="q1" vid="PSA 142:1">Mi mi krae i go long Hae God</para>
  <para style="q3" vid="PSA 142:1">blong hem i givhan long mi.</para>
  <para style="q1" vid="PSA 142:1">Mi stap askem long hem</para>
  <para style="q2" vid="PSA 142:1">blong hem i sore long mi.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Mi talemaot olgeta samting long hem</para>
  <para style="q3" vid="PSA 142:2">we i mekem mi mi harem nogud,</para>
  <para style="q2" vid="PSA 142:2">mi talemaot olgeta trabol blong mi long hem.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Taem mi mi harem nogud tumas,</para>
  <para style="q3" vid="PSA 142:3">we tingting blong mi i foldaon from,</para>
  <para style="q2" vid="PSA 142:3">be hem i save wanem samting</para>
  <para style="q4" vid="PSA 142:3">we bambae mi mas mekem.</para>
  <para style="q1" vid="PSA 142:3">Long rod ya we mi stap wokbaot long hem,</para>
  <para style="q2" vid="PSA 142:3">ol enemi blong mi oli putum wan trap finis</para>
  <para style="q4" vid="PSA 142:3">blong kasem mi.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Be taem mi luk biaen long mi,</para>
  <para style="q2" vid="PSA 142:4">mi no luk wan man we i save givhan long mi,</para>
  <para style="q3" vid="PSA 142:4">i no gat man we i save blokemgud mi,</para>
  <para style="q4" vid="PSA 142:4">i no gat wan man nating we i save lukaot gud long mi.<verse eid="PSA 142:4" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />Hae God, mi stap krae long yu</para>
  <para style="q2" vid="PSA 142:5">blong yu givhan long mi.</para>
  <para style="q1" vid="PSA 142:5">Mi talem se,</para>
  <para style="q2" vid="PSA 142:5">“Yu nomo yu stap lukaot long mi.</para>
  <para style="q1" vid="PSA 142:5">Olgeta laef blong mi long wol ya,</para>
  <para style="q2" vid="PSA 142:5">yu nao.”<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Tingting blong mi i foldaon olgeta.</para>
  <para style="q1" vid="PSA 142:6">Plis yu lesin long mi</para>
  <para style="q2" vid="PSA 142:6">we mi stap krae long yu</para>
  <para style="q3" vid="PSA 142:6">blong yu givhan long mi.</para>
  <para style="q1" vid="PSA 142:6">Ol enemi ya blong mi</para>
  <para style="q3" vid="PSA 142:6">oli strong tumas winim mi,</para>
  <para style="q2" vid="PSA 142:6">plis yu tekemaot mi long han blong olgeta.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Mi mi stap long trabol ya</para>
  <para style="q2" vid="PSA 142:7">olsem we mi stap long kalabus.</para>
  <para style="q1" vid="PSA 142:7">Plis yu mekem mi mi fri,</para>
  <para style="q2" vid="PSA 142:7">nao bambae mi presem yu</para>
  <para style="q4" vid="PSA 142:7">long fes blong ol man blong yu,</para>
  <para style="q3" vid="PSA 142:7">from we yu yu mekem i gud tumas long mi.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">Prea we man i mekem blong Hae God i givhan long hem</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />Hae God.</para>
  <para style="q1" vid="PSA 143:1">Plis yu harem prea blong mi.</para>
  <para style="q1" vid="PSA 143:1">Fasin blong yu i stret,</para>
  <para style="q2" vid="PSA 143:1">mo oltaem yu stap holem promes blong yu</para>
  <para style="q3" vid="PSA 143:1">we yu mekem wetem man.</para>
  <para style="q1" vid="PSA 143:1">Plis yu lesin long tok blong mi,</para>
  <para style="q2" vid="PSA 143:1">yu harem krae blong mi.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143.2: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:20">Rom 3.20</ref>; <ref loc="GAL 2:16">Gal 2.16</ref></char>
    </note>Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 143:2">be yu yu save,</para>
  <para style="q3" vid="PSA 143:2">long wol ya,</para>
  <para style="q4" vid="PSA 143:2">i no gat wan man we i stret,</para>
  <para style="q3" vid="PSA 143:2">mifala evriwan i stap mekem i nogud.</para>
  <para style="q1" vid="PSA 143:2">Plis yu no jajem mi.<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Enemi ya blong mi i stap ronem mi</para>
  <para style="q3" vid="PSA 143:3">gogo i kasem mi,</para>
  <para style="q2" vid="PSA 143:3">nao hem i flatem mi,</para>
  <para style="q4" vid="PSA 143:3">i winimgud mi.</para>
  <para style="q1" vid="PSA 143:3">Hem i putum mi long kalabus ya</para>
  <para style="q3" vid="PSA 143:3">we i tudak olgeta,</para>
  <para style="q2" vid="PSA 143:3">nao mi mi stap olsem man</para>
  <para style="q4" vid="PSA 143:3">we i ded longtaem finis.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Nao mi mi harem nogud,</para>
  <para style="q3" vid="PSA 143:4">mi wantem livim evri samting,</para>
  <para style="q2" vid="PSA 143:4">from we tingting blong mi i foldaon</para>
  <para style="q4" vid="PSA 143:4">we i foldaon olgeta.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Be taem mi stap tingtingbak</para>
  <para style="q3" vid="PSA 143:5">long ol dei ya we i pas finis,</para>
  <para style="q2" vid="PSA 143:5">mi stap tingbaot olgeta wok ya</para>
  <para style="q4" vid="PSA 143:5">we yu yu mekem,</para>
  <para style="q3" vid="PSA 143:5">mo mi stap tingting long olgeta samting ya</para>
  <para style="q3" vid="PSA 143:5">we yu yu mekem long mi.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Naoia laef blong mi i olsem graon</para>
  <para style="q2" vid="PSA 143:6">we i drae we i drae.</para>
  <para style="q1" vid="PSA 143:6">Mi mi wantem yu tumas,</para>
  <para style="q2" vid="PSA 143:6">olsem man we i tosta</para>
  <para style="q4" vid="PSA 143:6">i wantem tumas blong dring wota,</para>
  <para style="q3" vid="PSA 143:6">nao mi stap leftemap han blong mi</para>
  <para style="q3" vid="PSA 143:6">blong prea long yu.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />!Hae God, plis yu kwik!</para>
  <para style="q1" vid="PSA 143:7">!Plis yu harem krae blong mi!</para>
  <para style="q1" vid="PSA 143:7">Tingting blong mi i foldaon olgeta.</para>
  <para style="q1" vid="PSA 143:7">!Plis yu no haedem fes blong yu long mi!</para>
  <para style="q1" vid="PSA 143:7">I nogud mi go wetem olgeta</para>
  <para style="q2" vid="PSA 143:7">we oli godaon long Hom* blong ol Dedman.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Mi mi putum tingting blong mi</para>
  <para style="q2" vid="PSA 143:8">i stap strong long yu.</para>
  <para style="q1" vid="PSA 143:8">Evri moning,</para>
  <para style="q2" vid="PSA 143:8">plis yu soemaot long mi bakegen</para>
  <para style="q3" vid="PSA 143:8">we oltaem yu yu lavem man tumas.</para>
  <para style="q1" vid="PSA 143:8">Oltaem prea blong mi i stap go antap long yu.</para>
  <para style="q1" vid="PSA 143:8">Plis yu soemaot rod long mi,</para>
  <para style="q2" vid="PSA 143:8">blong mi mi folem.<verse eid="PSA 143:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />Hae God, mi mi kam long yu</para>
  <para style="q2" vid="PSA 143:9">blong yu blokemgud mi,</para>
  <para style="q3" vid="PSA 143:9">yu lukaot gud long mi.</para>
  <para style="q1" vid="PSA 143:9">Plis yu tekemaot mi</para>
  <para style="q2" vid="PSA 143:9">long han blong ol enemi blong mi.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 143:10">plis yu tijim mi</para>
  <para style="q3" vid="PSA 143:10">blong mi mekem ol samting</para>
  <para style="q4" vid="PSA 143:10">we yu yu wantem.</para>
  <para style="q1" vid="PSA 143:10">Yu yu gud tumas long mi,</para>
  <para style="q2" vid="PSA 143:10">plis yu lidim mi long rod we i sef.<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />Hae God, fasin blong yu i gud tumas.</para>
  <para style="q1" vid="PSA 143:11">Plis yu sevem mi</para>
  <para style="q3" vid="PSA 143:11">olsem we yu bin promes,</para>
  <para style="q2" vid="PSA 143:11">yu tekemaot mi long ol trabol ya</para>
  <para style="q4" vid="PSA 143:11">we mi stap long hem.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 143:12">we oltaem yu lavem mi tumas.</para>
  <para style="q1" vid="PSA 143:12">Plis yu kilim olgeta enemi ya blong mi,</para>
  <para style="q2" vid="PSA 143:12">yu spolem olgeta ya</para>
  <para style="q3" vid="PSA 143:12">we oli stap spolem mi.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">King i talem tangkiu long Hae God, from we hem i win</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Olgeta.</para>
  <para style="q1" vid="PSA 144:1">Mi mi presem Hae God</para>
  <para style="q2" vid="PSA 144:1">we i stap lukaot long mi.</para>
  <para style="q1" vid="PSA 144:1">Hem i stap tijim mi</para>
  <para style="q2" vid="PSA 144:1">blong mekem mi mi rere blong faet.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Hem i stap blokemgud mi,</para>
  <para style="q3" vid="PSA 144:2">mo i stap lukaot gud long mi.</para>
  <para style="q1" vid="PSA 144:2">Hem i sefples blong mi</para>
  <para style="q2" vid="PSA 144:2">mo i Sevia blong mi.</para>
  <para style="q1" vid="PSA 144:2">Mi mi stap trastem hem nomo</para>
  <para style="q3" vid="PSA 144:2">blong i sevem mi.</para>
  <para style="q1" vid="PSA 144:2">Hem nao i stap mekem</para>
  <para style="q2" vid="PSA 144:2">ol man blong ol narafala kantri</para>
  <para style="q3" vid="PSA 144:2">oli stap aninit long paoa blong mi.<verse eid="PSA 144:2" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144.3: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:17">Job 7.17</ref>,<ref loc="JOB 7:18">18</ref>; <ref loc="PSA 8:4">Sam 8.4</ref></char>
    </note>Hae God.</para>
  <para style="q1" vid="PSA 144:3">Mi mi luk man</para>
  <para style="q2" vid="PSA 144:3">se hem i samting nating nomo.</para>
  <para style="q1" vid="PSA 144:3">I no stret</para>
  <para style="q2" vid="PSA 144:3">blong yu yu lukluk long hem.</para>
  <para style="q1" vid="PSA 144:3">I no stret nating</para>
  <para style="q2" vid="PSA 144:3">blong yu yu tingbaot hem.<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Hem i olsem win</para>
  <para style="q2" vid="PSA 144:4">we i blu smoltaem nomo nao i finis.</para>
  <para style="q1" vid="PSA 144:4">Ol dei blong hem</para>
  <para style="q2" vid="PSA 144:4">i olsem wan sado we i pas finis.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />Hae God.</para>
  <para style="q1" vid="PSA 144:5">Plis yu openem skae yu kamdaon,</para>
  <para style="q2" vid="PSA 144:5">yu tajem ol hil long han blong yu,</para>
  <para style="q3" vid="PSA 144:5">nao bambae smok i kamaot long olgeta.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Yu sanem laetning i kam,</para>
  <para style="q3" vid="PSA 144:6">i mekem ol enemi blong yu oli ron wanwan</para>
  <para style="q2" vid="PSA 144:6">yu sutum olgeta long ol ara blong yu,</para>
  <para style="q4" vid="PSA 144:6">blong mekem olgeta oli ronwe.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Plis yu pusum han blong yu i kam,</para>
  <para style="q2" vid="PSA 144:7">yu pulumaot mi long dip wota ya,</para>
  <para style="q3" vid="PSA 144:7">yu sevem mi.</para>
  <para style="q1" vid="PSA 144:7">Yu tekemaot mi</para>
  <para style="q2" vid="PSA 144:7">long paoa blong ol man ya blong narafala kantri,<verse eid="PSA 144:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 144:8" />we neva oli talem trutok.</para>
  <para style="q1" vid="PSA 144:8">Olgeta ya,</para>
  <para style="q2" vid="PSA 144:8">nating we oli stap talem nem blong yu</para>
  <para style="q3" vid="PSA 144:8">blong mekem tok blong olgeta i strong,</para>
  <para style="q2" vid="PSA 144:8">be oli stap giaman nomo.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />God,</para>
  <para style="q2" vid="PSA 144:9">bambae mi singsing long yu</para>
  <para style="q3" vid="PSA 144:9">long wan niufala sing,</para>
  <para style="q4" vid="PSA 144:9">bambae mi kilim gita blong mi,</para>
  <para style="q3" vid="PSA 144:9">mi sing long yu.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />Oltaem yu stap mekem ol king oli win long faet.</para>
  <para style="q1" vid="PSA 144:10">Mi mi man blong wok blong yu,</para>
  <para style="q2" vid="PSA 144:10">mo yu yu stap sevem mi.<note caller="+" style="f"><char style="fr" closed="false">144.10: </char><char style="ft" closed="false">Narafala rod blong tanem tok ya i olsem. Oltaem yu stap mekem ol king oli win long faet, mo yu sevem King Deved, man blong wok blong yu.</char></note><verse eid="PSA 144:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Ol enemi blong mi,</para>
  <para style="q2" vid="PSA 144:11">fasin blong olgeta i strong tumas.</para>
  <para style="q1" vid="PSA 144:11">Plis yu blokem olgeta oli no kam spolem mi</para>
  <para style="q2" vid="PSA 144:11">yu sevem mi.</para>
  <para style="q1" vid="PSA 144:11">Yu tekemaot mi long paoa</para>
  <para style="q2" vid="PSA 144:11">blong ol man ya blong narafala kantri,</para>
  <para style="q3" vid="PSA 144:11">we neva oli talem trutok.</para>
  <para style="q1" vid="PSA 144:11">Olgeta ya,</para>
  <para style="q2" vid="PSA 144:11">nating we oli stap talem nem blong yu</para>
  <para style="q3" vid="PSA 144:11">blong mekem tok blong olgeta i strong,</para>
  <para style="q4" vid="PSA 144:11">be oli stap giaman nomo.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Mifala i wantem</para>
  <para style="q2" vid="PSA 144:12">se ol yang boe blong mifala</para>
  <para style="q3" vid="PSA 144:12">bambae oli kam strong</para>
  <para style="q3" vid="PSA 144:12">olsem ol yang tri we oli stap gru gud,</para>
  <para style="q2" vid="PSA 144:12">mo ol dota blong mifala bambae oli naes</para>
  <para style="q3" vid="PSA 144:12">olsem ol pos blong kona blong haos blong king</para>
  <para style="q3" vid="PSA 144:12">we oli katem blong flasem haos ya.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Mifala i wantem</para>
  <para style="q2" vid="PSA 144:13">se ol garen blong mifala</para>
  <para style="q3" vid="PSA 144:13">oli karem plante kakae,</para>
  <para style="q4" vid="PSA 144:13">nao ol haos blong kakae blong mifala</para>
  <para style="q3" vid="PSA 144:13">bambae oli fulap gud,</para>
  <para style="q2" vid="PSA 144:13">mo ol sipsip long ol fenis blong mifala</para>
  <para style="q3" vid="PSA 144:13">bambae oli karem pikinini</para>
  <para style="q4" vid="PSA 144:13">we i plante we plante.<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />Mifala i wantem</para>
  <para style="q2" vid="PSA 144:14">se ol buluk blong mifala</para>
  <para style="q3" vid="PSA 144:14">bambae oli no save lusum ol pikinini blong olgeta</para>
  <para style="q4" vid="PSA 144:14">blong oli save kam plante we plante.</para>
  <para style="q1" vid="PSA 144:14">Mifala i wantem</para>
  <para style="q2" vid="PSA 144:14">se ol enemi blong mifala</para>
  <para style="q3" vid="PSA 144:14">bambae oli no moa stap klosap long mifala,</para>
  <para style="q2" vid="PSA 144:14">nao ol man blong mifala</para>
  <para style="q3" vid="PSA 144:14">bambae oli no moa save krae</para>
  <para style="q4" vid="PSA 144:14">olbaot long ples blong mifala,</para>
  <para style="q3" vid="PSA 144:14">bambae oli save harem gud.<verse eid="PSA 144:14" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Hae God i God blong yumi,</para>
  <para style="q2" vid="PSA 144:15">mo from samting ya,</para>
  <para style="q3" vid="PSA 144:15">yumi save harem gud.</para>
  <para style="q1" vid="PSA 144:15">Mo sipos hem i mekem</para>
  <para style="q2" vid="PSA 144:15">ol samting ya i kamtru long kantri ya blong yumi,</para>
  <para style="q3" vid="PSA 144:15">bambae yumi glad we yumi glad.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">Hae God i King</para>
  <para style="sp">(Sing ya, Deved i wokem.)</para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Hae God.</para>
  <para style="q1" vid="PSA 145:1">Yu yu God blong mi,</para>
  <para style="q2" vid="PSA 145:1">mo yu yu King blong mi.</para>
  <para style="q1" vid="PSA 145:1">Oltaem bambae mi stap talemaot hae nem blong yu,</para>
  <para style="q2" vid="PSA 145:1">bambae mi stap talem tangkiu long yu,</para>
  <para style="q3" vid="PSA 145:1">gogo i no save finis.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Evri dei,</para>
  <para style="q2" vid="PSA 145:2">bambae mi stap talem tangkiu long yu,</para>
  <para style="q3" vid="PSA 145:2">bambae mi stap presem yu oltaem,</para>
  <para style="q4" vid="PSA 145:2">gogo i no save finis.<verse eid="PSA 145:2" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />Hae God, hem i hae we i hae,</para>
  <para style="q2" vid="PSA 145:3">mo i stret</para>
  <para style="q3" vid="PSA 145:3">blong ol man oli stap leftemap</para>
  <para style="q4" vid="PSA 145:3">nem blong hem i go antap.</para>
  <para style="q1" vid="PSA 145:3">Hem i hae we i hae,</para>
  <para style="q2" vid="PSA 145:3">man i no naf</para>
  <para style="q3" vid="PSA 145:3">blong save paoa blong hem.<verse eid="PSA 145:3" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Hae God.</para>
  <para style="q1" vid="PSA 145:4">Oltaem ol man bambae oli stap</para>
  <para style="q2" vid="PSA 145:4">tokbaot ol wok blong yu</para>
  <para style="q3" vid="PSA 145:4">long fes blong ol pikinini</para>
  <para style="q4" vid="PSA 145:4">we bambae oli bon biaen long olgeta.</para>
  <para style="q1" vid="PSA 145:4">Oltaem bambae oli stap talemaot</para>
  <para style="q2" vid="PSA 145:4">ol bigbigfala wok blong yu.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Yu yu King,</para>
  <para style="q2" vid="PSA 145:5">mo oltaem bambae oli stap tokbaot</para>
  <para style="q3" vid="PSA 145:5">paoa blong yu mo hae nem blong yu,</para>
  <para style="q2" vid="PSA 145:5">mo oltaem bambae mi stap tingting gud</para>
  <para style="q3" vid="PSA 145:5">long ol gudgudfala wok blong yu.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Ol man bambae oli stap tokbaot</para>
  <para style="q3" vid="PSA 145:6">ol bigbigfala wok ya blong yu,</para>
  <para style="q2" vid="PSA 145:6">mo mi bambae mi stap talemaot</para>
  <para style="q4" vid="PSA 145:6">we yu yu hae we yu hae.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Bambae oli stap tokbaot</para>
  <para style="q3" vid="PSA 145:7">olgeta gudgudfala fasin blong yu,</para>
  <para style="q2" vid="PSA 145:7">mo bambae oli stap singsing</para>
  <para style="q4" vid="PSA 145:7">blong talemaot we yu yu kaen tumas.<verse eid="PSA 145:7" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />Hae God,</para>
  <para style="q2" vid="PSA 145:8">hem i God we i lavem yumi,</para>
  <para style="q3" vid="PSA 145:8">mo i gat sore long yumi.</para>
  <para style="q1" vid="PSA 145:8">Hem i no save kros kwik,</para>
  <para style="q2" vid="PSA 145:8">oltaem hem i stap lavem yumi.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />Hem i mekem olgeta samting we i gat laef,</para>
  <para style="q2" vid="PSA 145:9">mo oltaem hem i gat sore long olgeta.</para>
  <para style="q1" vid="PSA 145:9">Oltaem hem i stap mekem i gud tumas</para>
  <para style="q2" vid="PSA 145:9">long yumi evriwan.<verse eid="PSA 145:9" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />Hae God.</para>
  <para style="q1" vid="PSA 145:10">Olgeta samting ya we yu yu mekem,</para>
  <para style="q3" vid="PSA 145:10">bambae oli presem yu,</para>
  <para style="q2" vid="PSA 145:10">mo olgeta man blong yu</para>
  <para style="q3" vid="PSA 145:10">bambae oli talem tangkiu long yu.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Yu yu King,</para>
  <para style="q2" vid="PSA 145:11">mo bambae oli stap tokbaot ol gudgudfala samting</para>
  <para style="q4" vid="PSA 145:11">we yu yu mekem long paoa blong yu,</para>
  <para style="q3" vid="PSA 145:11">mo bambae oli stap talemaot bigfala paoa</para>
  <para style="q3" vid="PSA 145:11">we yu yu gat,<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />blong olgeta man bambae oli save</para>
  <para style="q4" vid="PSA 145:12">ol bigbigfala wok blong yu,</para>
  <para style="q3" vid="PSA 145:12">mo ol gudgudfala samting</para>
  <para style="q3" vid="PSA 145:12">blong hae nem blong yu.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Yu nomo yu King</para>
  <para style="q2" vid="PSA 145:13">mo bambae yu yu stap rul oltaem,</para>
  <para style="q3" vid="PSA 145:13">gogo i no save finis.</para>
  <para style="sp" vid="PSA 145:13">(Tok i go long ol man.)</para>
  <para style="q1" vid="PSA 145:13">Oltaem Hae God i stap holem ol promes blong hem,</para>
  <para style="q2" vid="PSA 145:13">mo evri samting we hem i stap mekem</para>
  <para style="q3" vid="PSA 145:13">oli gud tumas.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />Hem i stap givhan long olgeta</para>
  <para style="q3" vid="PSA 145:14">we oli stap long trabol,</para>
  <para style="q2" vid="PSA 145:14">mo i stap leftemap olgeta</para>
  <para style="q4" vid="PSA 145:14">we oli foldaon.<verse eid="PSA 145:14" /></para>
  <para style="sp">(Tok i go long Hae God.)</para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Hae God.</para>
  <para style="q1" vid="PSA 145:15">Olgeta samting we yu yu mekem,</para>
  <para style="q3" vid="PSA 145:15">oli stap lukluk long yu,</para>
  <para style="q2" vid="PSA 145:15">mo taem olgeta oli hanggri,</para>
  <para style="q4" vid="PSA 145:15">yu yu stap givim kakae long olgeta.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Yu stap givim plante kakae long olgeta,</para>
  <para style="q2" vid="PSA 145:16">mo yu stap mekem</para>
  <para style="q3" vid="PSA 145:16">olgeta evriwan oli harem gud.<verse eid="PSA 145:16" /></para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />Fasin blong Hae God i stret gud,</para>
  <para style="q2" vid="PSA 145:17">mo olgeta samting we hem i mekem</para>
  <para style="q3" vid="PSA 145:17">i stap soemaot samting ya.</para>
  <para style="q1" vid="PSA 145:17">Hem i God we i gat sore long man,</para>
  <para style="q2" vid="PSA 145:17">mo olgeta wok blong hem</para>
  <para style="q3" vid="PSA 145:17">i stap soemaot fasin ya blong hem.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />Oltaem hem i stap klosap long olgeta</para>
  <para style="q2" vid="PSA 145:18">we oli stap krae i go long hem,</para>
  <para style="q3" vid="PSA 145:18">we hemia olgeta ya we oli wantem tru</para>
  <para style="q4" vid="PSA 145:18">blong hem i givhan long olgeta.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />Olgeta we oli stap ona long hem,</para>
  <para style="q2" vid="PSA 145:19">oltaem hem i stap givim ol samting long olgeta</para>
  <para style="q4" vid="PSA 145:19">we oli sot long hem,</para>
  <para style="q3" vid="PSA 145:19">oltaem hem i stap harem krae blong olgeta,</para>
  <para style="q3" vid="PSA 145:19">mo i stap sevem olgeta.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />Oltaem hem i stap lukaot gud long olgeta</para>
  <para style="q3" vid="PSA 145:20">we oli lavem hem,</para>
  <para style="q2" vid="PSA 145:20">be bambae hem i spolem olgeta</para>
  <para style="q4" vid="PSA 145:20">we oli stap mekem ol fasin nogud.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Oltaem bambae mi mi presem Hae God.</para>
  <para style="q1" vid="PSA 145:21">Nem blong hem i tabu,</para>
  <para style="q2" vid="PSA 145:21">mo i gud olgeta samting we hem i mekem</para>
  <para style="q3" vid="PSA 145:21">oli stap presem hem oltaem,</para>
  <para style="q4" vid="PSA 145:21">gogo i no save finis.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">Sing blong presem Hae God we hem i stap sevem yumi</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Olgeta.</para>
  <para style="q1" vid="PSA 146:1">!Yumi mas presem Hae God!</para>
  <para style="b" vid="PSA 146:1" />
  <para style="q1" vid="PSA 146:1">!Mi mi mas presem hem!<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Oltaem long laef blong mi,</para>
  <para style="q2" vid="PSA 146:2">bambae mi stap presem hem.</para>
  <para style="q1" vid="PSA 146:2">Hem i God blong mi,</para>
  <para style="q3" vid="PSA 146:2">mo bambae mi stap sing blong presem hem.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Yufala i no mas trastem</para>
  <para style="q2" vid="PSA 146:3">ol lida blong wol ya.</para>
  <para style="q1" vid="PSA 146:3">Olgeta oli no save sevem yufala.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Taem oli ded,</para>
  <para style="q2" vid="PSA 146:4">oli stap gobak long graon nomo,</para>
  <para style="q3" vid="PSA 146:4">nao ol plan blong olgeta</para>
  <para style="q4" vid="PSA 146:4">oli no save kamtru.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 146:5-6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146.5-6: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 4:24">Wok 4.24</ref>; <ref loc="ACT 14:15">14.15</ref></char>
    </note>Hae God i God blong Jekob.*</para>
  <para style="q1" vid="PSA 146:5-6">Hem i mekem skae, mo graon, mo solwota,</para>
  <para style="q3" vid="PSA 146:5-6">wetem olgeta samting we i stap long trifala,</para>
  <para style="q2" vid="PSA 146:5-6">mo man we i putum tingting blong hem i stap long hem,</para>
  <para style="q4" vid="PSA 146:5-6">hem bambae i harem gud.</para>
  <para style="q1" vid="PSA 146:5-6">Oltaem Hae God i stap holem ol promes blong hem,<verse eid="PSA 146:5-6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />oltaem hem i stap givhan long olgeta</para>
  <para style="q3" vid="PSA 146:7">we ol narafala man</para>
  <para style="q4" vid="PSA 146:7">oli stap mekem i no stret long olgeta,</para>
  <para style="q3" vid="PSA 146:7">oli stap spolem olgeta,</para>
  <para style="q3" vid="PSA 146:7">mo oltaem hem i stap givim kakae</para>
  <para style="q4" vid="PSA 146:7">long olgeta we oli hanggri.</para>
  <para style="q1" vid="PSA 146:7">Hem i stap mekem</para>
  <para style="q3" vid="PSA 146:7">ol man we oli stap long kalabus oli go fri,<verse eid="PSA 146:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8" />mo i stap openem ae blong ol blaenman.</para>
  <para style="q1" vid="PSA 146:8">Oltaem hem i stap leftemap olgeta</para>
  <para style="q2" vid="PSA 146:8">we oli foldaon.</para>
  <para style="q1" vid="PSA 146:8">Ol man we fasin blong olgeta i stret,</para>
  <para style="q2" vid="PSA 146:8">hem i stap lavem olgeta.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />Hem i stap lukaot gud long ol strenja</para>
  <para style="q3" vid="PSA 146:9">we oli stap long ples blong yumi,</para>
  <para style="q2" vid="PSA 146:9">mo i stap givhan long ol wido,</para>
  <para style="q4" vid="PSA 146:9">mo ol pikinini we papa blong olgeta i ded,</para>
  <para style="q3" vid="PSA 146:9">be ol man nogud,</para>
  <para style="q3" vid="PSA 146:9">hem i stap spolem ol plan blong olgeta.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />Hae God,</para>
  <para style="q2" vid="PSA 146:10">hem bambae i King oltaem,</para>
  <para style="q3" vid="PSA 146:10">gogo i no save finis.</para>
  <para style="q1" vid="PSA 146:10">Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 146:10">God ya blong yumi bambae i rul oltaem nomo,</para>
  <para style="q3" vid="PSA 146:10">gogo i no save finis.<note caller="+" style="f"><char style="fr" closed="false">146.10: </char><char style="ft" closed="false">Narafala rod blong tanem tok long medel blong vas ya i olsem. </char><char style="fqa" closed="false">Yumi ol <char style="bd">man Saeon,</char> </char><char style="fqa" closed="false">God ya blong yumi bambae i rul oltaem nomo, gogo i no save finis.</char></note></para>
  <para style="b" vid="PSA 146:10" />
  <para style="q1" vid="PSA 146:10">!Oltaem yumi mas presem Hae God!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Olgeta.</para>
  <para style="q1" vid="PSA 147:1">!Yumi mas presem Hae God!</para>
  <para style="b" vid="PSA 147:1" />
  <para style="q1" vid="PSA 147:1">Hem i God blong yumi,</para>
  <para style="q2" vid="PSA 147:1">mo i gud yumi singsing blong presem hem,</para>
  <para style="q3" vid="PSA 147:1">from we fasin ya i gud tumas,</para>
  <para style="q4" vid="PSA 147:1">mo i stret tu.<verse eid="PSA 147:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />Hae God i stap stanemap Jerusalem* bakegen,</para>
  <para style="q2" vid="PSA 147:2">mo i stap tekem ol man blong yumi</para>
  <para style="q3" vid="PSA 147:2">we oli stap wok slef* long ol narafala kantri,</para>
  <para style="q4" vid="PSA 147:2">oli kambak long ples blong yumi.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Hem i stap mekem</para>
  <para style="q2" vid="PSA 147:3">olgeta we oli harem nogud,</para>
  <para style="q4" vid="PSA 147:3">oli harem gud bakegen,</para>
  <para style="q3" vid="PSA 147:3">mo i stap fasem ol soa blong olgeta.<verse eid="PSA 147:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4-6" style="v" sid="PSA 147:4-6" />Hae God i Masta<note caller="+" style="f"><char style="fr" closed="false">147.4-6: </char><char style="fqa" closed="false">Masta. </char><char style="ft" closed="false">Yu luk futnot <char style="bd">K</char> long 35.22.</char></note> blong yumi,</para>
  <para style="q2" vid="PSA 147:4-6">mo hem i hae we i hae.</para>
  <para style="q1" vid="PSA 147:4-6">Hem i makem namba blong ol sta,</para>
  <para style="q2" vid="PSA 147:4-6">mo i putum nem blong olgeta wanwan.</para>
  <para style="q1" vid="PSA 147:4-6">Hem i gat olgeta paoa,</para>
  <para style="q2" vid="PSA 147:4-6">mo man i no save makem waes blong hem.</para>
  <para style="q1" vid="PSA 147:4-6">Hem i stap leftemap olgeta</para>
  <para style="q3" vid="PSA 147:4-6">we tingting blong olgeta i stap daon,</para>
  <para style="q2" vid="PSA 147:4-6">be i stap flatemgud ol man nogud</para>
  <para style="q4" vid="PSA 147:4-6">i godaon long graon.<verse eid="PSA 147:4-6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Yumi mas sing long ol singsing</para>
  <para style="q3" vid="PSA 147:7">blong presem hem,</para>
  <para style="q2" vid="PSA 147:7">yumi mas sing wetem ol gita blong yumi</para>
  <para style="q4" vid="PSA 147:7">blong talem tangkiu long hem.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />Hem i stap putum ol klaod long skae,</para>
  <para style="q2" vid="PSA 147:8">mo i stap sanem ren i kam long graon,</para>
  <para style="q3" vid="PSA 147:8">mo i stap mekem gras i gru long ol hil.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Hem i stap givim kakae long ol anamol,</para>
  <para style="q2" vid="PSA 147:9">mo taem ol pikinini blong pijin oli krae,</para>
  <para style="q3" vid="PSA 147:9">hem i stap fidim olgeta.<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />Nating we ol hos oli strong blong mekem wok,</para>
  <para style="q2" vid="PSA 147:10">mo ol soldia oli no save fraet nating,</para>
  <para style="q3" vid="PSA 147:10">be Hae God i no glad long olgeta,<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />hem i glad moa long ol man</para>
  <para style="q4" vid="PSA 147:11">we oli stap ona long hem,</para>
  <para style="q3" vid="PSA 147:11">mo long olgeta we oli stap trastem hem,</para>
  <para style="q3" vid="PSA 147:11">se oltaem hem i lavem man tumas.<note caller="+" style="f"><char style="fr" closed="false">147.11: </char><char style="ft" closed="false">Long sam olfala Oltesteman, namba blong Sam ya i narafala. Yu luk futnot <char style="bd">F</char> long en blong Sam 9. Long ol Oltesteman ya, Sam 147 ya i brok long tu haf. Vas wan kasem vas leven, oli kolem Sam 146, mo vas twelef kasem vas twanti, oli kolem Sam 147.</char></note><verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Hae God i God blong yumi.</para>
  <para style="q1" vid="PSA 147:12">!Yumi ol man Saeon,*</para>
  <para style="q2" vid="PSA 147:12">yumi mas leftemap nem blong hem!</para>
  <para style="q1" vid="PSA 147:12">!Yumi mas presem hem!<note caller="+" style="f"><char style="fr" closed="false">147.12: </char><char style="ft" closed="false">Tok long las tu haf blong vas ya i folem fasin blong tok long Bislama, be long Oltesteman long lanwis ya Hibru, tok long ples ya i olsem. </char><char style="fqa" closed="false">!Yumi ol man <char style="bd">Jerusalem,</char> </char><char style="fqa" closed="false">yumi mas <char style="bd">presem</char> </char><char style="fqa" closed="false">hem! !Yumi <char style="bd">ol man Saeon, yumi</char> </char><char style="fqa" closed="false">mas presem hem! </char><char style="ft" closed="false">Long ples ya tufala nem ya Jerusalem mo Saeon tufala i nem blong sem ples nomo.</char></note><verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Hem i stap mekem</para>
  <para style="q2" vid="PSA 147:13">ol doa* blong stonwol blong yumi</para>
  <para style="q3" vid="PSA 147:13">i strong we i strong,</para>
  <para style="q4" vid="PSA 147:13">mo i stap blesem yumi evriwan.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />Hem i stap mekem</para>
  <para style="q2" vid="PSA 147:14">kantri blong yumi i stap kwaet,</para>
  <para style="q3" vid="PSA 147:14">mo i stap givim ol gudgudfala kakae long yumi</para>
  <para style="q4" vid="PSA 147:14">blong i mekem yumi harem gud.<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />Taem hem i givim tok,</para>
  <para style="q2" vid="PSA 147:15">wantaem nomo wol ya i obei long hem.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />Long koltaem, hem i stap mekem</para>
  <para style="q3" vid="PSA 147:16">wota blong naet i kam aes,</para>
  <para style="q2" vid="PSA 147:16">mo i stap mekem sno</para>
  <para style="q3" vid="PSA 147:16">i kam kavremap olgeta ples</para>
  <para style="q4" vid="PSA 147:16">olsem blangket.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />Hem i stap sanem ston blong aes*</para>
  <para style="q3" vid="PSA 147:17">i kam plante olsem korel,</para>
  <para style="q2" vid="PSA 147:17">nao i no gat man i save stap gud</para>
  <para style="q4" vid="PSA 147:17">long koltaem ya we hem i stap sanem i kam.<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />Be taem hem i tok, win i blu,</para>
  <para style="q2" vid="PSA 147:18">nao ol aes ya i ronaot, i kam wota,</para>
  <para style="q3" vid="PSA 147:18">mo ol reva oli stap ron bakegen.<verse eid="PSA 147:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 147:19">mo oltaem Hae God i stap givim</para>
  <para style="q4" vid="PSA 147:19">tok blong hem long yumi,</para>
  <para style="q3" vid="PSA 147:19">i stap tijim yumi long ol rod blong hem,</para>
  <para style="q3" vid="PSA 147:19">mo long ol tingting blong hem.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />Hem i no mekem samting ya</para>
  <para style="q2" vid="PSA 147:20">long ol man blong ol narafala kantri.</para>
  <para style="q1" vid="PSA 147:20">Olgeta ya oli no save nating</para>
  <para style="q2" vid="PSA 147:20">ol tingting blong hem.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q1" vid="PSA 147:20">!Oltaem yumi mas presem Hae God!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">Olgeta samting oli mas presem Hae God</para>
  <para style="sp">(Tok i go long ol man, wetem ol narafala samting.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Olgeta.</para>
  <para style="q1" vid="PSA 148:1">!Yumi mas presem Hae God!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q1" vid="PSA 148:1">Yufala evriwan we i stap long heven</para>
  <para style="q3" vid="PSA 148:1">yufala i mas presem Hae God.<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Yufala ol enjel blong hem long heven,</para>
  <para style="q2" vid="PSA 148:2">yufala i soldia blong hem,</para>
  <para style="q3" vid="PSA 148:2">yufala i mas presem hem.<verse eid="PSA 148:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />San mo mun,</para>
  <para style="q2" vid="PSA 148:3">yutufala i mas presem hem.</para>
  <para style="q1" vid="PSA 148:3">Yufala ol sta,</para>
  <para style="q2" vid="PSA 148:3">yufala i mas presem hem.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Skae, yu we yu stap antap olgeta,</para>
  <para style="q3" vid="PSA 148:4">yu mas presem hem,</para>
  <para style="q2" vid="PSA 148:4">mo wota, yu we yu stap antap</para>
  <para style="q3" vid="PSA 148:4">biaen long skae ya,</para>
  <para style="q4" vid="PSA 148:4">yu mas presem hem.<verse eid="PSA 148:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />I gud olgeta ya evriwan</para>
  <para style="q2" vid="PSA 148:5">oli presem nem blong Hae God,</para>
  <para style="q3" vid="PSA 148:5">from we hem i mekem olgeta long tok blong hem.<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />Hem i putum loa long ol samting ya,</para>
  <para style="q2" vid="PSA 148:6">se oli mas stap olwe long ples blong olgeta,</para>
  <para style="q3" vid="PSA 148:6">mo loa ya bambae i no save lus.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Yufala ol samting we i stap long wol ya,</para>
  <para style="q2" vid="PSA 148:7">yufala i mas presem Hae God.</para>
  <para style="q1" vid="PSA 148:7">Yufala ol bigbigfala fis, mo dipsi,</para>
  <para style="q2" vid="PSA 148:7">yufala i mas presem hem.<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />Laetning, wetem ol ston blong aes,*</para>
  <para style="q2" vid="PSA 148:8">sno, wetem ol klaod,</para>
  <para style="q3" vid="PSA 148:8">yufala i mas presem hem.</para>
  <para style="q1" vid="PSA 148:8">Hariken, yu yu stap obei long hem,</para>
  <para style="q2" vid="PSA 148:8">yu mas presem hem.<verse eid="PSA 148:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />Yufala ol bigbigfala hil</para>
  <para style="q3" vid="PSA 148:9">wetem ol smosmol hil,</para>
  <para style="q2" vid="PSA 148:9">yufala ol tri blong kakae</para>
  <para style="q4" vid="PSA 148:9">wetem ol narafala tri,</para>
  <para style="q3" vid="PSA 148:9">yufala i mas presem hem.<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />Yufala ol anamol blong vilej</para>
  <para style="q3" vid="PSA 148:10">wetem ol anamol blong bus,</para>
  <para style="q2" vid="PSA 148:10">yufala ol snek wetem ol pijin,</para>
  <para style="q4" vid="PSA 148:10">yufala i mas presem hem.<verse eid="PSA 148:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />Yufala ol king</para>
  <para style="q2" vid="PSA 148:11">wetem ol man blong evri ples,</para>
  <para style="q3" vid="PSA 148:11">yufala ol haeman wetem ol lida,</para>
  <para style="q4" vid="PSA 148:11">yufala i mas presem hem.<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />Yufala ol gel</para>
  <para style="q2" vid="PSA 148:12">wetem ol boe,</para>
  <para style="q3" vid="PSA 148:12">yufala ol ololfala</para>
  <para style="q4" vid="PSA 148:12">wetem ol pikinini tu,</para>
  <para style="q3" vid="PSA 148:12">yufala i mas presem hem.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Yumi evriwan i mas presem nem blong Hae God.</para>
  <para style="q1" vid="PSA 148:13">Nem blong hem i hae moa,</para>
  <para style="q3" vid="PSA 148:13">i winim ol narafala nem,</para>
  <para style="q2" vid="PSA 148:13">mo paoa blong hem i kasem evri ples</para>
  <para style="q4" vid="PSA 148:13">long heven mo long wol.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 148:14">yumi ol man blong hem,</para>
  <para style="q3" vid="PSA 148:14">mo yumi stap klosap moa long hem.</para>
  <para style="q1" vid="PSA 148:14">Hem nao i mekem yumi kam strong</para>
  <para style="q2" vid="PSA 148:14">blong yumi stap presem hem oltaem.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q1" vid="PSA 148:14">!Oltaem yumi mas presem Hae God!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">Sing blong presem Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Olgeta.</para>
  <para style="q1" vid="PSA 149:1">!Yumi presem Hae God!</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q1" vid="PSA 149:1">Yumi ya, yumi ol man blong hem.</para>
  <para style="q1" vid="PSA 149:1">I gud yumi wokem wan niufala singsing,</para>
  <para style="q2" vid="PSA 149:1">yumi kam wanples</para>
  <para style="q4" vid="PSA 149:1">long fes blong ol narafala man blong hem,</para>
  <para style="q3" vid="PSA 149:1">yumi sing long hem blong presem hem.<verse eid="PSA 149:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Yumi ol laen* blong Isrel,*</para>
  <para style="q2" vid="PSA 149:2">hem i mekem yumi.</para>
  <para style="q1" vid="PSA 149:2">I gud yumi joen long hem,</para>
  <para style="q2" vid="PSA 149:2">yumi glad.</para>
  <para style="q1" vid="PSA 149:2">Yumi ol man Saeon,*</para>
  <para style="q2" vid="PSA 149:2">hem i King blong yumi.</para>
  <para style="q1" vid="PSA 149:2">I gud yumi joen long hem,</para>
  <para style="q2" vid="PSA 149:2">yumi glad.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />I gud yumi danis</para>
  <para style="q2" vid="PSA 149:3">blong presem nem blong hem,</para>
  <para style="q2" vid="PSA 149:3">yumi kilim ol dram mo ol gita blong yumi</para>
  <para style="q3" vid="PSA 149:3">blong presem hem.<verse eid="PSA 149:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Oltaem Hae God i stap glad long yumi.</para>
  <para style="q1" vid="PSA 149:4">Oltaem tingting blong yumi i stap daon,</para>
  <para style="q2" vid="PSA 149:4">nao hem i mekem yumi win.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Yumi ol man blong hem,</para>
  <para style="q2" vid="PSA 149:5">i gud yumi glad from we yumi win,</para>
  <para style="q3" vid="PSA 149:5">i gud yumi singsing delaet</para>
  <para style="q4" vid="PSA 149:5">from we yumi glad.<verse eid="PSA 149:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />I gud yumi holem ol naef blong faet blong yumi</para>
  <para style="q3" vid="PSA 149:6">we oli sap tu saed,</para>
  <para style="q2" vid="PSA 149:6">nao yumi presem hem</para>
  <para style="q4" vid="PSA 149:6">we yumi stap singsingaot bigwan.<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />Bambae yumi go faet long ol narafala kantri</para>
  <para style="q2" vid="PSA 149:7">we bambae yumi winim olgeta,</para>
  <para style="q3" vid="PSA 149:7">yumi panisim ol man blong olgeta.<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />Bambae yumi putum hankaf</para>
  <para style="q3" vid="PSA 149:8">long ol king blong olgeta,</para>
  <para style="q2" vid="PSA 149:8">mo bambae yumi fasem ol lida blong olgeta</para>
  <para style="q4" vid="PSA 149:8">long ol bigbigfala jen.<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />Long fasin ya,</para>
  <para style="q2" vid="PSA 149:9">bambae yumi panisim ol man ya</para>
  <para style="q3" vid="PSA 149:9">olsem we Hae God i talem.</para>
  <para style="q1" vid="PSA 149:9">Hemia fasin we hem i stap folem</para>
  <para style="q2" vid="PSA 149:9">blong leftemap nem blong yumi.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q1" vid="PSA 149:9">!Oltaem yumi mas presem Hae God!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">Ol man oli mas presem Hae God</para>
  <para style="sp">(Tok i go long ol man.)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Olgeta.</para>
  <para style="q1" vid="PSA 150:1">!Yumi mas presem Hae God!</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q1" vid="PSA 150:1">Yumi mas presem hem long haos* blong hem.</para>
  <para style="q1" vid="PSA 150:1">Yufala long heven,</para>
  <para style="q2" vid="PSA 150:1">yufala i mas presem hem</para>
  <para style="q3" vid="PSA 150:1">from bigfala paoa blong hem.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Yumi mas presem hem</para>
  <para style="q2" vid="PSA 150:2">from ol bigbigfala wok we hem i mekem.</para>
  <para style="q1" vid="PSA 150:2">Nem blong hem i hae we i hae,</para>
  <para style="q2" vid="PSA 150:2">mo yumi mas presem hem.<verse eid="PSA 150:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Yumi mas presem hem long pupu.</para>
  <para style="q1" vid="PSA 150:3">Yumi mas presem hem long gita,</para>
  <para style="q2" vid="PSA 150:3">mo long mandolin.<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />Yumi mas presem hem long dram,</para>
  <para style="q2" vid="PSA 150:4">mo long danis.</para>
  <para style="q1" vid="PSA 150:4">Yumi mas presem hem long yukalele,</para>
  <para style="q2" vid="PSA 150:4">mo long bambu paep.<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />Yumi mas presem hem long simbol.*</para>
  <para style="q1" vid="PSA 150:5">Yumi mas presem hem</para>
  <para style="q2" vid="PSA 150:5">long simbol ya we i singaot bigwan.<verse eid="PSA 150:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Yumi olgeta samting we yumi gat laef,</para>
  <para style="q2" vid="PSA 150:6">yumi evriwan i mas presem hem.</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q1" vid="PSA 150:6">!Oltaem yumi mas presem Hae God!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>